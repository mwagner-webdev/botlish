{
  "name": "botlish",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-26.04",
  "containerEnv": {
    "LANG": "C.utf8",
    "LC_ALL": "C.utf8"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh && bash .devcontainer/setup-c-toolchain.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  }
}
