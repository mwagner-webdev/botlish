{
  "name": "botlish",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "LANG": "C.utf8",
    "LC_ALL": "C.utf8"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh && bash .devcontainer/setup-c-toolchain.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  }
}
