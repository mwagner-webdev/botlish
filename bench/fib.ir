# Naive recursive Fibonacci: calls, integer comparison and arithmetic.

{bind fib
    {block {n}
        {if {call {ref <} {ref n} {const 2}}
            {block {} {ref n}}
            {block {}
                {call {ref +}
                    {call {ref fib} {call {ref -} {ref n} {const 1}}}
                    {call {ref fib} {call {ref -} {ref n} {const 2}}}}}}}}

{call {ref fib} {const 18}}
