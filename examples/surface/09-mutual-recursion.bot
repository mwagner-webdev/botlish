# Mutual recursion is not supported: a binding is visible from its definition
# onward, so is_even cannot refer to is_odd, which is defined after it. One
# edge of any mutually recursive pair must point forward, and ordinary
# bindings are never hoisted. (Define the callee first, or restructure the
# recursion; an explicit construct for mutual recursion is a possible future
# extension.) A named function may call itself: see 02-recursion.bot.
#
# expect-error: CORE SEMANTIC UNBOUND

fn is_even(n):
    if n == 0:
        return true
    is_odd(n - 1)

fn is_odd(n):
    if n == 0:
        return false
    is_even(n - 1)

[is_even(10), is_even(7)]
