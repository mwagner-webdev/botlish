# probes.bot -- the CSV emitters' coroutine behavior, run
# (CSV-EMISSION-VALIDATION-MILESTONE-1.md, sections 7, 8, 11 and 13): one
# List[int] per probe, the same on every backend (tests/csv-emission.test
# compares them and checks each one).
#
#    0  the strict document's symbols (ASCII codes)
#    1  the UTF-8 document's bytes
#    2  the selective document's symbols
#    3  {bytes, records}: the source's final value read after done?
#    4  a completed source resumed three more times: its final value each
#       time, then 1 (done? still true)
#    5  a document with NUL in a later record's third field: {1, at, value}
#       then the bytes a sink holds -- a viable prefix, never a document
#    6  the first 7 bytes, the emitter then abandoned
#    7  a sink full after 30 bytes: {999, 30}
#    8  zero records: the empty stream
#    9  the records with CRLF between them and none after the last
#   10  {chunks, 1 when their concatenation is the document} for chunks of 3
#   11  bytes that are no UTF-8 (an overlong NUL): {3} (InvalidUtf8, before
#       any symbol)
#   12  'é' as a Profile A field: {1, 0, 233} (unsupported, nothing written
#       but the opening quotation mark)
#   13  a field beginning with U+FEFF, as bytes: quoted, so no document
#       starts with a byte-order mark
#   14  the run-time validation's digest equals the certified emitter's: 1
#   15  selective fields: "plain", "a,b", "", "a<U+2028>b", "tab<TAB>"
#   16  the injection value hello","admin as a whole record's fields
#   17  the formula values =1+2, +1+2, @SUM(1,2): quoted and unchanged
#   18  a document of multibyte characters in chunks of 2, each chunk
#       followed by -1: chunk boundaries inside UTF-8 sequences

import std::abi::bytes
import std::byte
import std::list
import csv_common
import sinks
import selective_emit

# A record of three fields (none of them a receiver).
nomethod fn row(a: str, b: str, c: str) -> csv_common::Row:
    csv_common::Row {a: a, b: b, c: c}

# The text whose UTF-8 bytes are CODES.
fn utf8_text(codes: List[int]) -> str errors InvalidUtf8, std::byte::BelowRange, std::byte::AboveRange:
    bs = loop x in codes:
        std::byte::from_int(x)
    std::abi::bytes::from_list(bs).decode_utf8()

fn utf8_bytes(codes: List[int]) -> std::abi::bytes::Bytes errors std::byte::BelowRange, std::byte::AboveRange:
    bs = loop x in codes:
        std::byte::from_int(x)
    std::abi::bytes::from_list(bs)

fn probes() -> List[List[int]] errors csv_common::UnsupportedCSVCharacter, selective_emit::QuotingDecision, InvalidUtf8, std::byte::BelowRange, std::byte::AboveRange, sinks::Invalid:
    header = row("id", "name", "note")
    rows = [row("101", "he said \"hi\"", "a,b"), row("102", "line\r\nbreak", ""), row("103", "xx", "yy")]
    nul = utf8_text([120, 0, 121])
    bad = [row("101", "ok", "fine"), row("102", "still", nul)]
    p5 = sinks::partial_bytes(header, bad)
    failed = if p5.failed:
        1
    else:
        0
    p7 = sinks::limited_bytes(header, rows, 30):
        on sinks::SinkFull {limit}:
            [999, limit]
    chunks = sinks::chunked_bytes(header, rows, 3)
    joined = std::list::flat(chunks)
    whole = if joined == sinks::collect_bytes_document(header, rows):
        1
    else:
        0
    p10 = [chunks.length(), whole]
    p11 = sinks::collect_bytes_field_from_bytes(utf8_bytes([192, 128])):
        on InvalidUtf8:
            [3]
    p12 = sinks::collect_strict_field(utf8_text([195, 169])):
        on csv_common::UnsupportedCSVCharacter {at, value}:
            [1, at, value]
    bom = utf8_text([239, 187, 191, 97])
    validated = sinks::validated_bytes(header, rows)
    certified = sinks::digest_bytes(header, rows)
    same = if validated == certified:
        1
    else:
        0
    ls = utf8_text([97, 226, 128, 168, 98])
    selective = std::list::flat([sinks::collect_selective_field("plain"), [124], sinks::collect_selective_field("a,b"), [124], sinks::collect_selective_field(""), [124], sinks::collect_selective_field(ls), [124], sinks::collect_selective_field("tab\t")])
    injection = "hello\",\"admin"
    formulas = [row("=1+2", "+1+2", "@SUM(1,2)")]
    wide = utf8_text([195, 169, 226, 130, 172, 240, 159, 152, 128])
    pieces = sinks::chunked_bytes(row(wide, "ab", wide), [], 2)
    marked = loop k in pieces:
        k.append(-1)
    [sinks::collect_strict_document(header, rows),
     sinks::collect_bytes_document(header, rows),
     sinks::collect_selective_document(header, rows),
     sinks::written_bytes(header, rows),
     sinks::after_end(rows, 3),
     std::list::flat([[failed, p5.at, p5.value], p5.symbols]),
     sinks::prefix_bytes(header, rows, 7),
     p7,
     sinks::collect_bytes_stream([]),
     sinks::collect_bytes_unterminated(rows),
     p10,
     p11,
     p12,
     sinks::collect_bytes_field(bom),
     [same],
     selective,
     sinks::collect_bytes_stream([row(injection, injection, injection)]),
     sinks::collect_bytes_stream(formulas),
     std::list::flat(marked)]

probes():
    on csv_common::UnsupportedCSVCharacter:
        []
    on selective_emit::QuotingDecision:
        []
    on InvalidUtf8:
        []
    on std::byte::BelowRange:
        []
    on std::byte::AboveRange:
        []
    on sinks::Invalid:
        []
