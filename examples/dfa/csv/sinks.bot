# sinks.bot -- consumers of the CSV sources (CSV-EMISSION-VALIDATION-
# MILESTONE-1.md, sections 7, 11 and 13). Each drives one source: it
# constructs the source's coroutine and resumes it in the same function, so
# coroutine fusion compiles the pair into straight-line code
# (COROUTINE-FUSION-MILESTONE-1.md). A consumer tells a symbol from the
# source's final value by std::coroutine::done?, never by the value.
#
#   collect_*       every symbol into a List (an accumulating sink)
#   digest_bytes    a running checksum and count of the bytes, storing none
#   chunked_bytes   the bytes in chunks of SIZE, as a buffered writer hands
#                   them on: chunks are transport, not grammar -- a chunk may
#                   end inside a doubled quotation mark, a CRLF or a UTF-8
#                   sequence, and only their concatenation is the document
#   limited_bytes   a sink that takes at most LIMIT bytes: past it the
#                   consumer fails SinkFull, abandoning the emitter
#                   mid-document (released, never resumed again)
#   prefix_bytes    the first K bytes, the emitter then abandoned
#   partial_bytes   what a sink holds when the emitter fails: the prefix it
#                   wrote and the failure -- a viable prefix, not a document
#   written_bytes   the source's final value read after done?: the number of
#                   records it wrote (no symbol, not -1)
#   after_end       resuming a completed source again: its final value each
#                   time, and done? stays true
#   validated_bytes design A for comparison: each byte of the certified
#                   emitter also fed to document3_bytes at run time
#
# A sink of several arguments is `nomethod`: its arguments are a table and
# its parameters, none of them a receiver.

import std::dfa
import std::coroutine
import std::list
import std::str
import std::mutable_vector
import std::mutable_array
import std::abi::bytes
import csv_common
import csv_utf8
import selective_emit
import sources

# The sink's limit on the bytes it accepts (its own failure).
error SinkFull:
    limit: int

# Design A's run-time verdict: the emitted bytes are not a document3_bytes
# token at index AT (the end: the count), STATE the recognizer's state.
error Invalid:
    at: int
    recognizer: str
    state: str

fn no_symbols() -> List[int]:
    v = std::mutable_vector::from_list([0])
    v.pop():
        on IndexNotFound:
            return []
    loop x in v:
        x

fn collect_strict_field(value: str) -> List[int] errors csv_common::UnsupportedCSVCharacter:
    coroutine {step, first} = sources::strict_field_source(value)
    out = std::mutable_vector::from_list(no_symbols())
    c = std::mutable_array::create(1, first)
    loop:
        if std::coroutine::done?(step):
            break
        out.push(c.at(0))
        c.set(0, step())
    loop x in out:
        x

nomethod fn collect_strict_document(header: csv_common::Row, rows: List[csv_common::Row]) -> List[int] errors csv_common::UnsupportedCSVCharacter:
    coroutine {step, first} = sources::strict_document_source(header, rows)
    out = std::mutable_vector::from_list(no_symbols())
    c = std::mutable_array::create(1, first)
    loop:
        if std::coroutine::done?(step):
            break
        out.push(c.at(0))
        c.set(0, step())
    loop x in out:
        x

