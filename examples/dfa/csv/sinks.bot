# {digest, symbols} of the document's bytes: H * 31 + B + 1 modulo a prime,
# storing no byte (a stand-in for a file or socket).
struct Digest:
    digest: int
    symbols: int

fn mix(h: int, c: int) -> int:
    (h * 31 + c + 1).mod(2147483647)

nomethod fn digest_bytes(header: csv_common::Row, rows: List[csv_common::Row]) -> Digest errors csv_common::UnsupportedCSVCharacter:
    coroutine {step, first} = sources::bytes_document_source(header, rows)
    state = std::mutable_array::create(3, 0)
    state.set(2, first)
    loop:
        if std::coroutine::done?(step):
            break
        state.set(0, state.at(0).mix(state.at(2)))
        state.set(1, state.at(1) + 1)
        state.set(2, step())
    Digest {digest: state.at(0), symbols: state.at(1)}

# The document's bytes in chunks of SIZE (the last one shorter), each chunk
# a List: what a buffered writer hands its file descriptor.
nomethod fn chunked_bytes(header: csv_common::Row, rows: List[csv_common::Row], size: int) -> List[List[int]] errors csv_common::UnsupportedCSVCharacter:
    coroutine {step, first} = sources::bytes_document_source(header, rows)
    chunks = std::mutable_vector::from_list([no_symbols()])
    chunks.clear()
    chunk = std::mutable_vector::from_list(no_symbols())
    c = std::mutable_array::create(1, first)
    loop:
        if std::coroutine::done?(step):
            break
        chunk.push(c.at(0))
        if chunk.length() >= size:
            full = loop x in chunk:
                x
            chunks.push(full)
            chunk.clear()
        c.set(0, step())
    if chunk.length() > 0:
        last = loop x in chunk:
            x
        chunks.push(last)
    loop k in chunks:
        k

nomethod fn limited_bytes(header: csv_common::Row, rows: List[csv_common::Row], limit: int) -> List[int] errors csv_common::UnsupportedCSVCharacter, SinkFull:
    coroutine {step, first} = sources::bytes_document_source(header, rows)
    out = std::mutable_vector::from_list(no_symbols())
    c = std::mutable_array::create(1, first)
    loop:
        if std::coroutine::done?(step):
            break
        if out.length() >= limit:
            fail SinkFull {limit: limit}
        out.push(c.at(0))
        c.set(0, step())
    loop x in out:
        x

nomethod fn prefix_bytes(header: csv_common::Row, rows: List[csv_common::Row], k: int) -> List[int] errors csv_common::UnsupportedCSVCharacter:
    coroutine {step, first} = sources::bytes_document_source(header, rows)
    out = std::mutable_vector::from_list(no_symbols())
    c = std::mutable_array::create(1, first)
    loop:
        if std::coroutine::done?(step) or out.length() >= k:
            break
        out.push(c.at(0))
        c.set(0, step())
    loop x in out:
        x

# What a sink holds after the emitter ran: SYMBOLS, and whether it failed
# (AT and VALUE the unsupported character's; -1 when it completed).
struct Partial:
    symbols: List[int]
    failed: bool
    at: int
    value: int

nomethod fn partial_bytes(header: csv_common::Row, rows: List[csv_common::Row]) -> Partial:
    out = std::mutable_vector::from_list(no_symbols())
    coroutine {step, first} = sources::bytes_document_source(header, rows):
        on csv_common::UnsupportedCSVCharacter {at, value}:
            return Partial {symbols: no_symbols(), failed: true, at: at, value: value}
    c = std::mutable_array::create(1, first)
    loop:
        if std::coroutine::done?(step):
            break
        out.push(c.at(0))
        next = step():
            on csv_common::UnsupportedCSVCharacter {at, value}:
                written = loop x in out:
                    x
                return Partial {symbols: written, failed: true, at: at, value: value}
        c.set(0, next)
    complete = loop x in out:
        x
    Partial {symbols: complete, failed: false, at: -1, value: -1}

# The bytes' count, then the source's final value (the number of records),
# read once done? says the source completed.
nomethod fn written_bytes(header: csv_common::Row, rows: List[csv_common::Row]) -> List[int] errors csv_common::UnsupportedCSVCharacter:
    coroutine {step, first} = sources::bytes_document_source(header, rows)
    state = std::mutable_array::create(2, 0)
    state.set(1, first)
    loop:
        if std::coroutine::done?(step):
            break
        state.set(0, state.at(0) + 1)
        state.set(1, step())
    [state.at(0), state.at(1)]

# The final value of a completed source, resumed MORE times after the end,
# and 1 if done? is still true.
nomethod fn after_end(rows: List[csv_common::Row], more: int) -> List[int] errors csv_common::UnsupportedCSVCharacter:
    coroutine {step, first} = sources::bytes_stream_source(rows)
    c = std::mutable_array::create(1, first)
    loop:
        if std::coroutine::done?(step):
            break
        c.set(0, step())
    out = std::mutable_vector::from_list([c.at(0)])
    loop i from 0 to more:
        out.push(step())
        continue
    if std::coroutine::done?(step):
        out.push(1)
    loop x in out:
        x

# Design A beside the certified emitter: every byte also fed, as it is
# emitted, to the document's recognizer, which never fails here (the claim
# is certified) -- the run-time cost the static proof saves.
nomethod fn validated_bytes(header: csv_common::Row, rows: List[csv_common::Row]) -> Digest errors csv_common::UnsupportedCSVCharacter, Invalid:
    coroutine {step: next, first: c0} = sources::bytes_document_source(header, rows)
    count = std::mutable_array::create(2, 0)
    if std::coroutine::done?(next):
        return Digest {digest: 0, symbols: 0}
    coroutine {step: feed} = csv_utf8::document3_bytes(c0):
        on std::dfa::UnrecognizedInput {recognizer, state}:
            fail Invalid {at: 0, recognizer: recognizer, state: state}
        on std::dfa::UnexpectedEnd {recognizer, state}:
            fail Invalid {at: 0, recognizer: recognizer, state: state}
    count.set(0, mix(0, c0))
    count.set(1, 1)
    loop:
        if std::coroutine::done?(feed):
            fail Invalid {at: count.at(1), recognizer: "csv_utf8::document3_bytes", state: "ended before this byte"}
        x = next()
        if std::coroutine::done?(next):
            break
        feed(std::dfa::Symbol {code: x}):
            on std::dfa::UnrecognizedInput {recognizer, state}:
                fail Invalid {at: 0, recognizer: recognizer, state: state}
            on std::dfa::UnexpectedEnd {recognizer, state}:
                fail Invalid {at: 0, recognizer: recognizer, state: state}
        count.set(0, count.at(0).mix(x))
        count.set(1, count.at(1) + 1)
    r = feed(std::dfa::Symbol {code: -1}):
        on std::dfa::UnrecognizedInput {recognizer, state}:
            fail Invalid {at: count.at(1), recognizer: recognizer, state: state}
        on std::dfa::UnexpectedEnd {recognizer, state}:
            fail Invalid {at: count.at(1), recognizer: recognizer, state: state}
    if r != 0:
        fail Invalid {at: count.at(1), recognizer: "csv_utf8::document3_bytes", state: "ended before the end"}
    Digest {digest: count.at(0), symbols: count.at(1)}
