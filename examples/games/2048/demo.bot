# demo.bot -- plays one deterministic game of 2048 with the engine
# (game2048.bot) and prints it, on Linux: the game and its presentation are
# demo_play.bot's (an application module beside it), and only the installed
# std::io::IO context is this file's -- std::linux::io's, whose writes are the raw
# write(2) syscall. demo-darwin.bot is the same program on macOS,
# demo-windows.bot on Windows.
#
# Output goes through std::io::print_line, which needs the native backend:
#
#   tclsh9.0 main.tcl -backend cranelift examples/games/2048/demo.bot
#
# or, as a standalone executable (written beside it, as demo):
#
#   tclsh9.0 main.tcl -emit-native-executable examples/games/2048/demo.bot
import demo_play
import std::io
import std::linux::io

with context std::linux::io::create()

demo_play::main():
    on std::io::WriteFailed:
        unit
