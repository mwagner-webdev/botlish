# main-windows.bot -- main.bot on Windows (ICY-TOWER-WINDOWS.md): the same
# game (game.bot), SDL (sdl.bot) and keyboard (keyboard.bot), with Windows'
# std::io::IO context installed -- std::windows::io's, whose writes are
# kernel32's WriteFile.
#
#   examples/games/icy-tower/build-windows.sh    the Windows executable
import game
import keyboard
import sdl
import std::io
import std::windows::io

with context std::windows::io::create()
with context sdl::create()
with context keyboard::create()

game::main(game::arguments()):
    on std::io::WriteFailed:
        unit
