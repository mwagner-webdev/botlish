# game.bot -- the Icy Tower vertical slice as a program
# (ICY-TOWER-VERTICAL-SLICE-1.md): a window, the keyboard, the frame loop,
# and the run's summary. An application module, the file beside the game's
# entry programs: main.bot installs Linux's std::io::IO context
# (std::linux::io), main-windows.bot Windows' (std::windows::io,
# ICY-TOWER-WINDOWS.md); each installs sdl.bot's Sdl and runs `main`.
# Nothing here names a platform.
#
#   examples/games/icy-tower/build.sh     the Linux executable
#   examples/games/icy-tower/build-windows.sh
#                                         the Windows one (on Windows)
#   icy-tower                             play (a tower from the clock)
#   icy-tower --seed 7                    play the tower of seed 7
#   icy-tower --headless --frames 1200    no SDL: the autopilot's run, its
#                                         summary printed
#   SDL_VIDEO_DRIVER=dummy icy-tower --autopilot --fixed-step --frames 600
#                                         the real SDL loop, no display
#
# Controls: Left/A and Right/D run; landing on a platform bounces; R
# starts a new game after a fall; Escape (or closing the window) quits.
#
# The program's value, which the executable prints, is the run's summary
# line (hud::summary). A run that fails -- SDL cannot start, or a frame
# cannot be drawn -- releases what it made, writes "Icy Tower: WHAT failed:
# SDL's error" on standard error and exits with status 1: Botlish has no
# exit status of its own, so that is C's exit().
#
# The frame loop is one self-tail-recursive function, `run`, which the
# native backend compiles to a loop: the world is an immutable value
# replaced each frame. SDL -- the window, the renderer, the keyboard, the
# clock -- is the installed sdl::Sdl context, which `play` opens before the
# loop and closes after it: nothing here holds an SDL object.
import std::ffi::c
import std::float64
import std::io
import std::list
import hud
import options
import std::str
import render
import sdl
import sdl3::scancode
import tower

# C's exit(3): the process's exit status, which Botlish cannot set.
extern c fn exit(status: std::ffi::c::Int) -> unit

# SCANCODE, an SDL scancode, as the Int it is: an index of SDL's keyboard
# state. (An SDL enumeration constant's C type is the target's: unsigned int
# on Linux, int on Windows.)
fn key(scancode: int) -> int:
    scancode

# The keys the game reads, in the order of `input`'s list.
fn scancodes() -> List[int]:
    [
        key(sdl3::scancode::SDL_SCANCODE_LEFT),
        key(sdl3::scancode::SDL_SCANCODE_A),
        key(sdl3::scancode::SDL_SCANCODE_RIGHT),
        key(sdl3::scancode::SDL_SCANCODE_D),
        key(sdl3::scancode::SDL_SCANCODE_R),
        key(sdl3::scancode::SDL_SCANCODE_ESCAPE),
    ]

# The player's input from HELD, which of scancodes() are held.
fn input(held: List[bool]) -> tower::Input:
    tower::Input {
        left: held.get(0, false) or held.get(1, false),
        right: held.get(2, false) or held.get(3, false),
        restart: held.get(4, false),
    }

fn escape?(held: List[bool]) -> bool:
    held.get(5, false)

# How a run ended: the last world, the frames played, and what failed (""
# when nothing did).
struct Ended:
    world: tower::World
    frames: int
    failure: str

# The length of the frame that started at NOW after the one that started at
# LAST, by the clock or, with --fixed-step, a 60th of a second.
fn frame_length(now: Float64, last: Float64, o: options::Options) -> Float64 errors NonFiniteFloat:
    if o.fixed_step:
        return tower::frame_time
    now - last

# Sleeps out the rest of a 60 Hz frame that started at NOW, unless the
# display paces the loop (vertical sync) or the steps are fixed (a smoke
# run goes as fast as it can).
fn pace(now: Float64, o: options::Options) errors NonFiniteFloat:
    if sdl::synced?() or o.fixed_step:
        return unit
    sdl::sleep(tower::frame_time - (sdl::seconds() - now))

# The frame loop: plays WORLD until a quit (the window closed, Escape), the
# frame limit of OPTIONS or a failure. FRAMES have been played, the last
# one started at LAST seconds.
fn run(world: tower::World, frames: int, last: Float64, o: options::Options) -> Ended:
    if o.frames > 0 and frames >= o.frames:
        return Ended {world: world, frames: frames, failure: ""}
    {quit, held, failure: unread} = sdl::poll(scancodes())
    if unread != "":
        return Ended {world: world, frames: frames, failure: unread}
    if quit or held.escape?():
        return Ended {world: world, frames: frames, failure: ""}
    wanted = if o.autopilot:
        tower::autopilot(world):
            on NonFiniteFloat:
                return Ended {world: world, frames: frames, failure: "the autopilot"}
    else:
        held.input()
    now = sdl::seconds():
        on NonFiniteFloat:
            return Ended {world: world, frames: frames, failure: "reading the clock"}
    dt = now.frame_length(last, o):
        on NonFiniteFloat:
            return Ended {world: world, frames: frames, failure: "reading the clock"}
    next = world.step(wanted, dt):
        on NonFiniteFloat:
            return Ended {world: world, frames: frames, failure: "a step of the game"}
    undrawn = render::draw(next)
    if undrawn != "":
        return Ended {world: next, frames: frames + 1, failure: undrawn}
    paced = now.pace(o):
        on NonFiniteFloat:
            unit
    next.run(frames + 1, now, o)

# The line reporting that WHAT failed, with SDL's REASON (SDL_GetError's
# text; "" when there was none to read).
fn failure_line(what: str, reason: str) -> str:
    line = "Icy Tower: ".concat(what).concat(" failed")
    if reason == "":
        return line
    line.concat(": ").concat(reason)

# Writes LINE on standard error. (If that fails there is nothing left to
# do: the run is ending with status 1.)
fn report(line: str):
    written = std::io::write_error_line(line):
        on std::io::WriteFailed:
            unit

# Plays with SDL: opens the window, runs the loop, closes everything; the
# summary, or, after a failure (reported), exit status 1.
fn play(o: options::Options) -> str errors NonFiniteFloat:
    sdl::open("Icy Tower - Botlish", 480, 720, not o.fixed_step):
        on sdl::SdlFailed {call, reason}:
            report(call.failure_line(reason))
            exit(1)
            return "failed: ".concat(call)
    seed = if o.seeded:
        o.seed
    else:
        sdl::counter()
    world = tower::new_world(seed, 1)
    start = sdl::seconds()
    {world: last, frames, failure} = world.run(0, start, o)
    reason = sdl::close(failure)
    if failure != "":
        report(failure.failure_line(reason))
        exit(1)
        return "failed: ".concat(failure)
    last.summary(frames)

# The autopilot's headless run: no SDL at all.
fn headless(o: options::Options) -> str errors NonFiniteFloat:
    tower::new_world(o.seed, 1).simulate(o.frames).summary(o.frames)

# The run OPTIONS ask for: headless, or played with SDL.
fn session(o: options::Options) -> str errors NonFiniteFloat:
    if o.headless:
        return headless(o)
    play(o)

# The run ARGUMENTS (the command line without the program's name) ask for:
# its summary, or the usage, or a usage error (status 2).
fn main(arguments: List[str]) -> str errors std::io::WriteFailed:
    o = options::parse(arguments):
        on options::UsageError {message}:
            std::io::write_error_line("icy-tower: ".concat(message))
            loop line in options::usage():
                std::io::write_error_line(line)
            exit(2)
            return message
    if o.help:
        loop line in options::usage():
            std::io::print_line(line)
        return "help"
    ran = o.session():
        on NonFiniteFloat:
            # SDL may be open (play opens it before its first Float64): close
            # it, as every other way out does. (Closing a closed Sdl does
            # nothing.)
            closed = sdl::close("")
            exit(1)
            "failed: a number left the finite Float64s"
    ran

# The process's arguments without its name ([] if they are not text).
fn arguments() -> List[str]:
    everything = argv():
        on InvalidArgumentEncoding:
            return []
    loop arg in everything and i from 0 to std::list::length(everything):
        if i == 0:
            continue
        arg
