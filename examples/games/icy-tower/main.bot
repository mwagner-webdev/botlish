# main.bot -- the Icy Tower vertical slice on Linux
# (ICY-TOWER-VERTICAL-SLICE-1.md): the game is game.bot's (an application
# module beside it) and SDL sdl.bot's; this file installs their contexts --
# std::linux::io's std::io::IO, whose writes are the raw write(2) syscall,
# and SDL, closed -- and runs the game on the command line.
# main-windows.bot is the same program on Windows.
#
#   examples/games/icy-tower/build.sh     the Linux executable
import game
import sdl
import std::io
import std::linux::io

with context std::linux::io::create()
with context sdl::create()

result = game::main(game::arguments()):
    on std::io::WriteFailed:
        "failed: writing to the terminal"
result
