# sdl.bot -- the SDL airlock of the Icy Tower vertical slice
# (ICY-TOWER-VERTICAL-SLICE-1.md, ICY-TOWER-CONTEXT-REFACTOR-CENSUS.md):
# one context, Sdl, which owns SDL's lifetime and every SDL object the game
# uses, and ordinary operations under it -- open and close the window, poll
# the input, the clock, and drawing a rectangle, a line and a line of text
# -- none of which takes or returns a C pointer. Everything below this
# module is the GENERATED SDL3 binding (generated/c/sdl3/TARGET/sdl3/,
# staged beside the program by build.sh).
#
# Authority (DIRECT-MODULES.md). A call that hands SDL a pointer its
# contract says nothing about (the renderer, the window: unknown escape) is
# raw, ambient authority, and so is making a native edit or view
# (std::binary::native). Every function here that does either requires Sdl,
# the context this module declares, so the authority reaches the game only
# as that capability -- `with context sdl::create()` in the entry program
# -- and nothing above this module is direct for using it.
#
# Privacy (MODULE-PRIVACY-AND-CONTEXT-ESCAPE-MILESTONE-1.md). What the game
# may call is public: the context and its constructor, the error, and the
# operations below, which take and return values only. Everything that
# takes or returns a pointer or a native view or edit -- the text and
# release helpers, the event and keyboard readers -- the session and the
# layouts that describe native memory are `private`: this module's
# implementation, which no importer can name, so no raw resource crosses
# its boundary (CONTEXT-RESOURCE-ESCAPE has nothing to report).
#
# State. The open session lives in the context, not in a value the game
# carries: Sdl's one member is a MutableVector, empty while SDL is closed
# and holding the session while it is open (a context member is mutated in
# place and seen by every function that requires the context:
# MUTABLE-VECTOR.md, "Context-field receiver mutation"). `open` pushes the
# session, `close` takes it out; an operation of a closed Sdl does nothing
# and reports failure, and closing twice closes once.
#
# Ownership (CONTEXT-OWNED-AFFINE-STATE-MILESTONE-1.md). The session holds
# SDL's pointers themselves -- the window, the renderer, the keyboard state
# and the scratch memory -- and C pointers are affine (C-ABI-TYPES.md): the
# installed Sdl owns them, inside its vector. `open` moves the session it
# made into the vector (push) and `close` moves it out again (pop) to
# release it; in between, an operation reaches a pointer where it is
# stored, through the session's element place, `sdl.open.element(0)`, and
# hands it to SDL, which only observes it: nothing is copied out of the
# context, and nothing but the context owns a pointer. An element place is
# no value (it fails with IndexNotFound while SDL is closed), so each
# operation is a public wrapper that turns a closed SDL into its failure
# and a private `session_*` function that makes the call.
#
# Memory. SDL takes its rectangles and strings by pointer, and Botlish byte
# storage can only be lent to a C call whose contract allows it (a
# byte-sized pointee: C-POINTER-BORROWING.md), which an SDL_FRect is not.
# So the scratch memory a call needs is native, from SDL_malloc: one
# SDL_FRect, a 128-byte text buffer and a 128-byte SDL_Event, written and
# read through layouts (std::binary::native::edit/view), allocated by
# `open` and freed by `close`. SDL_Event's generated layout is blocked (its
# alternatives hold C bools, which no layout field represents), so the
# event's type is read through EventType, the one field this program needs,
# at offset 0 of every alternative; the keyboard state, a C array of bool,
# is read as bytes through KeyState.
import std::abi
import std::abi::bytes
import std::binary
import std::binary::native
import std::byte
import std::char
import std::ffi::c
import std::float64
import std::list
import std::mutable_vector
import std::str
import sdl3::ctypes
import sdl3::events
import sdl3::error_h
import sdl3::init
import sdl3::keyboard
import sdl3::layouts
import sdl3::log
import sdl3::render
import sdl3::stdinc
import sdl3::timer
import sdl3::video

# An open session: the window, its renderer, the keyboard state SDL keeps
# for the program's lifetime, the native scratch memory of the calls, and
# whether presenting a frame waits for the display (vertical sync). Private
# and opaque: only this module names one, makes one or looks inside.
private opaque struct Session:
    window: std::ffi::c::Ptr[sdl3::ctypes::SDL_Window]
    renderer: std::ffi::c::Ptr[sdl3::ctypes::SDL_Renderer]
    keys: std::ffi::c::Ptr[std::ffi::c::Bool]
    rect: std::ffi::c::Ptr[sdl3::ctypes::SDL_FRect]
    text: std::ffi::c::Ptr[std::ffi::c::Char]
    event: std::ffi::c::Ptr[sdl3::ctypes::SDL_Event]
    synced: bool

# The capability to call SDL, and SDL's state: the open session, if any.
# Opaque: only this module makes one or looks inside.
opaque context struct Sdl:
    open: MutableVector[Session]

# SDL, closed. Makes no SDL call, so it needs no authority: the entry
# program installs it, `with context sdl::create()`, and `open` starts SDL.
fn create() -> Sdl:
    Sdl {open: std::mutable_vector::from_list([])}

# An SDL call failed; SDL_GetError's text has been logged already.
error SdlFailed:
    call: str

# The first field of every SDL_Event alternative: its type.
private layout EventType:
    size 128
    align 8
    field type_: std::ffi::c::UInt at 0

# SDL_GetKeyboardState's array, one C bool (a byte, 0 or 1) per scancode.
private layout KeyState:
    size 512
    align 1
    field down: array 512 of std::ffi::c::UChar at 0

# The text buffer: a NUL-terminated C string of at most 127 characters.
private layout TextBuffer:
    size 128
    align 1
    field chars: array 128 of std::ffi::c::Char at 0

private fn nul() -> std::byte::Byte:
    0

# TEXT's UTF-8 bytes and the NUL the C API needs.
private fn cstring(text: str) -> std::abi::bytes::Bytes:
    std::abi::bytes::from_list(std::str::encode_utf8(text).append(nul()))

# Writes TEXT, at most 127 characters, into the edit E of a text buffer:
# printable ASCII as itself, any other character as '?', then the NUL.
private fn write_text_unchecked(text: str, e: NativeEdit[TextBuffer]) errors IndexNotFound:
    n = std::str::length(text)
    loop i from 0 to n:
        c = std::char::scalar_value(text.char_at(i))
        code = if c >= 32 and c < 127:
            c
        else:
            63
        std::binary::store_element(e.chars, i, code)
    std::binary::store_element(e.chars, n, 0)

# Writes TEXT, its first 127 characters, through the edit E of a text
# buffer.
private fn write_chars(e: NativeEdit[TextBuffer], text: str) errors IndexNotFound:
    n = std::str::length(text)
    if n > 127:
        return text.substring(0, 127).write_text_unchecked(e):
            on LowerUnderrun:
                unit
            on UpperOverrun:
                unit
    text.write_text_unchecked(e)

# Writes TEXT into BUFFER as a C string (its first 127 characters).
private fn write_text(buffer: std::ffi::c::Ptr[std::ffi::c::Char], text: str, context sdl: Sdl) errors NativeEditNull, IndexNotFound:
    std::binary::native::edit(TextBuffer, buffer).write_chars(text)

# Logs "Icy Tower: CALL failed: " and SDL_GetError's text through SDL_Log
# (a variadic C call: the error string is its one trailing argument).
private fn log_failure(buffer: std::ffi::c::Ptr[std::ffi::c::Char], call: str, context sdl: Sdl):
    written = buffer.clone().write_text("Icy Tower: ".concat(call).concat(" failed: %s")):
        on NativeEditNull:
            return unit
        on IndexNotFound:
            return unit
    message = sdl3::error_h::SDL_GetError()
    buffer.SDL_Log(message)

# ---------------------------------------------------------------------------
# Opening and closing

private fn free_text(text: std::ffi::c::Ptr[std::ffi::c::Char], context sdl: Sdl):
    memory = std::ffi::c::erase(text)
    sdl3::stdinc::SDL_free(memory)

# Logs FAILURE, unless it is "", then releases the SDL objects and the
# scratch memory given (SDL_free of a null pointer does nothing, so a partly
# made session is released too); the caller then ends SDL. (nomethod: none
# of the six is a receiver.)
private nomethod fn release(window: std::ffi::c::Ptr[sdl3::ctypes::SDL_Window], renderer: std::ffi::c::Ptr[sdl3::ctypes::SDL_Renderer], rect: std::ffi::c::Ptr[sdl3::ctypes::SDL_FRect], text: std::ffi::c::Ptr[std::ffi::c::Char], event: std::ffi::c::Ptr[sdl3::ctypes::SDL_Event], failure: str, context sdl: Sdl):
    if failure != "":
        text.clone().log_failure(failure)
    rect_memory = std::ffi::c::erase(rect)
    sdl3::stdinc::SDL_free(rect_memory)
    event_memory = std::ffi::c::erase(event)
    sdl3::stdinc::SDL_free(event_memory)
    text.free_text()
    if not renderer.null?():
        renderer.SDL_DestroyRenderer()
    window.SDL_DestroyWindow()

# Starts SDL with video, a resizable window of WIDTH x HEIGHT titled TITLE,
# its renderer showing a WIDTH x HEIGHT logical view letterboxed into the
# window (one policy for every display density: SDL scales the logical view
# to the window's pixels), vertical sync when SYNC asks for it, and the
# scratch memory: the session of this Sdl from now on. On a failure
# everything made before it is released again (SDL_Quit included) and the
# failure is logged. Opening an open Sdl changes nothing. (nomethod: a title
# is not a receiver.)
nomethod fn open(title: str, width: std::ffi::c::Int, height: std::ffi::c::Int, sync: bool, context sdl: Sdl) errors SdlFailed:
    if not sdl.open.empty?():
        return unit
    text = std::ffi::c::retype[std::ffi::c::Char](sdl3::stdinc::SDL_malloc(128))
    if text.null?():
        fail SdlFailed {call: "SDL_malloc"}
    if not sdl3::init::SDL_Init(sdl3::init::SDL_INIT_VIDEO):
        text.clone().log_failure("SDL_Init")
        text.free_text()
        fail SdlFailed {call: "SDL_Init"}
    window = cstring(title).SDL_CreateWindow(width, height, sdl3::video::SDL_WINDOW_RESIZABLE)
    if window.null?():
        text.clone().log_failure("SDL_CreateWindow")
        text.free_text()
        sdl3::init::SDL_Quit()
        fail SdlFailed {call: "SDL_CreateWindow"}
    no_name = std::ffi::c::null[std::ffi::c::Char]()
    renderer = window.SDL_CreateRenderer(no_name)
    if renderer.null?():
        text.clone().log_failure("SDL_CreateRenderer")
        text.free_text()
        window.SDL_DestroyWindow()
        sdl3::init::SDL_Quit()
        fail SdlFailed {call: "SDL_CreateRenderer"}
    rect = std::ffi::c::retype[sdl3::ctypes::SDL_FRect](sdl3::stdinc::SDL_malloc(16))
    event = std::ffi::c::retype[sdl3::ctypes::SDL_Event](sdl3::stdinc::SDL_malloc(128))
    no_count = std::ffi::c::null[std::ffi::c::Int]()
    keys = sdl3::keyboard::SDL_GetKeyboardState(no_count)
    presented = renderer.SDL_SetRenderLogicalPresentation(width, height, sdl3::render::SDL_LOGICAL_PRESENTATION_LETTERBOX)
    if rect.null?() or event.null?() or keys.null?() or not presented:
        release(window, renderer, rect, text, event, "SDL_malloc, SDL_GetKeyboardState or SDL_SetRenderLogicalPresentation")
        sdl3::init::SDL_Quit()
        fail SdlFailed {call: "setup"}
    synced = sync and renderer.SDL_SetRenderVSync(1)
    sdl.open.push(Session {window: window, renderer: renderer, keys: keys, rect: rect, text: text, event: event, synced: synced})

# Logs FAILURE, unless it is "", and releases the open session -- the
# renderer, the window, the scratch memory -- and SDL. Closing a closed Sdl
# does nothing.
fn close(failure: str, context sdl: Sdl):
    session = sdl.open.pop():
        on IndexNotFound:
            return unit
    {window, renderer, rect, text, event} = session
    release(window, renderer, rect, text, event, failure)
    sdl3::init::SDL_Quit()

# Whether presenting a frame waits for the display (false when closed).
private fn session_synced?(context sdl: Sdl) -> bool errors IndexNotFound:
    sdl.open.element(0).synced

fn synced?(context sdl: Sdl) -> bool:
    synced = session_synced?():
        on IndexNotFound:
            return false
    synced

# ---------------------------------------------------------------------------
# Input and time

# Whether a quit was asked for (the window closed) among the events waiting
# in SDL's queue, every one of which this takes.
private fn quit_requested?(context sdl: Sdl) -> bool errors NativeViewNull, IndexNotFound:
    if not sdl3::events::SDL_PollEvent(sdl.open.element(0).event):
        return false
    if std::binary::native::view(EventType, sdl.open.element(0).event).type_ == sdl3::events::SDL_EVENT_QUIT:
        return true
    quit_requested?()

# Whether the key of SCANCODE is held, as of the last event poll.
private fn down?(scancode: int, context sdl: Sdl) -> bool errors NativeViewNull, IndexNotFound:
    std::binary::element(std::binary::native::view(KeyState, sdl.open.element(0).keys).down, scancode) != 0

# What a poll found: whether a quit was asked for, which of the keys asked
# about are held, and what failed ("" when nothing did).
struct Polled:
    quit: bool
    held: List[bool]
    failure: str

# Takes the waiting events and reads, for each of SCANCODES, whether its key
# is held.
fn poll(scancodes: List[std::ffi::c::UInt], context sdl: Sdl) -> Polled:
    if sdl.open.empty?():
        return Polled {quit: true, held: [], failure: "polling a closed SDL"}
    quit = quit_requested?():
        on NativeViewNull:
            return Polled {quit: true, held: [], failure: "reading an event"}
        on IndexNotFound:
            return Polled {quit: true, held: [], failure: "polling a closed SDL"}
    held = loop code in scancodes:
        down = down?(code):
            on NativeViewNull:
                false
            on IndexNotFound:
                false
        down
    Polled {quit: quit, held: held, failure: ""}

# Seconds since SDL started.
fn seconds(context sdl: Sdl) -> Float64 errors NonFiniteFloat:
    std::float64::from_int(sdl3::timer::SDL_GetTicksNS()) / 1000000000.0

# Sleeps SECONDS (nothing when it is not positive).
fn sleep(seconds: Float64, context sdl: Sdl) errors NonFiniteFloat:
    ns = std::float64::truncate(seconds * 1000000000.0)
    if ns > 0 and ns < 1000000000:
        sdl3::timer::SDL_DelayNS(ns)

# SDL's high-resolution counter: a different value every run.
fn counter(context sdl: Sdl) -> int:
    sdl3::timer::SDL_GetPerformanceCounter()

# ---------------------------------------------------------------------------
# Drawing. Each returns whether SDL drew (false when SDL is closed): a public
# operation that takes and returns values, and the private `session_*`
# function that makes the SDL call with the open session's pointers where
# the context stores them (an element place, IndexNotFound while SDL is
# closed). Nothing returns a pointer: a public function returning one would
# hand every importer the pointer.

# The current color: R, G, B, opaque.
private nomethod fn session_color(r: std::ffi::c::UChar, g: std::ffi::c::UChar, b: std::ffi::c::UChar, context sdl: Sdl) -> bool errors IndexNotFound:
    sdl.open.element(0).renderer.SDL_SetRenderDrawColor(r, g, b, 255)

nomethod fn color(r: std::ffi::c::UChar, g: std::ffi::c::UChar, b: std::ffi::c::UChar, context sdl: Sdl) -> bool:
    drawn = session_color(r, g, b):
        on IndexNotFound:
            return false
    drawn

private fn session_clear(context sdl: Sdl) -> bool errors IndexNotFound:
    sdl.open.element(0).renderer.SDL_RenderClear()

fn clear(context sdl: Sdl) -> bool:
    drawn = session_clear():
        on IndexNotFound:
            return false
    drawn

private fn session_present(context sdl: Sdl) -> bool errors IndexNotFound:
    sdl.open.element(0).renderer.SDL_RenderPresent()

fn present(context sdl: Sdl) -> bool:
    drawn = session_present():
        on IndexNotFound:
            return false
    drawn

# Fills the rectangle at X, Y (its top left corner, in view coordinates) of
# W x H in the current color. The four Float64s cross into C as the
# SDL_FRect's floats: rounded to binary32, an overflow NonFiniteFloat.
private nomethod fn session_fill(x: Float64, y: Float64, w: Float64, h: Float64, context sdl: Sdl) -> bool errors NonFiniteFloat, IndexNotFound, NativeEditNull:
    e = std::binary::native::edit(sdl3::layouts::SDL_FRect, sdl.open.element(0).rect)
    std::binary::store(e, sdl3::layouts::SDL_FRect.x, x)
    std::binary::store(e, sdl3::layouts::SDL_FRect.y, y)
    std::binary::store(e, sdl3::layouts::SDL_FRect.w, w)
    std::binary::store(e, sdl3::layouts::SDL_FRect.h, h)
    sdl.open.element(0).renderer.SDL_RenderFillRect(sdl.open.element(0).rect)

nomethod fn fill(x: Float64, y: Float64, w: Float64, h: Float64, context sdl: Sdl) -> bool errors NonFiniteFloat:
    drawn = session_fill(x, y, w, h):
        on IndexNotFound:
            return false
        on NativeEditNull:
            return false
    drawn

# A line from X1, Y1 to X2, Y2 in the current color (C float arguments).
private nomethod fn session_line(x1: Float64, y1: Float64, x2: Float64, y2: Float64, context sdl: Sdl) -> bool errors NonFiniteFloat, IndexNotFound:
    sdl.open.element(0).renderer.SDL_RenderLine(x1, y1, x2, y2)

nomethod fn line(x1: Float64, y1: Float64, x2: Float64, y2: Float64, context sdl: Sdl) -> bool errors NonFiniteFloat:
    drawn = session_line(x1, y1, x2, y2):
        on IndexNotFound:
            return false
    drawn

# TEXT in SDL's built-in 8 x 8 debug font, its top left corner at X, Y.
private nomethod fn session_text(x: Float64, y: Float64, text: str, context sdl: Sdl) -> bool errors NonFiniteFloat, IndexNotFound, NativeEditNull:
    std::binary::native::edit(TextBuffer, sdl.open.element(0).text).write_chars(text)
    sdl.open.element(0).renderer.SDL_RenderDebugText(x, y, sdl.open.element(0).text)

nomethod fn text(x: Float64, y: Float64, text: str, context sdl: Sdl) -> bool errors NonFiniteFloat:
    drawn = session_text(x, y, text):
        on IndexNotFound:
            return false
        on NativeEditNull:
            return false
    drawn

# Scales everything drawn after it by FACTOR (C float arguments).
private nomethod fn session_scale(factor: Float64, context sdl: Sdl) -> bool errors NonFiniteFloat, IndexNotFound:
    sdl.open.element(0).renderer.SDL_SetRenderScale(factor, factor)

nomethod fn scale(factor: Float64, context sdl: Sdl) -> bool errors NonFiniteFloat:
    drawn = session_scale(factor):
        on IndexNotFound:
            return false
    drawn