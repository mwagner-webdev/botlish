# options.bot -- the command line of the Icy Tower vertical slice
# (ICY-TOWER-VERTICAL-SLICE-1.md). Pure: the arguments are a List of
# Strings (the program's argv() without its name).
#
#   --seed N       the tower (default: from the clock when played, 7 when
#                  headless)
#   --frames N     stop after N frames (default: until quit)
#   --headless     no SDL: the autopilot plays fixed 60 Hz frames, the run
#                  prints its summary line (needs --frames)
#   --autopilot    the deterministic player instead of the keyboard
#   --fixed-step   every frame lasts 1/60 s, whatever the clock says
#   --help         print the usage and exit
#
# A number N is the decimal text of a nonnegative Int, as
# std::int::to_string writes it (NUMERIC-TEXT-BOUNDARY-MILESTONE-1.md):
# digits, no leading zero, of any length.
import std::int
import std::list
import std::str

struct Options:
    seed: int
    seeded: bool
    frames: int
    headless: bool
    autopilot: bool
    fixed_step: bool
    help: bool

# The arguments are not a command line this program takes.
error UsageError:
    message: str

fn usage() -> List[str]:
    [
        "usage: icy-tower [--seed N] [--frames N] [--headless] [--autopilot] [--fixed-step] [--help]",
        "  play: Left/A and Right/D run, landing bounces, R restarts after a fall, Escape quits",
        "  --headless --frames N: no window; the autopilot plays N fixed frames and the run prints its summary",
    ]

# The value of TEXT, the decimal text of a nonnegative Int.
fn number(text: str) -> int errors UsageError:
    n = std::int::from_string(text):
        on InvalidIntegerText:
            fail UsageError {message: "not a number: ".concat(text)}
    if n < 0:
        fail UsageError {message: "not a number: ".concat(text)}
    n

fn flag?(name: str) -> bool:
    name == "--headless" or name == "--autopilot" or name == "--fixed-step" or name == "--help"

fn valued?(name: str) -> bool:
    name == "--seed" or name == "--frames"

# Fails unless every argument of ARGS from I on is a flag or an option
# followed by a number.
fn check(args: List[str], i: int) errors UsageError:
    if i >= std::list::length(args):
        return unit
    arg = args.get(i, "")
    if arg.flag?():
        return args.check(i + 1)
    if not arg.valued?():
        fail UsageError {message: "unknown option: ".concat(arg)}
    if i + 1 >= std::list::length(args):
        fail UsageError {message: arg.concat(" needs a number")}
    args.get(i + 1, "").number()
    args.check(i + 2)

fn given?(args: List[str], name: str) -> bool:
    loop arg in args:
        if arg == name:
            return true
    false

# The number after the option NAME in ARGS, else FALLBACK.
fn value(args: List[str], name: str, fallback: int) -> int errors UsageError:
    n = std::list::length(args)
    loop i from 0 to n:
        if args.get(i, "") == name:
            return args.get(i + 1, "").number()
    fallback

# The options ARGS state.
fn parse(args: List[str]) -> Options errors UsageError:
    args.check(0)
    headless = args.given?("--headless")
    frames = args.value("--frames", 0)
    if headless and frames <= 0:
        fail UsageError {message: "--headless needs --frames N (N > 0)"}
    Options {
        seed: args.value("--seed", 7),
        seeded: args.given?("--seed"),
        frames: frames,
        headless: headless,
        autopilot: args.given?("--autopilot"),
        fixed_step: args.given?("--fixed-step"),
        help: args.given?("--help"),
    }
