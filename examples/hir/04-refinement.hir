# Refinements: a predicate proves a fact about the binding it tests, only in
# the branch where it holds. A test decided by static types marks the other
# branch unreachable.
#
# expect: [42, "hi", "other", "yes"]
#
# Lowers to 04-refinement.ir.

program s2 binds b1 describe, b6 five, b7 known
e1 bind b1 describe : block(e2)/1 -> any
    e2 block s3 (b2 v) captures () : block(e2)/1 -> any
        e3 if : any
            e4 call native(integer?) : bool
                e5 ref b3 integer? : native integer?
                e6 ref b2 v : any
            then s4 refines b2 v : int
                e7 call native(+) : int
                    e8 ref b4 + : native +
                    e9 ref b2 v : int
                    e10 const 1 : int
            else s5
                e11 if : str
                    e12 call native(string?) : bool
                        e13 ref b5 string? : native string?
                        e14 ref b2 v : any
                    then s6 refines b2 v : str
                        e15 ref b2 v : str
                    else s7
                        e16 const other : str
e17 bind b6 five : int
    e18 const 5 : int
e19 bind b7 known : str
    e20 if : str
        e21 call native(integer?) = true : bool
            e22 ref b3 integer? : native integer?
            e23 ref b6 five : int
        then s8 refines b6 five : int
            e24 const yes : str
        else s9
            e25 const no : str unreachable
e26 call native(list) : list
    e27 ref b8 list : native list
    e28 call block(e2) : int
        e29 ref b1 describe : block(e2)/1 -> any
        e30 const 41 : int
    e31 call block(e2) : str
        e32 ref b1 describe : block(e2)/1 -> any
        e33 const hi : str
    e34 call block(e2) : str
        e35 ref b1 describe : block(e2)/1 -> any
        e36 call native(list) : List[never]
            e37 ref b8 list : native list
    e38 ref b7 known : str
