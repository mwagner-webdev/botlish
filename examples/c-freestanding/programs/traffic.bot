# A traffic-light controller and a CRC-8 (C-COMPILE-FREESTANDING-MILESTONE-1.md):
# a program whose every Int the compiler proves fits int64_t -- its integer
# domains bound them -- so the C it compiles to calls no runtime service and
# links with no Botlish runtime and no C library.
#
# expect: [State {light: Light::Green, left: 19}, 224, 8, 250, 5]

type Byte = Int in 0..255
type Ticks = Int in 0..1000

enum Light:
    Red,
    Green,
    Yellow

struct State:
    light: Light
    left: Ticks

fn duration(l: Light) -> Ticks:
    if l == Light::Red:
        30
    elif l == Light::Green:
        25
    else:
        5

fn next(l: Light) -> Light:
    if l == Light::Red:
        Light::Green
    elif l == Light::Green:
        Light::Yellow
    else:
        Light::Red

fn tick(s: State) -> State:
    left = s.left
    if left < 1:
        n = next(s.light)
        State {light: n, left: duration(n)}
    else:
        State {light: s.light, left: left - 1}

fn run(steps: Ticks) -> State:
    fold i from 0 to steps with intermediate s State {light: Light::Red, left: 30}:
        tick(s)

fn crc_step(c: Byte) -> int:
    if bit_and(c, 1) == 1:
        bit_xor(c.shift_right(1), 140)
    else:
        c.shift_right(1)

fn crc8(b: Byte) -> int:
    fold i from 0 to 8 with intermediate c b:
        crc_step(c.mod(256))

fn gcd(a: Ticks, b: Ticks) -> Ticks:
    if b == 0:
        return a
    b.gcd(a.mod(b))

[run(100), crc8(49), crc8(200), gcd(1000, 750), duration(Light::Yellow)]
