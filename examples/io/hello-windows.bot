# The portable Hello World on Windows (CONTEXT-TRAITS.md;
# WINDOWS-X86-64-MILESTONE-2.md): examples/io/hello.bot with another context.
# hello() is the same function: it declares no context, and io::print_line
# requires the io::IO context trait; the installed windows::io::WindowsIO is
# the one context that implements it, so the call compiles to a direct call
# of windows::io::write_text -- one kernel32 WriteFile of "Hello, world!\n" to
# the process's standard output handle (GetStdHandle), with no C runtime in
# the path.
import io
import windows::io

fn hello() errors io::WriteFailed:
    io::print_line("Hello, world!")

with context windows::io::create()

hello():
    on io::WriteFailed:
        unit
