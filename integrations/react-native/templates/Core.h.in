// @CORE@.h -- the Botlish native library "@LIBRARY@" behind the React Native
// module @MODULE@: every C ABI call, its ownership, its errors and its thread.
// Generated by botlish-react-native @TOOL_VERSION@ from @LIBRARY@.manifest.json
// (sha256 @MANIFEST_SHA@); do not edit.
//
// This layer knows no JavaScript engine: its arguments are what a
// JavaScript caller can pass (a number is a double), its failures are data
// (Failure), so that it is tested on its own. @MODULE@Module.cpp is the JSI
// side: it turns a Failure into a thrown JavaScript error.
//
// The library's contract (its manifest: threading "thread-affine",
// reentrancy "refused"): an instance belongs to the thread that created it;
// every call and its destruction come from that thread, one at a time.
// Here:
//   * the instance is created at the first call, on the calling thread,
//     which owns it from then on; a call from any other thread is refused
//     (invocation WRONG-THREAD) before the C ABI is entered;
//   * it is destroyed on its own thread only: when the module goes on that
//     thread, at once; when the module goes on another thread, by its own
//     thread's next call into any module of this library or at that thread's
//     exit -- never by a foreign thread;
//   * a call made while another runs is refused (invocation REENTRANT-CALL);
//   * after invalidate(), or once the instance's thread has ended, every call
//     is refused (invocation INVALIDATED, INSTANCE-GONE);
//   * every owned result and error is released on every path (RAII).
#pragma once

#include <cstdint>
#include <memory>
#include <string>
#include <vector>

#include "@HEADER@"

namespace @NAMESPACE@ {

// A field of a declared error's payload, as the C ABI gives it.
struct Field {
  enum Kind { Int, Bool, Float64, Str, Other };
  Kind kind = Other;
  std::string name;
  int64_t integer = 0;
  bool boolean = false;
  double number = 0;
  std::string text;
};

// A call's failure. jsClass is the JavaScript error class it becomes:
// "TypeError" or "RangeError" for an argument JavaScript passed that the
// library's types cannot take (category "argument") or a result JavaScript
// cannot hold exactly (category "result"), else "Error" named BotlishError
// (categories declared, runtime, boundary, invocation, internal,
// unavailable).
struct Failure {
  std::string jsClass;
  std::string code;
  std::string category;
  std::string identity;
  std::string method;
  std::string message;
  std::vector<Field> fields;
};

class Slot;

class @CORE@ {
 public:
  @CORE@();
  // On any thread: the instance is destroyed on its own thread only.
  ~@CORE@();
  @CORE@(const @CORE@ &) = delete;
  @CORE@ &operator=(const @CORE@ &) = delete;

@CORE_DECLS@

  // No later call succeeds (invocation INVALIDATED); the instance is
  // destroyed now when this is its thread, else by its thread.
  void invalidate();

  // The module's and the process's counters, as a JSON object.
  std::string diagnostics() const;

 private:
  struct Call;
  @PREFIX@_instance *enter(const char *method);
  std::shared_ptr<Slot> slot_;
};

} // namespace @NAMESPACE@
