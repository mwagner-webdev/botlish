  size_t len = 0;
  std::string identity, message;
  if (@PREFIX@_error_identity(error, &ptr, &len) == @PREFIX@_STATUS_OK) identity = text(ptr, len);
  if (@PREFIX@_error_message(error, &ptr, &len) == @PREFIX@_STATUS_OK) message = text(ptr, len);
  Failure f = failure("Error", code, category, identity.c_str(), method, message);
  size_t count = @PREFIX@_error_field_count(error);
  for (size_t i = 0; i < count; i++) {
    Field field;
    if (@PREFIX@_error_field_name(error, i, &ptr, &len) == @PREFIX@_STATUS_OK) field.name = text(ptr, len);
    switch (@PREFIX@_error_field_type(error, i)) {
      case @PREFIX@_FIELD_INT:
        if (@PREFIX@_error_field_int(error, i, &field.integer) == @PREFIX@_STATUS_OK) field.kind = Field::Int;
        break;
      case @PREFIX@_FIELD_BOOL:
        if (@PREFIX@_error_field_bool(error, i, &field.boolean) == @PREFIX@_STATUS_OK) field.kind = Field::Bool;
        break;
      case @PREFIX@_FIELD_FLOAT64:
        if (@PREFIX@_error_field_float64(error, i, &field.number) == @PREFIX@_STATUS_OK) field.kind = Field::Float64;
        break;
      case @PREFIX@_FIELD_STR:
        if (@PREFIX@_error_field_str(error, i, &ptr, &len) == @PREFIX@_STATUS_OK) {
          field.kind = Field::Str;
          field.text = text(ptr, len);
