      {@PREFIX@_STATUS_DECLARED, "BOTLISH_DECLARED", "declared"},
      {@PREFIX@_STATUS_RUNTIME, "BOTLISH_RUNTIME", "runtime"},
      {@PREFIX@_STATUS_BOUNDARY, "BOTLISH_BOUNDARY", "boundary"},
      {@PREFIX@_STATUS_INVOCATION, "BOTLISH_INVOCATION", "invocation"},
      {@PREFIX@_STATUS_INTERNAL, "BOTLISH_INTERNAL", "internal"},
  };
  const char *code = "BOTLISH_INTERNAL", *category = "internal";
  for (const auto &kind : kinds) {
    if (kind.status == status) {
      code = kind.code;
      category = kind.category;
