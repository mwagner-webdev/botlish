// One module's instance, shared by the module and the thread that created
// it (Reaper): whichever goes last frees nothing it does not own.
class Slot {
 public:
  std::mutex mutex;
  std::thread::id owner;
  long ownerThread = 0;
  @PREFIX@_instance *instance = nullptr;
  uint64_t serial = 0;
  bool created = false;
  bool invalidated = false;
  bool destroyed = false;
  bool busy = false;
  bool ownerEnded = false;
  std::atomic<uint64_t> calls{0};

  // Destroys the instance, on its own thread, with MUTEX held.
  void destroyLocked(const char *why) {
    if (instance != nullptr) {
      int32_t status = @PREFIX@_destroy(instance);
      if (status == @PREFIX@_STATUS_OK) {
        totals().destroyed++;
      } else {
        totals().destroyFailed++;
      }
      note("instance %llu destroyed on thread %ld (%s): status %d", static_cast<unsigned long long>(serial),
          threadNumber(), why, static_cast<int>(status));
      instance = nullptr;
    }
    destroyed = true;
  }
};

namespace {

// The slots whose instances this thread created. An instance whose module
// went on another thread is destroyed here: at this thread's next call into
// the library, or at its exit -- on its own thread, as the library
// requires.
struct Reaper {
  std::vector<std::shared_ptr<Slot>> slots;

  void sweep() {
    std::vector<std::shared_ptr<Slot>> live;
    for (auto &slot : slots) {
      std::lock_guard<std::mutex> lock(slot->mutex);
      if (!slot->destroyed && slot->invalidated && !slot->busy) {
        slot->destroyLocked("its module went on another thread; reaped at this thread's next call");
        totals().reapedOnCall++;
      }
      if (!slot->destroyed) live.push_back(slot);
    }
    slots.swap(live);
  }

  ~Reaper() {
    for (auto &slot : slots) {
      std::lock_guard<std::mutex> lock(slot->mutex);
      if (!slot->destroyed) {
        slot->destroyLocked("its thread exits");
        totals().reapedAtExit++;
      }
      slot->ownerEnded = true;
    }
  }
};

// This thread's Reaper, made at the thread's first instance (after the
// library's own thread-local state, so that it is destroyed before that
// state at the thread's exit).
thread_local Reaper *tlsReaper = nullptr;

Reaper &reaper() {
  thread_local Reaper r;
  tlsReaper = &r;
  return r;
}

} // namespace

// A call in progress: the instance, entered on its own thread, left on
// every path.
struct @CORE@::Call {
  Slot &slot;
  @PREFIX@_instance *instance;
  Call(@CORE@ &core, const char *method) : slot(*core.slot_), instance(core.enter(method)) {}
  Call(const Call &) = delete;
  Call &operator=(const Call &) = delete;
  ~Call() {
    std::lock_guard<std::mutex> lock(slot.mutex);
    slot.busy = false;
    if (slot.invalidated && !slot.destroyed) slot.destroyLocked("invalidated during a call");
  }

  // Runs the C ABI call F, timed.
  template <typename F>
  int32_t run(F f) {
    auto start = std::chrono::steady_clock::now();
    int32_t status = f();
    auto nanos = std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - start).count();
    totals().nativeNanos += static_cast<uint64_t>(nanos);
    totals().calls++;
    slot.calls++;
    return status;
  }
};

@CORE@::@CORE@() : slot_(std::make_shared<Slot>()) {}

@CORE@::~@CORE@() {
  invalidate();
}

void @CORE@::invalidate() {
  Slot &s = *slot_;
  std::lock_guard<std::mutex> lock(s.mutex);
  if (s.invalidated) return;
  s.invalidated = true;
  if (!s.created) {
    s.destroyed = true;
    return;
  }
  if (s.destroyed || s.busy) return;
  if (std::this_thread::get_id() == s.owner) {
    s.destroyLocked("its module was invalidated on its thread");
  } else {
    totals().orphaned++;
    note("instance %llu orphaned: its module went on thread %ld; its own thread %ld destroys it",
        static_cast<unsigned long long>(s.serial), threadNumber(), s.ownerThread);
  }
}

@PREFIX@_instance *@CORE@::enter(const char *method) {
  if (tlsReaper != nullptr) tlsReaper->sweep();
  Slot &s = *slot_;
  std::unique_lock<std::mutex> lock(s.mutex);
  if (s.invalidated) {
    throw invocation(method, "INVALIDATED", "the module was invalidated: its Botlish instance is gone");
  }
  if (s.ownerEnded) {
    throw invocation(method, "INSTANCE-GONE",
        "the module's Botlish instance was destroyed with its thread " + std::to_string(s.ownerThread) +
            ", which has ended");
  }
  if (s.created && std::this_thread::get_id() != s.owner) {
    throw invocation(method, "WRONG-THREAD",
        "the module's Botlish instance belongs to thread " + std::to_string(s.ownerThread) + ", and this is thread " +
            std::to_string(threadNumber()) + " (a Botlish native library instance is thread-affine)");
  }
  if (s.destroyed) {
    throw invocation(method, "INSTANCE-GONE", "the module's Botlish instance was destroyed");
  }
  if (s.busy) {
    throw invocation(method, "REENTRANT-CALL", "a call is already running on the module's Botlish instance");
  }
  if (!s.created) {
    OwnedError error;
    @PREFIX@_instance *instance = nullptr;
    int32_t status = @PREFIX@_create(&instance, &error.value);
    if (status != @PREFIX@_STATUS_OK) {
      if (error.value != nullptr) totals().errorsAcquired++;
      Failure f = failureOf(method, status, error.value);
      f.message = std::string(method) + ": the Botlish instance could not be created: " + f.message;
      throw f;
    }
    s.instance = instance;
    s.owner = std::this_thread::get_id();
    s.ownerThread = threadNumber();
    s.created = true;
    s.serial = ++totals().created;
    reaper().slots.push_back(slot_);
    note("instance %llu created on thread %ld", static_cast<unsigned long long>(s.serial), s.ownerThread);
  }
  s.busy = true;
  if (tracing()) note("%s on thread %ld", method, threadNumber());
  return s.instance;
}

std::string @CORE@::diagnostics() const {
  const Totals &t = totals();
  const Slot &s = *slot_;
  char buffer[1024];
  std::snprintf(buffer, sizeof buffer,
      "{\"library\": \"%s\", \"thread\": %ld, \"module\": {\"created\": %s, \"serial\": %llu, \"ownerThread\": %ld, "
      "\"calls\": %llu}, \"process\": {\"instancesCreated\": %llu, \"instancesDestroyed\": %llu, "
      "\"destroyFailed\": %llu, \"orphaned\": %llu, \"reapedOnCall\": %llu, \"reapedAtExit\": %llu, \"calls\": %llu, "
      "\"nativeNanos\": %llu, \"resultsAcquired\": %llu, \"resultsReleased\": %llu, \"errorsAcquired\": %llu, "
      "\"errorsReleased\": %llu}}",
      kLibrary, threadNumber(), s.created ? "true" : "false", static_cast<unsigned long long>(s.serial), s.ownerThread,
      static_cast<unsigned long long>(s.calls.load()), static_cast<unsigned long long>(t.created.load()),
      static_cast<unsigned long long>(t.destroyed.load()), static_cast<unsigned long long>(t.destroyFailed.load()),
      static_cast<unsigned long long>(t.orphaned.load()), static_cast<unsigned long long>(t.reapedOnCall.load()),
      static_cast<unsigned long long>(t.reapedAtExit.load()), static_cast<unsigned long long>(t.calls.load()),
      static_cast<unsigned long long>(t.nativeNanos.load()), static_cast<unsigned long long>(t.resultsAcquired.load()),
      static_cast<unsigned long long>(t.resultsReleased.load()), static_cast<unsigned long long>(t.errorsAcquired.load()),
      static_cast<unsigned long long>(t.errorsReleased.load()));
  return buffer;
}

