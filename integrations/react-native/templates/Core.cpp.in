  return on;
}

// A lifecycle event (an instance created, destroyed, orphaned): logged to
// logcat (tag BotlishRN) on Android, to standard error elsewhere when
// tracing.
void note(const char *format, ...) {
  char line[400];
  va_list ap;
  va_start(ap, format);
  std::vsnprintf(line, sizeof line, format, ap);
  va_end(ap);
#ifdef __ANDROID__
  __android_log_print(ANDROID_LOG_INFO, "BotlishRN", "%s: %s", kLibrary, line);
#else
  if (tracing()) std::fprintf(stderr, "BotlishRN %s: %s\n", kLibrary, line);
#endif
}

[[maybe_unused]] std::string text(const uint8_t *ptr, size_t len) {
