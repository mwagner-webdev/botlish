#endif
}

// Tracing logs every call's method and thread: the Android system property
// debug.botlish.rn.trace, or BOTLISH_RN_TRACE elsewhere, set to 1.
bool tracing() {
  static const bool on = [] {
#ifdef __ANDROID__
    char value[PROP_VALUE_MAX] = {0};
    __system_property_get("debug.botlish.rn.trace", value);
    return std::strcmp(value, "1") == 0;
#else
    const char *value = std::getenv("BOTLISH_RN_TRACE");
    return value != nullptr && std::strcmp(value, "1") == 0;
#endif
