# CMakeLists.txt -- the Pure C++ TurboModule @MODULE@ over the Botlish native
# library "@LIBRARY@", for the app's own native build. Generated by
# botlish-react-native @TOOL_VERSION@; do not edit.
#
# React Native's Android autolinking adds this directory to the app's
# CMake build (react-native.config.js: cxxModuleCMakeListsPath) after the
# Codegen library the app generates from src/Native@MODULE@.ts
# (react_codegen_@SPEC@), and links the target into libappmodules.so. The
# Botlish library itself is the prebuilt shared object the package holds,
# checked here against the digest its manifest records; the Android build
# packages it into the APK beside libappmodules.so.
cmake_minimum_required(VERSION 3.13)
project(@CMAKE_TARGET@ CXX)

if(NOT ANDROID_ABI STREQUAL "arm64-v8a")
  message(FATAL_ERROR "@NPM_NAME@: there is no Botlish library \"@LIBRARY@\" for the Android ABI ${ANDROID_ABI}: this package holds one for arm64-v8a only. Build the app for arm64-v8a alone (reactNativeArchitectures=arm64-v8a in android/gradle.properties).")
endif()

if(DEFINED ANDROID_PLATFORM_LEVEL AND ANDROID_PLATFORM_LEVEL LESS @MIN_API@)
  message(FATAL_ERROR "@NPM_NAME@: the app's minimum Android API level is ${ANDROID_PLATFORM_LEVEL}; this package needs @MIN_API@ (React Native @RN_MAJOR_MINOR@'s floor; the Botlish library's own is @LIBRARY_API@).")
endif()

set(BOTLISH_LIBRARY "${CMAKE_CURRENT_LIST_DIR}/../native/android/arm64-v8a/lib@LIBRARY@.so")
if(NOT EXISTS "${BOTLISH_LIBRARY}")
  message(FATAL_ERROR "@NPM_NAME@: ${BOTLISH_LIBRARY} is missing: the package is incomplete; generate it again.")
endif()
file(SHA256 "${BOTLISH_LIBRARY}" BOTLISH_LIBRARY_SHA256)
if(NOT BOTLISH_LIBRARY_SHA256 STREQUAL "@SHARED_SHA@")
  message(FATAL_ERROR "@NPM_NAME@: ${BOTLISH_LIBRARY} is not the library this package was generated for (SHA-256 ${BOTLISH_LIBRARY_SHA256}, expected @SHARED_SHA@).")
endif()

add_library(@IMPORTED_TARGET@ SHARED IMPORTED)
set_target_properties(@IMPORTED_TARGET@ PROPERTIES IMPORTED_LOCATION "${BOTLISH_LIBRARY}")

add_library(@CMAKE_TARGET@ STATIC
  ../cpp/@MODULE@Module.cpp
  ../cpp/@CORE@.cpp)
set_target_properties(@CMAKE_TARGET@ PROPERTIES
  CXX_STANDARD 20
  CXX_STANDARD_REQUIRED ON
  CXX_EXTENSIONS OFF
  POSITION_INDEPENDENT_CODE ON)
target_include_directories(@CMAKE_TARGET@ PUBLIC ../cpp ../include)
target_link_libraries(@CMAKE_TARGET@ jsi reactnative react_codegen_@SPEC@ @IMPORTED_TARGET@ log)
