// index.ts -- the Botlish native library "@LIBRARY@" as the React Native
// module @MODULE@. Generated by botlish-react-native @TOOL_VERSION@ from
// @LIBRARY@.manifest.json (sha256 @MANIFEST_SHA@); do not edit.
//
// Every function calls the library synchronously, on the JavaScript
// thread, through a Pure C++ TurboModule (React Native's New Architecture,
// Hermes and JSI). Arguments are checked here before the native module
// sees them:
//
//   * a missing or extra argument, or one of the wrong JavaScript type, is
//     a TypeError (code BOTLISH_ARGUMENT_COUNT, BOTLISH_ARGUMENT_TYPE);
//   * an int argument must be a safe integer (Number.isSafeInteger) and a
//     float64 argument finite, else a RangeError (BOTLISH_ARGUMENT_RANGE):
//     nothing is ever rounded;
//   * an int result JavaScript cannot hold exactly is a RangeError
//     (BOTLISH_UNSAFE_RESULT).
//
// What the library reports is a BotlishError: `category` declared (one of
// the export's declared errors; `identity` is its canonical Botlish name
// and `fields` its payload), runtime, boundary, invocation (WRONG-THREAD,
// REENTRANT-CALL, INVALIDATED, INSTANCE-GONE), internal, or unavailable (no native
// module: this package runs on Android arm64-v8a only).
import Native@MODULE@ from './Native@MODULE@';
import type { Spec } from './Native@MODULE@';

/** What this package was generated from. */
export const library = {
  name: '@LIBRARY@',
  module: '@MODULE@',
  target: '@TARGET@',
  abis: ['arm64-v8a'],
  manifestSha256: '@MANIFEST_SHA@',
  sharedSha256: '@SHARED_SHA@',
  runtimeAbi: '@RUNTIME_ABI@',
  generator: 'botlish-react-native @TOOL_VERSION@',
} as const;

export type BotlishErrorCategory =
  | 'declared'
  | 'runtime'
  | 'boundary'
  | 'invocation'
  | 'internal'
  | 'unavailable';

export type BotlishField = number | string | boolean | null;

/** A failure the Botlish library reported (or its module's absence). */
export class BotlishError extends Error {
  readonly code: string;
  readonly category: BotlishErrorCategory;
  readonly identity: string;
  readonly method: string;
  readonly library: string;
  readonly fields: Readonly<Record<string, BotlishField>>;

  constructor(
    message: string,
    details: {
      code: string;
      category: BotlishErrorCategory;
      identity: string;
      method: string;
      fields?: Record<string, BotlishField>;
    },
  ) {
    super(message);
    this.name = 'BotlishError';
    this.code = details.code;
    this.category = details.category;
    this.identity = details.identity;
    this.method = details.method;
    this.library = library.name;
    this.fields = Object.freeze({ ...(details.fields ?? {}) });
  }
}

/** Whether E is a BotlishError of this library (and, given IDENTITY, that one). */
export function isBotlishError(e: unknown, identity?: string): e is BotlishError {
  return e instanceof BotlishError && (identity === undefined || e.identity === identity);
}

function argument_error(
  kind: 'TypeError' | 'RangeError',
  code: string,
  method: string,
  message: string,
): Error {
  const error = kind === 'TypeError' ? new TypeError(`${method}: ${message}`) : new RangeError(`${method}: ${message}`);
  (error as Error & { code: string }).code = code;
  return error;
}

function check_count(method: string, actual: number, expected: number): void {
  if (actual !== expected) {
    throw argument_error('TypeError', 'BOTLISH_ARGUMENT_COUNT', method,
      `takes ${expected} argument${expected === 1 ? '' : 's'}, not ${actual}`);
  }
}

function check_int(method: string, position: number, name: string, value: unknown): void {
  if (typeof value !== 'number') {
    throw argument_error('TypeError', 'BOTLISH_ARGUMENT_TYPE', method,
      `argument ${position} (${name}) must be a number, not ${value === null ? 'null' : typeof value}`);
  }
  if (!Number.isSafeInteger(value)) {
    throw argument_error('RangeError', 'BOTLISH_ARGUMENT_RANGE', method,
      `argument ${position} (${name}) must be a safe integer, not ${String(value)}`);
  }
}

function check_float64(method: string, position: number, name: string, value: unknown): void {
  if (typeof value !== 'number') {
    throw argument_error('TypeError', 'BOTLISH_ARGUMENT_TYPE', method,
      `argument ${position} (${name}) must be a number, not ${value === null ? 'null' : typeof value}`);
  }
  if (!Number.isFinite(value)) {
    throw argument_error('RangeError', 'BOTLISH_ARGUMENT_RANGE', method,
      `argument ${position} (${name}) must be a finite number, not ${String(value)}`);
  }
}

function check_bool(method: string, position: number, name: string, value: unknown): void {
  if (typeof value !== 'boolean') {
    throw argument_error('TypeError', 'BOTLISH_ARGUMENT_TYPE', method,
      `argument ${position} (${name}) must be a boolean, not ${value === null ? 'null' : typeof value}`);
  }
}

function check_str(method: string, position: number, name: string, value: unknown): void {
  if (typeof value !== 'string') {
    throw argument_error('TypeError', 'BOTLISH_ARGUMENT_TYPE', method,
      `argument ${position} (${name}) must be a string, not ${value === null ? 'null' : typeof value}`);
  }
}

function native_module(method: string): Spec {
  if (Native@MODULE@ == null) {
    throw new BotlishError(
      `${method}: the native module @MODULE@ is not available (the Botlish library "@LIBRARY@" is built for Android arm64-v8a only, in an app with React Native's New Architecture)`,
      { code: 'BOTLISH_UNAVAILABLE', category: 'unavailable', identity: 'MODULE-UNAVAILABLE', method },
    );
  }
  return Native@MODULE@;
}

// A native failure as a BotlishError; any other error unchanged. (The
// helpers' names hold an underscore: no generated function's name does.)
function rethrow_native(e: unknown): never {
  if (e instanceof Error && e.name === 'BotlishError' && !(e instanceof BotlishError)) {
    const raw = e as Error & {
      code?: string;
      category?: BotlishErrorCategory;
      identity?: string;
      method?: string;
      fields?: Record<string, BotlishField>;
    };
    throw new BotlishError(raw.message, {
      code: raw.code ?? 'BOTLISH_INTERNAL',
      category: raw.category ?? 'internal',
      identity: raw.identity ?? '',
      method: raw.method ?? '',
      fields: raw.fields,
    });
  }
  throw e;
}

/** The declared errors of each function, by canonical Botlish name. */
export const declaredErrors = {
@ERRORS@
} as const;

@WRAPPERS@

export type BotlishDiagnostics = {
  library: string;
  thread: number;
  module: { created: boolean; serial: number; ownerThread: number; calls: number };
  process: {
    instancesCreated: number;
    instancesDestroyed: number;
    destroyFailed: number;
    orphaned: number;
    reapedOnCall: number;
    reapedAtExit: number;
    calls: number;
    nativeNanos: number;
    resultsAcquired: number;
    resultsReleased: number;
    errorsAcquired: number;
    errorsReleased: number;
  };
};

/** The module's and the process's counters: instances, calls, the owned
 * results and errors acquired and released, the time spent in the C ABI. */
export function diagnostics(): BotlishDiagnostics {
  check_count('diagnostics', arguments.length, 0);
  return JSON.parse(native_module('diagnostics').botlishDiagnostics()) as BotlishDiagnostics;
}
