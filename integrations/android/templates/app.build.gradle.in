// Generated by botlish-android @TOOL_VERSION@ from the Botlish application
// library @LIBRARY@ (manifest SHA-256 @MANIFEST_SHA256@) and SDL @SDL_VERSION@
// (the package @SDL3_PACKAGE@ @SDL3_VERSION@): do not edit.
//
// The native libraries are the application library and SDL as their
// packages built them (src/main/botlish/arm64-v8a, imported by
// src/main/cpp/CMakeLists.txt, which also builds libmain.so, the SDL_main
// shim): arm64-v8a only.
plugins {
    id 'com.android.application'
}

android {
    namespace = "@APPLICATION_ID@"
    compileSdk = @COMPILE_SDK@
    ndkVersion = "@NDK_REVISION@"

    defaultConfig {
        applicationId "@APPLICATION_ID@"
        minSdk @MIN_SDK@
        targetSdk @TARGET_SDK@
        versionCode @VERSION_CODE@
        versionName "@VERSION_NAME@"
        ndk {
            abiFilters 'arm64-v8a'
        }
        externalNativeBuild {
            cmake {
                arguments "-DANDROID_PLATFORM=android-@MIN_SDK@", "-DANDROID_STL=none"
                abiFilters 'arm64-v8a'
            }
        }
    }

    externalNativeBuild {
        cmake {
            path "src/main/cpp/CMakeLists.txt"
            version "@CMAKE@"
        }
    }

    buildTypes {
        release {
            minifyEnabled false
            // A test APK: signed with the debug key (no release signing here).
            signingConfig signingConfigs.debug
        }
    }

    packaging {
        jniLibs {
            // @PACKAGING_NOTE@
            useLegacyPackaging = @LEGACY_PACKAGING@
        }
    }

    lint {
        abortOnError = false
    }
}
