# Generated by botlish-android @TOOL_VERSION@: do not edit.
#
# Imports the two native libraries as their packages built them -- the
# Botlish application library and SDL -- and builds the SDL_main shim
# libmain.so against them, 16 KiB-aligned. The Android Gradle Plugin
# packages imported libraries with the shim.
cmake_minimum_required(VERSION 3.22)
project(botlish_android_main C)

if(NOT ANDROID_ABI STREQUAL "arm64-v8a")
    message(FATAL_ERROR "this application is arm64-v8a only (its Botlish library is android-aarch64), not ${ANDROID_ABI}")
endif()
if(ANDROID_PLATFORM_LEVEL LESS @MIN_SDK@)
    message(FATAL_ERROR "the Botlish library needs Android API @MIN_SDK@, not ${ANDROID_PLATFORM_LEVEL}")
endif()

set(BOTLISH_LIBS ${CMAKE_CURRENT_SOURCE_DIR}/../botlish/${ANDROID_ABI})
file(SHA256 ${BOTLISH_LIBS}/lib@LIBRARY@.so BOTLISH_APP_SHA256)
if(NOT BOTLISH_APP_SHA256 STREQUAL "@APP_SHA256@")
    message(FATAL_ERROR "lib@LIBRARY@.so is not the library this project was generated from (SHA-256 ${BOTLISH_APP_SHA256}, not @APP_SHA256@)")
endif()
file(SHA256 ${BOTLISH_LIBS}/libSDL3.so BOTLISH_SDL_SHA256)
if(NOT BOTLISH_SDL_SHA256 STREQUAL "@SDL_SHA256@")
    message(FATAL_ERROR "libSDL3.so is not the library of the package @SDL3_PACKAGE@ @SDL3_VERSION@ (SHA-256 ${BOTLISH_SDL_SHA256}, not @SDL_SHA256@)")
endif()

add_library(@LIBRARY@ SHARED IMPORTED)
set_target_properties(@LIBRARY@ PROPERTIES IMPORTED_LOCATION ${BOTLISH_LIBS}/lib@LIBRARY@.so)
add_library(SDL3 SHARED IMPORTED)
set_target_properties(SDL3 PROPERTIES IMPORTED_LOCATION ${BOTLISH_LIBS}/libSDL3.so)

add_library(main SHARED main.c)
target_include_directories(main PRIVATE ${CMAKE_CURRENT_SOURCE_DIR})
target_compile_options(main PRIVATE -Wall -Wextra -Werror)
target_link_libraries(main PRIVATE @LIBRARY@ SDL3 log dl)
target_link_options(main PRIVATE "-Wl,-z,max-page-size=16384" "-Wl,-z,defs")
