# Policy and switches

test fvs-legacy-policy {the legacy policy keeps every fold one register} -constraints nativeBuilt -body {
    set text "$::fvsP
fn run(n: int) -> P:
    fold i from 0 to n with intermediate s P {a: 0, b: 0}:
        P {a: s.a + i, b: s.b + 1}

r = run(10)
\[r.a, r.b\]
"
    list [fvsSlots $text -struct-policy legacy] [fvsStructs $text -struct-policy legacy] [fvsStructs $text]
} -result {{} 11 0}

test fvs-struct-opt-off {struct scalar replacement off: no fold slot, the same value} -constraints nativeBuilt -body {
    set text "$::fvsP
fn run(n: int) -> P:
    fold i from 0 to n with intermediate s P {a: 0, b: 0}:
        P {a: s.a + i, b: s.b + 1}

r = run(10)
\[r.a, r.b\]
"
    list [fvsSlots $text -struct-opt 0] [fvsStructs $text -struct-opt 0]
} -result {{} 11}

test fvs-explain {explain names a virtual fold intermediate} -constraints nativeBuilt -body {
    set text "$::fvsP
fn run(n: int) -> P:
    fold i from 0 to n with intermediate s P {a: 0, b: 0}:
        P {a: s.a + i, b: s.b + 1}

r = run(10)
\[r.a, r.b\]
"
    set hir [fvsHir $text]
    set spec [hir::specialize::analyze $hir]
    hir::specialize::memoizeViews $hir $spec
    set analysis [hir::escape::analyze $hir $spec 1 [dict create enabled 1]]
    regexp {virtual fold intermediate \S+: struct P\{a, b\} \(2 fields\), carried as field registers} \
        [hir::escape::explain $hir $spec $analysis]
} -result 1

# Standalone executables (main.tcl -emit-native-executable) of the
# workloads and of a permuting nested-result program, plain and under GC
# stress, against the interpreter.
test fvs-executable {carried folds in standalone executables, plain and under GC stress, agree with the interpreter} -constraints {nativeBuilt executableAot} -body {
    set dir [makeDirectory {fvs executable test}]
    set programs {}
    foreach name {d-exits d-errors d-coroutine d-observe d-shapes c-vec-continue b-counted-fold} {
        lappend programs $name [core::ReadFile [file join $::projectRoot audit fold-virtual-struct-state workloads $name.bot]]
    }
    lappend programs scanner [core::ReadFile [file join $::projectRoot audit fold-loops workloads scanner-fold.bot]]
    lappend programs permute {struct Inner:
    a: int
    b: int

struct Outer:
    inner: Inner
    n: int

fn step(o: Outer, i: int) -> Outer:
    Outer {inner: Inner {a: o.inner.b, b: o.inner.a + i}, n: o.n + 1}

fn run(n: int) -> List[int]:
    t = fold i from 0 to n with intermediate s Outer {inner: Inner {a: 1, b: 2}, n: 0}:
        if i.mod(4) == 3:
            continue
        if i == 9:
            break
        if i.mod(3) == 0:
            Outer {inner: Inner {a: s.inner.b, b: s.inner.a}, n: s.n}
        else:
            step(s, i)
    [t.inner.a, t.inner.b, t.n]

[run(0), run(5), run(20)]
}
    set bad {}
    try {
        foreach {name text} $programs {
            set path [file join $dir $name.bot]
            set channel [open $path w]
            fconfigure $channel -encoding utf-8 -translation lf
            puts -nonewline $channel $text
            close $channel
            set expected [lindex [outcomeUnderHir interp [surface::readProgramFile $path -warnings off]] 1]
            exec [info nameofexecutable] [file join $::projectRoot main.tcl] -warnings off -emit-native-executable $path
            set plain [standaloneValue [file rootname $path]]
            set stressed [standaloneValue [file rootname $path] BOTLISH_NATIVE_GC_STRESS 1]
            if {$plain ne $expected || $stressed ne $expected} {
                lappend bad [list $name $expected $plain $stressed]
            }
        }
    } finally {
        removeDirectory {fvs executable test}
    }
    list [llength $programs] $bad
} -result {18 {}}

# Every register the lowering reads is defined on every path to the read
# (section 13 of the report): the independent check of NIR text,
# audit/fold-virtual-struct-state/tools/defined.tcl, over every program the
# tests above ran (the workloads when a -match ran none), with fold slots
# and reference joins on, and each off alone.
test fvs-nir-defined {every register the fold-slot lowering reads is defined on every path to it} -constraints nativeBuilt -body {
    set ::definedLibrary 1
    source [file join $::projectRoot audit fold-virtual-struct-state tools defined.tcl]
    set programs [lsort -unique $::fvsPrograms]
    if {$programs eq ""} {
        foreach path [glob [file join $::projectRoot audit fold-virtual-struct-state workloads d-*.bot]] {
            lappend programs [core::ReadFile $path]
        }
    }
    set bad {}
    foreach text $programs {
        set hir [fvsHir $text]
        foreach options {{} {-struct-fold 0} {-struct-ref-joins 0}} {
            foreach v [defined::check [dict get [native::lowered $hir {*}$options] text]] {
                lappend bad [list $options {*}[lrange $v 0 2]]
            }
        }
    }
    list [expr {[llength $programs] > 5}] $bad
} -result {1 {}}

cleanupTests
