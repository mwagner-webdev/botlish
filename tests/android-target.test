test at-library-alignment-checked {a shared object with 4 KiB-aligned segments is no Android library: the check refuses it and removes it} -constraints {androidRuntime} -body {
    set app [atGameApp]
    set dir [atDir align]
    set bin [file join [atNdk] toolchains llvm prebuilt linux-x86_64 bin]
    set here [pwd]
    cd $dir
    exec $bin/llvm-ar x $app/lib/libgame.a
    cd $here
    exec $bin/clang --target=aarch64-linux-android21 -shared -o $dir/libgame.so {*}[glob $dir/*.o] -Wl,-z,max-page-size=4096 \
        -Wl,--gc-sections -ldl -llog -lunwind -lm -lc
    set support [dict create libraries {-ldl -llog -lunwind -ldl -lm -lc}]
    set public [native::library::PublicNames game [lmap n {new_game move changes spawn first_empty spawn_first score over} {dict create name $n}]]
    set failed [catch {native::library::ValidateShared $dir/libgame.so android-aarch64 $support $public game {}} message options]
    list $failed [dict get $options -errorcode] [string match {*aligned to 4096, not 16384*} $message] [file exists $dir/libgame.so]
} -result {1 {NATIVE LIBRARY ELF} 1 0}

# ------------------------------------------------------------ cross-target link plans
#
# RN-HOST-STARTABLE-APPLICATION-LIBRARY-MILESTONE-1.md, "Cross-target link
# plans": a library of android-aarch64 resolves its link plan for Android's
# linker (the driver's link-plan --target), never the host's: the census's
# probe E2 (a library with `extern c library "log"`) was NATIVE TARGET.

set ::atLinkPlanSource {import std::ffi::c

extern c library "log"
extern c library "android"

extern c fn android_log_is_loggable named "__android_log_is_loggable"(prio: std::ffi::c::Int, tag: std::ffi::c::Ptr[std::ffi::c::Char] read noescape, default_prio: std::ffi::c::Int) -> std::ffi::c::Int
extern c fn android_api_level named "android_get_device_api_level"() -> std::ffi::c::Int

exported c fn version() -> int:
    1
}

test at-link-plan-cross {a library of android-aarch64 that declares Android's platform libraries (liblog, libandroid) builds: its plan is resolved for Android, the shared library needs them, the manifest names them} -constraints {androidRuntime} -body {
    set app [atGameApp]
    atWrite $app/plan.bot $::atLinkPlanSource
    lassign [atRun $app -warnings error -target android-aarch64 -target-support botlish_target_android_aarch64 \
        -emit-native-library plan -out planlib plan.bot] status output
    set facts [native::elf::facts $app/planlib/libplan.so]
    set m [pm::json::decode [atRead $app/planlib/plan.manifest.json]]
    set dependencies [lmap d [pm::json::payload [dict get [pm::json::payload $m] dependencies]] {
        pm::json::payload [dict get [pm::json::payload $d] link]
    }]
    list $status [dict get $facts machine] [lsort [dict get $facts needed]] $dependencies
} -result {0 183 {libandroid.so libc.so libdl.so liblog.so libm.so} {-llog -landroid}}

test at-link-plan-cross-refusals {a cross-target link plan is judged for Android: a static archive of this host's x86-64 objects is never linked into an Android library, a static library declared without a path is looked for in the -L directories only (never the host's), and nothing is left behind} -constraints {nativeBuilt linuxX86_64Host clang} -body {
    set app [atSupportApp [atDescriptor [native::runtimeAbi aarch64-linux-android]]]
    set ndk [atFakeNdk 29.0 [dict create cc [auto_execok clang] ld [auto_execok ld] objcopy [auto_execok objcopy] ar [auto_execok ar]] 21]
    atWrite $app/host.c "int host_value(void) \{ return 7; \}\n"
    exec clang -c -o $app/host.o $app/host.c
    exec ar rcs $app/libhost.a $app/host.o
    atWrite $app/declared.bot {import std::ffi::c
extern c library "host" static at "libhost.a"
extern c fn host_value() -> std::ffi::c::Int
exported c fn version() -> int:
    1
}
    atWrite $app/searched.bot {import std::ffi::c
extern c library "m" static
extern c fn host_value() -> std::ffi::c::Int
exported c fn version() -> int:
    1
}
    set results {}
    foreach file {declared searched} {
        lassign [withEnvironment [list ANDROID_NDK_ROOT $ndk] {
            atRun $app -warnings error -target android-aarch64 -target-support android_rt -emit-native-library $file -out out-$file $file.bot
        }] status out
        lappend results $status [file exists $app/out-$file/lib$file.so]
        if {$file eq "declared"} {
            lappend results [string match {*holds object code for ELF x86-64, and this program is linked for android-aarch64 (ELF AArch64)*(NATIVE LINK ARCHIVE)*} $out]
        } else {
            lappend results [string match {*no static archive libm.a is in the library search directories (none)*(NATIVE LINK ARCHIVE)*} $out]
        }
    }
    set results
} -result {1 0 1 1 0 1}

# ------------------------------------------------------------ application libraries
#
# RN-HOST-STARTABLE-APPLICATION-LIBRARY-MILESTONE-1.md, "Android AArch64
# artifacts": an ordinary entry program built as an application library of
# android-aarch64 (-application): NAME_main beside the library's API, the
# manifest's schema 3, an Android shared object; Icy Tower's game modules
# over the generated android-aarch64 SDL3 binding, linked with Android's
# libSDL3.so (tests/cffi/sdl3.tcl android), and the SDL_main shim an APK
# would carry. The fixtures are audit/host-startable-library/android/.

source [file join $::projectRoot tests cffi sdl3.tcl]
set ::atAppHere [file join $::projectRoot audit host-startable-library android]
testConstraint androidSdl3 [expr {[testConstraint androidRuntime] && [cffi::sdl3AndroidDir] ne ""}]

# The 2048 application's package tree (atGameApp) with the fixtures FILES of
# audit/host-startable-library/android beside it.
proc atApplicationApp {files} {
    set app [atGameApp]
    foreach file $files {
        file copy -force [file join $::atAppHere $file] [file join $app $file]
    }
    return $app
}

test at-application-library {an entry program -- its own IO over liblog and a context holding state -- built as an application library of android-aarch64: an AArch64 shared object, 16 KiB-aligned, needing Bionic's libraries and liblog only, exporting its API and NAME_main; its manifest is schema 3 with the application member and binds its files} -constraints {androidRuntime} -body {
    set app [atApplicationApp {android_log.bot hello.bot}]
    lassign [atRun $app -warnings error -target android-aarch64 -target-support botlish_target_android_aarch64 \
        -emit-native-library hello -application -out lib hello.bot] status output
    set facts [native::elf::facts $app/lib/libhello.so]
    set m [pm::json::decode [atRead $app/lib/hello.manifest.json]]
    set get {{value args} {
        foreach k $args { set value [dict get [pm::json::payload $value] $k] }
        pm::json::payload $value
    }}
    list $status [dict get $facts machine] [dict get $facts type] [lsort -unique [lmap l [dict get $facts loads] {dict get $l align}]] \
        [dict get $facts textrel] [lsort [dict get $facts needed]] [lsort -unique [concat {*}[dict values [dict get $facts verneed]]]] \
        [expr {[dict get $facts exports] eq [lsort [native::library::PublicNames hello {} 1]]}] [expr {"hello_main" in [dict get $facts exports]}] \
        [apply $get $m schema] [apply $get $m application symbol] [apply $get $m target name] \
        [apply $get $m targetSupport package] [expr {[apply $get $m sha256 shared] eq [native::library::Sha256 $app/lib/libhello.so]}]
} -result {0 183 dyn 16384 0 {libc.so libdl.so liblog.so libm.so} LIBC 1 1 3 hello_main android-aarch64 botlish_target_android_aarch64 1}

test at-application-sdl3 {Icy Tower's unchanged game modules with Android's IO, over the generated android-aarch64 SDL3 binding, built as an application library linked with Android's libSDL3.so: it needs libSDL3.so and liblog, imports SDL's functions with SDL's symbol version and no glibc one, 16 KiB-aligned; the SDL_main shim links against it; Linux's libSDL3.so is never linked into it} -constraints {androidSdl3} -body {
    set app [atApplicationApp {android_log.bot icy-android.bot sdl_main.c}]
    set src [atDir icysrc]
    foreach module {game sdl render hud tower options} {
        file copy [file join $::projectRoot examples games icy-tower $module.bot] [file join $src $module.bot]
    }
    # The binding as application modules (sdl3/... beside the entry): the
    # application's package graph names only the packages it installed.
    exec [info nameofexecutable] [file join $::projectRoot tools c-bindgen.tcl] stage sdl3 -target android-aarch64 \
        -app $src -into $app
    set sdl [cffi::sdl3AndroidDir]
    lassign [atRun $app -warnings error -target android-aarch64 -target-support botlish_target_android_aarch64 \
        -emit-native-library icy -application -L $sdl -out lib icy-android.bot] status output
    if {$status != 0} { error $output }
    set facts [native::elf::facts $app/lib/libicy.so]
    set sdlImports [lsort -unique [lmap line [split [exec [file join [atNdk] toolchains llvm prebuilt linux-x86_64 bin llvm-nm] -D --undefined-only $app/lib/libicy.so] \n] {
        if {![regexp {U (SDL_\w+)@(\S+)} $line -> name version]} continue
        set version
    }]]
    set bin [file join [atNdk] toolchains llvm prebuilt linux-x86_64 bin]
    exec $bin/clang --target=aarch64-linux-android21 -O2 -Wall -Wextra -Werror -fPIC -shared -Wl,-z,max-page-size=16384 \
        -Wl,-z,defs -Wl,-soname,libmain.so {-DAPP_HEADER="icy.h"} -DAPP_PREFIX=icy -I $app/lib -o $app/lib/libmain.so \
        $app/sdl_main.c -L $app/lib -licy -L $sdl -lSDL3 -llog
    set shim [native::elf::facts $app/lib/libmain.so]
    set results [list [lsort [dict get $facts needed]] [lsort -unique [lmap l [dict get $facts loads] {dict get $l align}]] \
        [lsort -unique [concat {*}[dict values [dict get $facts verneed]]]] $sdlImports \
        [expr {"icy_main" in [dict get $facts exports]}] [expr {"SDL_main" in [dict get $shim exports]}] [expr {"libicy.so" in [dict get $shim needed]}]]
    # Linux's libSDL3.so (this host's, x86-64 glibc) where Android's belongs:
    # the target's toolchain refuses it, and no library is left.
    if {[cffi::sdl3Dir] ne ""} {
        lassign [atRun $app -warnings error -target android-aarch64 -target-support botlish_target_android_aarch64 \
            -emit-native-library linux -application -L [cffi::sdl3Dir] -out linuxlib icy-android.bot] linuxStatus linuxOut
        lappend results $linuxStatus [string match {*(NATIVE LIBRARY TOOL cc)*} $linuxOut] [file exists $app/linuxlib/liblinux.so]
    } else {
        lappend results 1 1 0
    }
    set results
} -result {{libSDL3.so libc.so libdl.so liblog.so libm.so} 16384 {LIBC SDL3_0.0.0} SDL3_0.0.0 1 1 1 1 1 0}

# ------------------------------------------------------------ execution

# The hosts (host/host2048.c, host/stress.c) built by the NDK for API 21
# against the library of APP.
proc atHost {app source lib} {
    set out [file join $app lib [file rootname [file tail $source]]]
    exec [file join [atNdk] toolchains llvm prebuilt linux-x86_64 bin clang] --target=aarch64-linux-android21 \
        -std=c11 -O2 -Wall -Wextra -Werror -I [file join $app lib] -o $out $source -ldl
    return $out
}

proc atAndroid {root args} {
    set filtered {}
    catch {exec [file join $::atHere tools android-run.sh] {*}$args 2>@1} output options
    set status [expr {[dict get $options -code] == 0 ? 0 : [lindex [dict get $options -errorcode] 2]}]
    set lines [lmap line [split $output \n] {if {[string match *linker* $line]} continue; set line}]
    return [list $status $lines]
}

test at-android-2048 {the 2048 library made by this compiler plays in an Android process -- Android's linker64 and Bionic of every installed API level, at the minimum and the newest -- exactly as the interpreter plays: 321 states, the score, over, first_empty and the declared errors} -constraints {androidRun} -body {
    set app [atGameApp]
    set host [atHost $app [file join $::atHere host host2048.c] $app/lib/libgame.so]
    set results {}
    foreach root [atRoots] {
        set code [catch {exec [info nameofexecutable] [file join $::atHere tools parity.tcl] -app $app \
            -botlish [list [info nameofexecutable] $::atMain] -run [file join $::atHere tools android-run.sh] \
            $root/root $host $app/lib/libgame.so play 2>@1} output]
        lappend results [file tail $root] $code [regexp -all {(?n)^PASS } $output]
    }
    lsort -unique [lmap {api code passes} $results {list $code $passes}]
} -result {{0 4}}

test at-android-lifecycle {instances in an Android process: fifty created, played and destroyed; two interleaved, one destroyed and the other still working; a destroyed one refused; another thread refused (WRONG-THREAD), the owner's still working; the same under GC stress and with 16 KiB pages} -constraints {androidRun} -body {
    set app [atGameApp]
    set host [atHost $app [file join $::atHere host host2048.c] $app/lib/libgame.so]
    set root [lindex [atRoots] end]/root
    lassign [atAndroid $root $root $host $app/lib/libgame.so lifecycle 50] s1 l1
    lassign [atAndroid $root $root $host $app/lib/libgame.so thread] s2 l2
    lassign [withEnvironment {BOTLISH_NATIVE_GC_STRESS 1} { atAndroid $root $root $host $app/lib/libgame.so lifecycle 3 }] s3 l3
    lassign [atAndroid $root -p 16384 $root $host $app/lib/libgame.so thread] s4 l4
    list $s1 $l1 $s2 $l2 $s3 [lindex $l3 1] $s4 [lindex $l4 0]
} -result [list 0 [list "LIFECYCLE\t50 instances, each scored 28" "INTERLEAVED\t28 28 28" "ERROR\t4\tINVALID-INSTANCE"] \
    0 [list "OTHER-THREAD\t4\tWRONG-THREAD" "OWN-THREAD\t28"] 0 "INTERLEAVED\t28 28 28" 0 "OTHER-THREAD\t4\tWRONG-THREAD"]

test at-android-16k-control {16 KiB pages discriminate: Android's linker in its 16 KiB mode loads the compiler's library and refuses the same code linked 4 KiB-aligned} -constraints {androidRun16k} -body {
    set app [atGameApp]
    set host [atHost $app [file join $::atHere host host2048.c] $app/lib/libgame.so]
    set dir [atDir k4]
    set bin [file join [atNdk] toolchains llvm prebuilt linux-x86_64 bin]
    set here [pwd]
    cd $dir
    exec $bin/llvm-ar x $app/lib/libgame.a
    cd $here
    exec $bin/clang --target=aarch64-linux-android21 -shared -o $dir/libgame.so {*}[glob $dir/*.o] -Wl,-z,max-page-size=4096 \
        -Wl,--gc-sections -ldl -llog -lunwind -lm -lc
    file copy $host $dir/host2048
    set root [lindex [atRoots] [lsearch -glob [atRoots] */api-35]]/root
    lassign [atAndroid $root -p 16384 $root $host $app/lib/libgame.so thread] ours
    lassign [atAndroid $root -p 16384 $root $dir/host2048 $dir/libgame.so thread] theirs theirLines
    lassign [atAndroid $root $root $dir/host2048 $dir/libgame.so thread] small
    list $ours $theirs [string match {*dlopen failed*} $theirLines] $small
} -result {0 3 1 0}

test at-android-stress {the runtime's workloads in an Android process -- large and astral-plane strings, nested Lists of structs, a growing MutableVector, many allocations, a declared error with its payload -- equal the interpreter's, on two instances in turn, and under GC stress} -constraints {androidRun} -body {
    set app [atGameApp]
    file copy [file join $::atHere stress stress.bot] $app/stress.bot
    lassign [atRun $app -warnings error -target android-aarch64 -target-support botlish_target_android_aarch64 \
        -emit-native-library stress -out lib stress.bot] status output
    if {$status != 0} { error $output }
    set host [atHost $app [file join $::atHere host stress.c] $app/lib/libstress.so]
    set root [lindex [atRoots] 0]/root
    lassign [atAndroid $root $root $host $app/lib/libstress.so 6] s1 l1
    lassign [withEnvironment {BOTLISH_NATIVE_GC_STRESS 1} { atAndroid $root $root $host $app/lib/libstress.so 2 }] s2 l2
    atWrite $app/oracle.bot {import stress
r = stress::repeated("aé😀", 2000)
back = stress::reversed("aé😀bß"):
    on IndexNotFound:
        "?"
v = stress::vector(5000):
    on IndexNotFound:
        -1
[stress::characters(r), back, stress::nested(500), v]
}
    lassign [atRun $app -warnings off -backend interp -target android-aarch64 oracle.bot] - oracle
    regexp {value: \[(\d+), "([^"]*)", (\d+), (\d+)\]} $oracle -> chars back nested vector
    list $s1 [expr {[lrange $l1 0 4] eq [list "characters\t$chars\t14000" "reversed\t$back" "nested\t$nested" "vector\t$vector" "boom\t1\tBoom\t300\titem-299"]}] \
        $s2 [expr {[lrange $l2 0 4] eq [lrange $l1 0 4]}]
} -result {0 1 0 1}

# Application libraries in an Android process (RN-HOST-STARTABLE-APPLICATION-
# LIBRARY-MILESTONE-1.md, "Android execution"): Android's linker64 and Bionic
# of each installed API level, under qemu-user -- no ART, no Activity.

# The application library hello (audit/host-startable-library/android) of
# a fresh application, and the hosts host_main and host_dlclose beside it;
# co, a library whose entry runs a coroutine.
proc atApplicationHosts {} {
    if {[info exists ::atApplicationCache]} { return $::atApplicationCache }
    set app [atApplicationApp {android_log.bot hello.bot co.bot host_main.c host_dlclose.c}]
    foreach name {hello co} {
        lassign [atRun $app -warnings error -target android-aarch64 -target-support botlish_target_android_aarch64 \
            -emit-native-library $name -application -out lib $name.bot] status output
        if {$status != 0} { error "$name: $output" }
    }
    set clang [file join [atNdk] toolchains llvm prebuilt linux-x86_64 bin clang]
    foreach {out defines} {host_main {} host_untagged -DNO_HEAP_POINTER_TAGGING} {
        exec $clang --target=aarch64-linux-android21 -std=c11 -O2 -Wall -Wextra -Werror {*}$defines \
            {-DAPP_HEADER="hello.h"} -DAPP_PREFIX=hello -I $app/lib -o $app/lib/$out $app/host_main.c -L $app/lib -lhello -ldl
    }
    exec $clang --target=aarch64-linux-android21 -std=c11 -O2 -Wall -Wextra -Werror -o $app/lib/host_dlclose $app/host_dlclose.c -ldl
    set ::atApplicationCache $app
    return $app
}

# The lines of android-run.sh ROOT PROGRAM ARGS (Android's linker's warnings
# dropped), and whether it exited 0.
proc atAndroidLines {root program args} {
    set code [catch {exec [file join $::atHere tools android-run.sh] $root $program {*}$args 2>@1} output]
    set lines [lmap line [split [string map [list \0 ""] $output] \n] {
        if {[string match *linker* $line] || [string match libc:* $line] || [string match qemu* $line] || $line eq ""} continue
        set line
    }]
    return [list [expr {!$code}] $lines]
}

test at-application-run {NAME_main in an Android process, on a 1 MiB thread named SDLThread, twice: the entry completes on every installed API level -- also where Bionic tags heap pointers (Android 11 and later), whose tagged addresses the entry's byte borrowing for liblog hands C whole (RN-ANDROID-TAGGED-POINTER-CORRECTNESS-MILESTONE-1.md; before it, CORE SEMANTIC RANGE) -- and with the tagging off, as an application's android:allowNativeHeapPointerTagging="false" has it, alike} -constraints {androidRun} -body {
    set app [atApplicationHosts]
    set results {}
    foreach root [atRoots] {
        set api [string range [file tail $root] 4 end]
        lassign [atAndroidLines $root/root $app/lib/host_main one two] ok lines
        set untagged [lindex [atAndroidLines $root/root $app/lib/host_untagged one two] 1]
        set statuses [lmap line $lines {if {![string match MAIN* $line]} continue; lindex [split $line \t] 2}]
        set identities [lsort -unique [lmap line $lines {if {![string match MAIN* $line]} continue; lindex [split $line \t] 3}]]
        lappend results [list [expr {$api >= 30 ? "tagged" : "untagged"}] $ok $statuses $identities [lindex $lines end] \
            [lmap line $untagged {if {![string match MAIN* $line]} continue; lindex [split $line \t] 2}]]
    }
    lsort -unique $results
} -result {{tagged 1 {0 0} {{}} {HOST	done} {0 0}} {untagged 1 {0 0} {{}} {HOST	done} {0 0}}}

test at-application-unload {the dynamic loader's lifetime rule on Android: Rust's thread-locals there are pthread keys whose destructors are in the library, so a library unloaded while a thread that called it lives makes the thread's end crash; kept loaded by a second handle (SDLActivity's System.loadLibrary), or pinned with RTLD_NODELETE where Bionic has it (API 23 and later), the thread ends cleanly} -constraints {androidRun} -body {
    set app [atApplicationHosts]
    set results {}
    foreach root [atRoots] {
        set api [string range [file tail $root] 4 end]
        foreach lib {co} {
            foreach mode {unload kept nodelete} {
                lassign [atAndroidLines $root/root $app/lib/host_dlclose lib$lib.so ${lib}_main $mode] ok lines
                set survived [expr {"SURVIVED" in $lines}]
                set refused [expr {[lsearch -glob $lines {DLOPEN*invalid flags*}] >= 0}]
                lappend results [list $mode [expr {$api >= 23 ? "23+" : $api}] $survived $refused]
            }
        }
    }
    lsort -unique $results
} -result {{kept 21 1 0} {kept 23+ 1 0} {nodelete 21 0 1} {nodelete 23+ 1 0} {unload 21 0 0} {unload 23+ 0 0}}

# Tagged heap pointers (RN-ANDROID-TAGGED-POINTER-CORRECTNESS-MILESTONE-1.md):
# the probe of audit/android-tagged-pointers/android in Android processes --
# its C side (tp.c, a static archive the NDK builds, declared by the
# application with `static at`), the application libraries tagged and heap,
# and host_main.c built twice for each, the second turning Bionic's heap
# pointer tagging off first (an application's
# android:allowNativeHeapPointerTagging="false"). Nothing here turns
# tagging off for the probe itself.
set ::atTaggedHere [file join $::projectRoot audit android-tagged-pointers android]

proc atTaggedHosts {} {
    if {[info exists ::atTaggedCache]} { return $::atTaggedCache }
    set app [atApplicationApp {android_log.bot host_main.c}]
    foreach file {tp.c tp.bot tagged.bot heap.bot} {
        file copy -force [file join $::atTaggedHere $file] [file join $app $file]
    }
    set bin [file join [atNdk] toolchains llvm prebuilt linux-x86_64 bin]
    exec $bin/clang --target=aarch64-linux-android21 -std=c11 -O2 -Wall -Wextra -Werror -fPIC -fvisibility=hidden -c -o $app/tp.o $app/tp.c
    exec $bin/llvm-ar rcs $app/libtp.a $app/tp.o
    foreach name {tagged heap} {
        lassign [atRun $app -warnings error -target android-aarch64 -target-support botlish_target_android_aarch64 \
            -emit-native-library $name -application -out lib $name.bot] status output
        if {$status != 0} { error "$name: $output" }
        foreach {out defines} [list ${name}_host {} ${name}_untagged -DNO_HEAP_POINTER_TAGGING] {
            exec $bin/clang --target=aarch64-linux-android21 -std=c11 -O2 -Wall -Wextra -Werror {*}$defines \
                "-DAPP_HEADER=\"$name.h\"" -DAPP_PREFIX=$name -I $app/lib -o $app/lib/$out $app/host_main.c -L $app/lib -l$name -ldl
        }
    }
    set ::atTaggedCache $app
    return $app
}

# The probe's own lines among LINES (tp_say's: KEY VALUE...), each top byte
# C read (the exposure's and the heap block's) replaced by whether it is a
# tag: "tagged" when nonzero, "untagged" when zero.
proc atProbeLines {lines} {
    lmap line $lines {
        set words [split $line " "]
        switch -- [lindex $words 0] {
            exposure - heap {
                lset words 1 [expr {[lindex $words 1] != 0 ? "tagged" : "untagged"}]
            }
            log - write - view - record - callback - qsort - null - release {}
            default continue
        }
        join $words " "
    }
}

test at-tagged-manifest {an Android application library's manifest states the runtime ABI of Android's runtime of this compiler -- its target support package's, the fingerprint whose code encodes C address words Android's way -- as the compiler's, never the driver's own (which differs: the host's words keep no tag), so a consumer's comparison of the two (the React Native tool's) holds} -constraints {androidRuntime} -body {
    set app [atTaggedHosts]
    set m [pm::json::decode [atRead $app/lib/tagged.manifest.json]]
    set get {{value args} {
        foreach k $args { set value [dict get [pm::json::payload $value] $k] }
        pm::json::payload $value
    }}
    set compiler [apply $get $m compiler runtimeAbi]
    list [expr {$compiler eq [apply $get $m targetSupport runtimeAbi]}] [expr {$compiler eq [native::runtimeAbi aarch64-linux-android]}] \
        [expr {$compiler eq [native::runtimeAbi]}]
} -result {1 1 0}

test at-tagged-heap-pointer {a C heap pointer in an Android process: returned by C, kept, handed back unchanged and released, with no byte exposure -- on every installed API level, where Bionic tags it (Android 11 and later) as where it does not, and with the tagging turned off alike; before the tagged encoding a tagged result was NATIVE ADDRESS} -constraints {androidRun} -body {
    set app [atTaggedHosts]
    set results {}
    foreach root [atRoots] {
        set api [string range [file tail $root] 4 end]
        foreach host {heap_host heap_untagged} {
            lassign [atAndroidLines $root/root $app/lib/$host] ok lines
            set statuses [lmap line $lines {if {![string match MAIN* $line]} continue; lindex [split $line \t] 2}]
            set identities [lsort -unique [lmap line $lines {if {![string match MAIN* $line]} continue; lindex [split $line \t] 3}]]
            lappend results [list [expr {$api >= 30 ? "tagging" : "no-tagging"}] $host $ok $statuses $identities]
        }
    }
    lsort -unique $results
} -result {{no-tagging heap_host 1 {0 0} {{}}} {no-tagging heap_untagged 1 {0 0} {{}}} {tagging heap_host 1 {0 0} {{}}} {tagging heap_untagged 1 {0 0} {{}}}}

test at-tagged-pointers {every way a pointer and a byte exposure cross the boundary, in Android processes with Bionic's heap pointer tagging on: liblog given two exposed strings; the address C receives for a Botlish byte exposure carries Bionic's tag (Botlish's heap is Bionic's malloc) and C reads the right bytes there; a write exposure; a tagged heap block C allocates, kept in an installed context and handed back bit for bit; a native view through it; a pointer in a C record read through a view and stored through an edit; a callback given it as user data returning it; Bionic's qsort of an exposed buffer calling back with pointers into it; null -- twice per process. Where Bionic tags (API 30 and later) both tops are tags, where it does not (and with the tagging off) neither is, and every check holds everywhere} -constraints {androidRun} -body {
    set app [atTaggedHosts]
    set expected [list "log called" "exposure TAG 36" "write true" "heap TAG same" "view 77 0" "record same same" "callback same" "qsort true" "null true same" "release done"]
    set results {}
    foreach root [atRoots] {
        set api [string range [file tail $root] 4 end]
        foreach host {tagged_host tagged_untagged} {
            lassign [atAndroidLines $root/root $app/lib/$host] ok lines
            set statuses [lmap line $lines {if {![string match MAIN* $line]} continue; lindex [split $line \t] 2}]
            set probe [atProbeLines $lines]
            set tag [expr {$api >= 30 && $host eq "tagged_host" ? "tagged" : "untagged"}]
            set want [concat {*}[lrepeat 2 [string map [list TAG $tag] $expected]]]
            lappend results [list [expr {$api >= 30 ? "tagging" : "no-tagging"}] $host $ok $statuses [expr {$probe eq $want ? "as expected" : $probe}]]
        }
    }
    lsort -unique $results
} -result {{no-tagging tagged_host 1 {0 0} {as expected}} {no-tagging tagged_untagged 1 {0 0} {as expected}} {tagging tagged_host 1 {0 0} {as expected}} {tagging tagged_untagged 1 {0 0} {as expected}}}

test at-tagged-sdl3 {SDL3's objects in an Android process, over the committed android-aarch64 binding and Android's libSDL3.so, with no SDL_Init (which needs Android's Java side): a surface SDL allocates, filled, its pixels pointer -- a pointer in SDL's struct -- read through the generated layout's native view and read through, duplicated, both destroyed; where Bionic tags heap pointers (API 30 and later, tagging on) both pointers carry the tag C reads, elsewhere neither, and every step holds everywhere -- before the tagged encoding SDL_CreateSurface's tagged result was NATIVE ADDRESS} -constraints {androidRun androidSdl3} -body {
    set app [atTaggedHosts]
    file copy -force [file join $::atTaggedHere sdl_surface.bot] [file join $::atTaggedHere stdio_io.bot] $app
    set src [atDir sdlsrc]
    file copy [file join $app sdl_surface.bot] $src
    exec [info nameofexecutable] [file join $::projectRoot tools c-bindgen.tcl] stage sdl3 -target android-aarch64 -app $src -into $app
    set sdl [cffi::sdl3AndroidDir]
    lassign [atRun $app -warnings error -target android-aarch64 -target-support botlish_target_android_aarch64 \
        -emit-native-library sdl_surface -application -L $sdl -out lib sdl_surface.bot] status output
    if {$status != 0} { error $output }
    set clang [file join [atNdk] toolchains llvm prebuilt linux-x86_64 bin clang]
    foreach {out defines} {sdl_surface_host {} sdl_surface_untagged -DNO_HEAP_POINTER_TAGGING} {
        exec $clang --target=aarch64-linux-android21 -std=c11 -O2 -Wall -Wextra -Werror {*}$defines \
            {-DAPP_HEADER="sdl_surface.h"} -DAPP_PREFIX=sdl_surface -I $app/lib -o $app/lib/$out $app/host_main.c \
            -L $app/lib -lsdl_surface -L $sdl -lSDL3 -ldl
    }
    file copy -force [file join $sdl libSDL3.so] $app/lib/libSDL3.so
    set results {}
    foreach root [atRoots] {
        set api [string range [file tail $root] 4 end]
        foreach host {sdl_surface_host sdl_surface_untagged} {
            lassign [atAndroidLines $root/root $app/lib/$host] ok lines
            if {[lsearch -glob $lines {*CANNOT LINK EXECUTABLE*}] >= 0} {
                # A userspace without the libraries libSDL3.so needs
                # (Android 10 and later: the i18n APEX's ICU,
                # audit/android-tagged-pointers/tools/apex.sh): not run.
                continue
            }
            set tag [expr {$api >= 30 && $host eq "sdl_surface_host" ? 180 : 0}]
            set probe [lmap line $lines {if {![string match "sdl *" $line]} continue; set line}]
            set want [concat {*}[lrepeat 2 [list "sdl surface $tag $tag 8x8 32" "sdl fill true 287454020 287454020" "sdl duplicate 287454020" "sdl destroyed"]]]
            set statuses [lmap line $lines {if {![string match MAIN* $line]} continue; lindex [split $line \t] 2}]
            lappend results [list [expr {$api >= 30 ? "tagging" : "no-tagging"}] $host $ok $statuses [expr {$probe eq $want ? "as expected" : $probe}]]
        }
    }
    # The newest image must have run (the tagged pointers are its).
    lappend results [expr {[lsearch -glob $results {tagging sdl_surface_host *}] >= 0}]
    lsort -unique $results
} -result {1 {no-tagging sdl_surface_host 1 {0 0} {as expected}} {no-tagging sdl_surface_untagged 1 {0 0} {as expected}} {tagging sdl_surface_host 1 {0 0} {as expected}} {tagging sdl_surface_untagged 1 {0 0} {as expected}}}

test at-tagged-pointers-stress {the probe where Bionic tags heap pointers (the newest installed API level), under GC stress and with 16 KiB pages: every check holds, the tags kept} -constraints {androidRun16k} -body {
    set app [atTaggedHosts]
    set root [lindex [atRoots] [lsearch -glob [atRoots] */api-35]]/root
    set results {}
    lassign [withEnvironment {BOTLISH_NATIVE_GC_STRESS 1} { atAndroidLines $root $app/lib/tagged_host }] ok lines
    lappend results $ok [lsort -unique [atProbeLines $lines]]
    set code [catch {exec [file join $::atHere tools android-run.sh] -p 16384 $root $app/lib/tagged_host 2>@1} output]
    lappend results [expr {!$code}] [lsort -unique [atProbeLines [split $output \n]]]
} -result [lrepeat 2 1 {{callback same} {exposure tagged 36} {heap tagged same} {log called} {null true same} {qsort true} {record same same} {release done} {view 77 0} {write true}}]

cleanupTests
