        expr {[atRead $app/lib/$f] eq [atRead $app/again/$f]}
    }]
} -result {0 1 1 1 1}

test at-library-package-runtime {the library is linked with the installed package's runtime archive and no other: replaced by an archive holding only its identity record, the link fails on the runtime's missing symbols} -constraints {androidRuntime} -body {
    set app [atGameApp]
