# opaque-struct.test -- `opaque struct` (OPAQUE-STRUCTS.md): a struct whose
# representation -- constructing it from its fields, projecting or
# destructuring its fields -- belongs to the module that declares it.
#
#   opaque struct Token:
#       value: int
#
# * grammar, the contextual modifier, the AST, the loader-supplied owner,
#   the HIR registry and its text round trip;
# * the owner: ordinary Botlish, on every backend, entry programs included;
# * a consumer: values pass, store, return, compare and hash as any value;
# * what a consumer cannot do, each with the one dedicated diagnostic and no
#   observable difference between a hidden field and a guessed one;
# * methods: `x.f()` calls the visible function, hidden fields are not
#   candidates and cannot make a call ambiguous;
# * nesting, authority exactness (imports grant nothing), per-struct scope;
# * printing, equality, hashing, the module cache;
# * optimizer transparency: the same NIR, CLIF and allocations as the
#   equivalent ordinary struct, specialized and generic.
#
# Library fixtures live in a scratch directory $::core::libraryDir points at
# for the duration of each test that needs one.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]

interp recursionlimit {} 100000

set ::allBackends {interp compile cranelift-generic cranelift}

# ---------------------------------------------------------------------------
# Helpers

proc withScratchLibrary {script} {
    set saved $::core::libraryDir
    set dir [tcltest::makeDirectory opaque-scratch-[pid]-[incr ::scratchLibraryCounter]]
    set ::core::libraryDir $dir
    try {
        # The script runs in the caller's frame, with `dir` set there.
        uplevel 1 [list set dir $dir]
        uplevel 1 $script
    } finally {
        set ::core::libraryDir $saved
        tcltest::removeDirectory [file tail $dir]
    }
}
set ::scratchLibraryCounter 0

# Writes CONTENT to $dir/NAME.bot (NAME "a/b" is $dir/a/b.bot).
proc writeModule {dir name content} {
    set path [file join $dir {*}[split $name /]].bot
    file mkdir [file dirname $path]
    set channel [open $path w]
    fconfigure $channel -encoding utf-8
    puts -nonewline $channel $content
    close $channel
    return $path
}

# The HIR of the entry program SOURCE in the current library directory.
proc hirOfSource {source {strict 1}} {
    set dir [tcltest::makeDirectory opaque-main-[pid]-[incr ::scratchLibraryCounter]]
    try {
        set path [writeModule $dir main $source]
        return [surface::readProgramFile $path -strict $strict -warnings off]
    } finally {
        tcltest::removeDirectory [file tail $dir]
    }
}

# The error kind: the last word of a {SURFACE MODULE KIND} / {CORE SEMANTIC KIND}
# code, or SYNTAX for a {SURFACE SYNTAX DIAGNOSTIC}.
proc ErrorKind {options} {
    set code [dict get $options -errorcode]
    return [expr {[lindex $code 1] eq "SYNTAX" ? "SYNTAX" : [lindex $code end]}]
}

# "kind: message" of the first static rejection of SOURCE (locations of the
# entry program dropped, those of a module file shown as FILE), or accepted.
proc rejection {source} {
    if {[catch {hirOfSource $source} message options]} {
        set message [regsub -all {[^ ]*main\.bot:[0-9]+:[0-9]+: } $message {}]
        set message [regsub -all {[^ ]*\.bot:[0-9]+:[0-9]+} $message {FILE}]
        return "[ErrorKind $options]: $message"
    }
    return accepted
}

proc rejectionKind {source} {
    if {[catch {hirOfSource $source} message options]} {
        return [ErrorKind $options]
    }
    return accepted
}

# The value of SOURCE if every backend agrees on it (the full representation
# of an opaque value included, as the harness prints it), else the disagreement.
proc agree {source} {
    set hir [hirOfSource $source]
    set outcomes [lmap backend $::allBackends {lrange [outcomeUnderHir $backend $hir] 0 end-1}]
    if {[llength [lsort -unique $outcomes]] != 1} {
        return "DISAGREE: [join [lmap b $::allBackends o $outcomes {list $b $o}] { / }]"
    }
    set outcome [lindex $outcomes 0]
    return [expr {[lindex $outcome 0] eq "value" ? [lindex $outcome 1] : [list error [lindex $outcome 1]]}]
}

# The user-facing text of SOURCE's value on each backend (core::value::show
# as the runner prints it, evidence shown, representation not revealed), or
# the single text if every backend agrees.
proc shownOn {source} {
    set hir [hirOfSource $source]
    set texts {}
    foreach backend $::allBackends {
        set saved [core::useBackend]
        try {
            if {$backend in {cranelift cranelift-generic}} {
                set value [native::evalHir $hir {*}[expr {$backend eq "cranelift-generic" ? {-specialize 0} : {}}]]
            } else {
                core::useBackend $backend
                set value [core::evalProgram [hir::lower $hir]]
            }
            lappend texts [core::value::show $value 1]
        } finally {
            core::useBackend $saved
        }
    }
    if {[llength [lsort -unique $texts]] != 1} {
        return "DISAGREE: $texts"
    }
    return [lindex $texts 0]
}

# The runtime error message SOURCE raises on BACKEND (it must compile).
proc runtimeMessage {backend source} {
    set hir [hirOfSource $source]
    set outcome [outcomeUnderHir $backend $hir]
    return [expr {[lindex $outcome 0] eq "error" ? [lindex $outcome 2] : "no error: [lindex $outcome 1]"}]
}

proc diagKinds {source} {
    return [lsort -unique [lmap d [hir::diagnostics [hirOfSource $source 0]] {dict get $d kind}]]
}

proc diagKindsOrdered {source} {
    return [lmap d [hir::diagnostics [hirOfSource $source 0]] {dict get $d kind}]
}

# The text of one of the two opacity messages, with the guessed or real field
# name the caller wrote replaced, for "the same diagnostic" comparisons.
proc withoutName {message name} {
    return [string map [list "\"$name\"" {"NAME"}] $message]
}

# The standard library's own module `NAME` copied into the scratch library
# (a scratch library otherwise holds only what a test writes).
proc useStandardModule {dir name} {
    set source [file join $::projectRoot lib $name.bot]
    set target [file join $dir $name.bot]
    file mkdir [file dirname $target]
    file copy -force $source $target
}

# ---------------------------------------------------------------------------
# Fixtures
#
# wrapped   the validation fixture: an opaque struct with two fields, a
#           factory and two ordinary accessors
# hidden    an opaque struct with function-valued fields; one is named like
#           a function of the module (`describe`)
# hiddenamb the owner's own field/function ambiguity (ordinary rules)
# nest      an opaque struct holding a public struct, and a public struct
# mixed     a module with one public and one opaque struct
# holder    a public struct of another module holding an opaque value
# authp/authp::kid, authc/authc::kid  authority is exact across parent/child

proc writeFixtures {dir} {
    writeModule $dir wrapped "opaque struct Wrapped:
    value: int
    label: str

fn create(value: int, label: str):
    Wrapped {value: value, label: label}

fn value(x: Wrapped):
    x.value

fn describe(x: Wrapped):
    x.label

fn copy(x: Wrapped):
    {value, label} = x
    Wrapped {value: value, label: label}
"
    writeModule $dir hidden "fn twice(n: int) -> int:
    n + n

opaque struct Gadget:
    describe: Fn{args: \[int\], return: int, errors: \[\]}
    callback: Fn{args: \[int\], return: int, errors: \[\]}
    tag: int

fn make() -> Gadget:
    Gadget {describe: twice, callback: twice, tag: 1}

fn describe(g: Gadget) -> int:
    100

fn run(g: Gadget):
    (g.callback)(21)

fn tag(g: Gadget):
    g.tag
"
    writeModule $dir hiddenamb "fn twice(n: int) -> int:
    n + n

opaque struct Gadget:
    describe: Fn{args: \[int\], return: int, errors: \[\]}

fn describe(g: Gadget) -> int:
    100

fn make() -> Gadget:
    Gadget {describe: twice}

fn use(g: Gadget):
    g.describe()
"
    writeModule $dir nest "struct Inner:
    value: int

opaque struct Outer:
    inner: Inner
    count: int

fn make(v: int, c: int) -> Outer:
    Outer {inner: Inner {value: v}, count: c}

fn count(o: Outer):
    o.count

fn inner_value(o: Outer):
    o.inner.value
"
    writeModule $dir mixed "struct Public:
    value: int

opaque struct Secret:
    value: int

fn secret(v: int) -> Secret:
    Secret {value: v}
"
    writeModule $dir holder "import wrapped

struct Holder:
    secret: wrapped::Wrapped
    n: int

fn make(n: int) -> Holder:
    Holder {secret: wrapped::create(n, \"h\"), n: n}

fn secret(h: Holder):
    h.secret

fn viaaccessor(h: Holder):
    wrapped::value(h.secret)
"
    writeModule $dir holderbad "import wrapped

struct Holder:
    secret: wrapped::Wrapped

fn bad(h: Holder):
    h.secret.value
"
    # Parent with a child it imports; the child owns its own opaque struct.
    writeModule $dir authp "import authp::kid

opaque struct Box:
    v: int

fn forge():
    authp::kid::Kid {k: 1}
"
    writeModule $dir authp/kid "opaque struct Kid:
    k: int

fn make(k: int) -> Kid:
    Kid {k: k}
"
    # Child that imports its parent and tries the parent's representation.
    writeModule $dir authc "opaque struct Box:
    v: int

fn make(v: int) -> Box:
    Box {v: v}
"
    writeModule $dir authc/kid "import authc

fn forge():
    authc::Box {v: 1}
"
}

# The standard consumer prefix.
set ::consume "import wrapped\nx = wrapped::create(3, \"three\")\n"

# ---------------------------------------------------------------------------
# Grammar, the contextual modifier, the AST

test opaque-ast-flag {`opaque struct` is the one struct declaration with a property: the node carries opaque 1 and the modifier's span, an ordinary struct opaque 0} -body {
    set ast [surface::parse "opaque struct A:\n    v: int\n\nstruct B:\n    v: int\n"]
    lmap d [dict get $ast body] {
        list [dict get $d kind] [dict get $d name] [dict get $d opaque] \
            [expr {[dict get $d opaqueSpan] eq "" ? "-" : "[dict get $d opaqueSpan line]:[dict get $d opaqueSpan column]"}] \
            [dict get $d span column]
    }
} -result {{structdecl A 1 1:1 1} {structdecl B 0 - 1}}

test opaque-ast-printer {the AST printer shows the modifier} -body {
    surface::formatAst [surface::parse "opaque struct A:\n    v: int\nstruct B:\n    v: int\n"]
} -result {opaque struct A
    v: int
struct B
    v: int}

test opaque-ast-declaration-node-is-shared {an opaque struct is not another declaration kind: same node kind, same fields, one extra property} -body {
    set fieldNames {{ast} {lmap f [dict get [lindex [dict get $ast body] 0] fields] {list [dict get $f name] [dict get $f type]}}}
    set a [apply $fieldNames [surface::parse "opaque struct A:\n    v: int\n    w: str\n"]]
    set b [apply $fieldNames [surface::parse "struct A:\n    v: int\n    w: str\n"]]
    expr {$a eq $b && [llength $a] == 2}
} -result 1

test opaque-ast-contextual {`opaque` is not reserved: it stays an ordinary name, a field name, a function and a method name} -body {
    set a [surface::formatAst [surface::parse "opaque = 1\nopaque(2)\nx = opaque\n"]]
    set b [surface::formatAst [surface::parse "struct S:\n    opaque: int\ns = S {opaque: 1}\ns.opaque\ns.opaque()\n"]]
    list $a $b
} -result {{(bind opaque (int 1))
(call (name opaque) (int 2))
(bind x (name opaque))} {struct S
    opaque: int
(bind s (struct S (opaque (int 1))))
(project (name s) opaque)
(methodcall (name s) opaque)}}

test opaque-ast-owner-not-in-ast {the cached AST is importer- and path-neutral: the declaration carries no namespace or owner} -body {
    set d [lindex [dict get [surface::parse "opaque struct A:\n    v: int\n"] body] 0]
    lsort [dict keys $d]
} -result {fields id kind name nameSpan opaque opaqueSpan span}

foreach {name source message} {
    duplicate   "opaque opaque struct T:\n    a: int\n"          {duplicate modifier "opaque" in this struct declaration}
    stray-fn    "opaque fn f():\n    1\n"                        {"opaque" only modifies a struct declaration ("opaque struct NAME:"), not a "fn" declaration}
    stray-type  "opaque type T = Int in 0..3\n"                  {"opaque" only modifies a struct declaration ("opaque struct NAME:"), not a "type" declaration}
    stray-error "opaque error E\n"                               {"opaque" only modifies a struct declaration ("opaque struct NAME:"), not a "error" declaration}
    nested      "fn f():\n    opaque struct T:\n        a: int\n    1\n" {a struct declaration is only allowed at the top level of a module, not nested in a function/if/loop}
    no-name     "opaque struct:\n    a: int\n"                   {expected a struct name after "struct", found ":"}
    no-fields   "opaque struct T:\n"                             {a struct declaration needs at least one "field: Type" line in an indented block (there is no empty-struct syntax), found end of file}
    not-yet     "opaque context struct T:\n    a: int\n"          {expected end of line, found name "context"}
    not-yet-2   "opaque resource struct T:\n    a: int\n"         {expected end of line, found name "resource"}
    after-name  "struct opaque T:\n    a: int\n"                  {expected ":" after the struct name "opaque", found name "T"}
} {
    test opaque-syntax-$name {a malformed or unsupported opaque declaration is a located syntax error} -body {
        catch {surface::parse $source} m
        regsub {^<input>:[0-9]+:[0-9]+: } $m {}
    } -result $message
}

test opaque-syntax-recovery {a bad opaque declaration recovers like any other statement} -body {
    set ast [surface::parse "opaque fn f():\n    1\nopaque struct A:\n    v: int\nx = 1\n" -recover 1]
    list [lmap d [dict get $ast diagnostics] {dict get $d message}] \
        [lmap s [dict get $ast body] {dict get $s kind}]
} -result {{{"opaque" only modifies a struct declaration ("opaque struct NAME:"), not a "fn" declaration}} {error structdecl bind}}

test opaque-lower-decl {the lowered declaration carries the opaque flag and the namespace the loader supplied} -body {
    set ast [surface::parse "opaque struct A:\n    v: int\n"]
    set node [lindex [dict get $ast body] 0]
    list [dict get [surface::lower::StructDeclOf $node abi::x86_64] namespace] \
        [dict get [surface::lower::StructDeclOf $node abi::x86_64] opaque] \
        [dict get [surface::lower::StructDeclOf $node ""] namespace]
} -result {abi::x86_64 1 {}}

# ---------------------------------------------------------------------------
# The HIR registry and its text

test opaque-registry-entry {the HIR struct entry records opaque and the declaring namespace; an ordinary struct records opaque 0} -body {
    withScratchLibrary {
        writeFixtures $dir
        set hir [hirOfSource "import mixed\nimport wrapped\n1\n"]
        lsort [lmap entry [hir::sourceTypes $hir] {
            list [dict get $entry id] [dict get $entry namespace] [dict get $entry opaque]
        }]
    }
} -result {{mixed::Public mixed 0} {mixed::Secret mixed 1} {wrapped::Wrapped wrapped 1}}

test opaque-registry-predicates {isOpaque, owner and the authority predicate are exact} -body {
    withScratchLibrary {
        writeFixtures $dir
        hirOfSource "import mixed\nimport wrapped\n1\n"
        list [hir::structs::isOpaque wrapped::Wrapped] [hir::structs::isOpaque mixed::Public] \
            [hir::structs::owner wrapped::Wrapped] \
            [hir::structs::representationDenied wrapped::Wrapped ""] \
            [hir::structs::representationDenied wrapped::Wrapped wrapped] \
            [hir::structs::representationDenied wrapped::Wrapped mixed] \
            [hir::structs::representationDenied mixed::Public mixed::other]
    }
} -result {1 0 wrapped 1 0 1 0}

test opaque-registry-entry-program-owner {an entry program's own opaque struct is owned by the entry program (namespace "")} -body {
    set hir [hirOfSource "opaque struct Secret:\n    value: int\nSecret {value: 1}.value\n"]
    set entry [lindex [hir::sourceTypes $hir] 0]
    list [dict get $entry id] [dict get $entry namespace] [dict get $entry opaque] \
        [hir::structs::representationDenied Secret ""] [hir::structs::representationDenied Secret wrapped]
} -result {Secret {} 1 0 1}

test opaque-hir-text-roundtrip {the marker survives HIR text; an ordinary struct's line is unchanged and has no marker, and the re-read registry is as it was} -body {
    set hir [hirOfSource "opaque struct S:\n    v: int\nstruct P:\n    v: int\nS {v: 1}.v + P {v: 2}.v\n"]
    set text [hir::format $hir]
    set lines [lmap l [split $text \n] {if {![string match "struct *" $l]} continue; set l}]
    set back [hir::parse $text]
    list $lines \
        [lmap e [hir::sourceTypes $back] {list [dict get $e id] [dict get $e opaque]}] \
        [hir::structs::isOpaque S] [hir::structs::isOpaque P] \
        [expr {[hir::format $back] eq $text}]
} -result {{{struct S name S ns - opaque fields v: int} {struct P name P ns - fields v: int}} {{S 1} {P 0}} 1 0 1}

test opaque-hir-ordinary-text-has-no-opaque-word {HIR text of a program with only ordinary structs never contains the word} -body {
    set hir [hirOfSource "struct P:\n    a: int\nP {a: 1}.a\n"]
    string match *opaque* [hir::format $hir]
} -result 0

# ---------------------------------------------------------------------------
# The owner: ordinary Botlish

test opaque-owner-module-ordinary-botlish {inside its module an opaque struct is an ordinary struct: construction, projection and destructuring need nothing special} -body {
    withScratchLibrary {
        writeFixtures $dir
        agree "import wrapped\nx = wrapped::create(3, \"three\")\ny = wrapped::copy(x)\n\[wrapped::value(x), wrapped::describe(y), wrapped::value(y), x == y\]\n"
    }
} -result {[3, "three", 3, true]}

test opaque-owner-entry-program {an entry program may declare an opaque struct and is its owner: construction, projection, destructuring} -body {
    agree "opaque struct Secret:
    value: int

x = Secret {value: 1}
fn copy(s: Secret):
    {value} = s
    Secret {value: value + 1}
\[x.value, copy(x).value\]
"
} -result {[1, 2]}

test opaque-owner-entry-program-is-exact {an entry program's opaque struct is not open to a module's generic function: only the entry program's own code may project it} -body {
    withScratchLibrary {
        writeModule $dir peeker "fn peek(x):\n    x.value\n"
        rejection "import peeker\nopaque struct Secret:\n    value: int\npeeker::peek(Secret {value: 1})\n"
    }
} -match glob -result {OPAQUE-REPRESENTATION: call to peeker::peek with x : Secret is invalid: field access on Secret is not available outside the entry program; Secret has an opaque representation, so its fields can be neither projected nor destructured here (use the public operations provided by the entry program) (in the body of peeker::peek, at *)}

test opaque-owner-same-hir-as-ordinary-struct {opaque changes no HIR operation: the program's HIR, with the one declaration marker removed, is exactly the ordinary struct's, and has no opaque-specific node kind} -body {
    set body {
fn create(v: int):
    Token {value: v}

fn read(t: Token):
    t.value

fn copy(t: Token):
    {value} = t
    Token {value: value}

read(copy(create(4)))
}
    set o [hirOfSource "opaque struct Token:\n    value: int\n$body"]
    set p [hirOfSource "struct Token:\n    value: int\n$body"]
    set kinds [lsort -unique [lmap e [hir::walk $o] {hir::kind $o $e}]]
    # (The destructuring's hygienic temporary is named by its source offset.)
    set norm {{text} {regsub -all {destructure#[0-9]+} $text TMP}}
    list [expr {[apply $norm [string map {{ opaque fields} { fields}} [hir::format $o]]] eq [apply $norm [hir::format $p]]}] \
        [expr {[lsearch -glob $kinds *opaque*] < 0}] \
        [expr {[apply $norm [hir::lower $o]] eq [apply $norm [hir::lower $p]]}]
} -result {1 1 1}

# ---------------------------------------------------------------------------
# A consumer uses the value as a value

test opaque-consumer-value-semantics {a consumer passes, aliases and compares an opaque value like any value} -body {
    withScratchLibrary {
        writeFixtures $dir
        agree "import wrapped
x = wrapped::create(3, \"three\")
y = x
fn pass(v: wrapped::Wrapped) -> wrapped::Wrapped:
    v
\[wrapped::value(pass(x)), x == y, x == wrapped::create(4, \"four\"), pass(x) == y\]
"
    }
} -result {[3, true, false, true]}

test opaque-consumer-pass-store-return {passing, storing in a list, returning} -body {
    withScratchLibrary {
        writeFixtures $dir
        agree "import wrapped
import list
x = wrapped::create(3, \"three\")
fn pass(v: wrapped::Wrapped) -> wrapped::Wrapped:
    v
xs = \[x, pass(x)\]
\[wrapped::value(pass(x)), x == pass(x), list::length(xs)\]
"
    }
} -result {[3, true, 2]}

test opaque-consumer-method-and-qualified-call {the qualified accessor, the method form of the same function, and a method of a describe function} -body {
    withScratchLibrary {
        writeFixtures $dir
        agree "${::consume}\[wrapped::value(x), x.value(), x.describe(), wrapped::describe(x)\]\n"
    }
} -result {[3, 3, "three", "three"]}

test opaque-consumer-signatures {an opaque struct appears in a consumer's own signatures, struct fields and lists: the type is public} -body {
    withScratchLibrary {
        writeFixtures $dir
        agree "import wrapped
struct Box:
    inside: wrapped::Wrapped

fn open(b: Box) -> wrapped::Wrapped:
    b.inside

fn weigh(w: wrapped::Wrapped) -> int:
    wrapped::value(w)

b = Box {inside: wrapped::create(8, \"eight\")}
weigh(open(b))
"
    }
} -result 8

test opaque-consumer-holder-in-entry-program {an entry-program struct storing an opaque value is legal and projects its own field, not the stored value's} -body {
    withScratchLibrary {
        writeFixtures $dir
        list [agree "import wrapped\nstruct H:\n    t: wrapped::Wrapped\nh = H {t: wrapped::create(5, \"q\")}\nwrapped::value(h.t)\n"] \
             [rejectionKind "import wrapped\nstruct H:\n    t: wrapped::Wrapped\nh = H {t: wrapped::create(5, \"q\")}\nh.t.value\n"]
    }
} -result {5 OPAQUE-REPRESENTATION}

test opaque-consumer-no-import-type {`import type` stays reserved for source `type` declarations: a struct is spelled qualified, opaque or not} -body {
    withScratchLibrary {
        writeFixtures $dir
        rejection "import type wrapped::Wrapped\n1\n"
    }
} -match glob -result {NOT-A-TYPE: *"wrapped::Wrapped" is a struct, not a source-defined `type`*}

test opaque-consumer-anonymous-struct-is-not-an-opaque-value {an anonymous struct with the same fields never manufactures an opaque value} -body {
    withScratchLibrary {
        writeFixtures $dir
        rejection "import wrapped\nwrapped::value({value: 3, label: \"x\"})\n"
    }
} -match glob -result {TYPE: argument for parameter "x" cannot be proven to satisfy wrapped::Wrapped (argument type: *}

# ---------------------------------------------------------------------------
# What a consumer cannot do

set constructionMessage {OPAQUE-CONSTRUCTION: wrapped::Wrapped has an opaque representation owned by module "wrapped"; construct it through the public operations provided by that module}
set representationMessage {OPAQUE-REPRESENTATION: field access on wrapped::Wrapped is not available outside module "wrapped"; wrapped::Wrapped has an opaque representation, so its fields can be neither projected nor destructured here (use the public operations provided by that module)}

foreach {name literal} {
    valid          {wrapped::Wrapped {value: 3, label: "three"}}
    reordered      {wrapped::Wrapped {label: "three", value: 3}}
    constants      {wrapped::Wrapped {value: 0, label: ""}}
    missing-field  {wrapped::Wrapped {value: 3}}
    unknown-field  {wrapped::Wrapped {value: 3, label: "x", guess: 1}}
    only-guess     {wrapped::Wrapped {guess: 3}}
    duplicate      {wrapped::Wrapped {value: 3, value: 4, label: "x"}}
    wrong-type     {wrapped::Wrapped {value: "no", label: 4}}
} {
    test opaque-construct-$name "outside the owner `$literal` is rejected with the one OPAQUE-CONSTRUCTION diagnostic: no missing-field, unknown-field, duplicate or type error, no field named" -body {
        withScratchLibrary {
            writeFixtures $dir
            rejection "import wrapped\n$literal\n"
        }
    } -result $constructionMessage
}

test opaque-construct-in-a-function-and-nested {construction is rejected wherever it is written: in a function, as an argument, inside a list, in another struct's field} -body {
    withScratchLibrary {
        writeFixtures $dir
        lmap source {
            "import wrapped\nfn f():\n    wrapped::Wrapped {value: 1, label: \"a\"}\n1\n"
            "import wrapped\nwrapped::value(wrapped::Wrapped {value: 1, label: \"a\"})\n"
            "import wrapped\n\[wrapped::Wrapped {value: 1, label: \"a\"}\]\n"
            "import wrapped\nstruct H:\n    t: wrapped::Wrapped\nH {t: wrapped::Wrapped {value: 1, label: \"a\"}}\n"
        } {rejection $source}
    }
} -result [lrepeat 4 $constructionMessage]

test opaque-construct-diagnostic-kinds-all-modes {with -strict 0 the only diagnostic of a forged construction is OPAQUE-CONSTRUCTION, whatever its fields say: no field is proven against, or checked for, the hidden schema} -body {
    withScratchLibrary {
        writeFixtures $dir
        lmap literal {
            {wrapped::Wrapped {guess: 3}}
            {wrapped::Wrapped {value: "no", label: 4}}
            {wrapped::Wrapped {value: 3}}
            {wrapped::Wrapped {value: 3, label: "x", extra: 1}}
            {wrapped::Wrapped {value: 3, value: 4, label: "x"}}
        } {diagKinds "import wrapped\n$literal\n"}
    }
} -result [lrepeat 5 OPAQUE-CONSTRUCTION]

