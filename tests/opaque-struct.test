# ---------------------------------------------------------------------------
# Nothing about the representation is observable: a sweep
#
# One opaque struct whose fields have distinctive names and types (a
# source-defined domain, an ordinary struct, a contract-bearing `any` slot, a
# function-valued field). Many unauthorized programs are compiled non-strictly
# (so every diagnostic of every phase is collected); no message of any of them
# may contain a word of the hidden representation.

set ::leakModule {type Secretive = Int in 0..777

struct Lurker:
    shade: int

opaque struct Leaky:
    zeta_secret: Secretive
    hidden_tag: str
    lurk_inner: Lurker
    slot_any: any
    hook_fn: Fn{args: [int], return: int, errors: []}

fn twice(k: int) -> int:
    k + k

fn make() -> Leaky:
    Leaky {zeta_secret: 5, hidden_tag: "t", lurk_inner: Lurker {shade: 1}, slot_any: 0, hook_fn: twice}
}

set ::leakWords {zeta_secret hidden_tag lurk_inner slot_any hook_fn Lurker shade Secretive 777}

# What the sweep scans of a diagnostic: MESSAGE without the locations it
# reports ("FILE:LINE:COLUMN", which a strict compile's error starts with). A
# location says where, not what -- and FILE lies in a scratch directory named
# after the process id, which can itself contain a leak word (under pid 27770
# every strict error would "leak" 777).
proc withoutLocations {message} {
    regsub -all {[^ ]*\.bot:[0-9]+:[0-9]+(?:: )?} $message {}
}

set ::leakPrograms {
    {import leaky
leaky::Leaky {zeta_secret: 5, hidden_tag: "t", lurk_inner: leaky::Lurker {shade: 1}, slot_any: 0, hook_fn: leaky::twice}}
    {import leaky
leaky::Leaky {zeta_secret: "no", hidden_tag: 4}}
    {import leaky
leaky::Leaky {guess: 1, other: 2}}
    {import leaky
leaky::Leaky {zeta_secret: 5, zeta_secret: 6}}
    {import leaky
import mutable_array
m = mutable_array::create(2, "x")
leaky::Leaky {zeta_secret: 5, hidden_tag: "t", lurk_inner: leaky::Lurker {shade: 1}, slot_any: m, hook_fn: leaky::twice}}
    {import leaky
import mutable_array
m = mutable_array::create(2, "x")
leaky::Leaky {slot_any: m}}
    {import leaky
x = leaky::make()
x.zeta_secret}
    {import leaky
x = leaky::make()
x.hidden_tag + 1}
    {import leaky
x = leaky::make()
x.lurk_inner.shade}
    {import leaky
x = leaky::make()
x.slot_any}
    {import leaky
x = leaky::make()
x.nothing_like_it}
    {import leaky
x = leaky::make()
fn f(b: bool):
    b
f(x.zeta_secret)}
    {import leaky
x = leaky::make()
fn g(s: str):
    s
g(x.zeta_secret)}
    {import leaky
x = leaky::make()
[x.zeta_secret, x.hidden_tag]}
    {import leaky
x = leaky::make()
if x.zeta_secret:
    1
else:
    2}
    {import leaky
x = leaky::make()
{zeta_secret} = x
zeta_secret}
    {import leaky
x = leaky::make()
{hidden_tag: t, lurk_inner: {shade}} = x
shade}
    {import leaky
x = leaky::make()
{guess} = x
guess}
    {import leaky
x = leaky::make()
(x.hook_fn)(1)}
    {import leaky
x = leaky::make()
x.hook_fn(1)}
    {import leaky
x = leaky::make()
x.zeta_secret()}
    {import leaky
fn peek(q):
    q.zeta_secret
peek(leaky::make())}
    {import leaky
fn peek(q):
    {lurk_inner: {shade}} = q
    shade
peek(leaky::make())}
    {import leaky
struct H:
    t: leaky::Leaky
h = H {t: leaky::make()}
h.t.zeta_secret}
    {import leaky
x = leaky::make()
x + 1}
    {import leaky
x = leaky::make()
fn n(k: int):
    k
n(x)}
    {import leaky
x = leaky::make()
fn n(k: leaky::Secretive):
    k
n(x)}
    {import leaky
x = leaky::make()
fn f(v: any):
    v
f(x)}
    {import leaky
x = leaky::make()
[x, 1]}
    {import leaky
x = leaky::make()
x == 1}
    {import leaky
x = leaky::make()
x == {zeta_secret: 5}}
    {import leaky
x = leaky::make()
leaky::twice(x)}
}

test opaque-leak-sweep {no diagnostic of any unauthorized program, in any phase, names a field or a field type of the hidden representation} -body {
    withScratchLibrary {
        writeModule $dir leaky $::leakModule
        useStandardModule $dir mutable_array
        set leaks {}
        set rejected 0
        foreach program $::leakPrograms {
            set messages {}
            if {[catch {hirOfSource $program 0} hir options]} {
                # Every program must build (so that its diagnostics are the
                # compiler's, not a missing-module error).
                lappend leaks [list BUILD-ERROR $hir $program]
            } else {
                lappend messages {*}[lmap d [hir::diagnostics $hir] {dict get $d message}]
            }
            # The strict compile's error too.
            catch {hirOfSource $program 1} strict
            lappend messages $strict
            if {[llength $messages] > 0} { incr rejected }
            foreach word $::leakWords {
                # A word the program itself wrote (a guessed field, a type it
                # spells) may be echoed back: that says nothing about the
                # representation, whose messages are independent of it.
                if {[string first $word $program] >= 0} continue
                foreach m $messages {
                    if {[string first $word [withoutLocations $m]] >= 0} {
                        lappend leaks [list $word $m $program]
                    }
                }
            }
        }
        list $leaks [expr {$rejected == [llength $::leakPrograms]}]
    }
} -result {{} 1}

test opaque-construct-bearing-erasure-is-not-reported {a forged construction whose value would lose a typed array's contract in a hidden `any` field is still only OPAQUE-CONSTRUCTION: the erasure diagnostic ("stored in field ...") would confirm that a guessed field exists} -body {
    withScratchLibrary {
        writeModule $dir leaky $::leakModule
        useStandardModule $dir mutable_array
        set forged "import leaky\nimport mutable_array\nm = mutable_array::create(2, \"x\")\n"
        list [diagKinds "${forged}leaky::Leaky {slot_any: m}\n"] \
            [diagKinds "${forged}leaky::Leaky {guess_any: m}\n"]
    }
} -result {OPAQUE-CONSTRUCTION OPAQUE-CONSTRUCTION}

test opaque-construct-bearing-erasure-twin {the ordinary struct reports the erasure, naming the field: the control for the test above} -body {
    withScratchLibrary {
        writeModule $dir leaky [string map {{opaque struct Leaky} {struct Leaky}} $::leakModule]
        useStandardModule $dir mutable_array
        diagKinds "import leaky\nimport mutable_array\nm = mutable_array::create(2, \"x\")\nleaky::Leaky {zeta_secret: 5, hidden_tag: \"t\", lurk_inner: leaky::Lurker {shade: 1}, slot_any: m, hook_fn: leaky::twice}\n"
    }
} -result TYPE

test opaque-leak-sweep-control {the sweep can see a leak: the same words do appear in the diagnostics of the same module's struct written without the modifier} -body {
    withScratchLibrary {
        writeModule $dir leaky [string map {{opaque struct Leaky} {struct Leaky}} $::leakModule]
        set found 0
        foreach program {
            "import leaky\nleaky::Leaky {guess: 1}\n"
            "import leaky\nx = leaky::make()\nx.nothing_like_it\n"
            "import leaky\nleaky::Leaky {zeta_secret: \"no\", hidden_tag: 4}\n"
        } {
            catch {hirOfSource $program 1} m
            foreach word $::leakWords {
                if {[string first $word $program] < 0 && [string first $word [withoutLocations $m]] >= 0} { incr found; break }
            }
        }
        expr {$found >= 2}
    }
} -result 1

# ---------------------------------------------------------------------------
# No route around the boundary: higher-order calls, closures, aliases

test opaque-bypass-higher-order {a consumer function that projects an opaque argument is rejected however it is reached: passed to a module's higher-order function, aliased, destructuring, nested, or closed over} -body {
    withScratchLibrary {
        writeFixtures $dir
        writeModule $dir hof "fn apply(f, v):\n    f(v)\n"
        lmap source {
            "import hof\nimport wrapped\nfn peek(x):\n    x.value\nhof::apply(peek, wrapped::create(1, \"a\"))\n"
            "import hof\nimport wrapped\nfn peek(x: wrapped::Wrapped):\n    x.value\nhof::apply(peek, wrapped::create(1, \"a\"))\n"
            "import hof\nimport wrapped\nfn peek(x):\n    x.value\nf = peek\nhof::apply(f, wrapped::create(1, \"a\"))\n"
            "import hof\nimport wrapped\nfn peek(x):\n    {value} = x\n    value\nhof::apply(peek, wrapped::create(1, \"a\"))\n"
            "import wrapped\nw = wrapped::create(1, \"a\")\nfn grab():\n    w.value\ngrab()\n"
            "import hof\nimport wrapped\nw = wrapped::create(1, \"a\")\nfn grab(u):\n    w.label\nhof::apply(grab, 0)\n"
        } {rejectionKind $source}
    }
} -result [lrepeat 6 OPAQUE-REPRESENTATION]

test opaque-bypass-higher-order-owner-functions-pass {the owner's own functions are the sanctioned route: passed as values to a higher-order function they work} -body {
    withScratchLibrary {
        writeFixtures $dir
        writeModule $dir hof "fn apply(f, v):\n    f(v)\n"
        agree "import hof\nimport wrapped\n\[hof::apply(wrapped::value, wrapped::create(7, \"a\")), hof::apply(wrapped::describe, wrapped::create(7, \"a\"))\]\n"
    }
} -result {[7, "a"]}

# ---------------------------------------------------------------------------
# Public accessor facts (a function's contract is public; the field is not)

test opaque-accessor-facts-are-public {a consumer benefits from the owner's declared result domain: `facts::level(m)` is a Level without a check, while the field behind it stays private and the struct is no Level} -body {
    withScratchLibrary {
        writeModule $dir facts "type Level = Int in 0..9\n\nopaque struct Meter:\n    lvl: Level\n\nfn make(l: Level) -> Meter:\n    Meter {lvl: l}\n\nfn level(m: Meter) -> Level:\n    m.lvl\n"
        set need "import facts\nimport type facts::Level\nfn need(n: Level):\n    n\nm = facts::make(3)\n"
        list [agree "${need}need(facts::level(m))\n"] \
             [agree "${need}m.level()\n"] \
             [rejectionKind "${need}need(m)\n"] \
             [rejectionKind "${need}need(m.lvl)\n"]
    }
} -result {3 3 TYPE OPAQUE-REPRESENTATION}

test opaque-accessor-field-domain-is-not-exported {the hidden field's own domain is not exported through opacity: only what a function's contract says is known outside} -body {
    withScratchLibrary {
        writeModule $dir facts2 "type Level = Int in 0..9\n\nopaque struct Meter:\n    lvl: Level\n\nfn make(l: Level) -> Meter:\n    Meter {lvl: l}\n\nfn raw(m: Meter) -> int:\n    m.lvl\n"
        # raw's declared result is the full Int: no Level proof reaches the caller.
        rejectionKind "import facts2\nimport type facts2::Level\nfn need(n: Level):\n    n\nneed(facts2::raw(facts2::make(3)))\n"
    }
} -result TYPE

# ---------------------------------------------------------------------------
# Methods

test opaque-method-resolves-the-visible-function {`x.value()` is the method form of wrapped::value(x), while the field projection `x.value` is forbidden} -body {
    withScratchLibrary {
        writeFixtures $dir
        list [agree "${::consume}x.value()\n"] [rejectionKind "${::consume}x.value\n"]
    }
} -result {3 OPAQUE-REPRESENTATION}

test opaque-method-same-callee-as-qualified {the method call and the qualified call resolve to the same callee} -body {
    withScratchLibrary {
        writeFixtures $dir
        set m [hirOfSource "${::consume}x.value()\n"]
        set q [hirOfSource "${::consume}wrapped::value(x)\n"]
        proc calleeOfLast {hir} {
            set last ""
            foreach e [hir::walk $hir] {
                if {[hir::kind $hir $e] eq "call" && [hir::kind $hir [hir::get $hir $e callee]] eq "ref"
                        && [hir::get $hir [hir::get $hir $e callee] name] eq "wrapped::value"} {
                    set last [hir::get $hir [hir::get $hir $e callee] binding]
                }
            }
            return $last
        }
        expr {[calleeOfLast $m] ne "" && [calleeOfLast $m] eq [calleeOfLast $q]}
    }
} -result 1

test opaque-method-hidden-field-is-not-a-candidate {a hidden function-valued field named like a visible function neither becomes the callee nor makes the call ambiguous outside its owner} -body {
    withScratchLibrary {
        writeFixtures $dir
        agree "import hidden\ng = hidden::make()\ng.describe()\n"
    }
} -result 100

