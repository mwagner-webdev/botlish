} -match glob -result {AMBIGUOUS-METHOD-CALL: FILE: method-style call "describe" is ambiguous: the receiver (type hiddenamb::Gadget) has a field "describe" whose value may be callable, and a function "describe" is also visible here; *}

test opaque-method-consumer-function-named-like-a-hidden-field {a consumer's own function with the name of a hidden field is simply the method: hidden fields take no part in resolution} -body {
    withScratchLibrary {
        writeFixtures $dir
