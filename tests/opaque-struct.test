# ---------------------------------------------------------------------------
# Nesting

foreach {name pattern} {
    projection       {o.inner}
    projection-count {o.count}
    destructure-1    {{count} = o}
    destructure-2    {{inner} = o}
    destructure-3    {{inner: {value}} = o}
    destructure-4    {{inner: i} = o}
} {
    test opaque-nested-$name "outside the owner nothing of an opaque struct holding a public struct is reachable: `$pattern`, whatever its field's own type" -body {
        withScratchLibrary {
