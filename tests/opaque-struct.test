    }
} -result {[true, false]}

# ---------------------------------------------------------------------------
# The module cache

test opaque-cache-ast-is-not-touched {compiling programs that import a module never changes its cached AST, and the cached declaration has no importer-specific data} -body {
    withScratchLibrary {
        writeFixtures $dir
        set path [file join $dir wrapped.bot]
        set before [surface::modules::ParseModule $path]
        hirOfSource "import wrapped\nx = wrapped::create(1, \"a\")\nwrapped::value(x)\n"
        rejection "import wrapped\nwrapped::Wrapped {value: 1, label: \"a\"}\n"
        hirOfSource "import holder\nholder::make(1)\n"
        set after [surface::modules::ParseModule $path]
        expr {$before eq $after}
    }
} -result 1

test opaque-cache-owner-follows-the-module-not-the-importer {the owner of wrapped::Wrapped is `wrapped` whichever program (or module) causes it to load, in either order} -body {
    withScratchLibrary {
        writeFixtures $dir
        # First through holder (which imports wrapped itself), then directly,
        # then with the loads reversed: the same verdicts each time.
        set a [list [rejectionKind "import holder\n1\n"] \
            [rejectionKind "import holder\nh = holder::make(1)\nh.secret.value\n"] \
            [rejectionKind "import wrapped\nwrapped::Wrapped {value: 1, label: \"a\"}\n"] \
            [rejectionKind "import wrapped\nimport holder\nx = wrapped::create(1, \"a\")\nwrapped::value(x)\n"]]
        set b [list [rejectionKind "import wrapped\nwrapped::Wrapped {value: 1, label: \"a\"}\n"] \
            [rejectionKind "import holder\nh = holder::make(1)\nh.secret.value\n"] \
            [rejectionKind "import holder\n1\n"] \
            [rejectionKind "import holder\nimport wrapped\nx = wrapped::create(1, \"a\")\nwrapped::value(x)\n"]]
        list $a [expr {[lindex $a 0] eq [lindex $b 2] && [lindex $a 1] eq [lindex $b 1] && [lindex $a 2] eq [lindex $b 0] && [lindex $a 3] eq [lindex $b 3]}]
    }
} -result {{accepted OPAQUE-REPRESENTATION OPAQUE-CONSTRUCTION accepted} 1}

test opaque-cache-entry-struct-of-the-same-name-is-not-the-module-one {an entry program's own `Wrapped` (opaque or not) is a different type, owned by the entry program, whatever the module cache holds} -body {
    withScratchLibrary {
        writeFixtures $dir
        hirOfSource "import wrapped\n1\n"
        list [agree "opaque struct Wrapped:\n    value: int\nWrapped {value: 9}.value\n"] \
             [agree "struct Wrapped:\n    value: int\nWrapped {value: 9}.value\n"]
    }
} -result {9 9}

test opaque-cache-flag-edit-takes-effect {the cache is keyed by the module's text: removing `opaque` from the file makes the same consumer legal, adding it makes it illegal, with no stale answer} -body {
    withScratchLibrary {
        writeModule $dir flip "struct S:\n    v: int\n"
        set a [rejectionKind "import flip\nflip::S {v: 1}.v\n"]
        writeModule $dir flip "opaque struct S:\n    v: int\n"
        set b [rejectionKind "import flip\nflip::S {v: 1}.v\n"]
        writeModule $dir flip "struct S:\n    v: int\n"
        set c [rejectionKind "import flip\nflip::S {v: 1}.v\n"]
        list $a $b $c
    }
} -result {accepted OPAQUE-CONSTRUCTION accepted}

# ---------------------------------------------------------------------------
# Optimizer transparency (OPAQUE-STRUCTS.md "Optimizer transparency")
#
# One library module is written twice, once `opaque struct`, once `struct`,
# the same text otherwise, in two library directories; the same entry program
# is compiled against each. Opacity is source authority only, so everything
# the compiler produces is the same: HIR analyses, NIR (up to the shape
# table's rendering attribute), CLIF, and the objects allocated.

set ::smallModule "type SmallValue = Int in 0..255

@MOD@struct Small:
    value: SmallValue

fn create(v: SmallValue) -> Small:
    Small {value: v}

fn read(s: Small) -> int:
    s.value

fn bump(s: Small) -> int:
    s.value + 1
"

# {nir clif allocations structs structnew} of the program MAIN against a
# `small` module written with the modifier MODIFIER ("" or "opaque "), under
# native OPTIONS.
proc transparency {modifier main options} {
    withScratchLibrary {
        writeModule $dir small [string map [list @MOD@ $modifier] $::smallModule]
        set hir [hirOfSource $main]
        set text [dict get [native::lowered $hir {*}$options] text]
        set report [native::allocationReport $hir summary 1 {*}$options]
        set structs [expr {[dict exists $report byKind Struct] ? [dict get $report byKind Struct allocations] : 0}]
        dict create nir $text clif [native::clif $hir {*}$options] \
            allocations [dict get $report total allocations] structs $structs \
            structnew [regexp -all {= structnew } $text]
    }
}

# The value of MAIN on every backend (they must agree) against `small`
# written with MODIFIER.
proc smallValue {modifier main} {
    withScratchLibrary {
        writeModule $dir small [string map [list @MOD@ $modifier] $::smallModule]
        agree $main
    }
}

# The NIR with the one rendering attribute of an opaque shape removed.
proc plainNir {text} {
    return [string map {" opaque=1" ""} $text]
}

foreach {name main} {
    local-wrapper   "import small\nx = small::create(7)\nsmall::read(x) + small::bump(x)\n"
    stored          "import small\nxs = \[small::create(7), small::create(9)\]\nsmall::read(small::create(200))\n"
    returned-twice  "import small\nfn pass(s: small::Small) -> small::Small:\n    s\nsmall::read(pass(small::create(3)))\n"
} {
    foreach {mode options} {specialized {} generic {-specialize 0}} {
        test opaque-optimizer-$name-$mode "an opaque one-field wrapper compiles to the ordinary struct's NIR and CLIF and allocates the same objects ($mode)" -body {
            set o [transparency "opaque " $main $options]
            set p [transparency "" $main $options]
            list nir [expr {[plainNir [dict get $o nir]] eq [dict get $p nir]}] \
                clif [expr {[dict get $o clif] eq [dict get $p clif]}] \
                allocations [expr {[dict get $o allocations] == [dict get $p allocations]}] \
                structs [expr {[dict get $o structs] == [dict get $p structs]}] \
                structnew [expr {[dict get $o structnew] == [dict get $p structnew]}]
        } -result {nir 1 clif 1 allocations 1 structs 1 structnew 1}
    }
}

test opaque-optimizer-specialized-erases-the-wrapper {on the specialized path the opaque wrapper is scalar-replaced: no struct object, no structnew, no shape, no boxing -- zero cost for the abstraction} -body {
    set o [transparency "opaque " "import small\nx = small::create(7)\nsmall::read(x) + small::bump(x)\n" {}]
    list [dict get $o structs] [dict get $o allocations] [dict get $o structnew] \
        [string match *shape* [dict get $o nir]] [string match *opaque* [dict get $o nir]]
} -result {0 0 0 0 0}

test opaque-optimizer-generic-materializes-exactly-when-ordinary-does {the unspecialized path materializes the opaque struct exactly as the ordinary struct is materialized (one object here)} -body {
    set main "import small\nx = small::create(7)\nsmall::read(x) + small::bump(x)\n"
    set o [transparency "opaque " $main {-specialize 0}]
    set p [transparency "" $main {-specialize 0}]
    list [dict get $o structs] [dict get $p structs] [dict get $o structnew] [dict get $p structnew]
} -result {1 1 1 1}

test opaque-optimizer-no-runtime-check {no visibility check exists at run time: the specialized machine code (CLIF) of the opaque program is the ordinary program's, byte for byte} -body {
    set main "import small\nx = small::create(7)\nsmall::read(x) + small::bump(x)\n"
    expr {[dict get [transparency "opaque " $main {}] clif] eq [dict get [transparency "" $main {}] clif]}
} -result 1

test opaque-optimizer-range-facts-still-seen {the compiler still sees the hidden field's domain: the owner's accessor proves 0..255 + 1, so a branch on it is decided at compile time in both spellings} -body {
    set main "import small\nx = small::create(7)\nif small::bump(x) < 257:\n    1\nelse:\n    2\n"
    set o [transparency "opaque " $main {}]
    set p [transparency "" $main {}]
    list [expr {[plainNir [dict get $o nir]] eq [dict get $p nir]}] \
        [regexp -all {\bbr\y|\bcondbr\y|\bbrif\y|\bif\y} [dict get $o nir]]
} -result {1 0}

test opaque-optimizer-analysis-values-agree {the program computes the same value on every backend in both spellings} -body {
    set main "import small\nx = small::create(7)\n\[small::read(x), small::bump(x)\]\n"
    list [smallValue "opaque " $main] [smallValue "" $main]
} -result {{[7, 8]} {[7, 8]}}

test opaque-optimizer-gc-stress {native programs holding opaque values in lists agree with and without a forced collection at every allocation site} -body {
    withScratchLibrary {
        writeFixtures $dir
        set hir [hirOfSource "import wrapped\nimport list\nxs = \[wrapped::create(1, \"a\"), wrapped::create(2, \"b\"), wrapped::create(3, \"c\")\]\nwrapped::value(wrapped::create(9, \"z\")) + list::length(xs)\n"]
        set plain [outcomeUnderHir cranelift $hir]
        set ::env(BOTLISH_NATIVE_GC_STRESS) 1
        try {
            set stressed [outcomeUnderHir cranelift $hir]
        } finally {
            unset ::env(BOTLISH_NATIVE_GC_STRESS)
        }
        list [expr {$plain eq $stressed}] [lindex $plain 1]
    }
} -result {1 12}

# ---------------------------------------------------------------------------
# Fuzzing (audit/opaque-struct/tools/fuzz.tcl): a bounded run on every backend;
# a longer one is `tclsh9.0 audit/opaque-struct/tools/fuzz.tcl -n 170 -seed 1000`,
# and audit/opaque-struct/tools/mutate.tcl kills a mutant of every check.

test opaque-fuzz-smoke {random opaque and ordinary modules with consumers in two spellings agree with an oracle on every backend, every negative shape is refused (its ordinary twin accepted), and no diagnostic or printed text reveals a representation} -body {
    set output [exec [info nameofexecutable] [file join $::projectRoot audit opaque-struct tools fuzz.tcl] -n 17 -seed 9000 2>@1]
    lindex [split [string trim $output] \n] end
} -result {opaque-struct-fuzz programs 17 values 17 negatives 17 twins 16 differential-disagreements 0 oracle-disagreements 0 negative-escapes 0 twin-escapes 0 diagnostic-set-escapes 0 print-disagreements 0 message-leaks 0 backend-disagreements 0}

cleanupTests
