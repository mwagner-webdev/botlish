        # no diagnostic of the program names the hidden type.
        set source "${::consume}fn f(b: bool):\n    b\nf(x.value)\n"
        set diagnostics [hir::diagnostics [hirOfSource $source 0]]
        list [lsort -unique [lmap d $diagnostics {dict get $d kind}]] \
            [lsearch -regexp [lmap d $diagnostics {dict get $d message}] {\yint\y}]
