} -result {[true, false]}

test opaque-hash-equals-the-ordinary-struct-hash {the hash of an opaque value is computed exactly as the same struct's would be: the same value of the same declaration without the modifier hashes alike (the hash covers the declaration identity and fields, not opacity)} -body {
