# direct-modules.test -- direct modules and their mediation by module-owned
# contexts (DIRECT-MODULES.md).
#
# A module is designated direct by its file's first line, `direct module`, or
# -- for an intrinsic namespace -- by the compiler's registration metadata
# (core::native::declareDirectNamespace: the syscall transports,
# std::linux::abi::x86_64 and std::linux::abi::aarch64). A call into a direct
# module is a direct edge of the calling module; it is mediated when the
# function that makes it requires a context the calling module declares
# itself. A module with an unmediated edge is inferred direct, and the
# declaration must agree with the inference: DIRECT without the marker,
# STALE-DIRECT-MODULE with a marker nothing needs. The entry program is a
# module like any other.
#
# Every application here is a fresh directory of the tcltest temporary
# directory, compiled by surface::readProgramFile (main.tcl's front end) or
# by main.tcl itself.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]
source [file join $::projectRoot native native.tcl]

testConstraint nativeBuilt [expr {![catch {native::binary}]}]
testConstraint linuxX86_64 [expr {$::tcl_platform(os) eq "Linux"
    && $::tcl_platform(machine) in {x86_64 amd64}}]

set mainScript [file join $::projectRoot main.tcl]
set ::appCounter 0

# A fresh application directory holding FILES ({RELATIVE-PATH TEXT ...}): its
# absolute path.
proc app {files} {
    set dir [makeDirectory dm-app-[pid]-[incr ::appCounter]]
    foreach {relative text} $files {
        set path [file join $dir {*}[file split $relative]]
        file mkdir [file dirname $path]
        set channel [open $path w]
        fconfigure $channel -encoding utf-8 -translation lf
        puts -nonewline $channel $text
        close $channel
    }
    return $dir
}

proc removeApps {} {
    foreach dir [glob -nocomplain -directory [temporaryDirectory] dm-app-[pid]-*] {
        file delete -force $dir
    }
}

# The HIR of DIR/MAIN (strict unless STRICT is 0), for a Linux target
# (linuxTarget: the host's own on Linux): these programs use the Linux
# platform's direct modules.
proc appHir {dir {main main.bot} {strict 1}} {
    return [surface::readProgramFile [file join $dir $main] -warnings off -cache "" -strict $strict -target [linuxTarget]]
}

# "KIND: MESSAGE" of the compilation of DIR/MAIN, with DIR spelled APP and
# the library directory LIB, or accepted.
proc appRejection {dir {main main.bot}} {
    if {[catch {appHir $dir $main} message options]} {
        set kind [lindex [dict get $options -errorcode] end]
        return "$kind: [string map [list $dir/ "" $::core::libraryDir LIB] $message]"
    }
    return accepted
}

# The kind of DIR/MAIN's first diagnostic, or accepted.
proc appKind {dir {main main.bot}} {
    if {[catch {appHir $dir $main} message options]} {
        return [lindex [dict get $options -errorcode] end]
    }
    return accepted
}

# {UNIT STATUS ...} of HIR's module directness, for the units named UNITS (all
# when empty); the entry program is "".
proc statuses {hir {units {}}} {
    set result {}
    dict for {unit u} [dict get $hir direct units] {
        if {$units ne {} && $unit ni $units} continue
        lappend result $unit [dict get $u status]
    }
    return $result
}

# {KIND MESSAGE} of every diagnostic of the -strict 0 compilation of DIR/MAIN,
# with DIR spelled APP; and per diagnostic its related locations' lines.
proc appDiagnostics {dir {main main.bot}} {
    set hir [appHir $dir $main 0]
    return [lmap d [hir::diagnostics $hir] {
        list [dict get $d kind] [string map [list $dir/ ""] [dict get $d message]] \
            [lmap o [expr {[dict exists $d related] ? [dict get $d related] : {}}] {dict get $o line}]
    }]
}

# The value of DIR/MAIN on each of BACKENDS, or the backend's error kind.
proc appValues {dir backends} {
    set hir [appHir $dir]
    lmap backend $backends {
        lassign [outcomeUnderHir $backend $hir] tag value
        expr {$tag eq "value" ? $value : [lindex $value end]}
    }
}

# The raw syscall module of these tests: a direct application module. getpid
# makes the raw transition; add is ordinary computation, and a callable of a
# direct module all the same.
set rawModule {direct module

import std::abi::x86_64
import std::linux::abi::x86_64

struct Reading:
    value: int

fn getpid() -> int:
    std::abi::x86_64::to_int(std::linux::abi::x86_64::syscall({rax: std::abi::x86_64::register64(39)}))

fn add(a: int, b: int) -> int:
    a + b
}

# The writing preamble of the linux-layer programs.
set writeImports "import std::abi\nimport std::abi::bytes\nimport std::linux\nimport std::str\n"

# ---------------------------------------------------------------------------
# Syntax

test dm-parse-marker {`direct module` is the file's first construct, after comments and blank lines only (a #! line is a comment); the AST records its span, a file without it records ""} -body {
    set a [surface::parse "direct module\n\nimport std::linux\n1\n" t.bot]
    set b [surface::parse "#!/usr/bin/env botlish\n# a comment\n\ndirect module\nimport std::linux\n1\n" t.bot]
    set c [surface::parse "import std::linux\n1\n" t.bot]
    list [dict get $a direct line] [dict get $a direct column] [dict get $a direct endColumn] \
        [dict get $b direct line] [dict get $c direct] \
        [lindex [split [surface::formatAst $a -spans 1] \n] 0]
} -result {1 1 14 4 {} {(direct-module) @1:1-1:14}}

test dm-parse-contextual {direct and module are contextual words: ordinary names everywhere else} -body {
    set hir [surface::compile "direct = 1\nmodule = 2\nfn f(direct, module):\n    direct + module\nf(direct, module)\n" -warnings off]
    outcomeUnderHir interp $hir
} -result {value 3 {}}

test dm-parse-misplaced {the marker is located syntax: after an import, after a declaration, inside a function, inside a static block, duplicated, or with a name, each a located error} -body {
    lmap src [list \
        "import std::linux\ndirect module\n" \
        "fn f():\n    1\ndirect module\n" \
        "fn f():\n    direct module\n" \
        "fn f() errors std::compiler::CompilerError:\n    static compile:\n        direct module\n" \
        "direct module\ndirect module\n" \
        "direct module\nimport std::str\n\ndirect module\n" \
        "direct module linux\n" \
        "direct module:\n"] {
        if {[catch {surface::parse $src t.bot} message]} {
            regexp {^t.bot:([0-9]+:[0-9]+): ([A-Z-]+):} $message -> at code
            list $at $code
        } else {
            set src
        }
    }
} -result {{2:1 DIRECT-MODULE-POSITION} {3:1 DIRECT-MODULE-POSITION} {2:5 DIRECT-MODULE-POSITION} {3:9 DIRECT-MODULE-POSITION} {2:1 DUPLICATE-DIRECT-MODULE} {4:1 DUPLICATE-DIRECT-MODULE} {1:15 DIRECT-MODULE-FORM} {1:14 DIRECT-MODULE-FORM}}

test dm-parse-recover {a recovering parse reports every misplaced marker and keeps the valid one} -body {
    set ast [surface::parse "direct module\nimport std::str\ndirect module\nfn f():\n    direct module\n" t.bot -recover 1]
    list [dict get $ast direct line] [lmap d [dict get $ast diagnostics] {list [dict get $d line] [dict get $d code]}]
} -result {1 {{3 DUPLICATE-DIRECT-MODULE} {5 DIRECT-MODULE-POSITION}}}

test dm-no-call-or-function-syntax {there is no call-, function- or block-level acknowledgement: `direct fn`, `direct f()` and `direct:` are not syntax} -body {
    lmap src [list "direct fn f():\n    1\n" "direct f()\n" "fn f():\n    direct:\n        1\n"] {
        expr {[catch {surface::parse $src t.bot}] ? "rejected" : "accepted"}
    }
} -result {rejected rejected rejected}

# ---------------------------------------------------------------------------
# Designation

test dm-intrinsic-linux-abi {the syscall transports std::linux::abi::x86_64 and std::linux::abi::aarch64 -- the raw kernel transitions -- and std::binary::native, whose view reads live native memory (NATIVE-LAYOUT-VIEWS.md), are the intrinsic namespaces the compiler declares direct: registry metadata, not a name; linux (the source module) is direct by its own marker; std::abi::x86_64's address and register conversions are not direct} -body {
    list [core::native::directNamespaces] [core::native::isDirectNamespace std::linux] \
        [core::native::isDirectNamespace std::abi::x86_64] \
        [regexp {\ndirect module\n\nimport std::abi\n} [core::ReadFile [file join $::projectRoot stdlib linux.bot]]]
} -result {{std::binary::native std::linux::abi::aarch64 std::linux::abi::x86_64} 0 0 1}

test dm-intrinsic-metadata-participates {a probe intrinsic namespace declared direct is a direct module exactly like a source one: calling it unmediated is DIRECT, from a function requiring the caller's own context it is contextualized; undeclared, it is an ordinary namespace} -body {
    core::native::register dmprobe::poke -arity 1 -impl {apply {{x} {return $x}}} -param-types {int} -result-type int
    try {
        core::native::declareDirectNamespace dmprobe
        set raw [app {main.bot "import dmprobe\n\ndmprobe::poke(1)\n"}]
        set mediated [app {main.bot "import dmprobe\n\ncontext struct Probe:\n    ok: bool\n\nfn poke(context p: Probe) -> int:\n    dmprobe::poke(1)\n\nwith context Probe {ok: true}\npoke()\n"}]
        set declared [list [appKind $raw] [statuses [appHir $mediated] {""}] [appValues $mediated {interp compile}]]
        core::native::undeclareDirectNamespace dmprobe
        list $declared [appKind $raw] [statuses [appHir $raw] {""}]
    } finally {
        core::native::undeclareDirectNamespace dmprobe
        core::native::unregister dmprobe::poke
    }
} -cleanup removeApps -result {{DIRECT {{} contextualized} {1 1}} accepted {{} ordinary}}

test dm-declare-requires-members {only an intrinsic namespace with members can be declared direct} -body {
    list [catch {core::native::declareDirectNamespace dmnosuch} message] $message
} -result {1 {core::native::declareDirectNamespace: "dmnosuch" has no intrinsic members (register its natives first)}}

test dm-no-name-heuristic {directness is never read from a name: a module named raw, syscall or ffi that calls nothing direct is ordinary, and a direct module named anything is direct} -body {
    set dir [app [list main.bot "import raw\nimport syscall\nimport ffi_bits\n\n\[raw::one(), syscall::one(), ffi_bits::one()\]\n" \
        raw.bot "fn one() -> int:\n    1\n" syscall.bot "fn one() -> int:\n    1\n" ffi_bits.bot "fn one() -> int:\n    1\n" \
        other.bot "direct module\n\nimport std::linux::abi::x86_64\n"]]
    statuses [appHir $dir]
} -cleanup removeApps -result {raw ordinary syscall ordinary ffi_bits ordinary {} ordinary}

# ---------------------------------------------------------------------------
# The syscall acceptance case (the real Linux layer)

test dm-syscall-unacknowledged {an ordinary program calling std::linux::write, a callable of the direct module linux, from a context-free function is DIRECT, at the call, naming the module, the function, the direct module and both remedies} -body {
    appRejection [app [list main.bot "${::writeImports}\nfn emit(text: str) -> int:\n    std::linux::write(std::abi::i32(1), std::abi::bytes::from_list(std::str::encode_utf8(text)))\n\nemit(\"x\")\n"]]
} -cleanup removeApps -result {DIRECT: main.bot:7:5: the entry program uses direct authority: function "emit" calls std::linux::write, a callable of the direct module "std::linux", without a context defined by the entry program; require one of this module's own contexts ("context NAME: T", T a context struct or context trait declared by the entry program) in "emit", the function that makes the direct call, or declare the module direct with `direct module` as its first line}

test dm-syscall-declared {the same program declared `direct module` compiles: a deliberately low-level program; natively the write happens (the Tcl backends refuse the raw path, NATIVE-ONLY, as always)} -constraints {nativeBuilt linuxX86_64} -body {
    set dir [app [list main.bot "direct module\n\n${::writeImports}\nfn emit(text: str) -> int:\n    std::linux::write(std::abi::i32(1), std::abi::bytes::from_list(std::str::encode_utf8(text)))\n\nemit(\"\")\n"]]
    list [statuses [appHir $dir] {"" std::linux std::linux::io}] [appValues $dir {interp cranelift}]
} -cleanup removeApps -result {{std::linux direct {} direct} {NATIVE-ONLY 0}}

test dm-syscall-contextualized {the same raw call from a function requiring LocalIO, a context the program declares itself, compiles with no `direct module`: the program is contextualized, not direct} -constraints {nativeBuilt linuxX86_64} -body {
    set dir [app [list main.bot "${::writeImports}\ncontext struct LocalIO:\n    out: std::abi::I32\n\nfn emit(text: str, context io: LocalIO) -> int:\n    std::linux::write(io.out, std::abi::bytes::from_list(std::str::encode_utf8(text)))\n\nwith context LocalIO {out: std::abi::i32(1)}\n\nemit(\"\")\n"]]
    set hir [appHir $dir]
    list [statuses $hir {""}] [lmap e [dict get $hir direct units "" edges] {list [dict get $e function] [dict get $e callee] [dict get $e discharged]}] \
        [appValues $dir {cranelift}]
} -cleanup removeApps -result {{{} contextualized} {{emit std::linux::write LocalIO}} 0}

test dm-syscall-stdlib-layering {the standard library's own boundary: the transport provided direct, std::linux::sys (the architecture's syscall numbers and registers) and std::linux declared direct modules, std::linux::io contextualized by its LinuxIO, and a program using std::linux::io ordinary} -body {
    set hir [surface::readProgramFile [file join $::projectRoot examples linux context-hello.bot] -warnings off -cache "" -target [linuxTarget]]
    list [statuses $hir {std::linux::sys std::linux std::linux::io ""}] [llength [dict get $hir direct intrinsic]]
} -result {{std::linux::sys direct std::linux direct std::linux::io contextualized {} ordinary} 1}

test dm-syscall-raw-getpid {a raw syscall at the entry program's top level is undischarged whatever the program declares around it: top-level code has no context} -body {
    appRejection [app [list main.bot "import std::abi::x86_64\nimport std::linux::abi::x86_64\n\ncontext struct Local:\n    ok: bool\n\nwith context Local {ok: true}\nstd::abi::x86_64::to_int(std::linux::abi::x86_64::syscall({rax: std::abi::x86_64::register64(39)}))\n"]]
} -cleanup removeApps -result {DIRECT: main.bot:8:26: the entry program uses direct authority in its top-level code: it calls std::linux::abi::x86_64::syscall, a callable of the direct module "std::linux::abi::x86_64", and top-level code has no context, so the call is never mediated; move it into a function that requires a context defined by the entry program, or declare the module direct with `direct module` as its first line}

# ---------------------------------------------------------------------------
# Stale declarations

test dm-stale-no-authority {`direct module` with no call into a direct module is STALE-DIRECT-MODULE, at the marker} -body {
    list [appRejection [app {main.bot "direct module\n\n1\n"}]] \
        [appRejection [app {main.bot "direct module\n\nimport std::linux\n\nfn f(r: std::linux::ReadResult) -> int:\n    r.result\n\n1\n"}]]
} -cleanup removeApps -result {{STALE-DIRECT-MODULE: main.bot:1:1: `direct module` is unnecessary: the entry program makes no call into a direct module, so it exposes no direct authority; remove the declaration (it must state exactly what the compiler infers)} {STALE-DIRECT-MODULE: main.bot:1:1: `direct module` is unnecessary: the entry program makes no call into a direct module, so it exposes no direct authority; remove the declaration (it must state exactly what the compiler infers)}}

test dm-stale-fully-mediated {a module whose every direct call is mediated by its own context must drop its marker: the marker is not a permission bit under which authority can accumulate} -body {
    appRejection [app [list main.bot "direct module\n\nimport m\n\n1\n" m.bot "direct module\n\nimport std::abi::x86_64\nimport std::linux::abi::x86_64\n\ncontext struct Pids:\n    ok: bool\n\nfn pid(context p: Pids) -> int:\n    std::abi::x86_64::to_int(std::linux::abi::x86_64::syscall({rax: std::abi::x86_64::register64(39)}))\n"]]
} -cleanup removeApps -result {STALE-DIRECT-MODULE: m.bot:1:1: `direct module` is unnecessary: all direct authority in module "m" is mediated by contexts defined by "m" (every call into a direct module is in a function requiring one of them); remove the declaration (it must state exactly what the compiler infers)
main.bot:1:1: `direct module` is unnecessary: the entry program makes no call into a direct module, so it exposes no direct authority; remove the declaration (it must state exactly what the compiler infers) (CORE SEMANTIC STALE-DIRECT-MODULE)}

test dm-no-silent-promotion {a new unmediated call in an ordinary module is a compile error, never a silent promotion: the source diff must add `direct module`} -body {
    set before [app [list main.bot "import m\n\nm::two()\n" m.bot "fn two() -> int:\n    2\n"]]
    set after [app [list main.bot "import m\n\nm::two()\n" m.bot "import raw\n\nfn two() -> int:\n    raw::add(1, 1)\n" raw.bot $::rawModule]]
    set marked [app [list main.bot "import m\n\nm::two()\n" m.bot "direct module\n\nimport raw\n\nfn two() -> int:\n    raw::add(1, 1)\n" raw.bot $::rawModule]]
    list [appKind $before] [appKind $after] [appKind $marked]
} -cleanup removeApps -result {accepted DIRECT DIRECT}

# ---------------------------------------------------------------------------
# The context must reach the direct point

test dm-helper-not-laundered {a contextual outer function calling a context-free helper that makes the direct call does not mediate it: the helper is the unmediated edge} -body {
    appRejection [app [list main.bot "${::writeImports}\ncontext struct LocalIO:\n    out: std::abi::I32\n\nfn low(fd: std::abi::I32, text: str) -> int:\n    std::linux::write(fd, std::abi::bytes::from_list(std::str::encode_utf8(text)))\n\nfn high(text: str, context io: LocalIO) -> int:\n    low(io.out, text)\n\nwith context LocalIO {out: std::abi::i32(1)}\nhigh(\"\")\n"]]
} -cleanup removeApps -result {DIRECT: main.bot:10:5: the entry program uses direct authority: function "low" calls std::linux::write, a callable of the direct module "std::linux", without a context defined by the entry program; require one of this module's own contexts ("context NAME: T", T a context struct or context trait declared by the entry program) in "low", the function that makes the direct call, or declare the module direct with `direct module` as its first line}

test dm-helper-carries-the-context {carrying the module's own context onto the helper, where the direct call is, makes the program ordinary again; pure helpers below or beside the contextual functions need no context} -constraints {nativeBuilt linuxX86_64} -body {
    set dir [app [list main.bot "${::writeImports}\ncontext struct LocalIO:\n    out: std::abi::I32\n\nfn encoded(text: str) -> std::abi::bytes::Bytes:\n    std::abi::bytes::from_list(std::str::encode_utf8(text))\n\nfn low(text: str, context io: LocalIO) -> int:\n    std::linux::write(io.out, encoded(text))\n\nfn high(text: str, context io: LocalIO) -> int:\n    low(text)\n\nwith context LocalIO {out: std::abi::i32(1)}\nhigh(\"\")\n"]]
    set hir [appHir $dir]
    list [statuses $hir {""}] [lmap e [dict get $hir direct units "" edges] {list [dict get $e function] [dict get $e discharged]}] \
        [appValues $dir {cranelift}]
} -cleanup removeApps -result {{{} contextualized} {{low LocalIO}} 0}

test dm-nested-function-is-its-own {a function nested in a contextual function is its own function: its direct call is undischarged unless it requires the context itself} -body {
    list [appKind [app [list main.bot "import raw\n\ncontext struct C:\n    ok: bool\n\nfn outer(context c: C) -> int:\n    fn inner() -> int:\n        raw::add(1, 2)\n    inner()\n\nwith context C {ok: true}\nouter()\n" raw.bot $::rawModule]]] \
        [appKind [app [list main.bot "import raw\n\ncontext struct C:\n    ok: bool\n\nfn outer(context c: C) -> int:\n    fn inner(context d: C) -> int:\n        raw::add(1, 2)\n    inner()\n\nwith context C {ok: true}\nouter()\n" raw.bot $::rawModule]]]
} -cleanup removeApps -result {DIRECT accepted}

# ---------------------------------------------------------------------------
# Contexts of other modules

test dm-foreign-context {a context of another module does not mediate: B's function requiring a::ContextA leaves B inferred direct, and the diagnostic says why} -body {
    set files [list main.bot "import a\nimport b\n\nwith context a::ContextA {ok: true}\nb::raw_pid()\n" \
        a.bot "context struct ContextA:\n    ok: bool\n" \
        b.bot "import a\nimport std::abi::x86_64\nimport std::linux::abi::x86_64\n\nfn raw_pid(context c: a::ContextA) -> int:\n    std::abi::x86_64::to_int(std::linux::abi::x86_64::syscall({rax: std::abi::x86_64::register64(39)}))\n"]
    appRejection [app $files]
} -cleanup removeApps -result {DIRECT: b.bot:6:30: module "b" uses direct authority: function "b::raw_pid" calls std::linux::abi::x86_64::syscall, a callable of the direct module "std::linux::abi::x86_64", without a context defined by "b" ("b::raw_pid" requires a::ContextA, a context defined by module "a", but a context mediates direct authority only in the module that defines it: a context declared by "b" itself); require one of this module's own contexts ("context NAME: T", T a context struct or context trait declared by "b") in "b::raw_pid", the function that makes the direct call, or declare the module direct with `direct module` as its first line}

test dm-own-context {defining ContextB in B and requiring it at the raw call makes B non-direct (contextualized), whatever other contexts the function also requires} -body {
    set files [list main.bot "import a\nimport b\n\nwith context a::ContextA {ok: true}\nwith context b::create()\nb::raw_pid()\n" \
        a.bot "context struct ContextA:\n    ok: bool\n" \
        b.bot "import a\nimport std::abi::x86_64\nimport std::linux::abi::x86_64\n\nopaque context struct ContextB:\n    ok: bool\n\nfn create() -> ContextB:\n    ContextB {ok: true}\n\nfn raw_pid(context c: a::ContextA, d: ContextB) -> int:\n    std::abi::x86_64::to_int(std::linux::abi::x86_64::syscall({rax: std::abi::x86_64::register64(39)}))\n"]
    statuses [appHir [app $files]] {a b ""}
} -cleanup removeApps -result {a ordinary b contextualized {} ordinary}

test dm-context-identity-not-spelling {a context's module is its declaration's, not a spelling: `import type` cannot rename another module's context struct into this one (NOT-A-TYPE), and an entry-program struct named like a module's context is the entry program's own} -body {
    set renamed [app [list main.bot "import type a::ContextA\n\n1\n" a.bot "context struct ContextA:\n    ok: bool\n"]]
    set same [app [list main.bot "import a\nimport raw\n\ncontext struct ContextA:\n    ok: bool\n\nfn f(context c: a::ContextA) -> int:\n    raw::add(1, 1)\n\nwith context a::ContextA {ok: true}\nf()\n" \
        a.bot "context struct ContextA:\n    ok: bool\n" raw.bot $::rawModule]]
    list [appKind $renamed] [appKind $same]
} -cleanup removeApps -result {NOT-A-TYPE DIRECT}

test dm-context-construction-chain {a context whose construction needs direct authority is built under an earlier context of the same module, minted with none: the constructor's direct call is mediated like any other, and a context-free constructor gets no exemption} -body {
    set fs {import raw

opaque context struct Root:
    ok: bool

opaque context struct Probe:
    value: int

fn root() -> Root:
    Root {ok: true}

fn open(CONTEXT) -> Probe:
    Probe {value: raw::add(40, 2)}

fn value(context p: Probe) -> int:
    p.value
}
    set main "import fs\n\nwith context fs::root()\nwith context fs::open()\nfs::value()\n"
    set chained [app [list main.bot $main fs.bot [string map {CONTEXT {context r: Root}} $fs] raw.bot $::rawModule]]
    set unmediated [app [list main.bot $main fs.bot [string map {CONTEXT {}} $fs] raw.bot $::rawModule]]
    list [statuses [appHir $chained] {raw fs ""}] [appValues $chained {interp compile}] [appKind $unmediated]
} -cleanup removeApps -result {{raw direct fs contextualized {} ordinary} {42 42} DIRECT}

# ---------------------------------------------------------------------------
# The boundary is transitive in one direction only

set transitiveApp [list \
    raw.bot $rawModule \
    wrapper.bot "import raw\n\nopaque context struct Pids:\n    ok: bool\n\nfn create() -> Pids:\n    Pids {ok: true}\n\nfn pid(context p: Pids) -> int:\n    raw::getpid()\n" \
    consumer.bot "import wrapper\n\nfn same() -> bool:\n    a = wrapper::pid()\n    b = wrapper::pid()\n    a == b and a > 0\n" \
    main.bot "import consumer\nimport wrapper\n\nwith context wrapper::create()\n\nconsumer::same()\n"]

test dm-transitive-boundary {Raw direct, Wrapper (its own context at the raw call) contextualized, Consumer and Root ordinary: no taint beyond the contextualization boundary} -body {
    statuses [appHir [app $::transitiveApp]] {raw wrapper consumer ""}
} -cleanup removeApps -result {raw direct wrapper contextualized consumer ordinary {} ordinary}

test dm-transitive-runs {the contextualized syscall path runs natively (the context reaches the raw call through ordinary context requirements)} -constraints {nativeBuilt linuxX86_64} -body {
    appValues [app $::transitiveApp] {cranelift-generic cranelift}
} -cleanup removeApps -result {true true}

test dm-tooling-explains {main.tcl -direct explains every unit: declaration, inference, status and each direct edge with what mediates it} -constraints nativeBuilt -body {
    set dir [app $::transitiveApp]
    # (The run itself is the Tcl backend's NATIVE-ONLY refusal of the syscall;
    # a Linux program, compiled for a Linux target: linuxTarget.)
    catch {exec [info nameofexecutable] $::mainScript -backend interp -direct -warnings off -target [linuxTarget] [file join $dir main.bot] 2>@1} out
    set lines [lmap line [split [string map [list $dir/ ""] $out] \n] {
        expr {[regexp {^(module (raw|wrapper|consumer)|entry program|    (raw|wrapper)::|intrinsic)} $line] ? $line : [continue]}
    }]
    join $lines \n
} -cleanup removeApps -result {module raw: direct (declared direct, inferred direct)
    raw::getpid -> std::linux::abi::x86_64::syscall (direct module std::linux::abi::x86_64, raw.bot:10:30): undischarged
module wrapper: contextualized (declared ordinary, inferred ordinary)
    wrapper::pid -> raw::getpid (direct module raw, wrapper.bot:10:5): mediated by wrapper::Pids
module consumer: ordinary (declared ordinary, inferred ordinary)
entry program: ordinary (declared ordinary, inferred ordinary)
intrinsic std::linux::abi::x86_64: provided direct by the compiler}

# ---------------------------------------------------------------------------
# Module granularity

test dm-coarse-module {every callable of a direct module is direct, a pure one included: raw::add from an ordinary module is DIRECT, and contextualized like any other edge} -body {
    list [appRejection [app [list main.bot "import raw\n\nraw::add(1, 2)\n" raw.bot $::rawModule]]] \
        [appValues [app [list main.bot "import raw\n\ncontext struct Math:\n    ok: bool\n\nfn three(context m: Math) -> int:\n    raw::add(1, 2)\n\nwith context Math {ok: true}\nthree()\n" raw.bot $::rawModule]] {interp compile}]
} -cleanup removeApps -result {{DIRECT: main.bot:3:1: the entry program uses direct authority in its top-level code: it calls raw::add, a callable of the direct module "raw", and top-level code has no context, so the call is never mediated; move it into a function that requires a context defined by the entry program, or declare the module direct with `direct module` as its first line} {3 3}}

test dm-direct-module-internal {inside a direct module, unmediated direct calls are plain code: raw's own functions call each other and the syscall with no context} -body {
    set dir [app [list main.bot "direct module\n\nimport raw\n\nraw::add(raw::add(1, 2), 3)\n" raw.bot "${::rawModule}\nfn six() -> int:\n    add(add(1, 2), 3)\n"]]
    list [statuses [appHir $dir] {raw ""}] [appValues $dir {interp compile}]
} -cleanup removeApps -result {{raw direct {} direct} {6 6}}

test dm-direct-module-with-contexts {a direct module may contextualize some authority and expose other authority directly: it stays direct while one edge is unmediated} -body {
    set dir [app [list main.bot "direct module\n\nimport mixed\n\nwith context mixed::create()\n\[mixed::safe(), mixed::open()\]\n" \
        raw.bot $::rawModule \
        mixed.bot "direct module\n\nimport raw\n\nopaque context struct Gate:\n    ok: bool\n\nfn create() -> Gate:\n    Gate {ok: true}\n\nfn safe(context g: Gate) -> int:\n    raw::add(1, 1)\n\nfn open() -> int:\n    raw::add(2, 2)\n"]]
    set hir [appHir $dir]
    list [statuses $hir mixed] [lmap e [dict get $hir direct units mixed edges] {list [dict get $e function] [dict get $e discharged]}] \
        [appValues $dir {interp compile}]
} -cleanup removeApps -result {{mixed direct} {{mixed::safe mixed::Gate} {mixed::open {}}} {{[2, 4]} {[2, 4]}}}

# ---------------------------------------------------------------------------
# Types and imports are not authority

test dm-import-is-not-authority {importing a direct module is not direct: its types are usable in signatures, constructions and projections with no `direct module`} -body {
    set dir [app [list main.bot "import std::abi::bytes\nimport std::linux\nimport raw\n\nfn shown(r: raw::Reading) -> int:\n    r.value\n\nfn result_of(r: std::linux::ReadResult) -> int:\n    r.result\n\nshown(raw::Reading {value: 4})\n" raw.bot $::rawModule]]
    list [statuses [appHir $dir] {""}] [appValues $dir {interp compile}]
} -cleanup removeApps -result {{{} ordinary} {4 4}}

# ---------------------------------------------------------------------------
# First-class callables

test dm-callable-value-escapes {a non-direct module may not take a direct module's callable as a value: returning, storing, listing, passing or returning an alias of it is DIRECT-CALLABLE-VALUE} -body {
    lmap body [list \
        "fn get():\n    raw::add\n\n1\n" \
        "holder = {f: raw::add}\n1\n" \
        "fs = \[raw::add\]\n1\n" \
        "fn apply(f) -> int:\n    f(1, 2)\n\napply(raw::add)\n" \
        "w = raw::add\nfn get():\n    w\n\n1\n" \
        "context struct C:\n    ok: bool\n\nfn get(context c: C):\n    raw::add\n\nwith context C {ok: true}\nget()\n1\n"] {
        lsort -unique [lmap d [hir::diagnostics [appHir [app [list main.bot "import raw\n\n$body" raw.bot $::rawModule]] main.bot 0]] {dict get $d kind}]
    }
} -cleanup removeApps -result {DIRECT-CALLABLE-VALUE DIRECT-CALLABLE-VALUE DIRECT-CALLABLE-VALUE DIRECT-CALLABLE-VALUE DIRECT-CALLABLE-VALUE DIRECT-CALLABLE-VALUE}

test dm-callable-value-message {the escape is explained} -body {
    appRejection [app [list main.bot "import raw\n\nfn get():\n    raw::add\n\n1\n" raw.bot $::rawModule]]
} -cleanup removeApps -result {DIRECT-CALLABLE-VALUE: main.bot:4:5: raw::add is a callable of the direct module "raw": the entry program, which is not declared direct, may only call it (or bind it to another name as a statement), never pass, return, store or capture it as a value -- a call through an unknown function value would carry direct authority past this module's context boundary unseen (DIRECT-MODULES.md)}

test dm-alias-calls-are-edges {binding a direct callable to another name as a statement is allowed, and every call through the alias -- also from a closure capturing it -- is a direct edge of its own} -body {
    set dir [app [list main.bot "import raw\n\ncontext struct C:\n    ok: bool\n\nw = raw::add\nfn ok(context c: C) -> int:\n    w(1, 2)\nfn bad() -> int:\n    w(3, 4)\n\nwith context C {ok: true}\nok()\n" raw.bot $::rawModule]]
    lmap d [appDiagnostics $dir] {lrange $d 0 0}
} -cleanup removeApps -result {DIRECT}

test dm-direct-module-hands-out {a direct module may hand out its own callables (it declared that it exposes raw authority); obtaining one is itself a call into the direct module, so the receiving module mediates or declares that call} -body {
    set raw "${::rawModule}\nfn handout():\n    add\n"
    list [appKind [app [list main.bot "import raw\n\nf = raw::handout()\nf(1, 2)\n" raw.bot $raw]]] \
        [appValues [app [list main.bot "import raw\n\ncontext struct C:\n    ok: bool\n\nfn three(context c: C) -> int:\n    f = raw::handout()\n    f(1, 2)\n\nwith context C {ok: true}\nthree()\n" raw.bot $raw]] {interp compile}]
} -cleanup removeApps -result {DIRECT {3 3}}

test dm-direct-module-may-pass {a direct module passing a direct callable on is no escape: the direct module is the boundary that exposes it} -body {
    set dir [app [list main.bot "direct module\n\nimport apply\nimport raw\n\nraw::add(0, 0) + apply::twice(raw::add)\n" raw.bot $::rawModule \
        apply.bot "fn twice(f) -> int:\n    f(1, 2) + f(3, 4)\n"]]
    list [statuses [appHir $dir] {raw apply ""}] [appValues $dir {interp compile}]
} -cleanup removeApps -result {{apply ordinary raw direct {} direct} {10 10}}

# ---------------------------------------------------------------------------
# Context traits and trait operations

set traitApp [list \
    api.bot "context trait Out:\n    fn emit(n: int) -> int\n\nfn send(n: int, context o: Out) -> int:\n    o.emit(n)\n" \
    rawout.bot "direct module\n\nimport raw\n\ncontext struct RawOut:\n    ok: bool\n\nfn create() -> RawOut:\n    RawOut {ok: raw::add(1, 1) > 0}\n\nfn emit(n: int, context r: RawOut) -> int:\n    raw::add(n, 1)\n" \
    raw.bot $rawModule]

test dm-context-trait-mediates {a context trait a module declares itself mediates like its context structs: api::send's operation runs the direct rawout's implementation, mediated by api::Out} -body {
    set dir [app [concat $::traitApp [list main.bot "direct module\n\nimport api\nimport rawout\n\nwith context rawout::create()\napi::send(1)\n"]]]
    set hir [appHir $dir]
    list [statuses $hir {api rawout ""}] [lmap e [dict get $hir direct units api edges] {list [dict get $e via] [dict get $e target] [dict get $e discharged]}] \
        [appValues $dir {interp compile}]
} -cleanup removeApps -result {{api contextualized rawout direct {} direct} {{trait rawout api::Out}} {2 2}}

test dm-foreign-context-trait {an operation of another module's context trait, run in a function of an ordinary module, is a direct edge into the selected provider's direct module that the foreign trait does not mediate} -body {
    set dir [app [concat $::traitApp [list user.bot "import api\n\nfn relay(n: int, context o: api::Out) -> int:\n    o.emit(n)\n" \
        main.bot "direct module\n\nimport api\nimport rawout\nimport user\n\nwith context rawout::create()\nuser::relay(1)\n"]]]
    lmap d [appDiagnostics $dir] {list [lindex $d 0] [regexp {requires api::Out, a context defined by module "api"} [lindex $d 1]]}
} -cleanup removeApps -result {{DIRECT 1}}

test dm-value-trait-operation {a value-trait operation may run a direct module's implementation: generic code calling it is a direct edge into every direct module defining one} -body {
    set dir [app [list main.bot "direct module\n\nimport show\nimport sample\n\nshow::shown(sample::make())\n" \
        show.bot "trait Show:\n    fn text(self: Show) -> str\n\nfn shown(x: Show) -> str:\n    x.text()\n" \
        sample.bot "direct module\n\nimport raw\n\nstruct Sample:\n    n: int\n\nfn make() -> Sample:\n    Sample {n: raw::add(1, 1)}\n\nfn text(s: Sample) -> str:\n    \"sample\"\n" \
        raw.bot $::rawModule]]
    lmap d [appDiagnostics $dir] {list [lindex $d 0] [regexp {^module "show" uses direct authority: function "show::shown" calls a trait operation that may run sample::text \(an implementation of show::Show's text\), a callable of the direct module "sample"} [lindex $d 1]]}
} -cleanup removeApps -result {{DIRECT 1}}

# ---------------------------------------------------------------------------
# Module structure

test dm-cycles-stay-forbidden {module cycles are still forbidden (CYCLE), direct or not: there is no partial analysis order for directness to disappear in} -body {
    appKind [app {main.bot "import a\n\na::f()\n" a.bot "direct module\n\nimport b\nimport std::linux::abi::x86_64\n\nfn f() -> int:\n    1\n" b.bot "import a\n\nfn g() -> int:\n    1\n"}]
} -cleanup removeApps -result {CYCLE}

test dm-root-not-special {the entry program and an application module with the same code get the same verdict} -body {
    set code "import raw\n\nfn f() -> int:\n    raw::add(1, 2)\n"
    list [appKind [app [list main.bot "${code}\nf()\n" raw.bot $::rawModule]]] \
        [appKind [app [list main.bot "import m\n\nm::f()\n" m.bot $code raw.bot $::rawModule]]]
} -cleanup removeApps -result {DIRECT DIRECT}

test dm-diagnostics-recover {one diagnostic per function, at its first unmediated direct call, its others as related locations; another function's gets its own, and unrelated diagnostics are still reported} -body {
    set dir [app [list main.bot "import raw\n\nfn a() -> int:\n    raw::add(1, 2) + raw::add(3, 4) + raw::getpid()\n\nfn b() -> int:\n    raw::add(5, 6)\n\nfn c(x: int) -> int:\n    x\n\nc(\"s\")\n" raw.bot $::rawModule]]
    lmap d [appDiagnostics $dir] {list [lindex $d 0] [regexp {\(2 more undischarged direct calls in the same function} [lindex $d 1]] [lindex $d 2]}
} -cleanup removeApps -result {{TYPE 0 {}} {DIRECT 1 {4 4}} {DIRECT 0 {}}}

test dm-unreachable-code-counts {a direct call in unreachable or uncalled code still names the authority: the module is inferred direct} -body {
    list [appKind [app [list main.bot "import raw\n\nfn never() -> int:\n    raw::add(1, 2)\n\n1\n" raw.bot $::rawModule]]] \
        [appKind [app [list main.bot "import raw\n\nfn f(c: bool) -> int:\n    if false:\n        return raw::add(1, 2)\n    0\n\nf(true)\n" raw.bot $::rawModule]]]
} -cleanup removeApps -result {DIRECT DIRECT}

test dm-method-sugar {a direct callable reached through method syntax is a direct edge (an obligation of the selected call, never a reason to pick another candidate)} -body {
    appKind [app [list main.bot "${::writeImports}\nfn emit(text: str) -> int:\n    std::abi::i32(1).write(std::abi::bytes::from_list(std::str::encode_utf8(text)))\n\nemit(\"\")\n"]]
} -cleanup removeApps -result {DIRECT}

test dm-method-sugar-two-candidates {with another visible candidate of the name, the direct one is still selected and its call is DIRECT -- never NO-APPLICABLE-METHOD} -body {
    appKind [app [list main.bot "${::writeImports}\nfn write(label: str, n: int) -> int:\n    n\n\nfn emit(text: str) -> int:\n    std::abi::i32(1).write(std::abi::bytes::from_list(std::str::encode_utf8(text)))\n\nemit(\"\")\n"]]
} -cleanup removeApps -result {DIRECT}

test dm-coroutine-thunk {a coroutine construction's thunk runs where it is constructed: a direct call it makes is mediated by the constructing function's context} -body {
    set dir [app [list main.bot "import std::coroutine\nimport gen\n\ncontext struct C:\n    ok: bool\n\nfn first(context c: C) -> int:\n    coroutine {step, first} = gen::count(1)\n    first\n\nwith context C {ok: true}\nfirst()\n" \
        gen.bot "direct module\n\nimport std::coroutine\nimport raw\n\nfn count(n: int) -> int:\n    yield raw::add(n, 0)\n    n + 1\n" raw.bot $::rawModule]]
    list [statuses [appHir $dir] {""}] [appValues $dir {interp compile}]
} -cleanup removeApps -result {{{} contextualized} {1 1}}

# ---------------------------------------------------------------------------
# Static intrinsics

test dm-static-compile-direct {a static block whose body makes an unmediated direct call is rejected with DiagnosticCode::Direct (the rejected program has no direct call left)} -body {
    set dir [app [list main.bot "import std::compiler\nimport raw\n\nfn probe() -> int errors std::compiler::CompilerError:\n    static compile:\n        raw::add(1, 2)\n\nr = probe():\n    on std::compiler::CompilerError {code}:\n        if code == std::compiler::DiagnosticCode::Direct:\n            1\n        else:\n            0\nr\n" raw.bot $::rawModule]]
    list [statuses [appHir $dir] {""}] [appValues $dir {interp compile}]
} -cleanup removeApps -result {{{} ordinary} {1 1}}

test dm-static-compile-callable-value {DIRECT-CALLABLE-VALUE in a static block is DiagnosticCode::DirectCallableValue} -body {
    set dir [app [list main.bot "import std::compiler\nimport raw\n\nfn probe() -> int errors std::compiler::CompilerError:\n    static compile:\n        f = \[raw::add\]\n        1\n\nr = probe():\n    on std::compiler::CompilerError {code}:\n        if code == std::compiler::DiagnosticCode::DirectCallableValue:\n            1\n        else:\n            0\nr\n" raw.bot $::rawModule]]
    appValues $dir {interp compile}
} -cleanup removeApps -result {1 1}

test dm-static-compile-accepted-in-direct-module {in a direct module the same block is accepted: the module is direct by the block's own call} -body {
    set dir [app [list main.bot "direct module\n\nimport std::compiler\nimport raw\n\nfn probe() -> int errors std::compiler::CompilerError:\n    static compile:\n        raw::add(1, 2)\n\nr = probe():\n    on std::compiler::CompilerError:\n        0\nr\n" raw.bot $::rawModule]]
    list [statuses [appHir $dir] {""}] [appValues $dir {interp compile}]
} -cleanup removeApps -result {{{} direct} {3 3}}

test dm-static-compile-final-program {directness is the final program's: a direct module whose only direct call is in a block rejected for another reason is stale} -body {
    appKind [app [list main.bot "direct module\n\nimport std::compiler\nimport raw\n\nfn probe() -> int errors std::compiler::CompilerError:\n    static compile:\n        raw::add(1, \"two\")\n\nr = probe():\n    on std::compiler::CompilerError:\n        0\nr\n" raw.bot $::rawModule]]
} -cleanup removeApps -result {STALE-DIRECT-MODULE}

# ---------------------------------------------------------------------------
# Compilation isolation, interchange, determinism

test dm-isolation {one compilation's direct module "a" never makes another compilation's unrelated module "a" direct, and each HIR keeps its own verdict} -body {
    set one [app [list main.bot "direct module\n\nimport a\n\na::f()\n" a.bot "direct module\n\nimport raw\n\nfn f() -> int:\n    raw::add(1, 2)\n" raw.bot $::rawModule]]
    set two [app [list main.bot "import a\n\na::f()\n" a.bot "fn f() -> int:\n    3\n"]]
    set h1 [appHir $one]
    set h2 [appHir $two]
    list [statuses $h1 {a ""}] [statuses $h2 {a ""}] [statuses [appHir $one] {a ""}]
} -cleanup removeApps -result {{a direct {} direct} {a ordinary {} ordinary} {a direct {} direct}}

test dm-interchange-keeps-the-summary {the HIR interchange text keeps the module declarations and the directness summary: a HIR read back reports the same, with no front end run} -body {
    set hir [appHir [app $::transitiveApp]]
    set back [hir::interchange::decode [hir::interchange::encode $hir]]
    list [expr {[dict get $back direct] eq [dict get $hir direct]}] [expr {[dict get $back moduleDecls] eq [dict get $hir moduleDecls]}] \
        [statuses $back {raw wrapper consumer ""}]
} -cleanup removeApps -result {1 1 {raw direct wrapper contextualized consumer ordinary {} ordinary}}

test dm-deterministic {two compilations of one program give the identical summary, and the summary does not depend on import order} -body {
    set a [app [list main.bot "import x\nimport y\n\nx::f() + y::g()\n" x.bot "fn f() -> int:\n    1\n" y.bot "fn g() -> int:\n    2\n"]]
    set b [app [list main.bot "import y\nimport x\n\nx::f() + y::g()\n" x.bot "fn f() -> int:\n    1\n" y.bot "fn g() -> int:\n    2\n"]]
    list [expr {[dict get [appHir $a] direct] eq [dict get [appHir $a] direct]}] \
        [lsort -stride 2 [statuses [appHir $a]]] [lsort -stride 2 [statuses [appHir $b]]]
} -cleanup removeApps -result {1 {{} ordinary x ordinary y ordinary} {{} ordinary x ordinary y ordinary}}

test dm-core-ir-untouched {programs past the source boundary are not judged: core IR text calling the raw syscall builds as it always did, with no directness summary} -body {
    set hir [hir::build {{call {ref std::linux::abi::x86_64::syscall} {const 39}}} -strict 0]
    list [dict exists $hir direct] [lmap d [hir::diagnostics $hir] {dict get $d kind}]
} -result {0 TYPE}

test dm-no-runtime-representation {directness is compile time only: no runtime, lowering or backend file names it} -body {
    set hits {}
    foreach path [concat [glob [file join $::projectRoot core *.tcl]] [glob [file join $::projectRoot compiler *.tcl]] \
            [glob [file join $::projectRoot native *.tcl]] [glob -directory [file join $::projectRoot native src] -types f *.rs] \
            [glob -nocomplain -directory [file join $::projectRoot native src runtime] -types f *.rs]] {
        foreach line [split [core::ReadFile $path] \n] {
            if {[regexp {hir::direct::|moduleDecls|\[dict get \$hir direct|DIRECT-CALLABLE} $line]} {
                lappend hits [file tail $path]
            }
        }
    }
    lsort -unique $hits
} -result {}

# ---------------------------------------------------------------------------
# The single-file compiler

set singleExecutable [expr {[info exists ::env(BOTLISH_SINGLE)] ? $::env(BOTLISH_SINGLE)
    : [file join $::projectRoot single out botlish]}]
testConstraint singleExecutable [file executable $singleExecutable]

test dm-single-executable {the single executable, run from outside the checkout with an empty environment, applies the same rules: a raw application module, a contextual wrapper and an ordinary root compile and run natively; an unmarked raw root is DIRECT; a declared direct root runs} -constraints {singleExecutable linuxX86_64} -body {
    set dir [app $::transitiveApp]
    set home [makeDirectory dm-single-home-[pid]]
    set ok [exec env -i HOME=$home $::singleExecutable -backend cranelift -warnings off [file join $dir main.bot] 2>@1]
    set direct [app [list main.bot "import std::abi::x86_64\nimport std::linux::abi::x86_64\n\nstd::abi::x86_64::to_int(std::linux::abi::x86_64::syscall({rax: std::abi::x86_64::register64(39)})) > 0\n"]]
    catch {exec env -i HOME=$home $::singleExecutable -backend cranelift -warnings off [file join $direct main.bot] 2>@1} rejected
    set declared [app [list main.bot "direct module\n\nimport std::abi::x86_64\nimport std::linux::abi::x86_64\n\nstd::abi::x86_64::to_int(std::linux::abi::x86_64::syscall({rax: std::abi::x86_64::register64(39)})) > 0\n"]]
    set run [exec env -i HOME=$home $::singleExecutable -backend cranelift -warnings off [file join $declared main.bot] 2>@1]
    file delete -force $home
    list [regexp {value: true} $ok] [regexp {DIRECT} $rejected] [regexp {value: true} $run]
} -cleanup removeApps -result {1 1 1}

cleanupTests
