        [file join $::projectRoot examples io hello-darwin.bot] 2>@1]
    list $values [lrange [split $main \n] 1 2]
} -result {{{value {"ok"}} {value {"ok"}}} {{Hello, world!} {   value: unit}}}

# ---------------------------------------------------------------------------
# Short writes and failures (the write(2) interposer)

set ::injectLibrary ""
proc injectLibrary {} {
    if {$::injectLibrary eq ""} {
        set path [file join $::scratch libbcf_write_inject.dylib]
        exec cc -dynamiclib -O2 [file join $::projectRoot tests cffi write-inject.c] -o $path
        set ::injectLibrary $path
    }
    return $::injectLibrary
}

# {STDOUT STDERR STATUS LOG} of EXE run with the interposer's PLAN on
# descriptor FD; LOG the planned calls, {ASKED RESULT ERRNO} each.
proc injected {exe plan {fd 1} {stress 0}} {
    set log [file join $::scratch inject[incr ::runCounter].log]
    set run [diRun [list env DYLD_INSERT_LIBRARIES=[injectLibrary] BCF_WRITE_FD=$fd BCF_WRITE_PLAN=$plan BCF_WRITE_LOG=$log \
        BOTLISH_NATIVE_GC_STRESS=$stress $exe]]
    set calls [expr {[file exists $log] ? [lmap line [split [string trim [readBinary $log]] \n] {set line}] : {}}]
    return [concat $run [list $calls]]
}

# INJECTED with its log cut to its first N calls.
proc firstCalls {injected n} {
    lset injected 3 [lrange [lindex $injected 3] 0 [expr {$n - 1}]]
    return $injected
}

