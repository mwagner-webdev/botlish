# darwin-io.test -- Darwin I/O through libSystem: the macOS platform
# namespace `darwin` (stdlib/darwin.bot, stdlib/darwin/io.bot, stdlib/darwin/path.bot)
# and the portable std::io::IO through its DarwinIO context
# (MACOS-AARCH64-MILESTONE-8.md):
#
#   import std::io
#   import std::darwin::io
#
#   fn hello() errors std::io::WriteFailed:
#       std::io::print_line("Hello, world!")
#
#   with context std::darwin::io::create()
#   hello()
#
# hello is examples/io/hello.bot's function, unchanged; only the installed
# context differs. std::io::print_line requires std::io::IO, DarwinIO is the one
# installed context implementing it, and the call compiles to a direct call
# of std::darwin::io::write_text, whose writes are C calls of libSystem's write --
# no syscall, no compiler knowledge of I/O. Failures come back as C reports
# them: -1 and the thread's errno, read through a native view of the int
# __error() points to.
#
# Two kinds of test:
#
#   * the front end, on every host (programs compiled for macos-aarch64):
#     the platform rule, the C contracts, the static context selection, the
#     authority boundary, the Tcl backends' NATIVE-ONLY;
#   * execution, where the darwin platform is the host's and C calls link
#     (darwinIO: macOS arm64 today): standalone Mach-O executables and the
#     native backends' linked runs, against the host's own headers, real
#     descriptors, files of a private directory and a write(2) interposer
#     (tests/cffi/write-inject.c) where the operating system would not fail
#     on demand.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]
source [file join $::projectRoot native native.tcl]

interp recursionlimit {} 100000

testConstraint nativeBuilt [expr {![catch {native::binary}]}]
testConstraint cCompiler [expr {[auto_execok cc] ne ""}]
testConstraint posixShell [expr {[auto_execok sh] ne ""}]
set ::hostTarget [core::cabi::hostTarget]
# Darwin I/O runs (tests/helpers.tcl's darwinIO), with the native backend
# built and its executables linked by rustc.
testConstraint darwinIO [expr {[testConstraint darwinIO] && [testConstraint nativeBuilt] && [testConstraint cLinker]}]
# The interposer library, where the darwin platform runs and a C compiler
# builds dynamic libraries.
testConstraint writeInject [expr {[testConstraint darwinIO] && [testConstraint cCompiler]}]

set scratch [makeDirectory darwin-io-[pid]]
set programCounter 0

proc readBinary {path} {
    set channel [open $path rb]
    set data [read $channel]
    close $channel
    return $data
}

proc writeText {path text} {
    set channel [open $path w]
    fconfigure $channel -encoding utf-8 -translation lf
    puts -nonewline $channel $text
    close $channel
}

# The HIR of program TEXT, written as a program file in its own directory
# (so library modules load, and application modules FILES beside it:
# {NAME TEXT ...}), compiled for TARGET (macos-aarch64: the darwin platform's
# target on every host).
proc diHir {text {target macos-aarch64} {files {}}} {
    set dir [file join $::scratch app[incr ::programCounter]]
    file mkdir $dir
    foreach {name body} $files {
        writeText [file join $dir $name] $body
    }
    writeText [file join $dir main.bot] $text
    return [surface::readProgramFile [file join $dir main.bot] -warnings off -cache "" -target $target]
}

# {KIND MESSAGE} of the first diagnostic compiling TEXT for TARGET (its
# location removed), or accepted.
proc diRejection {text {target macos-aarch64} {files {}}} {
    if {[catch {diHir $text $target $files} message options]} {
        regsub {^.*?:[0-9]+:[0-9]+: } [lindex [split $message \n] 0] {} message
        return [list [lindex [dict get $options -errorcode] end] $message]
    }
    return accepted
}

# The standalone executable of TEXT (with application modules FILES; native
# lowering OPTIONS): its path.
proc diExecutable {text {files {}} {options {}}} {
    set hir [diHir $text $::hostTarget $files]
    set path [file join $::scratch exe[incr ::programCounter]]
    return [native::executable $hir $path {*}$options]
}

# {STDOUT STDERR STATUS} (bytes as binary strings; STATUS the exit status)
# of one run of COMMAND, standard input from INPUT (a path; /dev/null by
# default).
proc diRun {command {input /dev/null}} {
    set n [incr ::runCounter]
    set out [file join $::scratch out.$n]
    set err [file join $::scratch err.$n]
    set status 0
    if {[catch {exec {*}$command <$input >$out 2>$err} message options]} {
        set code [dict get $options -errorcode]
        set status [expr {[lindex $code 0] eq "CHILDSTATUS" ? [lindex $code end] : $message}]
    }
    return [list [readBinary $out] [readBinary $err] $status]
}
set runCounter 0

# A file of BYTES (a binary string) in the scratch directory: its path.
proc diInput {bytes} {
    set path [file join $::scratch in[incr ::runCounter]]
    set channel [open $path wb]
    puts -nonewline $channel $bytes
    close $channel
    return $path
}

# Text as UTF-8 bytes, for comparing with diRun's output.
proc utf8 {text} {
    return [encoding convertto utf-8 $text]
}

# The NIR body of function NAME (instruction lines, origins removed).
proc nirBody {nir name} {
    set lines {}
    set inside 0
    foreach line [split $nir \n] {
        if {[string match "func *" $line]} {
            set inside [string match "func * \"$name\" *" $line]
            continue
        }
        if {$line eq "end"} {
            set inside 0
            continue
        }
        if {$inside} {
            lappend lines [string trim [regsub -all {@e[0-9]+} $line ""]]
        }
    }
    return $lines
}

proc nirId {nir name} {
    foreach line [split $nir \n] {
        if {[string match "func * \"$name\" *" $line]} {
            return [lindex $line 1]
        }
    }
    return ""
}

set helloLinux [core::ReadFile [file join $::projectRoot examples io hello.bot]]
set helloDarwin [core::ReadFile [file join $::projectRoot examples io hello-darwin.bot]]

# Every portable operation, UTF-8 beyond ASCII, routed to stdout and stderr;
# the program's value says whether a WriteFailed reached it.
set routingText {import std::io
import std::darwin::io

fn emit_all() -> str errors std::io::WriteFailed:
    std::io::print("out:")
    std::io::print_line(" é 𝄞")
    std::io::write_error("err:")
    std::io::write_error_line(" done")
    "ok"

with context std::darwin::io::create()

emit_all():
    on std::io::WriteFailed:
        "failed"
}

# The Hello World whose value says whether the write failed.
set statusText {import std::io
import std::darwin::io

fn hello() -> str errors std::io::WriteFailed:
    std::io::print_line("Hello, world!")
    "ok"

with context std::darwin::io::create()

hello():
    on std::io::WriteFailed:
        "failed"
}

# ---------------------------------------------------------------------------
# The platform namespace (core/cabi.tcl's platforms, surface/modules.tcl's
# PlatformCheck)

test di-platform-rule {std::darwin and every namespace under it are the macOS platform's, by the target table's designation: they compile for macos-aarch64 (and macos-x86_64, a macOS target), and are UNSUPPORTED-PLATFORM for every Linux and Windows target, naming the namespace root; the Linux platform's namespaces stay refused for macOS, and a namespace only named like a system is no platform's} -body {
    set results {}
    foreach import {std::darwin std::darwin::io std::darwin::path} {
        foreach target {macos-aarch64 macos-x86_64 linux-x86_64 linux-aarch64 windows-x86_64} {
            lappend results $import $target [lindex [diRejection "import $import\n1\n" $target] 0]
        }
    }
    foreach import {std::linux std::linux::io std::linux::path} {
        lappend results $import macos-aarch64 [lindex [diRejection "import $import\n1\n" macos-aarch64] 0]
    }
    list [core::cabi::platformOf std::darwin::io] [core::cabi::platformOf std::linux::io] [core::cabi::platformOf macos] $results \
        [lindex [diRejection "import std::darwin::io\n1\n" linux-x86_64] 1]
} -result [list macos linux "" {std::darwin macos-aarch64 accepted std::darwin macos-x86_64 accepted std::darwin linux-x86_64 UNSUPPORTED-PLATFORM std::darwin linux-aarch64 UNSUPPORTED-PLATFORM std::darwin windows-x86_64 UNSUPPORTED-PLATFORM std::darwin::io macos-aarch64 accepted std::darwin::io macos-x86_64 accepted std::darwin::io linux-x86_64 UNSUPPORTED-PLATFORM std::darwin::io linux-aarch64 UNSUPPORTED-PLATFORM std::darwin::io windows-x86_64 UNSUPPORTED-PLATFORM std::darwin::path macos-aarch64 accepted std::darwin::path macos-x86_64 accepted std::darwin::path linux-x86_64 UNSUPPORTED-PLATFORM std::darwin::path linux-aarch64 UNSUPPORTED-PLATFORM std::darwin::path windows-x86_64 UNSUPPORTED-PLATFORM std::linux macos-aarch64 UNSUPPORTED-PLATFORM std::linux::io macos-aarch64 UNSUPPORTED-PLATFORM std::linux::path macos-aarch64 UNSUPPORTED-PLATFORM} {namespace "std::darwin::io" belongs to the macOS platform (the standard namespace std::darwin and every namespace under it), which is unavailable for target linux-x86_64 (Linux on x86_64): a macOS module is never chosen for, mapped to or substituted on another operating system, whatever the architecture; compile for a macOS target (-target macos-x86_64) or import no macOS namespace}]

test di-platform-no-way-around {a Darwin namespace reaches no other target by another route: a type import of it is refused like an import, the HIR of a Darwin program records its target and its interchange text is refused for any other (HIR INTERCHANGE TARGET), and a native backend refuses to run it on a host of another target (NATIVE TARGET) -- here, unless the host is macOS arm64} -body {
    set typeImport [lindex [diRejection "import type std::darwin::io::DarwinIO\n1\n" linux-x86_64] 0]
    set hir [diHir $::helloDarwin]
    set text [hir::interchange::encode $hir]
    set refused [lmap target {linux-x86_64 linux-aarch64 macos-x86_64} {
        catch {hir::interchange::decode $text -target $target} message options
        lindex [dict get $options -errorcode] end
    }]
    set own [hir::cabi::targetOf [hir::interchange::decode $text -target macos-aarch64]]
    set native [expr {$::hostTarget eq "macos-aarch64" || ![testConstraint nativeBuilt] ? "TARGET" :
        [lindex [lindex [outcomeUnderHir cranelift $hir] 1] end]}]
    list $typeImport [hir::cabi::targetOf $hir] $refused $own $native
} -result {UNSUPPORTED-PLATFORM macos-aarch64 {TARGET TARGET TARGET} macos-aarch64 TARGET}

# ---------------------------------------------------------------------------
# The libSystem declarations (stdlib/darwin.bot)

test di-c-declarations {stdlib/darwin.bot declares libSystem's write, read, open, close and __error by their C prototypes for macOS (LP64: int i32, size_t u64, ssize_t i64, a pointer 64 bits): write's buffer read noescape, read's write noescape, open's path read noescape and open itself variadic (its creation mode the one trailing argument), every link symbol the C name} -body {
    set nir [native::nir [diHir "direct module\nimport std::abi\nimport std::abi::bytes\nimport std::darwin\nimport std::darwin::path\nimport std::io::path\nfn f(p: str) -> List\[int\] errors std::io::path::NotAPath:\n    std::darwin::path::validate(p)\n    w = std::darwin::write(1, std::abi::bytes::from_list(\[\]))\n    r = std::darwin::read(0, std::abi::bytes::zeroed(std::abi::usize(1)))\n    o = std::darwin::create(p, std::darwin::Access::WriteOnly, 420)\n    c = std::darwin::close(o.fd)\n    \[w.count, r.count, o.fd, c.status\]\nf(\"x\"):\n    on std::io::path::NotAPath:\n        \[\]\n"]]
    set foreign [lsort [lmap line [split $nir \n] {
        if {![regexp {^foreign \d+ "(\S+)" params="([^"]*)" result=(\S+)( variadic=1)?} $line -> symbol params result variadic]} continue
        list $symbol $params $result [expr {$variadic ne ""}]
    }]]
    set contracts [lmap name {std::darwin::c_write std::darwin::c_read std::darwin::c_open std::darwin::c_close std::darwin::c_errno_location} {
        set c [dict get [core::native::metadata extern#$name] foreign]
        list $name [lmap p [dict get $c params] {
            expr {[dict exists $p access] ? [list [dict get $p name] [dict get $p access] [dict get $p escape]] : [dict get $p name]}
        }] [dict getdef $c variadic 0] [dict getdef $c provenance -]
    }]
    list $foreign $contracts [regexp -inline {varargs=\S+} $nir]
} -result {{{__error {} ptr 0} {close i32 i32 0} {open {ptr i32} i32 1} {read {i32 ptr u64} i64 0} {write {i32 ptr u64} i64 0}} {{std::darwin::c_write {fd {buf read declared-noescape} nbyte} 0 unknown} {std::darwin::c_read {fd {buf write declared-noescape} nbyte} 0 unknown} {std::darwin::c_open {{path read declared-noescape} oflag} 1 unknown} {std::darwin::c_close fd 0 unknown} {std::darwin::c_errno_location {} 0 independent}} varargs=u16:i32}

test di-errno-read-first {a failed call's errno is read before anything else runs: in std::darwin::write, read, open (both forms: open_with, and open_mode behind create and create_new) and close nothing comes between the C call and errno() but the keepalive of an exposure (no machine code) and the comparison -- of the C word write(2) and read(2) return (cwlt: their ssize_t compared as it is, never boxed, C-FFI-ERROR-CAPTURE-MILESTONE-2.md), of the unboxed int open(2) and close(2) return -- no allocation, no other call: read's write-back value is never built, its MutableBytes only after errno() (C-FFI-ERROR-CAPTURE-MILESTONE-1.md); and errno() is one C call of __error and one load through the native view} -body {
    set nir [native::nir [diHir "direct module\nimport std::abi\nimport std::abi::bytes\nimport std::darwin\nimport std::darwin::path\nimport std::io::path\nfn f(p: str) -> List\[int\] errors std::io::path::NotAPath:\n    std::darwin::path::validate(p)\n    w = std::darwin::write(1, std::abi::bytes::from_list(\[\]))\n    r = std::darwin::read(0, std::abi::bytes::zeroed(std::abi::usize(1)))\n    o = std::darwin::open(p, std::darwin::Access::ReadOnly)\n    m = std::darwin::create(p, std::darwin::Access::WriteOnly, 384)\n    c = std::darwin::close(o.fd)\n    \[w.count, w.errno, r.count, r.errno, o.fd, o.errno, m.fd, m.errno, c.status, c.errno\]\nf(\"x\"):\n    on std::io::path::NotAPath:\n        \[\]\n"]]
    set errno [nirId $nir std::darwin::errno]
    set between [lmap name {std::darwin::write std::darwin::read std::darwin::open_with std::darwin::open_mode std::darwin::close} {
        set body [nirBody $nir $name]
        set from [lsearch -glob $body "*foreigncall*"]
        set to [lsearch -glob $body "* = call $errno"]
        lmap line [lrange $body [expr {$from + 1}] [expr {$to - 1}]] {
            if {[regexp {= (op (\S+)|(structnew|call|callmulti|structget|foreigncall))} $line -> - op word]} {
                expr {$op ne "" ? $op : $word}
            } else {
                continue
            }
        }
    }]
    list $between [lmap line [nirBody $nir std::darwin::errno] {
        expr {[regexp {= (foreigncall|op nativeload)} $line -> what] ? $what : [continue]}
    }]
} -result {{{keepalive cwlt} {keepalive cwlt} {keepalive runbox rilt} {keepalive runbox rilt} {runbox rilt}} {foreigncall {op nativeload}}}

# ---------------------------------------------------------------------------
# std::io::IO through DarwinIO: static selection, no dispatch

test di-implements {std::darwin::io::DarwinIO implements std::io::IO through std::darwin::io::write_text and std::darwin::io::write_error_text, from its own module only (structural satisfaction: nothing registers it)} -body {
    diHir "import std::io\nimport std::darwin::io\n1\n"
    set s [hir::contexts::satisfiesTrait std::darwin::io::DarwinIO std::io::IO]
    list [dict get $s ok] [lmap {r impl} [dict get $s impls] {list $r [hir::traits::QualifiedName [dict get $impl unit] [dict get $impl name]]}]
} -result {1 {{write_text std::darwin::io::write_text} {write_error_text std::darwin::io::write_error_text}}}

test di-same-function-two-platforms {examples/io/hello.bot's hello and its macOS twin's are one function: the two programs differ only in the platform import and the installed context, and each compiles hello to a clone calling print_line's clone, which calls the installed context's own write_text directly (one operand, no context operand, no callvalue)} -body {
    set mac [native::nir [diHir $::helloDarwin]]
    set linux [native::nir [diHir $::helloLinux [core::cabi::systemTarget linux]]]
    set code [lmap text [list $::helloLinux $::helloDarwin] {
        join [lmap line [split $text \n] {expr {[string match #* $line] || [string match *std::linux::io* $line] || [string match *std::darwin::io* $line] ? [continue] : $line}}] \n
    }]
    list [expr {[lindex $code 0] eq [lindex $code 1]}] [lmap {nir context} [list $linux std::linux::io::LinuxIO $mac std::darwin::io::DarwinIO] {
        set write [nirId $nir [expr {$context eq "std::linux::io::LinuxIO" ? "std::linux::io::write_text" : "std::darwin::io::write_text"}]]
        set print [nirBody $nir "std::io::print_line<std::io::IO=$context>"]
        list [regexp -all -line "= call $write %\[0-9\]+\$" [join $print \n]] [regexp -all {callvalue} $nir] \
            [llength [lsearch -all -inline -glob [nirBody $nir "hello<std::io::IO=$context>"] "*call [nirId $nir "std::io::print_line<std::io::IO=$context>"] *"]]
    }]
} -result {1 {{1 0 1} {1 0 1}}}

test di-transitive-selection {hello declares no context: it requires std::io::IO through std::io::print_line, and the one top-level call selects DarwinIO} -body {
    set hir [diHir $::helloDarwin]
    set source [dict get $hir traitSource]
    dict values [dict get $source contexts selections]
} -result {{std::io::IO std::darwin::io::DarwinIO}}

# A second std::io::IO implementation, declared by the program itself.
set otherContext {
context struct Other:
    tag: Tag

fn write_text(text: str, context c: Other) -> unit errors std::io::WriteFailed:
    unit

fn write_error_text(text: str, context c: Other) -> unit errors std::io::WriteFailed:
    unit
}

test di-selection-diagnostics {context selection stays static and exact with DarwinIO: no installed context is MISSING-CONTEXT, DarwinIO beside another implementation of std::io::IO is AMBIGUOUS-CONTEXT-IMPLEMENTATION (never ranked), and a context whose operations do not match std::io::IO's requirements implements nothing (MISSING-CONTEXT again)} -body {
    set call "fn hi() errors std::io::WriteFailed:\n    std::io::print_line(\"hi\")\n\n"
    set handled "hi():\n    on std::io::WriteFailed:\n        unit\n"
    list [lindex [diRejection "import std::io\nimport std::darwin::io\n\n${call}$handled"] 0] \
        [lindex [diRejection "import std::io\nimport std::darwin::io\nimport std::str\ntype Tag = Int in 0..0\n$::otherContext\n${call}with context std::darwin::io::create()\nwith context Other {tag: 0}\n$handled"] 0] \
        [lindex [diRejection "import std::io\nimport std::str\ntype Tag = Int in 0..0\n[string map {{text: str} {text: int}} $::otherContext]\n${call}with context Other {tag: 0}\n$handled"] 0]
} -result {MISSING-CONTEXT AMBIGUOUS-CONTEXT-IMPLEMENTATION MISSING-CONTEXT}

test di-authority {the raw layer is direct, the context layer is not: stdlib/darwin.bot is a designated direct module, std::darwin::io is contextualized (each of its direct calls mediated by its own DarwinIO), std::io and a program using std::io and std::darwin::io ordinary; a program calling std::darwin::write itself must be marked direct (DIRECT), and is accepted marked; a module that only uses DarwinIO marked direct is STALE-DIRECT-MODULE} -body {
    set hir [diHir "import std::io\nimport std::darwin::io\nwith context std::darwin::io::create()\nstd::io::print(\"x\"):\n    on std::io::WriteFailed:\n        unit\n"]
    set statuses [dict create]
    dict for {unit u} [dict get $hir direct units] {
        if {$unit in {std::darwin std::darwin::io std::io}} {
            dict set statuses $unit [dict get $u status]
        }
    }
    set raw "import std::abi\nimport std::abi::bytes\nimport std::darwin\nstd::darwin::write(1, std::abi::bytes::from_list(\[\])).count\n"
    list [lsort -stride 2 [dict get $statuses]] [lindex [diRejection $raw] 0] [diRejection "direct module\n$raw"] \
        [lindex [diRejection "direct module\nimport std::io\nimport std::darwin::io\nwith context std::darwin::io::create()\nstd::io::print(\"x\"):\n    on std::io::WriteFailed:\n        unit\n"] 0]
} -result {{std::darwin direct std::darwin::io contextualized std::io ordinary} DIRECT accepted STALE-DIRECT-MODULE}

test di-tcl-backends {the Tcl backends verify a Darwin program and run it up to its first C call, which they refuse (NATIVE-ONLY): no Tcl channel imitates libSystem} -body {
    set hir [diHir $::helloDarwin]
    lmap backend {interp compile} {lrange [outcomeUnderHir $backend $hir] 0 1}
} -result {{error {CORE SEMANTIC NATIVE-ONLY}} {error {CORE SEMANTIC NATIVE-ONLY}}}

test di-warning-clean {programs importing darwin, std::darwin::io and std::darwin::path collect no warning from the library and compile under -warnings error} -body {
    lmap text [list "import std::darwin\n1\n" "import std::darwin::io\n1\n" "import std::darwin::path\n1\n" $::helloDarwin] {
        set dir [file join $::scratch warn[incr ::programCounter]]
        file mkdir $dir
        writeText [file join $dir main.bot] $text
        set hir [surface::readProgramFile [file join $dir main.bot] -warnings default -warning-channel "" -cache "" -target macos-aarch64]
        list [llength [hir::warnings::of $hir]] \
            [catch {surface::readProgramFile [file join $dir main.bot] -warnings error -warning-channel "" -cache "" -target macos-aarch64}]
    }
} -result {{0 0} {0 0} {0 0} {0 0}}

# ---------------------------------------------------------------------------
# std::darwin::path (pure: every backend runs it)

test di-path-validity {DarwinPath: a non-empty String without U+0000 -- relative, absolute, ".", "..", repeated and trailing slashes, spaces, non-ASCII -- and nothing else; concat joins with one "/" unless the path ends in one and refuses an empty, absolute or NUL-containing component; a NUL is refused before any C call, statically (a String literal holding one is no DarwinPath: TYPE)} -body {
    set cases [list "" "a" "/" "/a/b" "." ".." "a//b" "a/" "with space" "é/𝄞" "a\x00b" "\x00"]
    set list [join [lmap c $cases {string cat "\"" $c "\""}] ", "]
    set hir [diHir "import std::darwin::path\nimport std::io::path\nfn j(p: str, c: str) -> str:\n    if not std::darwin::path::valid?(p):\n        return \"!\"\n    joined = std::darwin::path::concat(p, c):\n        on std::io::path::NotAPath:\n            return \"!\"\n    std::darwin::path::text(joined)\nxs = \[$list\]\nvalid = loop x in xs:\n    std::darwin::path::valid?(x)\n\[valid, j(\"/a\", \"b\"), j(\"/a/\", \"b\"), j(\"/\", \"b\"), j(\"a\", \"/b\"), j(\"a\", \"\"), j(\"a\", \"b\x00\"), j(\"dïr with space\", \"fïlé 🙂.txt\")\]\n"]
    set static [lindex [diRejection "direct module\nimport std::darwin\nimport std::darwin::path\nstd::darwin::open(\"a\x00b\", std::darwin::Access::ReadOnly).fd\n"] 0]
    list [lmap backend {interp compile} {lindex [outcomeUnderHir $backend $hir] 1}] $static
} -result [list [lrepeat 2 {[[false, true, true, true, true, true, true, true, true, true, false, false], "/a/b", "/a/b", "/b", "!", "!", "!", "dïr with space/fïlé 🙂.txt"]}] TYPE]

test di-c-string {open(2)'s path is the DarwinPath's UTF-8 bytes and one terminating NUL, built in Botlish before the call (pure: every backend computes it) and exposed for that call alone: a Unicode name with spaces, the bytes beyond ASCII as UTF-8, exactly one 0 at the end} -body {
    set hir [diHir "direct module\nimport std::abi\nimport std::abi::bytes\nimport std::byte\nimport std::darwin\nimport std::darwin::path\nimport std::io::path\nimport std::list\nimport std::str\n\nfn c(p: str) -> List\[bool\] errors std::io::path::NotAPath:\n    std::darwin::path::validate(p)\n    s = std::darwin::c_string(p)\n    \[std::abi::bytes::length(s).value == std::str::length(p) + 0, s == std::abi::bytes::from_list(std::str::encode_utf8(p).append(std::byte::from_int(0))), std::abi::bytes::length(s).value == std::list::length(std::str::encode_utf8(p)) + 1\]\n\nc(\"dïr with space/f🙂\"):\n    on std::io::path::NotAPath:\n        \[\]\n"]
    lmap backend {interp compile} {lindex [outcomeUnderHir $backend $hir] 1}
} -result [lrepeat 2 {[false, true, true]}]

# ---------------------------------------------------------------------------
# On the host: the SDK's own facts

# A C program printing what the host's SDK headers say, built and run with
# the host's C compiler.
proc diHeaderFacts {} {
    set dir [file join $::scratch headers]
    file mkdir $dir
    writeText [file join $dir facts.c] {#include <errno.h>
#include <fcntl.h>
#include <stdio.h>
#include <sys/types.h>
#include <unistd.h>
#define KIND(T) _Generic((T)0, unsigned short: "u16", unsigned int: "u32", int: "i32", long: "i64", unsigned long: "u64", default: "other")
int main(void) {
    printf("O_RDONLY %d O_WRONLY %d O_RDWR %d O_CREAT %d O_TRUNC %d O_EXCL %d O_CLOEXEC %d\n",
           O_RDONLY, O_WRONLY, O_RDWR, O_CREAT, O_TRUNC, O_EXCL, O_CLOEXEC);
    printf("EBADF %d ENOENT %d EEXIST %d EISDIR %d ENOTDIR %d EINTR %d EAGAIN %d\n",
           EBADF, ENOENT, EEXIST, EISDIR, ENOTDIR, EINTR, EAGAIN);
    printf("F_GETFD %d F_SETFD %d FD_CLOEXEC %d\n", F_GETFD, F_SETFD, FD_CLOEXEC);
    printf("int %s size_t %s ssize_t %s mode_t %s\n", KIND(int), KIND(size_t), KIND(ssize_t), KIND(mode_t));
    return 0;
}
int symbols(void) {
    char b[1];
    return (int)write(1, b, 0) + (int)read(0, b, 0) + open("x", O_RDONLY) + open("x", O_CREAT, 0644) + close(-1) + errno;
}
}
    exec cc -O0 [file join $dir facts.c] -o [file join $dir facts]
    exec cc -O0 -S [file join $dir facts.c] -o [file join $dir facts.s]
    set calls [lsort -unique [regexp -all -inline {bl\s+_(?:write|read|open|close|__error)\M} [readBinary [file join $dir facts.s]]]]
    return [list [split [string trim [exec [file join $dir facts]]] \n] [lmap c $calls {lindex $c 1}]]
}

test di-sdk-facts {the constants and types stdlib/darwin.bot states are the host SDK's: the open flags (fcntl.h), the errno values the tests expect, mode_t unsigned 16 bits (so the creation mode is a std::ffi::c::UShort, promoted to int as a trailing argument), size_t unsigned long and ssize_t long (ULong and Long), and the C compiler's own calls use exactly the link symbols the declarations name (_write, _read, _open, _close, ___error)} -constraints {darwinIO cCompiler} -body {
    lassign [diHeaderFacts] lines calls
    set module [lindex [outcomeUnderHir interp [diHir "import std::darwin\n\[std::darwin::o_rdonly, std::darwin::o_wronly, std::darwin::o_rdwr, std::darwin::o_creat, std::darwin::o_trunc, std::darwin::o_excl, std::darwin::o_cloexec\]\n"]] 1]
    list $lines $calls $module
} -result {{{O_RDONLY 0 O_WRONLY 1 O_RDWR 2 O_CREAT 512 O_TRUNC 1024 O_EXCL 2048 O_CLOEXEC 16777216} {EBADF 9 ENOENT 2 EEXIST 17 EISDIR 21 ENOTDIR 20 EINTR 4 EAGAIN 35} {F_GETFD 1 F_SETFD 2 FD_CLOEXEC 1} {int i32 size_t u64 ssize_t i64 mode_t u16}} {___error _close _open _read _write} {[0, 1, 2, 512, 1024, 2048, 16777216]}}

