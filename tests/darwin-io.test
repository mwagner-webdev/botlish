set coroutineText {import std::coroutine
import std::io
import std::darwin::io
import std::list
import std::str

struct Event:
    value: int

fn say(word: str, depth: int) -> unit errors std::io::WriteFailed:
    if depth == 0:
        std::io::print_line(word)
        return unit
    say(word, depth - 1)

fn worker(name: str) -> Event errors std::io::WriteFailed:
    held = [name, name]
    say(name.concat(" starts"), 20)
    yield Event {value: 1}
    say(std::list::get(held, 1, "").concat(" resumes"), 5)
    yield Event {value: 2}
    std::io::write_error_line(name.concat(" ends"))
    return Event {value: 3}

fn run() -> List[int] errors std::io::WriteFailed:
    coroutine {step: a, first: a1} = worker("ant")
    coroutine {step: b, first: b1} = worker("bee")
    b2 = b()
    a2 = a()
    a3 = a()
    b3 = b()
    [a1.value, a2.value, a3.value, b1.value, b2.value, b3.value]

with context std::darwin::io::create()

run():
    on std::io::WriteFailed:
        []
}

test di-coroutines-gc-stress {output from coroutine bodies -- before the first yield, after resumes, with two coroutines suspended at once holding managed values -- through the portable API and DarwinIO, in a standalone executable, and the same under GC stress} -constraints {darwinIO posixShell nativeCoroutines} -body {
    set exe [diExecutable $::coroutineText]
    set plain [diRun $exe]
    set stressed [diRun [list env BOTLISH_NATIVE_GC_STRESS=1 $exe]]
    list $plain [expr {$plain eq $stressed}]
} -result [list [list "ant starts\nbee starts\nbee resumes\nant resumes\n\[1, 2, 3, 1, 2, 3\]\n" "ant ends\nbee ends\n" 0] 1]

test di-native-backends {the native backends run a Darwin program as an executable linked for the run (C-FFI.md: no dlopen, no in-process symbol resolution): its value on cranelift and cranelift-generic, and main.tcl -backend cranelift passes the program's own output through to its standard output} -constraints {darwinIO} -body {
