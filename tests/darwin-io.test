# ---------------------------------------------------------------------------
# errno

set errnoText {direct module
import std::abi
import std::abi::bytes
import std::coroutine
import std::darwin
import std::darwin::path
import std::io::path
import std::list
import std::str

struct Event:
    value: int

fn bytes_of(s: str) -> std::abi::bytes::Bytes:
    std::abi::bytes::from_list(std::str::encode_utf8(s))

fn every(xs: List[bool]) -> bool:
    loop x in xs:
        if not x:
            return false
    true

# Failures with distinct errnos, each followed by a success: the errno a
# result reports is its own call's, never a stale one.
fn round(dir: str) -> List[int] errors std::io::path::NotAPath:
    std::darwin::path::validate(dir)
    missing = std::darwin::open(std::darwin::path::concat(dir, "missing.txt"), std::darwin::Access::ReadOnly)
    bad = std::darwin::write(-1, bytes_of("x"))
    file = std::darwin::create(std::darwin::path::concat(dir, "present.txt"), std::darwin::Access::WriteOnly, 420)
    ok = std::darwin::write(file.fd, bytes_of("present\n"))
    exists = std::darwin::create_new(std::darwin::path::concat(dir, "present.txt"), std::darwin::Access::WriteOnly, 420)
    isdir = std::darwin::open(dir, std::darwin::Access::WriteOnly)
    closed = std::darwin::close(file.fd)
    again = std::darwin::close(file.fd)
    readbad = std::darwin::read(9999, std::abi::bytes::zeroed(std::abi::usize(4)))
    [missing.fd, missing.errno, bad.count, bad.errno, ok.count, ok.errno, exists.fd, exists.errno,
     isdir.fd, isdir.errno, closed.status, closed.errno, again.status, again.errno, readbad.count, readbad.errno]

fn worker(dir: str) -> Event errors std::io::path::NotAPath:
    first = round(dir)
    yield Event {value: std::list::get(first, 1, 0)}
    second = round(dir)
    return Event {value: std::list::get(second, 7, 0)}

fn all(dir: str) -> List[any] errors std::io::path::NotAPath:
    coroutine {step, first} = worker(dir)
    one = round(dir)
    rounds = loop i from 0 to 20:
        round(dir)
    same = loop r in rounds:
        r == one
    [one, std::list::length(rounds), every(same), first.value, step().value]
}

test di-errno {a failed libSystem call reports the errno it left, read right after it on the same thread: ENOENT (2) for a missing file, EBADF (9) for a bad descriptor (write, close of a closed one, read), EEXIST (17) for create_new of an existing file, EISDIR (21) for a directory opened for writing -- distinct errnos in succession, each followed by successes reporting 0, never a stale value; the same twenty times, inside a coroutine before and after a suspension, under GC stress, in the executable and on both native backends} -constraints {darwinIO posixShell nativeCoroutines} -body {
    set dir [makeDirectory darwin-io-errno-[pid]]
    set text $::errnoText
    append text "\nall(\"$dir\"):\n    on std::io::path::NotAPath:\n        \[\]\n"
    set exe [diExecutable $text]
    set plain [lindex [diRun $exe] 0]
    set stressed [lindex [diRun [list env BOTLISH_NATIVE_GC_STRESS=1 $exe]] 0]
    set hir [diHir $text $::hostTarget]
    set backends [lmap backend {cranelift cranelift-generic} {lindex [outcomeUnderHir $backend $hir] 1}]
    list $plain [expr {$stressed eq $plain}] [expr {"[lindex $backends 0]\n" eq $plain && [lindex $backends 0] eq [lindex $backends 1]}]
} -cleanup {file delete -force [file join [temporaryDirectory] darwin-io-errno-[pid]]} -result [list "\[\[-1, 2, -1, 9, 8, 0, -1, 17, -1, 21, 0, 0, -1, 9, -1, 9\], 20, true, 2, 17\]\n" 1 1]

# The allocator that changes errno on every allocation (tests/cffi/
# errno-clobber.c, C-FFI-ERROR-CAPTURE-MILESTONE-1.md), built once.
proc clobberLibrary {} {
    if {![info exists ::clobberLibrary]} {
        set path [file join $::scratch libbcf_errno_clobber.dylib]
        exec cc -dynamiclib -O2 [file join $::projectRoot tests cffi errno-clobber.c] -o $path
        set ::clobberLibrary $path
    }
    return $::clobberLibrary
}

test di-errno-allocator {nothing allocates between a libSystem call and its errno read: di-errno's program prints the same with an allocator that sets errno to 77 on every allocation (DYLD_INSERT_LIBRARIES), also under GC stress, and so does it with struct scalar replacement off (-struct-opt 0: the write-back value's transport is no optimization, C-FFI-ERROR-CAPTURE-MILESTONE-2.md) -- while the lowering before C-FFI-ERROR-CAPTURE-MILESTONE-1.md (the eager-foreign-result fault injection with -struct-opt 0: read's write-back value built right after the call) reports that 77 as read's errno, and only read's: write, open and close never allocated there} -constraints {writeInject posixShell nativeCoroutines} -body {
    set dir [makeDirectory darwin-io-allocator-[pid]]
    set text $::errnoText
    append text "\nall(\"$dir\"):\n    on std::io::path::NotAPath:\n        \[\]\n"
    set exe [diExecutable $text]
    set unoptimized [diExecutable $text {} {-struct-opt 0}]
    set eager [diExecutable $text {} {-struct-opt 0 -fault eager-foreign-result}]
    set plain [lindex [diRun $exe] 0]
    set clobber [list DYLD_INSERT_LIBRARIES=[clobberLibrary] BCF_ERRNO_CLOBBER=77]
    list [expr {[lindex [diRun [list env {*}$clobber $exe]] 0] eq $plain}] \
        [expr {[lindex [diRun [list env {*}$clobber BOTLISH_NATIVE_GC_STRESS=1 $exe]] 0] eq $plain}] \
        [expr {[lindex [diRun [list env {*}$clobber $unoptimized]] 0] eq $plain}] \
        [expr {[lindex [diRun $eager] 0] eq $plain}] [lindex [diRun [list env {*}$clobber $eager]] 0]
} -cleanup {file delete -force [file join [temporaryDirectory] darwin-io-allocator-[pid]]} -result [list 1 1 1 1 "\[\[-1, 2, -1, 9, 8, 0, -1, 17, -1, 21, 0, 0, -1, 9, -1, 77\], 20, true, 2, 17\]\n"]

# ---------------------------------------------------------------------------
# Standard input (std::darwin::io::read)

set stdinText {import std::abi
import std::abi::bytes
import std::darwin
import std::darwin::io
import std::str

fn as(s: str) -> std::abi::bytes::MutableBytes:
    std::abi::bytes::from_bytes(std::abi::bytes::from_list(std::str::encode_utf8(s)))

with context std::darwin::io::create()

original = as("AAAAAAAAAAAAAAAA")
none = std::darwin::io::read(std::abi::bytes::zeroed(std::abi::usize(0)))
r = std::darwin::io::read(original)
shown = std::darwin::io::write(std::abi::bytes::freeze(r.data))
kept = std::darwin::io::write_error(std::abi::bytes::freeze(original))
[none.count, none.errno, r.count, r.errno, shown.count, kept.count]
}

test di-stdin {std::darwin::io::read from the process's standard input into a 16-byte buffer of A's: the empty request reads nothing (0, the input left), a short read (5 bytes) fills only its prefix, an exact read all 16, end of file is 0 (not an error), non-UTF-8 and zero bytes arrive as they are, and a descriptor that cannot be read (standard input opened write-only) is -1 with EBADF, the empty request too (the kernel checks the descriptor first); the caller's own buffer is unchanged every time (what goes to descriptor 2)} -constraints {darwinIO posixShell} -body {
    set exe [diExecutable $::stdinText]
    set a [string repeat A 16]
    set result {}
    foreach input [list [diInput hello] [diInput 0123456789abcdef] /dev/null [diInput "\x00\xff\x80\xc3\x28"]] {
        lassign [diRun $exe $input] out err status
        lappend result [list $out [expr {$err eq $a}]]
    }
    set writeOnly [diInput ""]
    lassign [diRun [list sh -c "\"\$0\" 0>\"\$1\"" $exe $writeOnly]] out err status
    lappend result [list $out [expr {$err eq $a}]]
} -result [list [list "helloAAAAAAAAAAA\[0, 0, 5, 0, 16, 16\]\n" 1] [list "0123456789abcdef\[0, 0, 16, 0, 16, 16\]\n" 1] \
    [list "AAAAAAAAAAAAAAAA\[0, 0, 0, 0, 16, 16\]\n" 1] [list "\x00\xff\x80\xc3\x28AAAAAAAAAAA\[0, 0, 5, 0, 16, 16\]\n" 1] \
    [list "AAAAAAAAAAAAAAAA\[-1, 9, -1, 9, 16, 16\]\n" 1]]

# ---------------------------------------------------------------------------
# Files: open (variadic), create, read, close

# The program over the private directory DIR: a file of a Unicode name in a
# directory whose name has spaces, created with mode 0640 (the variadic
# argument), written, read back (a short read, then end of file), closed,
# and the relative path RELATIVE, opened from the run's working directory.
proc fileText {dir relative} {
    return [string map [list @DIR@ $dir @REL@ $relative] {direct module
import std::abi
import std::abi::bytes
import std::darwin
import std::darwin::path
import std::ffi::c
import std::io::path
import std::str

extern c fn fcntl(fd: std::ffi::c::Int, cmd: std::ffi::c::Int, variadic) -> std::ffi::c::Int

fn bytes_of(s: str) -> std::abi::bytes::Bytes:
    std::abi::bytes::from_list(std::str::encode_utf8(s))

# X as a C int: a variadic argument is passed as exactly one C type.
fn c_int(x: std::ffi::c::Int) -> std::ffi::c::Int:
    x

# The bytes R read: the first R.count bytes of its buffer.
fn read_bytes(r: std::darwin::ReadResult) -> std::abi::bytes::Bytes:
    count = std::abi::usize(r.count):
        on std::abi::AbiIntegerBelowRange:
            return std::abi::bytes::from_list([])
        on std::abi::AbiIntegerAboveRange:
            return std::abi::bytes::from_list([])
    prefix = std::abi::bytes::freeze_prefix(r.data, count):
        on UpperOverrun:
            return std::abi::bytes::from_list([])
    prefix

fn run(base: str, relative: str) -> List[any] errors std::io::path::NotAPath:
    std::darwin::path::validate(base)
    std::darwin::path::validate(relative)
    path = std::darwin::path::concat(base, "fïlé 🙂.txt")
    made = std::darwin::create(path, std::darwin::Access::WriteOnly, 416)
    written = std::darwin::write(made.fd, bytes_of("first line\n"))
    cloexec = fcntl(made.fd, 1)
    cleared = fcntl(made.fd, 2, c_int(0))
    after = fcntl(made.fd, 1)
    shut = std::darwin::close(made.fd)
    opened = std::darwin::open(path, std::darwin::Access::ReadOnly)
    first = std::darwin::read(opened.fd, std::abi::bytes::zeroed(std::abi::usize(64)))
    end = std::darwin::read(opened.fd, std::abi::bytes::zeroed(std::abi::usize(64)))
    shown = std::darwin::write(1, read_bytes(first))
    closed = std::darwin::close(opened.fd)
    rel = std::darwin::open(relative, std::darwin::Access::ReadOnly)
    relread = std::darwin::read(rel.fd, std::abi::bytes::zeroed(std::abi::usize(8)))
    relclosed = std::darwin::close(rel.fd)
    [made.fd >= 3, made.errno, written.count, cloexec, cleared, after, shut.status, opened.fd >= 3, first.count, end.count, end.errno,
     shown.count, closed.status, rel.fd >= 3, relread.count, relclosed.status]

run("@DIR@", "@REL@"):
    on std::io::path::NotAPath:
        []
}]
}

test di-files {open(2)'s genuine variadic prototype through std::darwin::create and std::darwin::open: a file of a Unicode name created in a directory whose name has spaces, its creation mode 0640 the one trailing argument (a std::ffi::c::UShort promoted to int) -- the file's permissions are 0640 --, close-on-exec set (fcntl's fixed-argument F_GETFD) and cleared (fcntl's variadic F_SETFD), the content written and read back exactly (a short read of a 64-byte buffer, then end of file), both descriptors closed, and a relative path resolved from the run's working directory; an absolute path elsewhere} -constraints {darwinIO posixShell} -body {
    set dir [makeDirectory darwin-io-files-[pid]]
    set base [file join $dir "dïr with spaces"]
    file mkdir $base
    writeText [file join $dir "relative.txt"] "rel"
    set exe [diExecutable [fileText $base relative.txt]]
    set here [pwd]
    cd $dir
    try {
        # Under a known umask (022, which leaves 0640 as it is): the mode
        # checked is the one open(2) received, not the runner's umask.
        lassign [diRun [list sh -c {umask 022; exec "$0"} $exe]] out err status
    } finally {
        cd $here
    }
    set made [file join $base "fïlé 🙂.txt"]
    list [encoding convertfrom utf-8 $out] $err $status [file attributes $made -permissions] [readBinary $made]
} -cleanup {file delete -force [file join [temporaryDirectory] darwin-io-files-[pid]]} -result [list "first line\n\[true, 0, 11, 1, 0, 0, 0, true, 11, 0, 0, 11, 0, true, 3, 0\]\n" {} 0 0o640 "first line\n"]

test di-file-errors {the file operations' failures, each its own errno: a missing file (ENOENT), a path through a file (ENOTDIR), a directory opened for writing (EISDIR), an existing file created exclusively (EEXIST), a closed descriptor closed again and an invalid one (EBADF)} -constraints {darwinIO posixShell} -body {
    set dir [makeDirectory darwin-io-file-errors-[pid]]
    writeText [file join $dir present.txt] "x"
    set text "direct module\nimport std::darwin\nimport std::darwin::path\nimport std::io::path\n\nfn run(d: str) -> List\[int\] errors std::io::path::NotAPath:\n    std::darwin::path::validate(d)\n    a = std::darwin::open(std::darwin::path::concat(d, \"absent.txt\"), std::darwin::Access::ReadOnly)\n    b = std::darwin::open(std::darwin::path::concat(d, \"present.txt/x\"), std::darwin::Access::ReadOnly)\n    c = std::darwin::open(d, std::darwin::Access::ReadWrite)\n    e = std::darwin::create_new(std::darwin::path::concat(d, \"present.txt\"), std::darwin::Access::WriteOnly, 384)\n    f = std::darwin::open(std::darwin::path::concat(d, \"present.txt\"), std::darwin::Access::ReadOnly)\n    g = std::darwin::close(f.fd)\n    h = std::darwin::close(f.fd)\n    i = std::darwin::close(-1)\n    \[a.fd, a.errno, b.fd, b.errno, c.fd, c.errno, e.fd, e.errno, g.status, g.errno, h.status, h.errno, i.status, i.errno\]\n\nrun(\"$dir\"):\n    on std::io::path::NotAPath:\n        \[\]\n"
    lindex [diRun [diExecutable $text]] 0
} -cleanup {file delete -force [file join [temporaryDirectory] darwin-io-file-errors-[pid]]} -result "\[-1, 2, -1, 20, -1, 21, -1, 17, 0, 0, -1, 9, -1, 9\]\n"

removeDirectory darwin-io-[pid]
cleanupTests
