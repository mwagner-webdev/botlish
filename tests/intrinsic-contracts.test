# intrinsic-contracts.test -- intrinsic function contract inference
# (INTRINSIC-FUNCTION-CONTRACT-INFERENCE.md, hir/signatures.tcl).
#
# An untyped parameter is no longer permanently `any`: its own function
# body's uses -- native arguments, declared-typed callee arguments, `if`
# conditions, loop iterables, calls of the parameter itself -- infer the
# narrowest sound contract, combined by meet, propagated backward through
# immutable aliases and forward through ordinary calls to a deterministic
# fixed point. Never from callers; never a code target.
#
# Sections: positive inference, fixed point / recursion / order, explicit
# annotations, conflicts, the native-wrapper semantic strengthening (and
# the checked/trusted boundary), callable parameters (args/return/errors,
# variance, the relational stop rule), reachability and path-dependence,
# result-type preservation, exact Block/structural integration,
# specialization keys, module signatures, and the canonical acceptance
# cases (scan_while, local_char?, label_char?, list helpers).

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]

set ::icDecls "type Byte = Int in 0..255\nerror NotFound\nerror PermissionDenied\n"

proc icCompile {src {strict 1} {decls default}} {
    if {$decls eq "default"} { set decls $::icDecls }
    set path [makeFile "$decls$src" ic-program.bot]
    try {
        return [surface::readProgramFile $path -strict $strict]
    } finally {
        removeFile ic-program.bot
    }
}

# {ERRORCODE MATCHED} for a program rejected at compile time, else "accepted".
proc icRejects {src pattern} {
    if {![catch {icCompile $src} message options]} {
        return "accepted"
    }
    set code [lrange [dict get $options -errorcode] 0 2]
    list $code [string match $pattern $message]
}

# The block expression bound to NAME.
proc icBlock {hir name} {
    dict for {b binding} [dict get $hir bindings] {
        if {[dict get $binding name] ne $name || [dict get $binding declaredBy] eq ""} continue
        set value [hir::get $hir [dict get $binding declaredBy] value]
        if {[hir::kind $hir $value] eq "block"} {
            return $value
        }
    }
    error "no function named $name"
}

# "PARAM: TYPE (SOURCE KIND)" for each parameter of function NAME, where
# KIND is trusted/checked for an inferred contract.
proc icSig {hir name} {
    set sig [hir::signatures::of $hir [icBlock $hir $name]]
    lmap p [dict get $sig params] {
        set kind ""
        if {[dict get $p source] eq "inferred"} {
            set kind [expr {[dict get $p trusted] ne {} ? " trusted" : " checked"}]
        }
        format {%s: %s (%s%s)} [dict get $p name] [hir::types::show [hir::signatures::paramType $p]] \
            [dict get $p source] $kind
    }
}

# The provenance of parameter PARAM of function NAME as "what -> type" lines.
proc icWhy {hir name param} {
    set sig [hir::signatures::of $hir [icBlock $hir $name]]
    foreach p [dict get $sig params] {
        if {[dict get $p name] eq $param} {
            return [lmap rec [dict get $p why] {
                format {%s %s -> %s} [dict get $rec kind] [dict get $rec what] [hir::types::show [dict get $rec type]]
            }]
        }
    }
    return "?"
}

# The note explaining why parameter PARAM of NAME has no callable contract.
proc icNote {hir name param} {
    set e [icBlock $hir $name]
    foreach b [hir::get $hir $e params] note [hir::get $hir $e paramNotes] {
        if {[dict get $hir bindings $b name] eq $param} {
            return [lindex $note 0]
        }
    }
    return "?"
}

# The program's value when every backend agrees (interp, compile,
# cranelift-generic and cranelift through the lowered core IR -- whose HIR
# re-infers every contract from the same bodies -- plus compile and
# cranelift straight from the surface HIR), else every outcome.
proc icRun {src} {
    set hir [icCompile $src]
    set exprs [hir::lower $hir]
    set outcomes [lmap backend {interp compile cranelift-generic cranelift} {outcomeUnder $backend $exprs}]
    lappend outcomes [list value [core::value::show [core::compiler::evalHir $hir] 1] {}]
    lappend outcomes [list value [core::value::show [native::evalHir $hir] 1] {}]
    if {[llength [lsort -unique $outcomes]] == 1} {
        return [lindex $outcomes 0 1]
    }
    return "DIFFER: $outcomes"
}

# ---------------------------------------------------------------------------
# Positive inference (spec item 66)

test ic-native-requirement {an untyped wrapper of a str-requiring native (length) infers x : str, a checked requirement, from the native's own registry metadata} -body {
    set h [icCompile {fn takes_str(x):
    length(x)
takes_str("abc")}]
    list [icSig $h takes_str] [icWhy $h takes_str x]
} -result {{{x: str (inferred checked)}} {{checked argument 1 of native length -> str}}}

test ic-forwarding {forwarding to an inferred wrapper infers the same contract} -body {
    set h [icCompile {fn takes_str(x):
    length(x)
fn forwards(x):
    takes_str(x)
forwards("abc")}]
    list [icSig $h forwards] [icWhy $h forwards x]
} -result {{{x: str (inferred checked)}} {{checked argument 1 of takes_str (inferred) -> str}}}

test ic-callable-parameter {calling an untyped parameter with a str and consuming the result as an if condition infers Fn{args: [str], return: bool, errors: []}, a trusted contract} -body {
    set h [icCompile {fn pred_use(p):
    if p("x"):
        1
    else:
        0
pred_use(is_tcl_alpha)}]
    icSig $h pred_use
} -result {{p: Fn{args: [str], return: bool, errors: []} (inferred trusted)}}

test ic-alias {a requirement on an immutable alias constrains the parameter it aliases} -body {
    set h [icCompile {fn takes_str(x):
    length(x)
fn alias(x):
    y = x
    takes_str(y)
alias("abc")}]
    icSig $h alias
} -result {{x: str (inferred checked)}}

test ic-alias-chain {x -> y -> z -> constrained use} -body {
    set h [icCompile {fn chain(x):
    y = x
    z = y
    z + 1
chain(1)}]
    icSig $h chain
} -result {{x: int (inferred checked)}}

test ic-operators {ordinary operators participate through their own native metadata: arithmetic and comparison (int), string concatenation (str), a loop iterable (list), counted-loop bounds (int), an if condition (bool)} -body {
    set h [icCompile {fn ops(a, b, s, xs, flag, lo):
    t = concat(s, "!")
    u = a * 2
    v = b < 3
    loop x in xs:
        x
    loop i from lo to 3:
        continue
    if flag:
        1
    else:
        0
ops(1, 2, "s", [1], true, 0)}]
    icSig $h ops
} -result {{a: int (inferred checked)} {b: int (inferred checked)} {s: str (inferred checked)} {xs: list (inferred checked)} {flag: bool (inferred checked)} {lo: int (inferred checked)}}

test ic-unconstrained-stays-any {a parameter with no concrete requirement stays any: equality and set membership accept every value} -body {
    set h [icCompile {fn eq_x?(c):
    c == "x"
fn member?(set, c):
    immutable_set_contains(set, c)
eq_x?(1)}]
    list [icSig $h eq_x?] [icSig $h member?]
} -result {{{c: any (none)}} {{set: immutableSet (inferred checked)} {c: any (none)}}}

test ic-meet {several requirements combine by meet: a declared Byte requirement and an Int arithmetic requirement meet in Byte} -body {
    set h [icCompile {fn take_byte(b: Byte) -> int:
    b
fn both(x):
    y = x + 1
    take_byte(x)
both(7)}]
    list [icSig $h both] [icWhy $h both x]
} -result {{{x: int[Byte] (inferred trusted)}} {{checked argument 1 of native + -> int} {trusted argument 1 of take_byte (declared int[Byte]) -> int[Byte]}}}

# ---------------------------------------------------------------------------
# Fixed point, recursion, definition order (spec items 30-33, 67)

set ::icChainForward {fn f(x):
    g(x)
fn g(y):
    h(y)
fn h(z):
    length(z)
f("abc")}
set ::icChainBackward {fn h(z):
    length(z)
fn g(y):
    h(y)
fn f(x):
    g(x)
f("abc")}

test ic-multi-hop {requirements propagate through several ordinary calls without annotations: h(z), g(y), f(x) all str} -body {
    set h [icCompile $::icChainForward]
    list [icSig $h f] [icSig $h g] [icSig $h h]
} -result {{{x: str (inferred checked)}} {{y: str (inferred checked)}} {{z: str (inferred checked)}}}

test ic-order-independent {the inferred signatures do not depend on definition order} -body {
    set a [icCompile $::icChainForward]
    set b [icCompile $::icChainBackward]
    expr {[list [icSig $a f] [icSig $a g] [icSig $a h]] eq [list [icSig $b f] [icSig $b g] [icSig $b h]]}
} -result 1

test ic-deterministic {compiling the same program twice gives identical signatures and provenance} -body {
    set a [icCompile $::icChainForward]
    set b [icCompile $::icChainForward]
    expr {[hir::signatures::of $a [icBlock $a f]] eq [hir::signatures::of $b [icBlock $b f]]}
} -result 1

test ic-mutual-recursion {mutually recursive functions converge: a requirement entering the SCC propagates through it} -body {
    set h [icCompile {fn even?(n):
    if n == 0:
        true
    else:
        odd?(n - 1)
fn odd?(n):
    if n == 0:
        false
    else:
        even?(n - 1)
even?(10)}]
    list [icSig $h even?] [icSig $h odd?]
} -result {{{n: int (inferred checked)}} {{n: int (inferred checked)}}}

test ic-recursive-scc-unconstrained {a recursive SCC with no concrete requirement keeps any} -body {
    set h [icCompile {fn ping(x, k):
    if k == 0:
        x
    else:
        pong(x, k - 1)
fn pong(x, k):
    ping(x, k)
ping("anything", 3)}]
    list [icSig $h ping] [icSig $h pong]
} -result {{{x: any (none)} {k: int (inferred checked)}} {{x: any (none)} {k: int (inferred checked)}}}

test ic-mutual-recursion-callable {a callable contract propagates through mutual recursion (trusted Fn in both)} -body {
    set h [icCompile {fn walk(p, n):
    if n == 0:
        0
    else:
        if p("x"):
            back(p, n - 1)
        else:
            0
fn back(q, n):
    walk(q, n)
walk(is_tcl_alpha, 3)}]
    list [icSig $h walk] [icSig $h back]
} -result {{{p: Fn{args: [str], return: bool, errors: []} (inferred trusted)} {n: int (inferred checked)}} {{q: Fn{args: [str], return: bool, errors: []} (inferred trusted)} {n: int (inferred checked)}}}

# ---------------------------------------------------------------------------
# Explicit annotations remain contracts (spec items 4, 68)

test ic-explicit-broad-not-narrowed {a declared broad parameter whose body needs a narrower type is invalid -- never silently narrowed} -body {
    icRejects {fn take_byte(b: Byte) -> int:
    b
fn broad(x: int):
    take_byte(x)
broad(7)} {*argument for parameter "b" cannot be proven to satisfy int\[Byte\] (argument type: int*}
} -result {{CORE SEMANTIC TYPE} 1}

test ic-explicit-declared-kept {a declared parameter keeps its declared type in the signature (source declared), even where the body would prove more} -body {
    set h [icCompile {fn take_byte(b: Byte) -> int:
    b
fn narrow(x: Byte):
    take_byte(x)
fn wide(s: str):
    length(s)
narrow(7)}]
    list [icSig $h narrow] [icSig $h wide]
} -result {{{x: int[Byte] (declared)}} {{s: str (declared)}}}

test ic-explicit-refinement-proves {a declared broad parameter is valid when an existing refinement proves the narrower use} -body {
    icRun {fn safe(x: int):
    if x >= 0:
        if x <= 255:
            x
        else:
            0
    else:
        0
safe(300)}
} -result 0

# ---------------------------------------------------------------------------
# Conflicting requirements (spec items 10, 47, 69)

test ic-conflict {an untyped parameter used as a str and as an Int has no sound contract: a compile-time error naming both uses -- never any} -body {
    icRejects {fn both(x):
    n = length(x)
    x + n
both("a")} {*cannot infer a sound type for parameter "x" of both: argument 1 of native length requires str (at *), but argument 1 of native + requires int (at *), and no type satisfies both*}
} -result {{CORE SEMANTIC TYPE} 1}

test ic-conflict-path-dependent {uses separated by a type refinement of the parameter itself are path-dependent: neither constrains the parameter, which keeps any} -body {
    set h [icCompile {fn either(x):
    if integer?(x):
        x + 1
    else:
        length(x)
either(1) + either("ab")}]
    list [icSig $h either] [icRun {fn either(x):
    if integer?(x):
        x + 1
    else:
        length(x)
either(1) + either("ab")}]
} -result {{{x: any (none)}} 4}

test ic-conflict-callable-result {a callable parameter whose result is used as a bool and as a str has no sound return contract} -body {
    icRejects {fn twice(p):
    if p(1):
        length(p(2))
    else:
        0
twice(is_tcl_alpha)} {*cannot infer a sound type for parameter "p" of twice:*bool*str*}
} -result {{CORE SEMANTIC TYPE} 1}

# ---------------------------------------------------------------------------
# Native wrappers: the deliberate semantic strengthening (spec items 7, 70,
# 71) and the trusted/checked boundary

set ::icWrapper "fn wrapper(x):\n    length(x)\n"

test ic-native-direct-unchanged {a direct native call with a statically wrong argument keeps its run-time TYPE error (direct native-call semantics unchanged): the native's own message, on every backend} -body {
    set exprs [hir::lower [icCompile "length(123)"]]
    lsort -unique [lmap backend {interp compile cranelift-generic cranelift} {lrange [outcomeUnder $backend $exprs] 1 2}]
} -result {{{CORE SEMANTIC TYPE} {length: expected str, got 123}}}

test ic-native-wrapper-static {wrapper(123) was a run-time TYPE error inside the native; it is now a compile-time error at the call, naming the inferred contract and where it came from} -body {
    icRejects "${::icWrapper}wrapper(123)" \
        {*:6:9: argument for parameter "x" is statically incompatible with str, the parameter type inferred from the function body (argument type: int*inferred from the function body: argument 1 of native length requires str (at 5:12)*}
} -result {{CORE SEMANTIC TYPE} 1}

test ic-native-wrapper-before {what that call used to do, and still does where no strict HIR build runs (core IR on interp; the compile backend keeps -strict 0 diagnostics as AOT blockers): enter the wrapper and raise the native's own run-time TYPE error} -body {
    set exprs [hir::lower [icCompile "${::icWrapper}wrapper(\"abc\")"]]
    set exprs [lreplace $exprs end end {call {ref wrapper} {const 123}}]
    list [differential $exprs] [lrange [outcomeUnder interp $exprs] 1 2] \
        [llength [hir::diagnostics [hir::build $exprs -strict 0]]]
} -result {same {{CORE SEMANTIC TYPE} {length: expected str, got 123}} 1}

test ic-native-wrapper-valid {a proven str argument is accepted and runs on every backend} -body {
    icRun "${::icWrapper}wrapper(\"abcd\")"
} -result 4

test ic-native-wrapper-known-kind {any argument of known kind other than str is rejected: a bool, a List, a callable} -body {
    lmap arg {true {[1]} is_tcl_alpha} {
        lindex [icRejects "${::icWrapper}wrapper($arg)" {*statically incompatible with str*}] 1
    }
} -result {1 1 1}

test ic-native-wrapper-any-argument {checked boundary: an argument whose static type is any (here an element of a heterogeneous List) still reaches the native's own run-time check -- no guard is inserted, and none is needed, because the wrapper body is never compiled assuming str} -body {
    set h [icCompile "${::icWrapper}xs = \[1, \"ab\"\]\nwrapper(list_get(xs, 1))"]
    list [icSig $h wrapper] [llength [hir::diagnostics $h]] \
        [icRun "${::icWrapper}xs = \[1, \"ab\"\]\nwrapper(list_get(xs, 1))"]
} -result {{{x: str (inferred checked)}} 0 2}

test ic-trusted-any-argument-rejected {trusted boundary: forwarding to a declared-typed callee makes the requirement trusted (the body is typed with it), so an argument not proven to satisfy it -- including one of static type any -- is a compile-time error, exactly as for a declared parameter (spec item 71)} -body {
    set src "fn take_byte(b: Byte) -> int:\n    b\nfn fwd(x):\n    take_byte(x)\n"
    list [icRejects "${src}xs = \[1, \"ab\"\]\nfwd(list_get(xs, 0))" \
            {*argument for parameter "x" cannot be proven to satisfy int\[Byte\], the parameter type inferred from the function body (argument type: any*}] \
         [icRejects "${src}fwd(9999)" {*cannot be proven to satisfy int\[Byte\], the parameter type inferred*}] \
         [icRun "${src}fwd(7)"]
} -result {{{CORE SEMANTIC TYPE} 1} {{CORE SEMANTIC TYPE} 1} 7}

test ic-trusted-forwarder-now-valid {fn fwd(x): take_byte(x) used to be a static error in fwd's own body (x : any); its body now proves the contract instead, and callers are held to it} -body {
    set h [icCompile "fn take_byte(b: Byte) -> int:\n    b\nfn fwd(x):\n    take_byte(x)\nfwd(200)"]
    icSig $h fwd
} -result {{x: int[Byte] (inferred trusted)}}

test ic-strict0-recovery {a core-IR program (-strict 0) that violates a trusted inferred contract keeps the diagnostic, and that parameter is demoted to checked-only so no backend compiles a body assuming a contract the program breaks: interp and compile agree} -body {
    set exprs [hir::lower [icCompile {fn pred_use(p):
    if p("x"):
        1
    else:
        0
pred_use(is_tcl_alpha)}]]
    set exprs [lreplace $exprs end end {call {ref pred_use} {block {c} {const 5}}}]
    set h [hir::build $exprs -strict 0]
    set e [icBlock $h pred_use]
    list [llength [hir::diagnostics $h]] [hir::signatures::entryTypes $h $e] [differential $exprs] \
        [lindex [outcomeUnder interp $exprs] 1]
} -result {1 {{}} same {CORE SEMANTIC NOT-BOOLEAN}}

# ---------------------------------------------------------------------------
# Callable parameters (spec items 15-22, 27-29, 72)

set ::icPredUse "fn pred_use(p):\n    if p(\"x\"):\n        1\n    else:\n        0\n"

test ic-callable-accepts {a native, an untyped Block, a str-declared Block and a capturing closure all satisfy Fn{args: [str], return: bool, errors: []}} -body {
    icRun "${::icPredUse}fn eq_x?(c):\n    c == \"x\"\nfn typed(c: str) -> bool:\n    length(c) == 1\nfn make(v):\n    fn eq?(c):\n        c == v\n    eq?\n\[pred_use(is_tcl_alpha), pred_use(eq_x?), pred_use(typed), pred_use(make(\"y\"))\]"
} -result {[1, 1, 1, 0]}

test ic-callable-variance {argument variance is contravariant: a callable whose parameter requires int cannot accept the str this body passes} -body {
    icRejects "${::icPredUse}fn int_only(n: int) -> bool:\n    n == 1\npred_use(int_only)" \
        {*argument 1 is incompatible: the callable's parameter requires int, but callers of the function type may pass any str*}
} -result {{CORE SEMANTIC TYPE} 1}

test ic-callable-return {the result consumed as an if condition requires return bool: a callable returning an Int is rejected statically} -body {
    icRejects "${::icPredUse}fn len(c):\n    length(c)\npred_use(len)" \
        {*return incompatible: the callable returns int, not usable as bool*}
} -result {{CORE SEMANTIC TYPE} 1}

test ic-callable-unknown-rejected {a trusted callable contract is a static obligation: an argument of type any is rejected (never checked at run time)} -body {
    icRejects "${::icPredUse}xs = \[is_tcl_alpha, 1\]\npred_use(list_get(xs, 0))" \
        {*argument for parameter "p" cannot be proven to satisfy Fn\{args: \[str\], return: bool, errors: \[\]\}, the parameter type inferred from the function body*}
} -result {{CORE SEMANTIC TYPE} 1}

test ic-callable-return-unconstrained {a result that is only returned leaves the contract's return any} -body {
    set h [icCompile "fn apply1(f):\n    f(1)\napply1(is_tcl_alpha)"]
    icSig $h apply1
} -result {{f: Fn{args: [int], return: any, errors: []} (inferred trusted)}}

test ic-callable-arity {every call site fixes the arity; one of two arities has no contract (the parameter keeps any)} -body {
    set h [icCompile "fn two(f):\n    f(1)\n    f(1, 2)\n0"]
    list [icSig $h two] [lindex [icNote $h two f] 0]
} -result {{{f: any (none)}} arity}

test ic-callable-errors-empty {a call in an error-free context infers errors: [], and a callable declaring NotFound is rejected} -body {
    icRejects "${::icPredUse}fn missing(c) -> bool errors NotFound:\n    fail NotFound\npred_use(missing)" \
        {*error set incompatible: the callable may raise NotFound, but the function type allows only \[\]*}
} -result {{CORE SEMANTIC TYPE} 1}

test ic-callable-errors-declared {inside a function admitting NotFound the inferred contract permits NotFound: a NotFound-declaring callable is accepted, and its error propagates to the caller's handler on every backend} -body {
    set src "fn use(p) -> int errors NotFound:\n    if p(\"x\"):\n        1\n    else:\n        0\nfn missing(c) -> bool errors NotFound:\n    fail NotFound\n"
    set h [icCompile "${src}r = use(is_tcl_alpha):\n    on NotFound:\n        7\nr"]
    list [icSig $h use] [icRun "${src}r = use(missing):\n    on NotFound:\n        7\nr"]
} -result {{{p: Fn{args: [str], return: bool, errors: [NotFound]} (inferred trusted)}} 7}

test ic-callable-errors-handled {a call handled for NotFound admits NotFound} -body {
    set h [icCompile "fn guarded(p):\n    ok = p(\"x\"):\n        on NotFound:\n            false\n    ok\nguarded(is_tcl_alpha)"]
    icSig $h guarded
} -result {{p: Fn{args: [str], return: any, errors: [NotFound]} (inferred trusted)}}

test ic-callable-errors-extra-rejected {a callable declaring an extra undeclared error is rejected (declared errors are upper bounds)} -body {
    icRejects "fn use(p) -> int errors NotFound:\n    if p(\"x\"):\n        1\n    else:\n        0\nfn both(c) -> bool errors NotFound, PermissionDenied:\n    fail PermissionDenied\nr = use(both):\n    on NotFound:\n        7\nr" \
        {*the callable may raise PermissionDenied, but the function type allows only \[NotFound\]*}
} -result {{CORE SEMANTIC TYPE} 1}

test ic-callable-errors-meet {errors are intersected over call sites: one site admits NotFound, the other nothing} -body {
    set h [icCompile "fn two(p):\n    a = p(\"x\"):\n        on NotFound:\n            false\n    p(\"y\")\ntwo(is_tcl_alpha)"]
    icSig $h two
} -result {{p: Fn{args: [str], return: any, errors: []} (inferred trusted)}}

test ic-relational-stop {loop x in xs: predicate(x) needs "the element type of xs" (a type variable): no Fn{args: [any]} is invented; predicate keeps any and a str-only predicate still works through it} -body {
    set src "fn all_of(xs, predicate):\n    loop x in xs:\n        if not predicate(x):\n            return false\n    true\nfn one?(c):\n    length(c) == 1\n"
    set h [icCompile "${src}all_of(\[\"a\"\], one?)"]
    list [icSig $h all_of] [lindex [icNote $h all_of predicate] 0] [icRun "${src}all_of(\[\"a\", \"b\"\], one?)"]
} -result {{{xs: list (inferred checked)} {predicate: any (none)}} relational true}

test ic-callable-escape {a callable parameter that escapes (here into an untyped List) gets no contract: an unknown party may call it with unknown arguments} -body {
    set h [icCompile "fn keep(p):\n    if p(\"x\"):\n        \[p\]\n    else:\n        \[\]\nkeep(is_tcl_alpha)"]
    list [icSig $h keep] [lindex [icNote $h keep p] 0]
} -result {{{p: any (none)}} escapes}

test ic-callable-through-hof {a callable passed on to another function whose own parameter has an inferred Fn contract does not escape: the contracts meet} -body {
    set h [icCompile "${::icPredUse}fn outer(q):\n    pred_use(q)\nouter(is_tcl_alpha)"]
    icSig $h outer
} -result {{q: Fn{args: [str], return: bool, errors: []} (inferred trusted)}}

test ic-callable-no-target {calling an inferred callable parameter stays callvalue: a contract, never a code target} -body {
    set h [icCompile "${::icPredUse}pred_use(is_tcl_alpha)"]
    set nir [dict get [native::lower::program [native::buildProgramHir [hir::lower $h]]] text]
    regexp {= callvalue } $nir
} -result 1

# ---------------------------------------------------------------------------
# Reachability (spec items 59-60)

test ic-unreachable-ignored {a use after an unconditional return is unreachable and imposes nothing} -body {
    set h [icCompile "fn early(x):\n    return 1\n    length(x)\nearly(5)"]
    icSig $h early
} -result {{x: any (none)}}

test ic-unreachable-call-ignored {a call of a parameter in a statically dead branch neither infers a contract nor any error requirement} -body {
    set h [icCompile "fn dead(p):\n    if false:\n        p(1)\n    else:\n        0\ndead(5)"]
    icSig $h dead
} -result {{p: any (none)}}

# ---------------------------------------------------------------------------
# Result-type precision (spec items 34, 73) and exact Block / structural Fn
# integration (36-37)

set ::icPick "fn is_x?(c):\n    c == \"x\"\nfn is_y?(c):\n    c == \"y\"\nfn pick(flag):\n    if flag:\n        is_x?\n    else:\n        is_y?\nfn classify(flag, c):\n    f = pick(flag)\n    f(c)\n"

test ic-result-bool-preserved {a created Block's body-inferred bool result survives: exact Block type, its structural contract, the join in the used specialization instance, and the call result there (was return: any in instance views)} -body {
    set h [icCompile "${::icPick}classify(true, \"x\")"]
    set x [icBlock $h is_x?]
    set exact [hir::bindingType $h [lindex [dict keys [dict filter [dict get $h bindings] script {b v} {expr {[dict get $v name] eq "is_x?"}}]] 0]]
    set hir [native::buildProgramHir [hir::lower $h]]
    set spec [hir::specialize::analyze $hir]
    set pickIf ""
    set call ""
    foreach id [dict get $spec used] {
        set label [hir::specialize::label $spec $id]
        set view [hir::specialize::view $hir $spec $id]
        set block [dict get [hir::specialize::instance $spec $id] block]
        if {[string match "pick<*" $label]} {
            foreach e [dict get [hir::specialize::instance $spec $id] reachable] {
                if {[hir::kind $view $e] eq "if"} { set pickIf [hir::types::show [hir::typeOf $view $e]] }
            }
        }
        if {[string match "classify<*" $label]} {
            foreach e [dict get [hir::specialize::instance $spec $id] reachable] {
                if {[hir::kind $view $e] eq "call" && [hir::get $view $e target] eq ""} {
                    set call [hir::types::show [hir::typeOf $view $e]]
                }
            }
        }
    }
    list [hir::types::show $exact] [hir::types::show [hir::types::structuralOf $exact]] $pickIf $call
} -result {{block(e2)/1 -> bool} {Fn{args: [any], return: bool, errors: []}} {Fn{args: [any], return: bool, errors: []}} bool}

test ic-exact-block-trusted-contract {a trusted inferred contract is part of the exact Block's structural supertype (like a declaration); a checked-only one is not (like a native's own -param-types)} -body {
    set h [icCompile "${::icPredUse}fn wrapper(x):\n    length(x)\nfn take_byte(b: Byte) -> int:\n    b\nfn fwd(x):\n    take_byte(x)\npred_use(is_tcl_alpha)"]
    lmap name {pred_use wrapper fwd} {
        set b [lindex [dict keys [dict filter [dict get $h bindings] script {b v} {expr {[dict get $v name] eq $name && [dict get $v kind] eq "local"}}]] 0]
        hir::types::show [hir::types::structuralOf [hir::bindingType $h $b]]
    }
} -result {{Fn{args: [Fn{args: [str], return: bool, errors: []}], return: int, errors: []}} {Fn{args: [any], return: int, errors: []}} {Fn{args: [int[Byte]], return: int, errors: []}}}

test ic-trusted-bearing {a function with a trusted inferred contract is precondition-bearing like a declared one: erasing it into an untyped parameter is rejected} -body {
    icRejects "${::icPredUse}fn app(f, v):\n    f(v)\napp(pred_use, is_tcl_alpha)" \
        {*"pred_use" has typed parameter requirements that cannot be preserved passed as an ordinary call argument*}
} -result {{CORE SEMANTIC TYPE} 1}

test ic-checked-not-bearing {a checked-only contract is not precondition-bearing: a str-requiring wrapper still passes through generic helpers (list::all?)} -body {
    set ::icDeclsSaved $::icDecls
    set ::icDecls ""
    try {
        icRun "fn one?(c):\n    length(c) == 1\nlist::all?(\[\"a\", \"b\"\], one?)"
    } finally {
        set ::icDecls $::icDeclsSaved
    }
} -result true

# ---------------------------------------------------------------------------
# Specialization keys (spec items 62-63)

test ic-keys-unchanged {inferred contracts never enter specialization keys: the scanner's instances are keyed by the argument kinds exactly as before (native / block), and each instance's body sees the Fn contract} -body {
    set src "fn scan(p, n):\n    loop i from 0 to n:\n        if p(\"a\"):\n            continue\n        return i\n    n\nfn loc?(c):\n    is_tcl_alnum(c)\n\[scan(is_tcl_alpha, 3), scan(loc?, 2)\]"
    set hir [native::buildProgramHir [hir::lower [icCompile $src]]]
    set spec [hir::specialize::analyze $hir]
    set labels [lmap id [dict get $spec used] {hir::specialize::label $spec $id}]
    set scan [lsearch -inline -all $labels scan<*]
    set id [lindex [dict get $spec used] [lsearch $labels [lindex $scan 0]]]
    set view [hir::specialize::view $hir $spec $id]
    set block [dict get [hir::specialize::instance $spec $id] block]
    set p [lindex [hir::get $view $block params] 0]
    set callee ""
    foreach e [dict get [hir::specialize::instance $spec $id] reachable] {
        if {[hir::kind $view $e] eq "call" && [hir::get $view $e target] eq ""} {
            set callee [hir::types::show [hir::typeOf $view [hir::get $view $e callee]]]
        }
    }
    list $scan $callee [icRun $src]
} -result {{{scan<native, int>} {scan<block, int>}} {Fn{args: [str], return: bool, errors: []}} {[3, 2]}}

# ---------------------------------------------------------------------------
# Module signatures (spec items 44-45)

test ic-module-signature {an unannotated module export reports its body-inferred contract (source inferred); a declared parameter stays the API boundary (source declared)} -body {
    set h [icCompile "list::all?(\[\"a\"\], is_tcl_alpha)" 1 ""]
    set sigs [hir::moduleSignatures $h]
    list [lmap t [dict get [dict get $sigs list::all?] params] {hir::types::show $t}] \
        [dict get [dict get $sigs list::all?] sources]
} -result {{list any} {inferred none}}

# ---------------------------------------------------------------------------
# Canonical acceptance cases (spec items 23-25, 38, 52-57): the real,
# unchanged lib/web.bot and lib/list.bot

# Programs loading library modules (web, byte, list) take no local
# type/error declarations: the modules declare their own Byte/NotFound.
proc icWebHir {} {
    return [icCompile "web::emailish?(\"a@b.cd\")" 1 ""]
}

test ic-scan-while {scan_while's own body infers start : int (the counted loop's bound, checked) and predicate : Fn{args: [str], return: bool, errors: []} (trusted) from predicate(char_at(i)) used as an if condition, in an error-free function -- no caller consulted} -body {
    set h [icWebHir]
    list [icSig $h scan_while] [icWhy $h scan_while start]
} -result {{{start: int (inferred checked)} {predicate: Fn{args: [str], return: bool, errors: []} (inferred trusted)}} {{checked the start of a counted loop -> int}}}

test ic-scan-while-call {predicate(char_at(i)) is typed from the contract: bool, no errors, still no target} -body {
    set h [icWebHir]
    set block [icBlock $h scan_while]
    set p [lindex [hir::get $h $block params] 1]
    set out {}
    dict for {e node} [dict get $h exprs] {
        if {[dict get $node kind] ne "call"} continue
        set callee [dict get $node callee]
        if {[hir::kind $h $callee] eq "ref" && [hir::get $h $callee binding] eq $p} {
            lappend out [hir::types::show [hir::typeOf $h $e]] [dict get $node target] [dict get $node calleeErrors]
        }
    }
    set out
} -result {bool {} {}}

test ic-local-char {local_char?(c): is_tcl_alnum requires str (checked), set membership requires nothing (immutable_set_contains accepts any element); their meet is str; the result is bool} -body {
    set h [icWebHir]
    list [icSig $h local_char?] [icWhy $h local_char? c] \
        [hir::types::show [dict get [hir::signatures::of $h [icBlock $h local_char?]] result]]
} -result {{{c: str (inferred checked)}} {{checked argument 1 of native is_tcl_alnum -> str}} bool}

test ic-label-char {label_char?(c): is_tcl_alnum requires str, == requires nothing: str} -body {
    set h [icWebHir]
    list [icSig $h label_char?] [icWhy $h label_char? c]
} -result {{{c: str (inferred checked)}} {{checked argument 1 of native is_tcl_alnum -> str}}}

test ic-emailish-callers-valid {every existing caller of the web helpers proves (or cannot contradict) the inferred contracts: no diagnostic} -body {
    llength [hir::diagnostics [icCompile "web::emailish?(\"a@b.cd\")" 0 ""]]
} -result 0

test ic-list-helpers {list::any?/all?/none?/find: xs is a list (the loop iterable, checked); predicate stays untyped -- the argument is the element type of xs, a relational constraint -- even though its result's use (bool) is known} -body {
    set h [icCompile "list::all?(\[\"a\"\], is_tcl_alpha)" 1 ""]
    lmap name {list::any? list::all? list::none? list::find} {
        list [icSig $h $name] [lindex [icNote $h $name predicate] 0]
    }
} -result {{{{xs: list (inferred checked)} {predicate: any (none)}} relational} {{{xs: list (inferred checked)} {predicate: any (none)}} relational} {{{xs: list (inferred checked)} {predicate: any (none)}} relational} {{{xs: list (inferred checked)} {predicate: any (none)}} relational}}

cleanupTests
