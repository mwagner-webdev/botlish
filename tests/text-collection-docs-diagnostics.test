# text-collection-docs-diagnostics.test -- what
# TEXT-AND-COLLECTION-DOCUMENTATION-AND-DIAGNOSTICS-MILESTONE-1.md (the
# census's M2) corrected: a declared function result's TYPE diagnostic names
# the result type the compiler inferred beside the declared one -- the
# generic body's own analysis, every normal completion joined, never a
# semantic instance's -- and the documentation of strings, UTF-8, text
# construction, literal escapes and List typing says what the compiler does.
# Where a documented statement is a fact of the compiler (the escape
# vocabulary, encode_utf8's static type, which text constructions copy
# linearly), the test reads the fact from the compiler and the statement
# from the documentation, and requires them to agree.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot compilerpedia compilerpedia.tcl]
interp recursionlimit {} 100000

testConstraint nativeBuilt [expr {![catch {native::binary}]}]

namespace eval tcd {}

# One reported diagnostic (core::raiseDiagnostics' entry) as {KIND
# LINE:COLUMN MESSAGE}: KIND the code's last word (SYNTAX for a syntax
# error), the message without its location.
proc tcd::Entry {errorcode message} {
    set kind [expr {[lrange $errorcode 0 1] eq {SURFACE SYNTAX} ? "SYNTAX" : [lindex $errorcode 2]}]
    if {[regexp {^.*?\.bot:(\d+):(\d+): (.*)$} $message -> line column text]} {
        return [list $kind $line:$column $text]
    }
    return [list $kind "" $message]
}

# What a strict compilation of the program SOURCE reports: `accepted`, or its
# diagnostics in reported order (Entry).
proc tcd::Report {source} {
    set path [makeFile $source tcd-case.bot]
    try {
        if {![catch {surface::readProgramFile $path -warnings off} hir options]} {
            return accepted
        }
        if {![dict exists $options -diagnostics]} {
            return [list [Entry [dict get $options -errorcode] [lindex [split $hir \n] 0]]]
        }
        return [lmap d [dict get $options -diagnostics] {
            Entry [dict get $d errorcode] [dict get $d message]
        }]
    } finally {
        removeFile tcd-case.bot
    }
}

# REPORT (Report) with each message cut before its explanation clause ("; ..."),
# which this milestone does not change: the comparison itself, exactly.
proc tcd::Cut {report} {
    return [lmap entry $report {
        lassign $entry kind at message
        set cut [string first "; " $message]
        list $kind $at [expr {$cut < 0 ? $message : [string range $message 0 $cut-1]}]
    }]
}

# The backends a test runs a program on: the native ones too where built.
proc tcd::Backends {} {
    if {[testConstraint nativeBuilt]} {
        return {interp compile cranelift-generic cranelift}
    }
    return {interp compile}
}

# The lenient HIR of the program SOURCE (its diagnostics kept).
proc tcd::Hir {source} {
    set path [makeFile $source tcd-case.bot]
    try {
        return [surface::readProgramFile $path -strict 0 -warnings off]
    } finally {
        removeFile tcd-case.bot
    }
}

# The block of HIR bound to NAME.
proc tcd::Block {hir name} {
    dict for {b binding} [dict get $hir bindings] {
        if {[hir::semantic::SourceName $hir $b] ne $name} continue
        dict for {e node} [dict get $hir exprs] {
            if {[dict get $node kind] eq "bind" && [dict get $node binding] eq $b} {
                return [dict get $node value]
            }
        }
    }
    error "no function $name"
}

# Compilerpedia's page ID as the help shows it, whitespace collapsed.
proc tcd::Page {id} {
    return [regsub -all {\s+} [compilerpedia::render $id] " "]
}

# The kind of what QUERY finds, and its ID(s).
proc tcd::Found {query} {
    set result [compilerpedia::lookup $query]
    switch -- [dict get $result kind] {
        page    { return [list page [dict get $result id]] }
        list    { return [list list [lindex [dict get $result ids] 0]] }
        index   { return [list index [dict get $result name]] }
        default { return [dict get $result kind] }
    }
}

# The text of FILE under the repository root.
proc tcd::Read {file} {
    set f [open [file join $::projectRoot $file] r]
    fconfigure $f -encoding utf-8
    set text [read $f]
    close $f
    return $text
}

# ---------------------------------------------------------------------------
# The declared-result diagnostic names the inferred result type

test tcd-result-applied {the census's j3: a List[Byte] returned as -> List[int] (invariant admission, unchanged) is reported with both types, as an argument's mismatch already was} -body {
    tcd::Report {import std::str
import std::byte

fn give(s: str) -> List[int]:
    s.encode_utf8()

fn take(xs: List[int]) -> int:
    0

take("a".encode_utf8())
}
} -result {{TYPE 4:8 {function result does not prove declared type List[int] (result type: List[int[std::byte::Byte]])}} {TYPE 10:6 {argument for parameter "xs" cannot be proven to satisfy List[int] (argument type: List[int[std::byte::Byte]])}}}

test tcd-result-nested {a nested applied type keeps its whole structure on both sides; a literal's inferred length is forgotten, as in an argument's diagnostic, unless the declaration states one} -body {
    tcd::Cut [tcd::Report {import std::str
import std::byte

fn give(s: str) -> List[List[int]]:
    [s.encode_utf8(), s.encode_utf8()]

fn pairs(s: str) -> List[List[int]{length: 2}]:
    [s.encode_utf8()]

0
}]
} -result {{TYPE 4:8 {function result does not prove declared type List[List[int]] (result type: List[List[int[std::byte::Byte]]])}} {TYPE 7:9 {function result does not prove declared type List[List[int]{length: 2}] (result type: List[List[int[std::byte::Byte]]]{length: 1})}}}

test tcd-result-refinement {a numeric refinement is shown as the domain the result has, never replaced by its carrier: a Digit returned as a Small is int[Digit], an unconstrained Int and a sum are int, each with the range proven for it} -body {
    tcd::Report {type Digit = Int in 0..9
type Small = Int in 0..5

fn narrow(d: Digit) -> Small:
    d

fn digit(n: int) -> Digit:
    n

fn next(d: Digit) -> Digit:
    d + 1

fn smalls(xs: List[Digit]) -> List[Small]:
    xs

0
}
} -result {{TYPE 4:10 {function result does not prove declared type int[Small] (result type: int[Digit], facts: [0, 9])}} {TYPE 7:9 {function result does not prove declared type int[Digit] (result type: int, facts: [-∞, +∞])}} {TYPE 10:8 {function result does not prove declared type int[Digit] (result type: int, facts: [1, 10])}} {TYPE 13:10 {function result does not prove declared type List[int[Small]] (result type: List[int[Digit]])}}}

test tcd-result-nominal {nominal types show both identities: two named structs, two enums (the case of another enum), two applications of one parameterized struct; the mismatch explanation that follows is unchanged} -body {
    set report [tcd::Report {struct Meters:
    value: int

struct Feet:
    value: int

struct Box[T]:
    value: T

enum Color:
    Red, Green

enum Shade:
    Red, Dark

fn length() -> Meters:
    Feet {value: 3}

fn color() -> Color:
    Shade::Red

fn boxed(b: Box[str]) -> Box[int]:
    b

0
}]
    list [tcd::Cut $report] [lmap entry $report {string match {*; * are distinct *} [lindex $entry 2]}]
} -cleanup {unset -nocomplain report} -result {{{TYPE 16:10 {function result does not prove declared type Meters (result type: Feet)}} {TYPE 19:9 {function result does not prove declared type Color (result type: Shade)}} {TYPE 22:9 {function result does not prove declared type Box[int] (result type: Box[str])}}} {1 0 1}}

test tcd-result-callable {a function value is shown as the callable it is (by its function's name), before the contract's explanation} -body {
    lindex [tcd::Cut [tcd::Report {fn inc(x: int) -> int:
    x + 1

fn get() -> Fn{args: [str], return: int}:
    inc

0
}]] 0
} -result {TYPE 4:7 {function result does not prove declared type Fn{args: [str], return: int, errors: []} (result type: inc/1 -> int)}}

test tcd-result-unknown {a result the compiler knows nothing about is reported as any, the type the proof was given -- never a concrete type made up for it} -body {
    tcd::Report {import std::list

fn first(xs: list) -> int errors IndexNotFound:
    xs.at(0)

0
}
} -result {{TYPE 3:9 {function result does not prove declared type int (result type: any, facts: [-∞, +∞])}}}

test tcd-result-poison-primary {a function whose result is poison (a call of a non-callable), unresolved (an unbound name) or a failed projection reports only that primary diagnostic: no result diagnostic restates it, with or without a type} -body {
    tcd::Report {fn poisoned() -> str:
    n = 5
    n(1)

fn unbound() -> str:
    missing_name

fn projected(x: int) -> str:
    x.no_such_method()

0
}
} -match glob -result {{UNBOUND 6:5 *} {NOT-CALLABLE 3:5 *} {NOT-A-STRUCT 9:7 *}}

test tcd-result-syntax-hole {past a syntax error (-check's recovered analysis) a function holding the hole gets no result diagnostic -- a hole is no value -- while a complete function's mismatch is reported with its result type} -body {
    set path [makeFile "fn f(n: int) -> str:\n    x = (n +\n    x\n\nfn g() -> str:\n    1\n\n0\n" tcd-hole.bot]
    set hir [surface::readProgramFile $path -strict 0 -warnings off -recover-syntax 1]
    lmap d [hir::recovery::reported $hir] {
        if {[dict get $d kind] ne "TYPE"} continue
        dict get $d message
    }
} -cleanup {removeFile tcd-hole.bot; unset -nocomplain path hir} -result {{function result does not prove declared type str (result type: int)}}

test tcd-result-joined-paths {a result reached on several paths is reported with the join the checker established -- a String and an Int join to any, a Digit and a Small to int over [0, 9], two List lengths to the List without a length -- never one branch's type} -body {
    tcd::Cut [tcd::Report {type Digit = Int in 0..9
type Small = Int in 0..5

fn early(c: bool) -> int:
    if c:
        return "early"
    1

fn joined(c: bool, d: Digit, s: Small) -> Small:
    if c:
        return d
    s

fn lengths(c: bool) -> List[int]{length: 2}:
    if c:
        return [1, 2, 3]
    [1, 2]

0
}]
} -result {{TYPE 4:9 {function result does not prove declared type int (result type: any, facts: [-∞, +∞])}} {TYPE 9:10 {function result does not prove declared type int[Small] (result type: int, facts: [0, 9])}} {TYPE 14:11 {function result does not prove declared type List[int]{length: 2} (result type: List[int])}}}

test tcd-result-semantic-instances {a generic function's mismatch is its generic body's: its semantic instances infer List[int]{length: 2} and List[str]{length: 2} for their calls' arguments, but the diagnostic shows the generic result, list; an imprinted function's shows its imprint variable, not a call's binding} -body {
    set source {import std::list

fn pair(a, b) -> List[str]:
    [a, b]

fn same(xs: List[T]) -> List[int]:
    xs

fn one(xs: List[T]) -> int errors IndexNotFound:
    xs.at(0)

[pair(1, 2), pair("a", "b"), same(["s"]), same([1])]
}
    set hir [tcd::Hir $source]
    set block [tcd::Block $hir pair]
    set instances [lsort [lmap {id inst} [dict get $hir semantic instances] {
        if {[dict get $inst block] ne $block} continue
        hir::types::show [dict get $inst snapshot exprs $block inferredResultType]
    }]]
    list $instances [lmap e [tcd::Report $source] {lindex $e 2}]
} -cleanup {unset -nocomplain source hir block instances} -result {{{List[int]{length: 2}} {List[str]{length: 2}}} {{function result does not prove declared type List[str] (result type: list)} {function result does not prove declared type List[int] (result type: List[T])} {function result does not prove declared type int (result type: T, facts: [-∞, +∞])}}}

test tcd-result-type-is-the-checked-one {the result type a diagnostic names is the block's own inferred result (inferredResultType, the type the admission proof was given), presented as an argument's type is: for every mismatching function of the cases above} -body {
    set problems {}
    foreach source [list {import std::str
import std::byte

fn give(s: str) -> List[int]:
    s.encode_utf8()

fn pair(a, b) -> List[str]:
    [a, b]

[pair(1, 2), pair("a", "b")]
} {type Digit = Int in 0..9
type Small = Int in 0..5

fn joined(c: bool, d: Digit, s: Small) -> Small:
    if c:
        return d
    s

fn narrow(d: Digit) -> Small:
    d

0
}] {
        set hir [tcd::Hir $source]
        foreach d [dict get $hir diagnostics] {
            if {![regexp {^function result does not prove declared type .*? \(result type: (.*?)(, facts: .*)?\)$} [dict get $d message] -> shown]} {
                continue
            }
            set node [dict get $hir exprs [dict get $d expr]]
            set inferred [hir::type $hir [dict get $node inferredResultType]]
            set want [hir::semantic::ShowType $hir [hir::range::ShownArgType $inferred [dict get $node declaredResult]]]
            lappend problems [expr {$shown eq $want ? "ok" : "$shown is not $want"}]
        }
    }
    set problems
} -cleanup {unset -nocomplain problems source hir d node inferred want shown} -result {ok ok ok ok}

test tcd-result-classification {the diagnostic keeps its code (CORE SEMANTIC TYPE), its location (the function's parameter list), its help topic (rule.type-result) and its count (one per function); a valid result, a declared domain proven by a guard and a declared list remain accepted} -body {
    set path [makeFile "fn f() -> str:\n    1\n\nf()\n" tcd-one.bot]
    catch {surface::readProgramFile $path -warnings off} message options
    list [dict get $options -errorcode] [llength [dict get $options -diagnostics]] \
        [compilerpedia::topicForDiagnostic [dict get $options -errorcode] [dict get [lindex [dict get $options -diagnostics] 0] message]] \
        [tcd::Report {import std::str
import std::byte

type Digit = Int in 0..9

fn give(s: str) -> List[std::byte::Byte]:
    s.encode_utf8()

fn digit(n: int) -> Digit:
    if n < 0 or n > 9:
        return 0
    n

fn any_list(s: str) -> list:
    s.encode_utf8()

[give("é"), digit(4), any_list("hé")]
}]
} -cleanup {removeFile tcd-one.bot; unset -nocomplain path message options} -result {{CORE SEMANTIC TYPE} 1 rule.type-result accepted}

# ---------------------------------------------------------------------------
# UTF-8: encode_utf8, decode_utf8 and encode_utf8's import-dependent type

test tcd-doc-utf8-decoding {encode_utf8's page names the way back -- std::abi::bytes::from_list, std::abi::bytes::decode_utf8 and its declared error InvalidUtf8 -- and no longer says there is none; decode utf8 finds std::abi::bytes::decode_utf8, which exists with that contract} -body {
    set page [tcd::Page stdlib.std::str::encode_utf8]
    set decl [compilerpedia::render stdlib.std::abi::bytes::decode_utf8]
    list [string match {*std::abi::bytes::decode_utf8*} $page] [string match {*std::abi::bytes::from_list*} $page] \
        [string match {*InvalidUtf8*} $page] [regexp -nocase {no decoding|no operation [^.]*back} $page] \
        [tcd::Found "decode utf8"] [string match {*fn decode_utf8(data: Bytes) -> str errors InvalidUtf8*} $decl]
} -cleanup {unset -nocomplain page decl} -result {1 1 1 0 {page stdlib.std::abi::bytes::decode_utf8} 1}

test tcd-doc-utf8-static-type {encode_utf8's documented static type is the compiler's: List[std::byte::Byte] when std::byte is loaded (directly, or by std::abi::bytes), the plain list otherwise -- the page states both and the condition, and so does README §8} -body {
    set types {}
    foreach imports {{import std::str} {import std::str
import std::abi::bytes} {import std::str
import std::byte}} {
        set report [tcd::Report "$imports\n\nfn t(s: str) -> str:\n    s\n\nt(\"é\".encode_utf8())\n"]
        regexp {\(argument type: (.*)\)$} [lindex $report 0 2] -> type
        lappend types $type
    }
    set page [tcd::Page stdlib.std::str::encode_utf8]
    set readme [regsub -all {\s+} [tcd::Read docs/README.md] " "]
    regexp {\| `std::str::encode_utf8` \|([^|]*)\|} $readme -> row
    list $types [string match {*has loaded std::byte*it is List\[std::byte::Byte\]; otherwise*} $page] [string match {*plain `list`*} $page] \
        [string match {*std::abi::bytes*} $page] [string match {*List\[std::byte::Byte\]` when*plain `list`*} $row]
} -cleanup {unset -nocomplain types imports report type page readme row} -result {{list {List[int[std::byte::Byte]]} {List[int[std::byte::Byte]]}} 1 1 1 1}

test tcd-doc-utf8-from-list-invariant {the documentation does not claim an arbitrary List of Ints is accepted by from_list: the compiler rejects one, and both pages say a List[std::byte::Byte] is needed (std::byte::from_int converts each Int)} -body {
    set report [tcd::Report "import std::abi::bytes\n\nx = std::abi::bytes::from_list(\[104, 105\])\n0\n"]
    set encode [tcd::Page stdlib.std::str::encode_utf8]
    set decode [tcd::Page stdlib.std::abi::bytes::decode_utf8]
    list [lindex $report 0 0] [string match {*cannot be proven to satisfy List\[int\[std::byte::Byte\]\]*} [lindex $report 0 2]] \
        [string match {*std::byte::from_int*} $encode] [string match {*std::byte::from_int*} $decode]
} -cleanup {unset -nocomplain report encode decode} -result {TYPE 1 1 1}

# ---------------------------------------------------------------------------
# Text construction

test tcd-doc-no-test-library-join {no page recommends std::test::joined for building text: task.string-concatenation no longer relates it, every sentence of the text pages that names it says it is quadratic, and its own page says it is a test helper} -body {
    set problems {}
    if {"stdlib.std::test::joined" in [dict get [compilerpedia::topic task.string-concatenation] related]} {
        lappend problems "task.string-concatenation relates std::test::joined"
    }
    foreach id {task.string-concatenation capability.string-formatting concept.strings stdlib.module.std::str stdlib.std::str::concat} {
        foreach sentence [split [string map {". " \x01} [tcd::Page $id]] \x01] {
            if {[string match {*std::test::joined*} $sentence] && ![string match -nocase {*quadratic*} $sentence]} {
                lappend problems "$id: $sentence"
            }
        }
    }
    set own [tcd::Page stdlib.std::test::joined]
    list $problems [string match -nocase {*quadratic*} $own] [string match {*test*helper*} $own]
} -cleanup {unset -nocomplain problems id sentence own} -result {{} 1 1}

test tcd-doc-construction-claims {task.string-concatenation's documented recursion is what the compiler accepts and computes on every backend, with every index proven (no handler); std::str has no join, as the page says} -body {
    set page [tcd::Page task.string-concatenation]
    set hasJoin [core::native::exists std::str::join]
    list [string match {*std::str has no join*} $page] $hasJoin \
        [sourceAgree {import std::list
import std::str

fn join_from(parts: List[str], separator: str, i: int, acc: str) -> str:
    if i < 0 or i >= parts.length():
        return acc
    if i == 0:
        return parts.join_from(separator, i + 1, acc.concat(parts.at(i)))
    parts.join_from(separator, i + 1, acc.concat(separator).concat(parts.at(i)))

fn text_from(chars: List[UnicodeChar], i: int, acc: str) -> str:
    if i < 0 or i >= chars.length():
        return acc
    chars.text_from(i + 1, acc.concat("".append_char(chars.at(i))))

[["a", "bc", "😀"].join_from("; ", 0, ""), [].join_from(", ", 0, ""), ['x', 'é'].text_from(0, "")]
} [tcd::Backends]]
} -cleanup {unset -nocomplain page hasJoin} -result {1 0 {value {["a; bc; 😀", "", "xé"]}}}

# String bytes copied (native::allocationReport) building text of N parts by
# the documented recursion (`join`) or by a fold carrying concat (`fold`), or
# N characters by concatenating one-character Strings (`concat`) or by
# append_char (`append`).
proc tcd::Copied {shape n} {
    set body [dict get {
        join {fn join_from(parts: List[str], separator: str, i: int, acc: str) -> str:
    if i < 0 or i >= parts.length():
        return acc
    if i == 0:
        return parts.join_from(separator, i + 1, acc.concat(parts.at(i)))
    parts.join_from(separator, i + 1, acc.concat(separator).concat(parts.at(i)))
parts = loop i from 0 to N:
    "ab;"
std::str::length(parts.join_from(", ", 0, ""))
}
        fold {parts = loop i from 0 to N:
    "ab;"
s = fold p in parts with intermediate acc "":
    acc.concat(p)
std::str::length(s)
}
        concat {fn text_from(chars: List[UnicodeChar], i: int, acc: str) -> str:
    if i < 0 or i >= chars.length():
        return acc
    chars.text_from(i + 1, acc.concat("".append_char(chars.at(i))))
chars = loop i from 0 to N:
    'é'
std::str::length(chars.text_from(0, ""))
}
        append {fn text_from(chars: List[UnicodeChar], i: int, acc: str) -> str:
    if i < 0 or i >= chars.length():
        return acc
    chars.text_from(i + 1, acc.append_char(chars.at(i)))
chars = loop i from 0 to N:
    'é'
std::str::length(chars.text_from(0, ""))
}} $shape]
    set hir [surface::compile "import std::list\nimport std::str\n[string map [list N $n] $body]" <tcd> -warnings off]
    return [dict get [native::allocationReport $hir summary 1] copies stringBytes]
}

test tcd-doc-construction-costs {the costs task.string-concatenation states hold natively: its recursions and a fold carrying concat copy in proportion to the text (4x the parts, at most 5x the bytes), append_char carried along copies the whole String each time (4x the characters, at least 12x the bytes) -- if the optimizer changes either, the page must change with it} -constraints nativeBuilt -body {
    set ratios {}
    foreach shape {join fold concat append} {
        set small [tcd::Copied $shape 1000]
        set large [tcd::Copied $shape 4000]
        lappend ratios $shape [expr {$small > 0 ? double($large) / $small : "none"}]
    }
    set page [tcd::Page task.string-concatenation]
    list [expr {[dict get $ratios join] <= 5}] [expr {[dict get $ratios fold] <= 5}] [expr {[dict get $ratios concat] <= 5}] \
        [expr {[dict get $ratios append] >= 12}] \
        [string match {*append_char is not extended that way*quadratic*} $page] [string match {*not a guarantee*} $page]
} -cleanup {unset -nocomplain ratios shape small large page} -result {1 1 1 1 1 1}

# ---------------------------------------------------------------------------
# Literal escapes

# The escapes the lexer accepts after a backslash in a literal of KIND
# (string | char): every printable ASCII character tried.
proc tcd::LexedEscapes {kind} {
    set accepted {}
    for {set c 33} {$c < 127} {incr c} {
        set ch [format %c $c]
        set source [expr {$kind eq "string" ? "x = \"\\$ch\"\n" : "x = '\\$ch'\n"}]
        set result [surface::lexer::tokenize $source tcd.bot]
        set invalid 0
        foreach d [dict get $result diagnostics] {
            if {[string match {*invalid escape*} $d]} { set invalid 1 }
        }
        if {!$invalid} { lappend accepted "\\$ch" }
    }
    return [lsort $accepted]
}

# The escapes concept.strings documents for literals of KIND, read from its
# LITERALS AND ESCAPES table: the backslash words of the row that names the
# literal kind.
proc tcd::DocumentedEscapes {kind} {
    set row [expr {$kind eq "string" ? {in a String literal} : {in a character literal}}]
    foreach entry [dict get [compilerpedia::topic concept.strings] body] {
        lassign $entry section items
        if {$section ne "LITERALS AND ESCAPES"} continue
        foreach item $items {
            lassign $item what line
            if {$what eq "text" && [string first $row [string trim $line]] == 0} {
                return [lsort [lmap word [regexp -all -inline {\S+} $line] {
                    if {[string index $word 0] ne "\\"} continue
                    set word
                }]]
            }
        }
    }
    return {}
}

test tcd-doc-escapes-complete {concept.strings documents exactly the escapes the lexer accepts, for String literals (\\ \" \n \r \t) and character literals (\\ \' \n \r \t), no more and no fewer} -body {
    list [tcd::LexedEscapes string] [expr {[tcd::DocumentedEscapes string] eq [tcd::LexedEscapes string]}] \
        [tcd::LexedEscapes char] [expr {[tcd::DocumentedEscapes char] eq [tcd::LexedEscapes char]}]
} -result {{{\"} {\\} {\n} {\r} {\t}} 1 {{\'} {\\} {\n} {\r} {\t}} 1}

test tcd-doc-no-numeric-escape {there is no numeric escape: \u, \x, \e and \0 are rejected in both kinds of literal, and concept.strings says so and documents none of them as valid; an invalid escape's help line leads to that page} -body {
    set rejected {}
    foreach e {u x e 0} {
        foreach source [list "x = \"\\$e\"\n" "x = '\\$e'\n"] {
            set diags [dict get [surface::lexer::tokenize $source tcd.bot] diagnostics]
            lappend rejected [expr {[string match {*invalid escape*} $diags]}]
        }
    }
    set page [tcd::Page concept.strings]
    set documented [concat [tcd::DocumentedEscapes string] [tcd::DocumentedEscapes char]]
    list [lsort -unique $rejected] [string match {*there is no numeric escape*} $page] \
        [lmap e {\\u \\x \\e \\0} {expr {$e in $documented}}] \
        [compilerpedia::topicForDiagnostic {SURFACE SYNTAX} {invalid escape "\u" in string}] \
        [compilerpedia::topicForDiagnostic {SURFACE SYNTAX} {invalid escape "\x" in character literal}]
} -cleanup {unset -nocomplain rejected e source diags page documented} -result {1 1 {0 0 0 0} concept.strings concept.strings}

test tcd-doc-literal-kinds {concept.strings distinguishes the two literals (a character literal is a UnicodeChar, not a one-character String) and names the one-character String literal warning; raw control characters are accepted, as the page says, and no constructor makes a character from a number, as std::char's page says} -body {
    set page [tcd::Page concept.strings]
    set char [tcd::Page stdlib.module.std::char]
    set raw [sourceAgree "import std::str\n\[\"\x1b\[1m\".length(), std::str::length(\"\x01\")\]\n" [tcd::Backends]]
    set members [lmap name [core::native::names] {if {[string match std::char::* $name]} {set name} else {continue}}]
    list [string match {*neither an Int nor a one-character String*} $page] [string match {*ONE-CHAR-STRING-LITERAL*} $page] \
        [string match {*accepted*} $page] $raw [string match {*no conversion from an Int to a UnicodeChar*} $char] \
        [lsort $members]
} -cleanup {unset -nocomplain page char raw members} -result {1 1 1 {value {[4, 1]}} 1 {std::char::is_tcl_alnum std::char::is_tcl_alpha std::char::scalar_value}}

# ---------------------------------------------------------------------------
# List typing: README §19 is history, the current rule is stated

test tcd-doc-readme-list-history {README §19's "Lists carry no element type" is marked as the state of that milestone, and the current List[E] typing is stated beside it; the compiler indeed gives std::list::at the element type} -body {
    set readme [regsub -all {\s+} [tcd::Read docs/README.md] " "]
    regexp {## 19\. (.*?)## 20\. } $readme -> section
    set report [tcd::Report "import std::list\n\nfn t(s: str) -> str:\n    s\n\nt(\[1, 2\].at(0))\n"]
    list [string match {*Lists carry no element type*} $section] [string match {*`std::list::at` returns `any`*} $section] \
        [string match {*Lists carried no element type*} $section] [string match {*Since then.*List\[E\]*} $section] \
        [regexp {\(argument type: (\S+)\)} [lindex $report 0 2] -> type] $type
} -cleanup {unset -nocomplain readme section report type} -result {0 0 1 1 1 int}

test tcd-doc-list-element-types {concept.lists states that element types are kept (at, loops) and held exactly at a declared List type, as the compiler does} -body {
    set page [tcd::Page concept.lists]
    list [string match {*element types are inferred and kept*} [string tolower $page]] \
        [string match {*List\[std::byte::Byte\] is not admissible for List\[int\]*} $page]
} -cleanup {unset -nocomplain page} -result {1 1}

# ---------------------------------------------------------------------------
# Discovery

test tcd-doc-discovery {the help finds the corrected pages by the words a developer uses: UTF-8 encoding and decoding, string concatenation and joining, escapes and control characters, List element types and lengths, and a character from an Int (whose page says it does not exist)} -body {
    lmap query {{encode utf8} {decode utf8} {string concatenation} {join strings} {build string} {character escapes}
            {control character} {invalid escape} {list element type} {list length} {char from int} {int to char}} {
        list $query [tcd::Found $query]
    }
} -result {{{encode utf8} {page stdlib.std::str::encode_utf8}} {{decode utf8} {page stdlib.std::abi::bytes::decode_utf8}} {{string concatenation} {page task.string-concatenation}} {{join strings} {page task.string-concatenation}} {{build string} {page task.string-concatenation}} {{character escapes} {page concept.strings}} {{control character} {page concept.strings}} {{invalid escape} {page concept.strings}} {{list element type} {page concept.lists}} {{list length} {page concept.list-length}} {{char from int} {page stdlib.module.std::char}} {{int to char} {page stdlib.module.std::char}}}

cleanupTests
