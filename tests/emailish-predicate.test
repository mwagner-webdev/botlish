# emailish-predicate.test -- web::emailish?, the source-defined proof-producing
# predicate of the source-defined refinement web::Emailish (lib/web.bot,
# REFINEMENT-VALUES.md):
#
#   refined type Emailish = str
#   fn emailish?(v: str) -> bool proves v: Emailish:
#
# History: the predicate was a Tcl-registered native type test of a
# Tcl-registered named type (lib/web.tcl), first with a per-call-site
# -native-body, then (R2, R2-ORDINARY-EMAILISH-PREDICATE.md) bridged to this
# same Botlish function through -module-fn, with an Emailish? compatibility
# alias. Its redundant re-check was folded because the compiler knew the
# native was a complete recognizer of a registered type. All of that is
# gone: the type and its proof are ordinary declarations, and the re-check
# is decided by generic exact predicate-result facts plus the compiler's
# repeatability proof (hir/repeatable.tcl). This file pins the predicate's
# behavior (the valid/invalid corpus NATIVE-TCL-UNICODE.md and
# NATIVE-EMAILISH.md established), its proof, and the redundant check's
# disappearance; refinement-values.test covers the language feature itself.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]

proc emailishCall {address} {
    return "import web\nweb::emailish?([Quote $address])\n"
}

# ADDRESS as a Botlish string literal.
proc Quote {text} {
    return "\"[string map {\\ \\\\ \" \\\" \n \\n} $text]\""
}

# ---------------------------------------------------------------------------
# The valid/invalid corpus, on every backend: ordinary ASCII, an accepted
# non-ASCII address, no "@", an invalid local part, an invalid domain label,
# an invalid/too-short TLD, and boundary/empty cases.

foreach {label address expect} {
    ascii-valid                    someone@example.com          true
    unicode-valid                  café@例え.テスト                true
    no-at                          not-an-email                 false
    empty-local-part               @example.com                 false
    invalid-local-char             {"a b"@example.com}           false
    invalid-domain-label           foo@bad_domain.com            false
    tld-too-short                  foo@example.c                 false
    empty-string                   ""                            false
    at-only                        @                             false
} {
    test emailish-predicate-parity-$label "web::emailish? on \"$address\" is $expect, on every backend" -body {
        sourceAgree [emailishCall $address]
    } -result [list value $expect]
}

# ---------------------------------------------------------------------------
# The proof: a true result refines the argument to web::Emailish in the true
# branch only; the predicate is still an ordinary bool function.

test emailish-predicate-refines {a successful web::emailish?(s) call refines s to Emailish in the true branch only} -body {
    set hir [surface::compile {import web

fn f(s: str):
    if web::emailish?(s):
        s
    else:
        s
} -warnings off]
    lrange [hirRefTypes $hir s] end-2 end
} -result {str {str[web::Emailish]} str}

test emailish-predicate-ordinary-bool {the predicate's result is an ordinary bool value} -body {
    sourceAgree {import web

x = web::emailish?("a@b.io")
[x, not x]
}
} -result {value {[true, false]}}

test emailish-predicate-signature {the HIR shows the proof contract on the function itself} -body {
    set hir [surface::compile "import web\nweb::emailish?(\"a@b.io\")\n" -warnings off]
    regexp -inline {block s[0-9]+ \(b[0-9]+ v:str\)[^\n]* declares bool proves b[0-9]+ v: str\[web::Emailish\]} [hir::format $hir]
} -match glob -result {*proves b* v: str\[web::Emailish\]*}

# ---------------------------------------------------------------------------
# The redundant second check disappears through generic machinery: an exact
# predicate-result fact (the same function on the same value returned true
# on this path) and the function's repeatability -- never the predicate's
# name, never the refinement fact alone. Pinned at the HIR level (`known`)
# and in NIR (one call of the shared validator, not two).

set redundant {import web

fn f(s: str) -> str:
    if web::emailish?(s):
        if web::emailish?(s):
            "yes"
        else:
            "no"
    else:
        "no"

[f("someone@example.com"), f("nope")]
}

test emailish-predicate-repeatable {web::emailish? is proven repeatable} -body {
    set hir [surface::compile $redundant -warnings off]
    set block [hir::get $hir [lindex [hirFind $hir ref web::emailish?] 0] binding]
    set value [hir::get $hir [dict get [hir::binding $hir $block] declaredBy] value]
    hir::repeatable::explain $hir $value
} -result {}

test emailish-predicate-redundant-check-known-hir {a redundant re-check inside its own true branch is HIR-known true, not dynamic} -body {
    set hir [surface::compile $redundant -warnings off]
    set calls [lmap e [hirFind $hir call] {
        if {[hir::kind $hir [hir::get $hir $e callee]] ne "ref"
                || [hir::get $hir [hir::get $hir $e callee] name] ne "web::emailish?"} continue
        hir::get $hir $e known
    }]
    set calls
} -result {{} 1}

test emailish-predicate-redundant-check-nir-shape {the redundant check compiles to exactly one call to the shared validator on cranelift, not two} -body {
    set hir [surface::compile $redundant -warnings off]
    set text [native::nir $hir]
    regexp {func (\d+) "web::emailish\?"} $text -> isEmailishId
    list [regexp -all {func \d+ "web::emailish\?"} $text] \
         [regexp -all "= call(?:env)? $isEmailishId %" $text] \
         [sourceAgree $redundant]
} -result {1 1 {value {["yes", "no"]}}}

# ---------------------------------------------------------------------------
# Instance structure of the motivating corpus program (bench/refined-
# checks.bot): no anonymous callee-position instance, one instance per
# scanner helper (scan_while one per exact predicate target, plus entries
# only dormant callers reach), and check keeps its Int-keyed instance.

proc refinedChecksHir {} {
    return [surface::readProgramFile [file join $::projectRoot bench refined-checks.bot] -warnings off]
}

test emailish-predicate-no-anonymous-callee-instance {no anonymous (unnamed) callee-position block instance exists for web::emailish?} -body {
    set hir [refinedChecksHir]
    set spec [hir::specialize::analyze $hir]
    set anonymous 0
    dict for {id instance} [dict get $spec instances] {
        if {$id ni [dict get $spec used]} continue
        if {[dict get $instance name] eq ""} {
            incr anonymous
        }
    }
    set anonymous
} -result 0

test emailish-predicate-check-scanner-instance-count {every scanner helper (and web::emailish? itself) is one emitted instance plus, for the Int-keyed closures, the never-entered generic entry} -body {
    set hir [refinedChecksHir]
    set spec [hir::specialize::analyze $hir]
    set counts [dict create]
    dict for {id instance} [dict get $spec instances] {
        if {$id ni [dict get $spec used]} continue
        set name [dict get $instance name]
        if {$name in {web::emailish? char_at scan_while local_char? label_char? tld? domain?}} {
            dict incr counts $name
        }
    }
    lmap name [lsort [dict keys $counts]] {list $name [dict get $counts $name]}
} -result {{char_at 2} {domain? 2} {label_char? 1} {local_char? 2} {scan_while 4} {tld? 2} {web::emailish? 1}}

test emailish-predicate-check-n-control {check's own n parameter range is [0,400]: check is check<int, int, str, str>} -body {
    set hir [refinedChecksHir]
    set spec [hir::specialize::analyze $hir]
    set analysis [hir::range::analyze $hir $spec]
    set id ""
    dict for {candidate instance} [dict get $spec instances] {
        if {$candidate in [dict get $spec used] && [dict get $instance name] eq "check"} {
            set id $candidate
        }
    }
    list [hir::specialize::label $spec $id] \
        [lindex [lmap p [dict get [dict get $analysis instances $id] params] {hir::range::show $p}] 0]
} -result [list check<int,\ int,\ str,\ str> "\[0, 400\]"]

# ---------------------------------------------------------------------------
# Module-retained values (formerly pinned through the -module-fn bridge,
# module-fn-bridge-reachability.test, deleted with the bridge): emailish?'s
# module-retained local_extra_chars is built once at module initialization,
# never per call, and a user-defined block calling the predicate behaves the
# same on every backend.

test emailish-predicate-set-retained-once {refined-checks.bot: local_extra_chars' List and ImmutableSet are each constructed exactly once (module init), none per emailish? call} -body {
    set hir [refinedChecksHir]
    set webPath [file normalize [file join $::projectRoot lib web.bot]]
    set line [lsearch -regexp [split [core::ReadFile $webPath] \n] {^local_extra_chars = }]
    incr line
    set sites {}
    foreach site [dict get [native::allocationReport $hir sites] sites] {
        set loc [dict get $site location]
        if {[dict exists $loc file] && [file normalize [dict get $loc file]] eq $webPath
                && [dict get $loc line] == $line} {
            lappend sites [list [dict get $site operation] [dict get $site allocations]]
        }
    }
    set text [native::nir $hir]
    set body [lindex [regexp -inline {func \d+ "web::emailish\?"[^\n]*\n(.*?)\nend} $text] 1]
    list [lsort $sites] [regexp -all {op setfromlist} $body] [regexp -all {op listnew} $body]
} -result {{{listnew 1} {setfromlisttotal 1}} 0 0}

test emailish-predicate-user-block {a user-defined block calling web::emailish?, refining and re-checking, on every backend} -body {
    sourceAgree {import web

fn check(s: str):
    if web::emailish?(s):
        if s.emailish?():
            s
        else:
            "no"
    else:
        "no"

[check("someone@example.com"), check("not-an-email"), check("café@例え.テスト")]
}
} -result {value {["someone@example.com", "no", "café@例え.テスト"]}}

::tcltest::cleanupTests
