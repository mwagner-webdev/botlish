    list [string first "fail " $data] [string first "if " $data] [string first "x <" $data]
} -result {-1 -1 -1}

test sf-message-text {one template: names the failure and states the count} -body {
    lmap w [failuresOf [compileWith $::groupSource]] {dict get $w message}
} -result {{failure `Invalid` is raised from 3 distinct exits}}

test sf-message-is-not-prescriptive {no imperative, no rewrite, no suggestion to merge or split} -body {
    set hir [compileWith $::groupSource]
    set text [join [lmap w [failuresOf $hir] {hir::warnings::render $hir $w}] \n]
    set found {}
    foreach word {merge combine split richer should consider use instead "or " " and " rewrite distinct- "->" "fail "} {
        if {[string first $word $text] >= 0} {
            lappend found $word
        }
    }
    set found
} -result {}

test sf-notes-one-per-secondary {each secondary exit is one note line with the note text} -body {
    set hir [compileWith $::groupSource]
    set lines [split [hir::warnings::render $hir [lindex [failuresOf $hir] 0]] \n]
    list [llength $lines] [lmap line [lrange $lines 1 end] {regsub {^t\.bot:[0-9]+:[0-9]+: } $line {}}]
} -result {3 {{note: also raised here} {note: also raised here}}}

test sf-anchor-first-in-source-order {the primary is the group's first exit in source order (a loop's fail before a later guard)} -body {
    failures {error E
fn f(xs, n) errors E:
    if n == 0:
