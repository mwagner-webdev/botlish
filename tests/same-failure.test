v}

test sf-hir-identical-across-modes {HIR (minus the side table), hir::format and hir::lower are identical under off and default} -body {
    set off [compileWith $::runSource off]
    set on [compileWith $::runSource default]
    list [llength [failuresOf $on]] [expr {$off eq [dict remove $on warnings]}] [expr {[hir::format $off] eq [hir::format $on]}] \
        [expr {[hir::lower $off] eq [hir::lower $on]}] [dict exists $off warnings]
} -result {1 1 1 1 0}

test sf-no-new-hir-state {nothing new is recorded on HIR: default adds only the warnings side table; every node has the fields it has under off} -body {
    set off [compileWith $::runSource off]
    set on [compileWith $::runSource default]
    set added [lmap key [dict keys $on] {if {[dict exists $off $key]} continue; set key}]
    set changed 0
    dict for {e node} [dict get $on exprs] {
        if {[lsort [dict keys $node]] ne [lsort [dict keys [dict get $off exprs $e]]]} {
            incr changed
        }
    }
    list $added $changed [expr {[dict get $on bindings] eq [dict get $off bindings]}] \
        [expr {[dict get $on scopes] eq [dict get $off scopes]}]
} -result {warnings 0 1 1}

test sf-nir-identical-across-modes {native IR (specialized and generic) is identical with warnings off and on} -body {
    set off [compileWith $::runSource off]
    set on [compileWith $::runSource default]
    list [expr {[native::nir $off] eq [native::nir $on]}] [expr {[native::nir $off -specialize 0] eq [native::nir $on -specialize 0]}]
} -result {1 1}

test sf-machine-readable-outputs-clean {native::report, NIR and CLIF are identical with and without the warnings side table} -body {
    set on [compileWith $::runSource default]
    set bare [dict remove $on warnings]
    expr {[llength [failuresOf $on]] == 1 && [native::report $on] eq [native::report $bare]
        && [native::nir $on] eq [native::nir $bare] && [native::clif $on] eq [native::clif $bare]}
} -result 1

test sf-no-warning-text-in-machine-readable-outputs {neither NIR, CLIF, the report nor HIR text mention the warning} -body {
    set hir [compileWith $::runSource default]
    set seen 0
    foreach text [list [native::nir $hir] [native::clif $hir] [native::report $hir] [hir::format $hir]] {
        foreach word {SAME-FAILURE warning "raised from" "distinct exits"} {
            if {[string first $word $text] >= 0} {
                incr seen
            }
        }
    }
    set seen
} -result 0

