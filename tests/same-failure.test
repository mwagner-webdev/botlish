        fail E
    if x == 2:
        fail E
    x
fn f(x) errors E:
    if x == 3:
        fail E
    if x == 4:
        fail E
    x}] {lindex $w 0}
} -result {4:9 10:9}

test sf-deterministic {compiling the same source twice gives identical warnings} -body {
    expr {[hir::warnings::of [compileWith $::groupSource]] eq [hir::warnings::of [compileWith $::groupSource]]}
} -result 1

test sf-generic-hir-once-instances-never-walked {a function analyzed as several semantic instances is one warning} -body {
    set hir [compileWith {error E
fn f(x, y) errors E:
    if x == y:
        fail E
