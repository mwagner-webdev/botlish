# Declared failures only (item 8)

test sf-strict0-unadmitted-fail-never-warned {-strict 0: fails the function does not declare keep an UNHANDLED-ERROR diagnostic; the program is never warned about} -body {
    set hir [surface::compile {error E
fn f(x):
    if x == 1:
        fail E
    if x == 2:
        fail E
    x} t.bot -strict 0 -warnings default -warning-channel ""]
    list [lsort -unique [lmap d [hir::diagnostics $hir] {dict get $d kind}]] [hir::warnings::of $hir]
} -result {UNHANDLED-ERROR {}}

test sf-strict0-undeclared-error-never-warned {-strict 0: fails of an undeclared error keep an UNDECLARED-ERROR diagnostic; never warned} -body {
    set hir [surface::compile {fn f(x) errors Nope:
    if x == 1:
        fail Nope
    if x == 2:
        fail Nope
    x} t.bot -strict 0 -warnings default -warning-channel ""]
    list [lsort -unique [lmap d [hir::diagnostics $hir] {dict get $d kind}]] [hir::warnings::of $hir]
} -result {UNDECLARED-ERROR {}}

test sf-hir-text-input-warns {identity is the name, which HIR text keeps: the parsed HIR has the same group (no provenance needed)} -body {
    set hir [compileWith {error E
fn f(x) errors E:
    if x == 1:
        fail E
    if x == 2:
        fail E
    x} off]
    set parsed [hir::parse [hir::format $hir]]
    lmap w [hir::warnings::collect $parsed] {list [dict get $w code] [dict get $w data failure] [dict get $w data exits]}
} -result {{SAME-FAILURE E 2}}

test sf-unresolved-site-silent {a fail whose name is not one of the function's resolved declared failures (hand-written HIR text, which hir::parse admits) is silent} -body {
    set hir [compileWith {error E
fn f(x) errors E:
    if x == 1:
        fail E
    if x == 2:
        fail E
    x} off]
    set text [hir::format $hir]
    set edited [hir::parse [string map {" errors E :" " :"} $text]]
    list [string match "* errors E :*" $text] [hir::diagnostics $edited] \
        [dict get $edited exprs e2 declaredErrors] [hir::warnings::collect $edited]
} -result {1 {} {} {}}

# ---------------------------------------------------------------------------
# Payload (item 7): `fail` carries no payload, so identity is the name

test sf-fail-carries-no-payload {the grammar is `fail NAME`: a payload is a syntax error, and the HIR fail node has no value child} -body {
    set hir [compileWith {error E
fn f(x) errors E:
    if x == 1:
        fail E
    x} off]
    set fails [lmap {e node} [dict get $hir exprs] {
        if {[dict get $node kind] ne "fail"} continue
        list [dict exists $node value] [hir::children $hir $e] [dict get $node name]
    }]
    list [lrange [lindex [rejection {error E
fn f(x) errors E:
    fail E(x)} default] 0] 0 1] [lrange [lindex [rejection {error E
fn f(x) errors E:
    fail E x} default] 0] 0 1] $fails
} -result {{SURFACE SYNTAX} {SURFACE SYNTAX} {{0 {} E}}}

test sf-identity-is-the-name {the record's failure is the declared name; failureName is the same name} -body {
    set w [lindex [failuresOf [compileWith {error Invalid
fn f(x) errors Invalid:
    if x == 1:
        fail Invalid
    if x == 2:
        fail Invalid
    x}]] 0]
    list [dict get $w data failure] [dict get $w data failureName]
} -result {Invalid Invalid}

