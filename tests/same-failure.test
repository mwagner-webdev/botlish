        fail Invalid
    if x > 9:
        fail Invalid
    if x == 5:
        fail Invalid
    x}

test sf-record-shape {the record is {code message primary secondary data}} -body {
    lsort [dict keys [lindex [failuresOf [compileWith $::groupSource]] 0]]
} -result {code data message primary secondary}

test sf-record-data-fields {data: function (block ExprId), functionName, failure, failureName, exits, sites (fail ExprIds in source order), note} -body {
    set hir [compileWith $::groupSource]
    set w [lindex [failuresOf $hir] 0]
    set data [dict get $w data]
    list [lsort [dict keys $data]] [dict get $hir exprs [dict get $data function] kind] \
        [dict get $data functionName] [dict get $data exits] \
        [lmap e [dict get $data sites] {list [dict get $hir exprs $e kind] [dict get $hir exprs $e name] [loc $hir [dict get $hir exprs $e origin]]}] \
        [dict get $data note] \
        [expr {[lmap e [dict get $data sites] {dict get $hir exprs $e origin}] eq [list [dict get $w primary] {*}[dict get $w secondary]]}]
} -result {{exits failure failureName function functionName note sites} block parse 3 {{fail Invalid 4:9} {fail Invalid 6:9} {fail Invalid 8:9}} {also raised here} 1}

test sf-no-rendered-source-in-data {data carries identities and counts, never source text} -body {
