# same-failure.test -- the SAME-FAILURE compiler warning
# (WARNINGS-SAME-FAILURE.md) on the warning framework WARNINGS-SAME-RETURN.md
# built (hir/warnings.tcl).
#
# The theorem: a failure group is reported exactly when two or more distinct,
# reachable exits of one function `fail` the same declared failure -- the same
# failure as the compiler resolves it, never the same text. One warning per
# group, anchored at the group's first exit, the others as notes.
#
# Exits here are exactly the written `fail` operations whose target is the
# function: the mirror image of SAME-RETURN-VALUE's exits. A final expression,
# a fall-through, a return and a call that fails (propagation) are never
# exits of this warning, and a nested function's fails are its own.
#
# Like the other warning test files, every compile here passes its policy and
# channel explicitly (`-warnings MODE`, `-warning-channel ""` to collect
# without printing), so this file exercises default, off and error whatever
# the harness's process default is.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]

testConstraint executableAot [expr {$::tcl_platform(os) eq "Linux" &&
    $::tcl_platform(machine) in {x86_64 amd64}}]

set ::allBackends {interp compile cranelift-generic cranelift}
set ::sfCode SAME-FAILURE

# The HIR of SOURCE under policy MODE (default off error), collecting
# warnings without printing them.
proc compileWith {source {mode default}} {
    return [surface::compile $source t.bot -warnings $mode -warning-channel ""]
}

# "LINE:COL" of ORIGIN in HIR, without the file name when it is t.bot.
proc loc {hir origin} {
    return [regsub {^t\.bot:} [hir::originLocation $hir $origin] {}]
}

# The SAME-FAILURE warnings of HIR.
proc failuresOf {hir} {
    return [lmap w [hir::warnings::of $hir] {
        if {[dict get $w code] ne $::sfCode} continue
        set w
    }]
}

# Each SAME-FAILURE warning of SOURCE as {PRIMARY FAILURE EXITS {SECONDARY...}},
# locations as LINE:COL.
proc failures {source} {
    set hir [compileWith $source]
    return [lmap w [failuresOf $hir] {
        list [loc $hir [dict get $w primary]] [dict get $w data failure] [dict get $w data exits] \
            [lmap o [dict get $w secondary] {loc $hir $o}]
    }]
}

# "MESSAGE @ PRIMARY SECONDARY..." for each SAME-FAILURE warning of SOURCE.
proc shown {source} {
    set hir [compileWith $source]
    return [lmap w [failuresOf $hir] {
        string cat [dict get $w message] " @ " \
            [join [lmap o [list [dict get $w primary] {*}[dict get $w secondary]] {loc $hir $o}] { }]
    }]
}

# 1 if SOURCE compiles with no SAME-FAILURE warning.
proc silent {source} {
    return [expr {[failuresOf [compileWith $source]] eq ""}]
}

# Every warning of SOURCE (all codes) as {CODE PRIMARY}.
proc allWarnings {source} {
    set hir [compileWith $source]
    return [lmap w [hir::warnings::of $hir] {list [dict get $w code] [loc $hir [dict get $w primary]]}]
}

# The rejection of SOURCE under MODE: {errorcode message}, or "compiled".
proc rejection {source mode} {
    if {[catch {compileWith $source $mode} message options]} {
        return [list [dict get $options -errorcode] $message]
    }
    return compiled
}

# Runs SCRIPT with module files FILES ({NAME TEXT ...}) in a private library
# directory (a per-process name in the tcltest temporary directory).
proc withModules {files script} {
    set saved $::core::libraryDir
    set dir [makeDirectory sf-scratch-[pid]]
    set ::core::libraryDir $dir
    try {
        foreach {name text} $files {
            set channel [open [file join $dir $name] w]
            puts -nonewline $channel $text
            close $channel
        }
        uplevel 1 $script
    } finally {
        set ::core::libraryDir $saved
        removeDirectory sf-scratch-[pid]
    }
}

# The names of the functions whose blocks hir::completions::reachedExprs is
# asked about while SCRIPT runs (the pass's candidate-gated walk).
proc walkedFunctions {hir script} {
    set ::walked {}
    set names [hir::warnings::BlockNames $hir]
    trace add execution hir::completions::reachedExprs enter {apply {{command op} {lappend ::walked [lindex $command 2]}}}
    try {
        uplevel 1 $script
    } finally {
        trace remove execution hir::completions::reachedExprs enter {apply {{command op} {lappend ::walked [lindex $command 2]}}}
    }
    return [lmap e $::walked {dict get $names $e}]
}

# ---------------------------------------------------------------------------
# Groups (items 3, 11): one warning per declared failure raised from N >= 2
# distinct, reachable exits

test sf-parse-record-rendered {the motivating guard pair: one warning at the first exit, one note, rendered exactly} -body {
    set source {error Invalid
fn parse_record(text, pos) errors Invalid:
    if text == "":
        fail Invalid
    if pos == 3:
        fail Invalid
    pos + 1}
    set hir [compileWith $source]
    lmap w [failuresOf $hir] {hir::warnings::render $hir $w}
} -result {{t.bot:4:9: warning: failure `Invalid` is raised from 2 distinct exits (SAME-FAILURE)
t.bot:6:9: note: also raised here}}

test sf-two-exits {two fails of one declared failure: one warning} -body {
    failures {error E
fn f(x) errors E:
    if x < 0:
        fail E
    if x > 9:
        fail E
    x}
} -result {{4:9 E 2 6:9}}

test sf-three-exits {three fails of one declared failure: one warning, two notes} -body {
    failures {error E
fn f(x) errors E:
    if x < 0:
        fail E
    if x > 9:
        fail E
    if x == 5:
        fail E
    x}
} -result {{4:9 E 3 {6:9 8:9}}}

test sf-one-diagnostic-per-group-never-pairwise {four fails of one failure are one diagnostic with three notes, not six pairs} -body {
    set hir [compileWith {error E
fn f(x) errors E:
    if x == 1:
        fail E
    if x == 2:
        fail E
    if x == 3:
        fail E
    if x == 4:
        fail E
    x}]
    list [llength [hir::warnings::of $hir]] [dict get [lindex [failuresOf $hir] 0] data exits] \
        [llength [dict get [lindex [failuresOf $hir] 0] secondary]]
} -result {1 4 3}

test sf-a-a-b-b-c {A A B B C: two warnings (A and B), correct anchors, C silent} -body {
    failures {error A
error B
error C
fn f(x) errors A, B, C:
    if x == 1:
        fail A
    if x == 2:
        fail B
    if x == 3:
        fail A
    if x == 4:
        fail B
    if x == 5:
        fail C
    x}
} -result {{6:9 A 2 10:9} {8:9 B 2 12:9}}

test sf-two-groups-are-two-diagnostics {A twice and B three times in one function: two warnings, each its own count} -body {
    shown {error A
error B
fn f(x) errors A, B:
    if x == 1:
        fail B
    if x == 2:
        fail A
    if x == 3:
        fail B
    if x == 4:
        fail A
    if x == 5:
        fail B
    x}
} -result {{failure `B` is raised from 3 distinct exits @ 5:9 9:9 13:9} {failure `A` is raised from 2 distinct exits @ 7:9 11:9}}

test sf-single-fail-silent {a single exit never warns} -body {
    silent {error E
fn f(x) errors E:
    if x < 0:
        fail E
    x}
} -result 1

test sf-different-declared-failures-never-group {two different declared failures, once each: silent} -body {
    silent {error BelowRange
error AboveRange
fn from_int(value) errors BelowRange, AboveRange:
    if value < 0:
        fail BelowRange
    if value > 255:
        fail AboveRange
    value}
} -result 1

test sf-similar-names-never-group {A, A2, a and AError are four failures: once each is silent; only a real repeat groups, alone} -body {
    set decls {error A
error A2
error a
error AError
}
    list [silent "${decls}fn f(x) errors A, A2, a, AError:
    if x == 1:
        fail A
    if x == 2:
        fail A2
    if x == 3:
        fail a
    if x == 4:
        fail AError
    x"] [failures "${decls}fn f(x) errors A, A2, a, AError:
    if x == 1:
        fail A
    if x == 2:
        fail A2
    if x == 3:
        fail A
    if x == 4:
        fail AError
    x"]
} -result {1 {{7:9 A 2 11:9}}}

test sf-one-name-is-one-declaration-program-wide {two declarations of one name (two modules, a module and the program, a builtin) are rejected: identical text never names two failures} -body {
    withModules {m.bot {error Invalid
fn g(x):
    x
} n.bot {error Invalid
fn h(x):
    x
}} {
        list [lindex [rejection "import m\nimport n\nn::h(1)" default] 0] \
            [lindex [rejection "import m\nerror Invalid\nm::g(1)" default] 0] \
            [lindex [rejection "error IndexNotFound\n1" default] 0]
    }
} -result {{CORE SEMANTIC UNDECLARED-ERROR} {CORE SEMANTIC UNDECLARED-ERROR} {CORE SEMANTIC UNDECLARED-ERROR}}

test sf-module-failure-is-the-same-failure {a fail of a module's declared error and the program's own fail of it are one identity: the name the resolver admits} -body {
    withModules {m.bot {error Invalid
fn g(x) errors Invalid:
    if x == 0:
        fail Invalid
    x
}} {
        failures {import m
fn f(x) errors Invalid:
    if x < 0:
        fail Invalid
    if x > 9:
        fail Invalid
    m::g(x)}
    }
} -result {{4:9 Invalid 2 6:9}}

test sf-builtin-error-groups {a builtin error of the runtime (IndexNotFound) is a declared failure like any other} -body {
    failures {fn f(x) errors IndexNotFound:
    if x < 0:
        fail IndexNotFound
    if x > 9:
        fail IndexNotFound
    x}
} -result {{3:9 IndexNotFound 2 5:9}}

test sf-never-across-functions {one failure, once in each of two functions: never grouped across functions} -body {
    silent {error E
fn f(x) errors E:
    if x < 0:
        fail E
    x
fn g(x) errors E:
    if x > 9:
        fail E
    x}
} -result 1

# ---------------------------------------------------------------------------
# Kind separation (item 4): the mirror-image exits table

test sf-returns-never-grouped-with-fails {repeated returns and one fail: SAME-RETURN-VALUE only; the returns are not failure exits} -body {
    allWarnings {error E
fn f(x) errors E:
    if x == 1:
        return 0
    if x == 2:
        fail E
    if x == 3:
        return 0
    x}
} -result {{SAME-RETURN-VALUE 4:9}}

test sf-fails-never-grouped-with-returns {the milestone-1 pin, now in both directions: two fails beside returns are a group of exactly the two fails, and no return value groups} -body {
    set hir [compileWith {error Bad
fn f(x) -> int errors Bad:
    if x < 0:
        fail Bad
    if x > 9:
        fail Bad
    if x == 5:
        return 0
    1}]
    lmap w [hir::warnings::of $hir] {list [dict get $w code] [dict get $w data exits] [loc $hir [dict get $w primary]]}
} -result {{SAME-FAILURE 2 4:9}}

test sf-repeated-returns-and-fails-two-warnings {repeated returns and repeated fails in one function: two independent diagnostics} -body {
    allWarnings {error E
fn f(x) errors E:
    if x == 1:
        return 0
    if x == 2:
        fail E
    if x == 3:
        return 0
    if x == 4:
        fail E
    0}
} -result {{SAME-RETURN-VALUE 4:9} {SAME-FAILURE 6:9}}

test sf-final-expression-is-not-an-exit {the final expression and a fall-through are normal completions, never failure exits} -body {
    list [silent {error E
fn f(x) errors E:
    if x == 1:
        fail E
    if x == 2:
        return 0
    0}] [silent {error E
fn f(x) errors E:
    if x == 1:
        fail E
    if x == 2:
        0}]
} -result {1 1}

test sf-fails-and-falls-through {a function that fails and falls through: the fall-through contributes nothing, the fails count} -body {
    failures {error E
fn f(x) errors E:
    if x == 1:
        fail E
    if x == 2:
        fail E}
} -result {{4:9 E 2 6:9}}

test sf-propagated-failure-is-not-an-exit {two calls of a failing function propagate its failure: ordinary calls, silent} -body {
    silent {error E
fn g(x) errors E:
    if x == 1:
        fail E
    x
fn f(x) errors E:
    if x == 2:
        return g(x)
    g(x + 1)}
} -result 1

test sf-propagated-beside-one-fail-silent {one fail and a propagating call of the same failure: one exit, silent} -body {
    silent {error E
fn g(x) errors E:
    if x == 1:
        fail E
    x
fn f(x) errors E:
    if x == 2:
        fail E
    g(x)}
} -result 1

test sf-body-ending-in-bare-failing-call-silent {a body that ends in a bare failing call: the call is no exit} -body {
    silent {error E
fn g(x) errors E:
    if x == 1:
        fail E
    x
fn f(x) errors E:
    g(x)
    g(x + 1)}
} -result 1

test sf-handled-call-is-not-an-exit {a handled call absorbs its callee's failure; only written fails count} -body {
    silent {error E
fn g(x) errors E:
    if x == 1:
        fail E
    x
fn f(x) errors E:
    y = g(x):
        on E:
            0
    if y == 3:
        fail E
    y}
} -result 1

# ---------------------------------------------------------------------------
# Where fails live (item 5)

test sf-if-else-branches {fail in both branches of a written if/else} -body {
    failures {error E
fn f(x) errors E:
    if x < 0:
        fail E
    else:
        fail E}
} -result {{4:9 E 2 6:9}}

test sf-elif-is-a-nested-if {elif branches are nested ifs: each fail is an exit} -body {
    failures {error E
fn f(x) errors E:
    if x < 0:
        fail E
    elif x > 9:
        fail E
    elif x == 5:
        fail E
    else:
        x}
} -result {{4:9 E 3 {6:9 8:9}}}

test sf-fail-as-final-statement {fail as the body's final statement counts} -body {
    failures {error E
fn f(x) errors E:
    if x < 0:
        fail E
    fail E}
} -result {{4:9 E 2 5:5}}

test sf-every-loop-form {fail inside every loop form (list, counted, lockstep, unconditional) participates} -body {
    failures {error E
fn f(xs, n) errors E:
    loop x in xs:
        if x == 1:
            fail E
    loop i from 0 to n:
        if i == 3:
            fail E
    loop x in xs and y in xs:
        if x == y:
            fail E
    loop:
        if n == 2:
            fail E
        break
    0}
} -result {{5:13 E 4 {8:13 11:13 14:13}}}

test sf-loop-and-top-level {one fail in a loop and one outside: two exits} -body {
    failures {error E
fn f(xs) errors E:
    loop x in xs:
        if x == 0:
            fail E
    if xs == []:
        fail E
    xs}
} -result {{5:13 E 2 7:9}}

test sf-handler-body {a fail inside an on-handler body is an exit of the enclosing function} -body {
    failures {error A
error E
fn g(x) errors A:
    if x == 1:
        fail A
    x
fn f(x) errors E:
    y = g(x):
        on A:
            fail E
    if y == 3:
        fail E
    y}
} -result {{10:13 E 2 12:9}}

test sf-re-raise-counts {a re-raise (on Invalid: fail Invalid) is a written fail: it counts} -body {
    failures {error Invalid
fn g(x) errors Invalid:
    if x == 1:
        fail Invalid
    x
fn f(x) errors Invalid:
    if x < 0:
        fail Invalid
    y = g(x):
        on Invalid:
            fail Invalid
    y}
} -result {{8:9 Invalid 2 11:13}}

test sf-re-raise-alone-silent {a lone re-raise is one exit: silent} -body {
    silent {error Invalid
fn g(x) errors Invalid:
    if x == 1:
        fail Invalid
    x
fn f(x) errors Invalid:
    y = g(x):
        on Invalid:
            fail Invalid
    y}
} -result 1

test sf-two-handlers-same-failure {two handlers of one call failing one failure: two exits} -body {
    failures {error A
error B
error E
fn g(x) errors A, B:
    if x == 1:
        fail A
    if x == 2:
        fail B
    x
fn f(x) errors E:
    y = g(x):
        on A:
            fail E
        on B:
            fail E
    y}
} -result {{13:13 E 2 15:13}}

test sf-nested-function-owns-its-fails {target confusion: the enclosing function and its nested function fail E once each -- both silent, never one group of 2} -body {
    silent {error E
fn f(x) errors E:
    fn inner(y) errors E:
        if y == 1:
            fail E
        y
    if x == 1:
        fail E
    inner(x)}
} -result 1

test sf-nested-function-warns-on-its-own {a nested function's repeated fail is its own warning; the enclosing function's group counts only its own fails} -body {
    set hir [compileWith {error E
fn f(x) errors E:
    fn inner(y) errors E:
        if y == 1:
            fail E
        if y == 2:
            fail E
        y
    if x == 1:
        fail E
    if x == 2:
        fail E
    inner(x)}]
    lmap w [failuresOf $hir] {list [dict get $w data functionName] [dict get $w data exits] [loc $hir [dict get $w primary]]}
} -result {{inner 2 5:13} {f 2 10:9}}

test sf-closure-owns-its-fails {a closure capturing the enclosing parameter owns its fails} -body {
    set hir [compileWith {error E
fn f(x) errors E:
    fn check(y) errors E:
        if y == x:
            fail E
        if y > x:
            fail E
        y
    if x < 0:
        fail E
    check(x + 1)}]
    lmap w [failuresOf $hir] {list [dict get $w data functionName] [dict get $w data exits]}
} -result {{check 2}}

test sf-nested-function-in-branch-and-loop {nested functions defined in a branch or a loop body still own their fails} -body {
    silent {error E
fn f(xs) errors E:
    if xs == []:
        fn a(y) errors E:
            if y == 1:
                fail E
            y
        return a(1)
    loop x in xs:
        fn b(y) errors E:
            if y == 2:
                fail E
            y
        if b(x) == 3:
            fail E
    0}
} -result 1

test sf-synthesized-boolean-if-never-opened {a guard on `a or b` / `not a and b` is one exit, not one per operand} -body {
    list [silent {error E
fn f(x) errors E:
    if x < 0 or x > 9:
        fail E
    x}] [failures {error E
fn f(x) errors E:
    if x < 0 or x > 9:
        fail E
    if not (x == 5) and x != 4:
        fail E
    x}]
} -result {1 {{4:9 E 2 6:9}}}

# ---------------------------------------------------------------------------
# Reachability (item 9)

test sf-dead-branch-never-counts {a fail under a statically false branch is no exit: with two reachable ones the count is 2, with one it is silent} -body {
    list [failures {error Invalid
fn f(x) errors Invalid:
    if 1 == 2:
        fail Invalid
    if x == 7:
        fail Invalid
    if x == 8:
        fail Invalid
    x}] [silent {error Invalid
fn f(x) errors Invalid:
    if 1 == 2:
        fail Invalid
    if x == 7:
        fail Invalid
    x}]
} -result {{{6:9 Invalid 2 8:9}} 1}

test sf-code-after-return-never-counts {a fail after an unconditional return is unreachable} -body {
    silent {error Invalid
fn f(x) errors Invalid:
    if x == 7:
        fail Invalid
    return x
    fail Invalid}
} -result 1

test sf-range-unreachable-pruned {a range-unreachable fail beside two reachable ones: the count stays 2, the dead site is in no location} -body {
    failures {error Invalid
fn f(x) errors Invalid:
    if x < 0:
        if x > 5:
            fail Invalid
    if x == 7:
        fail Invalid
    if x == 8:
        fail Invalid
    x}
} -result {{7:9 Invalid 2 9:9}}

test sf-range-feasible-control {the feasible control (x < -5 inside x < 0) keeps all three} -body {
    failures {error Invalid
fn f(x) errors Invalid:
    if x < 0:
        if x < -5:
            fail Invalid
    if x == 7:
        fail Invalid
    if x == 8:
        fail Invalid
    x}
} -result {{5:13 Invalid 3 {7:9 9:9}}}

test sf-range-pruning-removes-a-group {a structural pair whose second site is range-unreachable is no group: pruning only removes sites} -body {
    silent {error Invalid
fn f(x) errors Invalid:
    if x < 0:
        if x > 5:
            fail Invalid
    if x == 7:
        fail Invalid
    x}
} -result 1

test sf-walk-only-for-candidates {the completion walk runs only for a function with a structurally repeated failure of its own, once each: a dead site or a nested function's fail never makes a candidate} -body {
    set hir [compileWith {error A
error B
fn none(x):
    x
fn one(x) errors A:
    if x == 1:
        fail A
    x
fn distinct(x) errors A, B:
    if x == 1:
        fail A
    if x == 2:
        fail B
    x
fn deadpair(x) errors A:
    if 1 == 2:
        fail A
    if x == 1:
        fail A
    x
fn pair(x) errors A:
    if x == 1:
        fail A
    if x == 2:
        fail A
    x
fn rangepair(x) errors A:
    if x < 0:
        if x > 5:
            fail A
    if x == 1:
        fail A
    x
fn nestedpair(x) errors A:
    fn inner(y) errors A:
        if y == 1:
            fail A
        y
    if x == 1:
        fail A
    inner(x)} off]
    walkedFunctions $hir {hir::warnings::SameFailure $hir}
} -result {pair rangepair}

test sf-walk-records-fail-sites {the recording walk records fail sites as it is (no extension): reached sites present, the range-unreachable one absent} -body {
    set hir [compileWith {error Invalid
fn f(x) errors Invalid:
    if x < 0:
        if x > 5:
            fail Invalid
    if x == 7:
        fail Invalid
    x} off]
    set block [lindex [dict keys [hir::warnings::BlockNames $hir]] 0]
    set reached [hir::completions::reachedExprs $hir $block]
    lmap e [hir::warnings::BodyExprs $hir $block] {
        if {[dict get $hir exprs $e kind] ne "fail"} continue
        list [loc $hir [dict get $hir exprs $e origin]] [dict exists $reached $e]
    }
} -result {{5:13 0} {7:9 1}}

test sf-pruning-leaves-the-count-right {the count, the sites and the notes are those of the reachable exits only} -body {
    set hir [compileWith {error Invalid
fn f(x) errors Invalid:
    if x < 0:
        if x > 5:
            fail Invalid
    if 1 == 2:
        fail Invalid
    if x == 7:
        fail Invalid
    if x == 8:
        fail Invalid
    if x == 9:
        fail Invalid
    x}]
    set w [lindex [failuresOf $hir] 0]
    list [dict get $w data exits] [llength [dict get $w data sites]] [llength [dict get $w secondary]] \
        [lmap e [dict get $w data sites] {loc $hir [dict get $hir exprs $e origin]}]
} -result {3 3 2 {9:9 11:9 13:9}}

test sf-repeated-range-guard-pruned {a repeated `if x < 0: fail E` is dead after the first, and the range facts prove it: silent} -body {
    silent {error E
fn f(x) errors E:
    if x < 0:
        fail E
    if x < 0:
        fail E
    x}
} -result 1

test sf-limit-repeated-equality-guard-counts {LIMIT: a repeated `if x == 7: fail E` is dead after the first at run time, but range facts cannot exclude one point, so it is not provably unreachable and counts (over-count, never a miss)} -body {
    failures {error E
fn f(x) errors E:
    if x == 7:
        fail E
    if x == 7:
        fail E
    x}
} -result {{4:9 E 2 6:9}}

test sf-unreachable-function-is-not-walked {a nested function in a statically dead branch is never reported} -body {
    silent {error E
fn f(x) errors E:
    if 1 == 2:
        fn inner(y) errors E:
            if y == 1:
                fail E
            if y == 2:
                fail E
            y
        return inner(x)
    x}
} -result 1

test sf-reach-module-code-located-in-module {a module function's fail exits (one inside a loop) are located in the module file} -body {
    withModules {m.bot {error Invalid
fn parse(xs, a) errors Invalid:
    loop x in xs:
        if x == a:
            fail Invalid
    if a == 0:
        fail Invalid
    a
}} {
        set hir [surface::compile {import m
y = m::parse([1, 2], 3):
    on Invalid:
        0
y} t.bot -warnings default -warning-channel ""]
        lmap w [failuresOf $hir] {
            list [file tail [hir::originLocation $hir [dict get $w primary]]] \
                [lmap o [dict get $w secondary] {file tail [hir::originLocation $hir $o]}] \
                [dict get $w data functionName]
        }
    }
} -result {{m.bot:5:13 m.bot:7:9 m::parse}}

