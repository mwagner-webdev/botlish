} -result {SAME-FAILURE SAME-FAILURE 1}

test sf-off-runs-no-warning-pass {warnings off does not execute the pass at all (default does): the stats counter} -body {
    hir::warnings::resetStats
    compileWith $::groupSource off
    set afterOff [hir::warnings::stats]
    compileWith $::groupSource default
    set afterDefault [hir::warnings::stats]
    list $afterOff [dict exists $afterOff SAME-FAILURE] [dict get $afterDefault SAME-FAILURE]
} -result {{} 0 1}

test sf-off-runs-no-warning-pass-via-trace {an execution trace on the pass proves it is not invoked when off} -body {
    set ::passCalls 0
    trace add execution hir::warnings::SameFailure enter {apply {{args} {incr ::passCalls}}}
    try {
        compileWith $::groupSource off
        set off $::passCalls
        compileWith $::groupSource default
        set on $::passCalls
    } finally {
        trace remove execution hir::warnings::SameFailure enter {apply {{args} {incr ::passCalls}}}
    }
    list $off $on
} -result {0 1}

test sf-compilation-with-errors-has-no-warnings {a program the compiler rejects is never warned about} -body {
    set hir [surface::compile "$::groupSource\nnothing" t.bot -strict 0 -warnings default -warning-channel ""]
    list [expr {[llength [hir::diagnostics $hir]] > 0}] [hir::warnings::of $hir]
} -result {1 {}}

test sf-policy-is-per-compilation {interleaved compilations under different modes never leak a mode} -body {
    set a [compileWith $::groupSource off]
    set b [compileWith $::groupSource default]
    set c [catch {compileWith $::groupSource error}]
    set d [compileWith $::groupSource off]
    set e [compileWith $::groupSource default]
    list [llength [failuresOf $a]] [llength [failuresOf $b]] $c [llength [failuresOf $d]] [llength [failuresOf $e]]
} -result {0 1 1 0 1}

test sf-warnings-attached-structurally {hir::warnings::of equals collect} -body {
    set hir [compileWith $::fourSource default]
    list [expr {[hir::warnings::of $hir] eq [hir::warnings::collect $hir]}] [llength [hir::warnings::collect $hir]]
} -result {1 4}

test sf-error-stops-before-backend {error mode rejects before any backend lowers anything (traces on all four entry points)} -body {
    set source "$::groupSource\ny = parse(3):\n    on Invalid:\n        0\ny"
    set ::lowerCalls 0
    foreach command {native::evalHir native::prepareHir hir::lower core::compiler::evalHir} {
        trace add execution $command enter {apply {{args} {incr ::lowerCalls}}}
    }
    try {
        set rejected [catch {compileWith $source error} message options]
    } finally {
        foreach command {native::evalHir native::prepareHir hir::lower core::compiler::evalHir} {
            trace remove execution $command enter {apply {{args} {incr ::lowerCalls}}}
        }
    }
    list $rejected [dict get $options -errorcode] $::lowerCalls
} -result {1 {CORE SEMANTIC SAME-FAILURE} 0}

