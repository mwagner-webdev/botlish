# Backend independence (item 15)

test sf-backend-independent {every backend runs the program identically; the one warning set is the HIR's} -body {
    set hir [compileWith $::runSource default]
    set outcomes [lmap backend $::allBackends {outcomeUnderHir $backend $hir}]
    list [llength [lsort -unique [lmap o $outcomes {lindex $o 1}]]] [lindex $outcomes 0 1] [llength [failuresOf $hir]]
} -result {1 {[2, 0, 0, 8]} 1}

test sf-backend-independent-off {the same program runs identically on every backend with warnings off} -body {
    set hir [compileWith $::runSource off]
    lsort -unique [lmap backend $::allBackends {lindex [outcomeUnderHir $backend $hir] 1}]
} -result {{[2, 0, 0, 8]}}

# ---------------------------------------------------------------------------
# The command line

test sf-cli-modes {main.tcl: default prints the warning and its note on stderr and runs; off is silent; error rejects before running} -constraints executableAot -body {
    set main [file join $::projectRoot main.tcl]
    set path [makeFile $::runSource sf-cli-[pid].bot]
    set results {}
    foreach mode {default off error} {
        set status [catch {exec [info nameofexecutable] $main -warnings $mode $path 2>@1} out]
        lappend results [list $mode $status \
            [regexp {:4:9: warning: failure `Invalid` is raised from 2 distinct exits \(SAME-FAILURE\)} $out] \
            [regexp {:6:9: note: also raised here} $out] \
            [regexp {value: \[2, 0, 0, 8\]} $out] \
            [regexp {CORE SEMANTIC SAME-FAILURE} $out]]
    }
    removeFile sf-cli-[pid].bot
    set results
} -result {{default 0 1 1 1 0} {off 0 0 0 1 0} {error 1 0 0 0 1}}

test sf-cli-no-wno-option {-Wno-same-failure is an unknown option, not a file name} -constraints executableAot -body {
    set main [file join $::projectRoot main.tcl]
    set path [makeFile $::runSource sf-cli-wno-[pid].bot]
    catch {exec [info nameofexecutable] $main -Wno-same-failure $path 2>@1} out
    removeFile sf-cli-wno-[pid].bot
    list [string match "*unknown option*-Wno-same-failure*" $out] [string match "*value:*" $out]
} -result {1 0}

test sf-cli-unknown-mode {main.tcl rejects an unknown mode} -constraints executableAot -body {
    set main [file join $::projectRoot main.tcl]
    set path [makeFile $::runSource sf-cli-mode-[pid].bot]
    set status [catch {exec [info nameofexecutable] $main -warnings failures $path 2>@1} out]
    removeFile sf-cli-mode-[pid].bot
    list $status [string match "*unknown warnings mode*" $out]
} -result {1 1}

test sf-cli-stdout-clean {the warning goes to stderr: program stdout carries no warning text} -constraints executableAot -body {
    set main [file join $::projectRoot main.tcl]
    set path [makeFile $::runSource sf-cli-stdout-[pid].bot]
    set stderrPath [makeFile {} sf-cli-stderr-[pid].txt]
    set out [exec [info nameofexecutable] $main -warnings default $path 2> $stderrPath]
    set err [viewFile sf-cli-stderr-[pid].txt]
    removeFile sf-cli-stdout-[pid].bot
    removeFile sf-cli-stderr-[pid].txt
    list [string match *warning* $out] [string match *raised* $out] [string match *SAME-FAILURE* $err] \
        [string match {*value: \[2, 0, 0, 8\]*} $out]
} -result {0 0 1 1}

test sf-error-cli-stops-before-backend {main.tcl -backend cranelift -warnings error rejects without lowering or running anything} -constraints executableAot -body {
    set main [file join $::projectRoot main.tcl]
    set path [makeFile $::runSource sf-cli-error-[pid].bot]
    catch {exec [info nameofexecutable] $main -backend cranelift -warnings error $path 2>@1} out
    removeFile sf-cli-error-[pid].bot
    list [string match "*value:*" $out] [regexp {\(CORE SEMANTIC SAME-FAILURE\)} $out]
} -result {0 1}

# The warning lines (and their notes) of main.tcl's stderr for PATH on
# BACKEND, with the file's directory stripped.
proc cliWarningText {path backend} {
    set main [file join $::projectRoot main.tcl]
    set err [makeFile {} sf-cli-err-[pid].txt]
    catch {exec [info nameofexecutable] $main -backend $backend -warnings default $path 2> $err}
    set lines [lmap line [split [viewFile sf-cli-err-[pid].txt] \n] {
        if {![string match "*: warning: *" $line] && ![string match "*: note: *" $line]} continue
        set line
    }]
    removeFile sf-cli-err-[pid].txt
    return $lines
}

test sf-cli-backend-independent {main.tcl prints the identical SAME-FAILURE text, notes included, on every backend} -constraints executableAot -body {
    set path [makeFile "$::fourSource\ny = check(3):\n    on Bad:\n        0\ny" sf-cli-four-[pid].bot]
    set texts [lmap backend $::allBackends {cliWarningText $path $backend}]
    removeFile sf-cli-four-[pid].bot
    set first [lindex $texts 0]
    list [llength [lsort -unique $texts]] [llength [lsearch -all $first *SAME-FAILURE*]] \
        [llength [lsearch -all $first "*note: also raised here"]] [llength $first]
} -result {1 1 1 6}

test sf-cli-backend-independent-stdlib {main.tcl prints the identical warning text (every code, notes included) on every backend over the whole stdlib corpus} -constraints executableAot -body {
    set programs [lsort [glob -directory [file join $::projectRoot examples stdlib] *.bot]]
    set mismatches {}
    set total 0
    foreach path $programs {
        set texts [lmap backend $::allBackends {cliWarningText $path $backend}]
        incr total [llength [lindex $texts 0]]
        if {[llength [lsort -unique $texts]] != 1} {
            lappend mismatches [file tail $path]
        }
    }
    list $mismatches [expr {$total > 0}]
} -result {{} 1}

# ---------------------------------------------------------------------------
# Fuzzing: constructed programs, an independent oracle, all three modes

test sf-fuzz-smoke {60 generated programs: predicted groups (anchor and notes) and only them, off silent with identical HIR, error iff warned} -constraints executableAot -body {
    set fuzz [file join $::projectRoot audit same-failure tools fuzz.tcl]
    exec [info nameofexecutable] $fuzz 60 1
} -result {seeds 60 (from 1): * with warnings, * without; failures 0; extra warnings 0; groups *} -match glob

cleanupTests
