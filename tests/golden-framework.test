# ---------------------------------------------------------------------------
# The framework keeps the compiler's precision, and adds nothing at run time

# The compiler's verdict on CODE as the body of a function its registration
# function calls directly -- "ok VALUE" or the diagnostic's kind -- beside
# the verdict of the same CODE as a golden case's body (std::test::value against
# EXPECTED): the report line, with the diagnostic code when rejected. The
# prelude declares what the code uses.
proc gfPrecision {prelude code expected} {
    set indented [join [lmap line [split $code \n] {string cat "            " $line}] \n]
    set plainIndented [join [lmap line [split $code \n] {string cat "        " $line}] \n]
    set plain "import std::list\nimport std::mutable_vector\n$prelude\nfn register_probe(n: int):\n    fn body():\n$plainIndented\n    body()\n\nregister_probe(9)\n"
    set suite "import std::compiler\nimport std::list\nimport std::mutable_vector\nimport std::test\n$prelude\nfn register_probe(n: int):\n    fn body() errors std::compiler::CompilerError:\n        static compile:\n$indented\n    std::test::value(\"probe\", $expected, body)\n\nwith context std::test::suite()\nregister_probe(9)\nstd::test::report()\n"
    if {[catch {surface::compile $plain plain.bot -warnings off} hir options]} {
        set plainVerdict [lindex [dict get $options -errorcode] end]
    } else {
        set plainVerdict "ok [lindex [outcomeUnderHir interp $hir] 1]"
    }
    set report [gfReport $suite]
    set suiteVerdict [lindex $report 0]
    if {[string match "FAIL *" $suiteVerdict]} {
        regexp {compiler diagnostic (\S+)} [lindex $report 2] -> code
        set suiteVerdict "rejected $code"
    }
    return [list $plainVerdict $suiteVerdict]
}

