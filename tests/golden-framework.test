fn register_nir(n: int):
    fn body() errors std::compiler::CompilerError:
        static compile:
            n * 3 + 1
    std::test::value("nir", 22, body)

with context std::test::suite()
register_nir(7)
std::test::report()
}
    set plain {fn keep(f) -> int:
    f()

fn register_nir(n: int) -> int:
    fn body():
        n * 3 + 1
    keep(body)

register_nir(7)
}
    set a [gfFunctionNir $suite body]
    set b [gfFunctionNir $plain body]
    list [expr {$a eq $b}] [regexp {op rimul} $a] [regexp {static|compiler|CompilerError} $a]
} -result {1 1 0}


# SOURCE with every non-empty line indented by N spaces.
proc gfIndent {source n} {
    set pad [string repeat " " $n]
    return [join [lmap line [split $source \n] {if {$line eq ""} {string cat} else {string cat $pad $line}}] \n]
}

# The native allocations of HIR at the functions NAMES (by function and
# object kind: a dict "FUNCTION KIND" -> count), one run.
proc gfFunctionAllocations {hir names} {
    set counts [dict create]
    foreach site [dict get [native::allocationReport $hir sites] sites] {
        set function [dict get $site func]
        regsub {#\d+$} $function "" function
        if {$function in $names} {
            dict incr counts "$function [dict get $site objectKind]" [dict get $site allocations]
        }
    }
    return $counts
}

# A migrated golden body, CODE (with the suite-level IMPORTS and DECLS it
# needs; a registration function taking PARAMS, called with ARGS, which the
# body may capture), compiled twice: inside the convention (a body declaring
# std::compiler::CompilerError around a static compile: block, registered with
# std::test::value) and plainly (the same code as an ordinary nested function,
# called once through an untyped parameter). Returns the suite's verdict
# line, whether the NIR of each of NAMES (the body and the functions its
# block declares; "" for the anonymous function a coroutine construction
# makes) is equal in both programs, and whether their native allocations
# are.
proc gfMigratedBody {imports decls params args code expected names} {
    set suite "import std::compiler\n${imports}import std::test\n\n$decls\nfn register_nir($params):\n    fn body() errors std::compiler::CompilerError:\n        static compile:\n[gfIndent $code 12]\n    std::test::value(\"nir\", $expected, body)\n\nwith context std::test::suite()\nregister_nir($args)\nstd::test::report()\n"
    set plain "${imports}\n$decls\nfn keep(f):\n    f()\n\nfn register_nir($params):\n    fn body():\n[gfIndent $code 8]\n    keep(body)\n\nregister_nir($args)\n"
    set hir [gfCompile $suite]
    set suiteNir [gfNirFunctions $hir]
    set suiteAllocations [gfFunctionAllocations $hir $names]
    set verdict [lindex [lindex [golden::run $hir cranelift] 1] 0]
    set hir [gfCompile $plain]
    set plainNir [gfNirFunctions $hir]
    set plainAllocations [gfFunctionAllocations $hir $names]
    # A name the library uses too (std::test::value's nested check) has several
    # instances in the suite's program: one of them must equal the plain one.
    set equal [lmap name $names {
        set texts [dict values [dict filter $suiteNir script {key -} {regexp "^[string map {. \\.} $name](#\\d+)?\$" $key}]]
        expr {[dict exists $plainNir $name] && [dict get $plainNir $name] in $texts}
    }]
    return [list $verdict $equal [expr {$suiteAllocations eq $plainAllocations}]]
}

test gf-nir-migrated-bodies {representative migrated golden bodies are their code: for a closure (values.bot 03-closure), closures made per loop iteration (loop-in-closure-per-iteration), an error propagated through a declaring caller and handled (errors-propagation-through-declaring-caller) and a coroutine protocol (ownership.bot co-principal), every function the body defines has the same native NIR, and the same native allocations, as the same code written plainly without the framework and without static compile} -constraints nativeCoroutines -body {
    set cases [list \
        closure {} {} {} {} "fn make_adder(x):\n    fn add(y):\n        x + y\n\n    add\n\nadd10 = make_adder(10)\nadd10(32)" 42 {body make_adder add} \
        loop-closures {} {} {} {} "fs = loop x in \[1, 2, 3\]:\n    fn f():\n        x\n    f\nresults = loop g in fs:\n    g()\nresults" {[1, 2, 3]} {body f} \
        handled-errors {} "error TooSmall\nerror TooBig\n" "big: int" 20 "fn check(n) -> int errors TooSmall, TooBig:\n    if n < 0:\n        fail TooSmall\n    else:\n        if n > 10:\n            fail TooBig\n        else:\n            n\nfn middle(n) -> int errors TooSmall, TooBig:\n    check(n)\nr = middle(big):\n    on TooSmall:\n        -1\n    on TooBig:\n        -2\nr" -2 {body check middle} \
        coroutine "import std::coroutine\n" "struct Message:\n    value: int\n\nstruct Event:\n    value: int\n" {} {} "fn deep(base: int, resume Message) -> int:\n    message = yield Event {value: base}\n    message.value\nfn worker(base: int, resume Message) -> Event:\n    x = deep(base)\n    message = yield Event {value: x}\n    return Event {value: message.value}\ncoroutine {step, first} = worker(10)\nsecond = step(Message {value: 20})\nfinal = step(Message {value: 30})\nagain = step(Message {value: 999})\n\[first.value, second.value, final.value, again.value, std::coroutine::done?(step)\]" {[10, 20, 30, 30, true]} {body deep worker {}}]
    lmap {label imports decls params args code expected names} $cases {
        list $label {*}[gfMigratedBody $imports $decls $params $args $code $expected $names]
    }
} -result {{closure {PASS nir} {1 1 1} 1} {loop-closures {PASS nir} {1 1} 1} {handled-errors {PASS nir} {1 1 1} 1} {coroutine {PASS nir} {1 1 1 1} 1}}

