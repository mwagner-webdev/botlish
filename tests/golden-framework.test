test gf-gc-stress {natively under GC stress: many registered checks capturing Strings and structs, CompilerError payloads, coroutines and failing results retained until the report; the report equals the Tcl backends'; on the general coroutine runtime every coroutine is released and none swept} -constraints nativeCoroutines -body {
    set source {import std::compiler
import std::str
import std::test

struct Pair:
    label: str
    n: int

struct Event:
    n: int

fn finite(k: int) -> Event:
    yield Event {n: k}
    Event {n: k + 1}

fn register_many(k: int, label: str):
    pair = Pair {label: label.concat("!"), n: k}
    fn text() errors std::compiler::CompilerError:
        static compile:
            [pair.label, label]
    std::test::value(label, [label.concat("!"), label], text)
    fn wrong() errors std::compiler::CompilerError:
        static compile:
            [pair.n, k + 1]
    std::test::value(label.concat(" mismatch"), [k, k], wrong)
    fn rejected() errors std::compiler::CompilerError:
        static compile:
            pair.missing
    std::test::rejects(label.concat(" rejected"), std::compiler::DiagnosticCode::Type, rejected)
    fn driven() errors std::compiler::CompilerError:
        static compile:
            coroutine {step, first} = finite(pair.n)
            first.n + step().n
    std::test::value(label.concat(" coroutine"), k + k + 1, driven)

fn register_all(k: int):
    if k == 0:
        return
    register_many(k, "case ".concat(std::test::describe(k)))
    register_all(k - 1)

with context std::test::suite()
register_all(12)
std::test::report()
}
    set hir [gfCompile $source]
    set tcl [golden::run $hir interp]
    set native [withGcStress {golden::run $hir cranelift}]
    set coroutines [withGcStress {withoutCoroutineFusion {dict get [native::allocationReport $hir summary] coroutines}}]
    list [lindex [lindex $tcl 1] end] [expr {[lindex $native 1] eq [lindex $tcl 1]}] \
        [dict get $coroutines released] [dict get $coroutines sweptSuspended]
} -result {{24 passed, 24 failed} 1 13 0}

