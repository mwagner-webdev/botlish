# The message helpers, promoted from the suite-local matchers the migration's
# suites wrote (LARGE-SCALE-GOLDEN-MIGRATION.md, "The framework at scale"): the exact
# message, or a fragment of it, beside the code; each kind of mismatch.
set gfMessages {import std::compiler
import std::test

fn register_messages():
    fn unbound() errors std::compiler::CompilerError:
        static compile:
            missing + 1
    fn adds() errors std::compiler::CompilerError:
        static compile:
            20 + 22
    std::test::rejects_message("exact message", std::compiler::DiagnosticCode::Unbound, "unbound name \"missing\"", unbound)
    std::test::rejects_message("another message", std::compiler::DiagnosticCode::Unbound, "unbound name", unbound)
    std::test::rejects_message("another code", std::compiler::DiagnosticCode::Type, "unbound name \"missing\"", unbound)
    std::test::rejects_message("message expected, block accepted", std::compiler::DiagnosticCode::Unbound, "unbound name \"missing\"", adds)
    std::test::rejects_containing("fragment", std::compiler::DiagnosticCode::Unbound, "\"missing\"", unbound)
    std::test::rejects_containing("whole message as fragment", std::compiler::DiagnosticCode::Unbound, "unbound name \"missing\"", unbound)
    std::test::rejects_containing("empty fragment", std::compiler::DiagnosticCode::Unbound, "", unbound)
    std::test::rejects_containing("absent fragment", std::compiler::DiagnosticCode::Unbound, "present", unbound)
    std::test::rejects_containing("fragment, another code", std::compiler::DiagnosticCode::Type, "missing", unbound)
    std::test::rejects_containing("fragment expected, block accepted", std::compiler::DiagnosticCode::Unbound, "missing", adds)

with context std::test::suite()
register_messages()
std::test::report()
}

