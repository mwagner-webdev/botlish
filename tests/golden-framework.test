# The NIR of every function of HIR's native lowering, a dict name -> text:
# its header and lines without HIR expression ids, with every program-wide
# number replaced by what it numbers -- a callee or function value by its
# name, a struct shape by its declaration, a declared error by its name
# (from any `faildeclared N "NAME"` of the program) or else by its order of
# appearance -- since a suite's program also holds stdlib/test.bot's functions,
# shapes and std::compiler::CompilerError. Instances of one name are keyed NAME,
# NAME#2, ...; references name the function without the suffix. (Lower HIR
# right after compiling it: the lowering reads the latest compilation's
# module state.)
proc gfNirFunctions {hir} {
    set functions [dict create]
    set numbers [dict create]
    set errors [dict create]
    set shapes [dict create]
    set current ""
    set inside 0
    foreach line [split [native::nir $hir] \n] {
        if {[regexp {^shape (\d+) (.*)$} $line -> number shape]} {
            dict set shapes $number $shape
        }
        if {[regexp {^func (\d+) "([^"]*)" (.*)$} $line -> number name header]} {
            # Instances of one function share its name: number the later ones.
            set base $name
            for {set k 2} {[dict exists $functions $name]} {incr k} { set name "$base#$k" }
            set current $name
            set inside 1
            dict set numbers $number $base
            dict set functions $name [list [regsub -all { ?@e\d+} $header ""]]
        } elseif {$line eq "end"} {
            set inside 0
        } elseif {$inside} {
            dict lappend functions $current [regsub -all { ?@e\d+} $line ""]
        }
        if {[regexp {faildeclared (\d+) "([^"]+)"} $line -> number name]} {
            dict set errors $number $name
        }
    }
    set result [dict create]
    dict for {name lines} $functions {
        set order [dict create]
        set mapped {}
        foreach line $lines {
            if {[regexp {^(.*\m(?:call|callenv|closure|tailcall|fnvalue)) (\d+)(.*)$} $line -> before number after] && [dict exists $numbers $number]} {
                set line "$before <[dict get $numbers $number]>$after"
            }
            if {[regexp {^(.*\mstructnew) (\d+)(.*)$} $line -> before number after] && [dict exists $shapes $number]} {
                set line "$before <[dict get $shapes $number]>$after"
            }
            if {[regexp {^(.*\m(?:declarederroreq|faildeclared)) (\d+)(.*)$} $line -> before number after]} {
                if {[dict exists $errors $number]} {
                    set line "$before <[dict get $errors $number]>$after"
                } else {
                    if {![dict exists $order $number]} { dict set order $number "e[dict size $order]" }
                    set line "$before <[dict get $order $number]>$after"
                }
            }
            lappend mapped $line
        }
        dict set result $name [join $mapped \n]
    }
    return $result
}

# The NIR text of function NAME in the native lowering of SOURCE
# (gfNirFunctions).
proc gfFunctionNir {source name} {
    set functions [gfNirFunctions [gfCompile $source]]
    if {![dict exists $functions $name]} {
        error "no function $name"
    }
    return [dict get $functions $name]
}

