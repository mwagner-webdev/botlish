# Forging a Receiver to read a mailbox one never listened to: Receiver is opaque (OPAQUE-CONSTRUCTION).
import std::actor
import std::event_loop
import std::event_loop::deterministic

struct Work:
    n: int

fn snoop() -> std::actor::Exit:
    rx = std::actor::Receiver[Work] {slot: 0, gen: 1}
    w = rx.receive():
        on std::actor::Closed:
            return std::actor::exit(-1)
    std::actor::exit(w.n)

fn main(context ev: std::event_loop::Loop, ac: std::actor::Actors) -> int errors std::event_loop::SchedulerFault:
    0

with context std::event_loop::create(8)
with context std::event_loop::deterministic::create()
with context std::actor::create()
main():
    on std::event_loop::SchedulerFault:
        0
