# native-csv-records.test -- the composed CSV-header-to-row-HashTable
# workload (examples/stdlib/csv_records.bot): CSV parsing (csv_geometric.bot's
# algorithm) and the mutable HashTable (hashtable.bot's algorithm) used
# together in ordinary application code, exactly as the milestone that added
# this file asks. Both pieces are unmodified (see csv_records.bot's header);
# this file checks what composing them exposes -- header sharing, GC
# liveness of the larger object graph, zero-allocation steady-state reads,
# and the property/differential correctness of the row-shape and
# duplicate-header policy -- the same way native-hashtable.test and
# native-mutarray.test check their own pieces.
#
# tests/stdlib.test already differential-tests csv_records/csv_records_presized
# across all four backends for the row-shape, duplicate-header, quoting and
# Unicode (BMP) cases; this file is native-backend-specific (allocation
# instrumentation, GC stress) plus one property test, like
# native-hashtable.test's own split of concerns.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]
source [file join $::projectRoot examples stdlib corpus.tcl]

interp recursionlimit {} 1000000

# corpus::text's whole file, minus its own trailing "sample()" call (see
# native-hashtable.test's identical header note): this test appends its own
# driver after the definitions.
set ::csvRecordsSource [regsub {\nsample\(\)\n$} [corpus::text csv_records] "\n"]

proc sourceHir {text} {
    return [surface::compile "$::csvRecordsSource\n$text\n" t.bot -strict 0]
}

proc sourceIR {text} {
    return [hir::lower [sourceHir $text]]
}

set parityBackends {interp compile cranelift-generic cranelift}

proc parity {text} {
    set exprs [sourceIR $text]
    set outcomes [lmap backend $::parityBackends {outcomeUnder $backend $exprs}]
    if {[llength [lsort -unique $outcomes]] == 1} {
        return same
    }
    return [join [lmap backend $::parityBackends outcome $outcomes {list $backend $outcome}] " / "]
}

# The outcome of source TEXT on cranelift: {value V} or {error CODE MESSAGE}.
proc native {text} {
    lrange [outcomeUnder cranelift [sourceIR $text]] 0 end-1
}

proc allocationsOf {text} {
    return [native::allocationReport [sourceHir $text] summary]
}

# ---------------------------------------------------------------------------
# Deterministic CSV generation (Tcl-side, like bench/csv_records.tcl's own
# generator -- kept independently here so this file's fixtures do not depend
# on the benchmark script). HEADERS is a Tcl list of header names (already
# CSV-safe: no comma/quote/newline); ROWFN i -> a Tcl list of field values
# for data row i (0-based), of any length (ragged rows allowed).
proc genCsv {headers rows rowFn} {
    set lines [list [join $headers ,]]
    for {set i 0} {$i < $rows} {incr i} {
        lappend lines [join [uplevel 1 [list apply $rowFn $i]] ,]
    }
    return "[join $lines \n]\n"
}

# ---------------------------------------------------------------------------
# Header sharing (req #3, #16, #45): row-table construction over an already
# -parsed CSV adds no new String allocations. csv_records(TEXT) internally
# calls csv_parse(TEXT) and then only mutable_array_get/_set (never a String
# op) to place existing String objects into tables, so its String allocation
# count must equal csv_parse(TEXT)'s alone -- if headers (or fields) were
# being reconstructed per row instead of reused, this would grow with the
# row count instead of staying fixed.

proc csvFixture {} {
    return [genCsv {h0 h1 h2 h3 h4} 20 {i {
        list v$i-0 v$i-1 v$i-2 v$i-3 v$i-4
    }}]
}

test csv-records-string-sharing-1 {row-table construction over parsed CSV allocates no new Strings: header and field Strings are reused, not reconstructed} -body {
    set text [csvFixture]
    set base "fn f():\n    r = csv_parse([corpus::literal $text])\n    list_length(r)\nf()"
    set withTables "fn f():\n    r = csv_records([corpus::literal $text])\n    list_length(r)\nf()"
    set withPresized "fn f():\n    r = csv_records_presized([corpus::literal $text])\n    list_length(r)\nf()"
    set baseStrings [dict get [allocationsOf $base] byKind String allocations]
    set tableStrings [dict get [allocationsOf $withTables] byKind String allocations]
    set presizedStrings [dict get [allocationsOf $withPresized] byKind String allocations]
    list $baseStrings $tableStrings $presizedStrings
} -result {880 880 880}

# The exact figure (a multiple of the CSV scanner's own per-character/per
# -field allocation shape: every scan_unquoted call allocates a substring,
# and scan_quoted allocates one concat per character copied) matters less
# than the three counts being equal (asserted above) -- this second test
# pins the base count itself so a future change to the CSV scanner's own
# allocation shape is visible here too, not just relatively.
test csv-records-string-sharing-2 {the pinned base count itself (documents what "880" above is, independent of row-table construction)} -body {
    dict get [allocationsOf "csv_parse([corpus::literal [csvFixture]])"] byKind String allocations
} -result 880

# ---------------------------------------------------------------------------
# Presizing (req #24): a row wide enough to force the default table to
# resize while the presized table (built from the same header count) never
# does. 10 headers: ht_new() starts at capacity 8 (load factor forces a
# resize on the 6th distinct key, since (5+1)*3 = 18 > 8*2 = 16); ht_new_sized(10)
# starts at capacity 16 (10*3 = 30 <= 16*2 = 32), enough for all 10 without
# resizing. Each resize allocates exactly 3 replacement MutableArrays
# (ht_rehash: new controls/keys/values -- see hashtable.bot); a table's own
# construction (ht_alloc) always allocates 4 (controls, keys, values, the
# outer record). So one row of 10 distinct headers costs the default variant
# 4 + 3*resizes MutableArray allocations and the presized variant exactly 4.

proc wideHeaders {} { return {h0 h1 h2 h3 h4 h5 h6 h7 h8 h9} }

test csv-records-presize-1 {a 10-column row forces the default table to resize at least once; the presized table never resizes} -body {
    set text [genCsv [wideHeaders] 1 {i {list a b c d e f g h i j}}]
    set default "list_length(csv_records([corpus::literal $text]))"
    set presized "list_length(csv_records_presized([corpus::literal $text]))"
    set defaultMutarrays [dict get [allocationsOf $default] byKind MutableArray allocations]
    set presizedMutarrays [dict get [allocationsOf $presized] byKind MutableArray allocations]
    # Both build the same outer GeometricBuilder (1 row: geo_new's initial 0
    # -capacity array plus one grow-to-1 array = 2 MutableArray allocations)
    # around the one row table; the difference isolates the table's own
    # resize cost.
    list [expr {$defaultMutarrays > $presizedMutarrays}] [expr {$defaultMutarrays - $presizedMutarrays}]
} -result {1 3}

test csv-records-presize-2 {presized and default row tables agree on content even when the default variant resized} -body {
    native {
fn f():
    text = "h0,h1,h2,h3,h4,h5,h6,h7,h8,h9\na,b,c,d,e,f,g,h,i,j\n"
    d = list_get(csv_records(text), 0)
    p = list_get(csv_records_presized(text), 0)
    [ht_get(d, "h0"), ht_get(d, "h9"), ht_size(d), ht_capacity(d) > 8, ht_get(p, "h0"), ht_get(p, "h9"), ht_size(p), ht_capacity(p) == 16]
f()
    }
} -result {value {["a", "j", 10, true, "a", "j", 10, true]}}

# ---------------------------------------------------------------------------
# Zero-allocation readback (req #41, #21): repeated lookups over already
# -built row tables allocate zero managed objects, exactly like
# native-hashtable.test's ht-alloc-hit-1 but through the composed workload's
# own construction path. Compared as a delta against an identical program
# that omits only the lookups (see native-hashtable.test's header for why:
# construction itself allocates, honestly, per req #18).

proc assertNoExtraAllocation {label base after} {
    set baseCount [dict get [allocationsOf $base] total allocations]
    set afterCount [dict get [allocationsOf $after] total allocations]
    if {$baseCount != $afterCount} {
        error "$label: base allocated $baseCount, with the operation added allocated $afterCount (expected equal)"
    }
    return {}
}

set ::csvRecordsSetup {
fn setup():
    csv_records("h0,h1,h2\na,b,c\nd,e,f\ng,h,i\n")
}

set ::csvRecordsBase "$::csvRecordsSetup\nfn f():\n    rows = setup()\n    unit\nf()\n"

test csv-records-alloc-readback-1 {repeated ht_get/ht_contains over the constructed rows allocate zero managed objects beyond construction} -body {
    assertNoExtraAllocation readback $::csvRecordsBase "$::csvRecordsSetup\nfn f():\n    rows = setup()\n    r0 = list_get(rows, 0)\n    r1 = list_get(rows, 1)\n    r2 = list_get(rows, 2)\n    ht_get(r0, \"h0\")\n    ht_get(r1, \"h1\")\n    ht_get(r2, \"h2\")\n    ht_get(r0, \"missing\")\n    ht_contains(r1, \"h0\")\n    unit\nf()"
} -result {}

test csv-records-alloc-readback-2 {a repeated-lookup loop over many rows also allocates zero managed objects beyond construction} -body {
    set base "$::csvRecordsSetup\nfn lookupAll(rows, i, n):\n    if i >= n:\n        return unit\n    lookupAll(rows, i + 1, n)\n\nfn f():\n    rows = setup()\n    unit\nf()\n"
    set withLookups "$::csvRecordsSetup\nfn lookupAll(rows, i, n):\n    if i >= n:\n        return unit\n    r = list_get(rows, i)\n    ht_get(r, \"h0\")\n    ht_get(r, \"h1\")\n    ht_get(r, \"h2\")\n    lookupAll(rows, i + 1, n)\n\nfn f():\n    rows = setup()\n    lookupAll(rows, 0, 3)\nf()\n"
    assertNoExtraAllocation readback-loop $base $withLookups
} -result {}

# ---------------------------------------------------------------------------
# GC stress (req #19, #20, #54): shared header Strings and per-row field
# Strings, reachable only through the constructed row tables, survive
# collection; lookups after a forced collection still succeed.

test csv-records-gc-stress-shared-headers-1 {header Strings reachable only through row tables survive GC; every row's lookup still succeeds} -setup {
    set ::env(BOTLISH_NATIVE_GC_STRESS) 1
} -cleanup {
    unset ::env(BOTLISH_NATIVE_GC_STRESS)
} -body {
    set text [genCsv {name age city} 30 {i {list "person$i" [expr {20 + $i}] "city$i"}}]
    native::evalHir [sourceHir "
fn checkRow(rows, i, n, ok):
    if i >= n:
        return ok
    r = list_get(rows, i)
    checkRow(rows, i + 1, n, ok and ht_contains(r, \"name\") and ht_contains(r, \"age\") and ht_contains(r, \"city\"))

fn f():
    rows = csv_records([corpus::literal $text])
    \[list_length(rows), checkRow(rows, 0, list_length(rows), true), ht_get(list_get(rows, 0), \"name\"), ht_get(list_get(rows, 29), \"city\")\]
f()
    "] -specialize 1
} -result {list {{int 30} {bool true} {str person0} {str city29}}}

test csv-records-gc-stress-nonascii-1 {non-ASCII headers/values survive GC while live only through row tables} -setup {
    set ::env(BOTLISH_NATIVE_GC_STRESS) 1
} -cleanup {
    unset ::env(BOTLISH_NATIVE_GC_STRESS)
} -body {
    set text "\u540d\u524d,\u90fd\u5e02\n\u30a2\u30ea\u30b9,M\u00fcnchen\n\u30dc\u30d6,\u30d1\u30ea\n"
    native::evalHir [sourceHir "
fn f():
    rows = csv_records([corpus::literal $text])
    r0 = list_get(rows, 0)
    r1 = list_get(rows, 1)
    \[ht_get(r0, [corpus::literal \u540d\u524d]), ht_get(r0, [corpus::literal \u90fd\u5e02]), ht_get(r1, [corpus::literal \u540d\u524d])\]
f()
    "] -specialize 1
} -result [list list [list [list str \u30a2\u30ea\u30b9] [list str M\u00fcnchen] [list str \u30dc\u30d6]]]

test csv-records-gc-stress-duplicate-ragged-1 {duplicate headers and ragged rows together survive GC and stay correct under it} -setup {
    set ::env(BOTLISH_NATIVE_GC_STRESS) 1
} -cleanup {
    unset ::env(BOTLISH_NATIVE_GC_STRESS)
} -body {
    set text "a,a,b,c\n1,2,3,4\n5,6\n7,8,9\n"
    native::evalHir [sourceHir "
fn f():
    rows = csv_records([corpus::literal $text])
    r0 = list_get(rows, 0)
    r1 = list_get(rows, 1)
    r2 = list_get(rows, 2)
    \[ht_get(r0, \"a\"), ht_size(r0), ht_get(r1, \"a\"), ht_contains(r1, \"b\"), ht_size(r1), ht_get(r2, \"a\"), ht_get(r2, \"b\"), ht_contains(r2, \"c\"), ht_size(r2)\]
f()
    "] -specialize 1
} -result {list {{str 2} {int 3} {str 6} {bool false} {int 1} {str 8} {str 9} {bool false} {int 2}}}

test csv-records-gc-stress-presized-1 {presized construction survives GC identically to the default variant} -setup {
    set ::env(BOTLISH_NATIVE_GC_STRESS) 1
} -cleanup {
    unset ::env(BOTLISH_NATIVE_GC_STRESS)
} -body {
    set text [genCsv {h0 h1 h2 h3 h4 h5 h6 h7} 25 {i {list a$i b$i c$i d$i e$i f$i g$i h$i}}]
    native::evalHir [sourceHir "
fn checkAll(rows, i, n, ok):
    if i >= n:
        return ok
    r = list_get(rows, i)
    checkAll(rows, i + 1, n, ok and ht_size(r) == 8 and ht_capacity(r) >= 8)

fn f():
    rows = csv_records_presized([corpus::literal $text])
    \[list_length(rows), checkAll(rows, 0, list_length(rows), true)\]
f()
    "] -specialize 1
} -result {list {{int 25} {bool true}}}

test csv-records-gc-stress-allocation-consistency-1 {allocation report stays internally consistent (peak live >= current live, at least one GC cycle) under stress} -body {
    set ::env(BOTLISH_NATIVE_GC_STRESS) 1
    set text [genCsv {name age city} 60 {i {list "p$i" $i "c$i"}}]
    set report [allocationsOf "list_length(csv_records([corpus::literal $text]))"]
    unset ::env(BOTLISH_NATIVE_GC_STRESS)
    set total [dict get $report total]
    list [expr {[dict get $total peakLiveObjects] >= [dict get $total currentLiveObjects]}] \
        [expr {[dict get $report gc cycles] > 0}]
} -result {1 1}

# ---------------------------------------------------------------------------
# Astral-plane Unicode (req #12: "\U0001F642" / a face emoji): under Tcl 9
# (core/core.tcl requires it -- see the README's introduction), a
# supplementary-plane codepoint is one Tcl character, i.e. one Unicode
# scalar value, exactly like Rust's str::chars(). hash()/== operate on
# UTF-8-encoded bytes either way (core/hashing.tcl's Utf8Bytes), and
# length() now agrees too: every backend counts the emoji as 1, not the
# surrogate-pair-derived 2 that a Tcl 8.6 build (no full-Unicode support)
# used to give the Tcl-hosted backends. Verified below to parity-agree on
# all four backends for ht_get/ht_contains and length(), keyed and valued
# by the emoji itself.

set ::astralEmoji [encoding convertfrom utf-8 "\xf0\x9f\x99\x82"]

test csv-records-astral-1 {an astral-plane emoji as both a header name and a field value: round-trips correctly and agrees on every backend} -body {
    set csvText "label,$::astralEmoji\nok,$::astralEmoji\n"
    parity "fn f():\n    rows = csv_records([corpus::literal $csvText])\n    r = list_get(rows, 0)\n    \[ht_get(r, \"label\"), ht_contains(r, [corpus::literal $::astralEmoji]), ht_get(r, [corpus::literal $::astralEmoji]) == [corpus::literal $::astralEmoji]\]\nf()"
} -result same

test csv-records-astral-2 {the emoji round-trips to its correct 4-byte UTF-8 encoding on the native backend} -body {
    set csvText "mood,note\n$::astralEmoji,cheerful\n"
    native "fn f():\n    rows = csv_records([corpus::literal $csvText])\n    ht_get(list_get(rows, 0), \"mood\")\nf()"
} -result [list value "\"$::astralEmoji\""]

test csv-records-astral-length-1 {length() of the astral-plane emoji is one Unicode scalar value, agreeing on every backend} -body {
    list [parity "length([corpus::literal $::astralEmoji])"] \
         [native "length([corpus::literal $::astralEmoji])"]
} -result {same {value 1}}

# ---------------------------------------------------------------------------
# Allocation-site attribution (req #42): sites mode names the expected
# categories of allocation for a representative small workload -- CSV
# substring/strcat, HashTable/outer-builder MutableArray allocation. A
# smoke test (the exact counts are the benchmark's job, bench/csv_records.tcl),
# checking the operation vocabulary sites mode actually reports.

test csv-records-sites-1 {sites mode reports CSV scanning and MutableArray-allocation operations for a small representative row-table build} -body {
    set text [genCsv {a b c} 5 {i {list x$i y$i z$i}}]
    set report [native::allocationReport [sourceHir "list_length(csv_records([corpus::literal $text]))"] sites]
    set ops [lsort -unique [lmap s [dict get $report sites] {dict get $s operation}]]
    list [expr {"strcat" in $ops || "substr" in $ops}] [expr {"mutarrayallocate" in $ops}]
} -result {1 1}

# ---------------------------------------------------------------------------
# Specialization / representation-optimization flags (req #64): correctness
# is unchanged with either disabled, like native-hashtable.test's own pair.

test csv-records-specialize-off-1 {-specialize 0 gives the same result as the default} -body {
    set text {
fn f():
    rows = csv_records("h0,h1\na,b\nc,d\n")
    r1 = list_get(rows, 1)
    [list_length(rows), ht_get(r1, "h0"), ht_get(r1, "h1")]
f()
    }
    set hir [sourceHir $text]
    list [native::evalHir $hir] [native::evalHir $hir -specialize 0]
} -result {{list {{int 2} {str c} {str d}}} {list {{int 2} {str c} {str d}}}}

test csv-records-repr-opt-off-1 {-repr-opt 0 gives the same result as the default, including across a resize} -body {
    set text {
fn f():
    rows = csv_records_presized("h0,h1,h2,h3,h4,h5,h6,h7,h8,h9,h10,h11\na,b,c,d,e,f,g,h,i,j,k,l\n")
    r = list_get(rows, 0)
    [ht_size(r), ht_capacity(r), ht_get(r, "h11")]
f()
    }
    set hir [sourceHir $text]
    list [native::evalHir $hir] [native::evalHir $hir -repr-opt 0]
} -result {{list {{int 12} {int 32} {str l}}} {list {{int 12} {int 32} {str l}}}}

# ---------------------------------------------------------------------------
# Property/differential test (req #37-#39): a deterministic generated CSV
# (ragged rows, a duplicate header, some empty fields) is applied to a plain
# Tcl reference model (an ordered list of Tcl dicts, one per row, built by
# the identical row-shape/duplicate-header policy -- never the Botlish
# HashTable implementation, per req #38's "the correctness oracle should not
# reuse" rule) and compared field-by-field against the Botlish result, for
# both the default and presized variants.

# HEADERS applied to FIELDS (Tcl lists) by this workload's own row-shape
# policy: headers[0..min(len(fields),len(headers))) -> the corresponding
# field, later duplicates of the same header replacing earlier ones.
proc referenceRow {headers fields} {
    set row [dict create]
    set n [expr {min([llength $headers], [llength $fields])}]
    for {set i 0} {$i < $n} {incr i} {
        dict set row [lindex $headers $i] [lindex $fields $i]
    }
    return $row
}

# A deterministic ragged/duplicate-header dataset: HEADERS has one
# deliberately repeated name ("dup"); each row's field count cycles through
# every length from 0 to the header count (never more, so no RANGE error --
# the long-row error path is covered directly in tests/stdlib.test).
proc genPropertyDataset {seed rows} {
    set headers {a dup b dup c}
    set headerCount [llength $headers]
    set state $seed
    set lines [list [join $headers ,]]
    set refRows {}
    for {set i 0} {$i < $rows} {incr i} {
        set state [expr {($state * 1103515245 + 12345) % 2147483648}]
        set fieldCount [expr {$state % ($headerCount + 1)}]
        set fields {}
        for {set j 0} {$j < $fieldCount} {incr j} {
            lappend fields "r${i}f${j}"
        }
        lappend lines [join $fields ,]
        # csv.bot's own documented rule: "an empty line is a record with one
        # empty field", not zero fields -- a fieldCount of 0 produces an
        # empty CSV line, which csv_parse itself turns into [""], one field,
        # not []. The reference model must apply the identical row-shape
        # policy to what will actually be parsed, not to fieldCount as
        # generated (req #38: the oracle mirrors the real input, not the
        # generator's own bookkeeping).
        set parsedFields $fields
        if {$fieldCount == 0} {
            set parsedFields [list ""]
        }
        lappend refRows [referenceRow $headers $parsedFields]
    }
    return [list "[join $lines \n]\n" $refRows $headers]
}

# For every reference row, checks every header's expected presence/value
# (by ht_contains/ht_get) against Botlish row R (an already-list_get'd
# table), returning a Tcl boolean list-of-checks flattened to 1/0 so a
# single Botlish driver call can verify a whole dataset in one native run
# (far cheaper than one test per row/header pair).
# One Botlish driver expression checking every header of every reference
# row against the constructed table (ht_get/ht_contains/ht_size), "and"
# -reduced into a single boolean -- one native run verifies a whole dataset
# instead of one test per row/header pair.
proc propertyDriver {presized text headers refRows} {
    set ctor [expr {$presized ? "csv_records_presized" : "csv_records"}]
    set rowExprs {}
    set rowIndex 0
    foreach ref $refRows {
        set rowChecks {}
        foreach h $headers {
            if {[dict exists $ref $h]} {
                lappend rowChecks "ht_get(list_get(rows, $rowIndex), [corpus::literal $h]) == [corpus::literal [dict get $ref $h]]"
            } else {
                lappend rowChecks "ht_contains(list_get(rows, $rowIndex), [corpus::literal $h]) == false"
            }
        }
        lappend rowChecks "ht_size(list_get(rows, $rowIndex)) == [dict size $ref]"
        lappend rowExprs "([join $rowChecks { and }])"
        incr rowIndex
    }
    # Botlish's indentation-sensitive surface syntax does not continue a
    # statement across a bare newline, so the whole "and"-reduced check
    # stays on one (long) logical line.
    set allExpr [join $rowExprs " and "]
    return "fn f():\n    rows = ${ctor}([corpus::literal $text])\n    [expr {$rowExprs eq {} ? {true} : "$allExpr"}]\nf()\n"
}

proc propertyCheck {presized seed rows} {
    lassign [genPropertyDataset $seed $rows] text refRows headers
    return [native::evalHir [sourceHir [propertyDriver $presized $text $headers $refRows]]]
}

test csv-records-property-default-1 {40 generated ragged/duplicate-header rows match the Tcl reference model, default table construction} -body {
    propertyCheck 0 1 40
} -result {bool true}

test csv-records-property-presized-1 {the same generated rows match the reference model with presized table construction} -body {
    propertyCheck 1 1 40
} -result {bool true}

test csv-records-property-default-2 {a different seed, more rows} -body {
    propertyCheck 0 7 150
} -result {bool true}

test csv-records-property-presized-2 {the same larger dataset, presized} -body {
    propertyCheck 1 7 150
} -result {bool true}

cleanupTests
