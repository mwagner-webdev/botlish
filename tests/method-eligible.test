# ---------------------------------------------------------------------------
# Interleaving with SAME-RETURN-VALUE, ordering, the policy matrix

set ::twoSource "${::prelude}fn dup(x):
    if x < 0:
        return 0
    if x > 100:
        return 0
    return 1
fn t(x):
    return two(x, 1)
t(5)"

test me-interleaving-with-same-return-value {both warnings appear, in source order, deterministically} -body {
    set hir [compileWith $::twoSource default]
    lmap w [ownWarnings $hir] {
        list [dict get $w code] [regsub {^t\.bot:} [hir::originLocation $hir [dict get $w primary]] {}]
    }
} -result {{SAME-RETURN-VALUE 7:9} {METHOD-ELIGIBLE 12:12}}

test me-interleaving-methodfirst {a METHOD-ELIGIBLE warning that precedes a SAME-RETURN-VALUE one sorts first} -body {
    set source "${::prelude}fn t(x):
    return two(x, 1)
fn dup(x):
    if x < 0:
        return 0
    if x > 100:
        return 0
    return 1
t(5)"
    lmap w [warningsOf $source] {dict get $w code}
} -result {METHOD-ELIGIBLE SAME-RETURN-VALUE}

test me-interleaving-deterministic {compiling the same source twice yields the same warnings} -body {
    expr {[warningsOf $::twoSource] eq [warningsOf $::twoSource]}
} -result 1

test me-mode-default {default: compiles, and the program carries the warning} -body {
    set hir [compileWith $::twoSource default]
    list [lmap w [ownWarnings $hir] {dict get $w code}] [rejection $::twoSource default]
} -result {{SAME-RETURN-VALUE METHOD-ELIGIBLE} compiled}

test me-mode-off {off: compiles, and nothing is reported} -body {
    set hir [compileWith $::twoSource off]
    list [hir::warnings::of $hir] [dict exists $hir warnings]
} -result {{} 0}

test me-mode-error-only-method-eligible {error: a program with only this warning is rejected with the warning's own code} -body {
    set source "${::prelude}fn t(x):
    return two(x, 1)
t(5)"
    lassign [rejection $source error] code message
    list $code $message
} -result {{CORE SEMANTIC METHOD-ELIGIBLE} {t.bot:6:12: call to `two` is eligible for method syntax}}

test me-mode-error-first-in-sort-order {error with both warnings: exactly one error, the sort-first, with its own code} -body {
    list [lindex [rejection $::twoSource error] 0] \
        [lindex [rejection "${::prelude}fn t(x):
    return two(x, 1)
fn dup(x):
    if x < 0:
        return 0
    if x > 100:
        return 0
    return 1
t(5)" error] 0]
} -result {{CORE SEMANTIC SAME-RETURN-VALUE} {CORE SEMANTIC METHOD-ELIGIBLE}}

test me-mode-error-clean-program {error mode accepts a program with no warning} -body {
    rejection "${::prelude}fn t(x):
    return one(x)
t(5)" error
} -result compiled

test me-mode-default-is-the-default {no option and no environment setting means warnings on, as warnings} -body {
    set saved $::env(BOTLISH_WARNINGS)
    unset ::env(BOTLISH_WARNINGS)
    try {
        set hir [surface::compile $::twoSource t.bot -warning-channel ""]
        llength [hir::warnings::of $hir]
    } finally {
        set ::env(BOTLISH_WARNINGS) $saved
    }
} -result 2

test me-environment-default {BOTLISH_WARNINGS is only the default for a compilation given no -warnings} -body {
    set saved $::env(BOTLISH_WARNINGS)
    try {
        set results {}
        foreach mode {default off error} {
            set ::env(BOTLISH_WARNINGS) $mode
            lappend results [catch {surface::compile $::twoSource t.bot -warning-channel ""} message] \
                [catch {surface::compile $::twoSource t.bot -warnings off -warning-channel ""}]
        }
        set results
    } finally {
        set ::env(BOTLISH_WARNINGS) $saved
    }
} -result {0 0 0 0 1 0}

test me-unknown-mode {a mode outside default/off/error is a plain usage error} -body {
    surface::compile $::twoSource t.bot -warnings -Wall -warning-channel ""
} -returnCodes error -match glob -result {unknown warnings mode "-Wall" (known: default, off, error)}

test me-no-fine-grained-options {there is no per-warning option: -Wno-method-eligible is not an option} -body {
    surface::compile $::twoSource t.bot -Wno-method-eligible 1
} -returnCodes error -match glob -result {*unknown option "-Wno-method-eligible"*}

test me-no-new-modes-or-options {the policy surface is exactly default, off, error and the one option} -body {
    list $hir::warnings::modes [expr {[llength [info commands hir::warnings::enable]] + [llength [info commands hir::warnings::disable]]}]
} -result {{default off error} 0}

test me-error-promotion-identity {the promoted error keeps the code and the message the warning has} -body {
    set source "${::prelude}fn t(x):
    return two(x, 1)
t(5)"
    set hir [compileWith $source default]
    set w [lindex [ownWarnings $hir] 0]
    lassign [rejection $source error] code message
    list [lindex $code end] [dict get $w code] [string match "*[dict get $w message]*" $message]
} -result {METHOD-ELIGIBLE METHOD-ELIGIBLE 1}

test me-off-runs-no-warning-pass {warnings off does not execute the warning pass at all (default does)} -body {
    set source "${::prelude}fn t(x):
    return two(x, 1)"
    hir::warnings::resetStats
    compileWith $source off
    set afterOff [hir::warnings::stats]
    compileWith $source default
    set afterDefault [hir::warnings::stats]
    list $afterOff $afterDefault [dict exists $afterOff METHOD-ELIGIBLE] [dict get $afterDefault METHOD-ELIGIBLE]
} -result {{} {SAME-RETURN-VALUE 1 METHOD-ELIGIBLE 1 FIXED-ARITY-LIST-RETURN 1 SAME-FAILURE 1 PROVES-NAMING 1 ONE-CHAR-STRING-LITERAL 1} 0 1}

test me-off-runs-no-warning-pass-via-trace {an execution trace on the pass proves it is not invoked when off} -body {
    set source "${::prelude}fn t(x):
    return two(x, 1)"
    set ::passCalls 0
    trace add execution hir::warnings::MethodEligible enter {apply {{args} {incr ::passCalls}}}
    try {
        compileWith $source off
        set off $::passCalls
        compileWith $source default
        set on $::passCalls
    } finally {
        trace remove execution hir::warnings::MethodEligible enter {apply {{args} {incr ::passCalls}}}
    }
    list $off $on
} -result {0 1}

test me-compilation-with-errors-has-no-warnings {a program the compiler rejects is never warned about} -body {
    set hir [surface::compile "${::prelude}fn t(x):
    return two(x, 1)
nothing" t.bot -strict 0 -warnings default -warning-channel ""]
    list [llength [hir::diagnostics $hir]] [hir::warnings::of $hir]
} -result {1 {}}

test me-policy-is-per-compilation {interleaved compilations under different modes never leak a mode} -body {
    set source "${::prelude}fn t(x):
    return two(x, 1)"
    set a [compileWith $source off]
    set b [compileWith $source default]
    set c [catch {compileWith $source error}]
    set d [compileWith $source off]
    set e [compileWith $source default]
    list [llength [ownWarnings $a]] [llength [ownWarnings $b]] $c [llength [ownWarnings $d]] [llength [ownWarnings $e]]
} -result {0 1 1 0 1}

test me-warnings-attached-structurally {hir::warnings::of and collect give the warnings structurally} -body {
    set hir [compileWith $::twoSource default]
    list [expr {[hir::warnings::of $hir] eq [hir::warnings::collect $hir]}] [llength [hir::warnings::collect $hir]]
} -result {1 2}

test me-error-stops-before-backend {error mode rejects before any backend lowers anything} -body {
    set source "${::prelude}fn t(x):
    return two(x, 1)
t(5)"
    set ::lowerCalls 0
    foreach command {native::evalHir native::prepareHir hir::lower core::compiler::evalHir} {
        trace add execution $command enter {apply {{args} {incr ::lowerCalls}}}
    }
    try {
        catch {compileWith $source error}
    } finally {
        foreach command {native::evalHir native::prepareHir hir::lower core::compiler::evalHir} {
            trace remove execution $command enter {apply {{args} {incr ::lowerCalls}}}
        }
    }
    set ::lowerCalls
} -result 0

# ---------------------------------------------------------------------------
# Backend independence: warnings are discovered before a backend is chosen

set ::runSource "${::prelude}fn t(x):
    return two(x, 1)
t(5)"

test me-backend-independent {every backend runs the program, and sees the one warning set} -body {
    set hir [compileWith $::runSource default]
    set outcomes [lmap backend $::allBackends {outcomeUnderHir $backend $hir}]
    list [llength [lsort -unique [lmap o $outcomes {lindex $o 1}]]] [lindex $outcomes 0 1] [llength [ownWarnings $hir]]
} -result {1 5 1}

test me-backend-independent-off {the same program runs identically on every backend with warnings off} -body {
    set hir [compileWith $::runSource off]
    lsort -unique [lmap backend $::allBackends {lindex [outcomeUnderHir $backend $hir] 1}]
} -result 5

test me-sugared-and-functional-run-identically {both spellings give the same value on every backend} -body {
    set sugared "${::prelude}fn t(x):
    return x.two(1)
t(5)"
    lsort -unique [lmap backend $::allBackends {
        list [lindex [outcomeUnderHir $backend [compileWith $::runSource off]] 1] \
            [lindex [outcomeUnderHir $backend [compileWith $sugared off]] 1]
    }]
} -result {{5 5}}

# ---------------------------------------------------------------------------
# The command line

test me-cli-modes {main.tcl: default prints the warning on stderr and runs; off is silent; error rejects before running} -constraints executableAot -body {
    set main [file join $::projectRoot main.tcl]
    set path [makeFile $::runSource me-cli.bot]
    set results {}
    foreach mode {default off error} {
        set status [catch {exec [info nameofexecutable] $main -warnings $mode $path 2>@1} out]
        lappend results [list $mode $status \
            [regexp {warning: call to `two` is eligible for method syntax \(METHOD-ELIGIBLE\)} $out] \
            [regexp {value: 5} $out] \
            [regexp {CORE SEMANTIC METHOD-ELIGIBLE} $out]]
    }
    removeFile me-cli.bot
    set results
} -result {{default 0 1 1 0} {off 0 0 1 0} {error 1 0 0 1}}

test me-cli-no-wno-option {-Wno-method-eligible is an unknown option, not a file name} -constraints executableAot -body {
    set main [file join $::projectRoot main.tcl]
    set path [makeFile $::runSource me-cli-wno.bot]
    catch {exec [info nameofexecutable] $main -Wno-method-eligible $path 2>@1} out
    removeFile me-cli-wno.bot
    list [string match "*unknown option*-Wno-method-eligible*" $out] [string match "*value:*" $out]
} -result {1 0}

test me-cli-unknown-mode {main.tcl rejects an unknown mode} -constraints executableAot -body {
    set main [file join $::projectRoot main.tcl]
    set path [makeFile $::runSource me-cli-mode.bot]
    set status [catch {exec [info nameofexecutable] $main -warnings loud $path 2>@1} out]
    removeFile me-cli-mode.bot
    list $status [string match "*unknown warnings mode*" $out]
} -result {1 1}

test me-cli-stdout-clean {the warning goes to stderr: program stdout carries no warning text} -constraints executableAot -body {
    set main [file join $::projectRoot main.tcl]
    set path [makeFile $::runSource me-cli-stdout.bot]
    set stderrPath [makeFile {} me-cli-stderr.txt]
    set out [exec [info nameofexecutable] $main -warnings default $path 2> $stderrPath]
    set err [viewFile me-cli-stderr.txt]
    removeFile me-cli-stdout.bot
    removeFile me-cli-stderr.txt
    list [string match *warning* $out] [string match *METHOD-ELIGIBLE* $err]
} -result {0 1}

test me-error-cli-stops-before-backend {main.tcl -warnings error on a native backend rejects without lowering or running anything} -constraints executableAot -body {
    set main [file join $::projectRoot main.tcl]
    set path [makeFile $::runSource me-cli-error.bot]
    catch {exec [info nameofexecutable] $main -backend cranelift -warnings error $path 2>@1} out
    removeFile me-cli-error.bot
    list [string match "*value:*" $out] [regexp {\(CORE SEMANTIC METHOD-ELIGIBLE\)} $out]
} -result {0 1}

test me-cli-backend-independent-stdlib {main.tcl prints the same warning text on every backend over the whole stdlib corpus} -constraints executableAot -body {
    set main [file join $::projectRoot main.tcl]
    set programs [lsort [glob -directory [file join $::projectRoot examples stdlib] *.bot]]
    set mismatches {}
    set total 0
    foreach path $programs {
        set texts {}
        foreach backend $::allBackends {
            set err [makeFile {} me-cli-err.txt]
            catch {exec [info nameofexecutable] $main -backend $backend -warnings default $path 2> $err}
            lappend texts [lsearch -all -inline -glob [split [viewFile me-cli-err.txt] \n] *METHOD-ELIGIBLE*]
            removeFile me-cli-err.txt
        }
        incr total [llength [lindex $texts 0]]
        if {[llength [lsort -unique $texts]] != 1} {
            lappend mismatches [file tail $path]
        }
    }
    list $mismatches [expr {$total > 0}]
} -result {{} 1}

# ---------------------------------------------------------------------------
# Fuzzing: constructed programs, an independent oracle, all three modes

test me-fuzz-smoke {60 generated programs: predicted warnings and only them, off silent, error iff warned, every eligible call round-trips} -constraints executableAot -body {
    set fuzz [file join $::projectRoot audit method-eligible tools fuzz.tcl]
    exec [info nameofexecutable] $fuzz 60 1
} -result {seeds 60 (from 1): * with warnings, * without; failures 0; extra warnings 0; round trips *} -match glob

cleanupTests
