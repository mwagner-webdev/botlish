            lappend diffs $key
        }
    }
    set pv [core::formatValue [core::evalProgram [hir::lower [compileWith $plain off]]]]
    set mv [core::formatValue [core::evalProgram [hir::lower [compileWith $marked off]]]]
    list $diffs $pv $mv
} -result {{} 15 15}

