# method-eligible.test -- the METHOD-ELIGIBLE compiler warning and the
# `nomethod fn` declaration (WARNINGS-METHOD-ELIGIBLE.md), on the warning
# framework WARNINGS-SAME-RETURN.md built (hir/warnings.tcl).
#
# METHOD-ELIGIBLE: a reachable call *written* `f(x, y)` to a declared named
# function of at least 2 parameters, not `nomethod`, whose sugared spelling
# `x.f(y)` provably parses and resolves to the same callee. The warning is
# one-directional and silent wherever the compiler cannot prove the sugared
# spelling identical, so most cases here pin where it must NOT fire, and
# every case that fires is checked against the round-trip law:
#
#     the sugared spelling parses, resolves to the same callee, and compiles
#     to the same program (HIR text, core IR, NIR specialized and generic).
#
# Like warnings.test, every compile here passes its policy and channel
# explicitly (`-warnings MODE`, `-warning-channel ""` to collect without
# printing), so this file exercises default, off and error whatever the
# harness's process default is.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]

testConstraint executableAot [expr {$::tcl_platform(os) eq "Linux" &&
    $::tcl_platform(machine) in {x86_64 amd64}}]

set ::allBackends {interp compile cranelift-generic cranelift}

# The HIR of SOURCE under policy MODE (default off error), collecting
# warnings without printing them.
proc compileWith {source {mode default}} {
    return [surface::compile $source t.bot -warnings $mode -warning-channel ""]
}

# The METHOD-ELIGIBLE warnings of SOURCE's own file (t.bot): the warnings a
# library module the program loads carries are not what these tests are about.
# Nor are ONE-CHAR-STRING-LITERAL findings (WARNINGS-ONE-CHAR-STRING-LITERAL.md):
# a fact about a written literal (`"s"` as a receiver, `"x"` as an argument),
# which the functional and the sugared spelling carry alike.
proc ownWarnings {hir} {
    return [lmap w [hir::warnings::of $hir] {
        if {![string match t.bot:* [hir::originLocation $hir [dict get $w primary]]]
                || [dict get $w code] eq "ONE-CHAR-STRING-LITERAL"} continue
        set w
    }]
}

proc warningsOf {source} {
    return [ownWarnings [compileWith $source]]
}

# "LINE:COL" of each warning of SOURCE (own file), in order.
proc where {source} {
    set hir [compileWith $source]
    return [lmap w [ownWarnings $hir] {
        regsub {^t\.bot:} [hir::originLocation $hir [dict get $w primary]] {}
    }]
}

proc codes {source} {
    return [lmap w [warningsOf $source] {dict get $w code}]
}

# "MESSAGE @ LINE:COL" for each warning of SOURCE (own file).
proc shown {source} {
    set hir [compileWith $source]
    return [lmap w [ownWarnings $hir] {
        string cat [dict get $w message] " @ " [regsub {^t\.bot:} [hir::originLocation $hir [dict get $w primary]] {}]
    }]
}

# The rejection of SOURCE under MODE: {errorcode message}, or "compiled".
proc rejection {source mode} {
    if {[catch {compileWith $source $mode} message options]} {
        return [list [dict get $options -errorcode] $message]
    }
    return compiled
}

# The NIR text of HIR, or the error native lowering raised (both spellings of
# a program native cannot lower must fail the same way).
proc nirOf {hir args} {
    if {[catch {native::lower::program $hir {*}$args} result options]} {
        return [list error [dict get $options -errorcode] $result]
    }
    return [dict get $result text]
}

# What identifies SOURCE as a program: its HIR text, core IR and NIR
# (specialized and generic), computed right after it is compiled.
proc fingerprint {source} {
    set hir [compileWith $source off]
    return [dict create format [hir::format $hir] lower [hir::lower $hir] \
        nir [nirOf $hir] nirGeneric [nirOf $hir -specialize 0]]
}

# The ROUND-TRIP LAW for one call: "" if SUGARED (a program) parses, compiles
# without warning, and is the same program as FUNCTIONAL -- the same HIR text
# (so the same callee: HIR text prints each call's target), core IR and NIR
# specialized and generic; else what differs.
proc roundTrip {functional sugared} {
    if {[catch {fingerprint $sugared} s]} {
        return [list does-not-compile $s]
    }
    set f [fingerprint $functional]
    set diffs {}
    foreach key {format lower nir nirGeneric} {
        if {[dict get $f $key] ne [dict get $s $key]} {
            lappend diffs $key
        }
    }
    if {[codes $sugared] ne ""} {
        lappend diffs [list sugared-warns [codes $sugared]]
    }
    return $diffs
}

# SCRIPT evaluated with ::core::libraryDir a scratch directory holding the
# modules FILES ({NAME.bot TEXT ...}), restored afterwards.
proc withModules {files script} {
    set saved $::core::libraryDir
    set dir [makeDirectory me-scratch-[pid]]
    set ::core::libraryDir $dir
    try {
        foreach {name text} $files {
            set channel [open [file join $dir $name] w]
            puts -nonewline $channel $text
            close $channel
        }
        uplevel 1 $script
    } finally {
        set ::core::libraryDir $saved
        removeDirectory me-scratch-[pid]
    }
}

# The program at PATH compiled under MODE; "LOCATION" of each warning relative
# to DIR.
proc fileWarnings {path dir {mode default}} {
    set hir [surface::readProgramFile $path -warnings $mode -warning-channel ""]
    return [lmap w [hir::warnings::of $hir] {
        string map [list $dir/ {}] [hir::originLocation $hir [dict get $w primary]]
    }]
}

# Two functions every program below can call: `two` takes 2 parameters, `one`
# takes 1.
set ::prelude {fn two(a, b):
    a
fn one(a):
    a
}

# ---------------------------------------------------------------------------
# The rules: written functional call, at least two parameters

test me-core-example {fn any(xs, p) called as any(xs, hit?) warns; the message names the callee} -body {
    shown {fn any(xs, p):
    xs
fn hit?(x):
    x
fn any_hit(xs):
    return any(xs, hit?)}
} -result {{call to `any` is eligible for method syntax @ 6:12}}

test me-sugared-spelling-silent {the same program spelled with sugar is silent} -body {
    shown {fn any(xs, p):
    xs
fn hit?(x):
    x
fn any_hit(xs):
    return xs.any(hit?)}
} -result {}

test me-both-spellings-once {the same call written both ways in one program warns exactly once} -body {
    shown "${::prelude}fn t(x):
    two(x, 1)
    x.two(1)"
} -result {{call to `two` is eligible for method syntax @ 6:5}}

test me-three-params-warns {a 3-parameter function warns too} -body {
    shown {fn three(a, b, c):
    a
fn t(x):
    return three(x, 1, 2)}
} -result {{call to `three` is eligible for method syntax @ 4:12}}

test me-one-param-never-warns {a 1-parameter function (length-shaped) never warns} -body {
    codes "${::prelude}fn t(x):
    return one(x)"
} -result {}

test me-parameter-count-boundary {exactly 1 parameter: silent; exactly 2: warns; 3: warns; 4: warns} -body {
    set program {fn f1(a):
    a
fn f2(a, b):
    a
fn f3(a, b, c):
    a
fn f4(a, b, c, d):
    a
fn t(x):
    f1(x)
    f2(x, 1)
    f3(x, 1, 2)
    f4(x, 1, 2, 3)
    0}
    set hir [compileWith $program]
    lmap w [ownWarnings $hir] {list [dict get $w data functionName] [dict get $w data paramCount]}
} -result {{f2 2} {f3 3} {f4 4}}

test me-one-param-sugar-stays-legal {the language still accepts one-parameter sugar: the rule is in the warning, not the grammar} -body {
    list [codes "${::prelude}fn t(x):
    return x.one()"] [roundTrip "${::prelude}fn t(x):
    return one(x)
t(1)" "${::prelude}fn t(x):
    return x.one()
t(1)"]
} -result {{} {}}

test me-one-param-via-module {a one-parameter module function and a one-parameter intrinsic never warn} -body {
    withModules {m.bot {fn one(a):
    a
}} {
        list [codes {import m
import str
fn t(x, s):
    m::one(x)
    str::length(s)
    0}]
    }
} -result {{}}

test me-flags-do-not-count {a function with one ordinary parameter and a flag is a one-parameter function} -body {
    codes {fn q(a, flags :quiet):
    a
fn t(x):
    return q(x, :quiet)}
} -result {}

test me-call-with-flags-warns {two ordinary parameters and a flag: warns, and the flagged sugar is the same program} -body {
    set decl {fn q(a, b, flags :quiet):
    a
}
    list [codes "${decl}fn t(x):
    return q(x, 1, :quiet)"] [roundTrip "${decl}fn t(x):
    return q(x, 1, :quiet)
t(1)" "${decl}fn t(x):
    return x.q(1, :quiet)
t(1)"]
} -result {METHOD-ELIGIBLE {}}

test me-variadic-native-never {a variadic native has no fixed parameter count: never a candidate} -body {
    codes {fn t(x):
    return list(x, 1, 2)}
} -result {}

# ---------------------------------------------------------------------------
# Chains, granularity, ordering

test me-chain-two-warnings {a chain of functional calls: one warning per written call, in source order} -body {
    shown {fn map(xs, f):
    xs
fn find(xs, p):
    xs
fn norm(x):
    x
fn ok?(x):
    x
fn first(xs):
    return find(map(xs, norm), ok?)}
} -result {{call to `find` is eligible for method syntax @ 10:12} {call to `map` is eligible for method syntax @ 10:17}}

test me-chain-fully-sugared-is-silent {the fully sugared chain is silent, and is the same program} -body {
    set decls {fn map(xs, f):
    xs
fn find(xs, p):
    xs
fn norm(x):
    x
fn ok?(x):
    x
}
    list [codes "${decls}fn first(xs):
    return xs.map(norm).find(ok?)"] [roundTrip "${decls}fn first(xs):
    return find(map(xs, norm), ok?)
first(1)" "${decls}fn first(xs):
    return xs.map(norm).find(ok?)
first(1)"]
} -result {{} {}}

test me-no-grouping-one-per-call {each eligible call is its own warning: identical calls are not deduplicated} -body {
    shown "${::prelude}fn t(x):
    two(x, 1)
    two(x, 1)
    two(x, 1)"
} -result {{call to `two` is eligible for method syntax @ 6:5} {call to `two` is eligible for method syntax @ 7:5} {call to `two` is eligible for method syntax @ 8:5}}

test me-source-order {warnings come in source order whatever the function order} -body {
    where "${::prelude}fn late(x):
    two(x, 1)
fn early(x):
    two(x, 2)"
} -result {6:5 8:5}

test me-record-shape {the record is {code message primary secondary data}: secondary is empty, data carries the facts} -body {
    set hir [compileWith "${::prelude}fn t(x):
    return two(x, 1)"]
    set w [lindex [ownWarnings $hir] 0]
    set data [dict get $w data]
    list [lsort [dict keys $w]] [dict get $w code] [dict get $w secondary] \
        [dict get $data functionName] [dict get $data paramCount] [dict get $data receiverForm] \
        [lindex [dict get $data function] 0] \
        [dict get $hir exprs [dict get $data call] kind] [dict get $hir exprs [dict get $data receiver] kind] \
        [expr {[dict get $hir exprs [dict get $data call] origin] eq [dict get $w primary]}] \
        [lsort [dict keys $data]]
} -result {{code data message primary secondary} METHOD-ELIGIBLE {} two 2 name block call ref 1 {call function functionName paramCount receiver receiverForm}}

test me-data-function-is-the-callee-block {data function names the callee's block ExprId} -body {
    set hir [compileWith "${::prelude}fn t(x):
    return two(x, 1)"]
    set w [lindex [ownWarnings $hir] 0]
    lassign [dict get $w data function] kind block
    list $kind [dict get $hir exprs $block kind] [llength [dict get $hir exprs $block params]]
} -result {block block 2}

test me-data-has-no-rewrite {the structured data carries facts, never rewritten source text} -body {
    set hir [compileWith "${::prelude}fn t(x):
    return two(x, 1)"]
    set data [dict get [lindex [ownWarnings $hir] 0] data]
    set text [join [dict values $data] " "]
    list [string match *x.two* $text] [string match *.two(* $text]
} -result {0 0}

test me-rendering {rendered as FILE:LINE:COL: warning: MESSAGE (CODE), with no note line} -body {
    set hir [compileWith "${::prelude}fn t(x):
    return two(x, 1)"]
    hir::warnings::render $hir [lindex [ownWarnings $hir] 0]
} -result {t.bot:6:12: warning: call to `two` is eligible for method syntax (METHOD-ELIGIBLE)}

test me-message-is-neutral {the message states eligibility: no rewrite, no imperative, no location, no code} -body {
    set text [join [lmap w [warningsOf "${::prelude}fn t(x):
    return two(x, 1)"] {dict get $w message}] \n]
    set prescriptive 0
    foreach word {use prefer should rewrite replace instead change write ( ) x.two t.bot METHOD-ELIGIBLE} {
        if {[string match -nocase *$word* $text]} {
            incr prescriptive
        }
    }
    list $text $prescriptive
} -result {{call to `two` is eligible for method syntax} 0}

test me-no-fixit-or-rewrite-in-output {no stderr/stdout rendering prints a rewritten expression} -body {
    set hir [compileWith "${::prelude}fn t(x):
    return two(x, 1)"]
    set rendered [hir::warnings::render $hir [lindex [ownWarnings $hir] 0]]
    list [string match *x.two* $rendered] [string match *fixit* $rendered]
} -result {0 0}

# ---------------------------------------------------------------------------
# Receiver forms: the grammar's own receiver rule
#
#   postfix = primary { "(" args ")" | "." IDENT [ "(" args ")" ] }
#   primary = literal | name | qualified name | list | struct | "(" expr ")"
#
# Each row: the form -> eligible? A *eligible* row is exercised by a literal
# sugared program that parses, resolves to the same callee and compiles to
# the same program (the round-trip law).

proc formRow {functional sugared} {
    set drive "\nt(5)"
    return [list [codes $functional] [roundTrip "$functional$drive" "$sugared$drive"]]
}

test me-form-name {a plain name is a receiver} -body {
    formRow "${::prelude}fn t(x):
    return two(x, 1)" "${::prelude}fn t(x):
    return x.two(1)"
} -result {METHOD-ELIGIBLE {}}

test me-form-field-chain {a field chain is a receiver} -body {
    set program "${::prelude}fn t(n):
    s = {a: {b: n}}
    return two(s.a.b, 2)"
    formRow $program "${::prelude}fn t(n):
    s = {a: {b: n}}
    return s.a.b.two(2)"
} -result {METHOD-ELIGIBLE {}}

test me-form-call-result {a call result is a receiver (and the 1-parameter call inside it is not a finding)} -body {
    formRow "${::prelude}fn t(x):
    return two(one(x), 1)" "${::prelude}fn t(x):
    return one(x).two(1)"
} -result {METHOD-ELIGIBLE {}}

test me-form-method-call-result {a method-call result is a receiver} -body {
    formRow "${::prelude}fn t(x):
    return two(x.one(), 1)" "${::prelude}fn t(x):
    return x.one().two(1)"
} -result {METHOD-ELIGIBLE {}}

test me-form-parenthesized-call {a parenthesized call is the call: parentheses are not part of a node} -body {
    formRow "${::prelude}fn t(x):
    return two((one(x)), 1)" "${::prelude}fn t(x):
    return (one(x)).two(1)"
} -result {METHOD-ELIGIBLE {}}

test me-form-int-literal {an Int literal is a receiver: Botlish has no float literal, so `5.f` cannot re-lex} -body {
    formRow "${::prelude}fn t(x):
    return two(5, x)" "${::prelude}fn t(x):
    return 5.two(x)"
} -result {METHOD-ELIGIBLE {}}

test me-form-string-literal {a String literal is a receiver} -body {
    formRow "${::prelude}fn t(x):
    return two(\"s\", x)" "${::prelude}fn t(x):
    return \"s\".two(x)"
} -result {METHOD-ELIGIBLE {}}

test me-form-char-literal {a UnicodeChar literal is a receiver} -body {
    formRow "${::prelude}fn t(x):
    return two('a', x)" "${::prelude}fn t(x):
    return 'a'.two(x)"
} -result {METHOD-ELIGIBLE {}}

test me-form-bool-and-unit {true, false and unit are receivers} -body {
    list [formRow "${::prelude}fn t(x):
    return two(true, x)" "${::prelude}fn t(x):
    return true.two(x)"] [formRow "${::prelude}fn t(x):
    return two(unit, x)" "${::prelude}fn t(x):
    return unit.two(x)"]
} -result {{METHOD-ELIGIBLE {}} {METHOD-ELIGIBLE {}}}

test me-form-list-literal {a list literal is a receiver} -body {
    formRow "${::prelude}fn t(x):
    return two(\[1, 2\], x)" "${::prelude}fn t(x):
    return \[1, 2\].two(x)"
} -result {METHOD-ELIGIBLE {}}

test me-form-anonymous-struct {an anonymous struct literal is a receiver} -body {
    formRow "${::prelude}fn t(x):
    return two({a: 1}, x)" "${::prelude}fn t(x):
    return {a: 1}.two(x)"
} -result {METHOD-ELIGIBLE {}}

test me-form-named-struct {a named struct construction is a receiver} -body {
    set decl "struct P:\n    a: int\n$::prelude"
    formRow "${decl}fn t(x):
    return two(P {a: 1}, x)" "${decl}fn t(x):
    return P {a: 1}.two(x)"
} -result {METHOD-ELIGIBLE {}}

test me-form-qualified-name {a module-qualified name is a receiver} -body {
    withModules {m.bot {value = 7
}} {
        formRow "import m
${::prelude}fn t(x):
    return two(m::value, x)" "import m
${::prelude}fn t(x):
    return m::value.two(x)"
    }
} -result {METHOD-ELIGIBLE {}}

test me-form-receiver-forms-recorded {data receiverForm classifies the receiver the grammar accepted} -body {
    set program "struct P:
    a: int
${::prelude}fn t(x):
    s = {a: x}
    two(x, 1)
    two(s.a, 1)
    two(one(x), 1)
    two(x.one(), 1)
    two(5, 1)
    two(\"s\", 1)
    two('a', 1)
    two(\[1\], 1)
    two({a: 1}, 1)
    two(P {a: 1}, 1)
    two(true, 1)
    0"
    lmap w [warningsOf $program] {
        dict get $w data receiverForm
    }
} -result {name field call method-call literal literal literal list struct struct name}

# Receivers that are not, as written, a postfix/primary expression need added
# parentheses: `.` binds tighter than every operator.

test me-form-negative-literal-not-eligible {a negative literal is `-` applied to a literal: it would need parentheses} -body {
    codes "${::prelude}fn t(x):
    return two(-1, x)"
} -result {}

test me-form-negative-without-parens-means-something-else {`-1.two(x)` is `-(1.two(x))`: not the same program} -body {
    set functional "${::prelude}fn t(x):
    return two(-1, x)
t(5)"
    set sugared "${::prelude}fn t(x):
    return -1.two(x)
t(5)"
    expr {[roundTrip $functional $sugared] ne ""}
} -result 1

test me-form-negative-with-parens-is-valid-but-not-suggested {the parenthesized receiver is valid and identical: the silence is conservatism, not invalidity} -body {
    set functional "${::prelude}fn t(x):
    return two(-1, x)
t(5)"
    set sugared "${::prelude}fn t(x):
    return (-1).two(x)
t(5)"
    list [roundTrip $functional $sugared] [codes $functional]
} -result {{} {}}

test me-form-unary-minus-not-eligible {unary minus on a name is an operator expression} -body {
    codes "${::prelude}fn t(x):
    return two(-x, 1)"
} -result {}

test me-form-binary-operator-not-eligible {an arithmetic receiver is an operator expression (and `a + b.f()` means `a + (b.f())`)} -body {
    codes "${::prelude}fn t(x):
    return two(x + 1, 1)"
} -result {}

test me-form-parenthesized-operator-not-eligible {HIR records no parentheses: (x + 1) is the same node as x + 1, so it is not eligible either} -body {
    set program "${::prelude}fn t(x):
    return two((x + 1), 1)
t(5)"
    list [codes $program] [roundTrip $program "${::prelude}fn t(x):
    return (x + 1).two(1)
t(5)"]
} -result {{} {}}

test me-form-comparison-not-eligible {a comparison receiver is an operator expression} -body {
    codes "${::prelude}fn t(x):
    return two(x == 1, 1)"
} -result {}

test me-form-boolean-operators-not-eligible {not, and, or and != are conditions the frontend synthesizes: never receivers} -body {
    codes "${::prelude}fn t(x, y):
    two(not x, 1)
    two(x and y, 1)
    two(x or y, 1)
    two(x != y, 1)
    0"
} -result {}

test me-form-user-function-with-operator-inside-eligible {the call is eligible when only its *later* arguments are operator expressions} -body {
    shown "${::prelude}fn t(x):
    return two(x, x + 1)"
} -result {{call to `two` is eligible for method syntax @ 6:12}}

# ---------------------------------------------------------------------------
# Callees: qualified, imported, intrinsic, function values

test me-qualified-callee {mod::f(x, y) warns in the importing file when its sugared spelling resolves to the same function} -body {
    withModules {m.bot {fn two(a, b):
    a
}} {
        set program {import m
fn t(x):
    return m::two(x, 1)
t(5)}
        list [where $program] [roundTrip $program {import m
fn t(x):
    return x.two(1)
t(5)}]
    }
} -result {3:12 {}}

test me-qualified-callee-message-names-qualified-spelling {the message names the callee as written} -body {
    withModules {m.bot {fn two(a, b):
    a
}} {
        shown {import m
fn t(x):
    return m::two(x, 1)}
    }
} -result {{call to `m::two` is eligible for method syntax @ 3:12}}

test me-intrinsic-callee {a 2-parameter intrinsic warns when its namespace is imported} -body {
    set program {import str
fn t(s):
    return str::concat(s, "x")
t("a")}
    list [where $program] [roundTrip $program {import str
fn t(s):
    return s.concat("x")
t("a")}]
} -result {3:12 {}}

test me-intrinsic-one-param-silent {a 1-parameter intrinsic never warns} -body {
    codes {import str
fn t(s):
    return str::length(s)}
} -result {}

test me-imported-two-param-intrinsic-append {list::append(xs, v) warns} -body {
    set program {import list
fn t(xs):
    return list::append(xs, 1)
t([1])}
    list [where $program] [roundTrip $program {import list
fn t(xs):
    return xs.append(1)
t([1])}]
} -result {3:12 {}}

test me-module-warning-located-in-importing-file-and-module {a warning is located in the file its call is written in} -body {
    withModules {m.bot {fn helper(a, b):
    a

fn scan(n):
    loop i from 0 to n:
        helper(i, 1)
    0
}} {
        set path [makeFile {import m
fn t(x):
    return m::helper(x, 1)
m::scan(3)
} me-main.bot]
        try {
            lsort [lmap l [fileWarnings $path $::core::libraryDir default] {regsub {^.*/} $l {}}]
        } finally {
            removeFile me-main.bot
        }
    }
} -result {m.bot:6:9 me-main.bot:3:12}

test me-module-internal-sibling-call-in-loop {a module's own sibling call inside a loop is located in the module file} -body {
    withModules {m.bot {fn helper(a, b):
    a

fn scan(n):
    loop i from 0 to n:
        helper(i, 1)
    0
}} {
        set path [makeFile {import m
m::scan(3)
} me-main2.bot]
        try {
            fileWarnings $path $::core::libraryDir default
        } finally {
            removeFile me-main2.bot
        }
    }
} -result {m.bot:6:9}

test me-function-value-alias-never {a call through a binding that holds a function value never warns} -body {
    codes "${::prelude}g = two
fn t(x):
    return g(x, 1)"
} -result {}

test me-function-value-parameter-never {a parameter of function type is not a declared function} -body {
