# ---------------------------------------------------------------------------
# Provenance: how each call was written, recorded in every mode, invisible to
# everything downstream

proc writtenForms {hir} {
    set forms {}
    dict for {e node} [dict get $hir exprs] {
        if {[dict get $node kind] eq "call" && [dict exists $node written]} {
            lappend forms [dict get $node written form]
        }
    }
    return [lsort $forms]
}

set ::provenanceSource "${::prelude}fn t(x):
    a = two(x, 1)
    b = x.two(2)
    c = x + 1
    d = \[x, 1\]
    e = -x
    f = x != 1
    a
t(1)"

test me-provenance-recorded-by-form {each frontend-built call records how it was written} -body {
    writtenForms [compileWith $::provenanceSource off]
} -result {function function list method operator operator operator}

test me-provenance-under-off-and-default {the marker does not depend on the warning mode} -body {
    set off [compileWith $::provenanceSource off]
    set on [compileWith $::provenanceSource default]
    list [expr {[writtenForms $off] eq [writtenForms $on]}] [llength [writtenForms $off]]
} -result {1 7}

test me-provenance-records-namespace {a written call records the namespace of the code it is in} -body {
    withModules {m.bot {fn helper(a, b):
    a
fn go(n):
    helper(n, 1)
}} {
        set hir [surface::compile {import m
m::go(1)
fn t(x):
    two = 1
    x} t.bot -warnings off]
        set namespaces {}
        dict for {e node} [dict get $hir exprs] {
            if {[dict get $node kind] eq "call" && [dict exists $node written]} {
                lappend namespaces [dict get $node written ns]
            }
        }
        lsort -unique $namespaces
    }
} -result {{} m}

test me-hir-identical-across-modes {the HIR, with its provenance marker, is the same under off and default} -body {
    set program "${::prelude}fn t(x):
    return two(x, 1)
t(1)"
    set off [compileWith $program off]
    set on [compileWith $program default]
    list [expr {$off eq [dict remove $on warnings]}] [expr {[hir::format $off] eq [hir::format $on]}] \
        [expr {[hir::lower $off] eq [hir::lower $on]}] [dict exists $off warnings]
} -result {1 1 1 0}

test me-nir-identical-across-modes {native IR is identical with warnings off and on} -body {
    set program "${::prelude}fn t(x):
    return two(x, 1)
t(1)"
    expr {[native::nir [compileWith $program off]] eq [native::nir [compileWith $program default]]}
} -result 1

test me-nir-identical-between-spellings {the functional and the sugared spelling compile to the same NIR, report and CLIF} -body {
    set functional "${::prelude}fn t(x):
    return two(x, 1)
t(1)"
    set sugared "${::prelude}fn t(x):
    return x.two(1)
t(1)"
    set f [compileWith $functional off]
    set s [compileWith $sugared off]
    list [expr {[native::nir $f] eq [native::nir $s]}] [expr {[native::nir $f -specialize 0] eq [native::nir $s -specialize 0]}] \
        [expr {[native::clif $f] eq [native::clif $s]}] [expr {[native::report $f] eq [native::report $s]}]
} -result {1 1 1 1}

test me-machine-readable-outputs-clean {native::report is identical with and without the warnings side table} -body {
    set program "${::prelude}fn t(x):
    return two(x, 1)
t(1)"
    set on [compileWith $program default]
    set bare [dict remove $on warnings]
    expr {[llength [hir::warnings::of $on]] == 1 && [native::report $on] eq [native::report $bare]
        && [native::nir $on] eq [native::nir $bare] && [native::clif $on] eq [native::clif $bare]}
} -result 1

test me-no-warning-text-in-machine-readable-outputs {neither NIR, CLIF nor the report mention a warning or its code} -body {
    set hir [compileWith "${::prelude}fn t(x):
    return two(x, 1)
t(1)" default]
    set seen 0
    foreach text [list [native::nir $hir] [native::clif $hir] [native::report $hir] [hir::format $hir]] {
        foreach word {METHOD-ELIGIBLE eligible warning written} {
            if {[string match *$word* $text]} {
                incr seen
            }
        }
    }
    set seen
} -result 0

test me-hir-format-never-prints-warnings {hir::format does not print the side table or the provenance marker} -body {
    set hir [compileWith "${::prelude}fn t(x):
    return two(x, 1)
t(1)" default]
    list [string match *METHOD* [hir::format $hir]] [string match *written* [hir::format $hir]]
} -result {0 0}

# ---------------------------------------------------------------------------
# nomethod fn

proc nomethodDecl {} {
    return "nomethod fn atan2(y, x):\n    y + x\n"
}

test me-nomethod-parses {nomethod fn parses and the function is called functionally exactly like any other} -body {
    set hir [compileWith "[nomethodDecl]atan2(1, 2)" default]
    list [core::formatValue [core::evalProgram [hir::lower $hir]]] [hir::diagnostics $hir]
} -result {3 {}}

test me-nomethod-sugar-is-a-resolution-error {receiver-form call to a nomethod function is a resolution error with the pinned message} -body {
    lassign [rejection "[nomethodDecl]5.atan2(1)" off] code message
    list $code $message
} -result {{CORE SEMANTIC NOMETHOD-CALL} {t.bot:3:3: `atan2` is declared nomethod and cannot be called with method syntax; call it as atan2(receiver, ...)}}

test me-nomethod-error-before-typing {the error is raised by resolution: before type inference, like an unbound name} -body {
    set calls 0
    trace add execution hir::check enter {apply {{args} {incr ::checkCalls}}}
    set ::checkCalls 0
    try {
        catch {compileWith "[nomethodDecl]5.atan2(1)" off}
        set ::checkCalls
    } finally {
        trace remove execution hir::check enter {apply {{args} {incr ::checkCalls}}}
    }
} -result 0

