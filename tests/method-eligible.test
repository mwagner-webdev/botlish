    set hir [surface::compile "[nomethodDecl]5.atan2(1)" t.bot -strict 0 -warnings default -warning-channel ""]
    set kinds [lmap d [hir::diagnostics $hir] {dict get $d kind}]
    set callee [dict get $hir exprs [dict get [dict get $hir exprs [lindex [dict get $hir roots] end]] callee] kind]
    list [lindex $kinds 0] $callee [hir::warnings::of $hir]
} -result {NOMETHOD-CALL project {}}

test me-nomethod-functional-call-no-warning {a nomethod function is never reported: its sugared spelling is not legal} -body {
