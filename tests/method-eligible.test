} -match glob -result {*nomethod fn f (a b)*fn g (a)*}

test me-nomethod-ast-node {the function node carries the modifier and its span; a plain function carries 0} -body {
    set ast [surface::parse "nomethod fn f(a, b):\n    a\nfn g(a):\n    a\n" t.bot]
