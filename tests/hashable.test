# hashable.test -- the intrinsic trait Hashable, total hashing and equality,
# and the private collision-hardened table hash (HASHABLE-AND-KEYED-HASH.md).
#
# Behavioral checks run on every backend (interp, compile, cranelift-generic,
# cranelift) through one HIR (sourceAgree, keyedAgree). The keyed hash is
# reached as the standard library reaches it: a module of a private copy of
# stdlib/ (withPrivateLibrary) imports the internal namespace table_hash. Exact
# keyed values are compared, under a fixed test key (core::hashing::
# useTableHashKey, which native::RunDriver forwards to the driver), with
# audit/hashable/tools/oracle.py, an independent implementation; the
# production key is only ever checked for its laws.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]

# A python3 that runs (an executable alias that only opens an installer is
# none).
testConstraint python3 [expr {[auto_execok python3] ne ""
    && ![catch {exec python3 -I -c {print(6 * 7)}} answer] && $answer eq "42"}]
testConstraint nativeBuilt [expr {![catch {native::binary}]}]

# ---------------------------------------------------------------------------
# Helpers

set ::hbBackends {interp compile cranelift-generic cranelift}
set ::hbKey {1311768467750121216 18364758544493064720}

# The privileged fixture: a standard library module that may call the
# private table hash, as the standard library's hash structures will.
set ::hbFixture {import std::table_hash

fn keyed(x: Hashable) -> int:
    std::table_hash::of(x)
}

proc hbWriteModules {files} {
    foreach {path text} $files {
        set full [file join $::core::libraryDir $path]
        file mkdir [file dirname $full]
        set f [open $full w]
        fconfigure $f -encoding utf-8
        puts -nonewline $f $text
        close $f
    }
}

# The kind and location-free message of the first diagnostic of SOURCE's
# compile rejection (with the library modules FILES), or "accepted": the
# first entry of -diagnostics, never the first line of the message
# (DIAGNOSTIC-RECOVERY.md).
proc hbRejection {source {files {}}} {
    withPrivateLibrary {
        hbWriteModules $files
        if {[catch {surface::compile $source t.bot -warnings off} message options]} {
            if {[dict exists $options -diagnostics]} {
                set first [lindex [dict get $options -diagnostics] 0]
                set message [dict get $first message]
                set code [dict get $first errorcode]
            } else {
                set code [dict get $options -errorcode]
            }
            set result [list [lindex $code end] [regsub {^[^ ]*:[0-9]+:[0-9]+: } $message {}]]
        } else {
            set result accepted
        }
    }
    return $result
}

proc hbKind {source {files {}}} {
    return [lindex [hbRejection $source $files] 0]
}

# sourceAgree of SOURCE with the fixture module `hashfix` in the library and
# the table hash key KEY ("" for the process's drawn key).
proc keyedAgree {source {key ""} {backends {}}} {
    if {$backends eq {}} {
        set backends $::hbBackends
    }
    withPrivateLibrary {
        hbWriteModules [list hashfix.bot $::hbFixture]
        core::hashing::useTableHashKey $key
        try {
            set result [sourceAgree $source $backends]
        } finally {
            core::hashing::useTableHashKey ""
        }
    }
    return $result
}

proc hbHir {source {files {}}} {
    withPrivateLibrary {
        hbWriteModules [concat [list hashfix.bot $::hbFixture] $files]
        set hir [surface::compile $source t.bot -warnings off]
    }
    return $hir
}

proc hbNir {source args} {
    return [dict get [native::lower::program [hbHir $source] -tiny-leaf-inline-opt 0 {*}$args] text]
}

# The `may_error=...` of the calls of function NAME in NIR's call effects.
proc hbMayError {nir name} {
    set result {}
    foreach line [native::Driver calls $nir] {
        if {[string match "*callee_name=\"$name\" *" $line] && [regexp {may_error=(\w+)} $line -> e]} {
            lappend result $e
        }
    }
    return [lsort -unique $result]
}

# JSON TEXT with every non-ASCII character escaped (\uXXXX, a surrogate pair
# beyond the BMP): the hand-off to the oracle is ASCII, so no pipe encoding
# (Windows' code page) can change a String's text.
proc hbAsciiJson {text} {
    set out ""
    foreach c [split $text ""] {
        scan $c %c cp
        if {$cp < 0x80} {
            append out $c
        } elseif {$cp < 0x10000} {
            append out [format {\u%04x} $cp]
        } else {
            set v [expr {$cp - 0x10000}]
            append out [format {\u%04x\u%04x} [expr {0xD800 + ($v >> 10)}] [expr {0xDC00 + ($v & 0x3FF)}]]
        }
    }
    return $out
}

# The public and table hashes of the oracle's JSON values under KEY.
proc hbOracle {jsons key} {
    set out [exec python3 -I [file join $::projectRoot audit hashable tools oracle.py] hash {*}$key << [hbAsciiJson [join $jsons \n]]]
    return [split $out \n]
}

# A struct-heavy prelude every behavioral program shares.
set ::hbPrelude {import std::immutable_set

struct P:
    x: int
    y: int

enum Color:
    Red,
    Green,

struct Q:
    a: P
    b: str
    c: Color

struct Holder:
    n: int
    f: Fn{args: [int], return: int}

fn twice(n: int) -> int:
    n * 2

}

# ---------------------------------------------------------------------------
# Public hash compatibility: the exact values the public hash had before this
# milestone (taken on the tree it started from, every backend agreeing),
# unchanged by the shared canonical walk.

set ::hbPinnedProgram {import std::abi
import std::abi::bytes
import std::str
import std::immutable_set

struct P:
    x: int
    y: int

enum Color:
    Red,
    Green,
    Blue,

struct Q:
    a: P
    b: str
    c: Color

struct Name:
    first: str
    last: str

fn mk(s: str):
    std::abi::bytes::from_list(std::str::encode_utf8(s))

fn hashes(xs):
    loop x in xs:
        hash(x)

small = [0, 1, -1, 7, 9, 10, -10, 99, 100, -100, 123456789, 999999999999999999, 1000000000000000000, -1000000000000000000, 2305843009213693951, 2305843009213693952, -2305843009213693952, 4611686018427387903, -4611686018427387904]
big = [4611686018427387904, -4611686018427387905, 9223372036854775807, 9223372036854775808, -9223372036854775808, -9223372036854775809, 9999999999999999999, 10000000000000000000, 18446744073709551615, 18446744073709551616, -18446744073709551616, 100000000000000000005, 1208925819614629174706176, 340282366920938463463374607431768211455, 340282366920938463463374607431768211456, -340282366920938463463374607431768211456, 100000000000000000000000000000000000007, 123456789012345678901234567890123456789012345678901234567890]
computed = [shift_left(1, 61) - 1, shift_left(1, 62) - 1, shift_left(1, 62), 0 - shift_left(1, 62), 0 - shift_left(1, 62) - 1, shift_left(1, 63), shift_left(1, 64) - 1, shift_left(1, 127), shift_left(1, 128) - 1, shift_left(1, 128), 0 - shift_left(1, 200)]
chars = ['a', 'Z', '0', ' ', 'é', '☃', '🙂', '􏿿']
strs = ["", "a", "1", "-1", "héllo ☃", "🙂 quick brown fox", "the quick brown fox jumps over the lazy dog, then again and again and again"]
others = [true, false, unit, [], [1, 2], [2, 1], [[1], ["a", 'b']], [-7, 'x', 4611686018427387904], [[]], [[], []], [unit]]
floats = [0.0, 1.0, 1.5, -1.5, 2.5, 0.1, 1000000.25, -0.001, 123456.789]
structs = [P {x: 1, y: 2}, P {x: -1, y: 4611686018427387903}, P {x: 4611686018427387904, y: 0}, Q {a: P {x: 3, y: 4}, b: "s", c: Color::Green}, {x: 1, y: "a"}, {y: "a", x: 1}, {}, {p: P {x: 1, y: 2}, e: Color::Red}, {q: Q {a: P {x: 0, y: 0}, b: "", c: Color::Red}, l: [P {x: 5, y: 6}, 'c']}, [P {x: 1, y: 2}, Color::Red], Color::Red, Color::Green, Color::Blue, Name {first: "Ada", last: "Lovelace"}, {first: "Ada", last: "Lovelace"}]
stores = [mk(""), mk("AB"), mk("héllo"), std::abi::bytes::from_bytes(mk("k1")), std::abi::bytes::zeroed(std::abi::Usize {value: 3}), std::immutable_set::from_list([1, 2, 3]), std::immutable_set::from_list([3, 2, 1]), std::immutable_set::from_list([P {x: 1, y: 2}, 'q', "s", 4611686018427387904]), std::immutable_set::from_list([])]

[hashes(small), hashes(big), hashes(computed), hashes(chars), hashes(strs), hashes(others), hashes(floats), hashes(structs), hashes(stores)]
}

