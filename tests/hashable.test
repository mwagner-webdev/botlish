test hb-public-hash-pinned {the public hash of 107 values at every kind and representation edge is byte for byte the value it had before this milestone, on every backend} -body {
    sourceAgree $::hbPinnedProgram
} -result [list value $::hbPinnedValues]

test hb-public-hash-oracle {the independent oracle computes the pinned public hashes (kind tags, decimal texts, nested sub-hashes, the order-free set fold, byte storage, BigInt beyond 128 bits)} -constraints python3 -body {
    # {GROUP INDEX} of the pinned corpus, and the value described for the
    # oracle.
    set cases {
        {0 3} {{"int": "7"}}
        {1 15} {{"int": "-340282366920938463463374607431768211456"}}
        {1 17} {{"int": "123456789012345678901234567890123456789012345678901234567890"}}
        {3 6} {{"char": 128578}}
        {4 4} {{"str": "héllo ☃"}}
        {5 4} {{"list": [{"int": "1"}, {"int": "2"}]}}
        {5 6} {{"list": [{"list": [{"int": "1"}]}, {"list": [{"str": "a"}, {"char": 98}]}]}}
        {6 2} {{"float": 1.5}}
        {7 3} {{"struct": {"id": "Q", "fields": [["a", {"struct": {"id": "P", "fields": [["x", {"int": "3"}], ["y", {"int": "4"}]]}}], ["b", {"str": "s"}], ["c", {"enum": ["Color", "Green"]}]]}}}
        {7 4} {{"struct": {"id": "", "fields": [["y", {"str": "a"}], ["x", {"int": "1"}]]}}}
        {7 14} {{"struct": {"id": "", "fields": [["last", {"str": "Lovelace"}], ["first", {"str": "Ada"}]]}}}
        {8 1} {{"struct": {"id": "std::abi::bytes::Bytes", "fields": [["storage", {"bytes": [65, 66]}]]}}}
        {8 6} {{"set": [{"int": "3"}, {"int": "2"}, {"int": "1"}]}}
    }
    set pinned [string map {, "" [ "{" ] "}"} $::hbPinnedValues]
    set pinned [lindex $pinned 0]
    set jsons {}
    set want {}
    foreach {at json} $cases {
        lappend jsons $json
        lappend want [lindex $pinned {*}$at]
    }
    set got [lmap line [hbOracle $jsons $::hbKey] {lindex $line 0}]
    expr {$got eq $want ? "agree" : "$got != $want"}
} -result agree

# ---------------------------------------------------------------------------
# Hashable is an ordinary trait to its consumers

test hb-trait-argument {a Hashable parameter accepts every witness kind, and hash through it is the public hash, on every backend} -body {
    sourceAgree [string cat $::hbPrelude {fn fingerprint(x: Hashable) -> int:
    hash(x)

[fingerprint(7) == hash(7), fingerprint("apple") == hash("apple"), fingerprint(true) == hash(true), fingerprint(unit) == hash(unit), fingerprint('é') == hash('é'), fingerprint(1.5) == hash(1.5), fingerprint(Color::Red) == hash(Color::Red), fingerprint(P {x: 1, y: 2}) == hash(P {x: 1, y: 2}), fingerprint(Q {a: P {x: 1, y: 2}, b: "s", c: Color::Green}) == hash(Q {a: P {x: 1, y: 2}, b: "s", c: Color::Green}), fingerprint([1, 2]) == hash([1, 2]), fingerprint([[1], [2, 3]]) == hash([[1], [2, 3]]), fingerprint(std::immutable_set::from_list([1, 2])) == hash(std::immutable_set::from_list([2, 1])), fingerprint({a: 1, b: "x2"}) == hash({b: "x2", a: 1}), fingerprint([]) == hash([]), fingerprint(4611686018427387904) == hash(4611686018427387904)]
}]
} -result {value {[true, true, true, true, true, true, true, true, true, true, true, true, true, true, true]}}

test hb-trait-operation {the trait's one operation, x.hash(), is a direct call of the public hash in each specialization: no trait remains} -body {
    set hir [surface::compile [string cat $::hbPrelude {fn fingerprint(x: Hashable) -> int:
    x.hash()

[fingerprint(P {x: 1, y: 2}) == hash(P {x: 1, y: 2}), fingerprint(3) == hash(3)]
}] t.bot -warnings off]
    set calls [lmap e [hirFind $hir call] {
        if {![dict exists [hir::node $hir $e] traitImpl]} continue
        list [dict get [hir::symbol $hir [lindex [hir::get $hir $e target] 1]] name] [dict get [hir::node $hir $e] traitImpl witness]
    }]
    list [lsort $calls] [lindex [outcomeUnderHir cranelift $hir] 1] \
        [regexp {trait ID|\{trait } [lmap b [dict keys [dict get $hir bindings]] {dict getdef [hir::binding $hir $b] type ""}]]
} -result {{{hash int} {hash {nstruct P}}} {[true, true]} 0}

test hb-trait-provenance {a Hashable result keeps its witness: a returned view hashes like its concrete value and passes on to another Hashable parameter} -body {
    sourceAgree [string cat $::hbPrelude {fn keep(x: Hashable) -> Hashable:
    x

fn fingerprint(x: Hashable) -> int:
    x.hash()

v = keep(P {x: 4, y: 5})
[fingerprint(v) == hash(P {x: 4, y: 5}), fingerprint(keep(keep("k"))) == hash("k")]
}]
} -result {value {[true, true]}}

test hb-trait-equality {two Hashable parameters compare by ordinary structural equality} -body {
    sourceAgree [string cat $::hbPrelude {fn same(a: Hashable, b: Hashable) -> bool:
    a == b

[same(P {x: 1, y: 2}, P {x: 1, y: 2}), same(P {x: 1, y: 2}, P {x: 1, y: 3}), same(1, "1"), same([1], [1])]
}]
} -result {value {[true, false, false, true]}}

test hb-trait-join {different witnesses never join to a Hashable value: TRAIT-WITNESS-JOIN, as for any trait} -body {
    hbKind [string cat $::hbPrelude {fn pick(a: Hashable, b: Hashable, c: bool) -> Hashable:
    if c:
        a
    else:
        b

pick(1, "a", true)
}]
} -result TRAIT-WITNESS-JOIN

test hb-trait-storage {Hashable is not storable, as no trait is: a List[Hashable] or a field of it is TRAIT-STORAGE-UNSUPPORTED} -body {
    list [hbKind "fn f(xs: List\[Hashable\]) -> int:\n    1\n\n1\n"] \
        [hbKind "struct Box:\n    key: Hashable\n\n1\n"]
} -result {TRAIT-STORAGE-UNSUPPORTED TRAIT-STORAGE-UNSUPPORTED}

test hb-trait-visible-everywhere {Hashable is named by its bare name in every module, with no import, like a built-in type} -body {
    withPrivateLibrary {
        hbWriteModules [list keys.bot "fn digest(x: Hashable) -> int:\n    hash(x)\n"]
        set result [sourceAgree "import keys\n\nkeys::digest(\[1, 2\]) == hash(\[1, 2\])\n"]
    }
    set result
} -result {value true}

test hb-monomorphization-ordinary {a Hashable function is specialized once per witness its calls pass, like any trait-polymorphic function; a function that does not name it is untouched} -body {
    set hir [surface::compile [string cat $::hbPrelude {fn fingerprint(x: Hashable) -> int:
    hash(x)

fn plain(x: int) -> int:
    hash(x)

[fingerprint(1), fingerprint(2), fingerprint(P {x: 1, y: 2}), fingerprint("s1"), plain(3)]
}] t.bot -warnings off]
    lsort [dict keys [dict get [dict get $hir traitFunctions] fingerprint clones]]
} -result {fingerprint<P> fingerprint<int> fingerprint<str>}

# ---------------------------------------------------------------------------
# Witnesses: the census (HASHABLE-AND-KEYED-HASH.md, "Witness census")

test hb-witness-census {the witnesses are exactly the types with total equality and a hash: the runtime's own refusal lists, recursing through Lists, sets and struct fields} -body {
    set hir [hbHir {import std::ffi::c
import std::abi
import std::abi::bytes
import std::mutable_array
import std::mutable_vector

type Small = Int in 0..10

refined type Word = str

enum Color:
    Red,

struct P:
    x: int
    y: int

struct Nested:
    p: P
    tag: Color

struct Holder:
    n: int
    f: Fn{args: [int], return: int}

struct Loose:
    v: any

struct Tree:
    label: str
    kids: List[Tree]

struct BadTree:
    kids: List[BadTree]
    f: Fn{args: [], return: int}

opaque struct Secret:
    code: int

1
}]
    hir::activate $hir
    set types [dict create \
        int int str str bool bool unit unit UnicodeChar UnicodeChar Float64 Float64 \
        Small {refined int {Small}} Word {refined str {Word}} \
        std::ffi::c::Int {refined int {std::ffi::c::Int}} \
        Color {enum Color} P {nstruct P} Nested {nstruct Nested} Holder {nstruct Holder} \
        Loose {nstruct Loose} Tree {nstruct Tree} BadTree {nstruct BadTree} Secret {nstruct Secret} \
        Bytes {nstruct std::abi::bytes::Bytes} \
        {List[int]} {list int} {List[P]} {list {nstruct P}} {List[Holder]} {list {nstruct Holder}} \
        {ImmutableSet[str]} {immutableSet str} \
        anon {struct {a int b str}} anon-fn [list struct [list f [hir::types::MakeFn {int} int {}]]] \
        any any Fn [hir::types::MakeFn {int} int {}] \
        {MutableArray[int]} {mutarray int} {MutableVector[int]} {mutvec int} \
        Ptr {cptr {refined int {std::ffi::c::Int}}} \
        DecimalRounded {srefined DecimalRounded {minDecimalsPreserved 2}} \
        imprint {imprint T}]
    set rows {}
    dict for {name t} $types {
        lassign [hir::types::HashClass $t] class
        lappend rows "$name $class [expr {[hir::types::IsEqualityTotal $t] ? "eq-total" : "eq-not-total"}]"
    }
    join $rows \n
} -result {int total eq-total
str total eq-total
bool total eq-total
unit total eq-total
UnicodeChar total eq-total
Float64 total eq-total
Small total eq-total
Word total eq-total
std::ffi::c::Int total eq-total
Color total eq-total
P total eq-total
Nested total eq-total
Holder none eq-not-total
Loose unknown eq-not-total
Tree total eq-total
BadTree none eq-not-total
Secret total eq-total
Bytes unknown eq-not-total
List[int] total eq-total
List[P] total eq-total
List[Holder] none eq-not-total
ImmutableSet[str] total eq-total
anon total eq-total
anon-fn none eq-not-total
any unknown eq-not-total
Fn none eq-not-total
MutableArray[int] none eq-not-total
MutableVector[int] none eq-not-total
Ptr none eq-not-total
DecimalRounded none eq-not-total
imprint unknown eq-not-total}

test hb-witness-agrees-with-the-operations {the census describes the operations: every witness kind is hashed and compared without EQUALITY by the dynamic, untyped == and hash, on every backend; a value of a type it calls none stops with EQUALITY there} -body {
    list [sourceAgree [string cat $::hbPrelude {fn h(x):
    hash(x)

fn e(a, b):
    a == b

values = [7, 4611686018427387904, "s1", true, unit, 'é', 1.5, Color::Red, P {x: 1, y: 2}, Q {a: P {x: 1, y: 2}, b: "s", c: Color::Green}, [1, 2], std::immutable_set::from_list([1]), {a: 1}]
ok = loop v in values:
    h(v) == hash(v) and e(v, v)
ok
}]] [sourceAgree {fn inc(n):
    n + 1

fn h(x):
    hash(x)

h([inc])
}] [sourceAgree {fn inc(n):
    n + 1

fn e(a, b):
    a == b

e([inc], [inc])
}]
} -result {{value {[true, true, true, true, true, true, true, true, true, true, true, true, true]}} {error {CORE SEMANTIC EQUALITY} {hash is not defined for callables: <block (n)>}} {error {CORE SEMANTIC EQUALITY} {== is not defined for callables: <block (n)> == <block (n)>}}}

test hb-witness-requires-hash-support {a witness needs a hash as well as total equality: a kind whose values had equality but no hash would not be Hashable (here Float64, its hash refused for the test only)} -body {
    set saved $::core::hashing::unhashable
    lappend ::core::hashing::unhashable Float64
    try {
        list [hir::types::IsEqualityTotal Float64] [lindex [hir::types::HashClass Float64] 0] \
            [catch {core::hashing::hash [core::value::float Float64 1.5]} m] $m
    } finally {
        set ::core::hashing::unhashable $saved
    }
} -result {1 none 1 {hash is not defined for callables: 1.5}}

test hb-witness-requires-total-equality {a witness needs total equality as well as a hash: a kind whose values had a hash but no equality would not be Hashable (here Float64, its equality refused for the test only)} -body {
    set saved $::core::value::incomparable
    lappend ::core::value::incomparable Float64
    try {
        list [hir::types::IsEqualityTotal Float64] [lindex [hir::types::HashClass Float64] 0] \
            [lindex [hir::types::HashClass {list Float64}] 0] [catch {core::value::equal [core::value::float Float64 1.5] [core::value::float Float64 1.5]}]
    } finally {
        set ::core::value::incomparable $saved
    }
} -result {0 none none 1}

test hb-witness-not-user-definable {no source declaration makes a type Hashable or takes it away: a module's own `hash` function implements nothing, and a struct with a function field stays outside however its module spells it} -body {
    withPrivateLibrary {
        hbWriteModules [list model.bot "struct Holder:\n    f: Fn{args: \[int\], return: int}\n\nfn hash(value: Holder) -> int:\n    1\n\nstruct Plain:\n    n: int\n"]
        set rejected [hbRejection "import model\n\nfn fingerprint(x: Hashable) -> int:\n    hash(x)\n\nfn inc(n: int) -> int:\n    n + 1\n\nfingerprint(model::Holder {f: inc})\n"]
        set accepted [sourceAgree "import model\n\nfn fingerprint(x: Hashable) -> int:\n    hash(x)\n\nfingerprint(model::Plain {n: 3}) == hash(model::Plain {n: 3})\n"]
    }
    list [lindex $rejected 0] $accepted
} -result {TRAIT-NOT-SATISFIED {value true}}

test hb-reserved-name {Hashable is reserved: no struct, enum, type, refinement, layout or trait of a program may take the name} -body {
    lmap decl [list "struct Hashable:\n    x: int" "enum Hashable:\n    A," "type Hashable = Int in 0..3" \
            "refined type Hashable = str" "layout Hashable:\n    size 1\n    align 1\n    field a: UInt8 at 0" \
            "trait Hashable:\n    fn hash(value: Hashable) -> int"] {
        lindex [hbRejection "$decl\n\n1\n"] 0
    }
} -result {TYPE TYPE TYPE TYPE TYPE TRAIT-NAME-COLLISION}

# ---------------------------------------------------------------------------
# Callables and other non-witnesses: one rule, rejected at the boundary

test hb-callable-not-hashable {a function is not Hashable: TRAIT-NOT-SATISFIED at the Hashable parameter, saying why in source terms} -body {
    hbRejection [string cat $::hbPrelude {fn fingerprint(x: Hashable) -> int:
    hash(x)

fingerprint(twice)
}]
} -result {TRAIT-NOT-SATISFIED {argument for parameter "x" does not satisfy trait Hashable:
twice/1 -> int does not satisfy Hashable
a function has no total equality (== of two functions is not defined: there is no function identity)}}

test hb-struct-with-callable-not-hashable {a struct holding a function is not Hashable, and the message names the field} -body {
    lindex [split [lindex [hbRejection [string cat $::hbPrelude {fn fingerprint(x: Hashable) -> int:
    hash(x)

fingerprint(Holder {n: 1, f: twice})
}]] 1] \n] 2
} -result {field "f" of Holder (Fn{args: [int], return: int, errors: []}): a function has no total equality (== of two functions is not defined: there is no function identity)}

test hb-list-of-callables-not-hashable {neither is a List of functions, nor a nested struct whose inner field holds one} -body {
    list [hbKind [string cat $::hbPrelude {fn fingerprint(x: Hashable) -> int:
    hash(x)

fingerprint([twice])
}]] [hbKind [string cat $::hbPrelude {struct Outer:
    inner: Holder

fn fingerprint(x: Hashable) -> int:
    hash(x)

fingerprint(Outer {inner: Holder {n: 1, f: twice}})
}]]
} -result {TRAIT-NOT-SATISFIED TRAIT-NOT-SATISFIED}

test hb-any-not-hashable {a statically unknown value (an untyped parameter) is not Hashable, whatever the runtime value would be} -body {
    hbRejection {fn fingerprint(x: Hashable) -> int:
    hash(x)

fn g(x):
    fingerprint(x)

g(1)
}
} -result {TRAIT-NOT-SATISFIED {argument for parameter "x" does not satisfy trait Hashable:
any does not satisfy Hashable
its static type is any, whose values are not known to have total equality and hashing (one may hold a function)}}

test hb-authority-not-hashable {authority-bearing and mutable values are not Hashable: a MutableArray, a MutableVector, a C pointer (affine: the ownership discipline reports it), a coroutine handle} -body {
    list [hbKind "import std::mutable_array\nfn fingerprint(x: Hashable) -> int:\n    hash(x)\n\nfingerprint(std::mutable_array::create(2, 0))\n"] \
        [hbKind "import std::mutable_vector\nfn fingerprint(x: Hashable) -> int:\n    hash(x)\n\nfingerprint(std::mutable_vector::from_list(\[1\]))\n"] \
        [hbKind "import std::ffi::c\nfn fingerprint(x: Hashable) -> int:\n    hash(x)\n\nfn f() -> int:\n    fingerprint(std::ffi::c::null\[std::ffi::c::Int\]())\n\nf()\n"] \
        [hbKind "import std::ffi::c\nfn f() -> int:\n    p = std::ffi::c::null\[std::ffi::c::Int\]()\n    hash(p)\n\nf()\n"]
} -result {TRAIT-NOT-SATISFIED TRAIT-NOT-SATISFIED TRAIT-NOT-SATISFIED AFFINE-EQUALITY-UNSUPPORTED}

test hb-other-trait-view-not-hashable {a view of another trait is not Hashable, though its witness might be: no conversion between traits} -body {
    hbKind {trait Named:
    fn name(value: Named) -> str

struct Person:
    value: str

fn name(value: Person) -> str:
    value.value

fn fingerprint(x: Hashable) -> int:
    hash(x)

fn describe(v: Named) -> int:
    fingerprint(v)

describe(Person {value: "Ada"})
}
} -result TRAIT-NOT-SATISFIED

# ---------------------------------------------------------------------------
# The public hash's admission (HASHABLE-AND-KEYED-HASH.md, "Public hash
# admission")

test hb-hash-static-rejection {hash of a value statically known not to be Hashable is rejected at compile time (it used to fail when run)} -body {
    list [hbRejection [string cat $::hbPrelude "hash(twice)\n"]] \
        [hbKind [string cat $::hbPrelude "hash(Holder {n: 1, f: twice})\n"]] \
        [hbKind "import std::mutable_vector\nhash(std::mutable_vector::from_list(\[1\]))\n"]
} -result {{TRAIT-NOT-SATISFIED {the argument of hash does not satisfy trait Hashable:
twice/1 -> int does not satisfy Hashable
a function has no total equality (== of two functions is not defined: there is no function identity)}} TRAIT-NOT-SATISFIED TRAIT-NOT-SATISFIED}

test hb-hash-dynamic-compatibility {hash of a statically unknown value stays the dynamic, fallible hash: a Hashable value at run time hashes, a function stops with EQUALITY, on every backend (generic code without type parameters relies on it)} -body {
    list [sourceAgree {fn h(x):
    hash(x)

[h(1) == hash(1), h([1, "a"]) == hash([1, "a"])]
}] [sourceAgree {fn h(x):
    hash(x)

fn inc(n):
    n + 1

h(inc)
}]
} -result {{value {[true, true]}} {error {CORE SEMANTIC EQUALITY} {hash is not defined for callables: <block (n)>}}}

test hb-hash-generic-body-not-duck-typed {a trait-polymorphic body's hash of a view of another trait is not re-judged per witness: it stays the dynamic hash in every specialization} -body {
    sourceAgree {trait Named:
    fn name(value: Named) -> str

struct Person:
    value: str

fn name(value: Person) -> str:
    value.value

fn digest(v: Named) -> int:
    hash(v)

digest(Person {value: "Ada"}) == hash(Person {value: "Ada"})
}
} -result {value true}

# ---------------------------------------------------------------------------
# Total lowering and effects (HASHABLE-AND-KEYED-HASH.md, "Total lowering")

test hb-nir-hash-total {hash of a Hashable operand is hashtotal (no error edge), of an unknown one the fallible hash; a Hashable function is may_error=false} -body {
    set nir [hbNir [string cat $::hbPrelude {fn fingerprint(x: Hashable) -> int:
    hash(x)

fn h(x):
    hash(x)

fn direct(p: P) -> int:
    hash(p)

[fingerprint(P {x: 1, y: 2}), fingerprint(7), h(1), h("a"), direct(P {x: 3, y: 4})]
}] -specialize 0]
    list [regexp -all {op hashtotal} $nir] [regexp -all {op hash } $nir] \
        [hbMayError $nir fingerprint<P>] [hbMayError $nir fingerprint<int>] [hbMayError $nir h] [hbMayError $nir direct]
} -result {3 1 false false true false}

test hb-nir-equality-total {== of equality-total operands (structs, Lists, sets of witnesses; two different scalar kinds) is veqtotal: no error edge, may_error=false; an unknown operand keeps veq} -body {
    set nir [hbNir [string cat $::hbPrelude {fn e1(a: P, b: P) -> bool:
    a == b

fn e2(a: List[Q], b: List[Q]) -> bool:
    a == b

fn e3(a: int, b: str) -> bool:
    a == b

fn e4(a, b) -> bool:
    a == b

fn e5(a: Hashable, b: Hashable) -> bool:
    a == b

fn e6(a: P, b) -> bool:
    a == b

[e1(P {x: 1, y: 2}, P {x: 1, y: 2}), e2([], []), e3(1, "1"), e4(1, 2), e4("a", "b"), e5(P {x: 1, y: 1}, P {x: 1, y: 1}), e6(P {x: 1, y: 1}, 3)]
}] -specialize 0]
    list [regexp -all {op veqtotal} $nir] [regexp -all {op veq } $nir] \
        [hbMayError $nir e1] [hbMayError $nir e2] [hbMayError $nir e3] [hbMayError $nir e4] [hbMayError $nir e5<P,P>] [hbMayError $nir e6]
} -result {4 2 false false false true false true}

# slot's Botlish call makes it fallible where the depth check bounds
# recursion (nativeDepthChecked: NATIVE LIMIT STACK from its prologue).
set ::hbSlotMayError [if {[testConstraint nativeDepthChecked]} {string cat true} else {string cat false}]

test hb-nir-table-hash-total {the table hash of an admitted (Hashable) argument is tablehashtotal: no error edge, and the function making it is may_error=false and no safepoint (slot, which calls it, is may_error=true where the depth check makes its Botlish call fallible, nativeDepthChecked)} -body {
    set nir [hbNir [string cat "import hashfix\n" $::hbPrelude {fn slot(p: P) -> int:
    hashfix::keyed(p)

[slot(P {x: 1, y: 2}), hashfix::keyed("s1"), hashfix::keyed(7)]
}] -specialize 0]
    set calls [native::Driver calls $nir]
    list [regexp -all {op tablehashtotal} $nir] [regexp -all {op tablehash } $nir] \
        [hbMayError $nir slot] [hbMayError $nir hashfix::keyed<P>] [hbMayError $nir hashfix::keyed<str>] \
        [lsort -unique [lmap line $calls {if {![string match *keyed* $line]} continue; lindex [regexp -inline {may_gc=(\w+)} $line] 1}]]
} -result [list 3 0 $::hbSlotMayError false false false]

test hb-total-results-agree {the total lowerings compute what the fallible ones do, on every backend} -body {
    sourceAgree [string cat $::hbPrelude {fn e(a: Q, b: Q) -> bool:
    a == b

fn h(q: Q) -> int:
    hash(q)

q = Q {a: P {x: 1, y: 2}, b: "s", c: Color::Red}
[e(q, q), e(q, Q {a: P {x: 1, y: 3}, b: "s", c: Color::Red}), h(q) == hash(Q {a: P {x: 1, y: 2}, b: "s", c: Color::Red})]
}]
} -result {value {[true, false, true]}}

# ---------------------------------------------------------------------------
# The private table hash

test hb-keyed-oracle {under a fixed test key, every backend computes exactly the independent oracle's table hash (and public hash) of every kind, nested values included} -constraints python3 -body {
    set cases {
        {7} {{"int": "7"}}
        {-1} {{"int": "-1"}}
        {4611686018427387904} {{"int": "4611686018427387904"}}
        {-340282366920938463463374607431768211456} {{"int": "-340282366920938463463374607431768211456"}}
        {123456789012345678901234567890123456789012345678901234567890} {{"int": "123456789012345678901234567890123456789012345678901234567890"}}
        {"abc"} {{"str": "abc"}}
        {""} {{"str": ""}}
        {"héllo ☃🙂"} {{"str": "héllo ☃🙂"}}
        {'a'} {{"char": 97}}
        {'🙂'} {{"char": 128578}}
        {true} {{"bool": true}}
        {unit} {{"unit": null}}
        {1.5} {{"float": 1.5}}
        {-0.001} {{"float": -0.001}}
        {[1, 2]} {{"list": [{"int": "1"}, {"int": "2"}]}}
        {[]} {{"list": []}}
        {[[1], [2, 3]]} {{"list": [{"list": [{"int": "1"}]}, {"list": [{"int": "2"}, {"int": "3"}]}]}}
        {P {x: 1, y: 2}} {{"struct": {"id": "P", "fields": [["x", {"int": "1"}], ["y", {"int": "2"}]]}}}
        {Q {a: P {x: 3, y: 4}, b: "s", c: Color::Green}} {{"struct": {"id": "Q", "fields": [["a", {"struct": {"id": "P", "fields": [["x", {"int": "3"}], ["y", {"int": "4"}]]}}], ["b", {"str": "s"}], ["c", {"enum": ["Color", "Green"]}]]}}}
        {{y: "a1", x: 1}} {{"struct": {"id": "", "fields": [["y", {"str": "a1"}], ["x", {"int": "1"}]]}}}
        {Color::Red} {{"enum": ["Color", "Red"]}}
        {std::immutable_set::from_list([3, 1, 2])} {{"set": [{"int": "3"}, {"int": "1"}, {"int": "2"}]}}
        {[P {x: 1, y: 2}, P {x: 3, y: 4}]} {{"list": [{"struct": {"id": "P", "fields": [["x", {"int": "1"}], ["y", {"int": "2"}]]}}, {"struct": {"id": "P", "fields": [["x", {"int": "3"}], ["y", {"int": "4"}]]}}]}}
    }
    set exprs {}
    set jsons {}
    foreach {e j} $cases {
        lappend exprs "\[hash($e), hashfix::keyed($e)\]"
        lappend jsons $j
    }
    set outcome [keyedAgree "import hashfix\n$::hbPrelude\[[join $exprs {, }]\]\n" $::hbKey]
    set expected "\[[join [lmap line [hbOracle $jsons $::hbKey] {format {[%s, %s]} {*}$line}] {, }]\]"
    expr {$outcome eq [list value $expected] ? "agree" : "$outcome != $expected"}
} -result agree

test hb-keyed-coherence {equal values hash equally under the table hash however they were made: sets in any order, anonymous struct fields in any order, an Int computed or written, a String built or written} -body {
    keyedAgree "import hashfix\nimport std::str\n$::hbPrelude\[
    hashfix::keyed(std::immutable_set::from_list(\[1, 2, 3\])) == hashfix::keyed(std::immutable_set::from_list(\[3, 1, 2, 1\])),
    hashfix::keyed({a: 1, b: \"x2\"}) == hashfix::keyed({b: \"x2\", a: 1}),
    hashfix::keyed(shift_left(1, 62)) == hashfix::keyed(4611686018427387904),
    hashfix::keyed(shift_left(1, 62) - shift_left(1, 62) + 5) == hashfix::keyed(5),
    hashfix::keyed(std::str::concat(\"ab\", \"cd\")) == hashfix::keyed(\"abcd\"),
    hashfix::keyed(\[P {x: 1, y: 2}\]) == hashfix::keyed(\[P {x: 1, y: 2}\]),
    hashfix::keyed(1) != hashfix::keyed(\"1\")
\]\n" $::hbKey
} -result {value {[true, true, true, true, true, true, true]}}

test hb-keyed-process-key {with the production key (drawn once per process): one value hashes the same every time in a run, equal values equally, on every backend} -body {
    keyedAgree "import hashfix\n$::hbPrelude
fn many(n: int) -> List\[int\]:
    loop i from 0 to n:
        hashfix::keyed(P {x: 3, y: 4})

xs = many(50)
\[std::immutable_set::from_list(xs) == std::immutable_set::from_list(\[hashfix::keyed(P {x: 3, y: 4})\]), hashfix::keyed(\[1, 2\]) == hashfix::keyed(\[1, 2\])\]
"
} -result {value {[true, true]}}

test hb-keyed-differs-across-processes {smoke test of the production key: two native runs (two processes, two drawn keys) of 64 values do not give all 64 table hashes equal (each value is free to collide; all 64 together only with probability 2^-3900)} -constraints nativeBuilt -body {
    set source "import hashfix\nloop i from 0 to 64:\n    hashfix::keyed(i)\n"
    withPrivateLibrary {
        hbWriteModules [list hashfix.bot $::hbFixture]
        set hir [surface::compile $source t.bot -warnings off]
        set a [lindex [outcomeUnderHir cranelift $hir] 1]
        set b [lindex [outcomeUnderHir cranelift $hir] 1]
    }
    list [llength [split $a ,]] [expr {$a ne $b}]
} -result {64 1}

test hb-keyed-not-post-mixed {two Ints with one whole 64-bit public FNV state (audit/hashable/tools/collide.rs) collide under the public hash, also nested in a List or a struct field -- so they would under any function of the public hash and a key -- and not under the table hash} -body {
    keyedAgree "import hashfix\n$::hbPrelude
a = 17384044247497657079
b = 13834495523901255922
\[a == b, hash(a) == hash(b), hash(\[a\]) == hash(\[b\]), hash(P {x: a, y: 0}) == hash(P {x: b, y: 0}),
 hashfix::keyed(a) == hashfix::keyed(b), hashfix::keyed(\[a\]) == hashfix::keyed(\[b\]), hashfix::keyed(P {x: a, y: 0}) == hashfix::keyed(P {x: b, y: 0})\]
" $::hbKey
} -result {value {[false, true, true, true, false, false, false]}}

test hb-keyed-collision-corpus {the hash-table experiment's int-collide keys (1024 Ints whose public hash is 0 mod 1024: one bucket of 1024) spread under the table hash like random keys (fixed test key; expected about 647 buckets, max load about 5)} -body {
    set keys [string trim [core::ReadFile [file join $::projectRoot audit hashable data int-collide-1024.txt]]]
    set source "import hashfix\nkeys = \[[join $keys {, }]\]\npublic = loop k in keys:\n    mod(hash(k), 1024)\nkeyed = loop k in keys:\n    mod(hashfix::keyed(k), 1024)\n\[public, keyed\]\n"
    set outcome [keyedAgree $source $::hbKey {interp cranelift}]
    lassign [lindex [string map {, "" [ "{" ] "}"} [lindex $outcome 1]] 0] public keyed
    set loads [dict create]
    foreach s $keyed {
        dict incr loads $s
    }
    set max [tcl::mathfunc::max {*}[dict values $loads]]
    list [llength $keys] [lsort -unique $public] [dict size $loads] $max [expr {[dict size $loads] > 560 && $max <= 9}]
} -result {1024 0 651 5 1}

# ---------------------------------------------------------------------------
# The visibility boundary

test hb-internal-import {ordinary code cannot import the internal namespace: the entry program} -body {
    hbRejection "import std::table_hash\n\nstd::table_hash::of(1)\n"
} -result {INTERNAL-NAMESPACE {namespace "std::table_hash" is internal to the standard library: only its modules may import it or name its members (the entry program is not one)}}

test hb-internal-qualified {nor name its member fully qualified, imported or not} -body {
    hbKind "std::table_hash::of(1)\n"
} -result INTERNAL-NAMESPACE

test hb-internal-application-module {an application module (beside the program file) cannot import it either} -body {
    set dir [makeDirectory hb-app-[pid]]
    try {
        set f [open [file join $dir peek.bot] w]
        puts $f "import std::table_hash\n\nfn peek(x: int) -> int:\n    std::table_hash::of(x)"
        close $f
        set f [open [file join $dir main.bot] w]
        puts $f "import peek\n\npeek::peek(1)"
        close $f
        catch {surface::readProgramFile [file join $dir main.bot] -warnings off} message options
        list [lindex [dict get $options -errorcode] end] [regexp {application module "peek"} $message]
    } finally {
        removeDirectory hb-app-[pid]
    }
} -result {INTERNAL-NAMESPACE 1}

test hb-internal-not-a-method {no method syntax reaches it: it is nomethod, and its namespace is never imported by ordinary code} -body {
    list [dict get [core::native::metadata std::table_hash::of] nomethod] [hbKind "x = 1\nx.of()\n"]
} -result {1 NOT-A-STRUCT}

test hb-internal-not-exported {it is no ordinary standard library export: no Compilerpedia reference topic names it, and help does not list it} -body {
    set generated [core::ReadFile [file join $::projectRoot compilerpedia generated stdlib.topic]]
    list [regexp {table_hash} $generated] [core::native::isInternalNamespace table_hash] [core::native::isInternal std::table_hash::of] [core::native::isInternal hash]
} -result {0 1 1 0}

test hb-internal-standard-module-calls {a standard library module may import and call it (the privileged fixture), and only with a Hashable argument} -body {
    list [keyedAgree "import hashfix\nhashfix::keyed(\[1, 2\]) == hashfix::keyed(\[1, 2\])\n" $::hbKey] \
        [lindex [hbRejection "import loose\n\nloose::k(1)\n" [list loose.bot "import std::table_hash\n\nfn k(x):\n    std::table_hash::of(x)\n"]] 0]
} -result {{value true} TRAIT-NOT-SATISFIED}

test hb-internal-no-function-value {even in a standard library module it is only ever called: an alias, an argument or a result is INTERNAL-INTRINSIC-VALUE} -body {
    lmap body {
        "fn k(x: int) -> int:\n    f = std::table_hash::of\n    f(x)\n"
        "fn apply(f, x):\n    f(x)\n\nfn k(x: int) -> int:\n    apply(std::table_hash::of, x)\n"
        "fn k():\n    std::table_hash::of\n"
    } {
        lindex [hbRejection "import leak\n\n1\n" [list leak.bot "import std::table_hash\n\n$body"]] 0
    }
} -result {INTERNAL-INTRINSIC-VALUE INTERNAL-INTRINSIC-VALUE INTERNAL-INTRINSIC-VALUE}

test hb-internal-static-compile {a static compile block may ask whether ordinary code can reach it: the rejection is a CompilerError with its own code} -body {
    sourceAgree {import std::compiler

fn probe() errors std::compiler::CompilerError:
    static compile:
        std::table_hash::of(1)

r = probe():
    on std::compiler::CompilerError details:
        details.code == std::compiler::DiagnosticCode::InternalNamespace
r
}
} -result {value true}

test hb-secret-not-a-value {the key is runtime state: no native returns it, and nothing but the table hash reads it} -body {
    # No native's implementation is, or directly calls, the key's reader.
    set exposing {}
    foreach name [dict keys $::core::native::registry] {
        set impl [lindex [dict get [core::native::metadata $name] impl] 0]
        set body [expr {[info procs $impl] ne "" || [info procs ::$impl] ne "" ? [info body $impl] : ""}]
        if {[regexp {TableKey|tableKey|DrawKey} "$impl $body"]} {
            lappend exposing $name
        }
    }
    set readers {}
    foreach file [glob -directory [file join $::projectRoot core] *.tcl] {
        if {[regexp {TableKey|tableKey} [core::ReadFile $file]]} {
            lappend readers [file tail $file]
        }
    }
    set rust {}
    foreach file [glob -directory [file join $::projectRoot native src runtime] *.rs] {
        set text [core::ReadFile $file]
        if {[regexp {TABLE_HASH_KEY} $text]} {
            lappend rust [file tail $file] [regexp -all {TABLE_HASH_KEY} $text]
        }
    }
    list $exposing $readers $rust [dict get [core::native::metadata std::table_hash::of] contextFree]
} -result {{} hashing.tcl {ops.rs 3} 0}

# ---------------------------------------------------------------------------
# Allocation, interchange, isolation

test hb-allocation-free {the public and the table hash of an Int, a String, a struct and a nested struct allocate no heap object natively} -constraints nativeBuilt -body {
    # The same values made (and the same one result List) with and without
    # the eight hashes: what the hashes add.
    set prefix [string cat "import hashfix\n" $::hbPrelude "s = \"session-key-0042\"\nq = Q {a: P {x: 1, y: 2}, b: s, c: Color::Red}\n"]
    set base [hbHir [string cat $prefix "\[q, q.a, s, 7\]\n"]]
    set hashed [hbHir [string cat $prefix "\[q, q.a, s, 7, hash(7), hashfix::keyed(7), hash(s), hashfix::keyed(s), hash(q.a), hashfix::keyed(q.a), hash(q), hashfix::keyed(q)\]\n"]]
    set a [dict get [native::allocationReport $base summary] total allocations]
    set b [dict get [native::allocationReport $hashed summary] total allocations]
    list [expr {$b - $a}] [regexp -all {op (hashtotal|tablehashtotal)} [dict get [native::lower::program $hashed] text]]
} -result {0 8}

test hb-hir-text-and-interchange {a Hashable program's HIR text reads back to the same text and runs the same; its interchange form decodes and runs} -body {
    set hir [surface::compile [string cat $::hbPrelude {fn fingerprint(x: Hashable) -> int:
    x.hash()

[fingerprint({a: 1, b: "x2"}) == hash({b: "x2", a: 1}), fingerprint(P {x: 1, y: 2}) == hash(P {x: 1, y: 2})]
}] t.bot -warnings off]
    set text [hir::format $hir]
    set back [hir::parse $text]
    set decoded [hir::interchange::decode [hir::interchange::encode $hir]]
    list [regexp {trait Hashable intrinsic owner - requires hash\(value: Hashable\) -> int} $text] \
        [expr {[hir::format $back] eq $text}] [lindex [outcomeUnderHir cranelift $back] 1] [lindex [outcomeUnderHir interp $decoded] 1]
} -result {1 1 {[true, true]} {[true, true]}}

test hb-isolation {a Hashable program compiled before another compilation runs unchanged afterwards} -body {
    set first [surface::compile {fn fingerprint(x: Hashable) -> int:
    hash(x)

fingerprint([1, 2]) == hash([1, 2])
} t.bot -warnings off]
    surface::compile "struct Other:\n    x: int\n\n1\n" u.bot -warnings off
    list [lindex [outcomeUnderHir compile $first] 1] [lindex [outcomeUnderHir cranelift $first] 1]
} -result {true true}

test hb-no-traits-unchanged {a program that never names Hashable is no trait program: no traits, no monomorphization} -body {
    set hir [surface::compile "struct P:\n    x: int\n\nhash(P {x: 1})\n" t.bot -warnings off]
    list [dict exists $hir traits] [dict exists $hir traitFunctions]
} -result {0 0}

cleanupTests
