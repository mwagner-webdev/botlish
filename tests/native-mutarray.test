# native-mutarray.test -- MutableArray: the explicit mutable-storage
# substrate (core/mutarray.tcl, native/src/runtime/{value,ops,heap,metrics}.rs).
#
# Semantic checks are differential across every backend (see native.test's
# header): interp, compile, cranelift-generic, cranelift must agree. GC
# stress (BOTLISH_NATIVE_GC_STRESS=1) and allocation-instrumentation checks
# are native-backend-specific, like native-alloc.test's.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]

interp recursionlimit {} 100000

proc sourceHir {text} {
    return [surface::compile $text t.bot -strict 0]
}

proc sourceIR {text} {
    return [hir::lower [sourceHir $text]]
}

set parityBackends {interp compile cranelift-generic cranelift}

# The outcome of source TEXT on cranelift: {value V} or {error CODE MESSAGE}.
proc native {text} {
    lrange [outcomeUnder cranelift [sourceIR $text]] 0 end-1
}

proc parity {text} {
    set exprs [sourceIR $text]
    set outcomes [lmap backend $::parityBackends {outcomeUnder $backend $exprs}]
    if {[llength [lsort -unique $outcomes]] == 1} {
        return same
    }
    return [join [lmap backend $::parityBackends outcome $outcomes {list $backend $outcome}] " / "]
}

# ---------------------------------------------------------------------------
# Basic semantics

test mutarray-1 {a fresh array's capacity matches allocate's argument} -body {
    parity {import std::mutable_array
std::mutable_array::capacity(std::mutable_array::allocate(5))}
} -result same

test mutarray-2 {a fresh slot holds unit, not uninitialized memory} -body {
    parity {import std::mutable_array
std::mutable_array::at(std::mutable_array::allocate(3), 1)}
} -result same

test mutarray-3 {set then get reads back the written value} -body {
    parity "import std::mutable_array\nfn f():\n    a = std::mutable_array::allocate(3)\n    std::mutable_array::set(a, 1, \"hello\")\n    std::mutable_array::at(a, 1)\nf()"
} -result same

test mutarray-4 {set returns unit} -body {
    parity "import std::mutable_array\nfn f():\n    a = std::mutable_array::allocate(1)\n    std::mutable_array::set(a, 0, 1)\nf()"
} -result same

test mutarray-5 {mutation through one handle is observable through another} -body {
    parity "import std::mutable_array\nfn f():\n    a = std::mutable_array::allocate(2)\n    b = a\n    std::mutable_array::set(a, 0, 99)\n    std::mutable_array::at(b, 0)\nf()"
} -result same

test mutarray-6 {zero-capacity array} -body {
    parity {import std::mutable_array
std::mutable_array::capacity(std::mutable_array::allocate(0))}
} -result same

test mutarray-7 {allocate rejects a non-Int capacity} -body {
    parity {import std::mutable_array
std::mutable_array::allocate("3")}
} -result same

test mutarray-8 {get/set reject a non-mutarray first argument} -body {
    list [parity {import std::mutable_array
std::mutable_array::at([1, 2], 0)}] [parity {import std::mutable_array
std::mutable_array::set([1, 2], 0, 9)}]
} -result {same same}

# ---------------------------------------------------------------------------
# Bounds: negative index, index >= capacity, invalid copy range, oversized
# allocation, capacity arithmetic overflow (req #35)

test mutarray-bounds-1 {negative index (get)} -body {
    parity {import std::mutable_array
std::mutable_array::at(std::mutable_array::allocate(3), -1)}
} -result same

test mutarray-bounds-2 {index == capacity (get)} -body {
    parity {import std::mutable_array
std::mutable_array::at(std::mutable_array::allocate(3), 3)}
} -result same

test mutarray-bounds-3 {negative index (set)} -body {
    parity "import std::mutable_array\nfn f():\n    a = std::mutable_array::allocate(3)\n    std::mutable_array::set(a, -1, 9)\nf()"
} -result same

test mutarray-bounds-4 {index == capacity (set)} -body {
    parity "import std::mutable_array\nfn f():\n    a = std::mutable_array::allocate(3)\n    std::mutable_array::set(a, 3, 9)\nf()"
} -result same

test mutarray-bounds-5 {out-of-range access fails with IndexNotFound (uncaught here), never a default value} -body {
    native {import std::mutable_array
std::mutable_array::at(std::mutable_array::allocate(3), 3)}
} -result {error {CORE SEMANTIC UNCAUGHT-ERROR} {uncaught propagated error: <error IndexNotFound>}}

# Every backend raises RANGE for a negative/oversized capacity, but the
# reference interpreter (which has no small-Int representation to protect)
# and the native runtime (which enforces MAX_COLLECTION_LENGTH: value.rs)
# do not need to word the message identically -- so this checks the error
# code on each backend, not full outcome parity.
test mutarray-bounds-6 {negative allocate capacity is RANGE on every backend} -body {
    lmap backend $parityBackends {
        lrange [outcomeUnder $backend [sourceIR {import std::mutable_array
std::mutable_array::allocate(0 - 1)}]] 0 1
    }
} -result [lrepeat 4 {error {CORE SEMANTIC RANGE}}]

test mutarray-bounds-7 {a huge allocate capacity is a RANGE error, not a crash, on every backend} -body {
    lmap backend $parityBackends {
        lrange [outcomeUnder $backend [sourceIR {import std::mutable_array
std::mutable_array::allocate(100000000000000000000000000000000000000)}]] 0 1
    }
} -result [lrepeat 4 {error {CORE SEMANTIC RANGE}}]

test mutarray-bounds-8 {freeze count > capacity} -body {
    parity {import std::mutable_array
std::mutable_array::freeze(std::mutable_array::allocate(3), 4)}
} -result same

test mutarray-bounds-9 {freeze negative count} -body {
    parity {import std::mutable_array
std::mutable_array::freeze(std::mutable_array::allocate(3), 0 - 1)}
} -result same

test mutarray-copy-bounds-1 {copy count larger than either capacity} -body {
    parity "import std::mutable_array\nfn f():\n    a = std::mutable_array::allocate(3)\n    b = std::mutable_array::allocate(3)\n    std::mutable_array::copy(a, 0, b, 0, 10)\nf()"
} -result same

test mutarray-copy-bounds-2 {copy destination offset pushes past capacity} -body {
    parity "import std::mutable_array\nfn f():\n    a = std::mutable_array::allocate(5)\n    b = std::mutable_array::allocate(5)\n    std::mutable_array::copy(a, 3, b, 0, 3)\nf()"
} -result same

test mutarray-copy-bounds-3 {copy source offset pushes past capacity} -body {
    parity "import std::mutable_array\nfn f():\n    a = std::mutable_array::allocate(5)\n    b = std::mutable_array::allocate(5)\n    std::mutable_array::copy(a, 0, b, 3, 3)\nf()"
} -result same

test mutarray-copy-bounds-4 {negative dst/src start or count} -body {
    list \
        [parity "import std::mutable_array\nfn f():\n    a = std::mutable_array::allocate(3)\n    std::mutable_array::copy(a, 0 - 1, a, 0, 1)\nf()"] \
        [parity "import std::mutable_array\nfn f():\n    a = std::mutable_array::allocate(3)\n    std::mutable_array::copy(a, 0, a, 0 - 1, 1)\nf()"] \
        [parity "import std::mutable_array\nfn f():\n    a = std::mutable_array::allocate(3)\n    std::mutable_array::copy(a, 0, a, 0, 0 - 1)\nf()"]
} -result {same same same}

# ---------------------------------------------------------------------------
# Bulk copy correctness: zero elements, full range, partial range, offsets,
# both overlap directions (memmove semantics)

test mutarray-copy-1 {copying zero elements is a no-op} -body {
    parity "import std::mutable_array\nfn f():\n    a = std::mutable_array::allocate(3)\n    std::mutable_array::set(a, 0, 1)\n    std::mutable_array::copy(a, 0, a, 2, 0)\n    std::mutable_array::freeze(a, 3)\nf()"
} -result same

test mutarray-copy-2 {full-range copy into a larger array} -body {
    parity "import std::mutable_array\nfn f():\n    a = std::mutable_array::allocate(3)\n    std::mutable_array::set(a, 0, 1)\n    std::mutable_array::set(a, 1, 2)\n    std::mutable_array::set(a, 2, 3)\n    b = std::mutable_array::allocate(5)\n    std::mutable_array::copy(b, 0, a, 0, 3)\n    std::mutable_array::freeze(b, 3)\nf()"
} -result same

test mutarray-copy-3 {partial-range copy with both offsets} -body {
    parity "import std::mutable_array\nfn f():\n    a = std::mutable_array::allocate(5)\n    std::mutable_array::set(a, 0, 1)\n    std::mutable_array::set(a, 1, 2)\n    std::mutable_array::set(a, 2, 3)\n    std::mutable_array::set(a, 3, 4)\n    std::mutable_array::set(a, 4, 5)\n    b = std::mutable_array::allocate(5)\n    std::mutable_array::copy(b, 2, a, 1, 2)\n    std::mutable_array::freeze(b, 5)\nf()"
} -result same

test mutarray-copy-4 {overlapping self-copy, destination after source (forward)} -body {
    parity "import std::mutable_array\nfn f():\n    a = std::mutable_array::allocate(5)\n    std::mutable_array::set(a, 0, 1)\n    std::mutable_array::set(a, 1, 2)\n    std::mutable_array::set(a, 2, 3)\n    std::mutable_array::set(a, 3, 4)\n    std::mutable_array::set(a, 4, 5)\n    std::mutable_array::copy(a, 1, a, 0, 3)\n    std::mutable_array::freeze(a, 5)\nf()"
} -result same

test mutarray-copy-5 {overlapping self-copy, destination before source (backward)} -body {
    parity "import std::mutable_array\nfn f():\n    a = std::mutable_array::allocate(5)\n    std::mutable_array::set(a, 0, 1)\n    std::mutable_array::set(a, 1, 2)\n    std::mutable_array::set(a, 2, 3)\n    std::mutable_array::set(a, 3, 4)\n    std::mutable_array::set(a, 4, 5)\n    std::mutable_array::copy(a, 0, a, 1, 3)\n    std::mutable_array::freeze(a, 5)\nf()"
} -result same

test mutarray-copy-6 {overlapping self-copy over the identical range is a no-op} -body {
    parity "import std::mutable_array\nfn f():\n    a = std::mutable_array::allocate(3)\n    std::mutable_array::set(a, 0, 1)\n    std::mutable_array::set(a, 1, 2)\n    std::mutable_array::set(a, 2, 3)\n    std::mutable_array::copy(a, 0, a, 0, 3)\n    std::mutable_array::freeze(a, 3)\nf()"
} -result same

# ---------------------------------------------------------------------------
# Finalization

test mutarray-freeze-1 {freeze produces an ordinary List, usable by list natives} -body {
    parity "import std::list\nimport std::mutable_array\nfn f():\n    a = std::mutable_array::allocate(3)\n    std::mutable_array::set(a, 0, 10)\n    std::mutable_array::set(a, 1, 20)\n    std::mutable_array::set(a, 2, 30)\n    l = std::mutable_array::freeze(a, 3)\n    \[std::list::length(l), std::list::at(l, 1)\]\nf()"
} -result same

test mutarray-freeze-2 {freezing a prefix ignores the rest of the array} -body {
    parity "import std::mutable_array\nfn f():\n    a = std::mutable_array::allocate(5)\n    std::mutable_array::set(a, 0, 1)\n    std::mutable_array::set(a, 1, 2)\n    std::mutable_array::freeze(a, 2)\nf()"
} -result same

test mutarray-freeze-3 {mutating the array after freeze does not change the frozen List} -body {
    parity "import std::mutable_array\nfn f():\n    a = std::mutable_array::allocate(2)\n    std::mutable_array::set(a, 0, 1)\n    frozen = std::mutable_array::freeze(a, 2)\n    std::mutable_array::set(a, 0, 999)\n    \[frozen, std::mutable_array::at(a, 0)\]\nf()"
} -result same

test mutarray-freeze-4 {freezing capacity 0} -body {
    parity {import std::mutable_array
std::mutable_array::freeze(std::mutable_array::allocate(0), 0)}
} -result same

# ---------------------------------------------------------------------------
# No structural equality (like Block/Native)

test mutarray-eq-1 {== between two MutableArrays is an EQUALITY error} -body {
    parity {import std::mutable_array
std::mutable_array::allocate(1) == std::mutable_array::allocate(1)}
} -result same

test mutarray-eq-2 {== between a MutableArray and an ordinary value is an EQUALITY error} -body {
    parity {import std::mutable_array
std::mutable_array::allocate(1) == 1}
} -result same

# ---------------------------------------------------------------------------
# Builders: ordinary Botlish construction strategies over MutableArray.
# The state threading below mirrors examples/stdlib/csv_geometric.bot and
# csv_chunked.bot exactly (kept in sync by hand: both are short and this
# keeps the test self-contained). "persistent" is the existing std::list::append
# baseline (frozen, unchanged, in examples/stdlib/csv.bot); the strategy
# equivalence check (req #41) is that all three produce the same List.

set builders {
import std::list
import std::mutable_array
fn geo_new():
    [std::mutable_array::allocate(0), 0]

fn geo_new_capacity(capacity, length):
    doubled = capacity * 2
    if doubled <= length:
        return length + 1

    doubled

fn geo_grow(storage, length):
    capacity = std::mutable_array::capacity(storage)
    if length < capacity:
        return storage

    new_capacity = geo_new_capacity(capacity, length)
    fresh = std::mutable_array::allocate(new_capacity)
    std::mutable_array::copy(fresh, 0, storage, 0, length)
    fresh

fn geo_append(builder, value):
    storage = std::list::at(builder, 0)
    length = std::list::at(builder, 1)
    grown = geo_grow(storage, length)
    std::mutable_array::set(grown, length, value)
    [grown, length + 1]

fn geo_finish(builder):
    storage = std::list::at(builder, 0)
    length = std::list::at(builder, 1)
    std::mutable_array::freeze(storage, length)

fn chunk_size():
    4

fn chunked_new():
    [[], std::mutable_array::allocate(chunk_size()), 0]

fn chunked_append(builder, value):
    completed = std::list::at(builder, 0)
    current = std::list::at(builder, 1)
    filled = std::list::at(builder, 2)
    if filled == chunk_size():
        more = std::list::append(completed, current)
        fresh = std::mutable_array::allocate(chunk_size())
        std::mutable_array::set(fresh, 0, value)
        return [more, fresh, 1]

    std::mutable_array::set(current, filled, value)
    [completed, current, filled + 1]

# FINAL is chunked_finish's array, filled through a place parameter (an
# ordinary parameter would be the function's own copy: the completed chunks
# would never reach the result, NONPLACE-PARAMETER-MUTATION).
fn chunked_copy_chunks(chunks, index, place final: mutarray, offset):
    if index >= std::list::length(chunks):
        return offset

    chunk = std::list::at(chunks, index)
    std::mutable_array::copy(final, offset, chunk, 0, chunk_size())
    chunked_copy_chunks(chunks, index + 1, final, offset + chunk_size())

fn chunked_finish(builder):
    completed = std::list::at(builder, 0)
    current = std::list::at(builder, 1)
    filled = std::list::at(builder, 2)
    total = std::list::length(completed) * chunk_size() + filled
    final = std::mutable_array::allocate(total)
    offset = chunked_copy_chunks(completed, 0, final, 0)
    std::mutable_array::copy(final, offset, current, 0, filled)
    std::mutable_array::freeze(final, total)

fn fill_geo(b, i, n):
    if i >= n:
        return geo_finish(b)
    fill_geo(geo_append(b, [i, "v"]), i + 1, n)

fn fill_chunked(b, i, n):
    if i >= n:
        return chunked_finish(b)
    fill_chunked(chunked_append(b, [i, "v"]), i + 1, n)

fn fill_persistent(l, i, n):
    if i >= n:
        return l
    fill_persistent(std::list::append(l, [i, "v"]), i + 1, n)

fn check(n):
    a = fill_geo(geo_new(), 0, n)
    b = fill_chunked(chunked_new(), 0, n)
    c = fill_persistent([], 0, n)
    [a == c, b == c, std::list::length(a)]
}

# 0, 1, chunk_size()'s boundary (4) and boundary+1, and a size exercising
# several geometric growth steps and several completed chunks.
foreach n {0 1 3 4 5 8 100} {
    test mutarray-builder-$n "GeometricBuilder and ChunkedBuilder agree with persistent std::list::append at n=$n" -body {
        parity "$builders\ncheck($n)"
    } -result same
}

test mutarray-builder-values-1 {builders hold heap values (strings, nested lists) correctly} -body {
    parity "$builders\nfill_geo(geo_new(), 0, 37) == fill_persistent(\[\], 0, 37)"
} -result same

# ---------------------------------------------------------------------------
# GC stress: values reachable only through a MutableArray survive collection
# (BOTLISH_NATIVE_GC_STRESS=1 collects before every allocation).

test mutarray-gc-stress-1 {values stored only in a MutableArray stay live across GC, including through growth/copy/freeze} -setup {
    set ::env(BOTLISH_NATIVE_GC_STRESS) 1
} -cleanup {
    unset ::env(BOTLISH_NATIVE_GC_STRESS)
} -body {
    # Each string is heap-allocated (concat forces a fresh allocation, not a
    # constant), stored only inside the MutableArray/builder, and read back
    # after further allocations (each of which may trigger a collection
    # under stress) -- including a grow (allocate + copy) and a freeze.
    set text {
import std::list
import std::mutable_array
import std::str
fn label(i):
    if i == 0:
        return "x"

    std::str::concat(label(i - 1), "x")

fn geo_new():
    [std::mutable_array::allocate(0), 0]

fn geo_new_capacity(capacity, length):
    doubled = capacity * 2
    if doubled <= length:
        return length + 1

    doubled

fn geo_grow(storage, length):
    capacity = std::mutable_array::capacity(storage)
    if length < capacity:
        return storage

    new_capacity = geo_new_capacity(capacity, length)
    fresh = std::mutable_array::allocate(new_capacity)
    std::mutable_array::copy(fresh, 0, storage, 0, length)
    fresh

fn geo_append(builder, value):
    storage = std::list::at(builder, 0)
    length = std::list::at(builder, 1)
    grown = geo_grow(storage, length)
    std::mutable_array::set(grown, length, value)
    [grown, length + 1]

fn geo_finish(builder):
    storage = std::list::at(builder, 0)
    length = std::list::at(builder, 1)
    std::mutable_array::freeze(storage, length)

fn fill(b, i, n):
    if i >= n:
        return geo_finish(b)
    fill(geo_append(b, label(i)), i + 1, n)

[std::list::length(fill(geo_new(), 0, 50)), std::list::at(fill(geo_new(), 0, 50), 17), std::list::at(fill(geo_new(), 0, 50), 49)]
}
    native::evalHir [sourceHir $text] -specialize 1
} -result [list list [list {int 50} [list str [string repeat x 18]] [list str [string repeat x 50]]]]

test mutarray-gc-stress-2 {allocation report stays internally consistent while MutableArrays are live} -body {
    set ::env(BOTLISH_NATIVE_GC_STRESS) 1
    set text "import std::mutable_array\nimport std::str\nfn build(n, i, a):\n    w = a\n    if i >= n:\n        return w\n    std::mutable_array::set(w, i, std::str::concat(\"x\", \"\"))\n    build(n, i + 1, w)\n\nstd::mutable_array::capacity(build(30, 0, std::mutable_array::allocate(30)))"
    set report [native::allocationReport [sourceHir $text] summary]
    unset ::env(BOTLISH_NATIVE_GC_STRESS)
    set total [dict get $report total]
    list [expr {[dict get $total peakLiveObjects] >= [dict get $total currentLiveObjects]}] \
        [expr {[dict get $report gc cycles] > 0}] \
        [dict get $report byKind MutableArray allocations]
} -result {1 1 1}

# ---------------------------------------------------------------------------
# Allocation/copy instrumentation: the new storage kind is visible through
# the existing machinery (req #10-#13, #42-#43), using the canonical heap
# accounting path (no second metric system).

test mutarray-alloc-1 {allocate is one MutableArray allocation, nothing else} -body {
    set report [native::allocationReport [sourceHir {import std::mutable_array
std::mutable_array::capacity(std::mutable_array::allocate(5))}] summary]
    list [dict get $report total allocations] [dict get $report byKind MutableArray allocations]
} -result {1 1}

test mutarray-alloc-2 {allocated bytes grow with capacity} -body {
    set small [dict get [native::allocationReport [sourceHir {import std::mutable_array
std::mutable_array::capacity(std::mutable_array::allocate(2))}] summary] byKind MutableArray allocatedBytes]
    set large [dict get [native::allocationReport [sourceHir {import std::mutable_array
std::mutable_array::capacity(std::mutable_array::allocate(200))}] summary] byKind MutableArray allocatedBytes]
    expr {$large > $small}
} -result 1

test mutarray-copy-metric-1 {std::mutable_array::copy counts elements copied} -body {
    set text "import std::mutable_array\nfn f():\n    a = std::mutable_array::allocate(5)\n    b = std::mutable_array::allocate(5)\n    std::mutable_array::copy(b, 0, a, 0, 5)\nf()"
    dict get [native::allocationReport [sourceHir $text] summary] copies mutableArrayElements
} -result 5

test mutarray-copy-metric-2 {freeze counts its copy, an ordinary append write does not} -body {
    # A single std::mutable_array::set of a caller-supplied value into unused
    # capacity is a write, not a copy of an existing value (req #43): only
    # the freeze's own copy of the 3 elements shows up in
    # mutableArrayElements.
    set text "import std::mutable_array\nfn f():\n    a = std::mutable_array::allocate(3)\n    std::mutable_array::set(a, 0, 1)\n    std::mutable_array::set(a, 1, 2)\n    std::mutable_array::set(a, 2, 3)\n    std::mutable_array::freeze(a, 3)\nf()"
    dict get [native::allocationReport [sourceHir $text] summary] copies mutableArrayElements
} -result 3

test mutarray-mutation-metric-1 {optional read/write counters} -body {
    set text "import std::mutable_array\nfn f():\n    a = std::mutable_array::allocate(2)\n    std::mutable_array::set(a, 0, 1)\n    std::mutable_array::set(a, 1, 2)\n    \[std::mutable_array::at(a, 0), std::mutable_array::at(a, 1)\]\nf()"
    set report [native::allocationReport [sourceHir $text] summary]
    list [dict get $report mutableArray writes] [dict get $report mutableArray reads]
} -result {2 2}

# The geometric builder threads its storage and length separately, as the
# corpus's does (TYPED-MUTARRAY-BUILDER-REFACTOR.md): a MutableArray is a
# value (MUTABLE-ARRAY.md), so storage kept inside a `[storage, length]`
# List would be copied by every extraction (`std::list::at`), and every append's
# first write would then detach it -- a quadratic build. Threaded, each
# append mutates the one array it was handed (its caller's last use).
proc geoScalingProgram {n} {
    return "import std::list\nimport std::mutable_array\nfn geo_new_capacity(capacity, length):\n    doubled = capacity * 2\n    if doubled <= length:\n        return length + 1\n\n    doubled\n\nfn geo_grow(storage, length):\n    capacity = std::mutable_array::capacity(storage)\n    if length < capacity:\n        return storage\n\n    new_capacity = geo_new_capacity(capacity, length)\n    fresh = std::mutable_array::allocate(new_capacity)\n    std::mutable_array::copy(fresh, 0, storage, 0, length)\n    fresh\n\nfn geo_append(storage, length, value):\n    grown = geo_grow(storage, length)\n    std::mutable_array::set(grown, length, value)\n    grown\n\nfn fill(storage, i, n):\n    if i >= n:\n        return std::mutable_array::freeze(storage, n)\n    fill(geo_append(storage, i, i), i + 1, n)\n\nstd::list::length(fill(std::mutable_array::allocate(0), 0, $n))\n"
}

test mutarray-builder-scaling-1 {geometric construction: O(log N) allocations, O(N) elements copied (never quadratic), and no copy-on-write detach} -body {
    set small [native::allocationReport [sourceHir [geoScalingProgram 100]] summary]
    set large [native::allocationReport [sourceHir [geoScalingProgram 1000]] summary]
    set smallAllocs [dict get $small byKind MutableArray allocations]
    set largeAllocs [dict get $large byKind MutableArray allocations]
    set smallCopied [dict get $small copies mutableArrayElements]
    set largeCopied [dict get $large copies mutableArrayElements]
    # 10x the elements: allocation count barely moves (log growth), copied
    # elements scale much closer to 10x than 100x (never quadratic).
    set largeDetached [dict get $large mutableArray detachElements]
    list [expr {$largeAllocs < $smallAllocs * 3}] \
        [expr {$largeCopied < $smallCopied * 20}] $largeDetached
} -result {1 1 0}

cleanupTests
