    }
} -result {std::dfa::UnrecognizedInput {std::dfa::UnexpectedEnd std::dfa::UnrecognizedInput}}

test dfa-protocol-alphabets {bytes, ascii and unicode: a unicode recognizer takes scalar values beyond the BMP and rejects a surrogate; a bytes one validates UTF-8} -body {
    dfaAgree "import std::dfa\n\ndfa utf8 over bytes:\n    start:\n        0x00..0x7F -> accept\n        0xC2..0xDF -> tail1\n        0xE0 -> e0\n        0xE1..0xEC 0xEE..0xEF -> tail2\n        0xED -> ed\n        0xF0 -> f0\n        0xF1..0xF3 -> tail3\n        0xF4 -> f4\n    e0:\n        0xA0..0xBF -> tail1\n    ed:\n        0x80..0x9F -> tail1\n    f0:\n        0x90..0xBF -> tail2\n    f4:\n        0x80..0x8F -> tail2\n    tail3:\n        0x80..0xBF -> tail2\n    tail2:\n        0x80..0xBF -> tail1\n    tail1:\n        0x80..0xBF -> accept\n\ndfa wide over unicode:\n    start:\n        0x10000..0x10FFFF -> accept\n[dfaRunner utf8]\nfn w(c: int) -> str:\n    n = wide(c):\n        on std::dfa::UnrecognizedInput:\n            return \"no\"\n        on std::dfa::UnexpectedEnd:\n            return \"no\"\n    std::int::to_string(n)\n\n\[run(240, \[159, 152, 128\]), run(237, \[160, 128\]), run(224, \[128, 128\]), run(65, \[\]), w(128512), w(55296)\]"
} -result {value {["accept 0", "unrecognized utf8 ed 160", "unrecognized utf8 e0 128", "accept 0", "0", "no"]}}

# ---------------------------------------------------------------------------
# Model-based: the compiled recognizers against the reference interpreter
# (tests/dfa-support.tcl), every case on every backend. The cases are every
# interesting symbol alone and before the end, and random walks that keep the
# run alive, ended by the end or by a random symbol.

set dfaModelLex {import std::dfa

class digit = '0'..'9'
class nondigit = any except digit
class blank = ' ' ','

# Lookahead of one: a number ends before the blank after it.
dfa number over ascii:
    start:
        '-' -> minus
        '0' -> zero
        '1'..'9' -> integer
    minus:
        '0' -> zero
        '1'..'9' -> integer
    zero:
        '.' -> dot
        blank -> accept before
        end -> accept
    integer:
        digit -> integer
        '.' -> dot
        blank -> accept before
        end -> accept
    dot:
        digit -> fraction
    fraction:
        digit -> fraction
        blank -> accept before
        end -> accept

class safe = 0x21..0x7E except ',' '[' ']' '{' '}'
class plain = safe except ':'

# Lookahead of two: YAML's plain scalar in flow context, one word of it.
dfa scalar over ascii:
    start:
        plain -> body
    body:
        plain -> body
        ':' -> colon
        ' ' ',' -> accept before
        end -> accept
    colon:
        plain -> body
        ':' -> colon
        ' ' ',' -> accept before 2
        end -> accept before 1

# Lookahead of three: a run of a's and dashes ends before "-->".
dfa arrow over ascii:
    start:
        'a' -> a
    a:
        'a' -> a
        '-' -> d1
        end -> accept
    d1:
        'a' -> a
        '-' -> d2
        end -> accept before 1
    d2:
        'a' -> a
        '>' -> accept before 3
        end -> accept before 2

dfa digits over ascii:
    start:
        digit -> more
    more:
        digit -> more
        nondigit -> accept before
        end -> accept

class nondot = any except '.'

# Delegation: then STATE reconsiders what the callee left; then accept
# passes its count on.
dfa pair over ascii:
    start:
        digit -> call digits then sep
    sep:
        '.' -> frac
        nondot -> accept before
        end -> accept
    frac:
        digit -> call digits then accept

# Nested delegation, three deep.
dfa group over ascii:
    start:
        '(' -> open
    open:
        digit -> call pair then close
    close:
        ')' -> accept

# A callee's lookahead of up to three passed through `then accept`.
dfa tail over ascii:
    start:
        'a' -> call arrow then accept

# Sequences sharing prefixes.
dfa word over ascii:
    start:
        "true" -> accept
        "trap" -> accept
        "no" -> after
    after:
        "ne" -> accept
        ' ' -> accept before
        end -> accept

dfa utf8 over bytes:
    start:
        0x00..0x7F -> accept
        0xC2..0xDF -> tail1
        0xE0 -> e0
        0xE1..0xEC 0xEE..0xEF -> tail2
        0xED -> ed
        0xF0 -> f0
        0xF1..0xF3 -> tail3
        0xF4 -> f4
    e0:
        0xA0..0xBF -> tail1
    ed:
        0x80..0x9F -> tail1
    f0:
        0x90..0xBF -> tail2
    f4:
        0x80..0x8F -> tail2
    tail3:
        0x80..0xBF -> tail2
    tail2:
        0x80..0xBF -> tail1
    tail1:
        0x80..0xBF -> accept

dfa wide over unicode:
    start:
        0x10000..0x10FFFF 'x' -> more
    more:
        0x10000..0x10FFFF 'x' -> more
        ' ' -> accept before
        end -> accept
}

# A workspace holding the module lex.bot ($dfaModelLex) and its cases for
# SEED: {DIR CASES}.
proc dfaModelCases {seed {frontier 200}} {
    set dir [dfatest::workspace lex.bot $::dfaModelLex]
    set model [dfaref::load [list lex [file join $dir lex.bot]]]
    set cases {}
    foreach r {number scalar arrow digits pair group tail word utf8 wide} {
        foreach w [dfatest::cases $model lex $r 20 $seed $frontier] {
            lappend cases [list $r lex::$r $w]
        }
    }
    return [list $dir $cases]
}

test dfa-model-compact {the compact lowering agrees with the reference on every case, on every backend (the native one in its default dispatch)} -body {
    lassign [dfaModelCases 11] dir cases
    list [expr {[llength $cases] > 1500}] [dfatest::compare $dir lex $cases]
} -result {1 {}}

test dfa-model-tree {the decision-tree lowering (kept for measurements) agrees with the reference too (a Tcl and a native backend)} -setup {
    set ::surface::dfa::lowering tree
    set saved $::dfatest::backends
    set ::dfatest::backends {interp cranelift-generic}
} -body {
    lassign [dfaModelCases 12 100] dir cases
    dfatest::compare $dir lex $cases
} -cleanup {
    set ::surface::dfa::lowering compact
    set ::dfatest::backends $saved
} -result {}

foreach mode {tree switch table} {
    test dfa-model-dispatch-$mode "the native dispatch $mode of the transition call agrees with the reference (the dispatch is the same NIR in every native mode)" -constraints nativeCoroutines -setup {
        set ::env(BOTLISH_NATIVE_DFA_DISPATCH) $mode
        set saved $::dfatest::backends
        set ::dfatest::backends {cranelift-generic}
    } -body {
        lassign [dfaModelCases 13 100] dir cases
        dfatest::compare $dir lex $cases
    } -cleanup {
        unset ::env(BOTLISH_NATIVE_DFA_DISPATCH)
        set ::dfatest::backends $saved
    } -result {}
}

# ---------------------------------------------------------------------------
# Modules: a class or a recognizer of another module, by its qualified or
# rooted name; imports; a rejected module recognizer's importers

set dfaTokens {import std::dfa

class digit = '0'..'9'
class sign = '+' '-'

dfa number over ascii:
    start:
        digit -> more
    more:
        digit -> more
        ' ' -> accept before
        end -> accept
}

test dfa-modules-qualified-and-rooted {a declaration uses another module's classes and recognizers by their qualified or rooted names; a module recognizer's payload names it qualified} -body {
    dfaFilesAgree tokens.bot $::dfaTokens main.bot "import std::dfa
import tokens

class odd = '1' '3' '5' '7' '9'
class even = tokens::digit except odd
class signs = ::tokens::sign

dfa signed over ascii:
    start:
        signs -> after
        even -> call ::tokens::number then accept
        odd -> call tokens::number then accept
    after:
        tokens::digit -> call tokens::number then accept
[dfaRunner signed]

fn r(c: int) -> str:
    coroutine {first} = tokens::number(c):
        on std::dfa::UnrecognizedInput {recognizer}:
            return recognizer
        on std::dfa::UnexpectedEnd {recognizer}:
            return recognizer
    std::int::to_string(first)

\[run(43, \[49, 50, 32\]), run(52, \[-1\]), run(43, \[120\]), run(55, \[97\]), run(45, \[-1\]), r(49), r(32)\]
"
} -result {value {["accept 1", "accept 0", "unrecognized signed after 120", "unrecognized tokens::number more 97", "end signed after", "0", "tokens::number"]}}

test dfa-modules-missing-import {a class or a recognizer of a module the file does not import is MISSING-IMPORT where it is written, each use its own diagnostic, and nothing about the declaration that uses it} -body {
    dfaFilesDiag tokens.bot $::dfaTokens main.bot "import std::dfa

class nz = tokens::digit except '0'

dfa d over ascii:
    start:
        nz -> call tokens::number then accept
0
"
} -result {{MISSING-IMPORT main.bot:3:12 {}} {MISSING-IMPORT main.bot:7:20 {}}}

test dfa-modules-rejected-module-recognizer {a rejected recognizer of a module is its module's diagnostic; an importer's declaration that calls it and its function that resumes it say nothing; the importer's own independent error is reported} -body {
    dfaFilesDiag tokens.bot "import std::dfa

dfa number over ascii:
    start:
        '0'..'9' -> nowhere
" main.bot "import std::dfa
import tokens

dfa d over ascii:
    start:
        '+' -> call tokens::number then accept

fn f(c: int) -> int errors std::dfa::UnrecognizedInput, std::dfa::UnexpectedEnd:
    tokens::number(c)

fn g() -> str:
    1
0
"
} -result {{DFA-UNKNOWN-STATE tokens.bot:5:21 {}} {TYPE main.bot:11:5 {}}}

test dfa-modules-names {a recognizer's states, its local classes and its generated functions are no names of the program: a state is unbound outside its declaration, and the recognizer itself is no method} -body {
    list [lindex [dfaDiag "dfa d over ascii:\n    class x = 'x'\n    start:\n        x -> accept\nstart" ] 0 0] \
        [lindex [dfaDiag "dfa d over ascii:\n    class x = 'x'\n    start:\n        x -> accept\nx" ] 0 0] \
        [lindex [dfaDiag "dfa d over ascii:\n    start:\n        'x' -> accept\nfn f(c: int) -> int errors std::dfa::UnrecognizedInput, std::dfa::UnexpectedEnd:\n    c.d()\n0" ] 0 0]
} -result {UNBOUND UNBOUND NOMETHOD-CALL}

test dfa-modules-interchange {a program with recognizers read back from HIR interchange runs as it was built (everything a backend reads is in the HIR)} -constraints nativeCoroutines -body {
    set dir [dfatest::workspace tokens.bot $::dfaTokens main.bot [dfaHoist "import std::dfa\nimport tokens\n[dfaRunner tokens::number]\n\[run(49, \[50, 32\]), run(49, \[120\])\]\n"]]
    set hir [surface::readProgramFile [file join $dir main.bot] -warnings off]
    set read [hir::interchange::decode [hir::interchange::encode $hir]]
    list [lrange [outcomeUnderHir interp $hir] 0 end-1] [lrange [outcomeUnderHir interp $read] 0 end-1] [lrange [outcomeUnderHir cranelift $read] 0 end-1]
} -result {{value {["accept 1", "unrecognized tokens::number more 120"]}} {value {["accept 1", "unrecognized tokens::number more 120"]}} {value {["accept 1", "unrecognized tokens::number more 120"]}}}

# ---------------------------------------------------------------------------
# Lowering: one transition call per recognizer, the native dispatch forms,
# fusion, no allocation per symbol, warning-clean generated code

# The number of dfa#transition calls in HIR.
proc dfaTransitionCalls {hir} {
    set n 0
    foreach e [hirFind $hir call] {
        set callee [hir::get $hir $e callee]
        if {[hir::kind $hir $callee] eq "ref" && [hir::get $hir $callee name] eq "dfa#transition"} {
            incr n
        }
    }
    return $n
}

test dfa-lowering-one-transition-call {a recognizer's transitions are one dfa#transition call over its constant table, whatever its number of states: the model's ten recognizers, ten calls} -body {
    set hir [surface::compile "$::dfaModelLex\n0" t.bot -warnings off]
    dfaTransitionCalls $hir
} -result 10

# A driver feeding recognizer number N symbols, all in one function (so its
# coroutine is fused).
proc dfaDriverProgram {n} {
    return "import std::dfa
import std::coroutine
import std::mutable_array

class digit = '0'..'9'

dfa number over ascii:
    start:
        digit -> more
    more:
        digit -> more
        ' ' -> accept before
        end -> accept

dfa wide over unicode:
    start:
        0x10000..0x10FFFF 'x' -> more
    more:
        0x10000..0x10FFFF 'x' -> more
        ' ' -> accept before
        end -> accept

fn count(n: int) -> int errors std::dfa::UnrecognizedInput, std::dfa::UnexpectedEnd:
    coroutine {step} = number(49)
    i = std::mutable_array::create(1, 0)
    loop:
        if std::mutable_array::at(i, 0) >= n:
            break
        std::mutable_array::set(i, 0, std::mutable_array::at(i, 0) + 1)
        step(std::dfa::Symbol {code: 53})
    step(std::dfa::Symbol {code: 32})

fn w() -> int errors std::dfa::UnrecognizedInput, std::dfa::UnexpectedEnd:
    coroutine {step} = wide(120)
    step(std::dfa::Symbol {code: 128512})
    step(std::dfa::Symbol {code: -1})

r = count($n):
    on std::dfa::UnrecognizedInput:
        -1
    on std::dfa::UnexpectedEnd:
        -2
s = w():
    on std::dfa::UnrecognizedInput:
        -1
    on std::dfa::UnexpectedEnd:
        -2
\[r, s\]
"
}

test dfa-lowering-native-dispatch {natively a transition call is control flow over its constant table: a byte-table load per state and symbol (table, when every row's intervals lie in -1..255; any other recognizer as switch), multiway branches on the state and on the symbol (switch: Cranelift lowers each to a jump table or a balanced search), or nested ifs (tree); auto takes table where it applies, switch otherwise -- the same answers every way} -constraints nativeCoroutines -body {
    set hir [surface::compile [dfaDriverProgram 3] t.bot -warnings off]
    set out {}
    foreach mode {auto tree switch table} {
        set text [native::nir $hir -dfa-dispatch $mode]
        lappend out $mode [regexp -all {\n\s*switch %} $text] [regexp -all {rtabload8|rtabload16} $text] \
            [native::evalHir $hir -dfa-dispatch $mode]
    }
    set out
} -result {auto 3 2 {list {{int 1} {int 0}}} tree 0 0 {list {{int 1} {int 0}}} switch 6 0 {list {{int 1} {int 0}}} table 3 2 {list {{int 1} {int 0}}}}

test dfa-lowering-fused-no-allocation {a recognizer resumed only in the function that constructs it is fused into it -- no coroutine object, stack or switch -- and feeding it a symbol allocates nothing: the same allocations for ten symbols and a thousand (the driver's counter and the program's result List)} -constraints nativeCoroutines -body {
    set hir [surface::compile [dfaDriverProgram 10] t.bot -warnings off]
    set fused [lmap entry [native::fusion $hir] {lrange $entry 0 1}]
    set counts {}
    foreach n {10 1000} {
        set report [native::allocationReport [surface::compile [dfaDriverProgram $n] t.bot -warnings off] summary]
        lappend counts [dict get $report total allocations]
    }
    list $fused $counts
} -result {{{fused count} {fused w}} {2 2}}

test dfa-lowering-warning-clean {the code a declaration lowers to is warning-clean: one-letter recognizers and states give no ONE-CHAR-STRING-LITERAL (their names are no literals of the program), the generated functions no METHOD-ELIGIBLE (they are nomethod)} -body {
    surface::compile "$::dfaModelLex\ndfa a over ascii:\n    start:\n        'x' -> s\n    s:\n        end -> accept\n0" t.bot -warnings error
    string cat ok
} -result ok

# ---------------------------------------------------------------------------
# The compiler service: a declaration's diagnostics with their ranges and
# related locations; hover, definition and references of its names

source [file join $::projectRoot service service.tcl]

# A revision of the unsaved document SOURCE (and module documents FILES,
# NAME TEXT ...) at /virtual.
proc dfaRevision {source args} {
    set ws [service::workspace -warnings default -cache ""]
    foreach {name text} $args {
        service::setDocument $ws /virtual/$name $text
    }
    service::setDocument $ws /virtual/main.bot $source
    return [service::analyze $ws /virtual/main.bot]
}

# LINE:COLUMN-ENDLINE:ENDCOLUMN of RANGE (FILE: before it when not main.bot).
proc dfaRange {range} {
    set text [dict get $range line]:[dict get $range column]-[dict get $range endLine]:[dict get $range endColumn]
    if {[file tail [dict get $range file]] ne "main.bot"} {
        set text [file tail [dict get $range file]]:$text
    }
    return $text
}

test dfa-service-diagnostics {the service reports a declaration's diagnostics as the compiler does, each with its range and its related locations} -body {
    set rev [dfaRevision "import std::dfa\n\ndfa d over ascii:\n    start:\n        '0'..'9' -> a\n        '5' -> a\n    a:\n        end -> accept\n0\n"]
    lmap d [service::diagnostics $rev] {
        list [lindex [dict get $d code] end] [dfaRange $d] [lmap r [dict get $d related] {dfaRange $r}]
    }
} -result {{DFA-AMBIGUOUS-TRANSITION 6:9-6:12 {5:9-5:17 6:9-6:12}}}

set dfaServiceMain {import std::dfa
import tokens

class odd = '1' '3' '5'

dfa signed over ascii:
    start:
        '+' -> after
        odd -> call tokens::number then accept
    after:
        tokens::digit -> call tokens::number then done
    done:
        end -> accept
0
}

test dfa-service-names {a state, a class and a called recognizer have a hover, a definition (another module's included) and references, from the facts the declaration's checker recorded; a declaration's own name answers for itself} -body {
    set rev [dfaRevision $::dfaServiceMain tokens.bot $::dfaTokens]
    set out {}
    foreach {line column} {8 16 10 5 11 9 11 51 4 7 9 9 9 27} {
        set at [service::at $rev /virtual/main.bot $line $column]
        lappend out [list $line:$column [dict get $at construct kind] [dict get $at hover] \
            [dfaRange [dict get $at definition]] [lmap r [dict get $at references] {dfaRange $r}]]
    }
    join $out \n
} -result {8:16 dfa-state {state after of dfa signed over ascii:
    tokens::digit -> call tokens::number then done} 10:5-10:10 8:16-8:21
10:5 dfa-state {state after of dfa signed over ascii:
    tokens::digit -> call tokens::number then done} 10:5-10:10 8:16-8:21
11:9 dfa-class {class digit = '0'..'9'} tokens.bot:3:7-3:12 {tokens.bot:8:9-8:14 tokens.bot:10:9-10:14 11:9-11:22}
11:51 dfa-state {state done of dfa signed over ascii:
    end -> accept} 12:5-12:9 11:51-11:55
