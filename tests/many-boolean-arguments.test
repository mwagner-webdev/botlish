    list [llength [manyOf $a]] [llength [manyOf $b]] $c [llength [manyOf $d]] [llength [manyOf $e]]
} -result {0 2 1 0 2}

test mb-warnings-attached-structurally {hir::warnings::of equals collect} -body {
    set hir [compileWith $::sevenSource default]
    list [expr {[hir::warnings::of $hir] eq [hir::warnings::collect $hir]}] [llength [hir::warnings::collect $hir]]
} -result {1 7}

test mb-error-stops-before-backend {error mode rejects before any backend lowers anything (traces on all four entry points)} -body {
    set ::lowerCalls 0
    foreach command {native::evalHir native::prepareHir hir::lower core::compiler::evalHir} {
        trace add execution $command enter {apply {{args} {incr ::lowerCalls}}}
    }
    try {
        set rejected [catch {compileWith $::mbSource error} message options]
    } finally {
        foreach command {native::evalHir native::prepareHir hir::lower core::compiler::evalHir} {
