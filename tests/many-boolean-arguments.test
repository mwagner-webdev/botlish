# Record, message, ordering (items 8, 9)

set ::mbSource "$::openFile
a = \"a.txt\".open_file(true, false, true)
b = \"b.txt\".open_file(false, false, true)
\[a, b\]"

test mb-record-shape {the record is {code message primary secondary data}; secondary is empty (a single-location fact)} -body {
    set w [lindex [manyOf [compileWith $::mbSource]] 0]
    list [lsort [dict keys $w]] [dict get $w code] [dict get $w secondary]
} -result {{code data message primary secondary} MANY-BOOLEAN-ARGUMENTS {}}

test mb-record-data-fields {data: call (ExprId), callee (the call's target representation), calleeName, literals, positions -- nothing else, no rendered source text} -body {
    set hir [compileWith $::mbSource]
    set w [lindex [manyOf $hir] 0]
    set call [dict get $hir exprs [dict get $w data call]]
    list [lsort [dict keys [dict get $w data]]] [dict get $call kind] \
        [expr {[dict get $w data callee] eq [dict get $call target]}] [dict get $w data calleeName] \
        [dict get $w data literals] [dict get $w data positions]
} -result {{call callee calleeName literals positions} call 1 open_file 3 {2 3 4}}

test mb-primary-is-the-call {primary is the written call's own origin (its span)} -body {
    set hir [compileWith $::mbSource]
    lmap w [manyOf $hir] {expr {[dict get $w primary] eq [dict get $hir exprs [dict get $w data call] origin]}}
} -result {1 1}

test mb-render-has-no-notes {the rendered warning is one line: no note: lines} -body {
    set hir [compileWith $::mbSource]
    lmap w [manyOf $hir] {llength [split [hir::warnings::render $hir $w] \n]}
} -result {1 1}

test mb-message-template {the message states the count, names the callee and names the form, nothing else} -body {
    shown $::mbSource
} -result {{the call to `open_file` passes 3 boolean literals; flags name options @ 3:5} {the call to `open_file` passes 3 boolean literals; flags name options @ 4:5}}

test mb-no-flag-spelling-anywhere {no flag spelling is printed -- not in a message, not in data, not in the rendered text -- and nothing is prescribed: no mapping, no rewrite, no arity or default advice} -body {
    set source "fn open_file(path, append: bool, create: bool, sync: bool):
    path
fn tally(n: int, a: bool, b: bool) -> int:
    n
\[\"p\".open_file(true, false, true), tally(1, false, true)\]"
    set hir [compileWith $source]
    set seen {}
    foreach w [manyOf $hir] {
        set texts [list [dict get $w message] [dict get $w data] [regsub {^t\.bot:[0-9]+:[0-9]+:} [hir::warnings::render $hir $w] {}]]
        foreach text $texts {
            if {[regexp {(^|[^:A-Za-z0-9_]):[A-Za-z_]} $text spelling]} {
                lappend seen $spelling
            }
            foreach word {:append :create :sync :a :b append create sync -> " use " instead prefer "did you mean" rename fix should consider replace rewrite suggest default arity mapping " flags :" "true means" "false means"} {
                if {[string first $word $text] >= 0} {
                    lappend seen $word
                }
            }
        }
    }
    list [llength [manyOf $hir]] [lsort -unique $seen]
} -result {2 {}}

test mb-source-order-and-determinism {warnings in source order; compiling twice gives identical warnings} -body {
    set source "$::openFile
fn c(x):
    open_file(x, true, true, true)
fn a(x):
    open_file(x, false, false, false)
\[c(1), a(2), \"z\".open_file(true, true, false)\]"
    list [where $source] [expr {[hir::warnings::of [compileWith $source]] eq [hir::warnings::of [compileWith $source]]}]
} -result {{4:5 6:5 7:14} 1}

test mb-module-call-located-in-the-module {a module's own call is located in the module file and reported once for the program that loads it; the program's call of the module function is located in the program and names the module function} -body {
    withModules {opts.bot {fn open(path, append: bool, create: bool):
    path
fn reopen(path):
    open(path, true, false)
}} {
        set hir [compileWith {import opts
r = opts::open("x", true, false)
[r, opts::reopen("y"), opts::reopen("z")]}]
        lmap w [manyOf $hir] {list [file tail [hir::originLocation $hir [dict get $w primary]]] [dict get $w data calleeName]}
    }
} -result {{t.bot:2:5 opts::open} {opts.bot:4:5 opts::open}}

test mb-instances-never-walked {the pass reads the generic source HIR once: a call in a polymorphic function with several semantic instances is one warning; collecting over HIR stripped of the semantic side table gives the identical warnings} -body {
    set hir [compileWith "$::openFile
fn poly(x):
    open_file(x, true, false, true)
\[poly(1), poly(\"ab\"), poly(true)\]"]
    set call [dict get [lindex [manyOf $hir] 0] data call]
    set covering [lmap {id instance} [dict get $hir semantic instances] {
        if {![dict exists $instance snapshot exprs $call]} continue
        set id
    }]
    list [expr {[llength $covering] >= 3}] [llength [manyOf $hir]] \
        [expr {[hir::warnings::ManyBooleanArguments $hir] eq [hir::warnings::ManyBooleanArguments [dict remove $hir semantic]]}]
} -result {1 1 1}

test mb-trait-program-warned-as-written {a trait-polymorphic function's call is one warning: the program is warned as written (its checked source build), never as monomorphized, where the call exists once per witness} -body {
    withModules {wa.bot {struct A:
    v: int
fn size(value: A) -> int:
    value.v
} wb.bot {struct B:
    w: int
fn size(value: B) -> int:
    value.w
}} {
        set hir [compileWith {import wa
import wb
trait Sized:
    fn size(value: Sized) -> int
fn scale(n: int, double: bool, negate: bool) -> int:
    if double:
        return n * 2
    if negate:
        return 0 - n
    n
fn measure(value: Sized) -> int:
    value.size().scale(true, false)
[measure(wa::A {v: 2}), measure(wb::B {w: 3})]}]
        set clones 0
        dict for {e node} [dict get $hir exprs] {
            if {[dict get $node kind] eq "call" && [dict exists $node written] && [dict get $node written form] eq "method"
                    && [dict get $hir exprs [dict get $node callee] name] eq "scale"} {
                incr clones
            }
        }
        list $clones [lmap w [manyOf $hir] {loc $hir [dict get $w primary]}] [lindex [outcomeUnderHir interp $hir] 1]
    }
} -result {2 12:5 {[4, 6]}}

# ---------------------------------------------------------------------------
# Interleaving with the six existing codes (item 9)

set ::sevenSource {refined type E = str
error Bad
fn dup(x):
    if x < 0:
        return 0
    if x > 100:
        return 0
    return 1
fn two(a, b):
    a
fn pair(a, b):
    [a, b]
fn t(x):
    return two(x, 1)
fn check(x) errors Bad:
    if x < 0:
        fail Bad
    if x > 9:
        fail Bad
    x
fn emailish(v: str) -> bool proves v: E:
    v == "@"
fn opts(x, a: bool, b: bool):
    x
fn use_opts(x):
    x.opts(true, false)}

test mb-interleaving-seven-codes {all seven codes in one program, in source order} -body {
    allWarnings $::sevenSource
} -result {{SAME-RETURN-VALUE 5:9} {FIXED-ARITY-LIST-RETURN 12:5} {METHOD-ELIGIBLE 14:12} {SAME-FAILURE 17:9} {PROVES-NAMING 21:1} {ONE-CHAR-STRING-LITERAL 22:10} {MANY-BOOLEAN-ARGUMENTS 26:5}}

test mb-interleaving-seven-codes-other-order {the same seven warnings with the functions in the other order sort by location, not by code} -body {
    allWarnings {refined type E = str
error Bad
fn opts(x, a: bool, b: bool):
    x
fn use_opts(x):
    x.opts(true, false)
fn emailish(v: str) -> bool proves v: E:
    v == "@"
fn check(x) errors Bad:
    if x < 0:
        fail Bad
    if x > 9:
        fail Bad
    x
fn two(a, b):
    a
fn t(x):
    return two(x, 1)
fn pair(a, b):
    [a, b]
fn dup(x):
    if x < 0:
        return 0
    if x > 100:
        return 0
    return 1}
} -result {{MANY-BOOLEAN-ARGUMENTS 6:5} {PROVES-NAMING 7:1} {ONE-CHAR-STRING-LITERAL 8:10} {SAME-FAILURE 11:9} {METHOD-ELIGIBLE 18:12} {FIXED-ARITY-LIST-RETURN 20:5} {SAME-RETURN-VALUE 23:9}}

test mb-interleaving-deterministic {compiling the seven-code program twice yields the same warnings} -body {
    expr {[hir::warnings::of [compileWith $::sevenSource]] eq [hir::warnings::of [compileWith $::sevenSource]]}
} -result 1

test mb-independent-of-other-codes {a multi-bool call inside a construct that trips other codes is an independent diagnostic: a list literal of one-character Strings returned from a function (FIXED-ARITY-LIST-RETURN, ONE-CHAR-STRING-LITERAL) beside a functional multi-bool call (METHOD-ELIGIBLE and this)} -body {
    allWarnings "$::openFile
fn row(x):
    \[\"-\", \"+\", open_file(x, true, false, true)\]
row(\"path\")"
} -result {{FIXED-ARITY-LIST-RETURN 4:5} {ONE-CHAR-STRING-LITERAL 4:6} {ONE-CHAR-STRING-LITERAL 4:11} {MANY-BOOLEAN-ARGUMENTS 4:16} {METHOD-ELIGIBLE 4:16}}

