        compileWith $::mbSource default
        set on $::passCalls
    } finally {
        trace remove execution hir::warnings::ManyBooleanArguments enter {apply {{args} {incr ::passCalls}}}
    }
    list $off $on
} -result {0 1}

test mb-compilation-with-errors-has-no-warnings {a program the compiler rejects is never warned about} -body {
