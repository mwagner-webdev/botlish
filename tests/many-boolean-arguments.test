    } finally {
        set ::env(BOTLISH_WARNINGS) $saved
    }
} -result {MANY-BOOLEAN-ARGUMENTS MANY-BOOLEAN-ARGUMENTS}

test mb-environment-default {BOTLISH_WARNINGS is only the default for a compilation given no -warnings, read fresh each time} -body {
