test mb-no-new-modes-or-options {the policy surface is still exactly default, off, error; the registry is static, one line per code, seven codes} -body {
    list $hir::warnings::modes [dict keys $hir::warnings::passes] [dict get $hir::warnings::passes MANY-BOOLEAN-ARGUMENTS] \
        [expr {[llength [info commands hir::warnings::enable]] + [llength [info commands hir::warnings::disable]]}]
} -result {{default off error} {SAME-RETURN-VALUE METHOD-ELIGIBLE FIXED-ARITY-LIST-RETURN SAME-FAILURE PROVES-NAMING ONE-CHAR-STRING-LITERAL MANY-BOOLEAN-ARGUMENTS} hir::warnings::ManyBooleanArguments 0}

test mb-error-promotion-identity {the promoted error keeps the code and the message the warning has} -body {
    set w [lindex [manyOf [compileWith $::mbSource default]] 0]
