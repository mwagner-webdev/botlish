} -result {{} 0 1}

test mb-off-runs-no-warning-pass-via-trace {an execution trace on the pass proves it is not invoked when off} -body {
    set ::passCalls 0
    trace add execution hir::warnings::ManyBooleanArguments enter {apply {{args} {incr ::passCalls}}}
