# many-boolean-arguments.test -- the MANY-BOOLEAN-ARGUMENTS compiler warning
# (WARNINGS-MANY-BOOLEAN-ARGUMENTS.md) on the warning framework
# WARNINGS-SAME-RETURN.md built (hir/warnings.tcl).
#
# The theorem: a call site is reported exactly when it is a written call
# (`function` or `method` form) to a declared callee whose signature has at
# least two ordinary parameters the checker proves `bool` and at least one
# ordinary non-`bool` parameter, and the call passes two or more written
# `true`/`false` literals at ordinary parameter positions. One diagnostic per
# call site, anchored at the call, no secondary locations; everything else is
# silent:
#
#   * a callee whose ordinary parameters are all bool (data bools: `xor`),
#     one with fewer than two proven-bool ordinary parameters, and flags --
#     which are the idiom and never counted, in the gate or the threshold;
#   * a call through a function value (a parameter, a call result, a field);
#   * computed or bound bools at the call, whatever their value (the
#     anonymity principle: a name already says what the value means), and a
#     call with fewer than two literals;
#   * calls the frontend synthesizes (operators, list literals) and calls
#     with no provenance marker (core IR, HIR text);
#   * structurally unreachable calls (milestone 2's rule; no completion walk).
#
# The message states the literal count, names the callee and names the form;
# it prints no flag spelling and prescribes no mapping: the warning is
# deliberately not autofixable (a flag defaults to false, so a mis-mapped
# rewrite would compile and be silently wrong).
#
# Like the other warning test files, every compile here passes its policy and
# channel explicitly (`-warnings MODE`, `-warning-channel ""` to collect
# without printing), so this file exercises default, off and error whatever
# the harness's process default is.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]

testConstraint executableAot [expr {$::tcl_platform(os) eq "Linux" &&
    $::tcl_platform(machine) in {x86_64 amd64}}]

set ::allBackends {interp compile cranelift-generic cranelift}
set ::mbCode MANY-BOOLEAN-ARGUMENTS

# The HIR of SOURCE under policy MODE (default off error), collecting
# warnings without printing them.
proc compileWith {source {mode default}} {
    return [surface::compile $source t.bot -warnings $mode -warning-channel ""]
}

# "LINE:COL" of ORIGIN in HIR, without the file name when it is t.bot.
proc loc {hir origin} {
    return [regsub {^t\.bot:} [hir::originLocation $hir $origin] {}]
}

# The MANY-BOOLEAN-ARGUMENTS warnings of HIR.
proc manyOf {hir} {
    return [lmap w [hir::warnings::of $hir] {
        if {[dict get $w code] ne $::mbCode} continue
        set w
    }]
}

# Each MANY-BOOLEAN-ARGUMENTS warning of SOURCE as {PRIMARY LITERALS}.
proc sites {source} {
    set hir [compileWith $source]
    return [lmap w [manyOf $hir] {
        list [loc $hir [dict get $w primary]] [dict get $w data literals]
    }]
}

# "LINE:COL" of each MANY-BOOLEAN-ARGUMENTS warning of SOURCE, in order.
proc where {source} {
    return [lmap s [sites $source] {lindex $s 0}]
}

# "MESSAGE @ PRIMARY" for each MANY-BOOLEAN-ARGUMENTS warning of SOURCE.
proc shown {source} {
    set hir [compileWith $source]
    return [lmap w [manyOf $hir] {
        string cat [dict get $w message] " @ " [loc $hir [dict get $w primary]]
    }]
}

# 1 if SOURCE compiles with no MANY-BOOLEAN-ARGUMENTS warning.
proc silent {source} {
    return [expr {[manyOf [compileWith $source]] eq ""}]
}

# Every warning of SOURCE (all codes) as {CODE PRIMARY}.
proc allWarnings {source} {
    set hir [compileWith $source]
    return [lmap w [hir::warnings::of $hir] {list [dict get $w code] [loc $hir [dict get $w primary]]}]
}

# The rejection of SOURCE under MODE: {errorcode message}, or "compiled".
proc rejection {source mode} {
    if {[catch {compileWith $source $mode} message options]} {
        return [list [dict get $options -errorcode] $message]
    }
    return compiled
}

# What SOURCE does on the reference interpreter, compiled with warnings off:
# {value V}, {runtime ERRORCODE} or {rejected ERRORCODE}.
proc behavior {source} {
    if {[catch {compileWith $source off} hir options]} {
        return [list rejected [dict get $options -errorcode]]
    }
    set outcome [outcomeUnderHir interp $hir]
    if {[lindex $outcome 0] eq "value"} {
        return [list value [lindex $outcome 1]]
    }
    return [list runtime [lindex $outcome 1]]
}

# Runs SCRIPT with module files FILES ({NAME TEXT ...}) in a private library
# directory (a per-process name in the tcltest temporary directory).
proc withModules {files script} {
    set saved $::core::libraryDir
    set dir [makeDirectory mb-scratch-[pid]]
    foreach entry [glob -nocomplain -directory $saved *] {
        file copy -force $entry $dir
    }
    set ::core::libraryDir $dir
    try {
        foreach {name text} $files {
            set channel [open [file join $dir $name] w]
            fconfigure $channel -encoding utf-8
            puts -nonewline $channel $text
            close $channel
        }
        uplevel 1 $script
    } finally {
        set ::core::libraryDir $saved
        removeDirectory mb-scratch-[pid]
    }
}

# Runs SCRIPT with a probe native NAME registered with parameter types TYPES
# (its value is its first argument), unregistered afterwards.
proc withProbeNative {name types script} {
    core::native::register $name -arity [llength $types] -param-types $types \
        -impl {apply {{args} {return [list value [lindex $args 0]]}}} -result-type any
    try {
        uplevel 1 $script
    } finally {
        core::native::unregister $name
    }
}

# The option-taking function the examples below call: a subject and three
# proven-bool options.
set ::openFile {fn open_file(path, append: bool, create: bool, sync: bool):
    path}

# ---------------------------------------------------------------------------
# The theorem (item 3): the motivating call, the literal-count boundary,
# false counting, per-site granularity, positions

test mb-motivating-rendered {the motivating call: one warning at the call, rendered exactly, no notes} -body {
    set hir [surface::compile {fn open_file(path, append: bool, create: bool, sync: bool):
    path

open_file("file.txt", true, false, true)} f.bot -warnings default -warning-channel ""]
    lmap w [manyOf $hir] {hir::warnings::render $hir $w}
} -result {{f.bot:4:1: warning: the call to `open_file` passes 3 boolean literals; flags name options (MANY-BOOLEAN-ARGUMENTS)}}

test mb-literal-count-boundary {1 literal is silent, 2 fire, 3 fire; the count in the message is the literal count} -body {
    shown "$::openFile
fn f(x, a, b):
    one = open_file(x, true, a, b)
    two = open_file(x, true, false, b)
    three = open_file(x, true, false, true)
    \[one, two, three\]
f(\"p\", 1 == 1, 2 == 3)"
} -result {{the call to `open_file` passes 2 boolean literals; flags name options @ 5:11} {the call to `open_file` passes 3 boolean literals; flags name options @ 6:13}}

test mb-mixed-literal-and-computed {f(true, compute(), false): two literals with a computed bool between them fire, with count 2; the computed argument is no evidence} -body {
    set hir [compileWith "$::openFile
fn compute() -> bool:
    1 < 2
open_file(\"p\", true, compute(), false)"]
    lmap w [manyOf $hir] {list [loc $hir [dict get $w primary]] [dict get $w data literals] [dict get $w data positions]}
} -result {{5:1 2 {2 4}}}

test mb-false-counts {false is exactly as anonymous as true: two false literals fire, and a false beside a true counts} -body {
    sites "$::openFile
fn f(x, c):
    a = open_file(x, false, false, c)
    b = open_file(x, c, true, false)
    \[a, b\]
f(\"p\", 1 == 1)"
} -result {{4:9 2} {5:9 2}}

test mb-per-site {two identical calls are two warnings: per site, no grouping, no first-site-per-callee or per-value} -body {
    where "$::openFile
a = \"p\".open_file(true, false, true)
b = \"p\".open_file(true, false, true)
c = \"q\".open_file(true, false, true)
\[a, b, c\]"
} -result {3:5 4:5 5:5}

test mb-positions {the literals' ordinary positions (1-based, the receiver of a method call is position 1): first, middle and last parameters} -body {
    set hir [compileWith {fn first(a: bool, b: bool, x):
    x
fn middle(a: bool, x, b: bool):
    x
fn last(x, a: bool, b: bool):
    x
p = first(true, false, 1)
q = middle(true, 1, false)
r = last(1, true, false)
[p, q, r]}]
    lmap w [manyOf $hir] {list [dict get $w data calleeName] [dict get $w data positions]}
} -result {{first {1 2}} {middle {1 3}} {last {2 3}}}

test mb-method-sugar-receiver-position {DECIDED, pinned: method sugar is the call f(receiver, ...) (FLAGS.md: the receiver is the first ordinary argument), so a literal receiver is a literal at position 1 and counts; a non-literal receiver does not} -body {
    set hir [compileWith {fn first(a: bool, b: bool, x):
    x
fn last(x, a: bool, b: bool):
    x
p = true.first(false, 1)
q = "s".last(true, false)
r = true.last(false, true)
s = "t".last(true, 1 == 1)
[p, q, r, s]}]
    lmap w [manyOf $hir] {list [loc $hir [dict get $w primary]] [dict get $w data literals] [dict get $w data positions]}
} -result {{5:5 2 {1 2}} {6:5 2 {2 3}} {7:5 3 {1 2 3}}}

test mb-literal-at-a-subject-position-counts {a literal at any ordinary position counts, the subject's included: the evidence is the written token, and true carries no name wherever it is passed} -body {
    sites {fn last(x, a: bool, b: bool):
    x
last(true, true, 1 == 1)}
} -result {{3:1 2}}

test mb-method-and-functional-spellings-agree {the functional and the method spelling of one call are the same call: the same count, positions and callee} -body {
    set functional [compileWith "$::openFile
open_file(\"p\", true, false, true)"]
    set method [compileWith "$::openFile
\"p\".open_file(true, false, true)"]
    list [lmap w [manyOf $functional] {dict remove [dict get $w data] call}] \
        [lmap w [manyOf $method] {dict remove [dict get $w data] call}]
} -result {{{callee {block e2} calleeName open_file literals 3 positions {2 3 4}}} {{callee {block e2} calleeName open_file literals 3 positions {2 3 4}}}}

# ---------------------------------------------------------------------------
# The gate (item 4): two proven-bool ordinary parameters, a subject, flags
# excluded, provable types, declared callees

test mb-gate-subject-boundary {the subject gate, in one program: all-bool ordinary parameters are data bools (silent); one non-bool and two bool fire; two bool and one non-bool fire} -body {
    set hir [compileWith {fn xor(a: bool, b: bool) -> bool:
    a != b
fn subject_first(x, a: bool, b: bool):
    x
fn subject_last(a: bool, b: bool, x):
    x
p = xor(true, false)
q = subject_first(1, true, false)
r = subject_last(true, false, 1)
[p, q, r]}]
    lmap w [manyOf $hir] {list [dict get $w data calleeName] [loc $hir [dict get $w primary]]}
} -result {{subject_first 8:5} {subject_last 9:5}}

test mb-all-bool-of-any-arity-silent {data-bool functions of two, three and four bool parameters are silent, whatever their calls pass} -body {
    silent {fn and2(a: bool, b: bool) -> bool:
    a and b
fn and3(a: bool, b: bool, c: bool) -> bool:
    a and b and c
fn and4(a: bool, b: bool, c: bool, d: bool) -> bool:
    a and b and c and d
[and2(true, true), and3(true, false, true), and4(false, false, false, false)]}
} -result 1

test mb-flags-excluded {CRITICAL: flags are never counted. A function with two ordinary bools beside flags fires on its ordinary literals only; a flag-only signature never fires, whatever flags a call supplies (the resolver appends one bool constant per declared flag to the call's arguments)} -body {
    set hir [compileWith {fn mixed(path, a: bool, b: bool, flags :x, :y):
    path
fn idiom(path, flags :append, :create, :sync):
    path
p = mixed("p", true, false, :x)
q = mixed("q", true, false)
r = idiom("r", :append, :create, :sync)
s = idiom("s", :sync)
[p, q, r, s]}]
    list [lmap w [manyOf $hir] {list [loc $hir [dict get $w primary]] [dict get $w data literals] [dict get $w data positions]}] \
        [llength [dict get $hir exprs [dict get [lindex [manyOf $hir] 0] data call] args]]
} -result {{{5:5 2 {2 3}} {6:5 2 {2 3}}} 5}

test mb-flags-never-make-the-gate {a function with ONE ordinary bool and flags is below the gate: flags never complete it, even when the call supplies them (the flag arguments are bool constants the resolver appended)} -body {
    set hir [compileWith {fn one(path, a: bool, flags :x, :y):
    path
p = one(true, true, :x, :y)
q = one("q", true, :x)
[p, q]}]
    list [manyOf $hir] [behavior {fn one(path, a: bool, flags :x, :y):
    [path, a, x, y]
one(true, true, :x, :y)}]
} -result {{} {value {[true, true, true, true]}}}

test mb-flags-never-make-the-threshold {flags never count toward the threshold: one ordinary literal and any supplied flags is one literal (silent)} -body {
    silent {fn mixed(path, a: bool, b: bool, flags :x, :y):
    path
fn f(c):
    mixed("p", true, c, :x, :y)
f(1 == 1)}
} -result 1

test mb-one-bool-parameter-silent {a callee with one proven-bool ordinary parameter is below the gate, even when a call passes two literals (one at the untyped subject)} -body {
    silent {fn one(x, a: bool):
    x
one(true, false)}
} -result 1

test mb-zero-and-one-parameter-callees-silent {callees of zero and one ordinary parameters are silent} -body {
    silent {fn none():
    1
fn single(a: bool):
    a
[none(), single(true)]}
} -result 1

test mb-unprovable-parameter-types-silent {only a parameter the checker proves bool counts: untyped (polymorphic), `any`, and int parameters are not bool, so a call passing literals to them is below the gate} -body {
    silent {fn untyped(x, a, b):
    x
fn anys(x, a: any, b: any):
    x
fn mixed(x, a: bool, b: any):
    x
fn ints(x, a: int, b: bool):
    x
[untyped(1, true, false), anys(1, true, false), mixed(1, true, false), ints(1, 2, true)]}
} -result 1

test mb-yield-caveat-condition-use-is-not-a-proof {THE YIELD CAVEAT, resolved: an untyped parameter the body only uses as a condition carries a CHECKED bool contract (validated at run time; the body is never typed with it), not a proven type -- silent. Forwarded to a declared bool parameter it carries a TRUSTED inferred bool (the body cannot be typed without it; every call must prove it) -- counted, and the call fires} -body {
    set hir [compileWith {fn conditions(x, a, b):
    if a and b:
        x
    else:
        0
fn sink(x, a: bool, b: bool):
    x
fn forwards(x, a, b):
    sink(x, a, b)
p = conditions(1, true, false)
q = forwards(2, true, false)
[p, q]}]
    set contracts {}
    dict for {e node} [dict get $hir exprs] {
        if {[dict get $node kind] ne "bind" || [dict get $hir exprs [dict get $node value] kind] ne "block"} continue
        set sig [hir::signatures::of $hir [dict get $node value]]
        lappend contracts [dict get $node name] [lmap p [lrange [dict get $sig params] 1 2] {
            list [dict get $p source] [dict get $p trusted] [dict get $p checked]
        }]
    }
    list [lmap w [manyOf $hir] {list [dict get $w data calleeName] [loc $hir [dict get $w primary]]}] $contracts
} -result {{{forwards 11:5}} {conditions {{inferred {} bool} {inferred {} bool}} sink {{declared bool {}} {declared bool {}}} forwards {{inferred bool {}} {inferred bool {}}}}}

test mb-refined-bool-parameter-is-not-canonical-bool {a parameter's proven type must be exactly the canonical bool: no literal can be passed to a refinement of bool anyway (membership is a proof), and its gate count is the canonical bool's} -body {
    set hir [compileWith {refined type On = bool
fn on?(v: bool) -> bool proves v: On:
    v
fn f(x, a: On, b: bool):
    x
fn g(v: bool):
    if on?(v):
        f(1, v, true)
    else:
        0
g(true)}]
    list [manyOf $hir] [lrange [hir::signatures::entryTypes $hir [dict get [lindex [lmap {e n} [dict get $hir exprs] {if {[dict get $n kind] eq "bind" && [dict get $n name] eq "f"} {set n} else continue}] 0] value]] 1 2]
} -result {{} {{refined bool On} bool}}

test mb-native-callee-fires {DECIDED, pinned: a native callee is included, by its registry parameter types -- a probe native with a str subject and two bool parameters fires, functionally and through method sugar; one with only bool parameters is silent} -body {
    withProbeNative str::probe_open {str bool bool} {
        withProbeNative str::probe_xor {bool bool} {
            set hir [compileWith {import str
a = str::probe_open("p", true, false)
b = "q".probe_open(false, false)
c = str::probe_xor(true, false)
[a, b, c]}]
            lmap w [manyOf $hir] {list [loc $hir [dict get $w primary]] [dict get $w data callee] [dict get $w data calleeName] [dict get $w data positions]}
        }
    }
} -result {{2:5 {native str::probe_open} str::probe_open {2 3}} {3:5 {native str::probe_open} str::probe_open {2 3}}}

test mb-no-stdlib-native-takes-bool {the census's native half: no registered native declares a bool parameter, so no stdlib native call can fire today (the natives are included for the call site, and for the pressure list a future one would join)} -body {
    set withBool {}
    foreach name [core::native::names] {
        if {"bool" in [dict get [core::native::metadata $name] paramTypes]} {
            lappend withBool $name
        }
    }
    set withBool
} -result {}

test mb-function-value-callees-silent {a call through a function value is silent: a parameter, a call result, a struct field, a binding of a branch's value -- the signature belongs to no declaration the warning can name} -body {
    silent "$::openFile
fn apply(g, x):
    g(x, true, false, true)
fn make():
    open_file
fn pick(c):
    g = if c:
        open_file
    else:
        open_file
    g(\"p\", true, false, true)
s = {h: open_file}
\[apply(open_file, 1), make()(2, true, false, true), s.h(3, true, false, true), pick(1 == 1)\]"
} -result 1

test mb-alias-of-a-declared-function-warns {DECIDED, pinned: a name bound to a declared function (`g = open_file`, a chain of such) is that declaration, as the resolver's candidate identity and the flag interface resolve it (FLAGS.md, "Aliases and values"): the call warns and names the declaration} -body {
    shown "$::openFile
g = open_file
h = g
\[g(\"p\", true, false, true), h(\"q\", false, false, true)\]"
} -result {{the call to `open_file` passes 3 boolean literals; flags name options @ 5:2} {the call to `open_file` passes 3 boolean literals; flags name options @ 5:29}}

test mb-arity-mismatch-silent {a call whose argument count is not the declaration's cannot run (ARITY at run time) and is silent} -body {
    silent "$::openFile
fn f(x):
    open_file(x, true, false, true, true)
fn g(x):
    open_file(x, true, false)
1"
} -result 1

test mb-context-parameters-not-counted {context parameters are not parameters (not in the block's params): beside two bools and a subject the call fires; beside only bools it stays a data-bool function} -body {
    set hir [compileWith {context struct C:
    v: int
fn with_subject(x, a: bool, b: bool, context c: C):
    x + c.v
fn only_bools(a: bool, b: bool, context c: C):
    c.v
with context C {v: 1}
p = with_subject(1, true, false)
q = only_bools(true, false)
[p, q]}]
    lmap w [manyOf $hir] {list [dict get $w data calleeName] [loc $hir [dict get $w primary]]}
} -result {{with_subject 8:5}}

test mb-errors-clause-irrelevant {an errors clause changes nothing: the call of a function that declares errors fires like any other} -body {
    where {error Bad
fn f(x, a: bool, b: bool) errors Bad:
    if x < 0:
        fail Bad
    x
r = f(1, true, false):
    on Bad:
        0
r}
} -result 6:5

test mb-nested-and-recursive-callees {a nested function and a recursive call are declared callees} -body {
    where {fn outer(n):
    fn inner(x, a: bool, b: bool):
        x
    inner(n, true, false)
fn rec(n, a: bool, b: bool):
    if n <= 0:
        return 0
    rec(n - 1, true, true)
[outer(1), rec(2, false, false)]}
} -result {4:5 8:5 9:12}

# ---------------------------------------------------------------------------
# The evidence (item 5): written literals only -- anonymity as design

test mb-bindings-silent {named bindings are silent by design, not conservatism: a binding provably holding true, an alias of one, and a literal beside one binding (one literal) never fire} -body {
    silent "$::openFile
append = true
create = false
sync = append
a = open_file(\"p\", append, create, sync)
b = open_file(\"q\", true, create, sync)
\[a, b\]"
} -result 1

test mb-provably-constant-bindings-silent {the anti-heroic-proving pin: the exact value of a binding is known to the compiler (hir::exact), and still never evidence} -body {
    set hir [compileWith "$::openFile
yes = true
no = false
open_file(\"p\", yes, no, yes)"]
    set facts {}
    dict for {e node} [dict get $hir exprs] {
        if {[dict get $node kind] eq "call" && [dict exists $node written] && [dict get $node written form] eq "function"} {
            set facts [lmap a [lrange [dict get $node args] 1 end] {hir::exact::Of $hir $a}]
        }
    }
    list [manyOf $hir] $facts
} -result {{} {{val {bool true}} {val {bool false}} {val {bool true}}}}

test mb-computed-bools-silent {computed bools are no evidence and do not count: f(1 == 1, 2 == 2) has zero literals, f(true, compute()) one} -body {
    silent "$::openFile
fn compute() -> bool:
    1 < 2
a = open_file(\"p\", 1 == 1, 2 == 2, 3 == 3)
b = open_file(\"q\", true, compute(), 1 == 2)
c = open_file(\"r\", not false, true and true, false or false)
\[a, b, c\]"
} -result 1

test mb-synthesized-calls-silent {calls the frontend synthesizes are never candidates: `true != false` (an == call), `[true, false]` (a list call), `true == false`, and a struct literal of bool fields (no call at all)} -body {
    set hir [compileWith {struct S:
    a: bool
    b: bool
p = true != false
q = [true, false]
r = true == false
s = S {a: true, b: false}
[p, q, r, s]}]
    set forms {}
    dict for {e node} [dict get $hir exprs] {
        if {[dict get $node kind] eq "call" && [dict exists $node written]} {
            lappend forms [dict get $node written form]
        }
    }
    list [manyOf $hir] [lsort -unique $forms]
} -result {{} {list operator}}

test mb-same-literals-in-a-written-call-fire {the same literals inside a written call fire, beside the synthesized ones that do not} -body {
    where "$::openFile
p = \[true, false\]
q = true != false
r = open_file(\"p\", true, false, true)
\[p, q, r\]"
} -result 5:5

test mb-synthesized-bool-refs-enumerated {SOURCE AUDIT: the frontend builds a root true/false reference in exactly three ways -- the written keyword (surface/lower.tcl's `bool` case), `Bool` inside the branches of the !=, not, and, or desugarings (an `if`'s value, never an argument), and the flag transport's appended constants (hir/flags.tcl, after the ordinary arguments); a new one fails here} -body {
    set found {}
    foreach path [lsort [concat [glob [file join $::projectRoot hir *.tcl]] [glob [file join $::projectRoot surface *.tcl]]]] {
        set channel [open $path]
        set lines [split [read $channel] \n]
        close $channel
        foreach line $lines {
            if {[regexp {^\s*#} $line]} continue
            if {[regexp {rootRef \S+ (\$value|\[dict get \$node value\])} $line] || [regexp {\[Bool } $line]} {
                lappend found [list [file join [file tail [file dirname $path]] [file tail $path]] [string trim $line]]
            }
        }
    }
    set found
} -result {{hir/flags.tcl {lappend args [hir::resolve::Expr hir [hir::syntax::rootRef $origin $value] $ctx]}} {surface/lower.tcl {return [hir::syntax::rootRef $origin $value]}} {surface/lower.tcl {return [hir::syntax::rootRef $origin [dict get $node value]]}} {surface/lower.tcl {return [Branch $origin $equal [list [Bool $opOrigin false]] [list [Bool $opOrigin true]]]}} {surface/lower.tcl {[list [Bool $opOrigin false]] [list [Bool $opOrigin true]]]}} {surface/lower.tcl {[list [Bool $rightOrigin true]] [list [Bool $rightOrigin false]]]}} {surface/lower.tcl {[list $test] [list [Bool $opOrigin false]]]}} {surface/lower.tcl {[list [Bool $opOrigin true]] [list $test]]}}}

test mb-desugarings-pass-no-bool-literal {options built by every boolean desugaring (not, !=, and, or) are `if` nodes, never root true/false references, at the ordinary positions of a written call: no evidence and no warning; the call's only root `true` argument is its supplied flag, appended after the ordinary ones} -body {
    set hir [compileWith {fn opts(x, a: bool, b: bool, c: bool, flags :q):
    x
fn f(p, r):
    opts(p, not r, p != r, r and (r or r), :q)
f(1, true == true)}]
    set kinds {}
    dict for {e node} [dict get $hir exprs] {
        if {[dict get $node kind] eq "call" && [dict exists $node written] && [dict get $node written form] eq "function"
                && [dict get $hir exprs [dict get $node callee] name] eq "opts"} {
            set kinds [lmap a [dict get $node args] {dict get $hir exprs $a kind}]
            set positions [hir::warnings::BoolLiteralPositions $hir [dict get $node args]]
        }
    }
    list $kinds $positions [manyOf $hir]
} -result {{ref if if if ref} 5 {}}

test mb-core-ir-input-silent {HIR built from core IR carries no written provenance: never a candidate} -body {
    set hir [hir::build {{bind f {block {p a b} {ref p}}} {call {ref f} {const 1} {ref true} {ref false}}}]
    lmap w [hir::warnings::collect $hir] {dict get $w code}
} -result {}

test mb-hir-text-input-silent {HIR read back from hir::format text keeps the declared bool parameters but no provenance marker: the source HIR warns, the parsed one never (provenance is the only thing that silences it)} -body {
    set hir [compileWith "$::openFile
\"path\".open_file(true, false, true)"]
    set parsed [hir::parse [hir::format $hir]]
    set block [lindex [lmap {e node} [dict get $parsed exprs] {if {[dict get $node kind] eq "block"} {set e} else continue}] 0]
    list [llength [manyOf $hir]] [lmap w [hir::warnings::collect $parsed] {dict get $w code}] \
        [lrange [hir::signatures::entryTypes $parsed $block] 1 end]
} -result {1 {} {bool bool bool}}

# ---------------------------------------------------------------------------
# Reachability (item 7): milestone 2's structural rule, and the contrast with
# milestones 5 and 6

test mb-dead-branch-silent {a call in a statically decided-away branch is structurally unreachable: silent} -body {
    silent "$::openFile
fn f(x):
    if 1 == 2:
        return open_file(x, true, false, true)
    x
f(1)"
} -result 1

test mb-after-return-silent {a call after a completion is structurally unreachable: silent} -body {
    silent "$::openFile
fn f(x):
    return x
    open_file(x, true, false, true)
f(1)"
} -result 1

test mb-contrast-with-one-char-string-literal {THE CONTRAST, pinned in one program: in one dead branch a one-character String literal warns (its fact is about written source, oc-dead-branch-literal-warns's shape) and a multi-bool-literal call is silent (its fact is about a call, and a call that cannot execute makes no call)} -body {
    allWarnings "$::openFile
fn f(x):
    if 1 == 2:
        return \"x\".open_file(true, false, true)
    x
f(1)"
} -result {{ONE-CHAR-STRING-LITERAL 5:16}}

test mb-range-infeasible-branch-warns {structural only: a branch the range facts prove infeasible is structurally reachable (only the completion walk prunes it), so its call warns -- the conservative direction, no completion walk} -body {
    where "$::openFile
fn f(x):
    if x < 0:
        if x > 5:
            return \"p\".open_file(true, false, true)
    x
f(1)"
} -result 6:20

test mb-uncalled-function-warns {a reachable call in a function nobody calls still warns (no interprocedural unreachability), as does one in a function declared in a dead branch (its body is structurally reachable; milestone 2's METHOD-ELIGIBLE agrees)} -body {
    allWarnings "$::openFile
fn nobody(x):
    \"path\".open_file(x, true, false)
fn k(c):
    if 1 == 2:
        fn inner(x):
            open_file(x, true, false, true)
        inner(c)
    c
k(1)"
} -result {{MANY-BOOLEAN-ARGUMENTS 4:5} {MANY-BOOLEAN-ARGUMENTS 8:13} {METHOD-ELIGIBLE 8:13}}

test mb-no-completion-walk {the pass never asks the completion proof (hir::completions::reachedExprs traced at 0 calls)} -body {
    set hir [compileWith "$::openFile
fn f(x):
    if x < 0:
        if x > 5:
            return \"p\".open_file(true, false, true)
    \"q\".open_file(true, true, true)
f(1)" off]
    set ::walks 0
    trace add execution hir::completions::reachedExprs enter {apply {{args} {incr ::walks}}}
    try {
        set warnings [hir::warnings::ManyBooleanArguments $hir]
    } finally {
        trace remove execution hir::completions::reachedExprs enter {apply {{args} {incr ::walks}}}
    }
    list [llength $warnings] $::walks
} -result {2 0}

