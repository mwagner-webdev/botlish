    lsort -unique [lmap w [hir::warnings::of [compileWith $::mbSource]] {dict get $w code}]
} -result MANY-BOOLEAN-ARGUMENTS

test mb-mode-error-only-this-code {error: a program with only this warning is rejected with the warning's own code and message (the sort-first call)} -body {
    rejection $::mbSource error
} -result {{CORE SEMANTIC MANY-BOOLEAN-ARGUMENTS} {t.bot:3:5: the call to `open_file` passes 3 boolean literals; flags name options}}

