    list [lindex [rejection $::sevenSource error] 0] [lindex [rejection {fn opts(x, a: bool, b: bool):
    x
fn use_opts(x):
    x.opts(true, false)
fn check(v: str) -> bool:
    v == "@"
fn two(a, b):
    a
two(1, 2)} error] 0]
} -result {{CORE SEMANTIC SAME-RETURN-VALUE} {CORE SEMANTIC MANY-BOOLEAN-ARGUMENTS}}

test mb-mode-error-clean-program {error mode accepts a program whose options are flags, whose bool arguments are named or computed, and whose data-bool calls pass literals} -body {
    rejection {fn open_file(path, flags :append, :create, :sync):
    path
fn weight(n: int, double: bool, negate: bool) -> int:
    n
fn xor(a: bool, b: bool) -> bool:
    a != b
double = true
a = "a.txt".open_file(:append, :sync)
b = 3.weight(double, 1 == 2)
c = true.xor(false)
[a, b, c]} error
} -result compiled

test mb-mode-default-is-the-default {no option and no environment setting means warnings on, as warnings} -body {
    set saved $::env(BOTLISH_WARNINGS)
