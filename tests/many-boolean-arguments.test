} -result {1 {CORE SEMANTIC MANY-BOOLEAN-ARGUMENTS} 0}

# ---------------------------------------------------------------------------
# No semantics change (item 11)

set ::runSource {fn weight(base: int, double: bool, negate: bool) -> int:
    if double:
        if negate:
            return 0 - base * 2
        return base * 2
    if negate:
        return 0 - base
    base
fn tally(n: int, flags :double, :negate) -> int:
    n.weight(double, negate)
a = 3.weight(true, false)
b = 4.weight(false, false)
c = 5.tally(:double)
d = 6.weight(a > 5, true)
[a, b, c, d]}

test mb-hir-identical-across-modes {HIR (minus the side table), hir::format and hir::lower are identical under off and default} -body {
    set off [compileWith $::runSource off]
    set on [compileWith $::runSource default]
    list [llength [manyOf $on]] [expr {$off eq [dict remove $on warnings]}] [expr {[hir::format $off] eq [hir::format $on]}] \
        [expr {[hir::lower $off] eq [hir::lower $on]}] [dict exists $off warnings]
} -result {2 1 1 1 0}

test mb-no-new-hir-state {nothing new is recorded on HIR: default adds only the warnings side table; every node has the fields it has under off} -body {
    set off [compileWith $::runSource off]
    set on [compileWith $::runSource default]
    set added [lmap key [dict keys $on] {if {[dict exists $off $key]} continue; set key}]
    set changed 0
    dict for {e node} [dict get $on exprs] {
        if {[lsort [dict keys $node]] ne [lsort [dict keys [dict get $off exprs $e]]]} {
            incr changed
        }
    }
    list $added $changed [expr {[dict get $on bindings] eq [dict get $off bindings]}] \
        [expr {[dict get $on scopes] eq [dict get $off scopes]}] [expr {[dict get $on exprs] eq [dict get $off exprs]}]
} -result {warnings 0 1 1 1}

test mb-call-nodes-unchanged {a warned call node has exactly the fields a written (method-spelled) call node has always had -- milestone 2's provenance marker `written` and method sugar's `method` among them -- and the same under off: nothing this pass reads was added for it} -body {
    set hir [compileWith $::runSource]
    set off [compileWith $::runSource off]
    list [lsort -unique [lmap w [manyOf $hir] {lsort [dict keys [dict get $hir exprs [dict get $w data call]]]}]] \
        [lsort -unique [lmap w [manyOf $hir] {expr {[dict get $hir exprs [dict get $w data call]] eq [dict get $off exprs [dict get $w data call]]}}]]
} -result {{{args callee calleeErrors effectiveErrors id kind known mayReturnNormally method origin reachable resultRangeFact scope target type written}} 1}

test mb-nir-identical-across-modes {native IR (specialized and generic) is identical with warnings off and on} -body {
    set off [compileWith $::runSource off]
    set on [compileWith $::runSource default]
    list [expr {[native::nir $off] eq [native::nir $on]}] [expr {[native::nir $off -specialize 0] eq [native::nir $on -specialize 0]}]
} -result {1 1}

test mb-machine-readable-outputs-clean {native::report, NIR and CLIF are identical with and without the warnings side table} -body {
    set on [compileWith $::runSource default]
    set bare [dict remove $on warnings]
    expr {[llength [manyOf $on]] == 2 && [native::report $on] eq [native::report $bare]
        && [native::nir $on] eq [native::nir $bare] && [native::clif $on] eq [native::clif $bare]}
} -result 1

test mb-no-warning-text-in-machine-readable-outputs {neither NIR, CLIF, the report nor HIR text mention the warning} -body {
    set hir [compileWith $::runSource default]
    set seen 0
    foreach text [list [native::nir $hir] [native::clif $hir] [native::report $hir] [hir::format $hir]] {
        foreach word {MANY-BOOLEAN-ARGUMENTS warning "boolean literals" "flags name options"} {
            if {[string first $word $text] >= 0} {
                incr seen
            }
        }
    }
    set seen
} -result 0

# ---------------------------------------------------------------------------
# Backend independence (item 12)

test mb-backend-independent {every backend runs the program identically; the one warning set is the HIR's} -body {
    set hir [compileWith $::runSource default]
    set outcomes [lmap backend $::allBackends {outcomeUnderHir $backend $hir}]
    list [llength [lsort -unique [lmap o $outcomes {lindex $o 1}]]] [lindex $outcomes 0 1] [llength [manyOf $hir]]
} -result {1 {[6, 4, 10, -12]} 2}

test mb-backend-independent-off {the same program runs identically on every backend with warnings off} -body {
    set hir [compileWith $::runSource off]
    lsort -unique [lmap backend $::allBackends {lindex [outcomeUnderHir $backend $hir] 1}]
} -result {{[6, 4, 10, -12]}}

# ---------------------------------------------------------------------------
# The command line

test mb-cli-modes {main.tcl: default prints the warnings on stderr and runs; off is silent; error rejects before running} -constraints executableAot -body {
    set main [file join $::projectRoot main.tcl]
    set path [makeFile $::runSource mb-cli-[pid].bot]
    set results {}
    foreach mode {default off error} {
        set status [catch {exec [info nameofexecutable] $main -warnings $mode $path 2>@1} out]
        lappend results [list $mode $status \
            [regexp -all {: warning: the call to `weight` passes [0-9]+ boolean literals; flags name options \(MANY-BOOLEAN-ARGUMENTS\)} $out] \
            [regexp {note:} $out] \
            [regexp {value: } $out] \
            [regexp {CORE SEMANTIC MANY-BOOLEAN-ARGUMENTS} $out]]
    }
    removeFile mb-cli-[pid].bot
    set results
} -result {{default 0 2 0 1 0} {off 0 0 0 1 0} {error 1 0 0 0 1}}

test mb-cli-no-wno-option {-Wno-many-boolean-arguments is an unknown option, not a file name} -constraints executableAot -body {
    set main [file join $::projectRoot main.tcl]
    set path [makeFile $::runSource mb-cli-wno-[pid].bot]
    catch {exec [info nameofexecutable] $main -Wno-many-boolean-arguments $path 2>@1} out
    removeFile mb-cli-wno-[pid].bot
    list [string match "*unknown option*-Wno-many-boolean-arguments*" $out] [string match "*value:*" $out]
} -result {1 0}

test mb-cli-unknown-mode {main.tcl rejects an unknown mode} -constraints executableAot -body {
    set main [file join $::projectRoot main.tcl]
    set path [makeFile $::runSource mb-cli-mode-[pid].bot]
    set status [catch {exec [info nameofexecutable] $main -warnings booleans $path 2>@1} out]
    removeFile mb-cli-mode-[pid].bot
    list $status [string match "*unknown warnings mode*" $out]
} -result {1 1}

test mb-cli-stdout-clean {the warnings go to stderr: program stdout carries no warning text} -constraints executableAot -body {
    set main [file join $::projectRoot main.tcl]
    set path [makeFile $::runSource mb-cli-stdout-[pid].bot]
    set stderrPath [makeFile {} mb-cli-stderr-[pid].txt]
    set out [exec [info nameofexecutable] $main -warnings default $path 2> $stderrPath]
    set err [viewFile mb-cli-stderr-[pid].txt]
    removeFile mb-cli-stdout-[pid].bot
    removeFile mb-cli-stderr-[pid].txt
    list [string match *warning* $out] [string match "*boolean literals*" $out] [regexp -all {MANY-BOOLEAN-ARGUMENTS} $err] \
        [string match {*value: *} $out]
} -result {0 0 2 1}

test mb-error-cli-stops-before-backend {main.tcl -backend cranelift -warnings error rejects without lowering or running anything} -constraints executableAot -body {
    set main [file join $::projectRoot main.tcl]
    set path [makeFile $::runSource mb-cli-error-[pid].bot]
    catch {exec [info nameofexecutable] $main -backend cranelift -warnings error $path 2>@1} out
    removeFile mb-cli-error-[pid].bot
    list [string match "*value:*" $out] [regexp {\(CORE SEMANTIC MANY-BOOLEAN-ARGUMENTS\)} $out]
} -result {0 1}

# The warning lines (and their notes) of main.tcl's stderr for PATH on
# BACKEND, with the file's directory stripped.
proc cliWarningText {path backend} {
    set main [file join $::projectRoot main.tcl]
    set err [makeFile {} mb-cli-err-[pid].txt]
    catch {exec [info nameofexecutable] $main -backend $backend -warnings default $path 2> $err}
    set lines [lmap line [split [viewFile mb-cli-err-[pid].txt] \n] {
        if {![string match "*: warning: *" $line] && ![string match "*: note: *" $line]} continue
        set line
    }]
    removeFile mb-cli-err-[pid].txt
    return $lines
}

test mb-cli-backend-independent {main.tcl prints the identical warning text, all seven codes, on every backend} -constraints executableAot -body {
    set path [makeFile "$::sevenSource\ny = check(3):\n    on Bad:\n        0\n\[y, emailish(\"ab\"), use_opts(1)\]" mb-cli-seven-[pid].bot]
    set texts [lmap backend $::allBackends {cliWarningText $path $backend}]
    removeFile mb-cli-seven-[pid].bot
    set first [lindex $texts 0]
    list [llength [lsort -unique $texts]] [llength [lsearch -all $first *MANY-BOOLEAN-ARGUMENTS*]] [llength $first]
} -result {1 1 9}

test mb-cli-backend-independent-corpus {main.tcl prints the identical warning text (every code, notes included) on every backend over the stdlib corpus and the refinement example} -constraints executableAot -body {
    set programs [lsort [glob -directory [file join $::projectRoot examples stdlib] *.bot]]
    lappend programs [file join $::projectRoot examples refinement refined-strings.bot]
    set mismatches {}
    set total 0
    foreach path $programs {
        set texts [lmap backend $::allBackends {cliWarningText $path $backend}]
        incr total [llength [lindex $texts 0]]
        if {[llength [lsort -unique $texts]] != 1} {
            lappend mismatches [file tail $path]
        }
    }
    list $mismatches [expr {$total > 0}]
} -result {{} 1}

# ---------------------------------------------------------------------------
# Fuzzing: constructed programs, an independent oracle, all three modes, and
# the conversion law

test mb-fuzz-smoke {60 generated programs: predicted warnings (anchor, count) and only them, off silent with identical HIR, error iff warned, HIR text silent, and the conversion law over every convert-now callee} -constraints executableAot -body {
    set fuzz [file join $::projectRoot audit many-boolean-arguments tools fuzz.tcl]
    lindex [split [string trim [exec [info nameofexecutable] $fuzz 60 1]] \n] end
} -result {seeds 60 (from 1): * with warnings, * without; failures 0; extra warnings 0; conversion law * of * convert-now callees, failures 0*} -match glob

cleanupTests
