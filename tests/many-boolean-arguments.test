} -result {MANY-BOOLEAN-ARGUMENTS MANY-BOOLEAN-ARGUMENTS 1}

test mb-off-runs-no-warning-pass {warnings off does not execute the pass at all (default does): the stats counter} -body {
    hir::warnings::resetStats
    compileWith $::mbSource off
