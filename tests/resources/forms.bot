# forms.bot -- a scope's releases do not depend on the form its value takes
# natively (tests/resources.test): a String its caller concatenates (a
# construction plan result), a small Int its caller adds to (a raw Int
# result), a struct its caller only projects (a scalar-replacement
# companion), a branch whose value joins a plan. Each function's Handles are
# released at its end, in reverse, before the caller's next note. Natively
# these bodies were once lowered without their statements' releases: no
# Handle of theirs was ever released.
import handle
import std::int
import std::str

struct Point:
    a: int
    b: int

fn plan(n: int) -> str:
    h = handle::open(n)
    "<<".concat(std::int::to_string(n)).concat(">>")

fn statements(n: int) -> str:
    h = handle::open(n)
    s = "<<".concat(std::int::to_string(n))
    g = handle::open(n + 1)
    s.concat(">>")

fn raw(n: int) -> int:
    h = handle::open(n)
    n + 1

fn point(n: int) -> Point:
    h = handle::open(n)
    Point {a: n, b: n + 1}

fn branch(n: int) -> str:
    if n > 0:
        h = handle::open(n)
        "<<".concat(std::int::to_string(n)).concat(">>")
    else:
        "none"

fn main(context log: handle::Log) -> List[int] errors IndexNotFound:
    a = "xx".concat(plan(10))
    handle::note(1)
    b = "xx".concat(statements(20))
    handle::note(2)
    c = raw(30) + 1
    handle::note(3)
    d = point(40).a + 1
    handle::note(4)
    e = "xx".concat(branch(50))
    handle::note(5)
    handle::closed()

with context handle::create()
main():
    on IndexNotFound:
        []
