f(m, m.order())
}
nested {fn outer(o: std::mutable_set::MutableSet[int]) -> unit:
    fn inner(m: std::mutable_map::MutableMap[int, int]) -> unit:
        n = m
        n.reorder(o)
    unit
}
observer {m = int_map([1])
