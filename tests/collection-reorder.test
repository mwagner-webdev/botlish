test cr-proof-no-cascade {an order of the wrong type is its type's diagnostic only: nothing restates it as an unproven order} -body {
    # A rejected method-style call means no reorder at all; a qualified call
    # is a reorder whose argument its own check rejects, and that rejection
    # owns the obligation (hir::recovery::OwnedPositions).
    list [crProof "m = int_map(\[1\])\nm.reorder(std::mutable_set::create\[str\]())\n"] \
        [crProof "m = int_map(\[1\])\nm.reorder(\[1\])\n"] \
        [crProof "m = int_map(\[1\])\nstd::mutable_map::reorder(m, std::mutable_set::create\[str\]())\n"] \
        [crProof "m = int_map(\[1\])\nstd::mutable_map::reorder(m, \[1\])\n"] \
        [crProof "s = std::mutable_set::create\[int\]()\nstd::mutable_set::reorder(s, \[1\])\n"]
} -result {NO-APPLICABLE-METHOD@2 NO-APPLICABLE-METHOD@2 IMPRINT@2 IMPRINT@2 IMPRINT@2}

test cr-proof-message {the diagnostic names the order, the collection, its members, and how to establish the proof} -body {
    catch {surface::compile "${::crDecls}m = int_map(\[1\])\nc = set_of(\[1\])\nm.reorder(c)\n" -warnings off} message options
    list [lindex [dict get $options -errorcode] end] \
        [string match "*`c` is not known to hold exactly the current keys of `m`, which std::mutable_map::reorder requires*equal lengths are not equal keys*`m.order()`*`m.validate_order(candidate)`*std::mutable_map::OrderMismatch*" $message]
} -cleanup {unset -nocomplain message options} -result {REORDER-NOT-PROVEN 1}

test cr-proof-static-compile {an unproven reorder in a static compile block is the reified diagnostic DiagnosticCode::ReorderNotProven; a proven one is accepted} -body {
    crRun {fn probe(place m: std::mutable_map::MutableMap[int, int]) -> int errors std::compiler::CompilerError:
    c = set_of([1])
    static compile:
        m.reorder(c)
    1
fn fine(place m: std::mutable_map::MutableMap[int, int]) -> int errors std::compiler::CompilerError:
    static compile:
        m.reorder(m.order())
    2
m = int_map([1])
a = probe(m):
    on std::compiler::CompilerError {code}:
        if code == std::compiler::DiagnosticCode::ReorderNotProven:
            -1
        else:
            -2
b = fine(m):
    on std::compiler::CompilerError:
        -3
[a, b]
}
} -result {value {[-1, 2]}}

test cr-proof-method-syntax {with both collections imported, m.reorder and s.reorder are each their own module's function (nominal exclusion), and the proof is the same written qualified} -body {
    set hir [surface::compile "${::crDecls}m = int_map(\[1, 2\])\nm.reorder(m.order())\ns = set_of(\[1\])\ns.reorder(s.order())\n" -warnings off]
    set targets {}
    foreach e [hir::walk $hir] {
        if {[hir::kind $hir $e] ne "call"} continue
        lassign [hir::get $hir $e target] kind block
        if {$kind ne "block"} continue
        set name [hir::signatures::Name $hir $block]
        if {[string match *reorder $name]} {
            lappend targets $name
        }
    }
    lsort -unique $targets
} -cleanup {unset -nocomplain hir targets e kind block name} -result {std::mutable_map::reorder std::mutable_set::reorder}

# ---------------------------------------------------------------------------
# Value semantics

test cr-copies-independent {a copy reorders independently: a binding, a chain of copies, a struct field, a List element, a function argument and result never observe another version's reorder} -body {
    crRun {struct Box:
    m: std::mutable_map::MutableMap[int, int]
fn rev(m: std::mutable_map::MutableMap[int, int]) -> std::mutable_map::MutableMap[int, int]:
    n = m
    ok = reorder_to(n, [3, 2, 1])
    n
a = int_map([1, 2, 3])
b = a
c = b
ok1 = reorder_to(b, [2, 3, 1])
box = Box {m: a}
xs = [a]
r = rev(a)
ok2 = reorder_to(c, [3, 1, 2])
ok3 = reorder_to(a, [1, 3, 2])
x0 = std::list::at(xs, 0):
    on IndexNotFound:
        int_map([])
[pairs(a), pairs(b), pairs(c), pairs(box.m), pairs(x0), pairs(r)]
}
} -result {value {[[[1, 10], [3, 30], [2, 20]], [[2, 20], [3, 30], [1, 10]], [[3, 30], [1, 10], [2, 20]], [[1, 10], [2, 20], [3, 30]], [[1, 10], [2, 20], [3, 30]], [[3, 30], [2, 20], [1, 10]]]}}

test cr-copy-then-reorder-then-mutate {a reordered copy and its original stay separate through later growth, removal and clear of either} -body {
    crRun {a = int_map([1, 2, 3, 4])
b = a
ok = reorder_to(b, [4, 3, 2, 1])
loop i from 10 to 40:
    a.set(i, i)
r = b.remove(3):
    on std::mutable_map::KeyNotFound:
        0
c = b
b.clear()
[a.length(), pairs(c), b.length()]
}
} -result {value {[34, [[4, 40], [2, 20], [1, 10]], 0]}}

test cr-observer-overlap {s.reorder(s) is a no-op reorder (the order is the set as it was), and so are the forms through a struct field} -body {
    crRun {struct W:
    s: std::mutable_set::MutableSet[int]
s = set_of([3, 1, 2])
s.reorder(s)
w = W {s: set_of([5, 4])}
w.s.reorder(w.s)
w.s.reorder(w.s.order())
[elems(s), elems(w.s)]
}
} -result {value {[[3, 1, 2], [5, 4]]}}

test cr-iteration-snapshot {a loop over a collection it reorders iterates the collection as it was when the loop began; a later loop sees the new order} -body {
    crRun {m = int_map([1, 2, 3])
seen = loop e in m:
    if e.key == 1:
        ok = reorder_to(m, [3, 2, 1])
    e.key
s = set_of([1, 2, 3])
seen2 = loop x in s:
    ok = reorder_set_to(s, [2, 3, 1])
    x
[seen, pairs(m), seen2, elems(s)]
}
} -result {value {[[1, 2, 3], [[3, 30], [2, 20], [1, 10]], [1, 2, 3], [2, 3, 1]]}}

# ---------------------------------------------------------------------------
# Hashing: placement only, stored hashes reused

test cr-hidden-key-independent {the same reorders under two fixed hidden keys and the process's own give the same observations: the hidden hash chooses slots, the order chooses positions} -body {
    set body {m = int_map([])
loop i from 0 to 120:
    m.set((i * 7919).mod(1000), i)
loop i from 0 to 120:
    if i.mod(4) == 0:
        r = m.remove((i * 7919).mod(1000)):
            on std::mutable_map::KeyNotFound:
                -1
ks = loop e in m:
    e.key
evens = loop k in ks:
    if k.mod(2) == 1:
        continue
    k
odds = loop k in ks:
    if k.mod(2) == 0:
        continue
    k
c = set_of(odds)
loop k in evens:
    c.add(k)
o = m.validate_order(c):
    on std::mutable_map::OrderMismatch:
        m.order()
m.reorder(o)
s = set_of(ks)
d = set_of(evens)
loop k in odds:
    d.add(k)
p = s.validate_order(d):
    on std::mutable_set::OrderMismatch:
        s
s.reorder(p)
[o.length() == m.length(), pairs(m), elems(s)]
}
    set outcomes {}
    foreach key {{1 2} {0x123456789abcdef0 0x0fedcba987654321} ""} {
        core::hashing::useTableHashKey $key
        try {
            lappend outcomes [crRun $body {compile cranelift-generic cranelift}]
        } finally {
            core::hashing::useTableHashKey ""
        }
    }
    list [llength [lsort -unique $outcomes]] [string range [lindex $outcomes 0 1] 0 30]
} -cleanup {unset -nocomplain body outcomes key} -result {1 {[true, [[919, 1], [757, 3], [59}}

test cr-full-hash-collisions {genuine collisions of the stored keyed hash -- a private library whose collections keep two bits of it -- are told apart by equality: a reorder moves every entry to its own key's rank with its own value} -body {
    withPrivateLibrary {
        foreach file {mutable_map.bot mutable_set.bot} {
            set path [file join $::core::libraryDir $file]
            set text [string map {{std::table_hash::of(key)} {bit_and(std::table_hash::of(key), 3)} {std::table_hash::of(x)} {bit_and(std::table_hash::of(x), 3)}} [core::ReadFile $path]]
            set f [open $path w]
            puts -nonewline $f $text
            close $f
        }
        set result [sourceAgree "$::crDecls\nm = int_map(\[\])\nloop i from 0 to 40:\n    m.set(i * 11, i)\nloop i from 0 to 40:\n    if i.mod(5) == 2:\n        r = m.remove(i * 11):\n            on std::mutable_map::KeyNotFound:\n                -1\nks = loop e in m:\n    e.key\nrev = loop i from 0 to std::list::length(ks):\n    std::list::at(ks, std::list::length(ks) - 1 - i):\n        on IndexNotFound:\n            -1\nok = reorder_to(m, rev)\nbad = loop e in m:\n    if e.value * 11 == e.key:\n        continue\n    e.key\nafter = loop e in m:\n    e.key\n\[ok, after == rev, bad, m.length()\]\n"]
    }
    set result
} -cleanup {unset -nocomplain file path text f result} -result {value {[true, true, [], 32]}}

test cr-no-rehash {natively a reorder computes no keyed hash: order, reorder and the engine's arrangement and permutation have no tablehash operation (validate_order neither: it probes with the candidate's stored hashes; a set's order is its copy, inlined)} -constraints nativeBuilt -body {
    set nir [native::nir [surface::compile "${::crDecls}m = int_map(\[1, 2, 3\])\nok = reorder_to(m, \[3, 1, 2\])\ns = set_of(\[1, 2\])\nok2 = reorder_set_to(s, \[2, 1\])\ns.reorder(s.order())\nm.reorder(m.order())\n\[ok, ok2\]\n" -warnings off]]
    set found {}
    foreach f {std::mutable_map::reorder std::mutable_map::order std::mutable_map::validate_order std::mutable_set::reorder std::mutable_set::validate_order std::ordered_table::arrangement std::ordered_table::permute std::ordered_table::permute_values std::ordered_table::reindex std::ordered_table::count_shared} {
        set ops [crOps $nir $f]
        if {$ops eq "missing"} {
            lappend found $f:missing
            continue
        }
        foreach op $ops {
            if {[string match tablehash* $op] || $op in {hash hashtotal}} {
                lappend found $f:$op
            }
        }
    }
    set found
} -cleanup {unset -nocomplain nir found f ops op} -result {}

test cr-reorder-checks-nothing {a proven reorder performs no membership validation: reorder declares no error, and neither its body nor anything it calls counts shared members or can fail with OrderMismatch} -body {
    set hir [surface::compile "${::crDecls}m = int_map(\[1\])\nm.reorder(m.order())\ns = set_of(\[1\])\ns.reorder(s)\n" -warnings off]
    set result {}
    foreach name {std::mutable_map::reorder std::mutable_set::reorder} {
        set block ""
        foreach e [hir::walk $hir] {
            if {[hir::kind $hir $e] eq "block" && [hir::signatures::Name $hir $e] eq $name} {
                set block $e
            }
        }
        set reached {}
        set work [list $block]
        set seen [dict create]
        while {$work ne {}} {
            set work [lassign $work b]
            if {[dict exists $seen $b]} continue
            dict set seen $b 1
            lappend reached [hir::signatures::Name $hir $b]
            set inner [list $b]
            while {$inner ne {}} {
                set inner [lassign $inner x]
                if {[hir::kind $hir $x] eq "call"} {
                    lassign [hir::get $hir $x target] kind target
                    if {$kind eq "block"} {
                        lappend work $target
                    }
                }
                lappend inner {*}[hir::children $hir $x]
            }
        }
        lappend result $name [dict getdef [hir::node $hir $block] declaredErrors {}] \
            [expr {[lsearch -glob $reached *count_shared] < 0 && [lsearch -glob $reached *same_members?] < 0 && [lsearch -glob $reached *validate_order] < 0}]
    }
    set result
} -cleanup {unset -nocomplain hir result name block e reached work seen b inner x kind target} -result {std::mutable_map::reorder {} 1 std::mutable_set::reorder {} 1}

test cr-unproven-run-keeps-content {a program run despite its REORDER-NOT-PROVEN (a lenient build) still changes no content: the order's keys the collection lacks are skipped, and the entries it does not name follow in their old order with their values} -body {
    set result {}
    foreach {setup order} {
        {m = int_map([1, 2, 5])} {[3, 5, 2]}
        {m = int_map([1, 2, 5])} {[]}
        {m = int_map([1, 2, 5])} {[9, 5, 7, 1, 2, 8]}
        {m = int_map([1, 2, 5])} {[2]}
        {m = int_map([1, 2, 3, 4, 5, 6])
m.remove(2):
    on std::mutable_map::KeyNotFound:
        0
m.remove(5):
    on std::mutable_map::KeyNotFound:
        0} {[6, 7]}
        {m = int_map([])} {[1]}
    } {
        set body "$setup\nm.reorder(set_of($order))\nfound = m.at(1):\n    on std::mutable_map::KeyNotFound:\n        -1\n\[\[\[m.length(), found\]\], pairs(m)\]\n"
        set hir [surface::compile "${::crDecls}$body" -warnings off -strict 0]
        set outcomes [lsort -unique [lmap b {interp compile cranelift-generic cranelift} {lrange [outcomeUnderHir $b $hir] 0 1}]]
        lappend result [list [lmap d [dict get $hir diagnostics] {dict get $d kind}] {*}$outcomes]
    }
    join $result \n
} -cleanup {unset -nocomplain result setup order body hir outcomes b d} -result {REORDER-NOT-PROVEN {value {[[[3, 10]], [[5, 50], [2, 20], [1, 10]]]}}
REORDER-NOT-PROVEN {value {[[[3, 10]], [[1, 10], [2, 20], [5, 50]]]}}
REORDER-NOT-PROVEN {value {[[[3, 10]], [[5, 50], [1, 10], [2, 20]]]}}
REORDER-NOT-PROVEN {value {[[[3, 10]], [[2, 20], [1, 10], [5, 50]]]}}
REORDER-NOT-PROVEN {value {[[[4, 10]], [[6, 60], [1, 10], [3, 30], [4, 40]]]}}
REORDER-NOT-PROVEN {value {[[[0, -1]], []]}}}

test cr-allocations-constant {natively a proven reorder allocates the same managed objects whatever the size (its temporary permutation array and counter, the logical copies of the entry vectors it rewrites); no List of entries, keys or values} -constraints nativeBuilt -body {
    set rows [lmap n {500 1000} {
        set hir [surface::compile "${::crDecls}fn build(n: int) -> std::mutable_map::MutableMap\[int, int\]:\n    m = std::mutable_map::create\[int, int\]()\n    loop i from 0 to n:\n        m.set(i, i)\n    m\nm = build($n)\no = m.order()\nm.reorder(o)\nm.length()\n" -warnings off]
        set base [surface::compile "${::crDecls}fn build(n: int) -> std::mutable_map::MutableMap\[int, int\]:\n    m = std::mutable_map::create\[int, int\]()\n    loop i from 0 to n:\n        m.set(i, i)\n    m\nm = build($n)\no = m.order()\nm.length()\n" -warnings off]
        list [dict get [native::allocationReport $hir summary] total allocations] [dict get [native::allocationReport $base summary] total allocations]
    }]
    set d0 [expr {[lindex $rows 0 0] - [lindex $rows 0 1]}]
    set d1 [expr {[lindex $rows 1 0] - [lindex $rows 1 1]}]
    list [expr {$d0 == $d1}] [expr {$d0 <= 16}]
} -cleanup {unset -nocomplain rows hir base n d0 d1} -result {1 1}

# ---------------------------------------------------------------------------
# The representation access is internal

test cr-internal-members {std::mutable_set's representation access for std::mutable_map is internal to the standard library: an application names it INTERNAL-NAMESPACE, and method syntax to it is NOMETHOD-CALL} -body {
    list [crProof "s = set_of(\[1\])\nt = std::mutable_set::table_of(s)\n"] \
        [crProof "s = set_of(\[1\])\nt = s.table_of()\n"]
} -result {INTERNAL-NAMESPACE@2 NOMETHOD-CALL@2}

cleanupTests
