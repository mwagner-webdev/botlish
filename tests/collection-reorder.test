test cr-proof-loops {a loop that changes the map (anywhere in its body, before or after the reorder) loses the relation inside it and after it; one that does not keeps it; an order taken inside the body is proven there} -body {
    crProofs {
changes-after {fn f(place m: std::mutable_map::MutableMap[int, int], xs: List[int]) -> unit:
    o = m.order()
    loop x in xs:
        m.reorder(o)
        m.set(x, x)
    unit
}
changes-before {fn f(place m: std::mutable_map::MutableMap[int, int]) -> unit:
    o = m.order()
    loop i from 0 to 3:
        m.set(i, i)
    m.reorder(o)
}
inner-order {fn f(place m: std::mutable_map::MutableMap[int, int], xs: List[int]) -> unit:
    loop x in xs:
        m.set(x, x)
        o = m.order()
        m.reorder(o)
    unit
}
order-changes {fn f(place m: std::mutable_map::MutableMap[int, int], xs: List[int]) -> unit:
    o = m.order()
    loop x in xs:
        m.reorder(o)
        o.add(x)
    unit
}
}
} -result {changes-after 4 changes-before 5 inner-order ok order-changes 4}

test cr-proof-function-boundary {no relation crosses a function boundary but by a contract: a place parameter and an order parameter are unrelated, a nested function's captured order is unrelated to its own parameter, and a closure observing the order changes nothing} -body {
