# symbolic-type-identity.test -- symbolic native result-type metadata
# ({typed NAME LO HI}, core/native.tcl / hir/types.tcl::ShapeResult) must
# assign a source-defined type only when the compiler can prove the
# native's own guaranteed value domain is admissible in whatever NAME
# currently resolves to -- never merely because the spelling matches. See
# SYMBOLIC-TYPE-IDENTITY.md.
#
# std::str::encode_utf8 (core/strings.tcl) is this milestone's only current use of
# {typed NAME LO HI} (STATIC-COMPLETION-PROOFS.md's own "UTF-8 result
# type" section): its every element is definitionally an Int in 0..255, and
# its result is List[std::byte::Byte] only when the declaration of the
# qualified identity `std::byte::Byte` proves that domain admissible, not on
# a spelling alone. Since STDLIB-ENCODE-UTF8-RESULT-TYPE-STABILITY-
# MILESTONE-1.md the loader declares std::byte::Byte, from std::byte's file,
# in every compilation that can reach the native, whatever it imports
# (tests/encode-utf8-type-stability.test), and a declaration that does not
# admit 0..255 is the standard library contradicting its native: the
# compilation fails (COMPILER-INTERNAL) rather than silently falling back.
# Since source types are namespace members (IMPORTS.md), a program's own
# `type Byte` is a different type, `Byte`, and never `std::byte::Byte`; the
# narrower/wider domains below come from a scratch library whose `byte`
# module declares `Byte` differently.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]

# Runs SCRIPT with $::core::libraryDir pointed at a scratch directory holding
# a copy of stdlib/ whose `byte` module declares only `type Byte = Int in
# DOMAIN` (DOMAIN like 0..15): the symbolic name `std::byte::Byte` of
# std::str::encode_utf8's result then resolves to that declaration.
proc withByteDomain {domain script} {
    set saved $::core::libraryDir
    set dir [tcltest::makeDirectory symbolic-type-lib-[pid]-[incr ::libCounter]]
    file copy -force [file join $::projectRoot stdlib] [file join $dir stdlib]
    set channel [open [file join $dir stdlib byte.bot] w]
    puts -nonewline $channel "type Byte = Int in $domain\n"
    close $channel
    set ::core::libraryDir [file join $dir stdlib]
    try {
        uplevel 1 $script
    } finally {
        set ::core::libraryDir $saved
        tcltest::removeDirectory [file tail $dir]
    }
}
set ::libCounter 0

# The static type (hir::types::show) of the last `call` expression HIR
# finds walking SRC's HIR, in pre-order. SRC imports what it uses.
proc lastCallType {src} {
    set h [surface::compile $src t.bot]
    set last ""
    foreach e [hir::walk $h] {
        if {[hir::kind $h $e] eq "call"} {
            set last $e
        }
    }
    if {$last eq ""} {
        error "lastCallType: no call expression found"
    }
    return [hir::types::show [hir::typeOf $h $last]]
}

# ---------------------------------------------------------------------------
# Acceptance matrix (spec item 35)

test symbolic-type-identity-canonical-byte {canonical std::byte::Byte = Int in 0..255: std::str::encode_utf8's guaranteed 0..255 domain is admissible, so the result narrows to List[std::byte::Byte]} -body {
    lastCallType {import std::byte
import std::str

std::str::encode_utf8("A")
}
} -result {List[int[std::byte::Byte]]}

test symbolic-type-identity-narrow-byte-rejected {a byte module whose Byte is the narrower 0..15 cannot prove membership (UTF-8 may emit values above 15): std::str::encode_utf8 is never typed List[std::byte::Byte] -- the compilation fails, a standard library contradicting its native (COMPILER-INTERNAL), rather than claim it or quietly drop to the plain list} -body {
    withByteDomain 0..15 {
        catch {lastCallType {import std::byte
import std::str

std::str::encode_utf8("A")
}} message options
        dict get $options -errorcode
    }
} -cleanup {unset -nocomplain message options} -result {CORE SEMANTIC COMPILER-INTERNAL}

test symbolic-type-identity-wide-superset-byte {a byte module whose Byte is a compatible superset 0..1000 admits the native's 0..255 guarantee: this is a sound narrowing (semantic admissibility, not canonical-name identity)} -body {
    withByteDomain 0..1000 {
        lastCallType {import std::byte
import std::str

std::str::encode_utf8("A")
}
    }
} -result {List[int[std::byte::Byte]]}

test symbolic-type-identity-no-byte-declared {the program never imports module byte: the loader declares std::byte::Byte from std::byte's file for the native's contract (STDLIB-ENCODE-UTF8-RESULT-TYPE-STABILITY-MILESTONE-1.md), so the result is List[std::byte::Byte] all the same -- it was the plain list before} -body {
    lastCallType {import std::str

type Unrelated = Int in 0..1
std::str::encode_utf8("A")
}
} -result {List[int[std::byte::Byte]]}

test symbolic-type-identity-own-byte-is-not-the-natives {a program's own `type Byte = Int in 0..255` is the type Byte, not std::byte::Byte: std::str::encode_utf8 is not List[Byte] on the strength of a spelling -- it is List[std::byte::Byte], the standard library's, declared beside the program's own} -body {
    lastCallType {import std::str

type Byte = Int in 0..255
std::str::encode_utf8("A")
}
} -result {List[int[std::byte::Byte]]}

# ---------------------------------------------------------------------------
# Incompatible same-name kind (spec items 11, 13): Botlish's current type-
# declaration grammar (surface/parser.tcl's TypeDecl) only ever produces
# int-based types -- "type NAME = PARENT in DOMAIN" requires PARENT to be
# Int or another already-int-based type (hir/sourcetypes.tcl's RegisterOne
# rejects any other parent with "is not an integer-domain type"), so there
# is no legal Botlish *source* construct that declares a non-int type named
# "std::byte::Byte". This test exercises the general resolver directly instead (the
# same core::type registry every source declaration ultimately populates,
# and the same hir::types::ShapeResult entry point ordinary compilation
# calls) with a type registered the way a hypothetical non-int same-named
# declaration would leave the registry, to prove the mechanism is sound
# for that case too, not merely untested. This is not a new type-system
# construct: core::type::register itself, with a non-int -base, is
# pre-existing, general machinery (every compiler-registered validator
# type -- Emailish, UriQueryValue, NonEmpty -- already uses it).
test symbolic-type-identity-incompatible-kind {a same-named but non-int-based std::byte::Byte cannot make an Int-producing native's result List[std::byte::Byte]: name resolution succeeds (isNamed is true) but semantic membership is not proven, so the type is never claimed -- the compilation fails (COMPILER-INTERNAL) rather than fall back} -setup {
    hir::sourcetypes::Reset
    core::type::register std::byte::Byte -base str -validator {apply {v} {return 1}} -source 1
} -cleanup {
    core::type::unregister std::byte::Byte
    unset -nocomplain message options
} -body {
    catch {hir::types::ShapeResult {} {typed std::byte::Byte 0 255} {} {} list} message options
    list [core::type::isNamed std::byte::Byte] [dict get $options -errorcode]
} -result {1 {CORE SEMANTIC COMPILER-INTERNAL}}

# ---------------------------------------------------------------------------
# Canonical standard-library case, static-only (spec item 23): representative
# ASCII, multi-byte, and astral inputs. Runtime byte values already have
# full coverage (tests/native-uri-escape.test); this pins only the static
# type std::list::at(std::str::encode_utf8(...), 0) infers, which is what actually gates
# std::web::is_unreserved(b: Byte) accepting b with no conversion (item 24).

foreach {name text} {
    ascii     A
    two-byte  é
    astral    😀
} {
    test symbolic-type-identity-list-get-$name "std::list::at(std::str::encode_utf8(\"$name\"), 0) : std::byte::Byte, with the real standard-library Byte = Int in 0..255" -body {
        lastCallType [format {import std::byte
import std::list
import std::str

bytes = std::str::encode_utf8("%s")
b = std::list::at(bytes, 0):
    on IndexNotFound:
        0
b
} $text]
    } -result {int[std::byte::Byte]}
}

# ---------------------------------------------------------------------------
# Web regression (spec items 24-26): stdlib/web.bot is unmodified source; its
# clean path (std::list::at(std::str::encode_utf8(c), 0) flowing directly into
# is_unreserved(b: Byte), no conversion/handler) must still compile with no
# diagnostics and produce the exact same escaped text it always has.
# tests/native-uri-escape.test's own uriEscape-native text-parity table
# (unmodified, run as part of the full suite) is the broader four-backend
# check of this same pipeline; this test pins the static-diagnostics-free
# property directly.

test symbolic-type-identity-web-regression-clean-compile {a program that loads stdlib/web.bot and calls uri_escape_text over ASCII, multi-byte, and astral text produces zero diagnostics and the expected percent-encoded text -- std::list::at(std::str::encode_utf8(c), 0) still statically satisfies is_unreserved's declared Byte parameter} -body {
    set path [makeFile "import std::web\n\nstd::web::uri_escape_text(\"aA1 é😀\")" symbolic-type-identity-web.bot]
    try {
        set h [surface::readProgramFile $path -strict 0]
        list [hir::diagnostics $h] [core::formatValue [core::evalProgram [hir::lower $h]]]
    } finally {
        removeFile symbolic-type-identity-web.bot
    }
} -result {{} {"aA1%20%C3%A9%F0%9F%98%80"}}

# ---------------------------------------------------------------------------
# M7.a.a canonicalization fix (EMPTY-COLLECTION-AND-APPLIED-TYPE-SEMANTICS.md):
# ShapeResult's `typed` case narrowed to `MakeList NAME` (the bare symbolic
# name), not `MakeList RESOLVED` -- storing a non-canonical `{list Byte}`
# distinct from the canonical `{list {refined int {Byte}}}` a declared
# List[Byte] annotation resolves to, even though hir::types::show's own
# normalizing display printed both identically as "List[int[Byte]]". List
# admissibility compares stored values, never display text, so passing
# std::str::encode_utf8's result to a declared List[Byte] parameter was rejected with
# a self-contradictory "cannot be proven to satisfy List[int[Byte]]
# (argument type: List[int[Byte]])" diagnostic (M7A-INSTANCE-SELECTION-
# THEOREM-AUDIT.md's own audit finding). These tests exercise the aggregate/
# parameter-boundary case this file's own earlier tests (element-read via
# std::list::at, a scalar type) never reached.

test symbolic-type-identity-satisfies-declared-list-byte-parameter {std::str::encode_utf8's result now satisfies a declared List[Byte] parameter directly, with the canonical standard-library Byte -- the actual admissibility defect this milestone fixes (spec item 44)} -body {
    surface::compile {import std::byte
import std::str

fn consume(bytes: List[std::byte::Byte]) -> int:
    1

consume(std::str::encode_utf8("A"))
} consumeutf8.bot
    list ok
} -result ok

test symbolic-type-identity-short-type-name-is-the-same-type {the same parameter spelled with `import type std::byte::Byte` accepts it too: the short name is the one canonical std::byte::Byte} -body {
    surface::compile {import std::str
import type std::byte::Byte

fn consume(bytes: List[Byte]) -> int:
    1

consume(std::str::encode_utf8("A"))
} consumeutf8short.bot
    list ok
} -result ok

test symbolic-type-identity-structural-equality-not-display-text {std::str::encode_utf8's inferred type is structurally (Tcl-value) identical to a declared List[std::byte::Byte] annotation's own resolved type, not merely identical hir::types::show text -- the stronger proof that the fix is a real representation fix, not a display-formatting coincidence (spec items 19-20)} -body {
    set h1 [surface::compile {import std::byte
import std::str

std::str::encode_utf8("A")
} enc1.bot]
    set encType [hir::typeOf $h1 [lindex [hir::roots $h1] end]]
    set h2 [surface::compile {import std::byte

fn f(xs: List[std::byte::Byte]) -> int:
    1
} enc2.bot]
    set block [lindex [hirFind $h2 block] end]
    set declType [lindex [hir::get $h2 $block declaredParamTypes] 0]
    list [expr {$encType eq $declType}] [hir::types::show $encType]
} -result {1 {List[int[std::byte::Byte]]}}

test symbolic-type-identity-negative-control-list-int-still-rejected {std::str::encode_utf8's List[std::byte::Byte] result does NOT satisfy a declared List[int] parameter -- named-domain evidence still matters; canonicalization narrows to the resolved *named* type, never collapses distinct named/unnamed domains merely because both have runtime int kind (spec item 46)} -body {
    catch {surface::compile {import std::byte
import std::str

fn consume(xs: List[int]) -> int:
    1

consume(std::str::encode_utf8("A"))
} rejectlistint.bot} message options
    list [dict get $options -errorcode] [string match {*cannot be proven to satisfy*} $message]
} -result {{CORE SEMANTIC TYPE} 1}

test symbolic-type-identity-narrow-byte-param-still-rejected {with a byte module whose Byte is the narrower 0..15, std::str::encode_utf8 is never typed List[std::byte::Byte] (symbolic-type-identity-narrow-byte-rejected above), so it never satisfies a declared List[std::byte::Byte] parameter: the compilation fails as the standard library's error -- the aggregate/parameter-boundary case inherits the identical domain-admissibility proof, not a Byte-name shortcut} -body {
    withByteDomain 0..15 {
        catch {surface::compile {import std::byte
import std::str

fn consume(xs: List[std::byte::Byte]) -> int:
    1

consume(std::str::encode_utf8("A"))
} rejectnarrowbyte.bot} message options
        list [dict get $options -errorcode] [string match {*does not admit every value in 0..255*} $message]
    }
} -result {{CORE SEMANTIC COMPILER-INTERNAL} 1}

::tcltest::cleanupTests
