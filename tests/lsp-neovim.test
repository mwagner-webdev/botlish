# lsp-neovim.test -- Botlish's language server under a real editor: Neovim's
# built-in LSP client, headless, with the repository's own configuration
# (editors/neovim/botlish.lua), driven by tests/lsp-neovim.lua
# (LSP-MILESTONE-1.md, "Editors"). Neovim is not a dependency: these tests
# need it (0.10 or later) as `nvim` on PATH or BOTLISH_NVIM=PATH, and are
# skipped without it (CI installs a pinned release: .github/workflows/tests.yml).

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot lsp json.tcl]

# The Neovim executable, or "".
proc ltNvim {} {
    if {[info exists ::env(BOTLISH_NVIM)] && $::env(BOTLISH_NVIM) ne ""} {
        set nvim $::env(BOTLISH_NVIM)
    } else {
        set nvim [lindex [auto_execok nvim] 0]
    }
    if {$nvim eq "" || [catch {exec $nvim --version} version]
            || ![regexp {NVIM v(\d+)\.(\d+)} $version -> major minor]
            || !($major > 0 || $minor >= 10)} {
        return ""
    }
    return $nvim
}
testConstraint neovim [expr {[ltNvim] ne ""}]

proc ltField {r key} {
    return [lsp::json::get $r $key]
}

# Where a jump landed, as FILE:LINE:COLUMN (Neovim's cursor: line 1-based).
proc ltLanded {landed} {
    lassign [lsp::json::elements [lsp::json::get $landed cursor]] line column
    return "[lsp::json::text [lsp::json::get $landed file]]:[lsp::json::integer $line]:[lsp::json::integer $column]"
}

proc ltPut {path text} {
    set f [open $path w]
    fconfigure $f -encoding utf-8 -translation lf
    puts -nonewline $f $text
    close $f
}

test lsp-neovim-session {Neovim's own client, configured by editors/neovim/botlish.lua, on a two-module program: the .bot filetype, the server attached with UTF-16 positions, the compiler's diagnostics as Neovim shows them, hover, go-to-definition into the module and into std::list, references across files, unsaved edits the client sends, a syntax error during which hover answers fresh around the malformed line and stale inside it, a syntax error in the imported module (a second buffer) during which the importer's answers stay fresh, and the repairs -- and no file written (SYNTAX-RECOVERY-MILESTONE-1.md)} -constraints neovim -body {
    set dir [file join [temporaryDirectory] lsp-neovim-[pid]]
    file delete -force $dir
    file mkdir $dir
    set dir [file normalize $dir]
    set shapes "fn area(w: int, h: int) -> int:\n    w * h\n"
    ltPut $dir/shapes.bot $shapes
    set main "import shapes\nimport std::list\n\na = shapes::area(3, 4)\nb = std::list::get(\[1, 2\], 5, 0)\na + b + nosuch\n"
    ltPut $dir/main.bot $main
    set out [file join $dir out.json]
    set cmd [list [info nameofexecutable] [file join $::projectRoot main.tcl] -lsp -warnings default]
    withEnvironment [list BOTLISH_NVIM_OUT $out BOTLISH_NVIM_CMD [lsp::json::write [lsp::json::arrayOf [lmap a $cmd {lsp::json::str $a}]]]] {
        exec [ltNvim] --headless --clean --cmd "lua vim.g.botlish_lsp_cmd = vim.json.decode(os.getenv('BOTLISH_NVIM_CMD'))" \
            -u [file join $::projectRoot editors neovim botlish.lua] \
            -c "luafile [file join $::projectRoot tests lsp-neovim.lua]" $dir/main.bot 2>@1
    }
    set f [open $out]
    set r [lsp::json::parse [read $f]]
    close $f
    if {[ltField $r ok] ne {bool 1}} {
        error "the Neovim session failed: [lsp::json::write $r]"
    }
    set first [lindex [lsp::json::elements [ltField $r initial]] 0]
    set syntax [lindex [lsp::json::elements [ltField $r syntax]] 0]
    list [ltField $r ok] [ltField $r error] [ltField $r filetype] [ltField $r server] [ltField $r encoding] \
        [lsp::json::get $first code] [lsp::json::get $first message] [lsp::json::get $first line] [lsp::json::get $first col] \
        [ltField $r hover] [ltLanded [ltField $r definition]] [ltLanded [ltField $r std_definition]] \
        [lsp::json::write [ltField $r references_area]] [ltField $r fixed_waited] \
        [ltField $r syntax_waited] [lsp::json::get $syntax code] [ltField $r syntax_hover] [ltField $r syntax_hover_b] [ltField $r stale_hover] \
        [ltField $r recovered_waited] [ltField $r recovered_hover] \
        [ltField $r module_waited] [lsp::json::write [ltField $r module_syntax]] [ltField $r module_main_errors] \
        [ltField $r module_hover] [ltField $r module_hover_b] [ltField $r module_repaired] [ltField $r module_repaired_hover] \
        [ltField $r modified] [ltField $r module_modified] \
        [expr {[file exists $out] && [compilerpedia_ReadFile $dir/main.bot] eq $main && [compilerpedia_ReadFile $dir/shapes.bot] eq $shapes}]
} -setup {
    proc compilerpedia_ReadFile {path} { set f [open $path]; fconfigure $f -encoding utf-8; set t [read $f]; close $f; return $t }
} -cleanup {file delete -force $dir; unset -nocomplain dir main shapes out cmd r first syntax} -result [list {bool 1} {str {}} {str botlish} {str botlish} {str utf-16} \
    {str {CORE SEMANTIC UNBOUND}} {str {unbound name "nosuch"}} {num 5} {num 8} \
    "str {```botlish\nfn shapes::area(w: int, h: int) -> int\n```}" shapes.bot:1:3 list.bot:76:3 \
    {["shapes.bot:0","main.bot:3"]} {bool 1} {bool 1} {str {SURFACE SYNTAX}} \
    "str {```botlish\nfn shapes::area(w: int, h: int) -> int\n```}" "str {```botlish\nb: int\n```}" \
    "str {```botlish\na: int\n```\n\n*stale: analyzed before the latest changes to main.bot*}" \
    {bool 1} "str {```botlish\nfn shapes::area(w: int, h: int) -> int\n```}" \
    {bool 1} {"1:7: expected an expression, found end of line"} {num 0} \
    "str {```botlish\nfn shapes::area(w: int, h: int) -> int\n```}" "str {```botlish\nb: int\n```}" {bool 1} \
    "str {```botlish\nfn shapes::area(w: int, h: int) -> int\n```}" {bool 1} {bool 1} 1]


# The syntax item Neovim gives each classified token of the grammars'
# fixture, against the token IR's class (sample.classes.json; the same
# comparison tests/syntax-highlighting.test makes with Vim): the mismatches.
proc ltSyntaxMismatches {classes groups} {
    set want {keyword {botlishControl botlishDeclaration botlishOperatorWord} word botlishContextual
        constant botlishConstant number botlishNumber string botlishString char botlishChar comment botlishComment
        declared {botlishFunction botlishType}}
    set mismatches {}
    foreach item $classes group $groups {
        lassign $item line column length class
        if {$class eq "identifier"} {
            set ok [expr {$group ni {botlishControl botlishDeclaration botlishOperatorWord botlishContextual botlishConstant
                botlishFunction botlishType}}]
        } else {
            set ok [expr {$group in [dict get $want $class]}]
        }
        if {!$ok} {
            lappend mismatches "[expr {$line + 1}]:[expr {$column + 1}] $class $group"
        }
    }
    return $mismatches
}

test lsp-neovim-highlighting {Neovim's highlighting as editors/neovim/botlish.lua configures it (SYNTAX-HIGHLIGHTING-MILESTONE-1.md): the generated syntax on the runtime path gives every token of the grammars' fixture the token IR's class -- every keyword, contextual word, constant, number, string, character and comment, and no name a keyword -- and the server's semantic tokens reach Neovim's own client (a function's name, typed function)} -constraints neovim -body {
    set dir [file join [temporaryDirectory] lsp-neovim-hl-[pid]]
    file delete -force $dir
    file mkdir $dir
    set dir [file normalize $dir]
    set fixtures [file join $::projectRoot editors vscode test fixtures]
    set classes {}
    foreach line [split [string trim [compilerpedia_ReadFile [file join $fixtures sample.classes.json]]] \n] {
        set item [lmap v [lsp::json::elements [lsp::json::parse $line]] {lindex $v 1}]
        if {[lindex $item 3] ne "operator"} {
            lappend classes $item
        }
    }
    file copy [file join $fixtures sample.bot] $dir/sample.bot
    ltPut $dir/area.bot "fn area(w: int) -> int:\n    w\n\narea(2)\n"
    set cmd [list [info nameofexecutable] [file join $::projectRoot main.tcl] -lsp -warnings off]
    set results {}
    foreach {file positions probe} [list sample.bot [lmap c $classes {lrange $c 0 1}] "" area.bot {} {[0, 3]}] {
        set out [file join $dir out-$file.json]
        withEnvironment [list BOTLISH_NVIM_OUT $out BOTLISH_NVIM_TOKEN_AT $probe \
                BOTLISH_NVIM_POSITIONS [lsp::json::write [lsp::json::arrayOf [lmap p $positions {
                    lsp::json::arrayOf [list [lsp::json::int [lindex $p 0]] [lsp::json::int [lindex $p 1]]]}]]] \
                BOTLISH_NVIM_CMD [lsp::json::write [lsp::json::arrayOf [lmap a $cmd {lsp::json::str $a}]]]] {
            exec [ltNvim] --headless --clean --cmd "lua vim.g.botlish_lsp_cmd = vim.json.decode(os.getenv('BOTLISH_NVIM_CMD'))" \
                -u [file join $::projectRoot editors neovim botlish.lua] \
                -c "luafile [file join $::projectRoot tests lsp-neovim-highlight.lua]" $dir/$file 2>@1
        }
        set r [lsp::json::parse [compilerpedia_ReadFile $out]]
        if {[ltField $r ok] ne {bool 1}} {
            error "the Neovim session on $file failed: [lsp::json::write $r]"
        }
        lappend results $r
    }
    lassign $results sample area
    list [lsp::json::text [ltField $sample filetype]] [lsp::json::text [ltField $sample syntax]] \
        [ltSyntaxMismatches $classes [lmap g [lsp::json::elements [ltField $sample groups]] {lsp::json::text $g}]] \
        [lsp::json::text [ltField $area token]]
} -setup {
    proc compilerpedia_ReadFile {path} { set f [open $path]; fconfigure $f -encoding utf-8; set t [read $f]; close $f; return $t }
} -cleanup {file delete -force $dir; unset -nocomplain dir fixtures classes line item cmd results file positions probe out r sample area} \
    -result {botlish botlish {} function}

cleanupTests
