# workload.bot -- the base workload W of the composition scenarios: three
# tasks that interleave through yields, a channel and a timer, logging "W:"
# lines.
import elog
import std::event_loop
import std::str
import type std::event_loop::Delivery

nomethod fn say(text: str, n: int, context ev: std::event_loop::Loop) errors std::event_loop::SchedulerFault:
    elog::say("W: ".concat(text), n)

fn producer(ch: std::event_loop::Reg, context ev: std::event_loop::Loop) -> int errors std::event_loop::SchedulerFault:
    loop i from 0 to 5:
        ch.post(i, 0)
        say("produced ", i)
        std::event_loop::yield_now()
    0

fn consumer(ch: std::event_loop::Reg, context ev: std::event_loop::Loop) -> int errors std::event_loop::SchedulerFault:
    loop i from 0 to 5:
        e = std::event_loop::wait(ch)
        say("consumed ", e.a)
    0

fn sleeper(context ev: std::event_loop::Loop) -> int errors std::event_loop::SchedulerFault:
    std::event_loop::sleep(3)
    say("slept until ", std::event_loop::now())
    std::event_loop::yield_now()
    say("after sleep ", 1)
    0

fn start(context ev: std::event_loop::Loop) errors std::event_loop::SchedulerFault:
    ch = std::event_loop::channel(Delivery::Reliable, 8)
    coroutine {step: c, first: cf} = consumer(ch)
    std::event_loop::adopt(c, cf)
    coroutine {step: p, first: pf} = producer(ch)
    std::event_loop::adopt(p, pf)
    coroutine {step: s, first: sf} = sleeper()
    std::event_loop::adopt(s, sf)
