# sdlprobe.bot -- the tasks of the SDL coordination scenarios (sdl-*.bot,
# mixed-*.bot): they use only std::event_loop and the SDL source's
# registration, whatever coordinates SDL with the driver.
#
#   receive   SDL events (a producer thread's and SDL's own timer
#             thread's): count and post -> dispatch latency per event;
#   posts     records a producer thread posts through an endpoint;
#   ticker    a 7 ms repeating timer: how late each wake is;
#   pusher    a task that pushes an SDL event itself, inside its segment
#             (SDL's filter and watch run synchronously in that call): the
#             event must reach the program in a later turn.
import elog
import event_loop_linux
import evsdl
import std::event_loop
import std::mutable_array
import std::str
import type std::event_loop::Delivery
import type std::event_loop::Wake

# One event's measurement (code CODE, posted at POSTED).
nomethod fn measure(code: int, posted: int, place stats: MutableArray[int], context ev: std::event_loop::Loop, n: event_loop_linux::Native) errors IndexNotFound, std::event_loop::SchedulerFault:
    if code == 9000:
        elog::say("pushed event received in turn ", std::event_loop::turn_number())
    else:
        stats.set(0, stats.at(0) + 1)
        l = event_loop_linux::now_us() - posted
        stats.set(1, stats.at(1) + l)
        if l > stats.at(2):
            stats.set(2, l)
        if l > 5000:
            stats.set(3, stats.at(3) + 1)

# Wait for REG's events and drain what is queued at each wake (try_take).
nomethod fn latency_sink(label: str, reg: std::event_loop::Reg, expect: int, done: std::event_loop::Reg, context ev: std::event_loop::Loop, n: event_loop_linux::Native) -> int errors IndexNotFound, std::event_loop::SchedulerFault:
    stats = std::mutable_array::create(4, 0)
    loop:
        if stats.at(0) >= expect:
            break
        e = std::event_loop::wait(reg)
        if e.reason != Wake::Event:
            break
        measure(e.a, e.b, stats)
        loop:
            more = std::event_loop::try_take(reg)
            if more.reason != Wake::Event:
                break
            measure(more.a, more.b, stats)
    elog::say(label.concat(" received "), stats.at(0))
    elog::say(label.concat(" max latency us "), stats.at(2))
    elog::say(label.concat(" later than 5 ms "), stats.at(3))
    elog::say(label.concat(" total latency us "), stats.at(1))
    done.post(1, 0)
    stats.at(0)

# A repeating PERIOD timer until TICKS intervals have elapsed: how late
# each wake is against its interval's deadline.
fn ticker(period: int, ticks: int, context ev: std::event_loop::Loop) -> int errors IndexNotFound, std::event_loop::SchedulerFault:
    t = std::event_loop::every(period)
    first = std::event_loop::now() + period
    # worst lateness, intervals elapsed, intervals missed
    worst = std::mutable_array::create(3, 0)
    loop:
        if worst.at(1) >= ticks:
            break
        e = std::event_loop::wait(t)
        due = first + (worst.at(1) + e.a) * period
        late = std::event_loop::now() - due
        worst.set(1, worst.at(1) + e.count)
        worst.set(2, worst.at(2) + e.a)
        if late > worst.at(0):
            worst.set(0, late)
    std::event_loop::revoke(t)
    elog::say("timer worst lateness us ", worst.at(0))
    elog::say("timer missed intervals ", worst.at(2))
    worst.at(0)

fn pusher(context ev: std::event_loop::Loop) -> int errors std::event_loop::SchedulerFault:
    std::event_loop::sleep(20000)
    elog::say("pusher pushes in turn ", std::event_loop::turn_number())
    evsdl::push(9000)
    elog::say("pusher's segment continues in turn ", std::event_loop::turn_number())
    0

# A 100 ms heartbeat until SINKS sinks have posted to DONE: the only thing
# that wakes a loop whose SDL events cannot (the naive mode).
fn heartbeat(done: std::event_loop::Reg, sinks: int, context ev: std::event_loop::Loop) -> int errors IndexNotFound, std::event_loop::SchedulerFault:
    t = std::event_loop::every(100000)
    finished = std::mutable_array::create(2, 0)
    loop:
        loop:
            d = std::event_loop::try_take(done)
            if d.reason != Wake::Event:
                break
            finished.set(0, finished.at(0) + 1)
        if finished.at(0) >= sinks:
            break
        std::event_loop::wait(t)
        finished.set(1, finished.at(1) + 1)
    std::event_loop::revoke(t)
    finished.at(1)

fn idle_sleep(us: int, context ev: std::event_loop::Loop) -> int errors std::event_loop::SchedulerFault:
    std::event_loop::sleep(us)
    us

# Adopt the scenario's tasks.
nomethod fn spawn_all(sdlreg: std::event_loop::Reg, posts: std::event_loop::Reg, context ev: std::event_loop::Loop, n: event_loop_linux::Native) errors IndexNotFound, std::event_loop::SchedulerFault:
    done = std::event_loop::channel(Delivery::Reliable, 8)
    coroutine {step: s, first: sf} = latency_sink("sdl", sdlreg, 260, done)
    std::event_loop::adopt(s, sf)
    coroutine {step: p, first: pf} = latency_sink("posts", posts, 200, done)
    std::event_loop::adopt(p, pf)
    coroutine {step: t, first: tf} = ticker(7000, 30)
    std::event_loop::adopt(t, tf)
    coroutine {step: u, first: uf} = pusher()
    std::event_loop::adopt(u, uf)
    coroutine {step: h, first: hf} = heartbeat(done, 2)
    std::event_loop::adopt(h, hf)

# The SDL-side producers: 240 user events from a thread (2 ms apart on
# average), 50 more the policy drops, and 20 from SDL's own timer thread.
fn start_producers() -> int:
    evsdl::drop_codes_from(100000)
    evsdl::producer(240, 2000, 0)
    evsdl::producer(50, 2000, 100000)
    evsdl::sdl_timer(5, 20, 1000)

fn report_sdl(context ev: std::event_loop::Loop) errors std::event_loop::SchedulerFault:
    elog::say("sdl callbacks ", evsdl::stat(evsdl::st_callbacks))
    elog::say("sdl callbacks on a foreign thread ", evsdl::stat(evsdl::st_foreign_thread))
    elog::say("sdl callbacks nested in a task's C call ", evsdl::stat(evsdl::st_nested))
    elog::say("sdl events copied ", evsdl::stat(evsdl::st_copied))
    elog::say("sdl events dropped by policy ", evsdl::stat(evsdl::st_dropped_by_policy))
    elog::say("sdl timer callbacks ", evsdl::stat(evsdl::st_timer_callbacks))
