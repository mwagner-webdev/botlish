# reject-missing-driver.bot -- must be REJECTED (tests/event-loop.test, el-static-*): running the loop with no driver installed (MISSING-CONTEXT)
import std::event_loop

with context std::event_loop::create(8)
n = std::event_loop::run():
    on std::event_loop::SchedulerFault:
        -1
    on std::event_loop::DriverFault:
        -2
    on std::event_loop::LoopReentered:
        -3
