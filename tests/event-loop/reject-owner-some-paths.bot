# reject-owner-some-paths.bot -- must be REJECTED (tests/event-loop.test, el-static-*): an Owner moved into a task on one path and kept on the other (AFFINE-PATH-RELEASE-UNSUPPORTED): its release at the end of the scope could not tell the paths apart, and there is no run-time ownership state to ask
import std::event_loop
import type std::event_loop::Delivery

fn holder(owner: std::event_loop::Owner, reg: std::event_loop::Reg, context ev: std::event_loop::Loop) -> int errors std::event_loop::SchedulerFault:
    e = std::event_loop::wait(reg)
    e.a

fn main(spawn: bool, context ev: std::event_loop::Loop) -> int errors std::event_loop::SchedulerFault:
    {owner, reg} = std::event_loop::owned_channel(Delivery::Reliable, 4)
    if spawn:
        coroutine {step, first} = holder(owner, reg)
        std::event_loop::adopt(step, first)
    0

with context std::event_loop::create(8)
main(true):
    on std::event_loop::SchedulerFault:
        0
