} -result {{[["exe.txt"], "from an executable"]} {[["exe.txt"], "from an executable"]}}

test fs-linux-gc-stress {the native backends under GC stress: a directory of files written, listed and read, every operation allocating, with a collection at every allocation} -constraints nativeLinux -body {
    set dir [fsDir]
    set text [fsProgram linux $dir {    made = loop i from 0 to 5:
        nroot.concat(std::str::concat("f", i.to_string())).write_file(bytes_of(i.to_string()))
    listed = nroot.entries()
    sum = loop e in listed:
        text_of(nroot.join(e.name).read_file())
    [listed.length(), sum.length()]}]
    set hir [fsHir $text [linuxTarget]]
    withEnvironment {BOTLISH_NATIVE_GC_STRESS 1} {
        lmap b {cranelift cranelift-generic} {lindex [outcomeUnderHir $b $hir] 1}
    }
} -result {{[5, 5]} {[5, 5]}}

# ===========================================================================
# Linux: faults the kernel does not give on demand (strace's injection)

# EXE's output and strace's log of its file syscalls on PATH with INJECT
# injected: only the calls that access PATH (or a descriptor opened for it)
# are traced and counted (-P: the dynamic loader's reads are not the
# program's), full strings (-s), one line per call, the thread ids -f
# prefixes removed (the runtime runs Botlish code on a thread of its own).
proc fsStraced {exe inject path} {
    set log [file join $::fsScratch strace[incr ::fsCounter].log]
    catch {exec strace -f -qq -s 4096 -o $log -P $path -e trace=openat,getdents64,read,write,close -e inject=$inject $exe} out
    regsub -all -line {^[0-9]+ +} [fsReadBinary $log] {} text
    return [list $out $text]
}

test fs-linux-fault-enumeration {a getdents64 that fails (EIO, injected) fails entries with FileError (Other, 5) and closes the directory's descriptor: no descriptor outlives the failure} -constraints {nativeLinux straceInject} -body {
    set dir [fsDir]
    fsWrite [file join $dir a] a
    set exe [native::executable [fsHir [fsProgram linux $dir {    listed = nroot.entries()
    [listed.length()]}] [linuxTarget]] [file join $::fsScratch fsexe[incr ::fsCounter]]]
    lassign [fsStraced $exe getdents64:error=EIO $dir] out log
    regexp {openat\([^)]*O_DIRECTORY[^)]*\) = (\d+)} $log -> fd
    list $out [regexp "getdents64\\($fd, .*= -1 EIO \\(Input/output error\\) \\(INJECTED\\)\nclose\\($fd\\) += 0" $log]
} -cleanup {unset -nocomplain fd} -result {{["FileError", std::io::fs::Reason::Other, 5]} 1}

test fs-linux-fault-short-write {a short write (the first write reports one byte, injected) is continued by write_all from the next byte: strace's injection skips the call, so the file holds the five bytes write_all wrote after it -- the policy is "continue after what the kernel reports", never "write it all again"} -constraints {nativeLinux straceInject} -body {
    set dir [fsDir]
    set exe [native::executable [fsHir [fsProgram linux $dir {    path = nroot.concat("w.txt")
    path.write_file(bytes_of("abcdef"))
    [text_of(path.read_file())]}] [linuxTarget]] [file join $::fsScratch fsexe[incr ::fsCounter]]]
    lassign [fsStraced $exe write:retval=1:when=1 [file join $dir w.txt]] out log
    regexp {openat\([^)]*w\.txt[^)]*\) = (\d+)} $log -> fd
    list $out [fsReadBinary [file join $dir w.txt]] \
        [regexp "write\\($fd, \"abcdef\", 6\\) += 1 \\(INJECTED\\)\nwrite\\($fd, \"bcdef\", 5\\) += 5\n" $log]
} -cleanup {unset -nocomplain fd} -result {{["bcdef"]} bcdef 1}

test fs-linux-fault-read {a read that fails (EINTR, injected: no retry) fails read_file with FileError (Other, 4) and closes the file} -constraints {nativeLinux straceInject} -body {
    set dir [fsDir]
    fsWrite [file join $dir r.txt] data
    set exe [native::executable [fsHir [fsProgram linux $dir {    [text_of(nroot.concat("r.txt").read_file())]}] [linuxTarget]] [file join $::fsScratch fsexe[incr ::fsCounter]]]
    lassign [fsStraced $exe read:error=EINTR:when=1 [file join $dir r.txt]] out log
    regexp {openat\([^)]*r\.txt[^)]*\) = (\d+)} $log -> fd
    list $out [regexp "read\\($fd, .*INJECTED\\)\nclose\\($fd\\)" $log]
} -cleanup {unset -nocomplain fd} -result {{["FileError", std::io::fs::Reason::Other, 4]} 1}

# ===========================================================================
# Windows execution: real files and directories on NTFS
#
# Each program is registered here, by name, so that fs-windows-programs-compile
# type-checks every one of them for windows-x86_64 on every host; the tests
# that run them need Windows.

set ::fsWindows [dict create]
proc fsWindows {name body {helpers ""}} {
    dict set ::fsWindows $name [list $body $helpers]
}
proc fsWindowsProgram {name dir} {
    return [fsProgram windows $dir {*}[dict get $::fsWindows $name]]
}

fsWindows roundtrip {    path = nroot.concat("data.bin")
    made = path.open(std::io::fs::OpenMode::CreateNew)
    written = made.write_all(std::abi::bytes::join([bytes_of("hé"), raw([0, 255]), bytes_of("tail")]))
    written.close()
    opened = path.open(std::io::fs::OpenMode::Read)
    {file: f1, data: first} = opened.read(3)
    {file: f2, data: rest} = f1.read(4096)
    {file: f3, data: last} = f2.read(4096)
    f3.close()
    [std::abi::bytes::length(first).value, text_of(first), std::abi::bytes::length(rest).value, std::abi::bytes::length(last).value]}

fsWindows modes {    path = nroot.concat("Case.txt")
    path.write_file(bytes_of("long text"))
    path.write_file(bytes_of("short"))
    other = nroot.concat("CASE.TXT")
    exists = create_refused(other)
    log = nroot.concat("log.txt")
    a = log.open(std::io::fs::OpenMode::Append)
    a2 = a.write_all(bytes_of("one,"))
    a2.close()
    b = log.open(std::io::fs::OpenMode::Append)
    b2 = b.write_all(bytes_of("two"))
    b2.close()
    missing = read_refused(nroot.concat("missing"))
    deeper = read_refused(nroot.concat("nowhere\\x"))
    [text_of(other.read_file()), exists, text_of(log.read_file()), missing, deeper]} {fn create_refused(p: std::windows::fs::NativePath) -> List[any]:
    p.create_file(bytes_of("x")):
        on std::io::fs::FileError failed:
            return shown(failed.reason, failed.code)
    []

fn read_refused(p: std::windows::fs::NativePath) -> List[any]:
    p.read_file():
        on std::io::fs::FileError failed:
            return shown(failed.reason, failed.code)
    []
}

fsWindows native-roundtrip {    lone = std::windows::fs::from_units([117, 45, 55296])
    nroot.join(lone).write_file(bytes_of("lone"))
    nroot.join(std::windows::fs::from_units([117, 45, 65533])).write_file(bytes_of("lossy"))
    listed = nroot.entries()
    reached = loop e in listed:
        [e.name.units(), text_of(nroot.join(e.name).read_file()), e.name.display()]
    portable = root.entries():
        on std::io::path::NotText:
            []
    [reached, portable.length()]}

fsWindows verbatim {    verbatim = std::windows::fs::from_text(std::str::concat("\\\\?\\", root))
    verbatim.concat("verb.").write_file(bytes_of("kept"))
    nroot.concat("plain").write_file(bytes_of("plain"))
    listed = verbatim.entries()
    names = loop e in listed:
        e.name.display()
    dotted = loop e in listed:
        if e.name.units() == [118, 101, 114, 98, 46]:
            e.name
        else:
            continue
    found = dotted.at(0):
        on IndexNotFound:
            return ["no verb."]
    back = verbatim.join(found).read_file()
    refused = nroot.join(found):
        on std::io::path::NotAPath:
            nroot
    [names, text_of(back), refused == nroot]}

fsWindows directory-failures {    [
        try_list(nroot.concat("file.txt")),
        try_read(nroot.concat("full")),
        try_remove_file(nroot.concat("full")),
        try_read(nroot.concat("file.txt\\x")),
        try_remove_directory(nroot.concat("full")),
        try_remove_directory(nroot.concat("file.txt")),
        try_create_directory(nroot.concat("full")),
    ]} {fn try_list(p: std::windows::fs::NativePath) -> List[any]:
    p.entries():
        on std::io::fs::FileError failed:
            return shown(failed.reason, failed.code)
    []

fn try_read(p: std::windows::fs::NativePath) -> List[any]:
    p.read_file():
        on std::io::fs::FileError failed:
            return shown(failed.reason, failed.code)
    []

fn try_remove_file(p: std::windows::fs::NativePath) -> List[any]:
    p.remove_file():
        on std::io::fs::FileError failed:
            return shown(failed.reason, failed.code)
    []

fn try_remove_directory(p: std::windows::fs::NativePath) -> List[any]:
    p.remove_directory():
        on std::io::fs::FileError failed:
            return shown(failed.reason, failed.code)
    []

fn try_create_directory(p: std::windows::fs::NativePath) -> List[any]:
    p.create_directory():
        on std::io::fs::FileError failed:
            return shown(failed.reason, failed.code)
    []
}

fsWindows entries {    listed = nroot.entries()
    names = loop e in listed:
        [e.name.display(), e.kind]
    [names, nroot.concat("empty").entries().length()]}

fsWindows sharing {    path = nroot.concat("shared.txt")
    w = path.open(std::io::fs::OpenMode::Replace)
    r = path.open(std::io::fs::OpenMode::Read)
    r.close()
    w.close()
    busy = nroot.concat("held.txt").read_file():
        on std::io::fs::FileError failed:
            bytes_of(std::str::concat("Busy? ", failed.code.to_string()))
    [text_of(busy)]}

fsWindows long-path {    long = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    verbatim = std::windows::fs::from_text(std::str::concat("\\\\?\\", root))
    deep = verbatim.concat(long).concat(long).concat(long)
    verbatim.concat(long).create_directory()
    verbatim.concat(long).concat(long).create_directory()
    deep.create_directory()
    deep.concat("f.txt").write_file(bytes_of("deep"))
    plain = nroot.concat(long).concat(long).concat(long).concat("f.txt").read_file():
        on std::io::fs::FileError failed:
            bytes_of(failed.code.to_string())
    [text_of(deep.concat("f.txt").read_file()), text_of(plain)]}

fsWindows executable {    path = nroot.concat("exe.txt")
    path.write_file(bytes_of("from an executable"))
    names = loop e in nroot.entries():
        e.name.display()
    [names, text_of(path.read_file())]}

fsWindows portable {    data = portable(root)
    data} {fn portable(dir: std::io::fs::FilePath) -> List[any] errors std::io::fs::FileError, std::io::path::NotAPath, std::io::path::NotText:
    sub = dir.concat("saves")
    sub.create_directory()
    sub.concat("one.txt").write_file(std::abi::bytes::from_list("1".encode_utf8()))
    names = loop e in sub.entries():
        e.name
    sub.concat("one.txt").remove_file()
    sub.remove_directory()
    [names]
}

test fs-windows-programs-compile {every Windows execution program below compiles for windows-x86_64, on every host} -body {
    set out {}
    dict for {name program} $::fsWindows {
        set r [fsRejection [fsProgram windows {C:\x} {*}$program] windows-x86_64]
        if {$r ne "accepted"} {
            lappend out $name $r
        }
    }
    set out
} -result {}

test fs-windows-roundtrip {create a file exclusively, write bytes (a NUL and a high byte among them) and close it; reopen, read three bytes, the rest, nothing (the end), close} -constraints windowsIO -body {
    fsValue [fsWindowsProgram roundtrip [fsDir]]
} -result {[3, "hé", 6, 0]}

test fs-windows-modes {the four open modes on NTFS: Read needs the file (NotFound, ERROR_FILE_NOT_FOUND 2; ERROR_PATH_NOT_FOUND 3 for a missing directory), Replace truncates, CreateNew never does (AlreadyExists, ERROR_FILE_EXISTS 80, also for another spelling of the name: NTFS compares names without case), Append appends} -constraints windowsIO -body {
    fsValue [fsWindowsProgram modes [fsDir]]
} -result {["short", [std::io::fs::Reason::AlreadyExists, 80], "one,two", [std::io::fs::Reason::NotFound, 2], [std::io::fs::Reason::NotFound, 3]]}

test fs-windows-native-roundtrip {NTFS keeps a name with an unpaired surrogate: made from raw code units, listed, joined and opened again, it reaches its own file -- and so does the file whose name is its lossy spelling; the portable listing refuses the directory (NotText); display shows U+FFFD} -constraints windowsIO -body {
    fsValue [fsWindowsProgram native-roundtrip [fsDir]]
} -result {[[[[117, 45, 55296], "lone", "u-�"], [[117, 45, 65533], "lossy", "u-�"]], 0]}

test fs-windows-verbatim {Win32 drops a component's trailing period, \\?\ keeps it: a name made through a verbatim directory ("verb.") is listed as written and reached again only through that verbatim directory -- joined to the Win32 spelling of the directory it is refused (NotAPath), never opened as another file} -constraints windowsIO -body {
    fsValue [fsWindowsProgram verbatim [fsDir]]
} -result {[["plain", "verb."], "kept", true]}

test fs-windows-directory-failures {directory misuse on Windows, each with its Win32 code: listing a file is NotADirectory (ERROR_DIRECTORY, 267); opening a directory or DeleteFileW of one is IsADirectory (Win32's ERROR_ACCESS_DENIED, 5, kept as the code); a file used as a directory is NotFound (ERROR_PATH_NOT_FOUND, 3); removing a non-empty directory is NotEmpty (145), a file NotADirectory (267); an existing directory AlreadyExists (183)} -constraints windowsIO -body {
    set dir [fsDir]
    file mkdir [file join $dir full]
    fsWrite [file join $dir full f] x
    fsWrite [file join $dir file.txt] x
    fsValue [fsWindowsProgram directory-failures $dir]
} -result {[[std::io::fs::Reason::NotADirectory, 267], [std::io::fs::Reason::IsADirectory, 5], [std::io::fs::Reason::IsADirectory, 5], [std::io::fs::Reason::NotFound, 3], [std::io::fs::Reason::NotEmpty, 145], [std::io::fs::Reason::NotADirectory, 267], [std::io::fs::Reason::AlreadyExists, 183]]}

test fs-windows-entries {entries on NTFS: files and directories with their kinds, "." and ".." left out, an empty directory empty} -constraints windowsIO -body {
    set dir [fsDir]
    fsWrite [file join $dir b.txt] x
    file mkdir [file join $dir a] [file join $dir empty]
    fsValue [fsWindowsProgram entries $dir]
} -result {[[["a", std::io::fs::EntryKind::Directory], ["b.txt", std::io::fs::EntryKind::File], ["empty", std::io::fs::EntryKind::Directory]], 0]}

test fs-windows-sharing {files open with share mode READ|WRITE|DELETE: a second open of a file open for writing succeeds; while another process holds it exclusively (FileShare.None) opening it is Busy (ERROR_SHARING_VIOLATION, 32)} -constraints windowsIO -body {
    set dir [fsDir]
    fsWrite [file join $dir held.txt] held
    set held [file join $dir held.txt]
    set ready [file join $dir ready]
    set pid [exec pwsh -NoProfile -Command "\$f = \[System.IO.File\]::Open('$held', 'Open', 'ReadWrite', 'None'); Set-Content -Path '$ready' -Value ok; Start-Sleep -Seconds 120" &]
    for {set i 0} {$i < 600 && ![file exists $ready]} {incr i} { after 100 }
    try {
        fsValue [fsWindowsProgram sharing $dir]
    } finally {
        catch {exec taskkill /PID $pid /F}
    }
} -cleanup {unset -nocomplain held ready pid i} -result {["Busy? 32"]}

test fs-windows-long-path {a path longer than MAX_PATH works through \\?\ (NTFS's limit) and not through Win32's (ERROR_PATH_NOT_FOUND, 3)} -constraints windowsIO -body {
    fsValue [fsWindowsProgram long-path [fsDir]]
} -result {["deep", "3"]}

test fs-windows-executable {a standalone Windows executable does the round trip (and under GC stress)} -constraints windowsIO -body {
    set dir [fsDir]
    set exe [native::executable [fsHir [fsWindowsProgram executable $dir]] [file join $::fsScratch fsexe[incr ::fsCounter]]]
    set first [exec $exe]
    file delete [file join $dir exe.txt]
