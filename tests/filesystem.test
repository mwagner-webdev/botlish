fn try_open(p: std::darwin::fs::NativePath, mode: std::io::fs::OpenMode) -> List[any]:
    f = p.open(mode):
        on std::io::fs::FileError failed:
            return shown(failed.reason, failed.code)
    f.close():
        on std::io::fs::FileError failed:
            return shown(failed.reason, failed.code)
    []

fn try_remove_file(p: std::darwin::fs::NativePath) -> List[any]:
    p.remove_file():
        on std::io::fs::FileError failed:
            return shown(failed.reason, failed.code)
    []

fn try_remove_directory(p: std::darwin::fs::NativePath) -> List[any]:
    p.remove_directory():
        on std::io::fs::FileError failed:
            return shown(failed.reason, failed.code)
    []

fn try_create_directory(p: std::darwin::fs::NativePath) -> List[any]:
    p.create_directory():
        on std::io::fs::FileError failed:
            return shown(failed.reason, failed.code)
    []
}

fsDarwin portable {    data = portable(root)
    data} {fn portable(dir: std::io::fs::FilePath) -> List[any] errors std::io::fs::FileError, std::io::path::NotAPath, std::io::path::NotText:
    sub = dir.concat("saves")
    sub.create_directory()
    sub.concat("one.txt").write_file(std::abi::bytes::from_list("1".encode_utf8()))
    names = loop e in sub.entries():
        e.name
    back = sub.concat("one.txt").read_file()
    sub.concat("one.txt").remove_file()
    sub.remove_directory()
    [names, back == std::abi::bytes::from_list("1".encode_utf8())]
}

fsDarwin executable {    path = nroot.concat("exe.txt")
    path.write_file(bytes_of("from an executable"))
    names = loop e in nroot.entries():
        e.name.display()
    [names, text_of(path.read_file())]}

test fs-darwin-programs-compile {every macOS execution program below compiles for macos-aarch64, on every host} -body {
    set out {}
    dict for {name program} $::fsDarwin {
        set r [fsRejection [fsProgram darwin /tmp/x {*}$program] macos-aarch64]
        if {$r ne "accepted"} {
            lappend out $name $r
        }
    }
    set out
} -result {}

test fs-darwin-roundtrip {create a file exclusively, write bytes (a NUL and a high byte among them) and close it; reopen, read three bytes, the rest, nothing (the end), close -- through libSystem's open, read, write and close} -constraints darwinIO -body {
    fsValue [fsDarwinProgram roundtrip [fsDir]]
} -result {[3, "hé", 6, 0]}

test fs-darwin-modes {the four open modes on macOS: Read needs the file (NotFound, ENOENT 2), Replace truncates, CreateNew never does (AlreadyExists, EEXIST 17), Append appends} -constraints darwinIO -body {
    fsValue [fsDarwinProgram modes [fsDir]]
} -result {["short", [std::io::fs::Reason::AlreadyExists, 17], "one,two", [std::io::fs::Reason::NotFound, 2]]}

test fs-darwin-names {APFS's names are not Linux's: a name that is not UTF-8 is refused (InvalidName, EILSEQ 92) -- so every name a macOS directory lists has text -- and names are compared without normalization or case (an NFD spelling of an existing NFC name and another case of an existing name are AlreadyExists, 17)} -constraints darwinIO -body {
    fsValue [fsDarwinProgram names [fsDir]]
} -result {[[std::io::fs::Reason::InvalidName, 92], [std::io::fs::Reason::AlreadyExists, 17], [std::io::fs::Reason::AlreadyExists, 17], 2]}

test fs-darwin-entries {entries on APFS (readdir): files, directories and a symbolic link with their kinds, "." and ".." left out, an empty directory empty} -constraints darwinIO -body {
    set dir [fsDir]
    fsWrite [file join $dir b.txt] x
    file mkdir [file join $dir a] [file join $dir empty]
    exec ln -s b.txt [file join $dir link]
    set value [fsValue [fsDarwinProgram entries $dir]]
    list [lsort [regexp -all -inline {\["[a-z.]+", std::io::fs::EntryKind::[A-Za-z]+\]} $value]] [regexp {\], 0\]$} $value]
} -result {{{["a", std::io::fs::EntryKind::Directory]} {["b.txt", std::io::fs::EntryKind::File]} {["empty", std::io::fs::EntryKind::Directory]} {["link", std::io::fs::EntryKind::SymbolicLink]}} 1}

test fs-darwin-directory-failures {directory misuse on macOS, each with its errno: listing a file is NotADirectory (ENOTDIR 20), opening a directory to write IsADirectory (EISDIR 21), unlink of a directory IsADirectory (macOS's EPERM, 1, kept as the code), removing a non-empty directory NotEmpty (ENOTEMPTY, 66 on macOS), a file NotADirectory (20), an existing directory AlreadyExists (17)} -constraints darwinIO -body {
    set dir [fsDir]
    file mkdir [file join $dir full]
    fsWrite [file join $dir full f] x
    fsWrite [file join $dir file.txt] x
    fsValue [fsDarwinProgram directory-failures $dir]
} -result {[[std::io::fs::Reason::NotADirectory, 20], [std::io::fs::Reason::IsADirectory, 21], [std::io::fs::Reason::IsADirectory, 1], [std::io::fs::Reason::NotEmpty, 66], [std::io::fs::Reason::NotADirectory, 20], [std::io::fs::Reason::AlreadyExists, 17]]}

test fs-darwin-portable {portable code over FilePath, given a DarwinPath: the same program as the other platforms'} -constraints darwinIO -body {
    fsValue [fsDarwinProgram portable [fsDir]]
} -result {[["one.txt"], true]}

test fs-darwin-executable {a standalone macOS executable does the round trip (and under GC stress)} -constraints darwinIO -body {
    set dir [fsDir]
    set exe [native::executable [fsHir [fsDarwinProgram executable $dir]] [file join $::fsScratch fsexe[incr ::fsCounter]]]
    set first [exec $exe]
    file delete [file join $dir exe.txt]
    set stressed [withEnvironment {BOTLISH_NATIVE_GC_STRESS 1} {exec $exe}]
    list $first $stressed
} -result {{[["exe.txt"], "from an executable"]} {[["exe.txt"], "from an executable"]}}

cleanupTests
