# macOS execution: real files and directories on APFS, through libSystem
#
# Registered like the Windows programs: fs-darwin-programs-compile
# type-checks each for macos-aarch64 on every host; the tests that run them
# need macOS (darwinIO).

set ::fsDarwin [dict create]
proc fsDarwin {name body {helpers ""}} {
    dict set ::fsDarwin $name [list $body $helpers]
}
proc fsDarwinProgram {name dir} {
    return [fsProgram darwin $dir {*}[dict get $::fsDarwin $name]]
}

fsDarwin roundtrip {    path = nroot.concat("data.bin")
    made = path.open(std::io::fs::OpenMode::CreateNew)
    written = made.write_all(std::abi::bytes::join([bytes_of("hé"), raw([0, 255]), bytes_of("tail")]))
    written.close()
    opened = path.open(std::io::fs::OpenMode::Read)
    {file: f1, data: first} = opened.read(3)
    {file: f2, data: rest} = f1.read(4096)
    {file: f3, data: last} = f2.read(4096)
    f3.close()
    [std::abi::bytes::length(first).value, text_of(first), std::abi::bytes::length(rest).value, std::abi::bytes::length(last).value]}

fsDarwin modes {    path = nroot.concat("f.txt")
    path.write_file(bytes_of("long text"))
    path.write_file(bytes_of("short"))
    replaced = text_of(path.read_file())
    exists = create_refused(path)
    log = nroot.concat("log.txt")
    a = log.open(std::io::fs::OpenMode::Append)
    a2 = a.write_all(bytes_of("one,"))
    a2.close()
    b = log.open(std::io::fs::OpenMode::Append)
    b2 = b.write_all(bytes_of("two"))
    b2.close()
    missing = read_refused(nroot.concat("missing"))
    [replaced, exists, text_of(log.read_file()), missing]} {fn create_refused(p: std::darwin::fs::NativePath) -> List[any]:
    p.create_file(bytes_of("x")):
        on std::io::fs::FileError failed:
            return shown(failed.reason, failed.code)
    []

fn read_refused(p: std::darwin::fs::NativePath) -> List[any]:
    p.read_file():
        on std::io::fs::FileError failed:
            return shown(failed.reason, failed.code)
    []
}

fsDarwin names {    raw_name = std::darwin::fs::from_bytes(raw_bytes([255, 254, 120]))
    invalid = create_refused(nroot.join(raw_name))
    nroot.concat("é").write_file(bytes_of("nfc"))
    nfd = create_refused(nroot.concat("é"))
    nroot.concat("Case.txt").write_file(bytes_of("case"))
    cased = create_refused(nroot.concat("CASE.TXT"))
    listed = loop e in nroot.entries():
        e.name.bytes()
    [invalid, nfd, cased, listed.length()]} {fn raw_bytes(xs: List[int]) -> List[std::byte::Byte]:
    loop x in xs:
        std::byte::from_int(x):
            on std::byte::BelowRange:
                0
            on std::byte::AboveRange:
                0

fn create_refused(p: std::darwin::fs::NativePath) -> List[any]:
    p.create_file(bytes_of("x")):
        on std::io::fs::FileError failed:
            return shown(failed.reason, failed.code)
    []
}

fsDarwin entries {    listed = nroot.entries()
    names = loop e in listed:
        [e.name.display(), e.kind]
    [names, nroot.concat("empty").entries().length()]}

fsDarwin directory-failures {    [
        try_list(nroot.concat("file.txt")),
        try_open(nroot.concat("full"), std::io::fs::OpenMode::Replace),
        try_remove_file(nroot.concat("full")),
        try_remove_directory(nroot.concat("full")),
        try_remove_directory(nroot.concat("file.txt")),
