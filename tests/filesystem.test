} -result {{[["exe.txt"], "from an executable"]} {[["exe.txt"], "from an executable"]}}

test fs-windows-portable {portable code over FilePath, given a WindowsPath: the same program as fs-linux-portable's} -constraints windowsIO -body {
    fsValue [fsWindowsProgram portable [fsDir]]
} -result {[["one.txt"]]}

