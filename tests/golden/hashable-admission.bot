# hashable-admission.bot -- the public hash's admission and the internal
# namespace, as source can observe them (HASHABLE-AND-KEYED-HASH.md; the Tcl
# originals are tests/hashable.test's; hashable.bot is the companion with the
# trait itself):
#
#   * `hash` of a value statically known not to be Hashable -- a function, a
#     struct with a function field, a MutableVector -- is TraitNotSatisfied
#     at compile time; of an affine C pointer, AffineEqualityUnsupported (the
#     ownership discipline's);
#   * the total lowerings of hash and == compute what the fallible ones do;
#   * the internal namespace table_hash is unreachable from this program,
#     even where a static block asks (InternalNamespace).
#
# This suite never names the trait, so it is no trait program: its rejected
# blocks are decided together (a trait program's are decided one plan at a
# time).
import compiler
import ffi::c
import mutable_vector
import test

struct P:
    x: int
    y: int

enum Color:
    Red,
    Green,
    Blue,

struct Q:
    a: P
    b: str
    c: Color

struct Holder:
    n: int
    f: Fn{args: [int], return: int}

fn twice(n: int) -> int:
    n * 2

fn equal_q(a: Q, b: Q) -> bool:
    a == b

fn hash_q(q: Q) -> int:
    hash(q)

fn register_admission_tests():
    fn b_hash_callable() errors compiler::CompilerError:
        static compile:
            hash(twice)
    test::rejects_containing("hb-hash-static-rejection/function", compiler::DiagnosticCode::TraitNotSatisfied, "the argument of hash does not satisfy trait", b_hash_callable)

    fn b_hash_holder() errors compiler::CompilerError:
        static compile:
            hash(Holder {n: 1, f: twice})
    test::rejects("hb-hash-static-rejection/struct", compiler::DiagnosticCode::TraitNotSatisfied, b_hash_holder)

    fn b_hash_vector() errors compiler::CompilerError:
        static compile:
            hash(mutable_vector::from_list([1]))
    test::rejects("hb-hash-static-rejection/vector", compiler::DiagnosticCode::TraitNotSatisfied, b_hash_vector)

    fn b_pointer_hash() errors compiler::CompilerError:
        static compile:
            p = ffi::c::null[ffi::c::Int]()
            hash(p)
    test::rejects("hb-authority-not-hashable/pointer-hash", compiler::DiagnosticCode::AffineEqualityUnsupported, b_pointer_hash)

    fn b_total() errors compiler::CompilerError:
        static compile:
            q = Q {a: P {x: 1, y: 2}, b: "s", c: Color::Red}
            [equal_q(q, q), equal_q(q, Q {a: P {x: 1, y: 3}, b: "s", c: Color::Red}), hash_q(q) == hash(Q {a: P {x: 1, y: 2}, b: "s", c: Color::Red})]
    test::value("hb-total-results-agree", [true, false, true], b_total)

    fn b_internal() errors compiler::CompilerError:
        static compile:
            table_hash::of(1)
    test::rejects("hb-internal-static-compile", compiler::DiagnosticCode::InternalNamespace, b_internal)

with context test::suite()
register_admission_tests()
test::report()
