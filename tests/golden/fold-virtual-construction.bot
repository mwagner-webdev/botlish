# fold-virtual-construction.bot -- folds whose String/List intermediate the
# native backends carry as a construction plan (FOLD-VIRTUAL-LIST-
# CONSTRUCTION-MILESTONE-1.md), as a source-level specification: a plan
# fold means exactly what the eager fold means.
#
# * Appending to the intermediate, keeping it, continuing past it and
#   breaking off with it give the fold's value as written: a break yields
#   the intermediate its iteration started with, a continue keeps it, an
#   empty domain yields the initial value, every iteration form carries it.
# * The initial value is never modified (it may be shared), appended
#   elements stay ordinary values, nested folds keep their own
#   intermediates, an error or a return leaves the fold with nothing of it
#   committed, a yield suspends it.
# * Folds whose earlier intermediate is observable -- an append before a
#   break or continue, two versions on one path, an observation, a capture,
#   a reference in an inner loop -- run on the eager lowering, with the
#   same values.
#
# Ported from tests/fold-virtual-construction.test, which stays
# authoritative and unchanged; a golden test keeps its Tcl test's name. What
# only the Tcl tests observe (the eager fold's comparison, the decisions,
# NIR, copy and allocation counts, release counters, GC stress,
# executables) stays there. This file is generated by
# audit/fold-virtual-construction/tools/golden-port.tcl from the Tcl tests'
# own programs and results.
import std::compiler
import std::coroutine
import std::list
import std::mutable_map
import std::mutable_vector
import std::str
import std::test

# Declarations the tests need (top-level only), named Fvc... to stay apart
# from the other suites'.
type FvcPercent = Int in 0..100

error FvcBad

error FvcLate

error FvcOdd

error FvcSkip

struct FvcChunks:
    done: List[List[int]]
    current: List[int]

fn register_fold_virtual_construction_tests():
    fn t_append() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> List[int]:
                fold x in xs with intermediate acc []:
                    acc.append(x)

            [f([]), f([1]), f([1, 2, 3])]
    std::test::value("fvc-append", [[], [1], [1, 2, 3]], t_append)

    fn t_nonempty_initial() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> List[int]:
                fold x in xs with intermediate acc [100, 200]:
                    acc.append(x)

            [f([]), f([1, 2])]
    std::test::value("fvc-nonempty-initial", [[100, 200], [100, 200, 1, 2]], t_nonempty_initial)

    fn t_empty_domain() errors std::compiler::CompilerError:
        static compile:
            a = fold x in [] with intermediate acc [7]:
                acc.append(x)
            b = fold i from 3 to 3 with intermediate acc [8]:
                acc.append(i)
            [a, b]
    std::test::value("fvc-empty-domain", [[7], [8]], t_empty_domain)

    fn t_list_of_lists() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> List[List[int]]:
                fold x in xs with intermediate acc []:
                    if x == 0:
                        acc.append([])
                    else:
                        acc.append([x, -x])

            f([1, 0, 2])
    std::test::value("fvc-list-of-lists", [[1, -1], [], [2, -2]], t_list_of_lists)

    fn t_computed_elements() errors std::compiler::CompilerError:
        static compile:
            fn square(x: int) -> int:
                x * x

            fn f(xs: List[int]) -> List[int]:
                fold x in xs with intermediate acc []:
                    acc.append(square(x) + 1)

            f([1, 2, 3, 4])
    std::test::value("fvc-computed-elements", [2, 5, 10, 17], t_computed_elements)

    fn t_heap_elements() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[str]) -> List[str]:
                fold x in xs with intermediate acc []:
                    acc.append(std::str::concat(x, "!"))

            fn g(n: int) -> List[List[int]]:
                fold i from 0 to n with intermediate acc []:
                    row = loop j from 0 to i:
                        j
                    acc.append(row)

            [f(["a", "bé", "🙂"]), g(4)]
    std::test::value("fvc-heap-elements", [["a!", "bé!", "🙂!"], [[], [0], [0, 1], [0, 1, 2]]], t_heap_elements)

    fn t_conditional() errors std::compiler::CompilerError:
        static compile:
            fn keep(x: int) -> bool:
                x.mod(3) != 0

            fn f(xs: List[int]) -> List[int]:
                fold x in xs with intermediate acc [0]:
                    if keep(x):
                        acc.append(x * 10)
                    else:
                        acc

            f([1, 2, 3, 4, 5, 6, 7])
    std::test::value("fvc-conditional", [0, 10, 20, 40, 50, 70], t_conditional)

    fn t_unchanged() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> List[int]:
                fold x in xs with intermediate acc [1]:
                    if x > 100:
                        acc.append(x)
                    else:
                        acc

            [f([1, 2, 3]), f([5, 500, 6, 600])]
    std::test::value("fvc-unchanged", [[1], [1, 500, 600]], t_unchanged)

    fn t_continue() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> List[int]:
                fold x in xs with intermediate acc []:
                    if x == 0:
                        continue
                    y = x * 2
                    if y > 10:
                        continue
                    acc.append(y)

            f([1, 0, 2, 9, 3, 0])
    std::test::value("fvc-continue", [2, 4, 6], t_continue)

    fn t_break() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> List[int]:
                fold x in xs with intermediate acc []:
                    if x > 5:
                        break
                    acc.append(x)

            [f([1, 2, 9, 3]), f([9]), f([1, 2])]
    std::test::value("fvc-break", [[1, 2], [], [1, 2]], t_break)

    fn t_break_continue() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> List[List[int]]:
                fold t in xs with intermediate done []:
                    if t == 0:
                        continue
                    if t > 1000:
                        break
                    if t < 0:
                        done.append([t]).append([-t])
                    elif t == 1:
                        done.append([])
                    elif t == 2:
                        done
                    else:
                        done.append([t, t + 1])

            f([3, 0, -4, 1, 2, 5, 2000, 6])
    std::test::value("fvc-break-continue", [[3, 4], [-4], [4], [], [5, 6]], t_break_continue)

    fn t_positions() errors std::compiler::CompilerError:
        static compile:
            fn bound(xs: List[int]) -> int:
                r = fold x in xs with intermediate acc []:
                    acc.append(x)
                r.length()

            fn returned(xs: List[int]) -> List[int]:
                return fold x in xs with intermediate acc []:
                    acc.append(x + 1)

            fn branch(xs: List[int], c: bool) -> List[int]:
                if c:
                    fold x in xs with intermediate acc []:
                        acc.append(x * 2)
                else:
                    []

            top = fold x in [4, 5] with intermediate acc []:
                acc.append(x)
            [[bound([1, 2, 3])], returned([1, 2]), branch([1, 2], true), branch([1], false), top]
    std::test::value("fvc-positions", [[3], [2, 3], [2, 4], [], [4, 5]], t_positions)

    fn t_generic() errors std::compiler::CompilerError:
        static compile:
            fn f(xs):
                fold x in xs with intermediate acc []:
                    acc.append(x)

            [f([1, 2]), f(["a", "b"])]
    std::test::value("fvc-generic", [[1, 2], ["a", "b"]], t_generic)

    fn t_refined() errors std::compiler::CompilerError:
        static compile:
            fn clamp(n: int) -> FvcPercent:
                if n < 0:
                    return 0
                if n > 100:
                    return 100
                n

            fn f(xs: List[int]) -> List[FvcPercent]:
                fold x in xs with intermediate acc []:
                    acc.append(clamp(x))

            fn need(ps: List[FvcPercent]) -> List[FvcPercent]:
                ps

            need(f([-5, 50, 500]))
    std::test::value("fvc-refined", [0, 50, 100], t_refined)

    fn t_string() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[str]) -> str:
                fold x in xs with intermediate s "<":
                    s.concat(x).concat(",")

            [f([]), f(["a", "bé", "🙂"])]
    std::test::value("fvc-string", ["<", "<a,bé,🙂,"], t_string)

    fn t_domains() errors std::compiler::CompilerError:
        static compile:
            fn keys(m: std::mutable_map::MutableMap[str, int]) -> List[str]:
                fold e in m with intermediate acc []:
                    acc.append(e.key)

            fn build() -> std::mutable_map::MutableMap[str, int] errors std::mutable_map::KeyNotFound:
                m = std::mutable_map::create[str, int]()
                m.set("a", 1)
                m.set("b", 20)
                m.set("c", 300)
                m.remove("b")
                m

            m = build():
                on std::mutable_map::KeyNotFound:
                    std::mutable_map::create[str, int]()
            a = fold i from 0 to 3 with intermediate acc ["s"]:
                acc.append("x")
            b = fold i down from 3 through 1 with intermediate acc []:
                acc.append(i)
            c = fold x in [1, 2, 3] and i from 0 to 3 with intermediate acc []:
                acc.append(x + i)
            [[a.length()], b, c, [keys(m).length()]]
    std::test::value("fvc-domains", [[4], [3, 2, 1], [1, 3, 5], [2]], t_domains)

    fn t_nested_independent() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> List[List[int]]:
                fold x in xs with intermediate outer []:
                    inner = fold y in [x, x + 1] with intermediate acc []:
                        acc.append(y * 2)
                    outer.append(inner)

            f([1, 5, 9])
    std::test::value("fvc-nested-independent", [[2, 4], [10, 12], [18, 20]], t_nested_independent)

    fn t_inner_seeded() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> List[int]:
                fold x in xs with intermediate outer [0]:
                    fold y in [x, x] with intermediate inner outer:
                        inner.append(y)

            f([1, 2, 3])
    std::test::value("fvc-inner-seeded", [0, 1, 1, 2, 2, 3, 3], t_inner_seeded)

    fn t_handoff_to_inner_fold() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int], ws: List[int]) -> List[int]:
                fold x in xs with intermediate acc []:
                    y = acc.append(x)
                    z = fold w in ws with intermediate inner y:
                        inner.append(w * 10)
                    z.append(0)

            [f([1, 2], [3, 4]), f([5], [])]
    std::test::value("fvc-handoff-to-inner-fold", [[1, 30, 40, 0, 2, 30, 40, 0], [5, 0]], t_handoff_to_inner_fold)

    fn t_in_outer_loop() errors std::compiler::CompilerError:
        static compile:
            loop k from 0 to 3:
                fold x in [1, 2] with intermediate acc [k]:
                    acc.append(x)
    std::test::value("fvc-in-outer-loop", [[0, 1, 2], [1, 1, 2], [2, 1, 2]], t_in_outer_loop)

    fn t_several_appends() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> List[List[int]]:
                fold x in xs with intermediate acc []:
                    acc.append([x]).append([]).append([x, x])

            f([1, 2])
    std::test::value("fvc-several-appends", [[1], [], [1, 1], [2], [], [2, 2]], t_several_appends)

    fn t_return_path() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> List[int]:
                fold x in xs with intermediate acc []:
                    if x < 0:
                        return acc.append(99)
                    acc.append(x)

            [f([1, 2]), f([1, -1, 2])]
    std::test::value("fvc-return-path", [[1, 2], [1, 99]], t_return_path)

    fn t_plan_initial() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int], base: List[int]) -> List[int]:
                start = base.append(0)
                fold x in xs with intermediate acc start:
                    acc.append(x)

            [f([1, 2], [7]), f([], [8])]
    std::test::value("fvc-plan-initial", [[7, 0, 1, 2], [8, 0]], t_plan_initial)

    fn t_shared_initial() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int], base: List[int]) -> List[List[int]]:
                r = fold x in xs with intermediate acc base:
                    acc.append(x)
                s = fold x in xs with intermediate acc base:
                    acc.append(-x)
                [base, r, s]

            f([1, 2], [7])
    std::test::value("fvc-shared-initial", [[7], [7, 1, 2], [7, -1, -2]], t_shared_initial)

    fn t_retained_element() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> List[List[int]]:
                r = fold x in xs with intermediate acc []:
                    acc.append(xs)
                r.append(xs)

            f([1, 2])
    std::test::value("fvc-retained-element", [[1, 2], [1, 2], [1, 2]], t_retained_element)

    fn t_element_error() errors std::compiler::CompilerError:
        static compile:
            fn check(x: int) -> int errors FvcBad:
                if x == 2:
                    fail FvcBad
                x

            fn f(xs: List[int]) -> List[int] errors FvcBad:
                fold x in xs with intermediate acc []:
                    acc.append(check(x))

            fn g(xs: List[int]) -> List[int]:
                r = f(xs):
                    on FvcBad:
                        [-1]
                r

            [g([1, 3]), g([1, 2, 3])]
    std::test::value("fvc-element-error", [[1, 3], [-1]], t_element_error)

    fn t_error_before_commit() errors std::compiler::CompilerError:
        static compile:
            fn check(x: int) -> int errors FvcLate:
                if x == 2:
                    fail FvcLate
                x

            fn f(xs: List[int]) -> List[int] errors FvcLate:
                fold x in xs with intermediate acc []:
                    y = acc.append(x)
                    check(x)
                    y

            fn g(xs: List[int]) -> List[int]:
                r = f(xs):
                    on FvcLate:
                        [-1]
                r

            [g([1, 3]), g([1, 2, 3])]
    std::test::value("fvc-error-before-commit", [[1, 3], [-1]], t_error_before_commit)

    fn t_handled_in_body() errors std::compiler::CompilerError:
        static compile:
            fn check(x: int) -> int errors FvcOdd:
                if x.mod(2) == 1:
                    fail FvcOdd
                x

            fn f(xs: List[int]) -> List[int]:
                fold x in xs with intermediate acc []:
                    y = check(x):
                        on FvcOdd:
                            0
                    acc.append(y)

            f([1, 2, 3, 4])
    std::test::value("fvc-handled-in-body", [0, 2, 0, 4], t_handled_in_body)

    fn t_discarded() errors std::compiler::CompilerError:
        static compile:
            fn note(place log: MutableVector[int], n: int) -> int:
                log.push(n)
                n

            fn f(xs: List[int]) -> List[int]:
                log = std::mutable_vector::from_list([0])
                log.clear()
                fold x in xs with intermediate acc []:
                    acc.append(note(log, x))
                loop v in log:
                    v

            f([3, 1, 2])
    std::test::value("fvc-discarded", [3, 1, 2], t_discarded)

    fn t_flat_composition() errors std::compiler::CompilerError:
        static compile:
            fn expand(x: int) -> List[int]:
                [x, x + 1]

            fn chunks(xs: List[int]) -> List[List[int]]:
                fold x in xs with intermediate acc []:
                    acc.append(expand(x))

            fn count(cs: List[List[int]]) -> int:
                cs.length()

            cs = chunks([1, 5, 9])
            second = std::list::at(cs, 1):
                on IndexNotFound:
                    []
            [std::list::flat(cs), std::list::flat(chunks([])), [count(cs), cs.length()], second]
    std::test::value("fvc-flat-composition", [[1, 2, 5, 6, 9, 10], [], [3, 3], [5, 6]], t_flat_composition)

    fn t_coroutine() errors std::compiler::CompilerError:
        static compile:
            fn running(xs: List[int]) -> List[int]:
                fold x in xs with intermediate acc []:
                    yield [x * 10]
                    acc.append(x)

            fn drive() -> List[List[int]]:
                coroutine {step, first} = running([1, 2, 3])
                a = step()
                b = step()
                c = step()
                [first, a, b, c]

            drive()
    std::test::value("fvc-coroutine", [[10], [20], [30], [1, 2, 3]], t_coroutine)

    fn t_reject_break_after_append() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> List[int]:
                fold x in xs with intermediate acc []:
                    y = acc.append(x)
                    if x > 5:
                        break
                    y

            f([1, 2, 9, 3])
    std::test::value("fvc-reject-break-after-append", [1, 2], t_reject_break_after_append)

    fn t_reject_continue_after_append() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> List[int]:
                fold x in xs with intermediate acc []:
                    y = acc.append(x)
                    if x == 2:
                        continue
                    y

            f([1, 2, 9, 3])
    std::test::value("fvc-reject-continue-after-append", [1, 9, 3], t_reject_continue_after_append)

    fn t_reject_break_after_materialized() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> List[int]:
                fold x in xs with intermediate acc []:
                    y = acc.append(x)
                    if y.length() > 3:
                        break
                    y.append(0)

            f([1, 2, 9, 3])
    std::test::value("fvc-reject-break-after-materialized", [1, 0, 2, 0], t_reject_break_after_materialized)

    fn t_reject_continue_after_materialized() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> List[int]:
                fold x in xs with intermediate acc []:
                    y = acc.append(x)
                    if x == y.length():
                        continue
                    y.append(0)

            f([1, 2, 9, 3])
    std::test::value("fvc-reject-continue-after-materialized", [2, 0, 9, 0, 3, 0], t_reject_continue_after_materialized)

    fn t_reject_discarded_append() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> List[int]:
                fold x in xs with intermediate acc []:
                    y = acc.append(x)
                    if x == 2:
                        acc
                    else:
                        y

            f([1, 2, 9, 3])
    std::test::value("fvc-reject-discarded-append", [1, 9, 3], t_reject_discarded_append)

    fn t_reject_observed() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> List[int]:
                fold x in xs with intermediate acc []:
                    n = acc.length()
                    acc.append(n + x)

            f([1, 2, 9, 3])
    std::test::value("fvc-reject-observed", [1, 3, 11, 6], t_reject_observed)

    fn t_reject_two_versions() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> List[List[int]]:
                r = fold x in xs with intermediate acc []:
                    p = {before: acc, after: acc.append(x)}
                    p.after
                fold x in xs with intermediate acc [r]:
                    p = {before: acc, after: acc.append([x])}
                    if x == 2:
                        p.before
                    else:
                        p.after

            f([1, 2, 3])
    std::test::value("fvc-reject-two-versions", [[1, 2, 3], [1], [3]], t_reject_two_versions)

    fn t_reject_retained() errors std::compiler::CompilerError:
        static compile:
            fn keep(place log: MutableVector[List[int]], l: List[int]) -> int:
                log.push(l)
                l.length()

            fn f(xs: List[int]) -> List[List[int]]:
                log = std::mutable_vector::from_list([[0]])
                log.clear()
                r = fold x in xs with intermediate acc []:
                    n = keep(log, acc)
                    acc.append(n)
                s = fold x in xs with intermediate acc []:
                    held = [acc]
                    acc.append(held.length())
                snapshots = loop v in log:
                    v
                snapshots.append(r).append(s)

            f([5, 6, 7])
    std::test::value("fvc-reject-retained", [[], [0], [0, 1], [0, 1, 2], [1, 1, 1]], t_reject_retained)

    fn t_reject_retained_only() errors std::compiler::CompilerError:
        static compile:
            fn keep(place log: MutableVector[List[int]], l: List[int]) -> int:
                log.push(l)
                l.length()

            fn f(xs: List[int]) -> List[List[int]]:
                log = std::mutable_vector::from_list([[0]])
                log.clear()
                last = fold x in xs with intermediate acc [1]:
                    n = keep(log, acc)
                    [x].append(n)
                snapshots = loop v in log:
                    v
                snapshots.append(last)

            f([5, 6])
    std::test::value("fvc-reject-retained-only", [[1], [5, 1], [6, 2]], t_reject_retained_only)

    fn t_reject_captured() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> List[int]:
                fs = fold x in xs with intermediate acc []:
                    fn size() -> int:
                        acc.length()
                    acc.append(size)
                loop g in fs:
                    g()

            f([1, 2, 3])
    std::test::value("fvc-reject-captured", [0, 1, 2], t_reject_captured)

    fn t_reject_inner_loop() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> List[List[int]]:
                fold x in xs with intermediate acc []:
                    ys = loop y in [1, 2]:
                        acc.length() + y
                    acc.append(ys)

            f([5, 6])
    std::test::value("fvc-reject-inner-loop", [[1, 2], [2, 3]], t_reject_inner_loop)

    fn t_reject_handler_continue() errors std::compiler::CompilerError:
        static compile:
            fn check(x: int) -> int errors FvcSkip:
                if x == 2:
                    fail FvcSkip
                x

            fn f(xs: List[int]) -> List[int]:
                fold x in xs with intermediate acc []:
                    y = acc.append(x)
                    z = check(x):
                        on FvcSkip:
                            continue
                    y

            f([1, 2, 3])
    std::test::value("fvc-reject-handler-continue", [1, 3], t_reject_handler_continue)

    fn t_reject_bare() errors std::compiler::CompilerError:
        static compile:
            fold with intermediate acc []:
                if acc.length() >= 3:
                    break
                acc.append(1)
    std::test::value("fvc-reject-bare", [1, 1, 1], t_reject_bare)

    fn t_scalar_and_struct_folds() errors std::compiler::CompilerError:
        static compile:
            fn total(xs: List[int]) -> int:
                fold x in xs with intermediate s 0:
                    s + x

            fn chunks(xs: List[int]) -> List[List[int]]:
                c = fold t in xs with intermediate st FvcChunks {done: [], current: []}:
                    if t == 0:
                        FvcChunks {done: st.done.append(st.current), current: []}
                    else:
                        FvcChunks {done: st.done, current: st.current.append(t)}
                c.done.append(c.current)

            [[total([1, 2, 3])], chunks([1, 2, 0, 3])]
    std::test::value("fvc-scalar-and-struct-folds", [[6], [[1, 2], [3]]], t_scalar_and_struct_folds)

with context std::test::suite()
register_fold_virtual_construction_tests()
std::test::report()
