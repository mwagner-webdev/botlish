                fold with intermediate s Scan2 {pos: 0, idents: 0}:
                    p = s.pos
                    if p < 0 or p >= std::str::length(text):
                        break
                    c = text.char_at(p)
                    v = std::char::scalar_value(c)
                    if v >= 48 and v <= 57:
                        num = text.number_at(p)
