# fold-virtual-struct-state.bot -- folds whose struct intermediate the
# native backends carry as independent field registers (FOLD-VIRTUAL-STRUCT-
# STATE-MILESTONE-1.md), as a source-level specification: a fold slot means
# exactly what the fold carrying one struct object means.
#
# * A normal completion replaces the whole intermediate at once (a
#   completion that permutes, repeats or keeps fields included), a
#   continue keeps the iteration's starting value, a bare break and
#   exhaustion yield it, an empty domain yields the initial value.
# * Nested folds keep their own intermediates; an error or a return leaves
#   the fold with nothing of a candidate committed; a yield suspends it.
# * Earlier versions stored or compared stay as they were; an intermediate
#   handed whole to an open call, compared, captured or shared keeps its
#   meaning whichever representation the compiler chooses; mutable fields
#   keep their copy convention (consumed, or copied at entry).
#
# Ported from tests/fold-virtual-struct-state.test, which stays
# authoritative and unchanged; a golden test keeps its Tcl test's name. What
# only the Tcl tests observe (the comparison with fold slots, reference
# joins and struct scalar replacement off, the fold-slot decisions, the
# census, NIR, allocation and copy counts, GC stress) stays there. This file
# is generated by audit/fold-virtual-struct-state/tools/golden-port.tcl from
# the Tcl tests' own programs and results.
import std::char
import std::compiler
import std::coroutine
import std::list
import std::mutable_vector
import std::str
import std::test

# Declarations the tests need (top-level only): one each, the same in every
# program that declares it.
struct Acc:
    count: int
    items: MutableVector[int]

struct Acc2:
    count: int
    evens: MutableVector[int]
    odds: MutableVector[int]

struct Bounded:
    total: Small

struct Box[T]:
    value: T
    count: int

struct Chunks:
    done: List[List[int]]
    current: List[int]

struct Inner:
    a: int
    b: int

struct Number:
    pos: int
    value: int

struct One:
    v: int

struct Outer:
    inner: Inner
    n: int

struct Outer2:
    inner: P
    n: int

struct P:
    a: int
    b: int

struct R:
    x: int
    y: int
    z: int

struct S:
    name: str
    items: List[int]
    count: int

struct Scan:
    pos: int
    idents: int
    ints: int
    sum: int
    depth: int
    deepest: int

struct Scan2:
    pos: int
    idents: int

struct Scan3:
    pos: int
    idents: int
    ints: int
    sum: int

type Small = Int in 0..1000

struct Step:
    f: Fn{args: [int], return: int}
    total: int

error Stop:
    at: int

error TooBig:
    at: int

struct W:
    f0: int
    f1: int
    f2: int
    f3: int
    f4: int
    f5: int
    f6: int
    f7: int
    f8: int
    f9: int
    f10: int
    f11: int
    f12: int
    f13: int
    f14: int
    f15: int
    f16: int
    f17: int
    f18: int
    f19: int

fn register_fold_virtual_struct_state_tests():
    fn t_scanner() errors std::compiler::CompilerError:
        static compile:
            fn ident_char?(c: UnicodeChar) -> bool:
                std::char::is_tcl_alpha(c) or c == '_'

            fn ident_end(text: str, start: int) -> int:
                fold with intermediate p start:
                    if p < 0 or p >= std::str::length(text):
                        break
                    if not ident_char?(text.char_at(p)):
                        break
                    p + 1

            fn line_end(text: str, start: int) -> int:
                fold with intermediate p start:
                    if p < 0 or p >= std::str::length(text):
                        break
                    if text.char_at(p) == '\n':
                        break
                    p + 1

            fn number_at(text: str, start: int) -> Number:
                fold with intermediate num Number {pos: start, value: 0}:
                    p = num.pos
                    if p < 0 or p >= std::str::length(text):
                        break
                    v = std::char::scalar_value(text.char_at(p))
                    if v < 48 or v > 57:
                        break
                    Number {pos: p + 1, value: num.value * 10 + v - 48}

            fn scan(text: str) -> Scan:
                fold with intermediate s Scan {pos: 0, idents: 0, ints: 0, sum: 0, depth: 0, deepest: 0}:
                    p = s.pos
                    if p < 0 or p >= std::str::length(text):
                        break
                    c = text.char_at(p)
                    v = std::char::scalar_value(c)
                    if v >= 48 and v <= 57:
                        num = text.number_at(p)
                        Scan {pos: num.pos, idents: s.idents, ints: s.ints + 1, sum: s.sum + num.value, depth: s.depth, deepest: s.deepest}
                    elif ident_char?(c):
                        Scan {pos: text.ident_end(p), idents: s.idents + 1, ints: s.ints, sum: s.sum, depth: s.depth, deepest: s.deepest}
                    elif c == '#':
                        Scan {pos: text.line_end(p), idents: s.idents, ints: s.ints, sum: s.sum, depth: s.depth, deepest: s.deepest}
                    elif c == '(':
                        d = s.depth + 1
                        deepest = if d > s.deepest:
                            d
                        else:
                            s.deepest
                        Scan {pos: p + 1, idents: s.idents, ints: s.ints, sum: s.sum, depth: d, deepest: deepest}
                    elif c == ')':
                        Scan {pos: p + 1, idents: s.idents, ints: s.ints, sum: s.sum, depth: s.depth - 1, deepest: s.deepest}
                    else:
                        Scan {pos: p + 1, idents: s.idents, ints: s.ints, sum: s.sum, depth: s.depth, deepest: s.deepest}

            text = "(define (square x) (mul x x)) # squares 12\nlet total_42 = 7 (plus 100 (minus 3 2))\n(define (cube y) (mul y (mul y y))) # 3 levels\nlet limit = 250 (max 9 (min 81 (abs 6)))\n(list 1 2 3) # done 999\n(sum (range 0 10) 600)\n"

            r = scan(text)
            [r.idents, r.ints, r.sum, r.deepest]
    std::test::value("fvs-scanner", [26, 15, 1116, 3], t_scanner)

    fn t_scanner_two() errors std::compiler::CompilerError:
        static compile:
            fn ident_char?(c: UnicodeChar) -> bool:
                std::char::is_tcl_alpha(c) or c == '_'

            fn ident_end(text: str, start: int) -> int:
                fold with intermediate p start:
                    if p < 0 or p >= std::str::length(text):
                        break
                    if not ident_char?(text.char_at(p)):
                        break
                    p + 1

            fn line_end(text: str, start: int) -> int:
                fold with intermediate p start:
                    if p < 0 or p >= std::str::length(text):
                        break
                    if text.char_at(p) == '\n':
                        break
                    p + 1

            fn number_at(text: str, start: int) -> Number:
                fold with intermediate num Number {pos: start, value: 0}:
                    p = num.pos
                    if p < 0 or p >= std::str::length(text):
                        break
                    v = std::char::scalar_value(text.char_at(p))
                    if v < 48 or v > 57:
                        break
                    Number {pos: p + 1, value: num.value * 10 + v - 48}

