                    Outer2 {inner: P {a: s.inner.a + i, b: s.inner.b + 1}, n: s.n + 1}

            o = run(10)
            [o.inner.a, o.inner.b, o.n]
    std::test::value("fvs-nested-closed", [45, 10, 10], t_nested_closed)

    fn t_mixed_descriptor() errors std::compiler::CompilerError:
