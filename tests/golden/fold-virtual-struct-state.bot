    fn t_chunks_m2_boundary() errors std::compiler::CompilerError:
        static compile:
            fn token(i: int) -> int:
                if i.mod(5) == 4:
                    return 0
                if i.mod(7) == 6:
                    return -i
                i

            fn chunks(tokens: List[int]) -> List[List[int]]:
                c = fold t in tokens with intermediate st Chunks {done: [], current: []}:
                    if t == 0:
                        if st.current == []:
                            st
                        else:
                            Chunks {done: st.done.append(st.current), current: []}
                    elif t < 0:
                        Chunks {done: st.done.append([t]).append([-t]), current: st.current}
                    else:
                        Chunks {done: st.done, current: st.current.append(t)}
                if c.current == []:
                    c.done
                else:
                    c.done.append(c.current)

            fn size(cs: List[List[int]]) -> int:
                fold c in cs with intermediate n 0:
                    n + c.length()

            fn total(cs: List[List[int]]) -> int:
                fold c in cs with intermediate s 0:
                    inner = fold x in c with intermediate t 0:
                        t + x
                    s + inner

            n = 256
            tokens = loop i from 0 to n:
                token(i)
            cs = chunks(tokens)
            [cs.length(), size(cs), total(cs)]
    std::test::value("fvs-chunks-m2-boundary", [110, 233, 22408], t_chunks_m2_boundary)

    fn t_exits() errors std::compiler::CompilerError:
        static compile:
            xs = [1, 2, 3, 4, 5, 6, 7, 8]

            # Every completion a literal of all fields.
            fn plain(xs: List[int]) -> P:
                fold x in xs with intermediate s P {a: 0, b: 1}:
                    P {a: s.a * 0, b: s.b + x}

            # `continue` before any successor is computed: the iteration keeps s.
            fn continue_first(xs: List[int]) -> P:
                fold x in xs with intermediate s P {a: 0, b: 1}:
                    if x.mod(3) == 0:
                        continue
                    P {a: s.a + x, b: s.b + 1}

            # A successor computed, then `continue`: the candidate is dropped and the
            # next iteration starts from s, not from n.
            fn continue_after_candidate(xs: List[int]) -> P:
                fold x in xs with intermediate s P {a: 0, b: 1}:
                    n = P {a: s.a + x, b: s.b + x}
                    if x.mod(2) == 0:
                        continue
                    n

            # A successor computed, then a bare `break`: the fold's value is s, the
            # iteration's starting value, not n.
            fn break_after_candidate(xs: List[int]) -> P:
                fold x in xs with intermediate s P {a: 0, b: 1}:
                    n = P {a: s.a + x, b: s.b * 2}
                    if x == 3:
                        break
                    n

            # Partial updates: one field rebuilt, one carried, on different branches.
            fn partial(xs: List[int]) -> P:
                fold x in xs with intermediate s P {a: 0, b: 0}:
                    if x.mod(2) == 0:
                        P {a: s.a + x * 2, b: s.b}
                    else:
                        P {a: s.a, b: s.b + 2}

            # The intermediate itself as one branch's completion.
            fn identity_branch(xs: List[int]) -> P:
                fold x in xs with intermediate s P {a: 0, b: 0}:
                    if x > 4:
                        s
                    else:
                        P {a: s.a + 1, b: s.b + x}

            # No domain: the fold ends on a field of its own intermediate.
            fn no_domain(limit: int) -> P:
                fold with intermediate s P {a: 0, b: 1}:
                    if s.a >= limit:
                        break
                    P {a: s.a + 3, b: s.b + 1}

            # A completion that swaps the fields (each field's next value reads the
            # other's old one: the field moves must not clobber).
            fn swap(xs: List[int]) -> P:
                fold x in xs with intermediate s P {a: 0, b: 1}:
                    P {a: s.b, b: s.a + x}

            # A completion that only permutes the fields: every source is a field of
            # the iteration's starting value, so the back edge is a parallel move (a
            # sequential one would overwrite `a` before `b` reads it: {1, 1}).
            fn swap_pure(xs: List[int]) -> P:
                fold x in xs with intermediate s P {a: 0, b: 1}:
                    P {a: s.b, b: s.a}

            # The successor built by a helper function: the completion is a call whose
            # result is a struct (a recognized result crosses as `retmulti` fields),
            # its argument the intermediate itself (a `fields` parameter).
            fn advance(s: P, x: int) -> P:
                P {a: s.a + x, b: s.b + 1}

            fn helper(xs: List[int]) -> P:
                fold x in xs with intermediate s P {a: 0, b: 0}:
                    advance(s, x)

            pairs = [plain(xs), continue_first(xs), continue_after_candidate(xs), break_after_candidate(xs), partial(xs), identity_branch(xs), no_domain(7), swap(xs), swap_pure([1, 2, 3]), helper(xs)]
            loop p in pairs:
                [p.a, p.b]
    std::test::value("fvs-exits", [[0, 37], [27, 7], [16, 17], [3, 4], [40, 8], [4, 10], [9, 4], [16, 21], [1, 0], [36, 8]], t_exits)

    fn t_swap_parallel() errors std::compiler::CompilerError:
        static compile:
            fn swap_pure(xs: List[int]) -> P:
                fold x in xs with intermediate s P {a: 0, b: 1}:
                    P {a: s.b, b: s.a}

            p = swap_pure([1, 2, 3])
            q = swap_pure([1, 2])
            [p.a, p.b, q.a, q.b]
    std::test::value("fvs-swap-parallel", [1, 0, 0, 1], t_swap_parallel)

    fn t_rotate_three() errors std::compiler::CompilerError:
        static compile:
            fn rotate(n: int) -> R:
                fold i from 0 to n with intermediate r R {x: 1, y: 2, z: 3}:
                    R {x: r.y, y: r.z, z: r.x}

            fn partial(n: int) -> R:
                fold i from 0 to n with intermediate r R {x: 1, y: 2, z: 3}:
                    R {x: r.y, y: r.x, z: r.z + i}

            fn repeated(n: int) -> R:
                fold i from 0 to n with intermediate r R {x: 1, y: 2, z: 3}:
                    R {x: r.z, y: r.z, z: r.x + r.y}

            fn conditional(n: int) -> R:
                fold i from 0 to n with intermediate r R {x: 1, y: 2, z: 3}:
                    if i.mod(2) == 0:
                        R {x: r.y, y: r.x, z: r.z}
                    else:
                        R {x: r.z, y: r.y, z: r.x}

            fn show(r: R) -> List[int]:
                [r.x, r.y, r.z]

            [show(rotate(4)), show(rotate(3)), show(partial(3)), show(repeated(3)), show(conditional(5))]
    std::test::value("fvs-rotate-three", [[2, 3, 1], [1, 2, 3], [2, 1, 6], [6, 6, 6], [3, 2, 1]], t_rotate_three)

    fn t_nested_permutations() errors std::compiler::CompilerError:
        static compile:
            fn grid(n: int) -> P:
                fold i from 0 to n with intermediate s P {a: 1, b: 2}:
                    t = fold j from 0 to 3 with intermediate u P {a: s.b, b: s.a}:
                        P {a: u.b, b: u.a + j}
                    P {a: t.b, b: t.a + i}

            g = grid(3)
            [g.a, g.b]
    std::test::value("fvs-nested-permutations", [8, 7], t_nested_permutations)

    fn t_empty_fold() errors std::compiler::CompilerError:
        static compile:
            fn none(xs: List[int]) -> P:
                fold x in xs with intermediate s P {a: 3, b: 4}:
                    P {a: s.a + x, b: s.b}

            fn counted(n: int) -> P:
                fold i from 0 to n with intermediate s P {a: 5, b: 6}:
                    P {a: s.a + i, b: s.b}

            e = none([])
            c = counted(0)
            [e.a, e.b, c.a, c.b]
    std::test::value("fvs-empty-fold", [3, 4, 5, 6], t_empty_fold)

    fn t_bare_fold() errors std::compiler::CompilerError:
        static compile:
            fn until(limit: int) -> P:
                fold with intermediate s P {a: 0, b: 1}:
                    if s.a >= limit:
                        break
                    P {a: s.a + 3, b: s.b * 2}

            u = until(10)
            [u.a, u.b]
    std::test::value("fvs-bare-fold", [12, 16], t_bare_fold)

    fn t_break_candidate() errors std::compiler::CompilerError:
        static compile:
            fn stop(xs: List[int]) -> P:
                fold x in xs with intermediate s P {a: 0, b: 1}:
                    n = P {a: s.a + x, b: s.b * 2}
                    if x == 3:
                        break
                    n

            fn skip(xs: List[int]) -> P:
                fold x in xs with intermediate s P {a: 0, b: 1}:
                    n = P {a: s.a + x, b: s.b * 2}
                    if x.mod(2) == 0:
                        continue
                    n

            b = stop([1, 2, 3, 4])
            c = skip([1, 2, 3, 4, 5])
            [b.a, b.b, c.a, c.b]
    std::test::value("fvs-break-candidate", [3, 4, 9, 8], t_break_candidate)

    fn t_early_return() errors std::compiler::CompilerError:
        static compile:
            fn early(xs: List[int]) -> P:
                fold x in xs with intermediate s P {a: 0, b: 0}:
                    if x == 4:
                        return s
                    P {a: s.a + x, b: s.b + 1}

            e = early([1, 2, 3, 4, 5])
            f = early([1, 2])
            [e.a, e.b, f.a, f.b]
    std::test::value("fvs-early-return", [6, 3, 3, 2], t_early_return)

    fn t_errors() errors std::compiler::CompilerError:
        static compile:
            xs = [1, 2, 3, 4, 5]

            fn check(x: int) -> int errors TooBig:
                if x > 3:
                    fail TooBig {at: x}
                x

            # Raised after the candidate: the fold has no value; the caller's handler
            # reports where.
            fn raised(xs: List[int]) -> List[int] errors TooBig:
                t = fold x in xs with intermediate s P {a: 0, b: 0}:
                    n = P {a: s.a + x, b: s.b + 1}
                    c = check(x)
                    P {a: n.a + c * 0, b: n.b}
                [t.a, t.b]

            fn caught(xs: List[int]) -> List[int]:
                r = raised(xs):
                    on TooBig {at}:
                        return [-1, at - 1]
                r

            # Handled inside the body: the handler's value completes the iteration.
            fn handled(xs: List[int]) -> List[int]:
                t = fold x in xs with intermediate s P {a: 0, b: 0}:
                    c = check(x):
                        on TooBig:
                            0
                    P {a: s.a + c * 2, b: s.b + 1}
                [t.a, t.b]

            # A callee fails on some iterations; those iterations keep s through a
            # handler that continues.
            fn skipped(xs: List[int]) -> List[int]:
                t = fold x in xs with intermediate s P {a: 1, b: 0}:
                    n = P {a: s.a + x, b: s.b + 1}
                    c = check(x):
                        on TooBig:
                            continue
                    P {a: n.a, b: n.b + c * 0}
                [t.a, t.b]

            [caught(xs), handled(xs), skipped(xs)]
    std::test::value("fvs-errors", [[-1, 3], [12, 5], [7, 3]], t_errors)

    fn t_error_escapes() errors std::compiler::CompilerError:
        static compile:
            fn step(x: int) -> int errors Stop:
                if x > 2:
                    fail Stop {at: x}
                x

            fn run(xs: List[int]) -> P errors Stop:
                fold x in xs with intermediate s P {a: 0, b: 0}:
                    n = P {a: s.a + x, b: s.b + 1}
                    P {a: n.a + step(x), b: n.b}

            fn guarded(xs: List[int]) -> P:
                r = run(xs):
                    on Stop {at}:
                        P {a: -1, b: at}
                r

            r = guarded([1, 2, 3])
            q = guarded([1, 2])
            [r.a, r.b, q.a, q.b]
    std::test::value("fvs-error-escapes", [-1, 3, 6, 2], t_error_escapes)

    fn t_nested() errors std::compiler::CompilerError:
        static compile:
            xs = [1, 2, 3]

            # The inner fold starts from the outer intermediate; its value is the
            # outer's next intermediate.
            fn seeded(xs: List[int]) -> P:
                fold x in xs with intermediate s P {a: 0, b: 0}:
                    fold y in [x, 1] with intermediate t s:
                        P {a: t.a + y, b: t.b + 1 + 0 * y}

            # The inner fold starts from one field of the outer intermediate.
            fn field_seeded(xs: List[int]) -> P:
                fold x in xs with intermediate s P {a: 1, b: 0}:
                    a = fold y in [x, x] with intermediate u s.a:
                        u + y - x + 1
                    P {a: a + 1, b: s.b + 1}

            # The intermediate read in an inner collecting loop's body.
            fn inner_loop(xs: List[int]) -> P:
                fold x in xs with intermediate s P {a: 0, b: 0}:
                    ys = loop y in [1, 1]:
                        s.a + y
                    P {a: s.a + 1 + 0 * ys.length(), b: s.b + ys.length() * 2}

            # A struct-valued fold as the function's result.
            fn digits(text: List[int]) -> P:
                fold d in text with intermediate n P {a: 0, b: 0}:
                    P {a: n.a * 10 + d, b: n.b + 1}

            sd = seeded(xs)
            fs = field_seeded(xs)
            il = inner_loop(xs)
            dg = digits(xs)
            [[sd.a, sd.b], [fs.a, fs.b], [il.a, il.b], [dg.a, dg.b]]
    std::test::value("fvs-nested", [[9, 6], [10, 3], [3, 12], [123, 3]], t_nested)

    fn t_coroutine() errors std::compiler::CompilerError:
        static compile:
            fn running(xs: List[int]) -> List[int]:
                t = fold x in xs with intermediate s P {a: 0, b: 0}:
                    yield [x * 10 + s.b]
                    P {a: s.a + x, b: s.b + 1}
                [t.a, t.b]

            fn drive() -> List[List[int]]:
                coroutine {step, first} = running([1, 2, 3])
                a = step()
                b = step()
                c = step()
                [first, a, b, c]

            drive()
    std::test::value("fvs-coroutine", [[10], [21], [32], [6, 3]], t_coroutine)

    fn t_gc_stress() errors std::compiler::CompilerError:
        static compile:
            fn build(n: int) -> S:
                fold i from 0 to n with intermediate s S {name: "", items: [], count: 0}:
                    if i.mod(3) == 0:
                        s
                    else:
                        S {name: std::str::concat(s.name, "x"), items: s.items.append(i), count: s.count + 1}

            r = build(40)
            [std::str::length(r.name), r.items.length(), r.count]
    std::test::value("fvs-gc-stress", [26, 26, 26], t_gc_stress)

    fn t_affine_body() errors std::compiler::CompilerError:
        static compile:
            fn gen() -> int:
                yield 1
                yield 2
                0

            fn run(n: int) -> P:
                fold i from 0 to n with intermediate s P {a: 0, b: 0}:
                    coroutine {step, first} = gen()
                    P {a: s.a + first, b: s.b + 1}

            r = run(5)
            [r.a, r.b]
    std::test::value("fvs-affine-body", [5, 5], t_affine_body)

    fn t_observe() errors std::compiler::CompilerError:
        static compile:
            xs = [1, 2, 3, 4]

            # Every earlier version stored in a List built beside the fold (storage).
            fn history(xs: List[int]) -> List[int]:
                t = fold x in xs with intermediate s {p: P {a: 0, b: 0}, seen: []}:
                    n = P {a: s.p.a + x, b: s.p.b + 1}
                    {p: n, seen: s.seen.append(n)}
                loop q in t.seen:
                    q.a

            # Two versions observable in one record: the old one and its successor.
            fn both_versions(xs: List[int]) -> List[int]:
                r = fold x in xs with intermediate s {old: P {a: 0, b: 0}, new: P {a: 0, b: 0}}:
                    {old: s.new, new: P {a: s.new.a + x, b: s.new.b + x}}
                [r.old.a, r.new.b]

            # Passed whole to an exact function and to a function value (open call).
            fn weight(p: P) -> int:
                p.a + p.b

            fn calls(xs: List[int]) -> List[int]:
                f = weight
                t = fold x in xs with intermediate s P {a: 0, b: 0}:
                    w = weight(s) + f(s)
                    P {a: s.a + x, b: w.mod(5)}
                [t.a, t.b]

            # Captured by a function made in the body, called after the fold.
            fn captured(xs: List[int]) -> int:
                t = fold x in xs with intermediate s {p: P {a: 0, b: 0}, last: 0}:
                    fn g() -> int:
                        s.p.a + x
                    {p: P {a: g(), b: 0}, last: g()}
                t.last

            # Returned from the enclosing function in the middle of the fold.
            fn early(xs: List[int]) -> P:
                fold x in xs with intermediate s P {a: 0, b: 0}:
                    if x == 4:
                        return s
                    P {a: s.a + x, b: s.b + 1}

            # Compared whole (structural equality needs the object).
            fn compared(xs: List[int]) -> P:
                fold x in xs with intermediate s P {a: 1, b: 1}:
                    if s == P {a: 3, b: 3}:
                        s
                    else:
                        P {a: s.a + 1, b: s.b + 1}

            # Hand-written field state: the struct only built at the end (the
            # reference the fold's field registers would equal).
            fn fields_only(xs: List[int]) -> P:
                t = fold x in xs with intermediate s P {a: 0, b: 0}:
                    P {a: s.a + 1, b: s.b + x}
                t

            # The intermediate passed to an exact callee whose parameter takes fields.
            fn first(p: P) -> int:
                p.a

            fn exact(xs: List[int]) -> int:
                t = fold x in xs with intermediate s P {a: 0, b: 0}:
                    P {a: first(s) + 0 * x, b: s.b}
                t.a + 2

            e = early(xs)
            c = compared(xs)
            fo = fields_only(xs)
            [history(xs), both_versions(xs), calls(xs), captured(xs), [e.a, e.b], [c.a, c.b], [fo.a, fo.b], exact(xs)]
    std::test::value("fvs-observe", [[1, 3, 6, 10], [6, 10], [10, 2], 10, [6, 3], [3, 3], [4, 10], 2], t_observe)

    fn t_history_independent() errors std::compiler::CompilerError:
        static compile:
            fn history(n: int) -> List[P]:
                t = fold i from 0 to n with intermediate s {p: P {a: 0, b: 0}, seen: []}:
                    {p: P {a: s.p.a + i, b: s.p.b + 1}, seen: s.seen.append(s.p)}
                t.seen

            hs = history(4)
            loop h in hs:
                [h.a, h.b]
    std::test::value("fvs-history-independent", [[0, 0], [0, 1], [1, 2], [3, 3]], t_history_independent)

    fn t_no_loss_open_call() errors std::compiler::CompilerError:
        static compile:
            fn weight(p: P) -> int:
                p.a + p.b

            fn heavy(p: P) -> int:
                p.a * p.b

            fn run(n: int, k: int) -> P:
                f = if k > 0:
                    weight
                else:
                    heavy
                fold i from 0 to n with intermediate s P {a: 0, b: 1}:
                    w = f(s)
                    if w > 1000 * 1000:
                        P {a: s.a, b: 1}
                    elif i == n - 1:
                        P {a: s.a + 1, b: s.b + i}
                    else:
                        s

            r = run(512, 1)
            [r.a, r.b, weight(r) - 1]
    std::test::value("fvs-no-loss-open-call", [1, 512, 512], t_no_loss_open_call)

    fn t_no_loss_continue() errors std::compiler::CompilerError:
        static compile:
            fn run(xs: List[int]) -> List[P]:
                t = fold x in xs with intermediate s {p: P {a: 0, b: 0}, seen: []}:
                    q = s.p
                    if x.mod(2) == 0:
                        continue
                    {p: P {a: q.a + x, b: q.b + 1}, seen: s.seen.append(q)}
                t.seen

            fn run2(xs: List[int]) -> P:
                keep = [P {a: 0, b: 0}]
                fold x in xs with intermediate s P {a: 0, b: 0}:
                    if s == P {a: 9, b: 9}:
                        continue
                    P {a: s.a + x, b: s.b + 1}

            r = run([1, 2, 3])
            r2 = run2([1, 2])
            [r.length(), r2.a, r2.b]
    std::test::value("fvs-no-loss-continue", [2, 3, 2], t_no_loss_continue)

    fn t_no_loss_constructing_path() errors std::compiler::CompilerError:
        static compile:
            fn record(n: int) -> List[P]:
                t = fold i from 0 to n with intermediate s {p: P {a: 0, b: 0}, log: []}:
                    if i.mod(2) == 0:
                        {p: P {a: s.p.a + i, b: s.p.b}, log: s.log.append(s.p)}
                    else:
                        s
                t.log

            record(5).length()
    std::test::value("fvs-no-loss-constructing-path", 3, t_no_loss_constructing_path)

    fn t_no_loss_return() errors std::compiler::CompilerError:
        static compile:
            fn early(xs: List[int]) -> P:
                fold x in xs with intermediate s P {a: 0, b: 0}:
                    if x == 4:
                        return s
                    if x.mod(2) == 0:
                        s
                    else:
                        P {a: s.a + x, b: s.b + 1}

            fn late(xs: List[int]) -> P:
                fold x in xs with intermediate s P {a: 0, b: 0}:
                    if x == 9:
                        return s
                    t = s == P {a: 4, b: 2}
                    if t:
                        s
                    else:
                        P {a: s.a + x, b: s.b + 1}

            e = early([1, 2, 3, 4, 5])
            f = early([1, 2, 3])
            g = late([1, 2, 3, 5])
            [e.a, e.b, f.a, f.b, g.a, g.b]
    std::test::value("fvs-no-loss-return", [4, 2, 4, 2, 11, 4], t_no_loss_return)

    fn t_source_falls() errors std::compiler::CompilerError:
        static compile:
            fn run(xs: List[int]) -> P:
                fold x in xs with intermediate s P {a: 0, b: 0}:
                    n = P {a: s.a + x, b: s.b + 1}
                    ws = loop y in [1, 2]:
                        [n, n].length() + y
                    if x > 100:
                        P {a: ws.length(), b: 0}
                    else:
                        n

            r = run([1, 2, 3])
            [r.a, r.b]
    std::test::value("fvs-source-falls", [6, 3], t_source_falls)

    fn t_param_initial() errors std::compiler::CompilerError:
        static compile:
            fn run(p: P, n: int) -> P:
                fold i from 0 to n with intermediate s p:
                    P {a: s.a + i, b: s.b + 1}

            fn twice(n: int) -> P:
                run(P {a: n, b: n}, n)

            r = twice(4)
            [r.a, r.b]
    std::test::value("fvs-param-initial", [10, 8], t_param_initial)

    fn t_unrecognized_completion() errors std::compiler::CompilerError:
        static compile:
            fn step(p: P) -> P:
                P {a: p.b, b: p.a + 1}

            fn back(p: P) -> P:
                P {a: p.a + 1, b: p.b}

            fn run(n: int, k: int) -> P:
                g = if k > 0:
                    step
                else:
                    back
                fold i from 0 to n with intermediate s P {a: 0, b: 0}:
                    g(s)

            r = run(5, 1)
            [r.a, r.b]
    std::test::value("fvs-unrecognized-completion", [2, 3], t_unrecognized_completion)

    fn t_exact_call() errors std::compiler::CompilerError:
        static compile:
            fn weight(p: P) -> int:
                p.a + p.b

            fn run(n: int) -> P:
                fold i from 0 to n with intermediate s P {a: 0, b: 1}:
                    if weight(s) > 1000:
                        s
                    else:
                        P {a: s.a + 1, b: s.b + i}

            r = run(100)
            [r.a, r.b]
    std::test::value("fvs-exact-call", [45, 991], t_exact_call)

    fn t_exact_call_nested_result() errors std::compiler::CompilerError:
        static compile:
            fn start(k: int) -> Outer:
                Outer {inner: Inner {a: k, b: k + 1}, n: 0}

            fn step(o: Outer, i: int) -> Outer:
                Outer {inner: Inner {a: o.inner.b, b: o.inner.a + i}, n: o.n + 1}

            fn run(n: int) -> int:
                t = fold i from 0 to n with intermediate s start(3):
                    step(s, i)
                t.inner.a * 10000 + t.inner.b * 100 + t.n

            run(10)
    std::test::value("fvs-exact-call-nested-result", 232910, t_exact_call_nested_result)

