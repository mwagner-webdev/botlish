    fn t_wide() errors std::compiler::CompilerError:
        static compile:
            fn run(n: int) -> int:
                w = fold i from 0 to n with intermediate s W {f0: 0, f1: 0, f2: 0, f3: 0, f4: 0, f5: 0, f6: 0, f7: 0, f8: 0, f9: 0, f10: 0, f11: 0, f12: 0, f13: 0, f14: 0, f15: 0, f16: 0, f17: 0, f18: 0, f19: 0}:
                    W {f0: s.f0 + 1, f1: s.f1 + 1, f2: s.f2 + 1, f3: s.f3 + 1, f4: s.f4 + 1, f5: s.f5 + 1, f6: s.f6 + 1, f7: s.f7 + 1, f8: s.f8 + 1, f9: s.f9 + 1, f10: s.f10 + 1, f11: s.f11 + 1, f12: s.f12 + 1, f13: s.f13 + 1, f14: s.f14 + 1, f15: s.f15 + 1, f16: s.f16 + 1, f17: s.f17 + 1, f18: s.f18 + 1, f19: s.f19 + 1}
                w.f0 + w.f19

            run(10)
