    fn t_consumed_vector() errors std::compiler::CompilerError:
        static compile:
            fn ints() -> MutableVector[int]:
                std::mutable_vector::from_list([])

            fn total(v: MutableVector[int]) -> int:
                fold i from 0 to v.length() with intermediate t 0:
                    t + v.at(i)


            fn build(n: int) -> Acc:
                fold i from 0 to n with intermediate a Acc {count: 0, items: ints()}:
                    a.items.push(i)
                    Acc {count: a.count + 1, items: a.items}

            r = build(100)
            [r.count, r.items.length(), total(r.items)]
    std::test::value("fvs-consumed-vector", [100, 100, 4950], t_consumed_vector)

    fn t_copying_share() errors std::compiler::CompilerError:
        static compile:
            fn ints() -> MutableVector[int]:
                std::mutable_vector::from_list([])

            fn total(v: MutableVector[int]) -> int:
                fold i from 0 to v.length() with intermediate t 0:
                    t + v.at(i)


            fn build(n: int) -> Acc:
                fold i from 0 to n with intermediate a Acc {count: 0, items: ints()}:
                    a.items.push(i)
                    if i.mod(3) != 0:
                        continue
                    Acc {count: a.count + 1, items: a.items}

            r = build(60)
            [r.count, r.items.length(), total(r.items)]
    std::test::value("fvs-copying-share", [20, 20, 570], t_copying_share)

    fn t_two_vectors() errors std::compiler::CompilerError:
        static compile:
            fn ints() -> MutableVector[int]:
                std::mutable_vector::from_list([])

            fn build(n: int) -> Acc2:
                fold i from 0 to n with intermediate a Acc2 {count: 0, evens: ints(), odds: ints()}:
                    if i.mod(2) == 0:
                        a.evens.push(i)
                    else:
                        a.odds.push(i)
                    Acc2 {count: a.count + 1, evens: a.evens, odds: a.odds}

            fn total(v: MutableVector[int]) -> int:
                fold i from 0 to v.length() with intermediate s 0:
                    s + v.at(i)

            n = 200
            r = build(n)
            [r.count, r.evens.length(), r.odds.length(), total(r.evens)]
    std::test::value("fvs-two-vectors", [200, 100, 100, 9900], t_two_vectors)

    fn t_ref_join_local() errors std::compiler::CompilerError:
        static compile:
            fn pick(x: int) -> int:
                q = P {a: x, b: x + 1}
                p = if x > 2:
                    q
                else:
                    P {a: 1, b: x}
                p.a * p.b + q.b

            [pick(3), pick(1)]
    std::test::value("fvs-ref-join-local", [16, 3], t_ref_join_local)

    fn t_ref_join_materialized_source() errors std::compiler::CompilerError:
        static compile:
            fn pick(x: int, keep: List[P]) -> int:
                q = P {a: x, b: x + 1}
                k = keep.append(q)
                p = if x > 2:
                    q
                else:
                    P {a: 1, b: x}
                p.a * p.b + k.length()

            [pick(3, []), pick(1, [])]
    std::test::value("fvs-ref-join-materialized-source", [13, 2], t_ref_join_materialized_source)

