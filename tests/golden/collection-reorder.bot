# ---------------------------------------------------------------------------
# Value semantics

fn register_reorder_value_tests():
    # a copy reorders independently: a binding, a chain of copies, a struct field, a List element, a function argument and result
    fn b_cr_copies_independent() errors std::compiler::CompilerError:
        static compile:
            fn rev(m: std::mutable_map::MutableMap[int, int]) -> std::mutable_map::MutableMap[int, int]:
                n = m
                ok = reorder_to(n, [3, 2, 1])
                n
            a = int_map([1, 2, 3])
            b = a
            c = b
            ok1 = reorder_to(b, [2, 3, 1])
            box = ReorderCopyBox {m: a}
            xs = [a]
            r = rev(a)
            ok2 = reorder_to(c, [3, 1, 2])
            ok3 = reorder_to(a, [1, 3, 2])
            x0 = std::list::at(xs, 0):
                on IndexNotFound:
                    int_map([])
            [pairs(a), pairs(b), pairs(c), pairs(box.m), pairs(x0), pairs(r)]
    std::test::value("cr-copies-independent", [[[1, 10], [3, 30], [2, 20]], [[2, 20], [3, 30], [1, 10]], [[3, 30], [1, 10], [2, 20]], [[1, 10], [2, 20], [3, 30]], [[1, 10], [2, 20], [3, 30]], [[3, 30], [2, 20], [1, 10]]], b_cr_copies_independent)

    # a reordered copy and its original stay separate through later growth, removal and clear of either
    fn b_cr_copy_then_reorder_then_mutate() errors std::compiler::CompilerError:
        static compile:
            a = int_map([1, 2, 3, 4])
            b = a
            ok = reorder_to(b, [4, 3, 2, 1])
            loop i from 10 to 40:
                a.set(i, i)
            r = b.remove(3):
                on std::mutable_map::KeyNotFound:
                    0
            c = b
            b.clear()
            [a.length(), pairs(c), b.length()]
    std::test::value("cr-copy-then-reorder-then-mutate", [34, [[4, 40], [2, 20], [1, 10]], 0], b_cr_copy_then_reorder_then_mutate)

    # s.reorder(s) is a no-op reorder, and so are the forms through a struct field
    fn b_cr_observer_overlap() errors std::compiler::CompilerError:
        static compile:
            s = set_of([3, 1, 2])
            s.reorder(s)
            w = ReorderSetBox {s: set_of([5, 4])}
            w.s.reorder(w.s)
            w.s.reorder(w.s.order())
            [elems(s), elems(w.s)]
    std::test::value("cr-observer-overlap", [[3, 1, 2], [5, 4]], b_cr_observer_overlap)

    # a loop over a collection it reorders iterates the collection as it was when the loop began
    fn b_cr_iteration_snapshot() errors std::compiler::CompilerError:
        static compile:
            m = int_map([1, 2, 3])
            seen = loop e in m:
                if e.key == 1:
                    ok = reorder_to(m, [3, 2, 1])
                e.key
            s = set_of([1, 2, 3])
            seen2 = loop x in s:
                ok = reorder_set_to(s, [2, 3, 1])
                x
            [seen, pairs(m), seen2, elems(s)]
    std::test::value("cr-iteration-snapshot", [[1, 2, 3], [[3, 30], [2, 20], [1, 10]], [1, 2, 3], [2, 3, 1]], b_cr_iteration_snapshot)

# ---------------------------------------------------------------------------

fn register_collection_reorder_tests():
    register_reorder_semantics_tests()
    register_reorder_proof_tests()
    register_reorder_value_tests()

with context std::test::suite()
register_collection_reorder_tests()
std::test::report()
