# collection-reorder.bot -- proven reordering of std::mutable_map::MutableMap
# and std::mutable_set::MutableSet (PROVEN-COLLECTION-REORDERING.md), ported
# from tests/collection-reorder.test.
#
# * `m.reorder(order)` changes the iteration order and nothing else: every
#   key keeps its stored key and its value, length and lookups are
#   unchanged; ORDER is a MutableSet holding exactly the collection's
#   members. `m.order()` is the current order, `m.validate_order(c)` checks
#   a candidate once (the declared error OrderMismatch otherwise) and
#   reorders nothing. Copies reorder independently; a loop iterates the
#   collection as it was when it began.
# * The compiler admits a reorder only where it knows the order's members
#   are the collection's (REORDER-NOT-PROVEN, ReorderNotProven here): from
#   order(), validate_order or a copy; a change to either value's members
#   loses it, reads and reorders keep it, a join keeps it only when every
#   completing path does, and nothing crosses a function boundary. Each
#   proof case is a block of its own: a rejection pins the first unproven
#   reorder of its block (rejects_at); an admitted program compiles and runs.
#
# What a Botlish program cannot observe stays in tests/collection-reorder.test
# and tests/ordered-table.test: the hidden hash key's independence across
# fixed keys, injected collisions of the stored hash (a private library),
# the native facts (no keyed hash, allocations), the HIR facts (which
# function a method call is, what a reorder can reach), the absence of a
# cascade after a type error, and the representation's invariants.

import std::compiler
import std::list
import std::str
import std::mutable_map
import std::mutable_set
import std::test

# ---------------------------------------------------------------------------
# Declarations the tests need (top-level only).

# crDecls: reading a collection out as Lists, building one, reordering one
# by a validated List.
fn pairs(m: std::mutable_map::MutableMap[int, int]) -> List[List[int]]:
    loop e in m:
        [e.key, e.value]

fn names(m: std::mutable_map::MutableMap[str, int]) -> List[str]:
    loop e in m:
        e.key

fn elems(s: std::mutable_set::MutableSet[int]) -> List[int]:
    loop x in s:
        x

fn set_of(xs: List[int]) -> std::mutable_set::MutableSet[int]:
    s = std::mutable_set::create[int]()
    loop x in xs:
        s.add(x)
    s

fn str_set(xs: List[str]) -> std::mutable_set::MutableSet[str]:
    s = std::mutable_set::create[str]()
    loop x in xs:
        s.add(x)
    s

fn int_map(xs: List[int]) -> std::mutable_map::MutableMap[int, int]:
    m = std::mutable_map::create[int, int]()
    loop x in xs:
        m.set(x, x * 10)
    m

fn reorder_to(place m: std::mutable_map::MutableMap[int, int], xs: List[int]) -> bool:
    o = m.validate_order(set_of(xs)):
        on std::mutable_map::OrderMismatch:
            return false
    m.reorder(o)
    true

fn reorder_set_to(place s: std::mutable_set::MutableSet[int], xs: List[int]) -> bool:
    o = s.validate_order(set_of(xs)):
        on std::mutable_set::OrderMismatch:
            return false
    s.reorder(o)
    true

# cr-proof-membership-changes/struct-place-call: a struct holding a map (Box
# in the Tcl program).
struct ReorderMapBox:
    m: std::mutable_map::MutableMap[int, int]

# cr-proof-copies/struct-copy: a map and an order in one struct (Box).
struct ReorderPair:
    m: std::mutable_map::MutableMap[int, int]
    o: std::mutable_set::MutableSet[int]

# cr-copies-independent: a struct holding a map (Box).
struct ReorderCopyBox:
    m: std::mutable_map::MutableMap[int, int]

# cr-observer-overlap: a struct holding a set (W).
struct ReorderSetBox:
    s: std::mutable_set::MutableSet[int]

# cr-proof-membership-changes/context and context-reader,
# cr-proof-order-only-and-reads-preserve/context-member: a context holding
# a map (Store).
context struct ReorderStore:
    m: std::mutable_map::MutableMap[int, int]

# ---------------------------------------------------------------------------
# Semantics and validation

fn register_reorder_semantics_tests():
    # a map reordered iterates in the order's order; every key keeps its value, and the length, membership and lookups are unchanged
    fn b_cr_map_reorder() errors std::compiler::CompilerError:
        static compile:
            m = int_map([1, 2, 3, 4, 5])
            ok = reorder_to(m, [3, 1, 5, 2, 4])
            v = m.at(5):
                on std::mutable_map::KeyNotFound:
                    -1
            [ok, pairs(m), m.length(), m.contains(2), m.contains(9), v]
    std::test::value("cr-map-reorder", [true, [[3, 30], [1, 10], [5, 50], [2, 20], [4, 40]], 5, true, false, 50], b_cr_map_reorder)

    # values move with their keys through a reorder after replacement, removal and reinsertion (dead entries)
    fn b_cr_map_values_aligned() errors std::compiler::CompilerError:
        static compile:
            m = int_map([10, 11, 12, 13, 14, 15, 16])
            m.set(12, -12)
            r = m.remove(11):
                on std::mutable_map::KeyNotFound:
                    0
            r2 = m.remove(14):
                on std::mutable_map::KeyNotFound:
                    0
            m.set(11, -11)
            ok = reorder_to(m, [16, 11, 10, 15, 13, 12])
            found = loop k in [10, 11, 12, 13, 15, 16]:
                m.at(k):
                    on std::mutable_map::KeyNotFound:
                        0
            [ok, pairs(m), found]
    std::test::value("cr-map-values-aligned", [true, [[16, 160], [11, -11], [10, 100], [15, 150], [13, 130], [12, -12]], [100, -11, -12, 130, 150, 160]], b_cr_map_values_aligned)

    # String keys: reordered by a candidate built independently (equal Strings), each value still found by its key
    fn b_cr_map_string_keys() errors std::compiler::CompilerError:
        static compile:
            m = std::mutable_map::create[str, int]()
            loop k in ["pear", "fig", "kiwi", "date"]:
                m.set(k, std::str::length(k))
            o = m.validate_order(str_set([std::str::concat("da", "te"), "kiwi", "pear", "fig"])):
                on std::mutable_map::OrderMismatch:
                    m.order()
            m.reorder(o)
            lens = loop k in names(m):
                m.at(k):
                    on std::mutable_map::KeyNotFound:
                        -1
            [names(m), lens]
    std::test::value("cr-map-string-keys", [["date", "kiwi", "pear", "fig"], [4, 4, 4, 3]], b_cr_map_string_keys)

    # a set reordered iterates in the order's order with the same members
    fn b_cr_set_reorder() errors std::compiler::CompilerError:
        static compile:
            s = set_of([4, 8, 15, 16, 23, 42])
            ok = reorder_set_to(s, [42, 4, 23, 8, 16, 15])
            [ok, elems(s), s.length(), s.contains(15), s.contains(7)]
    std::test::value("cr-set-reorder", [true, [42, 4, 23, 8, 16, 15], 6, true, false], b_cr_set_reorder)

    # empty by empty and singleton by itself; an empty candidate for a non-empty collection and a non-empty one for an empty collection are mismatches
    fn b_cr_empty_and_singleton() errors std::compiler::CompilerError:
        static compile:
            e = int_map([])
            one = int_map([7])
            s = set_of([])
            a = [reorder_to(e, []), pairs(e)]
            b = [reorder_to(one, [7]), pairs(one)]
            c = [reorder_set_to(s, []), elems(s)]
            d = [reorder_to(one, []), reorder_to(e, [7]), reorder_set_to(s, [1]), pairs(one), pairs(e)]
            [a, b, c, d]
    std::test::value("cr-empty-and-singleton", [[true, []], [true, [[7, 70]]], [true, []], [false, false, false, [[7, 70]], []]], b_cr_empty_and_singleton)

    # reordering to the current order changes nothing observable, also after removals and reinsertions
    fn b_cr_current_order() errors std::compiler::CompilerError:
        static compile:
            m = int_map([5, 3, 9, 1])
            o = m.order()
            m.reorder(o)
            a = pairs(m)
            m.reorder(m.order())
            loop k in [2, 4, 6, 8, 10, 12, 14, 16, 18]:
                m.set(k, k)
            loop k in [3, 4, 8, 12, 16]:
                r = m.remove(k):
                    on std::mutable_map::KeyNotFound:
                        0
            m.set(3, 33)
            b = pairs(m)
            m.reorder(m.order())
            s = set_of([7, 1, 4, 9, 2])
            r2 = s.remove(1)
            r3 = s.remove(9)
            s.add(1)
            s.reorder(s.order())
            [a, pairs(m), b == pairs(m), elems(s)]
    std::test::value("cr-current-order", [[[5, 50], [3, 30], [9, 90], [1, 10]], [[5, 50], [9, 90], [1, 10], [2, 2], [6, 6], [10, 10], [14, 14], [18, 18], [3, 33]], true, [7, 4, 2, 1]], b_cr_current_order)

    # 300 keys grown, a third removed, reversed by an order built in any way: exactly the survivors, reversed, their values kept
    fn b_cr_reverse_after_churn() errors std::compiler::CompilerError:
        static compile:
            m = int_map([])
            loop i from 0 to 300:
                m.set(i * 7, i)
            loop i from 0 to 300:
                if i.mod(3) == 1:
                    r = m.remove(i * 7):
                        on std::mutable_map::KeyNotFound:
                            -1
            ks = loop e in m:
                e.key
            rev = loop i from 0 to std::list::length(ks):
                std::list::at(ks, std::list::length(ks) - 1 - i):
                    on IndexNotFound:
                        -1
            ok = reorder_to(m, rev)
            after = loop e in m:
                e.key
            vals = loop e in m:
                if e.value * 7 != e.key:
                    continue
                e.value
            [ok, after == rev, std::list::length(vals), m.length()]
    std::test::value("cr-reverse-after-churn", [true, true, 200, 200], b_cr_reverse_after_churn)

    # m.order() is a MutableSet of exactly m's keys in m's order and a value of its own; s.order() is a copy of s
    fn b_cr_order_snapshot() errors std::compiler::CompilerError:
        static compile:
            m = int_map([3, 1, 2])
            r = m.remove(1):
                on std::mutable_map::KeyNotFound:
                    0
            m.set(1, 0)
            o = m.order()
            s = set_of([9, 8])
            p = s.order()
            a = [elems(o), o.length(), o.contains(3), o.contains(4), elems(p)]
            loop k from 10 to 30:
                m.set(k, k)
            r2 = m.remove(3):
                on std::mutable_map::KeyNotFound:
                    0
            q = m.order()
            q.add(99)
            q.clear()
            s.add(7)
            [a, elems(o), m.length(), m.contains(99), elems(p)]
    std::test::value("cr-order-snapshot", [[[3, 2, 1], 3, true, false, [9, 8]], [3, 2, 1], 22, false, [9, 8]], b_cr_order_snapshot)

    # after a reorder the ordinary rules hold in the new order
    fn b_cr_later_operations() errors std::compiler::CompilerError:
        static compile:
            m = int_map([1, 2, 3, 4])
            ok = reorder_to(m, [4, 2, 3, 1])
            m.set(9, 90)
            m.set(2, 22)
            r = m.remove(3):
                on std::mutable_map::KeyNotFound:
                    0
            m.set(3, 33)
            a = pairs(m)
            loop i from 100 to 140:
                m.set(i, i)
            loop i from 100 to 140:
                r2 = m.remove(i):
                    on std::mutable_map::KeyNotFound:
                        0
            b = pairs(m)
            s = set_of([1, 2, 3])
            ok2 = reorder_set_to(s, [3, 1, 2])
            dup = s.add(1)
            s.add(5)
            c = elems(s)
            s.clear()
            s.add(7)
            [ok, a, b == a, dup, c, elems(s)]
    std::test::value("cr-later-operations", [true, [[4, 40], [2, 22], [1, 10], [9, 90], [3, 33]], true, false, [3, 1, 2, 5], [7]], b_cr_later_operations)

    # against keys a b c, candidates a b, a b d, a b c d, none, d e f are OrderMismatch; every permutation of a b c is accepted
    fn b_cr_validate_mismatch() errors std::compiler::CompilerError:
        static compile:
            m = std::mutable_map::create[str, int]()
            m.set("a", 1)
            m.set("b", 2)
            m.set("c", 3)
            fn verdict(m: std::mutable_map::MutableMap[str, int], xs: List[str]) -> bool:
                o = m.validate_order(str_set(xs)):
                    on std::mutable_map::OrderMismatch:
                        return false
                true
            bad = loop xs in [["a", "b"], ["a", "b", "d"], ["a", "b", "c", "d"], [], ["d", "e", "f"]]:
                verdict(m, xs)
            good = loop xs in [["a", "b", "c"], ["a", "c", "b"], ["b", "a", "c"], ["b", "c", "a"], ["c", "a", "b"], ["c", "b", "a"]]:
                verdict(m, xs)
            [bad, good]
    std::test::value("cr-validate-mismatch", [[false, false, false, false, false], [true, true, true, true, true, true]], b_cr_validate_mismatch)

    # validation reorders nothing and returns the candidate; a failed validation leaves both inputs unchanged
    fn b_cr_validate_changes_nothing() errors std::compiler::CompilerError:
        static compile:
            m = int_map([1, 2, 3])
            c = set_of([3, 2, 1])
            o = m.validate_order(c):
                on std::mutable_map::OrderMismatch:
                    m.order()
            bad = set_of([2, 1])
            failed = m.validate_order(bad):
                on std::mutable_map::OrderMismatch:
                    set_of([0])
            s = set_of([5, 6])
            sbad = set_of([6, 7])
            sfailed = s.validate_order(sbad):
                on std::mutable_set::OrderMismatch:
                    set_of([0])
            [pairs(m), elems(o), elems(c), elems(failed), elems(bad), elems(s), elems(sbad), elems(sfailed)]
    std::test::value("cr-validate-changes-nothing", [[[1, 10], [2, 20], [3, 30]], [3, 2, 1], [3, 2, 1], [0], [2, 1], [5, 6], [6, 7], [0]], b_cr_validate_changes_nothing)

    # unhandled, OrderMismatch is UNHANDLED-ERROR
    fn b_cr_validate_propagates_unhandled() errors std::compiler::CompilerError:
        static compile:
            m = int_map([1])
            o = m.validate_order(set_of([2]))  # reject cr-validate-propagates/unhandled col=17
            m.reorder(o)
    std::test::rejects_at("cr-validate-propagates/unhandled", std::compiler::DiagnosticCode::UnhandledError, 328, 17, b_cr_validate_propagates_unhandled)

    # declared, OrderMismatch propagates to the caller's handler
    fn b_cr_validate_propagates_declared() errors std::compiler::CompilerError:
        static compile:
            fn f(place m: std::mutable_map::MutableMap[int, int]) -> int errors std::mutable_map::OrderMismatch:
                o = m.validate_order(set_of([2]))
                m.reorder(o)
                1
            m = int_map([1])
            r = f(m):
                on std::mutable_map::OrderMismatch:
                    -1
            r
    std::test::value("cr-validate-propagates/declared", -1, b_cr_validate_propagates_declared)

    # reorder itself declares no error
    fn b_cr_validate_propagates_reorder_no_error() errors std::compiler::CompilerError:
        static compile:
            fn f(place m: std::mutable_map::MutableMap[int, int]) -> unit:
                m.reorder(m.order())
            m = int_map([1])
            f(m)
            m.length()
    std::test::value("cr-validate-propagates/reorder-no-error", 1, b_cr_validate_propagates_reorder_no_error)

# ---------------------------------------------------------------------------
# The proof

fn register_reorder_proof_tests():
    # order(), validate_order, a copy of a proven order or of the collection are proven
    fn b_cr_proof_established_snapshot() errors std::compiler::CompilerError:
        static compile:
            m = int_map([1, 2])
            o = m.order()
            m.reorder(o)
            unit
    std::test::value("cr-proof-established/snapshot", unit, b_cr_proof_established_snapshot)

    # order(), validate_order, a copy of a proven order or of the collection are proven
    fn b_cr_proof_established_inline() errors std::compiler::CompilerError:
        static compile:
            m = int_map([1, 2])
            m.reorder(m.order())
            std::mutable_map::reorder(m, std::mutable_map::order(m))
            unit
    std::test::value("cr-proof-established/inline", unit, b_cr_proof_established_inline)

    # order(), validate_order, a copy of a proven order or of the collection are proven
    fn b_cr_proof_established_validated() errors std::compiler::CompilerError:
        static compile:
            m = int_map([1, 2])
            o = m.validate_order(set_of([2, 1])):
                on std::mutable_map::OrderMismatch:
                    m.order()
            m.reorder(o)
            unit
    std::test::value("cr-proof-established/validated", unit, b_cr_proof_established_validated)

    # order(), validate_order, a copy of a proven order or of the collection are proven
    fn b_cr_proof_established_validated_exit() errors std::compiler::CompilerError:
        static compile:
            fn f(place m: std::mutable_map::MutableMap[int, int]) -> unit:
                o = m.validate_order(set_of([2, 1])):
                    on std::mutable_map::OrderMismatch:
                        return unit
                m.reorder(o)
            unit
    std::test::value("cr-proof-established/validated-exit", unit, b_cr_proof_established_validated_exit)

    # order(), validate_order, a copy of a proven order or of the collection are proven
    fn b_cr_proof_established_propagated() errors std::compiler::CompilerError:
        static compile:
            fn f(place m: std::mutable_map::MutableMap[int, int]) -> unit errors std::mutable_map::OrderMismatch:
                o = m.validate_order(set_of([2, 1]))
                m.reorder(o)
            unit
    std::test::value("cr-proof-established/propagated", unit, b_cr_proof_established_propagated)

    # order(), validate_order, a copy of a proven order or of the collection are proven
    fn b_cr_proof_established_order_copy() errors std::compiler::CompilerError:
        static compile:
            m = int_map([1, 2])
            o = m.order()
            c = o
            m.reorder(c)
            unit
    std::test::value("cr-proof-established/order-copy", unit, b_cr_proof_established_order_copy)

    # order(), validate_order, a copy of a proven order or of the collection are proven
    fn b_cr_proof_established_map_copy() errors std::compiler::CompilerError:
        static compile:
            m = int_map([1, 2])
            o = m.order()
            m2 = m
            m2.reorder(o)
            m.reorder(o)
            unit
    std::test::value("cr-proof-established/map-copy", unit, b_cr_proof_established_map_copy)

    # order(), validate_order, a copy of a proven order or of the collection are proven
    fn b_cr_proof_established_set_forms() errors std::compiler::CompilerError:
        static compile:
            s = set_of([1, 2])
            s.reorder(s.order())
            t = s
            s.reorder(t)
            s.reorder(s)
            o = s.validate_order(set_of([2, 1])):
                on std::mutable_set::OrderMismatch:
                    s
            s.reorder(o)
            unit
    std::test::value("cr-proof-established/set-forms", unit, b_cr_proof_established_set_forms)

    # order(), validate_order, a copy of a proven order or of the collection are proven
    fn b_cr_proof_established_generic() errors std::compiler::CompilerError:
        static compile:
            fn f(place m: std::mutable_map::MutableMap[K, V]) -> unit:
                o = m.order()
                m.reorder(o)
            unit
    std::test::value("cr-proof-established/generic", unit, b_cr_proof_established_generic)

    # a MutableSet of the key type, a parameter, a helper's result, another map's order, a List element, the validator's argument: REORDER-NOT-PROVEN
    fn b_cr_proof_type_is_not_enough_arbitrary() errors std::compiler::CompilerError:
        static compile:
            m = int_map([1, 2])
            c = set_of([2, 1])
            m.reorder(c)  # reject cr-proof-type-is-not-enough/arbitrary
            unit
    std::test::rejects_at("cr-proof-type-is-not-enough/arbitrary", std::compiler::DiagnosticCode::ReorderNotProven, 459, 13, b_cr_proof_type_is_not_enough_arbitrary)

    # a MutableSet of the key type, a parameter, a helper's result, another map's order, a List element, the validator's argument: REORDER-NOT-PROVEN
    fn b_cr_proof_type_is_not_enough_parameters() errors std::compiler::CompilerError:
        static compile:
            fn f(place m: std::mutable_map::MutableMap[int, int], o: std::mutable_set::MutableSet[int]) -> unit:
                m.reorder(o)  # reject cr-proof-type-is-not-enough/parameters
            unit
    std::test::rejects_at("cr-proof-type-is-not-enough/parameters", std::compiler::DiagnosticCode::ReorderNotProven, 467, 17, b_cr_proof_type_is_not_enough_parameters)

    # a MutableSet of the key type, a parameter, a helper's result, another map's order, a List element, the validator's argument: REORDER-NOT-PROVEN
    fn b_cr_proof_type_is_not_enough_helper() errors std::compiler::CompilerError:
        static compile:
            fn order_of(m: std::mutable_map::MutableMap[int, int]) -> std::mutable_set::MutableSet[int]:
                m.order()
            m = int_map([1, 2])
            m.reorder(order_of(m))  # reject cr-proof-type-is-not-enough/helper
            unit
    std::test::rejects_at("cr-proof-type-is-not-enough/helper", std::compiler::DiagnosticCode::ReorderNotProven, 477, 13, b_cr_proof_type_is_not_enough_helper)

    # a MutableSet of the key type, a parameter, a helper's result, another map's order, a List element, the validator's argument: REORDER-NOT-PROVEN
    fn b_cr_proof_type_is_not_enough_other_map() errors std::compiler::CompilerError:
        static compile:
            a = int_map([1, 2])
            b = int_map([1, 2])
            o = a.order()
            a.reorder(o)
            b.reorder(o)  # reject cr-proof-type-is-not-enough/other-map
            unit
    std::test::rejects_at("cr-proof-type-is-not-enough/other-map", std::compiler::DiagnosticCode::ReorderNotProven, 488, 13, b_cr_proof_type_is_not_enough_other_map)

    # a MutableSet of the key type, a parameter, a helper's result, another map's order, a List element, the validator's argument: REORDER-NOT-PROVEN
    fn b_cr_proof_type_is_not_enough_element() errors std::compiler::CompilerError:
        static compile:
            m = int_map([1, 2])
            xs = [m.order()]
            y = std::list::at(xs, 0):
                on IndexNotFound:
                    m.order()
            m.reorder(y)  # reject cr-proof-type-is-not-enough/element
            unit
    std::test::rejects_at("cr-proof-type-is-not-enough/element", std::compiler::DiagnosticCode::ReorderNotProven, 500, 13, b_cr_proof_type_is_not_enough_element)

    # a MutableSet of the key type, a parameter, a helper's result, another map's order, a List element, the validator's argument: REORDER-NOT-PROVEN
    fn b_cr_proof_type_is_not_enough_validator_argument() errors std::compiler::CompilerError:
        static compile:
            fn f(place m: std::mutable_map::MutableMap[int, int], c: std::mutable_set::MutableSet[int]) -> unit errors std::mutable_map::OrderMismatch:
                o = m.validate_order(c)
                m.reorder(c)  # reject cr-proof-type-is-not-enough/validator-argument
            unit
    std::test::rejects_at("cr-proof-type-is-not-enough/validator-argument", std::compiler::DiagnosticCode::ReorderNotProven, 509, 17, b_cr_proof_type_is_not_enough_validator_argument)

    # a MutableSet of the key type, a parameter, a helper's result, another map's order, a List element, the validator's argument: REORDER-NOT-PROVEN
    fn b_cr_proof_type_is_not_enough_set_arbitrary() errors std::compiler::CompilerError:
        static compile:
            s = set_of([1, 2])
            s.reorder(set_of([2, 1]))  # reject cr-proof-type-is-not-enough/set-arbitrary
            unit
