# callables.bot -- function values and structural function types: the
# source-level specification of
#
#   * structural function types (STRUCTURAL-FUNCTION-TYPES.md):
#     `Fn{args: [T1, ...], return: R, errors: [E1, ...]}` is a call contract
#     -- some callable (a native, an envless function or a capturing
#     closure, which one is not known) that accepts arguments admissible for
#     T1.., returns R and lets at most E1.. escape. Its fields may span lines
#     and come in any order; an omitted `errors` field admits no error; it
#     nests in argument, result and List positions and is a function's
#     declared result type. An exact callable (a native, a function, a
#     closure) is admitted by every compatible contract: arguments are
#     contravariant (a callable accepting all of Byte serves callers that
#     pass only Nibble), the result covariant, the error set a subset. A
#     wrong arity, a too-narrow parameter, a too-broad result, an extra
#     error, a non-callable and an unknown (`any`) value are rejected, each
#     with its own reason; a call through an Fn is held to the contract's
#     argument types, arity and error set. A join (an `if`, a List literal,
#     a returning loop) of compatible callables is their common Fn, never
#     `any`; a join of incompatible arities falls back to the bare
#     (dynamically callable) kind, and a join of incompatible typed
#     callables is rejected as an erasure;
#   * typed-callable escape (TYPED-CALLABLE-ESCAPE-SOUNDNESS.md): a
#     callable with a declared parameter type never reaches a call where
#     that contract could go unchecked. Exact identity survives an alias, a
#     chain of aliases, a capture, a return and a constant-condition `if`, so
#     such calls are checked like direct ones; through an untyped
#     higher-order parameter the helper's semantic instance checks the
#     callee's contract with the argument types that reach it (and an
#     instance is keyed by types, so even a valid-looking literal is not
#     proven); a callable whose only declared type is its result stays
#     unrestricted, and so does one whose every parameter is declared `any`
#     (an obligation of no caller's) while it declares no error;
#   * exact callable identity through higher-order helpers
#     (EXACT-CALLABLE-CLOSED-CALLER.md) and Int-keyed closures
#     (GENERIC-PREDICATE-PROOF-LOSS.md, loss point 1): a function value, a
#     native or a value-capturing closure passed to, aliased into, returned
#     to, forwarded through or recursed through a helper computes the same
#     value on every backend, whatever specialization the compiler chose --
#     several targets of one helper (more than the per-helper budget too),
#     same-named functions of different scopes, natives of one signature,
#     targets chosen dynamically (by `if`, from a List), and closures
#     capturing Strings, Ints, Lists, MutableArrays and structs.
#
# Ported from tests/structural-fn-types.test, tests/typed-callable-escape.test,
# tests/closure-int-keys.test and tests/exact-callable-key.test, which stay
# authoritative and unchanged (audit/golden/migration/fragments/callables.tsv
# maps every test). Those files' Tcl-only halves stay there: the lattice laws
# of hir::types, the static types hir::typeOf shows, specialization labels
# and keys, NIR instance, callvalue and closure-allocation counts, the
# compiler options (-exact-callable-opt, -block-escape-opt, the exact-target
# budget) and the forced in-process GC stress. Here a Tcl program that is
# only compiled also runs, on every backend, and its value is compared; a
# rejected program is a rejected block compared by its std::compiler::DiagnosticCode
# and, where the Tcl test globs the message for the reason of the rejection
# (an arity mismatch, a return or error-set incompatibility, the semantic
# instance's admissibility diagnostic against the erasure diagnostic), by
# the fragment that names the reason. The exact-callable-key and
# closure-int-keys programs were compiled -strict 0 in Tcl; here they are
# strict, a few with the declared errors of std::str::substring, std::list::at and
# std::mutable_array::at admitted or handled (each noted at its test).
#
# Imports: compiler and test (the framework); list (std::list::all?, std::list::at:
# the Tcl preludes import it), str (std::str::is_tcl_alpha, std::str::is_tcl_alnum,
# std::str::length, std::str::substring, std::str::concat) and mutable_array (a closure
# capturing a MutableArray). No test is about imports or method-call
# candidates, and no body uses method-call syntax.
import std::compiler
import std::list
import std::mutable_array
import std::str
import std::test

# ---------------------------------------------------------------------------
# Declarations the tests need (top-level only): the Tcl files' preludes
# (structural-fn-types.test's fnDecls: Byte, Nibble, NotFound,
# PermissionDenied; typed-callable-escape.test's byteDecl and its Small and
# Mark programs; exact-callable-typed-callable-with-errors' NotFound, the
# same payload-free declaration; its `any` parameter programs' structs).

type Byte = Int in 0..255
type Nibble = Int in 0..15
type Small = Int in 0..10
type Mark = Int in {0,4,8,12}

error NotFound
error PermissionDenied

struct AnyBox:
    value: any

struct Cell[T]:
    value: T

# ===========================================================================
# tests/structural-fn-types.test

# ---------------------------------------------------------------------------
# Surface syntax

fn register_fn_syntax_tests():
    # fn-syntax-multiline-any-order-omitted-errors: an Fn type's fields may
    # span lines and come in any order (with a trailing comma), and f and g
    # are both callable with a String, returning a Bool.
    fn multiline_fields() errors std::compiler::CompilerError:
        static compile:
            fn apply(
                f: Fn{
                    return: bool,
                    args: [str],
                },
                g: Fn{args: [str], return: bool, errors: []}
            ):
                [f("a"), g("1")]
            apply(std::str::is_tcl_alpha, std::str::is_tcl_alpha)
    std::test::value("fn-syntax-multiline-any-order-omitted-errors/fields", [true, false], multiline_fields)

    # ... and the omitted errors field is errors: [] -- no error may escape:
    # a callable that may raise NotFound does not satisfy f.
    fn omitted_errors_admit_none() errors std::compiler::CompilerError:
        static compile:
            fn apply(
                f: Fn{
                    return: bool,
                    args: [str],
                },
                g: Fn{args: [str], return: bool, errors: []}
            ):
                1
            fn raising(x) -> bool errors NotFound:
                if x == "a":
                    fail NotFound
                true
            apply(raising, std::str::is_tcl_alpha)
    std::test::rejects_containing("fn-syntax-multiline-any-order-omitted-errors/omitted-errors-admit-none", std::compiler::DiagnosticCode::Type, "error set incompatible: the callable may raise NotFound, but the function type allows only []", omitted_errors_admit_none)

    # fn-syntax-return-annotation: Fn is a function's declared result type
    # (its result is called here: a body never returns a function value).
    fn return_annotation() errors std::compiler::CompilerError:
        static compile:
            fn pick() -> Fn{args: [str], return: bool}:
                std::str::is_tcl_alpha
            pick()("a")
    std::test::value("fn-syntax-return-annotation", true, return_annotation)

    # fn-syntax-nested: Fn nests in argument, result and List positions
    # (and resolves: the program is accepted).
    fn nested() errors std::compiler::CompilerError:
        static compile:
            fn run(fs: List[Fn{args: [int], return: Fn{args: [], return: int}}]):
                1
            1
    std::test::value("fn-syntax-nested", 1, nested)

    # fn-syntax-unknown-error: an error name in an Fn type must be a
    # declared error identity (Nope is not declared here).
    fn unknown_error() errors std::compiler::CompilerError:
        static compile:
            fn f(g: Fn{args: [str], return: bool, errors: [Nope]}):
                1
            1
    std::test::rejects_containing("fn-syntax-unknown-error", std::compiler::DiagnosticCode::Type, "unknown error \"Nope\" in the function type's \"errors\" list", unknown_error)

    # fn-syntax-unknown-type: an unknown argument type is the ordinary
    # unknown-type diagnostic.
    fn unknown_type() errors std::compiler::CompilerError:
        static compile:
            fn f(g: Fn{args: [Nope], return: bool}):
                1
            1
    std::test::rejects_containing("fn-syntax-unknown-type", std::compiler::DiagnosticCode::Type, "unknown type \"Nope\"", unknown_type)

# ---------------------------------------------------------------------------
# Acceptance: exact callables, joins and contracts. The Tcl prelude's apply
# (applyStr, written there across lines) is written on one line here.

fn register_fn_acceptance_tests():
    # fn-accept-exact-envless-block: an exact envless function passes a
    # structural Fn parameter.
    fn exact_envless_block() errors std::compiler::CompilerError:
        static compile:
            fn apply(predicate: Fn{args: [str], return: bool, errors: []}, value: str) -> bool:
                predicate(value)
            fn is_x?(c):
                c == "x"
            [apply(is_x?, "x"), apply(is_x?, "y")]
    std::test::value("fn-accept-exact-envless-block", [true, false], exact_envless_block)

    # fn-accept-exact-native: an exact native passes the same parameter.
    fn exact_native() errors std::compiler::CompilerError:
        static compile:
            fn apply(predicate: Fn{args: [str], return: bool, errors: []}, value: str) -> bool:
                predicate(value)
            [apply(std::str::is_tcl_alpha, "a"), apply(std::str::is_tcl_alnum, "-")]
    std::test::value("fn-accept-exact-native", [true, false], exact_native)

    # fn-accept-exact-capturing-block: a capturing closure passes too.
    fn exact_capturing_block() errors std::compiler::CompilerError:
        static compile:
            fn apply(predicate: Fn{args: [str], return: bool, errors: []}, value: str) -> bool:
                predicate(value)
            fn make(target):
                fn eq?(c):
                    c == target
                eq?
            q? = make("q")
            r? = make("r")
            [apply(q?, "q"), apply(r?, "q"), q?("q")]
    std::test::value("fn-accept-exact-capturing-block", [true, false, true], exact_capturing_block)

    # fn-accept-returned-fn: a declared Fn result joins a native and a
    # nested closure.
    fn returned_fn() errors std::compiler::CompilerError:
        static compile:
            fn pick(strict) -> Fn{args: [str], return: bool}:
                if strict:
                    std::str::is_tcl_alnum
                else:
                    fn lenient?(c):
                        std::str::is_tcl_alnum(c) or c == "_"
                    lenient?
            [pick(true)("_"), pick(false)("_")]
    std::test::value("fn-accept-returned-fn", [false, true], returned_fn)

    # fn-accept-list-inference: a List of mixed compatible callables (natives
    # and functions) is iterated and each element called.
    fn list_inference() errors std::compiler::CompilerError:
        static compile:
            fn under?(c):
                c == "_"
            fn dash?(c):
                c == "-"
            checks = [std::str::is_tcl_alpha, std::str::is_tcl_alnum, under?, dash?]
            loop check in checks:
                check("_")
    std::test::value("fn-accept-list-inference/value", [false, false, true, false], list_inference)

    # ... and its loop element is a known callable (their common Fn, not
    # any): it satisfies an Fn parameter, which `any` never does
    # (fn-reject-any-is-not-fn).
    fn list_element_is_fn() errors std::compiler::CompilerError:
        static compile:
            fn apply(predicate: Fn{args: [str], return: bool, errors: []}, value: str) -> bool:
                predicate(value)
            fn under?(c):
                c == "_"
            fn dash?(c):
                c == "-"
            checks = [std::str::is_tcl_alpha, std::str::is_tcl_alnum, under?, dash?]
            loop check in checks:
                apply(check, "_")
    std::test::value("fn-accept-list-inference/element-is-fn", [false, false, true, false], list_element_is_fn)

    # fn-accept-if-join: an if choosing between a native and a function.
    fn if_join() errors std::compiler::CompilerError:
        static compile:
            fn lenient?(c):
                std::str::is_tcl_alnum(c) or c == "_"
            fn choose(strict):
                if strict:
                    std::str::is_tcl_alnum
                else:
                    lenient?
            classifier = choose(false)
            [choose(true)("_"), classifier("_")]
    std::test::value("fn-accept-if-join/value", [false, true], if_join)

    # ... and the binding keeps their common Fn type (not any): it satisfies
    # an Fn parameter.
    fn if_join_is_fn() errors std::compiler::CompilerError:
        static compile:
            fn apply(predicate: Fn{args: [str], return: bool, errors: []}, value: str) -> bool:
                predicate(value)
            fn lenient?(c):
                std::str::is_tcl_alnum(c) or c == "_"
            fn choose(strict):
                if strict:
                    std::str::is_tcl_alnum
                else:
                    lenient?
            classifier = choose(false)
            [apply(choose(true), "_"), apply(classifier, "_")]
    std::test::value("fn-accept-if-join/keeps-fn-type", [false, true], if_join_is_fn)

    # fn-accept-typed-callable: a Byte-parameter function satisfies
    # Fn{args: [Byte]}, and the call through it runs.
    fn typed_callable() errors std::compiler::CompilerError:
        static compile:
            fn take_byte(x: Byte) -> int:
                x + 1
            fn apply(f: Fn{args: [Byte], return: int}, v: Byte) -> int:
                f(v)
            apply(take_byte, 7)
    std::test::value("fn-accept-typed-callable", 8, typed_callable)

    # fn-accept-narrower-domain-arg: a callable accepting all of Byte
    # satisfies a contract whose callers pass only Nibble.
    fn narrower_domain_arg() errors std::compiler::CompilerError:
        static compile:
            fn take_byte(x: Byte) -> int:
                x
            fn apply(f: Fn{args: [Nibble], return: int}, v: Nibble) -> int:
                f(v)
            apply(take_byte, 9)
    std::test::value("fn-accept-narrower-domain-arg", 9, narrower_domain_arg)

    # fn-accept-closure-factory: a factory satisfies a contract returning a
    # function type, and the closure it returns stays callable directly.
    fn closure_factory() errors std::compiler::CompilerError:
        static compile:
            fn make(k):
                fn add(x):
                    x + k
                add
            fn apply(f: Fn{args: [int], return: Fn{args: [int], return: any}}) -> any:
                f(1)(2)
            add5 = make(5)
            [apply(make), add5(1)]
    std::test::value("fn-accept-closure-factory", [3, 6], closure_factory)

    # fn-accept-recursive: a recursive function's structural contract is
    # derived (compilation terminates) and it satisfies Fn{args: [int]}.
    fn recursive() errors std::compiler::CompilerError:
        static compile:
            fn count(n) -> int:
                if n == 0:
                    return 0
                1 + count(n - 1)
            fn apply(f: Fn{args: [int], return: int}) -> int:
                f(3)
            apply(count)
    std::test::value("fn-accept-recursive", 3, recursive)

    # fn-accept-untyped-hof-unaffected: a structural value with no
    # obligation still passes an untyped higher-order parameter.
    fn untyped_hof_unaffected() errors std::compiler::CompilerError:
        static compile:
            fn lenient?(c):
                std::str::is_tcl_alnum(c) or c == "_"
            fn choose(strict):
                if strict:
                    std::str::is_tcl_alnum
                else:
                    lenient?
            [std::list::all?(["a", "_"], choose(true)), std::list::all?(["a", "_"], choose(false))]
    std::test::value("fn-accept-untyped-hof-unaffected", [false, true], untyped_hof_unaffected)

    # fn-accept-untyped-forwarder: an untyped parameter passed where an Fn
    # is declared infers that Fn as its own contract: the forwarder is valid
    # for a callable ...
    fn untyped_forwarder() errors std::compiler::CompilerError:
        static compile:
            fn apply(predicate: Fn{args: [str], return: bool, errors: []}, value: str) -> bool:
                predicate(value)
            fn pass(g):
                apply(g, "a")
            pass(std::str::is_tcl_alpha)
    std::test::value("fn-accept-untyped-forwarder/accepted", true, untyped_forwarder)

    # ... and its callers are held to the inferred contract.
    fn untyped_forwarder_rejected() errors std::compiler::CompilerError:
        static compile:
            fn apply(predicate: Fn{args: [str], return: bool, errors: []}, value: str) -> bool:
                predicate(value)
            fn pass(g):
                apply(g, "a")
            pass(1)
    std::test::rejects_containing("fn-accept-untyped-forwarder/rejected", std::compiler::DiagnosticCode::Type, "argument for parameter \"g\" cannot be proven to satisfy Fn{args: [str], return: bool, errors: []}, the parameter type inferred from the function body", untyped_forwarder_rejected)

# ---------------------------------------------------------------------------
# Rejection: each reason a callable does not satisfy an Fn, and calls
# through an Fn held to its contract

fn register_fn_rejection_tests():
    # fn-reject-arity: the wrong arity, said so.
    fn wrong_arity() errors std::compiler::CompilerError:
        static compile:
            fn apply(predicate: Fn{args: [str], return: bool, errors: []}, value: str) -> bool:
                predicate(value)
            fn two(a, b):
                true
            apply(two, "a")
    std::test::rejects_containing("fn-reject-arity", std::compiler::DiagnosticCode::Type, "arity mismatch: the callable takes 2 argument(s), the function type 1", wrong_arity)

    # fn-reject-argument-too-narrow: a parameter narrower than the contract's
    # argument type, at the argument position.
    fn argument_too_narrow() errors std::compiler::CompilerError:
        static compile:
            fn apply(f: Fn{args: [int], return: int}):
                f(1000)
            fn take_byte(x: Byte) -> int:
                x
            apply(take_byte)
    std::test::rejects_containing("fn-reject-argument-too-narrow", std::compiler::DiagnosticCode::Type, "argument 1 is incompatible: the callable's parameter requires int[Byte], but callers of the function type may pass any int", argument_too_narrow)

    # fn-reject-return-too-broad: a result wider than the contract promises.
    fn return_too_broad() errors std::compiler::CompilerError:
        static compile:
            fn apply(predicate: Fn{args: [str], return: bool, errors: []}, value: str) -> bool:
                predicate(value)
            fn ident(x):
                x
            apply(ident, "a")
    std::test::rejects_containing("fn-reject-return-too-broad", std::compiler::DiagnosticCode::Type, "return incompatible: the callable returns any, not usable as bool", return_too_broad)

    # fn-reject-extra-error: an error the contract does not allow, named.
    fn extra_error() errors std::compiler::CompilerError:
        static compile:
            fn apply(f: Fn{args: [str], return: int, errors: [NotFound]}) -> int:
                f("a"):
                    on NotFound:
                        0
            fn find(x) -> int errors NotFound, PermissionDenied:
                if x == "a":
                    fail PermissionDenied
                1
            apply(find)
    std::test::rejects_containing("fn-reject-extra-error", std::compiler::DiagnosticCode::Type, "error set incompatible: the callable may raise PermissionDenied, but the function type allows only [NotFound]", extra_error)

    # fn-reject-non-callable: an Int is not a callable.
    fn non_callable() errors std::compiler::CompilerError:
        static compile:
            fn apply(predicate: Fn{args: [str], return: bool, errors: []}, value: str) -> bool:
                predicate(value)
            apply(5, "a")
    std::test::rejects_containing("fn-reject-non-callable", std::compiler::DiagnosticCode::Type, "a value of type int is not known to be callable", non_callable)

    # fn-reject-any-is-not-fn: an element of a heterogeneous List is any,
    # not a known callable.
    fn any_is_not_fn() errors std::compiler::CompilerError:
        static compile:
            fn apply(predicate: Fn{args: [str], return: bool, errors: []}, value: str) -> bool:
                predicate(value)
            fn pass(gs):
                apply(std::list::at(gs, 0), "a")
            pass([std::str::is_tcl_alpha, 1])
    std::test::rejects_containing("fn-reject-any-is-not-fn", std::compiler::DiagnosticCode::Type, "a value of type any is not known to be callable", any_is_not_fn)

    # fn-reject-call-argument: a call through an Fn is held to its argument
    # types (no run-time check).
    fn call_argument() errors std::compiler::CompilerError:
        static compile:
            fn apply(f: Fn{args: [Byte], return: int}) -> int:
                f(9999)
            1
    std::test::rejects_containing("fn-reject-call-argument", std::compiler::DiagnosticCode::Type, "argument 1 cannot be proven to satisfy int[Byte], the parameter type the callee's function type Fn{args: [int[Byte]]", call_argument)

    # fn-reject-call-arity: ... and to its arity.
    fn call_arity() errors std::compiler::CompilerError:
        static compile:
            fn apply(predicate: Fn{args: [str], return: bool, errors: []}, value: str) -> bool:
                predicate(value)
            fn bad(f: Fn{args: [str], return: bool}):
                f("a", "b")
            1
    std::test::rejects_containing("fn-reject-call-arity", std::compiler::DiagnosticCode::Type, "passes 2 argument(s) to a callable of function type Fn{args: [str], return: bool, errors: []}, whose contract takes 1", call_arity)

    # fn-reject-incompatible-join-falls-back: a join of different arities
    # falls back to the bare kind, still callable dynamically ...
    fn join_falls_back() errors std::compiler::CompilerError:
        static compile:
            fn one(a):
                1
            fn two(a, b):
                2
            fn choose(c):
                if c:
                    one
                else:
                    two
            choose(true)(5)
    std::test::value("fn-reject-incompatible-join-falls-back/fallback", 1, join_falls_back)

    # ... and a join of incompatible typed callables is rejected at the join
    # as an erasure.
    fn join_rejected() errors std::compiler::CompilerError:
        static compile:
            fn take_byte(x: Byte) -> int:
                x
            fn take_str(x: str) -> str:
                x
            fn choose(c):
                if c:
                    take_byte
                else:
                    take_str
            choose(true)
    std::test::rejects_containing("fn-reject-incompatible-join-falls-back/rejected", std::compiler::DiagnosticCode::Type, "typed parameter requirements that cannot be preserved", join_rejected)

# ---------------------------------------------------------------------------
# Error contracts. HIT is the String the find functions fail on ("a"), a
# parameter so that the failure is decided at run time.

fn register_fn_error_contract_tests(hit: str, miss: str):
    # fn-errors-impl-none-declared-a: a declared error set is an upper bound.
    fn impl_none_declared_a() errors std::compiler::CompilerError:
        static compile:
            fn f(x) -> int errors NotFound:
                1
            f(1):
                on NotFound:
                    0
    std::test::value("fn-errors-impl-none-declared-a", 1, impl_none_declared_a)

    # fn-errors-impl-a-declared-ab: emitting [A] while declaring [A, B].
    fn impl_a_declared_ab() errors std::compiler::CompilerError:
        static compile:
            fn f(x) -> int errors NotFound, PermissionDenied:
                if x == 1:
                    fail NotFound
                2
            fn g(x) -> int:
                r = f(x):
                    on NotFound:
                        0
                    on PermissionDenied:
                        -1
                r
            [g(1), g(2)]
    std::test::value("fn-errors-impl-a-declared-ab", [0, 2], impl_a_declared_ab)

    # fn-errors-impl-ab-declared-a: emitting [A, B] while declaring only [A].
    fn impl_ab_declared_a() errors std::compiler::CompilerError:
        static compile:
            fn f(x) -> int errors NotFound:
                if x == 1:
                    fail NotFound
                if x == 2:
                    fail PermissionDenied
                2
            f(3):
                on NotFound:
                    0
    std::test::rejects_containing("fn-errors-impl-ab-declared-a", std::compiler::DiagnosticCode::UnhandledError, "\"fail PermissionDenied\" is not admitted here", impl_ab_declared_a)

    # fn-errors-narrower-satisfies-wider: fewer declared errors satisfy a
    # contract allowing more, and the error propagates through the
    # structural call at run time.
    fn narrower_satisfies_wider() errors std::compiler::CompilerError:
        static compile:
            fn apply(f: Fn{args: [str], return: int, errors: [NotFound, PermissionDenied]}, v: str) -> int:
                f(v):
                    on NotFound:
                        0
                    on PermissionDenied:
                        -1
            fn find(x) -> int errors NotFound:
                if x == "a":
                    fail NotFound
                1
            [apply(find, hit), apply(find, miss)]
    std::test::value("fn-errors-narrower-satisfies-wider", [0, 1], narrower_satisfies_wider)

    # fn-errors-wider-rejected: more declared errors than the contract allows.
    fn wider_rejected() errors std::compiler::CompilerError:
        static compile:
            fn apply(f: Fn{args: [str], return: int}) -> int:
                f("a")
            fn find(x) -> int errors NotFound:
                1
            apply(find)
    std::test::rejects_containing("fn-errors-wider-rejected", std::compiler::DiagnosticCode::Type, "error set incompatible: the callable may raise NotFound, but the function type allows only []", wider_rejected)

    # fn-errors-structural-call-propagates: a call through an Fn exposes its
    # declared errors: unhandled and undeclared is rejected.
    fn structural_call_propagates() errors std::compiler::CompilerError:
        static compile:
            fn apply(f: Fn{args: [str], return: int, errors: [NotFound]}) -> int:
                f("a")
            1
    std::test::rejects_containing("fn-errors-structural-call-propagates", std::compiler::DiagnosticCode::UnhandledError, "through a callable of function type Fn{args: [str], return: int, errors: [NotFound]} may produce the declared error \"NotFound\"", structural_call_propagates)

    # fn-errors-structural-call-declared: an enclosing errors declaration
    # admits it, and it reaches the exact caller's handler at run time.
    fn structural_call_declared() errors std::compiler::CompilerError:
        static compile:
            fn apply(f: Fn{args: [str], return: int, errors: [NotFound]}) -> int errors NotFound:
                f("a")
            fn find(x) -> int errors NotFound:
                if x == hit:
                    fail NotFound
                1
            apply(find):
                on NotFound:
                    42
    std::test::value("fn-errors-structural-call-declared", 42, structural_call_declared)

    # fn-errors-join-union: a join of two compatible callables unions their
    # errors; handling both is accepted ...
    fn join_union_handled() errors std::compiler::CompilerError:
        static compile:
            fn a(x) -> int errors NotFound:
                1
            fn b(x) -> int errors PermissionDenied:
                2
            fn choose(c):
                if c:
                    a
                else:
                    b
            choose(true)(0):
                on NotFound:
                    -1
                on PermissionDenied:
                    -2
    std::test::value("fn-errors-join-union/handled", 1, join_union_handled)

    # ... handling one is not.
    fn join_union_unhandled() errors std::compiler::CompilerError:
        static compile:
            fn a(x) -> int errors NotFound:
                1
            fn b(x) -> int errors PermissionDenied:
                2
            fn choose(c):
                if c:
                    a
                else:
                    b
            choose(true)(0):
                on NotFound:
                    -1
    std::test::rejects_containing("fn-errors-join-union/unhandled", std::compiler::DiagnosticCode::UnhandledError, "may produce the declared error \"PermissionDenied\"", join_union_unhandled)

    # fn-errors-exact-call-keeps-narrower-set: an exact callable keeps its
    # own narrower error set where it is still exact: its direct call
    # handles only NotFound.
    fn exact_call_keeps_narrower_set() errors std::compiler::CompilerError:
        static compile:
            fn find(x) -> int errors NotFound:
                if x == "a":
                    fail NotFound
                1
            fn apply(f: Fn{args: [str], return: int, errors: [NotFound, PermissionDenied]}) -> int:
                f("b"):
                    on NotFound:
                        0
                    on PermissionDenied:
                        -1
            direct = find("a"):
                on NotFound:
                    0
            [apply(find), direct]
    std::test::value("fn-errors-exact-call-keeps-narrower-set", [1, 0], exact_call_keeps_narrower_set)

# ---------------------------------------------------------------------------
# Typed contracts through untyped code

fn register_fn_escape_tests():
    # fn-escape-declared-param-erased: a declared Fn parameter passed on to
    # an untyped helper keeps its contract in the helper's instance.
    fn declared_param_erased() errors std::compiler::CompilerError:
        static compile:
            fn take_byte(x: Byte) -> int:
                x
            fn apply(f: Fn{args: [Byte], return: int}):
                fn inner(g, v):
                    g(v)
                inner(f, 9999)
            apply(take_byte)
    std::test::rejects_containing("fn-escape-declared-param-erased", std::compiler::DiagnosticCode::Type, "call to inner with g : Fn{args: [int[Byte]], return: int, errors: []}, v : int is invalid: argument 1 cannot be proven to satisfy int[Byte]", declared_param_erased)

    # fn-escape-typed-list: a List of typed callables is callable through
    # its elements with checked arguments ...
    fn typed_list() errors std::compiler::CompilerError:
        static compile:
            fn a(x: Byte) -> int:
                x
            fn b(x: Byte) -> int:
                x + 1
            fs = [a, b]
            loop f in fs:
                f(3)
    std::test::value("fn-escape-typed-list/list", [3, 4], typed_list)

    # ... and through an untyped parameter the element contract is kept.
    fn typed_list_sneak() errors std::compiler::CompilerError:
        static compile:
            fn a(x: Byte) -> int:
                x
            fn b(x: Byte) -> int:
                x + 1
            fn sneak(xs):
                loop f in xs:
                    f(9999)
            sneak([a, b])
    std::test::rejects_containing("fn-escape-typed-list/sneak", std::compiler::DiagnosticCode::Type, "call to sneak with xs : List[Fn{args: [int[Byte]], return: int, errors: []}] is invalid: argument 1 cannot be proven to satisfy int[Byte]", typed_list_sneak)

    # fn-escape-returning-loop-element: collecting typed callables keeps
    # their contract ...
    fn loop_element_kept() errors std::compiler::CompilerError:
        static compile:
            fn tb(x: Byte) -> int:
                x
            ys = loop x in [1, 2]:
                tb
            loop f in ys:
                f(7)
    std::test::value("fn-escape-returning-loop-element/kept", [7, 7], loop_element_kept)

    # ... but collecting them where the aggregate depth bound cuts the
    # element type is rejected as an erasure.
    fn loop_element_depth_cut() errors std::compiler::CompilerError:
        static compile:
            fn tb(x: Byte) -> int:
                x
            nested = [[[tb]]]
            ys = loop x in [1]:
                nested
            std::list::at(std::list::at(std::list::at(std::list::at(ys, 0), 0), 0), 0)(9999)
    std::test::rejects_containing("fn-escape-returning-loop-element/depth-cut", std::compiler::DiagnosticCode::Type, "cannot be preserved as a returning loop's collected element", loop_element_depth_cut)

    # fn-escape-returned-typed-callable: a callable returning a typed
    # callable is itself precondition-bearing.
    fn returned_typed_callable() errors std::compiler::CompilerError:
        static compile:
            fn take_byte(x: Byte) -> int:
                x
            fn chooser():
                take_byte
            fn apply(f):
                g = f()
                g(9999)
            apply(chooser)
    std::test::rejects_containing("fn-escape-returned-typed-callable", std::compiler::DiagnosticCode::Type, "\"chooser\" has typed parameter requirements that cannot be preserved", returned_typed_callable)

    # fn-escape-declared-result-must-preserve: a declared Fn result keeps
    # the returned callable's obligations.
    fn declared_result_must_preserve() errors std::compiler::CompilerError:
        static compile:
            fn take_byte(x: Byte) -> int:
                x
            fn chooser():
                take_byte
            fn wrap() -> Fn{args: [], return: any}:
                chooser
            1
    std::test::rejects_containing("fn-escape-declared-result-must-preserve", std::compiler::DiagnosticCode::Type, "declared result type Fn{args: [], return: any, errors: []} would erase", declared_result_must_preserve)

fn register_structural_fn_types_tests():
    register_fn_syntax_tests()
    register_fn_acceptance_tests()
    register_fn_rejection_tests()
    register_fn_error_contract_tests("a", "b")
    register_fn_escape_tests()

# ===========================================================================
# tests/typed-callable-escape.test

# ---------------------------------------------------------------------------
# Through an untyped higher-order parameter: the helper's semantic instance

fn register_callable_escape_helper_tests(run: bool):
    # callable-escape-bug-rejected (and callable-escape-apply-bad-arg-
    # rejected, the same program and assertion): the reported unsound
    # program is a compile-time error, the admissibility diagnostic of
    # apply's instance ...
    fn bug() errors std::compiler::CompilerError:
        static compile:
            fn take_byte(x: Byte) -> int:
                x
            fn apply(f, v):
                f(v)
            apply(take_byte, 9999)
    std::test::rejects_containing("callable-escape-bug-rejected", std::compiler::DiagnosticCode::Type, "call to apply with f : take_byte/1 -> int, v : int is invalid: argument for parameter \"x\" cannot be proven to satisfy int[Byte]", bug)

    # callable-escape-bug-is-an-admissibility-error-in-the-instance: ...
    # the callee's own admissibility wording (not the erasure diagnostic's
    # "cannot be preserved"), reported at the call of apply.
    std::test::rejects_containing("callable-escape-bug-is-an-admissibility-error-in-the-instance/wording", std::compiler::DiagnosticCode::Type, "cannot be proven to satisfy", bug)
    std::test::rejects_at("callable-escape-bug-is-an-admissibility-error-in-the-instance/at-the-call-of-apply", std::compiler::DiagnosticCode::Type, 764, 13, bug)

    # callable-escape-apply-good-arg-still-rejected: an instance is keyed by
    # types, not values: 7 is an int, not proven Byte inside it.
    fn good_arg() errors std::compiler::CompilerError:
        static compile:
            fn take_byte(x: Byte) -> int:
                x
            fn apply(f, v):
                f(v)
            apply(take_byte, 7)
    std::test::rejects_containing("callable-escape-apply-good-arg-still-rejected", std::compiler::DiagnosticCode::Type, "call to apply with f : take_byte/1 -> int, v : int is invalid: argument for parameter \"x\" cannot be proven to satisfy int[Byte]", good_arg)

    # callable-escape-ordinary-untyped-callable-unaffected: an untyped
    # callable passes through apply freely.
    fn untyped_unaffected() errors std::compiler::CompilerError:
        static compile:
            fn identity(x):
                x
            fn apply(f, v):
                f(v)
            apply(identity, 9999)
    std::test::value("callable-escape-ordinary-untyped-callable-unaffected", 9999, untyped_unaffected)

    # callable-escape-typed-result-only-unrestricted: a declared result type
    # alone adds no restriction.
    fn typed_result_only() errors std::compiler::CompilerError:
        static compile:
            fn make_small(x) -> Small:
                if x < 0:
                    0
                else:
                    1
            fn apply(f, v):
                f(v)
            apply(make_small, 5)
    std::test::value("callable-escape-typed-result-only-unrestricted", 1, typed_result_only)

    # callable-escape-mixed-typed-untyped-params-rejected: one typed
    # parameter is enough to be protected.
    fn mixed_params() errors std::compiler::CompilerError:
        static compile:
            fn f(x: Byte, y):
                x
            fn apply(g, v, w):
                g(v, w)
            apply(f, 7, 1)
    std::test::rejects_containing("callable-escape-mixed-typed-untyped-params-rejected", std::compiler::DiagnosticCode::Type, "call to apply with g : f/2 -> int[Byte], v : int, w : int is invalid: argument for parameter \"x\" cannot be proven to satisfy int[Byte]", mixed_params)

    # callable-escape-arity-mismatch-is-a-runtime-error: a typed callable
    # called through a helper with the wrong number of arguments is
    # accepted (the arity error is a run-time one, never an escape). RUN is
    # false: the call is compiled but never made (its ARITY failure would
    # abort the suite).
    fn arity_mismatch() errors std::compiler::CompilerError:
        static compile:
            fn f(x: Byte, y):
                x
            fn apply(g, v):
                g(v)
            if run:
                apply(f, 7)
            else:
                0
    std::test::value("callable-escape-arity-mismatch-is-a-runtime-error", 0, arity_mismatch)

    # callable-escape-source-defined-type-escape-rejected: a source-defined
    # bounded type is protected the same way.
    fn source_type_escape() errors std::compiler::CompilerError:
        static compile:
            fn take_small(x: Small) -> int:
                x
            fn apply(f, v):
                f(v)
            apply(take_small, 3)
    std::test::rejects_containing("callable-escape-source-defined-type-escape-rejected", std::compiler::DiagnosticCode::Type, "call to apply with f : take_small/1 -> int, v : int is invalid: argument for parameter \"x\" cannot be proven to satisfy int[Small]", source_type_escape)

    # callable-escape-semantic-soundness-legal-calls-only: every legal call
    # proves x <= 255 ...
    fn soundness_legal() errors std::compiler::CompilerError:
        static compile:
            fn always_true_for_byte(x: Byte) -> int:
                if x <= 255:
                    1
                else:
                    2
            always_true_for_byte(200)
    std::test::value("callable-escape-semantic-soundness-legal-calls-only/legal", 1, soundness_legal)

    # ... and the only way to the else branch, an erased call with 9999, is
    # rejected.
    fn soundness_escape() errors std::compiler::CompilerError:
        static compile:
            fn always_true_for_byte(x: Byte) -> int:
                if x <= 255:
                    1
                else:
                    2
            fn apply(f, v):
                f(v)
            apply(always_true_for_byte, 9999)
    std::test::rejects("callable-escape-semantic-soundness-legal-calls-only/escape", std::compiler::DiagnosticCode::Type, soundness_escape)

# ---------------------------------------------------------------------------
# Exact identity: direct calls, aliases, constant branches, returns and
# captures are checked like direct calls

fn register_callable_escape_identity_tests():
    # callable-escape-direct-call-valid-unaffected / -invalid-unaffected.
    fn direct_valid() errors std::compiler::CompilerError:
        static compile:
            fn take_byte(x: Byte) -> int:
                x
            take_byte(7)
    std::test::value("callable-escape-direct-call-valid-unaffected", 7, direct_valid)

    fn direct_invalid() errors std::compiler::CompilerError:
        static compile:
            fn take_byte(x: Byte) -> int:
                x
            take_byte(9999)
    std::test::rejects_containing("callable-escape-direct-call-invalid-unaffected", std::compiler::DiagnosticCode::Type, "cannot be proven to satisfy", direct_invalid)

    # callable-escape-alias-valid / -invalid: f = take_byte resolves exactly.
    fn alias_valid() errors std::compiler::CompilerError:
        static compile:
            fn take_byte(x: Byte) -> int:
                x
            f = take_byte
            f(7)
    std::test::value("callable-escape-alias-valid", 7, alias_valid)

    fn alias_invalid() errors std::compiler::CompilerError:
        static compile:
            fn take_byte(x: Byte) -> int:
                x
            f = take_byte
            f(9999)
    std::test::rejects_containing("callable-escape-alias-invalid", std::compiler::DiagnosticCode::Type, "cannot be proven to satisfy", alias_invalid)

    # callable-escape-transitive-alias-valid / -invalid: g = f = take_byte.
    fn transitive_valid() errors std::compiler::CompilerError:
        static compile:
            fn take_byte(x: Byte) -> int:
                x
            f = take_byte
            g = f
            g(7)
    std::test::value("callable-escape-transitive-alias-valid", 7, transitive_valid)

    fn transitive_invalid() errors std::compiler::CompilerError:
        static compile:
            fn take_byte(x: Byte) -> int:
                x
            f = take_byte
            g = f
            g(9999)
    std::test::rejects_containing("callable-escape-transitive-alias-invalid", std::compiler::DiagnosticCode::Type, "cannot be proven to satisfy", transitive_invalid)

    # callable-escape-branch-known-condition-preserves-identity: a constant
    # condition selects one branch outright: no join.
    fn known_condition() errors std::compiler::CompilerError:
        static compile:
            fn take_byte(x: Byte) -> int:
                x
            f = if true:
                take_byte
            else:
                take_byte
            f(7)
    std::test::value("callable-escape-branch-known-condition-preserves-identity", 7, known_condition)

    # callable-escape-return-preserved-valid / -invalid: a returned typed
    # callable keeps its identity.
    fn return_valid() errors std::compiler::CompilerError:
        static compile:
            fn take_byte(x: Byte) -> int:
                x
            fn chooser():
                take_byte
            f = chooser()
            f(7)
    std::test::value("callable-escape-return-preserved-valid", 7, return_valid)

    fn return_invalid() errors std::compiler::CompilerError:
        static compile:
            fn take_byte(x: Byte) -> int:
                x
            fn chooser():
                take_byte
            f = chooser()
            f(9999)
    std::test::rejects_containing("callable-escape-return-preserved-invalid", std::compiler::DiagnosticCode::Type, "cannot be proven to satisfy", return_invalid)

    # callable-escape-capture-typed-wrapper-valid / -invalid: a closure
    # capturing a typed callable, with a typed parameter of its own.
    fn capture_typed_valid() errors std::compiler::CompilerError:
        static compile:
            fn take_byte(x: Byte) -> int:
                x
            fn outer():
                f = take_byte
                fn inner(v: Byte):
                    f(v)
                inner(7)
            outer()
    std::test::value("callable-escape-capture-typed-wrapper-valid", 7, capture_typed_valid)

    fn capture_typed_invalid() errors std::compiler::CompilerError:
        static compile:
            fn take_byte(x: Byte) -> int:
                x
            fn outer():
                f = take_byte
                fn inner(v: Byte):
                    f(v)
                inner(9999)
            outer()
    std::test::rejects_containing("callable-escape-capture-typed-wrapper-invalid", std::compiler::DiagnosticCode::Type, "cannot be proven to satisfy", capture_typed_invalid)

    # callable-escape-capture-untyped-wrapper-rejected: the closure's
    # untyped parameter infers the captured callable's contract: valid when
    # its callers prove Byte ...
    fn capture_untyped_accepted() errors std::compiler::CompilerError:
        static compile:
            fn take_byte(x: Byte) -> int:
                x
            fn outer(n):
                f = take_byte
                fn inner(v):
                    f(v)
                inner(n)
            outer(7)
    std::test::value("callable-escape-capture-untyped-wrapper-rejected/accepted", 7, capture_untyped_accepted)

    # ... rejected when they do not.
    fn capture_untyped_rejected() errors std::compiler::CompilerError:
        static compile:
            fn take_byte(x: Byte) -> int:
                x
            fn outer(n):
                f = take_byte
                fn inner(v):
                    f(v)
                inner(n)
            fn bad():
                f = take_byte
                fn inner(v):
                    f(v)
                inner(9999)
            bad()
    std::test::rejects_containing("callable-escape-capture-untyped-wrapper-rejected/rejected", std::compiler::DiagnosticCode::Type, "argument for parameter \"v\" cannot be proven to satisfy int[Byte], the parameter type inferred from the function body", capture_untyped_rejected)

    # callable-escape-source-defined-type-alias-valid,
    # callable-escape-sparse-type-exact-alias(-invalid): source-defined
    # bounded and sparse types through an exact alias.
    fn source_type_alias() errors std::compiler::CompilerError:
        static compile:
            fn take_small(x: Small) -> int:
                x
            f = take_small
            f(7)
    std::test::value("callable-escape-source-defined-type-alias-valid", 7, source_type_alias)

    fn sparse_alias() errors std::compiler::CompilerError:
        static compile:
            fn take_mark(x: Mark) -> int:
                x
            f = take_mark
            f(4)
    std::test::value("callable-escape-sparse-type-exact-alias", 4, sparse_alias)

    fn sparse_alias_invalid() errors std::compiler::CompilerError:
        static compile:
            fn take_mark(x: Mark) -> int:
                x
            f = take_mark
            f(5)
    std::test::rejects_containing("callable-escape-sparse-type-exact-alias-invalid", std::compiler::DiagnosticCode::Type, "cannot be proven to satisfy", sparse_alias_invalid)

# ---------------------------------------------------------------------------
# Joins: an if or a function's return sites joining callables

fn register_callable_escape_join_tests():
    # callable-escape-branch-join-same-callable-ok: both branches the same
    # exact typed callable.
    fn same_callable() errors std::compiler::CompilerError:
        static compile:
            fn take_byte(x: Byte) -> int:
                x
            fn choose(cond):
                f = if cond:
                    take_byte
                else:
                    take_byte
                f(7)
            choose(true)
    std::test::value("callable-escape-branch-join-same-callable-ok", 7, same_callable)

    # callable-escape-branch-join-different-callables-structural: two
    # compatible callables join to Fn{args: [Byte], ...}: a call respecting
    # it is accepted, a call violating it rejected at the call.
    fn different_accepted() errors std::compiler::CompilerError:
        static compile:
            fn take_byte(x: Byte) -> int:
                x
            fn take_other(x):
                x
            fn choose(cond):
                f = if cond:
                    take_byte
                else:
                    take_other
                f(7)
            choose(true)
    std::test::value("callable-escape-branch-join-different-callables-structural/accepted", 7, different_accepted)

    fn different_rejected() errors std::compiler::CompilerError:
        static compile:
            fn take_byte(x: Byte) -> int:
                x
            fn take_other(x):
                x
            fn choose(cond):
                f = if cond:
                    take_byte
                else:
                    take_other
                f(9999)
            choose(true)
    std::test::rejects_containing("callable-escape-branch-join-different-callables-structural/rejected", std::compiler::DiagnosticCode::Type, "argument 1 cannot be proven to satisfy int[Byte], the parameter type the callee's function type Fn{args: [int[Byte]]", different_rejected)

    # callable-escape-branch-join-untyped-vs-typed-structural: an untyped
    # and a typed callable join to the typed contract.
    fn untyped_vs_typed_accepted() errors std::compiler::CompilerError:
        static compile:
            fn take_byte(x: Byte) -> int:
                x
            fn other(x):
                x
            fn choose(cond):
                f = if cond:
                    take_byte
                else:
                    other
                f(7)
            choose(true)
    std::test::value("callable-escape-branch-join-untyped-vs-typed-structural/accepted", 7, untyped_vs_typed_accepted)

    fn untyped_vs_typed_rejected() errors std::compiler::CompilerError:
        static compile:
            fn take_byte(x: Byte) -> int:
                x
            fn other(x):
                x
            fn choose(cond, v):
                f = if cond:
                    take_byte
                else:
                    other
                f(v)
            choose(true, 9999)
    std::test::rejects("callable-escape-branch-join-untyped-vs-typed-structural/rejected", std::compiler::DiagnosticCode::Type, untyped_vs_typed_rejected)

    # callable-escape-branch-join-incompatible-typed-rejected: no
    # representable argument meet (Byte vs str): rejected at the join.
    fn incompatible_typed() errors std::compiler::CompilerError:
        static compile:
            fn take_byte(x: Byte) -> int:
                x
            fn take_str(x: str) -> str:
                x
            fn choose(cond):
                f = if cond:
                    take_byte
                else:
                    take_str
                f(7)
            choose(true)
    std::test::rejects_containing("callable-escape-branch-join-incompatible-typed-rejected", std::compiler::DiagnosticCode::Type, "typed parameter requirements that cannot be preserved", incompatible_typed)

    # callable-escape-branch-join-two-untyped-ok: two untyped callables have
    # no precondition to lose.
    fn two_untyped() errors std::compiler::CompilerError:
        static compile:
            fn identity(x):
                x
            fn other(x):
                x
            fn choose(cond):
                f = if cond:
                    identity
                else:
                    other
                f(9999)
            choose(true)
    std::test::value("callable-escape-branch-join-two-untyped-ok", 9999, two_untyped)

    # callable-escape-return-join-different-structural: a function's return
    # sites joining two compatible callables return their Fn, checked at
    # the caller.
    fn return_join_accepted() errors std::compiler::CompilerError:
        static compile:
            fn take_byte(x: Byte) -> int:
                x
            fn take_other(x):
                x
            fn chooser(cond):
                if cond:
                    return take_byte
                take_other
            chooser(true)(7)
    std::test::value("callable-escape-return-join-different-structural/accepted", 7, return_join_accepted)

    fn return_join_rejected() errors std::compiler::CompilerError:
        static compile:
            fn take_byte(x: Byte) -> int:
                x
            fn take_other(x):
                x
            fn chooser(cond):
                if cond:
                    return take_byte
                take_other
            chooser(true)(9999)
    std::test::rejects("callable-escape-return-join-different-structural/rejected", std::compiler::DiagnosticCode::Type, return_join_rejected)

# ---------------------------------------------------------------------------
# A parameter declared `any`: no obligation of its caller's

fn register_callable_escape_any_tests(run: bool):
    # callable-escape-any-parameters-unrestricted: a function whose every
    # parameter is declared `any` obliges a caller to nothing an untyped one
    # does not, so each erasing position accepts it as it accepts the untyped
    # function (each block holds both) -- and the erased value still calls
    # it. RUN is false: comparing callables (native-argument) would raise
    # EQUALITY at run time, which no handler catches.
    fn any_native_argument() errors std::compiler::CompilerError:
        static compile:
            fn any_only(c: any, d: any) -> bool:
                c == d
            fn untyped(c, d) -> bool:
                c == d
            if run:
                [any_only == any_only, untyped == untyped]
            else:
                [false, false]
    std::test::value("callable-escape-any-parameters-unrestricted/native-argument", [false, false], any_native_argument)

    fn any_list_element() errors std::compiler::CompilerError:
        static compile:
            fn any_only(c: any, d: any) -> bool:
                c == d
            fn untyped(c, d) -> bool:
                c == d
            xs = [any_only, 5]
            ys = [untyped, 5]
            [std::list::length(xs), std::list::length(ys)]
    std::test::value("callable-escape-any-parameters-unrestricted/list-element", [2, 2], any_list_element)

    fn any_any_parameter() errors std::compiler::CompilerError:
        static compile:
            fn any_only(c: any, d: any) -> bool:
                c == d
            fn untyped(c, d) -> bool:
                c == d
            fn keep(v: any):
                v
            [keep(any_only)(1, 1), keep(untyped)(1, 2)]
    std::test::value("callable-escape-any-parameters-unrestricted/any-parameter", [true, false], any_any_parameter)

    fn any_if_join() errors std::compiler::CompilerError:
        static compile:
            fn any_only(c: any, d: any) -> bool:
                c == d
            fn untyped(c, d) -> bool:
                c == d
            fn pick(flag):
                if flag:
                    any_only
                else:
                    5
            fn pick_untyped(flag):
                if flag:
                    untyped
                else:
                    5
            [pick(true)(2, 2), pick_untyped(true)(2, 3)]
    std::test::value("callable-escape-any-parameters-unrestricted/if-join", [true, false], any_if_join)

    fn any_return() errors std::compiler::CompilerError:
        static compile:
            fn any_only(c: any, d: any) -> bool:
                c == d
            fn untyped(c, d) -> bool:
                c == d
            fn pick(flag):
                if flag:
                    return any_only
                5
            fn pick_untyped(flag):
                if flag:
                    return untyped
                5
            [pick(true)(3, 3), pick_untyped(true)(3, 4)]
    std::test::value("callable-escape-any-parameters-unrestricted/return", [true, false], any_return)

    fn any_any_field() errors std::compiler::CompilerError:
        static compile:
            fn any_only(c: any, d: any) -> bool:
                c == d
            fn untyped(c, d) -> bool:
                c == d
            a = AnyBox {value: any_only}
            u = AnyBox {value: untyped}
            fa = a.value
            fu = u.value
            [fa(4, 4), fu(4, 5)]
    std::test::value("callable-escape-any-parameters-unrestricted/any-field", [true, false], any_any_field)

    fn any_struct_element() errors std::compiler::CompilerError:
        static compile:
            fn any_only(c: any, d: any) -> bool:
                c == d
            fn untyped(c, d) -> bool:
                c == d
            s = {handler: any_only}
            t = {handler: untyped}
            xs = [s, 5, t]
            std::list::length(xs)
    std::test::value("callable-escape-any-parameters-unrestricted/struct-element", 3, any_struct_element)

    fn any_applied_struct_element() errors std::compiler::CompilerError:
        static compile:
            fn any_only(c: any, d: any) -> bool:
                c == d
            fn untyped(c, d) -> bool:
                c == d
            c = Cell {value: any_only}
            d = Cell {value: untyped}
            xs = [c, 5, d]
            std::list::length(xs)
    std::test::value("callable-escape-any-parameters-unrestricted/applied-struct-element", 3, any_applied_struct_element)

    fn any_collected_element() errors std::compiler::CompilerError:
        static compile:
            fn any_only(c: any, d: any) -> bool:
                c == d
            fn untyped(c, d) -> bool:
                c == d
            nested = [[[any_only]]]
            nested_untyped = [[[untyped]]]
            ys = loop x in [1]:
                nested
            zs = loop x in [1]:
                nested_untyped
            [std::list::length(ys), std::list::length(zs)]
    std::test::value("callable-escape-any-parameters-unrestricted/collected-element", [1, 1], any_collected_element)

    # callable-escape-any-beside-typed-parameter-rejected: one typed
    # parameter beside `any` ones still bears, and every erasing position
    # rejects the function.
    fn mixed_native_argument() errors std::compiler::CompilerError:
        static compile:
            fn mixed(c: any, d: int) -> bool:
                c == d
            mixed == mixed
    std::test::rejects_containing("callable-escape-any-beside-typed-parameter-rejected/native-argument", std::compiler::DiagnosticCode::Type, "typed parameter requirements that cannot be preserved", mixed_native_argument)

    fn mixed_list_element() errors std::compiler::CompilerError:
        static compile:
            fn mixed(c: any, d: int) -> bool:
                c == d
            xs = [mixed, 5]
            xs
    std::test::rejects_containing("callable-escape-any-beside-typed-parameter-rejected/list-element", std::compiler::DiagnosticCode::Type, "typed parameter requirements that cannot be preserved", mixed_list_element)

    fn mixed_any_parameter() errors std::compiler::CompilerError:
        static compile:
            fn mixed(c: any, d: int) -> bool:
                c == d
            fn keep(v: any):
                v
            keep(mixed)
    std::test::rejects_containing("callable-escape-any-beside-typed-parameter-rejected/any-parameter", std::compiler::DiagnosticCode::Type, "typed parameter requirements that cannot be preserved", mixed_any_parameter)

    fn mixed_if_join() errors std::compiler::CompilerError:
        static compile:
            fn mixed(c: any, d: int) -> bool:
                c == d
            fn pick(flag):
                if flag:
                    mixed
                else:
                    5
            pick(true)
    std::test::rejects_containing("callable-escape-any-beside-typed-parameter-rejected/if-join", std::compiler::DiagnosticCode::Type, "typed parameter requirements that cannot be preserved", mixed_if_join)

    fn mixed_return() errors std::compiler::CompilerError:
        static compile:
            fn mixed(c: any, d: int) -> bool:
                c == d
            fn pick(flag):
                if flag:
                    return mixed
                5
            pick(true)
    std::test::rejects_containing("callable-escape-any-beside-typed-parameter-rejected/return", std::compiler::DiagnosticCode::Type, "typed parameter requirements that cannot be preserved", mixed_return)

    fn mixed_any_field() errors std::compiler::CompilerError:
        static compile:
            fn mixed(c: any, d: int) -> bool:
                c == d
            b = AnyBox {value: mixed}
            b
    std::test::rejects_containing("callable-escape-any-beside-typed-parameter-rejected/any-field", std::compiler::DiagnosticCode::Type, "typed parameter requirements that cannot be preserved", mixed_any_field)

    fn mixed_struct_element() errors std::compiler::CompilerError:
        static compile:
            fn mixed(c: any, d: int) -> bool:
                c == d
            s = {handler: mixed}
            xs = [s, 5]
            xs
    std::test::rejects_containing("callable-escape-any-beside-typed-parameter-rejected/struct-element", std::compiler::DiagnosticCode::Type, "typed parameter requirements that cannot be preserved", mixed_struct_element)

    fn mixed_applied_struct_element() errors std::compiler::CompilerError:
        static compile:
            fn mixed(c: any, d: int) -> bool:
                c == d
            c = Cell {value: mixed}
            xs = [c, 5]
            xs
    std::test::rejects_containing("callable-escape-any-beside-typed-parameter-rejected/applied-struct-element", std::compiler::DiagnosticCode::Type, "typed parameter requirements that cannot be preserved", mixed_applied_struct_element)

    fn mixed_collected_element() errors std::compiler::CompilerError:
        static compile:
            fn mixed(c: any, d: int) -> bool:
                c == d
            nested = [[[mixed]]]
            ys = loop x in [1]:
                nested
            ys
    std::test::rejects_containing("callable-escape-any-beside-typed-parameter-rejected/collected-element", std::compiler::DiagnosticCode::Type, "typed parameter requirements that cannot be preserved", mixed_collected_element)

    # callable-escape-any-parameters-with-errors-rejected: a declared error
    # set still bears when every parameter is `any`: every erasing position
    # rejects the function (NotFound, the suite's declaration, for the Tcl
    # test's Oops).
    fn errs_native_argument() errors std::compiler::CompilerError:
        static compile:
            fn errs(c: any, d: any) -> bool errors NotFound:
                if c == d:
                    fail NotFound
                true
            errs == errs
    std::test::rejects_containing("callable-escape-any-parameters-with-errors-rejected/native-argument", std::compiler::DiagnosticCode::Type, "typed parameter requirements that cannot be preserved", errs_native_argument)

    fn errs_list_element() errors std::compiler::CompilerError:
        static compile:
            fn errs(c: any, d: any) -> bool errors NotFound:
                if c == d:
                    fail NotFound
                true
            xs = [errs, 5]
            xs
    std::test::rejects_containing("callable-escape-any-parameters-with-errors-rejected/list-element", std::compiler::DiagnosticCode::Type, "typed parameter requirements that cannot be preserved", errs_list_element)

    fn errs_any_parameter() errors std::compiler::CompilerError:
        static compile:
            fn errs(c: any, d: any) -> bool errors NotFound:
                if c == d:
                    fail NotFound
                true
            fn keep(v: any):
                v
