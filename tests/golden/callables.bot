    std::test::rejects_containing("callable-escape-any-parameters-with-errors-rejected/any-parameter", std::compiler::DiagnosticCode::Type, "typed parameter requirements that cannot be preserved", errs_any_parameter)

    fn errs_if_join() errors std::compiler::CompilerError:
        static compile:
            fn errs(c: any, d: any) -> bool errors NotFound:
                if c == d:
                    fail NotFound
                true
            fn pick(flag):
                if flag:
                    errs
                else:
                    5
            pick(true)
    std::test::rejects_containing("callable-escape-any-parameters-with-errors-rejected/if-join", std::compiler::DiagnosticCode::Type, "typed parameter requirements that cannot be preserved", errs_if_join)

    fn errs_return() errors std::compiler::CompilerError:
        static compile:
            fn errs(c: any, d: any) -> bool errors NotFound:
                if c == d:
                    fail NotFound
                true
            fn pick(flag):
                if flag:
                    return errs
                5
            pick(true)
    std::test::rejects_containing("callable-escape-any-parameters-with-errors-rejected/return", std::compiler::DiagnosticCode::Type, "typed parameter requirements that cannot be preserved", errs_return)

    fn errs_any_field() errors std::compiler::CompilerError:
        static compile:
            fn errs(c: any, d: any) -> bool errors NotFound:
                if c == d:
                    fail NotFound
                true
            b = AnyBox {value: errs}
            b
    std::test::rejects_containing("callable-escape-any-parameters-with-errors-rejected/any-field", std::compiler::DiagnosticCode::Type, "typed parameter requirements that cannot be preserved", errs_any_field)

    fn errs_struct_element() errors std::compiler::CompilerError:
        static compile:
            fn errs(c: any, d: any) -> bool errors NotFound:
                if c == d:
                    fail NotFound
                true
            s = {handler: errs}
            xs = [s, 5]
            xs
    std::test::rejects_containing("callable-escape-any-parameters-with-errors-rejected/struct-element", std::compiler::DiagnosticCode::Type, "typed parameter requirements that cannot be preserved", errs_struct_element)

    fn errs_applied_struct_element() errors std::compiler::CompilerError:
        static compile:
            fn errs(c: any, d: any) -> bool errors NotFound:
                if c == d:
                    fail NotFound
                true
            c = Cell {value: errs}
            xs = [c, 5]
            xs
    std::test::rejects_containing("callable-escape-any-parameters-with-errors-rejected/applied-struct-element", std::compiler::DiagnosticCode::Type, "typed parameter requirements that cannot be preserved", errs_applied_struct_element)

    fn errs_collected_element() errors std::compiler::CompilerError:
        static compile:
            fn errs(c: any, d: any) -> bool errors NotFound:
                if c == d:
                    fail NotFound
                true
            nested = [[[errs]]]
            ys = loop x in [1]:
                nested
            ys
    std::test::rejects_containing("callable-escape-any-parameters-with-errors-rejected/collected-element", std::compiler::DiagnosticCode::Type, "typed parameter requirements that cannot be preserved", errs_collected_element)

fn register_typed_callable_escape_tests():
    register_callable_escape_helper_tests(false)
    register_callable_escape_identity_tests()
    register_callable_escape_join_tests()
    register_callable_escape_any_tests(false)

# ===========================================================================
# tests/closure-int-keys.test: closures with a String capture called with
# Ints (the inner<int> keys), on every backend

fn register_closure_int_keys_tests():
    # closure-int-keys-parity-int: Int arguments of a closure capturing a
    # String.
    fn parity_int() errors std::compiler::CompilerError:
        static compile:
            fn outer(tag):
                fn inner(x):
                    x + std::str::length(tag)
                inner(1) + inner(2)
            outer("v")
    std::test::value("closure-int-keys-parity-int", 5, parity_int)

    # closure-int-keys-parity-mixed: String and Int arguments of one closure.
    fn parity_mixed() errors std::compiler::CompilerError:
        static compile:
            fn outer(tag):
                fn inner(x):
                    std::str::concat(tag, "")
                    x
                [inner(tag), inner(1), inner(2)]
            outer("v")
    std::test::value("closure-int-keys-parity-mixed", ["v", 1, 2], parity_mixed)

    # closure-int-keys-parity-scanner: nested closures over a String and an
    # Int bound, called with Int positions. Strict: at's std::str::substring
    # handles LowerUnderrun and UpperOverrun (never raised: every index is
    # in range).
    fn parity_scanner() errors std::compiler::CompilerError:
        static compile:
            fn first_space(s):
                n = std::str::length(s)
                fn at(i):
                    c = std::str::substring(s, i, i + 1):
                        on LowerUnderrun:
                            ""
                        on UpperOverrun:
                            ""
                    c
                fn scan(start):
                    loop i from start to n:
                        if at(i) == " ":
                            return i
                    n
                fn tail(i):
                    e = scan(i)
                    e - i
                [scan(0), tail(1), tail(n)]
            [first_space("abc def"), first_space("abcdef"), first_space("")]
    std::test::value("closure-int-keys-parity-scanner", [[3, 2, 0], [6, 5, 0], [0, -1, 0]], parity_scanner)

# ===========================================================================
# tests/exact-callable-key.test: exact callables through higher-order
# helpers compute the same value on every backend

# ---------------------------------------------------------------------------
# One target, several targets, the budget

fn register_exact_callable_target_tests():
    # exact-callable-botlish-single-value: one exact function.
    fn botlish_single() errors std::compiler::CompilerError:
        static compile:
            fn inc(x):
                x + 1
            fn apply_loop(f, i, n):
                loop j from i to n:
                    if f(j) > 41:
                        return j + 1
                n
            apply_loop(inc, 0, 100)
    std::test::value("exact-callable-botlish-single-value", 42, botlish_single)

    # exact-callable-native-single-value (and exact-callable-gc-exact-
    # native-region's program): one exact native over a substring.
    fn native_single() errors std::compiler::CompilerError:
        static compile:
            fn count_while(p, s):
                loop i from 0 to std::str::length(s):
                    if p(std::str::substring(s, i, i + 1)):
                        continue
                    return i
                std::str::length(s)
            count_while(std::str::is_tcl_alpha, "abc1")
    std::test::value("exact-callable-native-single-value", 3, native_single)

    # exact-callable-mixed-parity: one helper, a function and a native.
    fn mixed() errors std::compiler::CompilerError:
        static compile:
            fn bot_alpha(c):
                std::str::is_tcl_alpha(c) or c == "_"
            fn count_while(p, s):
                loop i from 0 to std::str::length(s):
                    if p(std::str::substring(s, i, i + 1)):
                        continue
                    return i
                std::str::length(s)
            [count_while(bot_alpha, "ab_c1"), count_while(std::str::is_tcl_alpha, "abc1")]
    std::test::value("exact-callable-mixed-parity", [4, 3], mixed)

    # exact-callable-two-botlish-two-natives.
    fn two_and_two() errors std::compiler::CompilerError:
        static compile:
            fn lt5(x):
                x < 5
            fn lt9(x):
                x < 9
            fn run(f, n):
                loop j from 0 to n:
                    if f(j) == false:
                        return j
                n
            fn alpha_run(p, s):
                loop j from 0 to std::str::length(s):
                    if p(std::str::substring(s, j, j + 1)):
                        continue
                    return j
                std::str::length(s)
            [run(lt5, 100), run(lt9, 100), alpha_run(std::str::is_tcl_alpha, "ab1"), alpha_run(std::str::is_tcl_alnum, "ab1_")]
    std::test::value("exact-callable-two-botlish-two-natives", [5, 9, 2, 3], two_and_two)

    # exact-callable-budget-fallback-correct: six targets of one helper,
    # more than the per-helper budget (4 by default), so the shared
    # fallback instance runs too (the Tcl test generates this program,
    # budgetProgram 6, and forces a budget of 2).
    fn budget_fallback() errors std::compiler::CompilerError:
        static compile:
            fn p1(x):
                x < 3
            fn p2(x):
                x < 6
            fn p3(x):
                x < 9
            fn p4(x):
                x < 12
            fn p5(x):
                x < 15
            fn p6(x):
                x < 18
            fn apply_loop(f, i, n):
                loop j from i to n:
                    if f(j) == false:
                        return j
                n
            [apply_loop(p1, 0, 100), apply_loop(p2, 0, 100), apply_loop(p3, 0, 100), apply_loop(p4, 0, 100), apply_loop(p5, 0, 100), apply_loop(p6, 0, 100)]
    std::test::value("exact-callable-budget-fallback-correct", [3, 6, 9, 12, 15, 18], budget_fallback)

# ---------------------------------------------------------------------------
# Dynamic controls: a callable chosen at run time

fn register_exact_callable_dynamic_tests():
    # exact-callable-dynamic-if-chosen: a predicate chosen by if.
    fn if_chosen() errors std::compiler::CompilerError:
        static compile:
            fn a_alpha(c):
                std::str::is_tcl_alpha(c)
            fn b_alnum(c):
                std::str::is_tcl_alnum(c)
            fn count_while(p, s):
                loop i from 0 to std::str::length(s):
                    if p(std::str::substring(s, i, i + 1)):
                        continue
                    return i
                std::str::length(s)
            fn pick(flag):
                if flag:
                    a_alpha
                else:
                    b_alnum
            [count_while(pick(true), "ab1"), count_while(pick(false), "12a_")]
    std::test::value("exact-callable-dynamic-if-chosen", [2, 3], if_chosen)

    # exact-callable-dynamic-list-held: a callable read from a List. Strict:
    # nth handles std::list::at's IndexNotFound (never raised).
    fn list_held() errors std::compiler::CompilerError:
        static compile:
            fn a_alpha(c):
                std::str::is_tcl_alpha(c)
            fn b_alnum(c):
                std::str::is_tcl_alnum(c)
            fn count_while(p, s):
                loop i from 0 to std::str::length(s):
                    if p(std::str::substring(s, i, i + 1)):
                        continue
                    return i
                std::str::length(s)
            fn nth(preds, k):
                p = std::list::at(preds, k):
                    on IndexNotFound:
                        b_alnum
                p
            preds = [a_alpha, b_alnum]
            [count_while(nth(preds, 0), "ab1"), count_while(nth(preds, 1), "12a_")]
    std::test::value("exact-callable-dynamic-list-held", [2, 3], list_held)

    # exact-callable-escaping-exact-stays-sound: an exact callable also
    # stored in a List and called through a read.
    fn escaping() errors std::compiler::CompilerError:
        static compile:
            fn is_small(x):
                x < 10
            fn apply_loop(f, i, n):
                loop j from i to n:
                    if f(j) == false:
                        return j
                n
            fs = [is_small]
            [apply_loop(is_small, 0, 100), std::list::at(fs, 0)(3)]
    std::test::value("exact-callable-escaping-exact-stays-sound", [10, true], escaping)

# ---------------------------------------------------------------------------
# Alias, returned callable, recursion, forwarding

fn register_exact_callable_flow_tests(some_small: List[int], none_big: List[int]):
    # exact-callable-alias: p = is_small; q = p.
    fn alias() errors std::compiler::CompilerError:
        static compile:
            fn is_small(x):
                x < 10
            fn apply_loop(f, i, n):
                loop j from i to n:
                    if f(j) == false:
                        return j
                n
            p = is_small
            q = p
            apply_loop(q, 0, 100)
    std::test::value("exact-callable-alias", 10, alias)

    # exact-callable-function-returned: make() returns the callable.
    fn function_returned() errors std::compiler::CompilerError:
        static compile:
            fn is_small(x):
                x < 10
            fn make():
                is_small
            fn apply_loop(f, i, n):
                loop j from i to n:
                    if f(j) == false:
                        return j
                n
            apply_loop(make(), 0, 100)
    std::test::value("exact-callable-function-returned", 10, function_returned)

    # exact-callable-recursive-hof: the predicate carried through every
    # level of a tail recursion.
    fn recursive_hof() errors std::compiler::CompilerError:
        static compile:
            fn is_small(x):
                x < 10
            fn count_up(p, i, n):
                if i >= n:
                    return i
                if p(i):
                    return count_up(p, i + 1, n)
                i
            count_up(is_small, 0, 100)
    std::test::value("exact-callable-recursive-hof", 10, recursive_hof)

    # exact-callable-non-tail-recursive-hof: ... and of a non-tail one.
    fn non_tail_recursive_hof() errors std::compiler::CompilerError:
        static compile:
            fn is_small(x):
                x < 10
            fn is_big(x):
                x > 10
            fn depth(p, i, n):
                if i >= n:
                    return 0
                if p(i):
                    return 1 + depth(p, i + 1, n)
                0
            [depth(is_small, 0, 100), depth(is_big, 0, 100), depth(is_small, 20, 100)]
    std::test::value("exact-callable-non-tail-recursive-hof", [10, 0, 0], non_tail_recursive_hof)

    # exact-callable-recursion-new-closure-each-level: a new closure around
    # the predicate at every level (compilation terminates).
    fn new_closure_each_level() errors std::compiler::CompilerError:
        static compile:
            fn is_small(x):
                x < 10
            fn walk(p, i, n):
                if i >= n:
                    return i
                fn next(x):
                    p(x)
                if p(i):
                    return walk(next, i + 1, n)
                i
            walk(is_small, 0, 50)
    std::test::value("exact-callable-recursion-new-closure-each-level", 10, new_closure_each_level)

    # exact-callable-forwarded-through-layers: forwarded through two helper
    # layers and composed in all four combinations.
    fn forwarded() errors std::compiler::CompilerError:
        static compile:
            fn twice(f, x):
                f(f(x))
            fn apply_twice(g, y):
                twice(g, y)
            fn inc(n):
                n + 1
            fn dbl(n):
                n * 2
            fn compose(f, g, x):
                f(g(x))
            [apply_twice(inc, 5), apply_twice(dbl, 5), compose(inc, dbl, 5), compose(dbl, inc, 5), compose(inc, inc, 5), compose(dbl, dbl, 5)]
    std::test::value("exact-callable-forwarded-through-layers", [7, 20, 11, 12, 7, 20], forwarded)

    # exact-callable-typed-callable-with-errors: typed callables through a
    # helper declaring NotFound, which reaches the handler at run time (the
    # Lists searched are the parameters SOME_SMALL and NONE_BIG, so that the
    # failure is decided at run time).
    fn typed_with_errors() errors std::compiler::CompilerError:
        static compile:
            fn find_first(p, xs: List[int]) -> int errors NotFound:
                loop x in xs:
                    if p(x):
                        return x
                fail NotFound
            fn small?(n: int) -> bool:
                n < 4
            fn big?(n: int) -> bool:
                n > 100
            r1 = find_first(small?, some_small):
                on NotFound:
                    -2
            r2 = find_first(big?, none_big):
                on NotFound:
                    -1
            [r1, r2]
    std::test::value("exact-callable-typed-callable-with-errors", [3, -1], typed_with_errors)

# ---------------------------------------------------------------------------
# Identity: never a printed name, never a signature

fn register_exact_callable_identity_tests():
    # exact-callable-same-name-different-blocks: two functions named pred
    # in different scopes are two targets (keyed by name, both would give 5).
    fn same_name() errors std::compiler::CompilerError:
        static compile:
            fn apply_loop(f, i, n):
                loop j from i to n:
                    if f(j) == false:
                        return j
                n
            fn left():
                fn pred(x):
                    x < 5
                apply_loop(pred, 0, 100)
            fn right():
                fn pred(x):
                    x < 7
                apply_loop(pred, 0, 100)
            [left(), right()]
    std::test::value("exact-callable-same-name-different-blocks", [5, 7], same_name)

    # exact-callable-natives-same-signature: two natives of one type.
    fn natives_same_signature() errors std::compiler::CompilerError:
        static compile:
            fn alpha_run(p, s):
                loop j from 0 to std::str::length(s):
                    if p(std::str::substring(s, j, j + 1)):
                        continue
                    return j
                std::str::length(s)
            [alpha_run(std::str::is_tcl_alpha, "ab1"), alpha_run(std::str::is_tcl_alnum, "ab1_")]
    std::test::value("exact-callable-natives-same-signature", [2, 3], natives_same_signature)

    # exact-callable-blocks-same-signature: two functions of one type.
    fn blocks_same_signature() errors std::compiler::CompilerError:
        static compile:
            fn lt5(x):
                x < 5
            fn lt7(x):
                x < 7
            fn run(f, n):
                loop j from 0 to n:
                    if f(j) == false:
                        return j
                n
            [run(lt5, 100), run(lt7, 100)]
    std::test::value("exact-callable-blocks-same-signature", [5, 7], blocks_same_signature)

# ---------------------------------------------------------------------------
# Value-capturing closures as targets, and closures that call a target.
# Strict: the closures over std::str::substring with an unbounded index declare
# its LowerUnderrun and UpperOverrun (never raised), handled at the top.

fn register_exact_callable_closure_tests():
    # exact-callable-capturing-closure-direct: a closure capturing a String
    # and an Int.
    fn capturing_direct() errors std::compiler::CompilerError:
        static compile:
            fn run(s, items, n):
                fn longer(x):
                    std::str::length(x) > std::str::length(s) + n
                fn first_match(p, xs):
                    loop x in xs:
                        if p(x):
                            return x
                    ""
                first_match(longer, items)
            run("ab", ["a", "abc", "abcdef", "abcdefgh"], 2)
    std::test::value("exact-callable-capturing-closure-direct", "abcdef", capturing_direct)

    # exact-callable-capturing-closure-no-closure-allocated: one closure
    # literal called with three exact predicates.
    fn several_instances() errors std::compiler::CompilerError:
        static compile:
            fn run(s) errors LowerUnderrun, UpperOverrun:
                fn char_at(i) errors LowerUnderrun, UpperOverrun:
                    std::str::substring(s, i, i + 1)
                fn bot_alpha(c):
                    std::str::is_tcl_alpha(c)
                fn scan(start, predicate) errors LowerUnderrun, UpperOverrun:
                    loop i from start to std::str::length(s):
                        if predicate(char_at(i)):
                            continue
                        return i
                    std::str::length(s)
                [scan(0, bot_alpha), scan(0, std::str::is_tcl_alnum), scan(1, std::str::is_tcl_alpha)]
            r = run("ab1_"):
                on LowerUnderrun:
                    []
                on UpperOverrun:
                    []
            r
    std::test::value("exact-callable-capturing-closure-no-closure-allocated", [2, 3, 2], several_instances)

    # exact-callable-closure-recursion-several-instances: closures recursing
    # (tail and non-tail) with two exact predicates.
    fn closure_recursion() errors std::compiler::CompilerError:
        static compile:
            fn run(v) errors LowerUnderrun, UpperOverrun:
                fn walk(i, p) errors LowerUnderrun, UpperOverrun:
                    if i >= std::str::length(v):
                        return i
                    if p(std::str::substring(v, i, i + 1)):
                        return walk(i + 1, p)
                    i
                fn depth(i, p) errors LowerUnderrun, UpperOverrun:
                    if i >= std::str::length(v):
                        return 0
                    if p(std::str::substring(v, i, i + 1)):
                        return 1 + depth(i + 1, p)
                    0
                fn a() errors LowerUnderrun, UpperOverrun:
                    walk(0, std::str::is_tcl_alpha)
                fn b() errors LowerUnderrun, UpperOverrun:
                    walk(0, std::str::is_tcl_alnum)
                [a(), b(), depth(0, std::str::is_tcl_alpha), depth(0, std::str::is_tcl_alnum), walk(1, std::str::is_tcl_alnum)]
            r = run("ab1_"):
                on LowerUnderrun:
                    []
                on UpperOverrun:
                    []
            r
    std::test::value("exact-callable-closure-recursion-several-instances", [2, 3, 2, 3, 3], closure_recursion)

    # exact-callable-many-closures-one-target: many closures of one code
    # target, each capturing a different value.
    fn many_closures() errors std::compiler::CompilerError:
        static compile:
            fn first_match(p, xs):
                loop x in xs:
                    if p(x):
                        return x
                0
            fn go(i, k, total):
                if i > k:
                    return total
                fn big(x):
                    x > i
                go(i + 1, k, total + first_match(big, [1, 2, 3, 4, 5, 6]))
            go(1, 5, 0)
    std::test::value("exact-callable-many-closures-one-target", 20, many_closures)

    # exact-callable-captured-callable-boundary: a callable captured by a
    # nested closure, two different ones.
    fn captured_callable() errors std::compiler::CompilerError:
        static compile:
            fn outer(p, s) errors LowerUnderrun, UpperOverrun:
                fn inner(x):
                    p(x)
                fn count(i) errors LowerUnderrun, UpperOverrun:
                    if i >= std::str::length(s):
                        return i
                    if inner(std::str::substring(s, i, i + 1)):
                        return count(i + 1)
                    i
                count(0)
            fn go() errors LowerUnderrun, UpperOverrun:
                [outer(std::str::is_tcl_alpha, "ab1"), outer(std::str::is_tcl_alnum, "ab1_")]
            r = go():
                on LowerUnderrun:
                    []
                on UpperOverrun:
                    []
            r
    std::test::value("exact-callable-captured-callable-boundary", [2, 3], captured_callable)

    # exact-callable-dead-self-call-keeps-closure: the type tests integer?
    # and string? as exact targets of a recursive closure.
    fn dead_self_call() errors std::compiler::CompilerError:
        static compile:
            fn run(v) errors LowerUnderrun, UpperOverrun:
                fn walk(i, p) errors LowerUnderrun, UpperOverrun:
                    if i >= std::str::length(v):
                        return i
                    if p(std::str::substring(v, i, i + 1)):
                        return walk(i + 1, p)
                    i
                [walk(0, integer?), walk(0, string?)]
            r = run("ab1"):
                on LowerUnderrun:
                    []
                on UpperOverrun:
                    []
            r
    std::test::value("exact-callable-dead-self-call-keeps-closure", [0, 3], dead_self_call)

    # exact-callable-gc-capture-string-list: a closure capturing a String
    # and a List (strict: heavy handles std::list::at's IndexNotFound, never
    # raised).
    fn capture_string_list() errors std::compiler::CompilerError:
        static compile:
            fn run(tag, words):
                fn heavy(x):
                    w = std::list::at(words, 0):
                        on IndexNotFound:
                            ""
                    std::str::length(std::str::concat(tag, x)) > std::str::length(w) + 3
                fn first(p, xs):
                    loop x in xs:
                        if p(std::str::concat(x, tag)):
                            return x
                    ""
                first(heavy, ["a", "bbbb", "ccccccc"])
            run("xy", ["pqr", "st"])
    std::test::value("exact-callable-gc-capture-string-list", "bbbb", capture_string_list)

    # exact-callable-gc-capture-mutarray-struct: a closure capturing a
    # MutableArray (element 1 is 7) and a struct. Strict: the array is
    # built by make (a place run mutated could not be captured:
    # MUTABLE-PLACE-CAPTURE), and probe handles std::mutable_array::at's
    # IndexNotFound (never raised).
    fn capture_mutarray_struct() errors std::compiler::CompilerError:
        static compile:
            fn make():
                arr = std::mutable_array::allocate(4)
                std::mutable_array::set(arr, 1, 7)
                arr
            fn run(n):
                arr = make()
                rec = {a: 5, b: "zz"}
                fn probe(x):
                    e = std::mutable_array::at(arr, 1):
                        on IndexNotFound:
                            0
                    x + e + rec.a > n
                fn find_first(p, lo, hi):
                    loop i from lo to hi:
                        if p(i):
                            return i
                    hi
                find_first(probe, 0, 100)
            run(30)
    std::test::value("exact-callable-gc-capture-mutarray-struct", 19, capture_mutarray_struct)

fn register_exact_callable_key_tests():
    register_exact_callable_target_tests()
    register_exact_callable_dynamic_tests()
    register_exact_callable_flow_tests([7, 3, 4, 6], [1, 3, 4])
    register_exact_callable_identity_tests()
    register_exact_callable_closure_tests()

with context std::test::suite()
register_structural_fn_types_tests()
register_typed_callable_escape_tests()
register_closure_int_keys_tests()
register_exact_callable_key_tests()
std::test::report()
