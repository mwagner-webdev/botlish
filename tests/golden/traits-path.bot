# traits-path.bot -- traits as static views (TRAITS.md), in a program that
# imports a module's trait by its short name: `import type std::io::path::Path`
# makes the standard library's trait std::io::path::Path a type of this file, and
# a function over it specializes, statically, to each concrete path type it
# is given -- a refinement of str owned by another module
# (std::linux::path::LinuxPath) and a struct owned here -- with no erased path
# object.
#
# Ports two tests of tests/traits.test (the Tcl tests stay authoritative):
# the accepting half of trait-import-type (its other half, the short name
# without `import type`, is in traits.bot, which imports std::io::path alone) and
# the source half of trait-future-path-shape. They are a suite of their own
# for the `import type` and because the struct witness here needs this
# namespace's own `concat` and `text`, which traits.bot's namespace declares
# for other witnesses (one namespace declares one function per name).
#
# Imports: compiler and test (the framework); std::io::path and `import type
# std::io::path::Path` (the trait, by its short name: the property); std::linux::path
# (LinuxPath's validator); str (std::str::concat).
import std::compiler
import std::io::path
import std::linux::path
import std::str
import std::test
import type std::io::path::Path

# A Windows-like path: a struct of this namespace, joined with a backslash
# (traits.test's module winpath::WindowsPath; its `parent` and `render`
# become std::io::path::Path's `text`).
struct WindowsPath:
    text: str

fn concat(path: WindowsPath, component: str) -> WindowsPath:
    WindowsPath {text: std::str::concat(std::str::concat(path.text, "\\"), component)}

fn text(path: WindowsPath) -> str:
    path.text

# trait-import-type: the short name Path denotes the module's trait.
fn accepts_path(v: Path) -> int:
    1

# trait-future-path-shape: a non-receiver parameter and a self result.
fn somewhere(path: Path) -> Path errors std::io::path::NotAPath:
    path.concat("child")

fn register_path_trait_tests():
    fn imported_short_name() errors std::compiler::CompilerError:
        static compile:
            accepts_path(WindowsPath {text: "C:"})
    std::test::value("trait-import-type/imported", 1, imported_short_name)

    fn path_shape() errors std::compiler::CompilerError:
        static compile:
            fn linux_side(s: str) -> str:
                if std::linux::path::valid?(s):
                    p = somewhere(s):
                        on std::io::path::NotAPath:
                            return "NotAPath"
                    p.text()
                else:
                    ""
            fn windows_side(w: WindowsPath) -> str:
                p = somewhere(w):
                    on std::io::path::NotAPath:
                        return "NotAPath"
                p.text()
            [linux_side("/home"), windows_side(WindowsPath {text: "C:"})]
    std::test::value("trait-future-path-shape", ["/home/child", "C:\\child"], path_shape)

with context std::test::suite()
register_path_trait_tests()
std::test::report()
