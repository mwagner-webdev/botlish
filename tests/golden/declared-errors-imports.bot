# declared-errors-imports.bot -- module-qualified errors and the import
# rules: the source-level specification of
#
#   * authorization: a module's error is named qualified, and the spelling is
#     authorized exactly like any qualified member -- its namespace imported
#     exactly (MissingImport when only a child of it, or only other
#     namespaces, are imported), an existing namespace (UnknownNamespace), an
#     error that namespace declares (UnknownSymbol) -- in a handler, an
#     errors clause, a function type's errors list and a `fail`;
#   * the diagnostics' wording: which namespace and import are missing (and
#     that imports are exact), which errors a namespace declares, and the
#     qualified spelling of a module's error written bare outside it.
#
# Ported from tests/namespaced-errors.test, which stays authoritative
# (audit/golden/migration/fragments/declared-errors-imports.tsv maps every
# test). The Tcl tests write modules a (errors Failed and Plain) and a::sub;
# here they are the stock io (error WriteFailed) and its child std::io::path
# (errors NotAPath and NotText), and the Tcl tests' unimported module is abi.
#
# Imports: compiler and test (the framework) and std::io::path -- exactly the
# import set the theorems need: std::io::path imported and its parent io not, and
# no namespace of abi imported at all. This is why these tests are a suite
# of their own: declared-errors.bot imports abi and std::abi::bytes, so no
# error-declaring namespace there is unrelated to every import. (A suite
# always imports compiler and test, so the Tcl test's program without any
# import is the same theorem as its program importing another namespace.)
import std::compiler
import std::io::path
import std::test

fn register_import_authorization_tests():
    # nerr-import-authorization: a handler naming an error of io, whose child
    # std::io::path alone is imported, is MissingImport.
    fn b_child_import() errors std::compiler::CompilerError:
        static compile:
            fn f(x: int) -> int:
                x
            f(1):
                on std::io::WriteFailed:
                    0
    std::test::rejects("nerr-import-authorization/child-import", std::compiler::DiagnosticCode::MissingImport, b_child_import)

    # ... an error of abi, no namespace of which is imported, is MissingImport.
    fn b_unrelated_import() errors std::compiler::CompilerError:
        static compile:
            fn f(x: int) -> int:
                x
            f(1):
                on std::abi::AbiIntegerAboveRange:
                    0
    std::test::rejects("nerr-import-authorization/not-imported", std::compiler::DiagnosticCode::MissingImport, b_unrelated_import)

    # ... an error of a namespace that does not exist is UnknownNamespace.
    fn b_unknown_namespace() errors std::compiler::CompilerError:
        static compile:
            fn f(x: int) -> int:
                x
            f(1):
                on nonexistent::E:
                    0
    std::test::rejects("nerr-import-authorization/unknown-namespace", std::compiler::DiagnosticCode::UnknownNamespace, b_unknown_namespace)

    # ... an error an imported namespace does not declare is UnknownSymbol.
    fn b_unknown_error() errors std::compiler::CompilerError:
        static compile:
            fn f(x: int) -> int:
                x
            f(1):
                on std::io::path::DoesNotExist:
                    0
    std::test::rejects("nerr-import-authorization/unknown-error", std::compiler::DiagnosticCode::UnknownSymbol, b_unknown_error)

    # ... and an errors clause, a function type's errors list and a fail
    # naming an error of a namespace not imported are MissingImport.
    fn b_errors_clause() errors std::compiler::CompilerError:
        static compile:
            fn f(x: int) -> int errors std::abi::AbiIntegerAboveRange:
                x
            1
    std::test::rejects("nerr-import-authorization/errors-clause", std::compiler::DiagnosticCode::MissingImport, b_errors_clause)

    fn b_function_type() errors std::compiler::CompilerError:
        static compile:
            fn f(g: Fn{args: [int], return: int, errors: [std::abi::AbiIntegerAboveRange]}) -> int:
                1
            1
    std::test::rejects("nerr-import-authorization/function-type", std::compiler::DiagnosticCode::MissingImport, b_function_type)

    fn b_fail() errors std::compiler::CompilerError:
        static compile:
            fn f(x: int) -> int errors std::abi::AbiIntegerAboveRange:
                fail std::abi::AbiIntegerAboveRange
            1
    std::test::rejects("nerr-import-authorization/fail", std::compiler::DiagnosticCode::MissingImport, b_fail)

fn register_diagnostic_message_tests():
    # nerr-diagnostic-messages: the MissingImport message names the namespace
    # and import that are missing, and says that importing a child does not
    # import its parent.
    fn b_child_import_message() errors std::compiler::CompilerError:
        static compile:
            fn f(x: int) -> int:
                x
            f(1):
                on std::io::WriteFailed:
                    0
    std::test::rejects_message("nerr-diagnostic-messages/child-import", std::compiler::DiagnosticCode::MissingImport, "namespace \"std::io\" is not imported; add `import std::io` to use `std::io::WriteFailed` (imports are exact: `import std::io::path` does not import \"std::io\")", b_child_import_message)

    # ... the UnknownSymbol message lists the errors the namespace declares.
    fn b_unknown_error_message() errors std::compiler::CompilerError:
        static compile:
            fn f(x: int) -> int:
                x
            f(1):
                on std::io::path::DoesNotExist:
                    0
    std::test::rejects_message("nerr-diagnostic-messages/unknown-error", std::compiler::DiagnosticCode::UnknownSymbol, "namespace \"std::io::path\" has no error \"DoesNotExist\" (it declares: NotAPath, NotText)", b_unknown_error_message)

    # ... and a module's error written bare outside its module is an unknown
    # error whose message names its qualified spelling.
    fn b_bare_module_error() errors std::compiler::CompilerError:
        static compile:
            fn f(x: int) -> int:
                x
            f(1):
                on NotAPath:
                    0
    std::test::rejects_message("nerr-diagnostic-messages/bare-module-error", std::compiler::DiagnosticCode::UndeclaredError, "unknown error \"NotAPath\": no \"error NotAPath\" declaration is visible here (a module's error is named qualified outside its module: std::io::path::NotAPath)", b_bare_module_error)

with context std::test::suite()
register_import_authorization_tests()
register_diagnostic_message_tests()
std::test::report()
