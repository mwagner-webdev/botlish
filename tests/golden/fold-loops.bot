# fold-loops.bot -- folding loops (FOLD-LOOPS-MILESTONE-1.md), as a
# source-level specification:
#
# * `fold CLAUSES with intermediate acc INITIAL:` iterates exactly as `loop
#   CLAUSES:` does -- every clause form, lockstep, or none (until a break) --
#   but carries one value instead of collecting: `acc` is bound, in each
#   iteration, to the value the previous one produced (INITIAL for the
#   first); a normal completion of the body is the next one; the fold is the
#   last one, and an empty fold is INITIAL.
# * `continue` keeps the intermediate; a bare `break` ends the fold with the
#   current intermediate (never the value the body was about to produce);
#   `return` and errors leave the fold as they leave a loop.
# * The loop's operands are evaluated first, in written order, then INITIAL,
#   exactly once; the body then runs per iteration (the log tests: a
#   MutableVector place written by note()).
# * The intermediate is bound in the body only, immutable there (a
#   duplicate), shadowable in a nested scope, never visible in INITIAL, the
#   operands or after the fold, and never named like a loop variable.
# * The fold's type is the intermediate's: the join of INITIAL's and every
#   normal completion's; a join only the dynamic type covers is
#   FoldIntermediateType, an affine intermediate AffineFoldUnsupported.
# * `fold`, `with` and `intermediate` stay ordinary names elsewhere.
#
# Ported from tests/fold-loops.test, which stays authoritative and
# unchanged; a golden test keeps its Tcl test's name unless the fragment
# file (audit/golden/migration/fragments/fold-loops.tsv) records otherwise.
# What only the Tcl tests observe (HIR, Core IR and NIR text, types,
# diagnostic locations and messages, related locations, parse errors,
# -strict 0 runs) stays there. This file is generated by
# audit/fold-loops/tools/golden-port.py from the same table as its fragment.
#
# Imports: compiler and test; coroutine for yields; list, str, mutable_map
# and mutable_vector for the programs that use them.
import std::compiler
import std::coroutine
import std::list
import std::mutable_map
import std::mutable_vector
import std::str
import std::test

# Declarations the tests need (top-level only), renamed to stay apart from
# the other suites' and each other's: the Tcl programs' Range, Percent, A, B
# and their error helpers.
struct FoldRange:
    low: int
    high: int

type FoldPercent = Int in 0..100

struct FoldA:
    v: int

struct FoldB:
    v: int

error FoldBoom
error FoldBang

# Fails (FoldBoom) for an odd N: the error tests pass an N no proof decides.
fn fold_boom(n: int) -> int errors FoldBoom:
    if n.mod(2) == 1:
        fail FoldBoom
    n

fn fold_bang(n: int) -> List[int] errors FoldBang:
    if n > 0:
        fail FoldBang
    [n]

type FoldFactor = Int in 0..100

context struct FoldScale:
    factor: FoldFactor

# fold-loops-context: the body needs the installed FoldScale, so the
# registration function computes and the body compares (a body is a function
# value and cannot need a context).
fn fold_scaled(x: int, context s: FoldScale) -> int:
    x * s.factor

fn fold_scaled_sum(xs: List[int], context s: FoldScale) -> int:
    fold x in xs with intermediate acc 0:
        acc + fold_scaled(x)

fn register_fold_basics_tests():
    fn t_sum() errors std::compiler::CompilerError:
        static compile:
            fn sum(xs: List[int]) -> int:
                fold x in xs with intermediate acc 0:
                    acc + x
            [sum([1, 2, 3, 4]), sum([7]), sum([])]
    std::test::value("fold-loops-sum", [10, 7, 0], t_sum)

    fn t_empty_is_initial() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> int:
                fold x in xs with intermediate acc 42:
                    acc * 1000 + x
            f([])
    std::test::value("fold-loops-empty-is-initial", 42, t_empty_is_initial)

    fn t_singleton() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> int:
                fold x in xs with intermediate acc 5:
                    acc * 10 + x
            f([3])
    std::test::value("fold-loops-singleton", 53, t_singleton)

    fn t_order_of_iterations() errors std::compiler::CompilerError:
        static compile:
            fn digits(xs: List[int]) -> int:
                fold d in xs with intermediate n 0:
                    n * 10 + d
            digits([1, 2, 3, 4])
    std::test::value("fold-loops-order-of-iterations", 1234, t_order_of_iterations)

    fn t_count_up_to() errors std::compiler::CompilerError:
        static compile:
            fn f() -> int:
                fold i from 1 to 5 with intermediate s 0:
                    s + i
            f()
    std::test::value("fold-loops-count-up-to", 10, t_count_up_to)

    fn t_count_up_through() errors std::compiler::CompilerError:
        static compile:
            fn f() -> int:
                fold i from 1 through 5 with intermediate s 0:
                    s + i
            f()
    std::test::value("fold-loops-count-up-through", 15, t_count_up_through)

    fn t_count_down_to() errors std::compiler::CompilerError:
        static compile:
            fn f() -> int:
                fold i down from 5 to 1 with intermediate s 0:
                    s + i
            f()
    std::test::value("fold-loops-count-down-to", 14, t_count_down_to)

    fn t_count_down_through() errors std::compiler::CompilerError:
        static compile:
            fn f() -> int:
                fold i down from 5 through 1 with intermediate s 0:
                    s + i
            f()
    std::test::value("fold-loops-count-down-through", 15, t_count_down_through)

    fn t_count_up_to_empty() errors std::compiler::CompilerError:
        static compile:
            fn f() -> int:
                fold i from 5 to 1 with intermediate s 0:
                    s + i
            f()
    std::test::value("fold-loops-count-up-to-empty", 0, t_count_up_to_empty)

    fn t_count_down_empty() errors std::compiler::CompilerError:
        static compile:
            fn f() -> int:
                fold i down from 1 to 5 with intermediate s 0:
                    s + i
            f()
    std::test::value("fold-loops-count-down-empty", 0, t_count_down_empty)

    fn t_count_order() errors std::compiler::CompilerError:
        static compile:
            fn f() -> int:
                fold i down from 4 through 1 with intermediate n 0:
                    n * 10 + i
            f()
    std::test::value("fold-loops-count-order", 4321, t_count_order)

    fn t_lockstep() errors std::compiler::CompilerError:
        static compile:
            fn dot(xs: List[int]) -> int:
                fold x in xs and i from 0 to std::list::length(xs) with intermediate t 0:
                    t + x * i
            dot([5, 6, 7])
    std::test::value("fold-loops-lockstep", 20, t_lockstep)

    fn t_bare() errors std::compiler::CompilerError:
        static compile:
            fn collatz_steps(n: int) -> int:
                s = fold with intermediate st {n: n, steps: 0}:
                    if st.n == 1:
                        break
                    if st.n.mod(2) == 0:
                        {n: st.n.shift_right(1), steps: st.steps + 1}
                    else:
                        {n: st.n * 3 + 1, steps: st.steps + 1}
                s.steps
            [collatz_steps(1), collatz_steps(6), collatz_steps(27)]
    std::test::value("fold-loops-bare", [0, 8, 111], t_bare)

    fn t_bare_return() errors std::compiler::CompilerError:
        static compile:
            fn first_square_over(n: int) -> int:
                fold with intermediate i 1:
                    if i * i > n:
                        return i
                    i + 1
            first_square_over(50)
    std::test::value("fold-loops-bare-return", 8, t_bare_return)

    fn t_big_ints() errors std::compiler::CompilerError:
        static compile:
            fn f() -> int:
                fold i from 0 to 70 with intermediate p 1:
                    p * 2
            f()
    std::test::value("fold-loops-big-ints", 1180591620717411303424, t_big_ints)


fn register_fold_control_tests():
    fn t_continue_first() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> int:
                fold x in xs with intermediate acc 0:
                    if x == 2:
                        continue
                    acc + x
            f([1, 2, 3])
    std::test::value("fold-loops-continue-first", 4, t_continue_first)

    fn t_continue_after_work() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> int:
                fold x in xs with intermediate acc 0:
                    doubled = acc + x * 2
                    if doubled > 4:
                        continue
                    doubled
            f([1, 2, 3])
    std::test::value("fold-loops-continue-after-work", 2, t_continue_after_work)

    fn t_continue_every_iteration() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> int:
                fold x in xs with intermediate acc 9:
                    if x > 0:
                        continue
                    acc + x
            f([1, 2, 3])
    std::test::value("fold-loops-continue-every-iteration", 9, t_continue_every_iteration)

    fn t_break_first() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> int:
                fold x in xs with intermediate acc 7:
                    if x > 0:
                        break
                    acc + x
            f([1, 2, 3])
    std::test::value("fold-loops-break-first", 7, t_break_first)

    fn t_break_later() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> int:
                fold x in xs with intermediate acc 0:
                    if x > 2:
                        break
                    acc + x
            f([1, 2, 3, 4])
    std::test::value("fold-loops-break-later", 3, t_break_later)

    fn t_break_discards_next() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> int:
                fold x in xs with intermediate acc 0:
                    next = acc + x
                    if next > 5:
                        break
                    next
            f([1, 2, 3, 4])
    std::test::value("fold-loops-break-discards-next", 3, t_break_discards_next)

    fn t_continue_and_break() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> int:
                fold x in xs with intermediate acc 0:
                    if x < 0:
                        continue
                    if x == 0:
                        break
                    acc + x
            f([1, -5, 2, 0, 100])
    std::test::value("fold-loops-continue-and-break", 3, t_continue_and_break)

    fn t_break_in_count() errors std::compiler::CompilerError:
        static compile:
            fn f() -> int:
                fold i from 0 to 100 with intermediate acc 0:
                    if i == 3:
                        continue
                    if i == 6:
                        break
                    acc + i
            f()
    std::test::value("fold-loops-break-in-count", 12, t_break_in_count)


fn register_fold_order_tests():
    fn t_initial_once_ordered() errors std::compiler::CompilerError:
        static compile:
            fn note(place log: MutableVector[int], n: int) -> int:
                log.push(n)
                n
            fn entries(log: MutableVector[int]) -> List[int]:
                loop v in log:
                    v

            fn f() -> List[List[int]]:
                log = std::mutable_vector::from_list([0])
                r = fold x in [note(log, 1), note(log, 2)] with intermediate acc note(log, 3):
                    acc + x + note(log, 10)
                [[r], entries(log)]
            f()
    std::test::value("fold-loops-initial-once-ordered", [[26], [0, 1, 2, 3, 10, 10]], t_initial_once_ordered)

    fn t_initial_once_empty() errors std::compiler::CompilerError:
        static compile:
            fn note(place log: MutableVector[int], n: int) -> int:
                log.push(n)
                n
            fn entries(log: MutableVector[int]) -> List[int]:
                loop v in log:
                    v

            fn f() -> List[List[int]]:
                log = std::mutable_vector::from_list([0])
                r = fold x in [] with intermediate acc note(log, 5):
                    acc + note(log, 99)
                [[r], entries(log)]
            f()
    std::test::value("fold-loops-initial-once-empty", [[5], [0, 5]], t_initial_once_empty)

    fn t_initial_once_bare() errors std::compiler::CompilerError:
        static compile:
            fn note(place log: MutableVector[int], n: int) -> int:
                log.push(n)
                n
            fn entries(log: MutableVector[int]) -> List[int]:
                loop v in log:
                    v

            fn f() -> List[List[int]]:
                log = std::mutable_vector::from_list([0])
                r = fold with intermediate acc note(log, 1):
                    if acc > 3:
                        break
                    acc + note(log, 2) - 1
                [[r], entries(log)]
            f()
    std::test::value("fold-loops-initial-once-bare", [[4], [0, 1, 2, 2, 2]], t_initial_once_bare)

    fn t_count_bounds_before_initial() errors std::compiler::CompilerError:
        static compile:
            fn note(place log: MutableVector[int], n: int) -> int:
                log.push(n)
                n
            fn entries(log: MutableVector[int]) -> List[int]:
                loop v in log:
                    v

            fn f() -> List[List[int]]:
                log = std::mutable_vector::from_list([0])
                r = fold i from note(log, 1) to note(log, 3) with intermediate acc note(log, 5):
                    acc + i
                [[r], entries(log)]
            f()
    std::test::value("fold-loops-count-bounds-before-initial", [[8], [0, 1, 3, 5]], t_count_bounds_before_initial)

    fn t_statement_position() errors std::compiler::CompilerError:
        static compile:
            fn note(place log: MutableVector[int], n: int) -> int:
                log.push(n)
                n
            fn entries(log: MutableVector[int]) -> List[int]:
                loop v in log:
                    v

            fn f() -> List[int]:
                log = std::mutable_vector::from_list([0])
                fold x in [1, 2, 3] with intermediate s 0:
                    note(log, s + x)
                entries(log)
            f()
    std::test::value("fold-loops-statement-position", [0, 1, 3, 6], t_statement_position)

    fn t_discarded_fold_still_runs() errors std::compiler::CompilerError:
        static compile:
            fn note(place log: MutableVector[int], n: int) -> int:
                log.push(n)
                n
            fn entries(log: MutableVector[int]) -> List[int]:
                loop v in log:
                    v

            fn f() -> List[int]:
                log = std::mutable_vector::from_list([0])
                fold x in [1, 2, 3] with intermediate s 100:
                    note(log, s)
                    s + x
                entries(log)
            f()
    std::test::value("fold-loops-discarded-fold-still-runs", [0, 100, 101, 103], t_discarded_fold_still_runs)


fn register_fold_errors_tests(one: int, zero: int, digits: List[int]):
    fn t_initial_error() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int], k: int) -> int errors FoldBoom:
                fold x in xs with intermediate acc fold_boom(k):
                    acc + x
            fn run(k: int) -> int:
                f([1], k):
                    on FoldBoom:
                        -1
            [run(one), run(zero)]
    std::test::value("fold-loops-initial-error", [-1, 1], t_initial_error)

    fn t_iterable_error_first() errors std::compiler::CompilerError:
        static compile:
            fn f(k: int) -> int errors FoldBoom, FoldBang:
                fold x in fold_bang(k) with intermediate acc fold_boom(k):
                    acc + x
            fn run(k: int) -> int:
                f(k):
                    on FoldBoom:
                        1
                    on FoldBang:
                        2
            [run(one), run(zero)]
    std::test::value("fold-loops-iterable-error-first", [2, 0], t_iterable_error_first)

    fn t_body_error() errors std::compiler::CompilerError:
        static compile:
            fn note(place log: MutableVector[int], n: int) -> int:
                log.push(n)
                n
            fn entries(log: MutableVector[int]) -> List[int]:
                loop v in log:
                    v

            fn g(place log: MutableVector[int], xs: List[int]) -> int errors FoldBoom:
                fold x in xs with intermediate acc 0:
                    if x > 2:
                        fold_boom(x)
                    else:
                        note(log, x)
                        acc + x
            fn f(xs: List[int]) -> List[int]:
                log = std::mutable_vector::from_list([0])
                r = g(log, xs):
                    on FoldBoom:
                        -1
                [r, std::list::length(entries(log))]
            f(digits)
    std::test::value("fold-loops-body-error", [-1, 3], t_body_error)

    fn t_return() errors std::compiler::CompilerError:
        static compile:
            fn find(xs: List[int], target: int) -> int:
                total = fold x in xs with intermediate acc 0:
                    if x == target:
                        return acc
                    acc + x
                -total
            [find([1, 2, 3], 3), find([1, 2, 3], 9)]
    std::test::value("fold-loops-return", [3, -6], t_return)

    fn t_handled_in_body() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> int:
                fold x in xs with intermediate acc 0:
                    v = fold_boom(x - 1):
                        on FoldBoom:
                            100
                    acc + v
            f([1, 2, 3])
    std::test::value("fold-loops-handled-in-body", 102, t_handled_in_body)


fn register_fold_scope_tests():
    fn t_scope_does_not_leak() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> int:
                t = fold x in xs with intermediate acc 0:
                    acc + x
                acc
            f([1])
    std::test::rejects("fold-loops-scope-does-not-leak", std::compiler::DiagnosticCode::Unbound, t_scope_does_not_leak)

    fn t_not_in_scope_in_initial_initial() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> int:
                fold x in xs with intermediate acc acc:
                    acc + x
            f([1])
    std::test::rejects("fold-loops-not-in-scope-in-initial/initial", std::compiler::DiagnosticCode::Unbound, t_not_in_scope_in_initial_initial)

    fn t_not_in_scope_in_initial_operand() errors std::compiler::CompilerError:
        static compile:
            fn f() -> int:
                fold i from 0 to acc with intermediate acc 0:
                    acc + i
            f()
    std::test::rejects("fold-loops-not-in-scope-in-initial/operand", std::compiler::DiagnosticCode::Unbound, t_not_in_scope_in_initial_operand)

    fn t_immutable() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> int:
                fold x in xs with intermediate acc 0:
                    acc = acc + x
                    acc
            f([1])
    std::test::rejects("fold-loops-immutable", std::compiler::DiagnosticCode::Duplicate, t_immutable)

    fn t_shadow_in_branch() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> int:
                fold x in xs with intermediate acc 0:
                    if x > 1:
                        acc = 100
                        acc + x
                    else:
                        acc + x
            f([1, 2, 3])
    std::test::value("fold-loops-shadow-in-branch", 103, t_shadow_in_branch)

    fn t_shadows_outer() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> List[int]:
                acc = 1000
                r = fold x in xs with intermediate acc 0:
                    acc + x
                [r, acc]
            f([1, 2])
    std::test::value("fold-loops-shadows-outer", [3, 1000], t_shadows_outer)

    fn t_duplicate_name_single() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> int:
                fold x in xs with intermediate x 0:
                    x
            f([1])
    std::test::rejects("fold-loops-duplicate-name/single", std::compiler::DiagnosticCode::DuplicateLoopVariable, t_duplicate_name_single)

    fn t_duplicate_name_lockstep() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> int:
                fold x in xs and i from 0 to std::list::length(xs) with intermediate i 0:
                    x
            f([1])
    std::test::rejects("fold-loops-duplicate-name/lockstep", std::compiler::DiagnosticCode::DuplicateLoopVariable, t_duplicate_name_lockstep)


fn register_fold_nesting_tests():
    fn t_nested_folds() errors std::compiler::CompilerError:
        static compile:
            fn f(rows: List[List[int]]) -> int:
                fold row in rows with intermediate total 0:
                    row_sum = fold v in row with intermediate s 0:
                        s + v
                    total * 100 + row_sum
            f([[1, 2], [3, 4], [5]])
    std::test::value("fold-loops-nested-folds", 30705, t_nested_folds)

    fn t_nested_break_targets_inner() errors std::compiler::CompilerError:
        static compile:
            fn f(rows: List[List[int]]) -> int:
                fold row in rows with intermediate total 0:
                    capped = fold v in row with intermediate s 0:
                        if v > 9:
                            break
                        s + v
                    total + capped
            f([[1, 20, 2], [3, 4]])
    std::test::value("fold-loops-nested-break-targets-inner", 8, t_nested_break_targets_inner)

    fn t_nested_continue_targets_inner() errors std::compiler::CompilerError:
        static compile:
            fn f(rows: List[List[int]]) -> int:
                fold row in rows with intermediate total 0:
                    evens = fold v in row with intermediate s 0:
                        if v.mod(2) == 1:
                            continue
                        s + v
                    total + evens
            f([[1, 2, 3, 4], [6, 7]])
    std::test::value("fold-loops-nested-continue-targets-inner", 12, t_nested_continue_targets_inner)

    fn t_loop_in_fold() errors std::compiler::CompilerError:
        static compile:
            fn f(rows: List[List[int]]) -> int:
                fold row in rows with intermediate n 0:
                    prefix = loop v in row:
                        if v < 0:
                            break
                        v
                    n + std::list::length(prefix)
            f([[1, 2, -1, 4], [5]])
    std::test::value("fold-loops-loop-in-fold", 3, t_loop_in_fold)

    fn t_fold_in_loop() errors std::compiler::CompilerError:
        static compile:
            fn f(rows: List[List[int]]) -> List[int]:
                loop row in rows:
                    if row == []:
                        continue
                    fold v in row with intermediate m 0:
                        if v > m:
                            v
                        else:
                            m
            f([[3, 9, 2], [], [4]])
    std::test::value("fold-loops-fold-in-loop", [9, 4], t_fold_in_loop)

    fn t_fold_break_in_loop_body() errors std::compiler::CompilerError:
        static compile:
            fn f(rows: List[List[int]]) -> List[int]:
                loop row in rows:
                    fold v in row with intermediate s 0:
                        if v == 0:
                            break
                        s + v
            f([[1, 0, 5], [2, 3]])
    std::test::value("fold-loops-fold-break-in-loop-body", [1, 5], t_fold_break_in_loop_body)


fn register_fold_positions_tests():
    fn t_positions() errors std::compiler::CompilerError:
        static compile:
            fn twice(n: int) -> int:
                n * 2
            fn a(xs: List[int]) -> int:
                t = fold x in xs with intermediate s 0:
                    s + x
                twice(t)
            fn b(xs: List[int]) -> int:
                return fold x in xs with intermediate s 1:
                    s * x
            fn c(xs: List[int], flag: bool) -> int:
                if flag:
                    fold x in xs with intermediate s 0:
                        s - x
                else:
                    0
            xs = [1, 2, 3]
            [a(xs), b(xs), c(xs, true), c(xs, false)]
    std::test::value("fold-loops-positions", [12, 6, -6, 0], t_positions)

    fn t_top_level() errors std::compiler::CompilerError:
        static compile:
            fold x in [1, 2, 3] with intermediate s 10:
                s + x
    std::test::value("fold-loops-top-level", 16, t_top_level)


fn register_fold_intermediates_tests():
    fn t_bool() errors std::compiler::CompilerError:
        static compile:
            fn all_positive(xs: List[int]) -> bool:
                fold x in xs with intermediate ok true:
                    ok and x > 0
            [all_positive([1, 2]), all_positive([1, -2]), all_positive([])]
    std::test::value("fold-loops-bool", [true, false, true], t_bool)

    fn t_string() errors std::compiler::CompilerError:
        static compile:
            fn join(xs: List[str]) -> str:
                fold x in xs with intermediate out "":
                    if out == "":
                        x
                    else:
                        out.concat(", ").concat(x)
            join(["a", "bc", "d"])
    std::test::value("fold-loops-string", "a, bc, d", t_string)

    fn t_list() errors std::compiler::CompilerError:
        static compile:
            fn evens(xs: List[int]) -> List[int]:
                fold x in xs with intermediate out []:
                    if x.mod(2) == 0:
                        out.append(x)
                    else:
                        out
            evens([1, 2, 3, 4, 6])
    std::test::value("fold-loops-list", [2, 4, 6], t_list)

    fn t_struct() errors std::compiler::CompilerError:
        static compile:
            fn stats(xs: List[int]) -> List[int]:
                s = fold x in xs with intermediate st {n: 0, sum: 0, max: 0}:
                    m = if x > st.max:
                        x
                    else:
                        st.max
                    {n: st.n + 1, sum: st.sum + x, max: m}
                [s.n, s.sum, s.max]
            stats([3, 9, 4])
    std::test::value("fold-loops-struct", [3, 16, 9], t_struct)

    fn t_named_struct() errors std::compiler::CompilerError:
        static compile:
            fn bounds(xs: List[int]) -> FoldRange:
                fold x in xs with intermediate r FoldRange {low: 1000, high: -1000}:
                    lo = if x < r.low:
                        x
                    else:
                        r.low
                    hi = if x > r.high:
                        x
                    else:
                        r.high
                    FoldRange {low: lo, high: hi}
            b = bounds([4, -2, 7])
            [b.low, b.high]
    std::test::value("fold-loops-named-struct", [-2, 7], t_named_struct)

    fn t_nested_struct() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> List[int]:
                s = fold x in xs with intermediate st {pos: {line: 1, col: 0}, seen: []}:
                    if x == 0:
                        {pos: {line: st.pos.line + 1, col: 0}, seen: st.seen}
                    else:
                        {pos: {line: st.pos.line, col: st.pos.col + 1}, seen: st.seen.append(x)}
                [s.pos.line, s.pos.col, std::list::length(s.seen)]
            f([5, 6, 0, 7])
    std::test::value("fold-loops-nested-struct", [2, 1, 3], t_nested_struct)

    fn t_list_of_lists() errors std::compiler::CompilerError:
        static compile:
            fn chunks(xs: List[int]) -> List[List[int]]:
                fold x in xs with intermediate out []:
                    if x == 0:
                        out
                    elif x == 1:
                        out.append([x])
                    else:
                        out.append([x, x]).append([-x])
            chunks([1, 0, 2, 1])
    std::test::value("fold-loops-list-of-lists", [[1], [2, 2], [-2], [1]], t_list_of_lists)

    fn t_generic() errors std::compiler::CompilerError:
        static compile:
            fn reduce(xs, initial, step):
                fold x in xs with intermediate acc initial:
                    step(acc, x)
            fn add(a, b):
                a + b
            fn cat(a: str, b: str) -> str:
                a.concat(b)
            [reduce([1, 2, 3], 0, add), reduce(["x", "y"], "<", cat)]
    std::test::value("fold-loops-generic", [6, "<xy"], t_generic)

    fn t_refined() errors std::compiler::CompilerError:
        static compile:
            fn clamp(n: int) -> FoldPercent:
                if n < 0:
                    return 0
                if n > 100:
                    return 100
                n
            fn needs(p: FoldPercent) -> int:
                p + 1
            fn f(xs: List[int]) -> int:
                p = fold x in xs with intermediate acc clamp(0):
                    clamp(acc + x)
                needs(p)
            [f([30, 50, 40]), f([-5])]
    std::test::value("fold-loops-refined", [101, 1], t_refined)

    fn t_mutable_vector() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> List[int]:
                v = std::mutable_vector::from_list([0])
                w = fold x in xs with intermediate acc v:
                    acc.push(x * 10)
                    acc
                [std::mutable_vector::length(w), std::mutable_vector::length(v)]
            f([1, 2, 3])
    std::test::value("fold-loops-mutable-vector", [4, 1], t_mutable_vector)

    fn t_mutable_map() errors std::compiler::CompilerError:
        static compile:
            fn total(m: std::mutable_map::MutableMap[str, int]) -> int:
                fold e in m with intermediate t 0:
                    t + e.value
            fn build() -> std::mutable_map::MutableMap[str, int] errors std::mutable_map::KeyNotFound:
                m = std::mutable_map::create[str, int]()
                m.set("a", 1)
                m.set("b", 20)
                m.set("c", 300)
                m.remove("b")
                m
            m = build():
                on std::mutable_map::KeyNotFound:
                    std::mutable_map::create[str, int]()
            total(m)
    std::test::value("fold-loops-mutable-map", 301, t_mutable_map)


fn register_fold_interactions_tests(context s: FoldScale):
    fn t_callable_step() errors std::compiler::CompilerError:
        static compile:
            fn fold_with(xs: List[int], f: Fn{args: [int, int], return: int}) -> int:
                fold x in xs with intermediate acc 0:
                    f(acc, x)
            fn mul_add(a: int, b: int) -> int:
                a * 2 + b
            fold_with([1, 0, 1, 1], mul_add)
    std::test::value("fold-loops-callable-step", 11, t_callable_step)

    fn t_closure_in_body() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> int:
                fold x in xs with intermediate acc 1:
                    fn add(n: int) -> int:
                        acc + n
                    add(x)
            f([2, 3])
    std::test::value("fold-loops-closure-in-body", 6, t_closure_in_body)

    fn t_coroutine() errors std::compiler::CompilerError:
        static compile:
            fn running(xs: List[int]) -> int:
                fold x in xs with intermediate acc 0:
                    yield acc + x
                    acc + x
            fn drive() -> List[int]:
                coroutine {step, first} = running([1, 2, 3])
                a = step()
                b = step()
                c = step()
                [first, a, b, c]
            drive()
    std::test::value("fold-loops-coroutine", [1, 3, 6, 6], t_coroutine)

    # The context test: computed here, compared by the body.
    context_value = fold_scaled_sum([1, 2, 4])
    fn context() errors std::compiler::CompilerError:
        context_value
    std::test::value("fold-loops-context", 21, context)


fn register_fold_diagnostics_tests():
    fn t_conflict_kinds() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> int:
                fold x in xs with intermediate acc 0:
                    "no"
            f([1])
    std::test::rejects("fold-loops-conflict-kinds", std::compiler::DiagnosticCode::FoldIntermediateType, t_conflict_kinds)

    fn t_conflict_missing_else() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> int:
                fold x in xs with intermediate acc 0:
                    if x > 1:
                        acc + x
            f([1])
    std::test::rejects("fold-loops-conflict-missing-else", std::compiler::DiagnosticCode::FoldIntermediateType, t_conflict_missing_else)

    fn t_conflict_branch() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> int:
                fold x in xs with intermediate acc {n: 0}:
                    if x > 2:
                        {n: acc.n + 1, extra: true}
                    else:
                        acc
            f([1, 5])
    std::test::rejects("fold-loops-conflict-branch", std::compiler::DiagnosticCode::FoldIntermediateType, t_conflict_branch)

    fn t_conflict_named_structs() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> int:
                r = fold x in xs with intermediate s FoldA {v: 0}:
                    FoldB {v: x}
                0
            f([1])
    std::test::rejects("fold-loops-conflict-named-structs", std::compiler::DiagnosticCode::FoldIntermediateType, t_conflict_named_structs)

    fn t_conflict_incompatible_initial() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> int:
                t = fold x in xs with intermediate acc "":
                    x + 1
                t + 1
            f([1])
    std::test::rejects("fold-loops-conflict-incompatible-initial", std::compiler::DiagnosticCode::FoldIntermediateType, t_conflict_incompatible_initial)

    fn t_no_conflict_dynamic() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int], seed) -> any:
                fold x in xs with intermediate acc seed:
                    x
            f([1], 0)
    std::test::value("fold-loops-no-conflict-dynamic", 1, t_no_conflict_dynamic)

    fn t_no_conflict_paths_that_leave() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> int errors FoldBoom:
                fold x in xs with intermediate acc 0:
                    if x == 1:
                        continue
                    if x == 2:
                        break
                    if x == 3:
                        return -1
                    if x == 4:
                        fail FoldBoom
                    acc + x
            f([5, 1, 2, 3]):
                on FoldBoom:
                    0
    std::test::value("fold-loops-no-conflict-paths-that-leave", 5, t_no_conflict_paths_that_leave)

    fn t_unhandled_initial() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int], k: int) -> int:
                fold x in xs with intermediate acc fold_boom(k):
                    acc + x
            f([1], 0)
    std::test::rejects("fold-loops-unhandled-initial", std::compiler::DiagnosticCode::UnhandledError, t_unhandled_initial)

    fn t_result_type_checked() errors std::compiler::CompilerError:
        static compile:
            fn needs_str(s: str) -> str:
                s
            fn f(xs: List[int]) -> str:
                t = fold x in xs with intermediate acc 0:
                    acc + x
                needs_str(t)
            f([1])
    std::test::rejects("fold-loops-result-type-checked", std::compiler::DiagnosticCode::Type, t_result_type_checked)

    fn t_cardinality_not_domain() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> List[int]:
                r = fold x in xs with intermediate out []:
                    out.append(x).append(x)
                loop a in r and i from 0 to std::list::length(xs):
                    a + i
            f([1, 2])
    std::test::rejects("fold-loops-cardinality-not-domain", std::compiler::DiagnosticCode::LockstepUnproven, t_cardinality_not_domain)

    fn t_affine_rejected() errors std::compiler::CompilerError:
        static compile:
            fn gen() -> int:
                yield 1
                2
            fn f(n: int) -> int:
                coroutine {step: h} = gen()
                c = fold i from 0 to n with intermediate c h:
                    c
                0
            f(2)
    std::test::rejects("fold-loops-affine-rejected", std::compiler::DiagnosticCode::AffineFoldUnsupported, t_affine_rejected)

    fn t_break_outside() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> int:
                fold x in xs with intermediate acc 0:
                    fn g() -> int:
                        break
                    acc + x
            f([1])
    std::test::rejects("fold-loops-break-outside", std::compiler::DiagnosticCode::BreakOutsideLoop, t_break_outside)


fn register_fold_syntax_tests():
    fn t_parse_fold_is_a_name() errors std::compiler::CompilerError:
        static compile:
            fold = 3
            fn twice(fold: int) -> int:
                fold * 2
            s = {fold: 4}
            [fold, twice(fold), s.fold]
    std::test::value("fold-loops-parse-fold-is-a-name", [3, 6, 4], t_parse_fold_is_a_name)

    fn t_parse_with_is_a_variable() errors std::compiler::CompilerError:
        static compile:
            fn f(xs: List[int]) -> int:
                fold with in xs with intermediate intermediate 0:
                    intermediate + with
            f([2, 3])
    std::test::value("fold-loops-parse-with-is-a-variable", 5, t_parse_with_is_a_variable)


fn register_fold_loops_tests(context s: FoldScale):
    register_fold_basics_tests()
    register_fold_control_tests()
    register_fold_order_tests()
    register_fold_errors_tests(1, 0, [1, 2, 3, 4])
    register_fold_scope_tests()
    register_fold_nesting_tests()
    register_fold_positions_tests()
    register_fold_intermediates_tests()
    register_fold_interactions_tests()
    register_fold_diagnostics_tests()
    register_fold_syntax_tests()

with context std::test::suite()
with context FoldScale {factor: 3}
register_fold_loops_tests()
std::test::report()
