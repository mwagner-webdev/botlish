# refinements.bot -- refinement values (REFINEMENT-VALUES.md), as a
# source-level specification:
#
#   refined type Mail = str
#   fn mail?(s: str) -> bool proves s: Mail:
#
# A refinement is a new nominal type over exactly one carrier type. A value
# becomes a refinement only where one of its owner's proof-producing
# functions has proven it (a predicate returned true for it, or a validator
# completed normally for it); there is no conversion, constructor or
# implicit strengthening. A proof is a fact about a value, never about a
# spelling: it flows through Boolean bindings, aliases and copies, survives
# a join only when every path to it proves it, and is lost through an
# erased `any`. A refined value is usable wherever its carrier is
# (forgetting is free and transitive along a chain of refinements), it
# computes, compares and hashes as its carrier, and it may be returned or
# stored in a field of the refinement's type once proven. A proof clause
# names one ordinary parameter, declared of the carrier, of a function
# declaring `-> bool` (or `-> unit`, a validator), and changes neither its
# arity nor its call. A repeated proof predicate on the same value may be
# decided by the compiler, never one that reads or writes mutable state.
#
# It ports tests/refinement-values.test (register_refinement_values_tests),
# tests/refined.test (register_refined_tests: the source analogs of its
# Core IR type-test programs) and tests/refined-signatures.test
# (register_refined_signatures_tests: verified result contracts over a sparse
# integer domain). What only Tcl observes -- HIR binding types, the `known`
# field of a decided predicate call, specialization instance labels, NIR,
# allocation counts, the rendering text -- stays in those files.
#
# Imports: compiler and test (the framework); list and str (the Tcl
# prelude's imports: std::list::at, std::str::length, std::str::concat, std::str::lowercase,
# std::str::substring); mutable_array (the effectful predicate's state, as in its
# Tcl program); std::linux::path and `import type std::linux::path::LinuxPath` (a
# standard module's refinement, standing in for refinement-module-identity's
# private module "validation"); `import type std::byte::Byte` (a source-defined
# integer domain, as an eligible carrier and as a proven type that is not a
# refinement).
#
# One context beside std::test::suite() is installed: Counter, the mutable state
# the effectful predicate bump? reads and writes. The code that needs it runs
# in its registration function, and the body compares what it computed.
import std::compiler
import std::linux::path
import std::list
import std::mutable_array
import std::str
import std::test
import type std::byte::Byte
import type std::linux::path::LinuxPath

# ---------------------------------------------------------------------------
# Shared declarations (top-level only): the Tcl prelude of
# refinement-values.test -- two sibling refinements of str, a refinement of
# a refinement, and the entry program's own proof-producing predicates (a
# second predicate of Mail, and one proving Encoded from a Query) -- plus
# the declarations single tests need.

refined type Mail = str
refined type Query = str
refined type Encoded = Query

fn mail?(s: str) -> bool proves s: Mail:
    std::str::length(s) > 3

fn other_mail?(s: str) -> bool proves s: Mail:
    std::str::length(s) > 4

fn query?(s: str) -> bool proves s: Query:
    std::str::length(s) > 0

fn encoded?(q: Query) -> bool proves q: Encoded:
    std::str::length(q) > 1

fn send(m: Mail) -> int:
    std::str::length(m)

fn show(s: str) -> str:
    s

# refinement-chain-order-independent: a carrier declared after its
# refinement.
refined type Late = Early
refined type Early = str

# refinement-carrier-eligible: scalar value carriers, an integer domain and
# refinements of refinements.
refined type Flag = bool
refined type Letter = UnicodeChar
refined type Even = int
refined type EvenByte = Byte
refined type Text = str
refined type Short = Text

# refinement-proof-with-errors, refinement-join-all-paths, refinement-return.
error Weird
error Bad
error Invalid

# refinement-field: a struct field of refinement type.
struct Recipient:
    email: Mail

# refinement-effectful-not-folded: the mutable state its predicate reads and
# writes (one slot, a counter of calls).
context struct Counter:
    a: MutableArray[int]

# refined-signatures.test's local HighNibble (the Tcl file's highNibbleDecl,
# stdlib/byte.bot's sparse domain declared over Int): a 16-value sparse example
# type for generic range and exact-set machinery.
type HighNibble = Int in {
    0, 16, 32, 48,
    64, 80, 96, 112,
    128, 144, 160, 176,
    192, 208, 224, 240
}

# ---------------------------------------------------------------------------
# refinement-values.test: declaration syntax, identity and ownership

fn register_syntax_tests():
    # refinement-refined-is-contextual: "refined" is an ordinary name
    # everywhere but before "type".
    fn refined_is_contextual() errors std::compiler::CompilerError:
        static compile:
            fn refined(x):
                x + 1

            refined_value = refined(41)
            [refined_value]
    std::test::value("refinement-refined-is-contextual", [42], refined_is_contextual)

    # refinement-proves-is-contextual: "proves" is an ordinary name
    # everywhere but after a result type.
    fn proves_is_contextual() errors std::compiler::CompilerError:
        static compile:
            fn f(proves):
                proves + 1

            proves = 2
            [f(proves), proves]
    std::test::value("refinement-proves-is-contextual", [3, 2], proves_is_contextual)

fn register_identity_tests():
    # refinement-nominal-identity: a refinement is a new nominal type, not
    # an alias: Mail, Query and str are three types. A sibling's proof is
    # no proof of Mail, a carrier value is none, Mail's own predicate is.
    fn sibling_proof() errors std::compiler::CompilerError:
        static compile:
            fn f(s: str) -> int:
                if query?(s):
                    send(s)
                else:
                    0
            f("abcd")
    std::test::rejects_at("refinement-nominal-identity/sibling", std::compiler::DiagnosticCode::Type, 153, 26, sibling_proof)
    fn carrier_value() errors std::compiler::CompilerError:
        static compile:
            send("abcd")
    std::test::rejects_at("refinement-nominal-identity/carrier", std::compiler::DiagnosticCode::Type, 160, 18, carrier_value)
    fn own_proof() errors std::compiler::CompilerError:
        static compile:
            fn f(s: str) -> int:
                if mail?(s):
                    send(s)
                else:
                    0
            f("abcd")
    std::test::value("refinement-nominal-identity/proven", 4, own_proof)

    # refinement-owner-entry-program: the entry program owns its own
    # refinements: its predicate mints Mail.
    fn owner_entry_program() errors std::compiler::CompilerError:
        static compile:
            fn f(s: str) -> int:
                if mail?(s):
                    send(s)
                else:
                    0
            [f("abcd"), f("ab")]
    std::test::value("refinement-owner-entry-program", [4, 0], owner_entry_program)

    # refinement-module-identity: a module's refinement has its
    # path-derived identity (std::linux::path::LinuxPath), usable qualified and
    # through `import type`, proven for the entry program by the owner's
    # predicate and accepted by the owner's own function over it.
    fn module_identity() errors std::compiler::CompilerError:
        static compile:
            fn short(p: LinuxPath) -> LinuxPath:
                p

            fn qualified(p: std::linux::path::LinuxPath) -> int:
                std::str::length(std::linux::path::text(p))

            fn ok(s: str) -> int:
                if std::linux::path::valid?(s):
                    qualified(short(s)) + std::str::length(std::linux::path::text(s))
                else:
                    0

            [ok("abcd"), ok("")]
    std::test::value("refinement-module-identity", [8, 0], module_identity)

    # refinement-chain-forgets-transitively: Encoded forgets to Query and to
    # str; nothing strengthens a Query back to an Encoded.
    fn chain_forgets() errors std::compiler::CompilerError:
        static compile:
            fn as_query(q: Query) -> str:
                q

            fn f(s: str) -> str:
                if query?(s):
                    if encoded?(s):
                        std::str::concat(as_query(s), show(s))
                    else:
                        "no"
                else:
                    "no"

            [f("ab"), f("a")]
    std::test::value("refinement-chain-forgets-transitively/forgets", ["abab", "no"], chain_forgets)
    fn chain_no_strengthening() errors std::compiler::CompilerError:
        static compile:
            fn need(e: Encoded) -> int:
                1

            fn f(s: str) -> int:
                if query?(s):
                    need(s)
                else:
                    0

            f("ab")
    std::test::rejects_at("refinement-chain-forgets-transitively/no-strengthening", std::compiler::DiagnosticCode::Type, 230, 26, chain_no_strengthening)

    # refinement-chain-order-independent: Late's carrier Early is declared
    # after it (top of the suite); the chain resolves.
    fn chain_order_independent() errors std::compiler::CompilerError:
        static compile:
            fn keep(x: Late) -> Late:
                x

            1
    std::test::value("refinement-chain-order-independent", 1, chain_order_independent)

fn register_carrier_tests():
    # refinement-carrier-eligible: scalar value carriers (bool, UnicodeChar,
    # int, str), an integer domain (Byte) and refinements (Short = Text)
    # are eligible; a predicate over the int carrier proves Even.
    fn carrier_eligible() errors std::compiler::CompilerError:
        static compile:
            fn even?(n: int) -> bool proves n: Even:
                mod(n, 2) == 0

            fn half(n: Even) -> int:
                mod(n, 7)

            fn f(n: int) -> int:
                if even?(n):
                    half(n)
                else:
                    -1

            [f(10), f(3)]
    std::test::value("refinement-carrier-eligible", [3, -1], carrier_eligible)

# ---------------------------------------------------------------------------
# refinement-values.test: proof clauses and their validation

fn register_proof_clause_tests():
    # refinement-proof-target-missing: a proof clause must name an ordinary
    # parameter -- neither a missing one nor a flag.
    fn target_missing() errors std::compiler::CompilerError:
        static compile:
            fn p(s: str) -> bool proves t: Mail:
                true
            1
    std::test::rejects_containing("refinement-proof-target-missing/no-parameter", std::compiler::DiagnosticCode::ProofClause, "must name one of the function's ordinary parameters: the function has no parameter \"t\" (its parameters: s)", target_missing)
    fn target_flag() errors std::compiler::CompilerError:
        static compile:
            fn p(s: str, flags :x) -> bool proves x: Mail:
                true
            1
    std::test::rejects_containing("refinement-proof-target-missing/flag", std::compiler::DiagnosticCode::ProofClause, "\"x\" is a flag, not an ordinary parameter", target_flag)

    # refinement-proof-target-not-refinement: the proven type must be a
    # refinement: not the carrier itself, not an integer domain, not an
    # unknown name.
    fn target_carrier() errors std::compiler::CompilerError:
        static compile:
            fn p(s: str) -> bool proves s: str:
                true
            1
    std::test::rejects_containing("refinement-proof-target-not-refinement/carrier", std::compiler::DiagnosticCode::ProofClause, "is str, which is not a refinement type", target_carrier)
    fn target_domain() errors std::compiler::CompilerError:
        static compile:
            fn p(n: int) -> bool proves n: Byte:
                true
            1
    std::test::rejects("refinement-proof-target-not-refinement/domain", std::compiler::DiagnosticCode::ProofClause, target_domain)
    fn target_unknown() errors std::compiler::CompilerError:
        static compile:
            fn p(s: str) -> bool proves s: Nope:
                true
            1
    std::test::rejects("refinement-proof-target-not-refinement/unknown", std::compiler::DiagnosticCode::ProofClause, target_unknown)

    # refinement-proof-returns-bool: a proof-producing function declares
    # -> bool (or -> unit, a validator).
    fn returns_int() errors std::compiler::CompilerError:
        static compile:
            fn p(s: str) -> int proves s: Mail:
                1
            1
    std::test::rejects_message("refinement-proof-returns-bool/int", std::compiler::DiagnosticCode::ProofClause, "a proof-producing function must declare \"-> bool\" (a predicate: its true result is the proof) or \"-> unit\" (a validator: its normal completion is the proof), but \"proves s: Mail\" is on a function declared -> int", returns_int)
    fn returns_undeclared() errors std::compiler::CompilerError:
        static compile:
            fn p(s: str) proves s: Mail:
                true
            1
    std::test::rejects_containing("refinement-proof-returns-bool/undeclared", std::compiler::DiagnosticCode::ProofClause, "with no declared result type", returns_undeclared)

    # refinement-proof-carrier-mismatch: the proven parameter must already
    # be of the carrier (or of a refinement that forgets to it).
    fn mismatch_int() errors std::compiler::CompilerError:
        static compile:
            fn p(n: int) -> bool proves n: Mail:
                true
            1
    std::test::rejects_message("refinement-proof-carrier-mismatch/int", std::compiler::DiagnosticCode::ProofClause, "proof carrier mismatch: parameter \"n\" is declared int, but Mail refines str, and a int value does not forget to a str (a proof can only strengthen what the parameter already is)", mismatch_int)
    fn mismatch_untyped() errors std::compiler::CompilerError:
        static compile:
            fn p(s) -> bool proves s: Mail:
                true
            1
    std::test::rejects_message("refinement-proof-carrier-mismatch/untyped", std::compiler::DiagnosticCode::ProofClause, "the proven parameter \"s\" must declare its type: \"proves s: Mail\" refines a str value, so write \"s: str\" (or a refinement that forgets to it)", mismatch_untyped)
    fn mismatch_chain() errors std::compiler::CompilerError:
        static compile:
            fn p(s: str) -> bool proves s: Encoded:
                true
            1
    std::test::rejects_message("refinement-proof-carrier-mismatch/chain", std::compiler::DiagnosticCode::ProofClause, "proof carrier mismatch: parameter \"s\" is declared str, but Encoded refines str[Query], and a str value does not forget to a str[Query] (a proof can only strengthen what the parameter already is)", mismatch_chain)

    # refinement-proof-arity-abi: a proof clause changes neither arity nor
    # the call: the predicate is an ordinary bool function (and value).
    fn arity_abi() errors std::compiler::CompilerError:
        static compile:
            ok = mail?("abcd")
            f = mail?
            [ok, not ok, f("ab")]
    std::test::value("refinement-proof-arity-abi", [true, false, false], arity_abi)

    # refinement-proof-with-errors: a proof clause sits between the result
    # type and an errors clause; the error edge proves nothing, the true
    # edge proves.
    fn with_errors() errors std::compiler::CompilerError:
        static compile:
            fn p(s: str) -> bool proves s: Mail errors Weird:
                if s == "?":
                    fail Weird
                std::str::length(s) > 1

            fn take(m: Mail) -> int:
                std::str::length(m)

            fn f(s: str) -> int:
                ok = p(s):
                    on Weird:
                        return -1
                if ok:
                    take(s)
                else:
                    0

            [f("abc"), f("a"), f("?")]
    std::test::value("refinement-proof-with-errors", [3, 0, -1], with_errors)

# ---------------------------------------------------------------------------
# refinement-values.test: forgetting, no strengthening, the flow of proofs

fn register_forgetting_tests():
    # refinement-forgetting: a refined value is usable wherever its carrier
    # is, with no conversion.
    fn forgetting() errors std::compiler::CompilerError:
        static compile:
            fn f(s: str) -> List[str]:
                if mail?(s):
                    [show(s), std::str::concat(s, "!"), std::str::lowercase(s)]
                else:
                    []

            f("abcd")
    std::test::value("refinement-forgetting", ["abcd", "abcd!", "abcd"], forgetting)

    # refinement-no-implicit-strengthening: a carrier value is never a
    # refinement without a proof.
    fn no_implicit_strengthening() errors std::compiler::CompilerError:
        static compile:
            fn bad(s: str) -> int:
                send(s)
            bad("abcd")
    std::test::rejects_message("refinement-no-implicit-strengthening", std::compiler::DiagnosticCode::Type, "argument for parameter \"m\" cannot be proven to satisfy str[Mail] (argument type: str); expected Mail but found str: a refinement proof is required (a str value becomes Mail only where one of its owner's proof-producing functions has proven it: a predicate returned true for it, or a validator completed normally for it; there is no implicit conversion)", no_implicit_strengthening)

    # refinement-false-edge-no-proof: the false edge proves nothing about
    # the argument.
    fn false_edge() errors std::compiler::CompilerError:
        static compile:
            fn f(s: str) -> int:
                if mail?(s):
                    0
                else:
                    send(s)
            f("ab")
    std::test::rejects_at("refinement-false-edge-no-proof", std::compiler::DiagnosticCode::Type, 413, 26, false_edge)

    # refinement-param-is-proven: inside a function, a refinement parameter
    # is proven.
    fn param_is_proven() errors std::compiler::CompilerError:
        static compile:
            fn relay(m: Mail) -> int:
                send(m) + std::str::length(m)

            fn f(s: str) -> int:
                if mail?(s):
                    relay(s)
                else:
                    0

            f("abcde")
    std::test::value("refinement-param-is-proven", 10, param_is_proven)

fn register_proof_flow_tests():
    # refinement-boolean-binding: the proof belongs to the Boolean value:
    # ok = p(s), a copy of ok, then if.
    fn boolean_binding() errors std::compiler::CompilerError:
        static compile:
            fn f(s: str) -> int:
                ok = mail?(s)
                copy = ok
                if copy:
                    send(s)
                else:
                    0

            [f("abcd"), f("ab")]
    std::test::value("refinement-boolean-binding", [4, 0], boolean_binding)

    # refinement-not-and-or: not, and, or: facts true on every path to an
    # outcome.
    fn not_and_or() errors std::compiler::CompilerError:
        static compile:
            fn neg(s: str) -> int:
                if not mail?(s):
                    return 0
                send(s)

            fn both(s: str, t: str) -> int:
                if mail?(s) and mail?(t):
                    send(s) + send(t)
                else:
                    0

            fn either(s: str) -> int:
                if mail?(s) or other_mail?(s):
                    send(s)
                else:
                    0

            [neg("abcd"), neg("a"), both("abcd", "efgh"), both("abcd", "e"), either("abcd"), either("a")]
    std::test::value("refinement-not-and-or", [4, 0, 8, 0, 4, 0], not_and_or)

    # refinement-or-needs-both: an or of a proof and an unrelated test
    # proves nothing.
    fn or_needs_both() errors std::compiler::CompilerError:
        static compile:
            fn f(s: str, c: bool) -> int:
                if mail?(s) or c:
                    send(s)
                else:
                    0
            f("abcd", true)
    std::test::rejects_at("refinement-or-needs-both", std::compiler::DiagnosticCode::Type, 479, 26, or_needs_both)

    # refinement-copy-of-proven-value: a local copy of a proven value is
    # the same value.
    fn copy_of_proven() errors std::compiler::CompilerError:
        static compile:
            fn f(s: str) -> int:
                if mail?(s):
                    x = s
                    send(x)
                else:
                    0
            f("abcd")
    std::test::value("refinement-copy-of-proven-value", 4, copy_of_proven)

    # refinement-proof-through-alias: proving an alias proves the value it
    # aliases.
    fn through_alias() errors std::compiler::CompilerError:
        static compile:
            fn f(s: str) -> int:
                x = s
                if mail?(x):
                    send(s)
                else:
                    0
            f("abcd")
    std::test::value("refinement-proof-through-alias", 4, through_alias)

    # refinement-join-all-paths: a fact survives a join when every path
    # that reaches it proves it (a failing else, early returns on both
    # branches with two different predicates of Mail).
    fn join_all_paths() errors std::compiler::CompilerError:
        static compile:
            fn guard(s: str) -> int errors Bad:
                if mail?(s):
                    unit
                else:
                    fail Bad
                send(s)

            fn both_branches(s: str) -> int:
                if std::str::length(s) > 10:
                    if not mail?(s):
                        return -1
                else:
                    if not other_mail?(s):
                        return -2
                send(s)

            fn g(s: str) -> int:
                v = guard(s):
                    on Bad:
                        -9
                v

            [g("abcd"), g("a"), both_branches("abcde"), both_branches("abc")]
    std::test::value("refinement-join-all-paths", [4, -9, 5, -2], join_all_paths)

    # refinement-join-one-path: a fact proven on only one path does not
    # survive the join.
    fn join_one_path() errors std::compiler::CompilerError:
        static compile:
            fn f(s: str) -> int:
                if std::str::length(s) > 2:
                    if mail?(s):
                        1
                    else:
                        2
                else:
                    3
                send(s)
            f("abcd")
    std::test::rejects_at("refinement-join-one-path", std::compiler::DiagnosticCode::Type, 553, 22, join_one_path)

    # refinement-rebinding: facts belong to values, not spellings: a
    # shadowing parameter is not proven.
    fn rebinding() errors std::compiler::CompilerError:
        static compile:
            fn f(s: str) -> int:
                if mail?(s):
                    fn inner(s: str) -> int:
                        send(s)
                    inner("x")
                else:
                    0
            f("abcd")
    std::test::rejects_at("refinement-rebinding", std::compiler::DiagnosticCode::Type, 564, 30, rebinding)

    # refinement-rebinding-local: a local binding that shadows a proven name
    # is a different value: neither proven (/rejected) nor decided by the
    # earlier call (/value: mail?("xy") runs, and is false).
    fn rebinding_local_rejected() errors std::compiler::CompilerError:
        static compile:
            fn f(s: str) -> int:
                if mail?(s):
                    s = "x"
                    send(s)
                else:
                    0
            f("abcd")
    std::test::rejects_at("refinement-rebinding-local/rejected", std::compiler::DiagnosticCode::Type, 579, 26, rebinding_local_rejected)
    fn rebinding_local_value() errors std::compiler::CompilerError:
        static compile:
            fn f(s: str) -> int:
                if mail?(s):
                    s = "xy"
                    if mail?(s):
                        1
                    else:
                        2
                else:
                    0
            f("abcd")
    std::test::value("refinement-rebinding-local/value", 2, rebinding_local_value)

# ---------------------------------------------------------------------------
# refinement-values.test: returns and fields

fn register_return_and_field_tests():
    # refinement-return: a function may return a refinement it has proven,
    # with no constructor.
    fn proven_return() errors std::compiler::CompilerError:
        static compile:
            fn parse(s: str) -> Mail errors Invalid:
                if mail?(s):
                    s
                else:
                    fail Invalid

            fn f(s: str) -> int:
                m = parse(s):
                    on Invalid:
                        return -1
                send(m)

            [f("abcd"), f("x")]
    std::test::value("refinement-return", [4, -1], proven_return)

    # refinement-return-unproven: returning an unproven carrier value is
    # rejected.
    fn unproven_return() errors std::compiler::CompilerError:
        static compile:
            fn parse(s: str) -> Mail:
                s
            parse("abcd")
    std::test::rejects_message("refinement-return-unproven", std::compiler::DiagnosticCode::Type, "function result does not prove declared type str[Mail] (result type: str); expected Mail but found str: a refinement proof is required (a str value becomes Mail only where one of its owner's proof-producing functions has proven it: a predicate returned true for it, or a validator completed normally for it; there is no implicit conversion)", unproven_return)

    # refinement-field: a struct field of refinement type accepts only a
    # proven value (/unproven); the field is a refined value (/value).
    fn field_value() errors std::compiler::CompilerError:
        static compile:
            fn make(s: str) -> int:
                if mail?(s):
                    r = Recipient {email: s}
                    send(r.email) + std::str::length(r.email)
                else:
                    0

            [make("abcd"), make("a")]
    std::test::value("refinement-field/value", [8, 0], field_value)
    fn field_unproven() errors std::compiler::CompilerError:
        static compile:
            Recipient {email: "abcd"}
    std::test::rejects_message("refinement-field/unproven", std::compiler::DiagnosticCode::Type, "field \"email\" of struct Recipient cannot be proven to satisfy its declared type str[Mail] (value type: str); expected Mail but found str: a refinement proof is required (a str value becomes Mail only where one of its owner's proof-producing functions has proven it: a predicate returned true for it, or a validator completed normally for it; there is no implicit conversion)", field_unproven)

# ---------------------------------------------------------------------------
# refinement-values.test: method sugar, operators, equality and hashing

fn register_method_and_operator_tests():
    # refinement-method-sugar-forgets: method sugar of carrier functions
    # applies to a refined value.
    fn sugar_forgets() errors std::compiler::CompilerError:
        static compile:
            fn f(s: str) -> int:
                if mail?(s):
                    s.length() + std::str::length(s.show())
                else:
                    0
            f("abcd")
    std::test::value("refinement-method-sugar-forgets", 8, sugar_forgets)

    # refinement-method-sugar-one-way: a function requiring the refinement
    # is no method of a plain carrier value.
    fn sugar_one_way() errors std::compiler::CompilerError:
        static compile:
            fn f(s: str) -> int:
                s.send()
            f("abcd")
    std::test::rejects_at("refinement-method-sugar-one-way", std::compiler::DiagnosticCode::Type, 669, 17, sugar_one_way)

    # refinement-method-sugar-ambiguity: no refinement-specific ranking: a
    # length over Mail and std::str::length are both applicable to a proven
    # value.
    fn sugar_ambiguity() errors std::compiler::CompilerError:
        static compile:
            fn length(m: Mail) -> int:
                0

            fn f(s: str) -> int:
                if mail?(s):
                    s.length()
                else:
                    0

            f("abcd")
    std::test::rejects_at("refinement-method-sugar-ambiguity", std::compiler::DiagnosticCode::AmbiguousMethodCall, 683, 23, sugar_ambiguity)

    # refinement-operators: operators take the carrier: equality and
    # comparison are the carrier's (/value), and concatenation returns the
    # carrier, not the refinement (/concat-forgets).
    fn operators() errors std::compiler::CompilerError:
        static compile:
            fn f(s: str) -> List[bool]:
                if mail?(s):
                    joined = std::str::concat(s, "x")
                    [s == "abcd", s != "abce", joined == "abcdx"]
                else:
                    []

            f("abcd")
    std::test::value("refinement-operators/value", [true, true, true], operators)
    fn concat_forgets() errors std::compiler::CompilerError:
        static compile:
            fn f(s: str) -> int:
                if mail?(s):
                    joined = std::str::concat(s, "x")
                    send(joined)
                else:
                    0
            f("abcd")
    std::test::rejects_at("refinement-operators/concat-forgets", std::compiler::DiagnosticCode::Type, 709, 26, concat_forgets)

    # refinement-equality-and-hash: equality and hashing are the carrier's,
    # never salted by the refinement.
    fn equality_and_hash() errors std::compiler::CompilerError:
        static compile:
            fn f(s: str, t: str) -> List[bool]:
                if mail?(s):
                    if mail?(t):
                        [s == t, hash(s) == hash(t), hash(s) == hash("abcd"), s == "abcd"]
                    else:
                        []
                else:
                    []

            f("abcd", "abcd")
    std::test::value("refinement-equality-and-hash", [true, true, true, true], equality_and_hash)

# ---------------------------------------------------------------------------
# refinement-values.test: rendering, erasure, generic code, inference

fn register_erasure_and_generic_tests():
    # refinement-rendering-value: a refined value is its carrier value, at
    # top level and inside a list (compared, not rendered: see the fragment).
    fn rendering_value() errors std::compiler::CompilerError:
        static compile:
            fn pick(s: str) -> List[Mail]:
                if mail?(s):
                    [s]
                else:
                    []

            [pick("abcd"), pick("a")]
    std::test::value("refinement-rendering-value", [["abcd"], []], rendering_value)

    # refinement-any-erasure: through an erased any the proof is lost
    # (/erased); where the compiler still knows the exact value, it is kept
    # (/exact).
    fn any_erased() errors std::compiler::CompilerError:
        static compile:
            fn f(s: str) -> List[int]:
                if mail?(s):
                    loop x in [s, 1]:
                        send(x)
                else:
                    []
            f("abcd")
    std::test::rejects_at("refinement-any-erasure/erased", std::compiler::DiagnosticCode::Type, 756, 30, any_erased)
    fn any_exact() errors std::compiler::CompilerError:
        static compile:
            fn f(s: str) -> int:
                if mail?(s):
                    xs = [s, 1]
                    send(std::list::at(xs, 0))
                else:
                    0
            f("abcd")
    std::test::value("refinement-any-erasure/exact", 4, any_exact)

    # refinement-generic-imprint: an identity function's result keeps the
    # refinement of its argument (send(m) is accepted) and the carrier of a
    # plain one.
    fn generic_imprint() errors std::compiler::CompilerError:
        static compile:
            fn identity(x):
                x

            fn f(s: str) -> int:
                if mail?(s):
                    m = identity(s)
                    p = identity("plain")
                    send(m) + std::str::length(p)
                else:
                    0

            f("abcd")
    std::test::value("refinement-generic-imprint", 9, generic_imprint)

    # refinement-contract-inference: an untyped function that passes its
    # parameter where a refinement is required requires the refinement of
    # its callers.
    fn inferred_rejected() errors std::compiler::CompilerError:
        static compile:
            fn relay(x):
                send(x)

            fn bad(s: str) -> int:
                relay(s)

            bad("abcd")
    std::test::rejects_containing("refinement-contract-inference/rejected", std::compiler::DiagnosticCode::Type, "the parameter type inferred from the function body", inferred_rejected)
    fn inferred_accepted() errors std::compiler::CompilerError:
        static compile:
            fn relay(x):
                send(x)

            fn ok(s: str) -> int:
                if mail?(s):
                    relay(s)
                else:
                    0

            ok("abcd")
    std::test::value("refinement-contract-inference/accepted", 4, inferred_accepted)

# ---------------------------------------------------------------------------
# refinement-values.test: repeated predicates

# refinement-effectful-not-folded's predicate: it proves, but it reads and
# writes the installed Counter, so an earlier call never decides a repeat.
# Its first call sees 0 (true), every later one a larger count (false).
fn bump?(s: str, context c: Counter) -> bool proves s: Mail:
    n = std::mutable_array::at(c.a, 0):
        on IndexNotFound:
            return false
    std::mutable_array::set(c.a, 0, n + 1):
        on IndexNotFound:
            return false
    n == 0

fn register_repeat_tests():
    # refinement-repeat-folds-true: a repeated proof predicate on the same
    # value, on the true edge (the compiler may decide it true).
    fn repeat_true() errors std::compiler::CompilerError:
        static compile:
            fn f(s: str) -> int:
                if mail?(s):
                    if mail?(s):
                        1
                    else:
                        2
                else:
                    3

            [f("abcd"), f("a")]
    std::test::value("refinement-repeat-folds-true", [1, 3], repeat_true)

    # refinement-repeat-folds-false: the same invocation on the false edge
    # (decided false: an exact result, never a negative refinement).
    fn repeat_false() errors std::compiler::CompilerError:
        static compile:
            fn f(s: str) -> int:
                if mail?(s):
                    1
                else:
                    if mail?(s):
                        2
                    else:
                        3

            [f("abcd"), f("a")]
    std::test::value("refinement-repeat-folds-false", [1, 3], repeat_false)

    # refinement-repeat-different-predicate: a different predicate proving
    # the same refinement is not decided (other_mail?("abcd") is false),
    # though the value is proven on both of its edges.
    fn different_predicate() errors std::compiler::CompilerError:
        static compile:
            fn f(s: str) -> int:
                if mail?(s):
                    if other_mail?(s):
                        send(s)
                    else:
                        -send(s)
                else:
                    0

            [f("abcde"), f("abcd")]
    std::test::value("refinement-repeat-different-predicate", [5, -4], different_predicate)

    # refinement-effectful-not-folded: a proof predicate that reads or
    # writes mutable state still proves (take(s) on both edges of the
    # repeat), but its repeat is never decided: the second call runs and
    # returns false. It needs the Counter context, so it runs here.
    fn take(m: Mail) -> str:
        m

    fn f(s: str) -> List[str]:
        if bump?(s):
            if bump?(s):
                [take(s), "again"]
            else:
                [take(s), "changed"]
        else:
            []

    observed = f("x")
    fn effectful_not_folded() errors std::compiler::CompilerError:
        static compile:
            observed
    std::test::value("refinement-effectful-not-folded", ["x", "changed"], effectful_not_folded)

fn register_refinement_values_tests():
    register_syntax_tests()
    register_identity_tests()
    register_carrier_tests()
    register_proof_clause_tests()
    register_forgetting_tests()
    register_proof_flow_tests()
    register_return_and_field_tests()
    register_method_and_operator_tests()
    register_erasure_and_generic_tests()
    register_repeat_tests()

# ---------------------------------------------------------------------------
# refined.test: kind tests and a String range error, in source

# The operands arrive as parameters (S, LOWER, UPPER) so that the range
# error is the run time's, not a statically known failure.
fn register_refined_tests(s: str, lower: int, upper: int):
    # refined-type-test-kind-tests-on-unknown: integer?, string? and list?
    # of a value whose kind the function does not declare.
    fn kind_tests() errors std::compiler::CompilerError:
        static compile:
            fn f(v):
                [integer?(v), string?(v), list?(v)]

            [f(1), f("a"), f([])]
    std::test::value("refined-type-test-kind-tests-on-unknown", [[true, false, false], [false, true, false], [false, false, true]], kind_tests)

    # refined-16: a substring past the end of the String fails with the
    # declared UpperOverrun (handled: the outcome becomes a value).
    fn substring_range() errors std::compiler::CompilerError:
        static compile:
            r = std::str::substring(s, lower, upper):
                on LowerUnderrun:
                    "LowerUnderrun"
                on UpperOverrun:
                    "UpperOverrun"
            r
    std::test::value("refined-16", "UpperOverrun", substring_range)

# ---------------------------------------------------------------------------
# refined-signatures.test: verified ordinary-function result contracts

# BYTE (17) and FLAG (true) are inputs the compiler cannot decide: a call's
# value meets HighNibble only through the function's verified result.
fn register_refined_signatures_tests(byte: int, flag: bool):
    # refined-signature-syntax-2: an unknown result type is a semantic
    # error, even in a function nothing calls.
    fn unknown_result() errors std::compiler::CompilerError:
        static compile:
            fn f() -> MissingType:
                1
            0
    std::test::rejects_containing("refined-signature-syntax-2", std::compiler::DiagnosticCode::Type, "unknown or invalid result type", unknown_result)

    # refined-signature-verify-0: an ordinary primitive result declaration
    # is accepted by semantic subtype checking.
    fn primitive_result() errors std::compiler::CompilerError:
        static compile:
            fn f() -> bool:
                true
            f()
    std::test::value("refined-signature-verify-0", true, primitive_result)

    # refined-signature-verify-1: constant-mask facts verify a sparse
    # refined result; the call has the declared type.
    fn constant_mask() errors std::compiler::CompilerError:
        static compile:
            fn f(x) -> HighNibble:
                bit_and(x, 240)

            fn need(h: HighNibble) -> int:
                h

            need(f(byte))
    std::test::value("refined-signature-verify-1", 16, constant_mask)

    # refined-signature-verify-2: an invalid sparse result is rejected at
    # definition time.
    fn invalid_sparse() errors std::compiler::CompilerError:
        static compile:
            fn bad() -> HighNibble:
                15
            0
    std::test::rejects_containing("refined-signature-verify-2", std::compiler::DiagnosticCode::Type, "does not prove declared type", invalid_sparse)

    # refined-signature-verify-3: a finite branch join proves a sparse
    # result.
    fn branch_join() errors std::compiler::CompilerError:
        static compile:
            fn f(x) -> HighNibble:
                if x:
                    0
                else:
                    240

            fn need(h: HighNibble) -> int:
                h

            need(f(flag))
    std::test::value("refined-signature-verify-3", 0, branch_join)

    # refined-signature-verify-4: bit_or of two AND masks' exact sets proves
    # a sparse result an interval hull could not (128 and 112 are disjoint
    # masks together spanning HighNibble's domain).
    fn exact_set_union() errors std::compiler::CompilerError:
        static compile:
            fn f(x) -> HighNibble:
                bit_or(bit_and(x, 128), bit_and(x, 112))

            fn need(h: HighNibble) -> int:
                h

            need(f(byte))
    std::test::value("refined-signature-verify-4", 16, exact_set_union)

    # refined-signature-verify-4b: an interval hull alone does not prove a
    # sparse result when one side's exact set is over budget (63 has 64
    # submasks).
    fn hull_only() errors std::compiler::CompilerError:
        static compile:
            fn f(x) -> HighNibble:
                bit_or(bit_and(x, 63), bit_and(x, 192))
            0
    std::test::rejects_containing("refined-signature-verify-4b", std::compiler::DiagnosticCode::Type, "does not prove declared type", hull_only)

with context Counter {a: std::mutable_array::create(1, 0)}
with context std::test::suite()
register_refinement_values_tests()
register_refined_tests("abc", 2, 5)
register_refined_signatures_tests(17, true)
std::test::report()
