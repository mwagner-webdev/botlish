# loop-collecting.bot -- collecting loops (COLLECTING-LOOPS.md), as a
# source-level specification:
#
# * A loop over a domain is an expression: it collects its body's value,
#   once per iteration, into a List. The four counted domains are
#   `from S to E` (S, S + 1, ..., E - 1), `from S through E` (..., E),
#   `down from S to E` (S, S - 1, ..., E + 1) and `down from S through E`
#   (..., E). A range whose start is already past its end is empty and
#   collects []; an inclusive end is reached exactly, never through E + 1 or
#   E - 1.
# * Int is arbitrary precision: bounds at and past i64::MAX / i64::MIN and
#   across the native small-Int tag boundary (2^62) count exactly, as do
#   bounds that are only known at run time and arithmetic on the loop
#   variable there.
# * Each bound is evaluated exactly once, START before END.
# * In the body, `continue` contributes nothing and advances, a bare `break`
#   ends the loop with the prefix collected so far, `return` leaves the
#   whole function; loops nest (results nest), and a closure made in an
#   iteration captures that iteration's own variable.
# * `through`, `down`, `from`, `to`, `by` and `in` are contextual: ordinary
#   names everywhere else, a loop variable included; so are `fold` (a fold
#   begins only before a name), `reduce`, `sum` and `accumulate`.
# * Lockstep: `loop x in xs and i from 0 to n:` advances every clause
#   together -- one body run per common position, not a Cartesian product.
#   The compiler must PROVE the clauses' iteration counts equal (a length,
#   an alias of one, a list built from the same domain, equal constants,
#   symbolically equal counts): provably different counts are
#   LockstepUnequal, unprovable ones LockstepUnproven (two calls are never
#   assumed equal; every clause is checked against the first). A clause's
#   variable is not in scope in another clause's operands, and two clauses
#   may not bind one name. continue, break and return act on the whole
#   loop; an error raised in the body escapes the whole loop.
# * Raw count loops (GENERIC-PREDICATE-PROOF-LOSS.md, loss point 4): natively
#   a counted loop whose bounds are proven small runs on a raw register.
#   That representation is invisible to source; what is observable is that
#   the programs exercising it (bounds at the small-Int edge, beyond it,
#   early exits, closures over the loop variable, a scanner, allocation in
#   the body) compute the same value on every backend.
#
# Ported from tests/loop-collecting.test and tests/raw-count-loops.test,
# which stay authoritative and unchanged; a golden test keeps its Tcl test's
# name unless the fragment file (audit/golden/migration/fragments/
# loop-collecting.tsv) records otherwise. What only the Tcl tests observe
# (HIR, Core IR and NIR text, cardinality formulas, the native knobs, parse
# errors, run-time TYPE errors, standalone executables) stays there.
#
# Evaluation-order and body-run tests of the Tcl suite observe a Tcl-side
# effect native (test-tick, test-log) on raw Core IR; here a probe `yield`s
# [its argument] and the body drives the coroutine, collecting [FIRST, REST]
# -- FIRST the first yield, REST every later yield followed by the
# coroutine's final result (tests/golden/values.bot's idiom).
#
# Imports: compiler (CompilerError, DiagnosticCode) and test; coroutine for
# the probes' std::coroutine::done?; list for std::list::length in lockstep proofs and
# std::list::at in the GC-stress program; str for the scanner and GC-stress
# programs and the message matcher below.
import std::compiler
import std::coroutine
import std::list
import std::str
import std::test

# ---------------------------------------------------------------------------
# Declarations (top-level only)

# loop-collecting-lockstep-body-error: the checked result type and the
# error a failing check raises.
error TooBig

type Small = Int in 0..10

# What a body did: rejected (with its diagnostic's code and message) or
# completed.
struct Observed:
    rejected: bool
    code: std::compiler::DiagnosticCode
    message: str

# ---------------------------------------------------------------------------
# A rejection's message, for the Tcl tests that pin one (or a fragment of
# one): the lockstep messages name the counts that differ or could not be
# proven equal, and that wording is the property. BODY goes through an
# untyped parameter, as in stdlib/test.bot's own helpers.

fn observe(body) -> Observed:
    v = body():
        on std::compiler::CompilerError {code, message}:
            return Observed {rejected: true, code: code, message: message}
    Observed {rejected: false, code: std::compiler::DiagnosticCode::Type, message: ""}

# true when FRAGMENT occurs in TEXT.
fn contains?(text: str, fragment: str) -> bool:
    n = std::str::length(text)
    k = std::str::length(fragment)
    loop i from 0 through n - k:
        piece = std::str::substring(text, i, i + k):
            on LowerUnderrun:
                continue
            on UpperOverrun:
                continue
        if piece == fragment:
            return true
    false

# The verdict for BODY: rejected with EXPECTED and a message that is exactly
# WANTED (WHOLE) or contains it (not WHOLE).
fn message_verdict(expected: std::compiler::DiagnosticCode, wanted: str, whole: bool, body) -> std::test::Match:
    head = "compiler diagnostic ".concat(std::test::code_name(expected))
    shown = if whole:
        head.concat(", message: ").concat(wanted)
    else:
        head.concat(", message containing: ").concat(wanted)
    o = observe(body)
    if not o.rejected:
        return std::test::mismatch(shown, "a value", "")
    worded = if whole:
        o.message == wanted
    else:
        contains?(o.message, wanted)
    if o.code == expected and worded:
        return std::test::passed()
    std::test::mismatch(shown, "compiler diagnostic ".concat(std::test::code_name(o.code)), o.message)

# BODY's block must be rejected with EXPECTED and exactly the message WANTED.
nomethod fn rejects_with_message(name: str, expected: std::compiler::DiagnosticCode, wanted: str, body) -> unit:
    fn check() -> std::test::Match:
        message_verdict(expected, wanted, true, body)
    std::test::case(name, check)

# BODY's block must be rejected with EXPECTED and a message containing
# FRAGMENT.
nomethod fn rejects_mentioning(name: str, expected: std::compiler::DiagnosticCode, fragment: str, body) -> unit:
    fn check() -> std::test::Match:
        message_verdict(expected, fragment, false, body)
    std::test::case(name, check)

# ---------------------------------------------------------------------------
# The four counted forms. Each program is the Tcl tests' `fn f(): loop
# HEADER: i` / `f()` with that test's literal header.

# `from S to E`: S, S + 1, ..., E - 1.
fn register_ascending_exclusive_tests():
    fn up_to_empty() errors std::compiler::CompilerError:
        static compile:
            fn f():
                loop i from 0 to 0:
                    i
            f()
    std::test::value("loop-collecting-up-to-empty", [], up_to_empty)

    fn up_to_one() errors std::compiler::CompilerError:
        static compile:
            fn f():
                loop i from 0 to 1:
                    i
            f()
    std::test::value("loop-collecting-up-to-one", [0], up_to_one)

    fn up_to_three() errors std::compiler::CompilerError:
        static compile:
            fn f():
                loop i from 0 to 3:
                    i
            f()
    std::test::value("loop-collecting-up-to-three", [0, 1, 2], up_to_three)

    fn up_to_reversed() errors std::compiler::CompilerError:
        static compile:
            fn f():
                loop i from 3 to 1:
                    i
            f()
    std::test::value("loop-collecting-up-to-reversed", [], up_to_reversed)

    fn up_to_negative() errors std::compiler::CompilerError:
        static compile:
            fn f():
                loop i from -3 to 0:
                    i
            f()
    std::test::value("loop-collecting-up-to-negative", [-3, -2, -1], up_to_negative)

    fn up_to_spanning() errors std::compiler::CompilerError:
        static compile:
            fn f():
                loop i from -2 to 3:
                    i
            f()
    std::test::value("loop-collecting-up-to-spanning", [-2, -1, 0, 1, 2], up_to_spanning)

    fn up_to_doc() errors std::compiler::CompilerError:
        static compile:
            fn f():
                loop i from 2 to 5:
                    i
            f()
    std::test::value("loop-collecting-up-to-doc", [2, 3, 4], up_to_doc)

# `from S through E`: S, S + 1, ..., E.
fn register_ascending_inclusive_tests():
    fn up_through_single() errors std::compiler::CompilerError:
        static compile:
            fn f():
