                    i
            f()
    std::test::value("loop-collecting-up-through-single", [0], up_through_single)

    fn up_through_two() errors std::compiler::CompilerError:
        static compile:
            fn f():
                loop i from 0 through 1:
                    i
            f()
    std::test::value("loop-collecting-up-through-two", [0, 1], up_through_two)

    fn up_through_four() errors std::compiler::CompilerError:
        static compile:
            fn f():
                loop i from 0 through 3:
                    i
            f()
    std::test::value("loop-collecting-up-through-four", [0, 1, 2, 3], up_through_four)

    fn up_through_reversed() errors std::compiler::CompilerError:
        static compile:
            fn f():
                loop i from 3 through 1:
                    i
            f()
    std::test::value("loop-collecting-up-through-reversed", [], up_through_reversed)

    fn up_through_just_past() errors std::compiler::CompilerError:
        static compile:
            fn f():
                loop i from 3 through 2:
                    i
            f()
    std::test::value("loop-collecting-up-through-just-past", [], up_through_just_past)

    fn up_through_spanning() errors std::compiler::CompilerError:
        static compile:
            fn f():
                loop i from -2 through 2:
                    i
            f()
    std::test::value("loop-collecting-up-through-spanning", [-2, -1, 0, 1, 2], up_through_spanning)

    fn up_through_doc() errors std::compiler::CompilerError:
        static compile:
            fn f():
                loop i from 2 through 5:
                    i
            f()
    std::test::value("loop-collecting-up-through-doc", [2, 3, 4, 5], up_through_doc)

