# warning-programs.bot -- the programs of the compiler-warning tests: what
# they compute, on every backend, and which of them the compiler rejects
# before any warning could be reported, as a source-level specification
# (manifest: category warnings).
#
# A warning (WARNINGS-SAME-RETURN.md and the WARNINGS-*.md of each code) is
# never part of a program's meaning, and Botlish source cannot observe one:
# the golden runner compiles every suite with -warnings off. So the warnings
# themselves -- their presence, absence, location, message, data and count,
# and the -strict 0 diagnostics lists -- stay in the Tcl tests. What this
# suite pins is the other half of those tests, the programs:
#
# * every program a warning is reported on computes the same value on every
#   backend (each code's backend-independence program);
# * ONE-CHAR-STRING-LITERAL: std::str::length counts characters (Unicode scalar
#   values: escapes resolved, a supplementary-plane character is one, a
#   letter plus a combining mark is two); call results and computed Strings
#   are ordinary values; a one-character String and its character spelling
#   are different values -- a str parameter rejects the character (TYPE), a
#   native's str parameter accepts it statically, == of the two kinds is
#   false, a kind-tolerant consumer gives the same value for both, and a
#   UnicodeChar parameter rejects the String (TYPE); every character
#   spelling denotes its code point; a context (and a context trait)
#   parameter reads the installed context;
# * FIXED-ARITY-LIST-RETURN: a same-scope rebinding is DUPLICATE and a struct
#   annotation over list exits is TYPE (neither program is ever warned
#   about); a List[int] result annotation changes no value; converting a
#   fixed-arity list result to an anonymous struct keeps its field reads
#   checked (UNKNOWN-FIELD), catches a leftover read through a source
#   function (TYPE), accepts a leftover native read statically, and turns a
#   leftover == against a list literal silently false;
# * PROVES-NAMING: a proves clause needs a declared bool or unit result and
#   names an ordinary parameter (PROOF-CLAUSE otherwise); `?` method sugar
#   resolves; the conventional rename keeps the value;
# * SAME-FAILURE: an unadmitted fail is UNHANDLED-ERROR and a fail of an
#   undeclared error is UNDECLARED-ERROR (never warned about);
# * MANY-BOOLEAN-ARGUMENTS: supplied flags are true beside ordinary bools.
#
# Ported from tests/one-char-string-literal.test,
# tests/fixed-arity-list-return.test, tests/proves-naming.test,
# tests/same-failure.test and tests/many-boolean-arguments.test (the Tcl
# tests stay authoritative and unchanged). A Tcl test that runs a program
# compiled under the default policy (each file's *-backend-independent) has
# the same program and value as its warnings-off twin
# (*-backend-independent-off), whose golden test here stands for both;
# warnings.test's warn-backend-independent likewise maps to harness.bot's
# warn-backend-independent-off.
#
# Rejections compare the diagnostic code only: no Tcl test ported here pins
# a location or a message. A Tcl program that ends with a declaration ends
# its block with a value, 0. Two accepted programs fail at run time in the
# Tcl tests with a TYPE error no handler catches (a native's parameter type
# is checked at run time); here their failing call stays reachable, under a
# condition that is false at run time (a registration parameter), so the
# block's acceptance is the theorem and the suite never aborts.
#
# Imports:
#   char      std::char::scalar_value (the UnicodeChar-typed code functions)
#   compiler  std::compiler::CompilerError and DiagnosticCode (every body)
#   list      std::list::get and std::list::at (the fixed-arity conversion's leftovers)
#   str       std::str::length, std::str::concat and the String methods substring,
#             lowercase and concat
#   test      the framework
import std::char
import std::compiler
import std::list
import std::str
import std::test

# ---------------------------------------------------------------------------
# Declarations (top-level only), renamed from the Tcl programs' one-letter
# names.

# one-char-string-literal.test's context programs. A context's fields must
# fit fixed native slots (CONTEXTS.md), so the Tcl programs' int field is a
# bounded Int here.
type Small = Int in 0..1000

# oc-context-load-key-is-not-a-literal's context struct C (a parameter of
# its type is loaded under its name, a one-character key there) and its
# consumer f.
context struct LoadKeyed:
    v: Small

fn loaded_value(context c: LoadKeyed) -> int:
    c.v

# oc-context-trait-key-is-not-a-literal's context trait T, its one
# implementation W (with W's tick) and the trait's consumer f.
context trait Ticking:
    fn tick(n: int) -> int

context struct TickSource:
    v: Small

fn tick(n: int, context w: TickSource) -> int:
    w.v + n

fn ticked(n: int, context t: Ticking) -> int:
    t.tick(n)

# fa-annotation-struct-is-a-checker-error's struct P.
struct Wrapped:
    x: int

# proves-naming.test's refinement E and error Bad.
refined type Vetted = str

error NotVetted

# same-failure.test: sf-strict0-unadmitted-fail-never-warned's E and the
# backend-independence program's Invalid. (sf-strict0-undeclared-error-
# never-warned's Nope is declared nowhere: that is its point.)
error Unadmitted

error Invalid

# ---------------------------------------------------------------------------
# one-char-string-literal.test

# SAMPLES are the Strings of oc-length-is-str-length, passed in so that
# their lengths are computed at run time; RUN_CHARACTER_SPELLING is false.
fn register_one_char_string_literal_tests(samples: List[str]):
    # oc-length-is-str-length: the length the warning measures is the
    # language's own std::str::length -- 0, 1 and 2 characters; a letter plus a
    # combining mark is two, the precomposed letter one, a supplementary-
    # plane character one; an escaped backslash and an escaped newline one.
    fn b_lengths() errors std::compiler::CompilerError:
        static compile:
            [std::str::length(""), std::str::length("a"), std::str::length("ab"), std::str::length("é"), std::str::length("é"), std::str::length("😀"), std::str::length("😀a"), std::str::length("\\"), std::str::length("\n")]
    std::test::value("oc-length-is-str-length", [0, 1, 2, 2, 1, 1, 2, 1, 1], b_lengths)

    # ... and the same lengths of the same Strings as run-time values (the
    # Tcl test's literal arguments may be folded by the compiler).
    fn b_lengths_at_run_time() errors std::compiler::CompilerError:
        static compile:
            loop s in samples:
                std::str::length(s)
    std::test::value("oc-length-is-str-length/run-time", [0, 1, 2, 2, 1, 1, 2, 1, 1], b_lengths_at_run_time)

    # oc-call-results-silent: one-character call results.
    fn b_call_results() errors std::compiler::CompilerError:
        static compile:
            fn second() -> str:
                "xy".substring(1, 2)
            fn pick(flag) -> str:
                if flag:
                    "ab".substring(0, 1)
                else:
                    "cd".substring(1, 2)
            [second(), pick(true), pick(false)]
    std::test::value("oc-call-results-silent", ["y", "a", "d"], b_call_results)

    # oc-computed-strings-silent: concatenations, lowercase and substring.
    fn b_computed_strings() errors std::compiler::CompilerError:
        static compile:
            a = std::str::concat("ab", "")
            b = "AB".lowercase().substring(0, 1)
            c = std::str::concat("x", "")
            [a, b, c]
    std::test::value("oc-computed-strings-silent", ["ab", "a", "x"], b_computed_strings)

    # oc-str-parameter-is-the-api-deficiency-shape: a str parameter takes the
    # one-character String; its character spelling is a TYPE error there.
    fn b_str_parameter_string() errors std::compiler::CompilerError:
        static compile:
            fn width(text: str) -> int:
                7
            width("a")
    std::test::value("oc-str-parameter-is-the-api-deficiency-shape/string", 7, b_str_parameter_string)

    fn b_str_parameter_char() errors std::compiler::CompilerError:
        static compile:
            fn width(text: str) -> int:
                7
            width('a')
    std::test::rejects("oc-str-parameter-is-the-api-deficiency-shape/char", std::compiler::DiagnosticCode::Type, b_str_parameter_char)

    # oc-str-native-argument-warns: a native's str parameter takes the
    # one-character String; its character spelling is a compile-time Type
    # there (an argument statically of another kind than a native requires,
    # METHOD-RECEIVER-TYPE-CORRECTNESS-MILESTONE-1.md; it compiled and failed
    # at run time before).
    fn b_native_argument_string() errors std::compiler::CompilerError:
        static compile:
            std::str::length("a")
    std::test::value("oc-str-native-argument-warns/string", 1, b_native_argument_string)

    fn b_native_argument_char() errors std::compiler::CompilerError:
        static compile:
            std::str::length('a')
    std::test::rejects("oc-str-native-argument-warns/char-rejected", std::compiler::DiagnosticCode::Type, b_native_argument_char)

    # oc-comparison-with-a-string-warns: == with a one-character String; the
    # character spelling silently changes the value (== of two kinds is
    # false, not an error).
    fn b_comparison_string() errors std::compiler::CompilerError:
        static compile:
            fn is_quote(text: str) -> bool:
                text == "\""
            [is_quote("\""), is_quote("ab")]
    std::test::value("oc-comparison-with-a-string-warns/string", [true, false], b_comparison_string)

    fn b_comparison_char() errors std::compiler::CompilerError:
        static compile:
            fn is_quote(text: str) -> bool:
                text == '"'
            [is_quote("\""), is_quote("ab")]
    std::test::value("oc-comparison-with-a-string-warns/char", [false, false], b_comparison_char)

    # oc-character-accepting-context-warns: a kind-tolerant consumer gives
    # the same value for the String and for its character spelling.
    fn b_accepting_string() errors std::compiler::CompilerError:
        static compile:
            fn is_comma(c):
                c == ',' or c == ","
            is_comma(",")
    std::test::value("oc-character-accepting-context-warns/string", true, b_accepting_string)

    fn b_accepting_char() errors std::compiler::CompilerError:
        static compile:
            fn is_comma(c):
                c == ',' or c == ","
            is_comma(',')
    std::test::value("oc-character-accepting-context-warns/char", true, b_accepting_char)

    # oc-character-typed-parameter: a UnicodeChar parameter takes the
    # character spelling; the String spelling there is a TYPE error.
    fn b_typed_char() errors std::compiler::CompilerError:
        static compile:
            fn code(c: UnicodeChar) -> int:
                std::char::scalar_value(c)
            code(',')
    std::test::value("oc-character-typed-parameter/char", 44, b_typed_char)

    fn b_typed_string() errors std::compiler::CompilerError:
        static compile:
            fn code(c: UnicodeChar) -> int:
                std::char::scalar_value(c)
            code(",")
    std::test::rejects("oc-character-typed-parameter/string", std::compiler::DiagnosticCode::Type, b_typed_string)

    # oc-backend-independent-off (and oc-backend-independent, the same
    # program under the default policy): a top-level binding read by a
    # nested function becomes a block binding here.
    fn b_backend_independent() errors std::compiler::CompilerError:
        static compile:
            sep = ","
            fn quote(text: str) -> str:
                "\"".concat(text).concat("\"")
            fn joined(a, b):
                a.concat(sep).concat(b)
            fn width(text: str) -> int:
                std::str::length(text)
            [quote("a"), joined("x", "yz"), width(";"), width(""), [',', "ab"]]
    std::test::value("oc-backend-independent-off", ["\"a\"", "x,yz", 1, 0, [',', "ab"]], b_backend_independent)

    # oc-spelling-law-unit: the character spelling of each one-character
    # String -- a letter, punctuation, both quotes, a backslash, newline,
    # tab, carriage return, a two-byte, a three-byte and a supplementary-
    # plane character -- denotes its code point, and a UnicodeChar parameter
    # takes it.
    fn b_spelling_law() errors std::compiler::CompilerError:
        static compile:
            fn code(c: UnicodeChar) -> int:
                std::char::scalar_value(c)
            [code('a'), code(','), code('"'), code('\''), code('\\'), code('\n'), code('\t'), code('\r'), code('é'), code('世'), code('😀')]
    std::test::value("oc-spelling-law-unit", [97, 44, 34, 39, 92, 10, 9, 13, 233, 19990, 128512], b_spelling_law)

# The context programs of one-char-string-literal.test. A body cannot need
# a context, so the consumers run here, with the suite's installations
# (LoadKeyed {v: 3}, TickSource {v: 3}), and the bodies compare what they
# read.
fn register_context_key_tests():
    # oc-context-load-key-is-not-a-literal: f() reads the installed
    # context's field; x is an ordinary String binding.
    loaded = loaded_value()
    fn b_load_key() errors std::compiler::CompilerError:
        static compile:
            x = "C"
            [loaded, x]
    std::test::value("oc-context-load-key-is-not-a-literal", [3, "C"], b_load_key)

    # oc-context-trait-key-is-not-a-literal: f(1) calls tick through the
    # context trait, selected statically as the one installed implementation.
    ticks = ticked(1)
    fn b_trait_key() errors std::compiler::CompilerError:
        static compile:
            x = "T"
            [ticks, x]
    std::test::value("oc-context-trait-key-is-not-a-literal", [4, "T"], b_trait_key)

# ---------------------------------------------------------------------------
# fixed-arity-list-return.test

# RUN_LEFTOVER is false.
fn register_fixed_arity_list_return_tests():
    # fa-rebinding-same-scope-is-an-error: a same-scope rebinding is
    # DUPLICATE (so the program is never warned about).
    fn b_rebinding() errors std::compiler::CompilerError:
        static compile:
            fn f(a, b):
                r = [a, b]
                r = [a, b, a]
                r
            0
    std::test::rejects("fa-rebinding-same-scope-is-an-error", std::compiler::DiagnosticCode::Duplicate, b_rebinding)

    # fa-annotation-struct-is-a-checker-error: a struct result annotation
    # over list exits is a TYPE error.
    fn b_struct_annotation() errors std::compiler::CompilerError:
        static compile:
            fn f(a: int) -> Wrapped:
                [a, a]
            0
    std::test::rejects("fa-annotation-struct-is-a-checker-error", std::compiler::DiagnosticCode::Type, b_struct_annotation)

    # fa-annotation-changes-nothing-else: the annotated and the unannotated
    # twin compute the same value (the annotation is a type declaration,
    # not a warning switch).
    fn b_annotated() errors std::compiler::CompilerError:
        static compile:
            fn pair(a: int, b: int) -> List[int]:
                [a, b]
            pair(3, 4)
    std::test::value("fa-annotation-changes-nothing-else/annotated", [3, 4], b_annotated)

    fn b_unannotated() errors std::compiler::CompilerError:
        static compile:
            fn pair(a: int, b: int):
                [a, b]
            pair(3, 4)
    std::test::value("fa-annotation-changes-nothing-else/plain", [3, 4], b_unannotated)

    # fa-backend-independent-off (and fa-backend-independent, the same
    # program under the default policy).
    fn b_backend_independent() errors std::compiler::CompilerError:
        static compile:
            fn pair(a, b):
                if a == 0:
                    return [b, a]
                [a, b]
            p = pair(3, 4)
            p
    std::test::value("fa-backend-independent-off", [3, 4], b_backend_independent)

    # The conversion the warning suggests: pair's fixed-arity list result
    # becomes an anonymous struct {p0, p1}.

    # fa-conversion-field-reads-checked: a field the converted result does
    # not have is UNKNOWN-FIELD.
    fn b_field_reads_checked() errors std::compiler::CompilerError:
        static compile:
            fn pair(a, b):
                {p0: a, p1: b}
            fn use(x):
                r = pair(x, 1)
                r.p2
            use(1)
    std::test::rejects("fa-conversion-field-reads-checked", std::compiler::DiagnosticCode::UnknownField, b_field_reads_checked)

    # fa-conversion-field-reads-compile: the converted reads run.
    fn b_field_reads_compile() errors std::compiler::CompilerError:
        static compile:
            fn pair(a, b):
                {p0: a, p1: b}
            fn use(x):
                r = pair(x, 1)
                [r.p1, r.p0]
            use(5)
    std::test::value("fa-conversion-field-reads-compile", [1, 5], b_field_reads_compile)

    # fa-conversion-leftover-through-source-function: a leftover positional
    # read through a source function (std::list::get) is a TYPE error.
    fn b_leftover_source_function() errors std::compiler::CompilerError:
        static compile:
            fn pair(a, b):
                {p0: a, p1: b}
            std::list::get(pair(1, 2), 0, 7)
    std::test::rejects("fa-conversion-leftover-through-source-function", std::compiler::DiagnosticCode::Type, b_leftover_source_function)

    # fa-conversion-leftover-native-read-is-a-type-error: a leftover direct
    # native read (std::list::at) of the converted struct is a compile-time
    # Type, as the read through a source function is (the gap that it
    # compiled and failed at run time was closed by
    # METHOD-RECEIVER-TYPE-CORRECTNESS-MILESTONE-1.md).
    fn b_leftover_native_read() errors std::compiler::CompilerError:
        static compile:
            fn pair(a, b):
                {p0: a, p1: b}
            v = std::list::at(pair(1, 2), 0):
                on IndexNotFound:
                    0
            v
    std::test::rejects("fa-conversion-leftover-native-read-is-a-type-error", std::compiler::DiagnosticCode::Type, b_leftover_native_read)

    # fa-conversion-leftover-equality-is-silent: a leftover == against a
    # list literal is silently false (no EQUALITY error).
    fn b_leftover_equality() errors std::compiler::CompilerError:
        static compile:
            fn pair(a, b):
                {p0: a, p1: b}
            pair(1, 2) == [1, 2]
    std::test::value("fa-conversion-leftover-equality-is-silent", false, b_leftover_equality)

# ---------------------------------------------------------------------------
# proves-naming.test

fn register_proves_naming_tests():
    # pn-predicate-needs-a-declared-bool: a proves clause on a function with
    # no result annotation, with -> str or with -> int is PROOF-CLAUSE.
    fn b_no_result() errors std::compiler::CompilerError:
        static compile:
            fn p(v: str) proves v: Vetted:
                true
            0
    std::test::rejects("pn-predicate-needs-a-declared-bool/no-result", std::compiler::DiagnosticCode::ProofClause, b_no_result)

    fn b_str_result() errors std::compiler::CompilerError:
        static compile:
            fn p(v: str) -> str proves v: Vetted:
                v
            0
    std::test::rejects("pn-predicate-needs-a-declared-bool/str", std::compiler::DiagnosticCode::ProofClause, b_str_result)

    fn b_int_result() errors std::compiler::CompilerError:
        static compile:
            fn p(v: str) -> int proves v: Vetted:
                1
            0
    std::test::rejects("pn-predicate-needs-a-declared-bool/int", std::compiler::DiagnosticCode::ProofClause, b_int_result)

    # pn-scope-zero-parameters-unrepresentable: the clause must name an
    # ordinary parameter -- not a missing one, not a flag.
    fn b_zero_parameters() errors std::compiler::CompilerError:
        static compile:
            fn p() -> bool proves v: Vetted:
                true
            0
    std::test::rejects("pn-scope-zero-parameters-unrepresentable/zero", std::compiler::DiagnosticCode::ProofClause, b_zero_parameters)

    fn b_flag_parameter() errors std::compiler::CompilerError:
        static compile:
            fn p(flags :v) -> bool proves v: Vetted:
                true
            0
    std::test::rejects("pn-scope-zero-parameters-unrepresentable/flag", std::compiler::DiagnosticCode::ProofClause, b_flag_parameter)

    # pn-shape-parameter-count: zero ordinary parameters cannot carry proves.
    fn b_shape_zero() errors std::compiler::CompilerError:
        static compile:
            fn zero() -> bool proves a: Vetted:
                true
            0
    std::test::rejects("pn-shape-parameter-count/zero", std::compiler::DiagnosticCode::ProofClause, b_shape_zero)

    # pn-backend-independent-off (and pn-backend-independent, the same
    # program under the default policy): a predicate and a validator whose
    # names do not follow the convention.
    fn b_backend_independent() errors std::compiler::CompilerError:
        static compile:
            fn emailish(v: str) -> bool proves v: Vetted:
                v == "a@b"
            fn check_email(v: str) -> unit proves v: Vetted errors NotVetted:
                if v == "":
                    fail NotVetted
                unit
            fn need(v: Vetted) -> int:
                7
            fn use(s: str) -> int:
                if emailish(s):
                    need(s)
                else:
                    0
            fn use2(s: str) -> int:
                check_email(s):
                    on NotVetted:
                        return -1
                3
            [use("a@b"), use("x"), use2(""), use2("y")]
    std::test::value("pn-backend-independent-off", [7, 0, -1, 3], b_backend_independent)

    # pn-question-method-sugar-parses: a `?`-suffixed method-sugar call
    # parses and resolves.
    fn b_question_method_sugar() errors std::compiler::CompilerError:
        static compile:
            fn emailish?(v: str) -> bool proves v: Vetted:
                v == "a"
            ["a".emailish?(), "b".emailish?()]
    std::test::value("pn-question-method-sugar-parses", [true, false], b_question_method_sugar)

    # pn-rename-is-semantics-preserving: the conventional rename (emailish ->
    # emailish?, check_email -> validate_check_email) of the program above
    # computes its value.
    fn b_renamed() errors std::compiler::CompilerError:
        static compile:
            fn emailish?(v: str) -> bool proves v: Vetted:
                v == "a@b"
            fn validate_check_email(v: str) -> unit proves v: Vetted errors NotVetted:
                if v == "":
                    fail NotVetted
                unit
            fn need(v: Vetted) -> int:
                7
            fn use(s: str) -> int:
                if emailish?(s):
                    need(s)
                else:
                    0
            fn use2(s: str) -> int:
                validate_check_email(s):
                    on NotVetted:
                        return -1
                3
            [use("a@b"), use("x"), use2(""), use2("y")]
    std::test::value("pn-rename-is-semantics-preserving", [7, 0, -1, 3], b_renamed)

# ---------------------------------------------------------------------------
# same-failure.test

fn register_same_failure_tests():
    # sf-strict0-unadmitted-fail-never-warned: fails of an error the
    # function does not declare are UNHANDLED-ERROR.
    fn b_unadmitted() errors std::compiler::CompilerError:
        static compile:
            fn f(x):
                if x == 1:
                    fail Unadmitted
                if x == 2:
                    fail Unadmitted
                x
            0
    std::test::rejects("sf-strict0-unadmitted-fail-never-warned", std::compiler::DiagnosticCode::UnhandledError, b_unadmitted)

    # sf-strict0-undeclared-error-never-warned: fails of an error declared
    # nowhere are UNDECLARED-ERROR.
    fn b_undeclared() errors std::compiler::CompilerError:
        static compile:
            fn f(x) errors Nope:
                if x == 1:
                    fail Nope
                if x == 2:
                    fail Nope
                x
            0
    std::test::rejects("sf-strict0-undeclared-error-never-warned", std::compiler::DiagnosticCode::UndeclaredError, b_undeclared)

    # sf-backend-independent-off (and sf-backend-independent, the same
    # program under the default policy): two fails of one error, handled
    # per element.
    fn b_backend_independent() errors std::compiler::CompilerError:
        static compile:
            fn parse(x) errors Invalid:
                if x < 0:
                    fail Invalid
                if x > 9:
                    fail Invalid
                x * 2
            v = loop k in [1, -1, 12, 4]:
                r = parse(k):
                    on Invalid:
                        0
                r
            v
    std::test::value("sf-backend-independent-off", [2, 0, 0, 8], b_backend_independent)

# ---------------------------------------------------------------------------
# many-boolean-arguments.test

fn register_many_boolean_arguments_tests():
    # mb-flags-never-make-the-gate: one ordinary bool and two flags, both
    # supplied: the flags are true.
    fn b_flags() errors std::compiler::CompilerError:
        static compile:
            fn one(path, a: bool, flags :x, :y):
                [path, a, x, y]
            one(true, true, :x, :y)
    std::test::value("mb-flags-never-make-the-gate", [true, true, true, true], b_flags)

    # mb-backend-independent-off (and mb-backend-independent, the same
    # program under the default policy): bool literals, a computed bool and
    # flags forwarded as ordinary bool arguments.
    fn b_backend_independent() errors std::compiler::CompilerError:
        static compile:
            fn weight(base: int, double: bool, negate: bool) -> int:
                if double:
                    if negate:
                        return 0 - base * 2
                    return base * 2
                if negate:
                    return 0 - base
                base
            fn tally(n: int, flags :double, :negate) -> int:
                n.weight(double, negate)
            a = 3.weight(true, false)
            b = 4.weight(false, false)
            c = 5.tally(:double)
            d = 6.weight(a > 5, true)
            [a, b, c, d]
    std::test::value("mb-backend-independent-off", [6, 4, 10, -12], b_backend_independent)

# ---------------------------------------------------------------------------
# The suite

fn register_warning_programs_tests():
    register_one_char_string_literal_tests(["", "a", "ab", "é", "é", "😀", "😀a", "\\", "\n"])
    register_context_key_tests()
    register_fixed_arity_list_return_tests()
    register_proves_naming_tests()
    register_same_failure_tests()
    register_many_boolean_arguments_tests()

with context std::test::suite()
with context LoadKeyed {v: 3}
with context TickSource {v: 3}
register_warning_programs_tests()
std::test::report()
