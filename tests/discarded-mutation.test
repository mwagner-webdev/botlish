        s.seen.push(x)
        if x < 0:
            continue
        State {seen: s.seen, n: s.n + 1}
    w.n
f(\[1, -2\])"
} -result {{fold-exit 9:13}}

test dm-fold-handler {an exit in the handler of the mutating call itself discards no mutation of that call (the failed call made none), only what ran before it; an exit after the handled call, which completed on every path that reaches it, discards both} -body {
    list [silent "${::foldDecl}fn f(xs: List\[int\]) -> int:
    w = fold x in xs with intermediate acc ints():
        acc.pop():
            on IndexNotFound:
                continue
        acc
    w.length()
f(\[1, 2\])"] [sites "${::foldDecl}fn f(xs: List\[int\]) -> int:
    w = fold x in xs with intermediate acc ints():
        acc.push(x)
        acc.pop():
            on IndexNotFound:
                continue
        if x == 2:
            continue
        acc
    w.length()
f(\[1, 2\])"]
} -result {1 {{fold-exit 9:17} {fold-exit 11:13}}}

test dm-fold-return-is-not-a-fold-exit {a return after a mutation of the intermediate leaves the fold with no value: never a fold-exit fact; the mutation is dead (nothing reads it on that one path) and the dead-mutation fact says so, about the intermediate} -body {
    shown "${::foldDecl}fn f(xs: List\[int\]) -> int:
    w = fold x in xs with intermediate acc ints():
        acc.push(x)
        return 0
    w.length()
f(\[1\])"
} -result {{this mutation of `acc` is never observed: nothing reads `acc` again before it goes out of scope (a fold carries its intermediate's changes only to the iteration after one that completes with it) @ 6:9}}

test dm-fold-dead-and-exit-once {a mutation followed unconditionally by the exit is dead and discarded by the exit: one warning, the fold-exit one, which says why} -body {
    sites "${::foldDecl}fn f(xs: List\[int\]) -> int:
    w = fold x in xs with intermediate acc ints():
        acc.push(x)
        continue
    w.length()
f(\[1\])"
} -result {{fold-exit 7:9}}

test dm-fold-conditional-mutation-then-exit {a mutation in one branch followed, on every path, by an exit is dead (nothing ever reads it) but no fold-exit fact (not every path to the exit ran it): the dead-mutation fact reports it} -body {
    sites "${::foldDecl}fn f(xs: List\[int\]) -> int:
    w = fold x in xs with intermediate acc ints():
        if x > 0:
            acc.push(x)
        continue
    w.length()
f(\[1\])"
} -result {{dead 7:13}}

test dm-fold-normal-completion {the documented idiom, push and complete with the intermediate, is silent; completing with something else instead discards the push (dead)} -body {
    list [silent "${::foldDecl}fn f(xs: List\[int\]) -> int:
    w = fold x in xs with intermediate acc ints():
        acc.push(x)
        acc
    w.length()
f(\[1, 2\])"] [sites "${::foldDecl}fn f(xs: List\[int\]) -> int:
    w = fold x in xs with intermediate acc ints():
        acc.push(x)
        ints()
    w.length()
f(\[1, 2\])"]
} -result {1 {{dead 6:9}}}

test dm-fold-unreachable-exit {an exit the completion analysis proves unreachable warns nothing} -body {
    silent "${::foldDecl}fn f(xs: List\[int\]) -> int:
    w = fold x in xs with intermediate acc ints():
        acc.push(x)
        if x > 0:
            if x < 0:
                continue
        acc
    w.length()
f(\[1\])"
} -result 1

test dm-fold-every-loop-kind {a fold of each loop kind -- over a List, counted, lockstep, unbounded -- has its exits judged} -body {
    list [sites "${::foldDecl}fn f(n: int) -> int:
    w = fold i from 0 to n with intermediate acc ints():
        acc.push(i)
        if i == 1:
            continue
        acc
    w.length()
f(3)"] [sites "${::foldDecl}fn f(xs: List\[int\], ys: List\[int\]) -> int:
    w = fold x in xs and y in xs with intermediate acc ints():
        acc.push(x + y)
        if x == 1:
            break
        acc
    w.length()
f(\[1, 2\], \[3, 4\])"]
} -result {{{fold-exit 8:13}} {{fold-exit 8:13}}}

test dm-fold-exit-deep {an exit 400 conditions deep inside a fold, after a push of the intermediate, at Tcl's default recursion limit: the fold-exit walk follows the nesting in depth-safe segments (core/deep.tcl) and reports it} -body {
    set depth 400
    set lines [list "fn f(xs: List\[int\], p: int) -> int:" "    w = fold x in xs with intermediate acc ints():" "        acc.push(x)"]
    for {set i 0} {$i < $depth} {incr i} {
        lappend lines "[string repeat {    } [expr {$i + 2}]]if p > $i:"
    }
    lappend lines "[string repeat {    } [expr {$depth + 2}]]continue" "        acc" "    w.length()" "f(\[1\], 1000)"
    set saved [interp recursionlimit {}]
    interp recursionlimit {} 1000
    try {
        set result [sites "${::foldDecl}[join $lines \n]"]
    } finally {
        interp recursionlimit {} $saved
    }
    set result
} -result [list [list fold-exit [expr {3 + 3 + 400 + 1}]:[expr {4 * 402 + 1}]]]

# ---------------------------------------------------------------------------
# The policy (WARNINGS-SAME-RETURN.md's one global switch)

set ::dmProgram "${::vec}fn f() -> int:
    v = std::mutable_vector::from_list(\[0\])
    v.push(1)
    0
f()"

test dm-mode-off {off runs no warning pass and attaches nothing} -body {
    hir::warnings::resetStats
    set hir [compileWith $::dmProgram off]
    list [hir::warnings::of $hir] [dict getdef [hir::warnings::stats] DISCARDED-MUTATION 0]
} -result {{} 0}

test dm-mode-error {error rejects the program with the warning's own code and message, located at the mutation, its related location after it} -body {
    lassign [rejection $::dmProgram error] code message
    list $code [regsub -all {t\.bot:} $message {}]
} -result {{CORE SEMANTIC DISCARDED-MUTATION} {4:5: this mutation of `v` is never observed: nothing reads `v` again before it goes out of scope (also at 3:5)}}

test dm-mode-default-runs {default runs the pass and attaches the warning} -body {
    hir::warnings::resetStats
    set hir [compileWith $::dmProgram default]
    list [llength [dmOf $hir]] [dict getdef [hir::warnings::stats] DISCARDED-MUTATION 0]
} -result {1 1}

test dm-registered {DISCARDED-MUTATION is one more static registry entry} -body {
    dict get $::hir::warnings::passes DISCARDED-MUTATION
} -result hir::warnings::DiscardedMutation

test dm-rejected-program-not-warned {a program the compiler rejects is never warned about} -body {
    catch {compileWith "${::vec}fn f(v: MutableVector\[int\]) -> int:
    v.push(1)
    0
f(std::mutable_vector::from_list(\[0\]))"} message options
    lindex [dict get $options -errorcode] end
} -result NONPLACE-PARAMETER-MUTATION

test dm-cli {main.tcl prints the warning on standard error with its Compilerpedia help line, and runs the program; -warnings error rejects it} -constraints executableAot -body {
    set dir [makeDirectory dm-cli-[pid]]
    set path [file join $dir p.bot]
    set f [open $path w]
    puts -nonewline $f $::dmProgram
    close $f
    set main [file join $::projectRoot main.tcl]
    set default [catch {exec [info nameofexecutable] $main -backend interp -warnings default $path 2>@1} out]
    set strict [catch {exec [info nameofexecutable] $main -backend interp -warnings error $path 2>@1} err]
    list $default [regexp {warning: this mutation of `v` is never observed[^\n]*\(DISCARDED-MUTATION\)} $out] \
        [regexp {help: tclsh9.0 main.tcl -help warning.discarded-mutation} $out] [regexp {value: 0} $out] \
        $strict [regexp {DISCARDED-MUTATION} $err]
} -cleanup {removeDirectory dm-cli-[pid]} -result {0 1 1 1 1 1}

# ---------------------------------------------------------------------------
# Nothing changes but the side table

test dm-hir-unchanged-by-mode {the HIR every backend compiles is the same with warnings on and off (but the warnings side table), and hir::format prints no warning} -body {
    set on [compileWith $::dmProgram default]
    set off [compileWith $::dmProgram off]
    list [expr {[dict remove $on warnings] eq [dict remove $off warnings]}] \
        [expr {[hir::format $on] eq [hir::format $off]}] [regexp DISCARDED [hir::format $on]]
} -result {1 1 0}

test dm-checked-source {the checked program as written is kept only for a program that may mutate a collection, never for a trait program (whose traitSource it is), and interchange text leaves it out: a decoded HIR carries the warnings, not the source} -body {
    set hir [compileWith $::dmProgram default]
    set plain [compileWith "fn f() -> int:\n    1\nf()" default]
    set trait [compileWith "import std::mutable_set\nfn f() -> int:\n    s = std::mutable_set::create\[int\]()\n    s.add(1)\n    0\nf()" default]
    set back [hir::interchange::decode [hir::interchange::encode $hir]]
    list [dict exists $hir checkedSource] [dict exists $plain checkedSource] [dict exists $trait checkedSource] \
        [dict exists $back checkedSource] [llength [dmOf $back]] \
        [expr {[hir::interchange::encode $hir] eq [hir::interchange::encode [dict remove $hir checkedSource]]}]
} -result {1 0 0 0 1 1}

test dm-elaborated-hir-not-analyzed {an elaborated HIR with no checked source (a fold's intermediate renamed, copies written out) is no program as written: the analysis declines it rather than misread it} -body {
    set hir [compileWith "${::foldDecl}fn f(xs: List\[int\]) -> int:
    w = fold x in xs with intermediate acc ints():
        acc.push(x)
        if x < 0:
            continue
        acc
    w.length()
f(\[1, -2\])" default]
    list [llength [hir::discarded::findings $hir]] [hir::discarded::findings [dict remove $hir checkedSource]]
} -result {1 {}}

test dm-backends-agree {every backend runs a warned program to the same value as with warnings off} -body {
    list [values $::dmProgram default] [values $::dmProgram off] \
        [values [core::ReadFile [file join $::dmCorpus c08-fold-continue.bot]] default]
} -result {{{value 0}} {{value 0}} {{value {[1, 3]}}}}

test dm-native-unchanged {native IR (specialized and generic) is identical with warnings off and on} -body {
    set on [compileWith $::dmProgram default]
    set off [compileWith $::dmProgram off]
    list [expr {[native::nir $off] eq [native::nir $on]}] [expr {[native::nir $off -specialize 0] eq [native::nir $on -specialize 0]}]
} -result {1 1}

cleanupTests
