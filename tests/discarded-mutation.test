        grow(acc, x)
        if x < 0:
            continue
        acc
    w.length()
f(\[1, -2\])"
} -result {{fold-exit 10:13}}

test dm-fold-read-only-and-moved {a read of the intermediate before an exit is no mutation; nor is mutating a copy of it (the copy is its own place): silent} -body {
    list [silent "${::foldDecl}fn f(xs: List\[int\]) -> int:
    w = fold x in xs with intermediate acc ints():
        if acc.length() > 2:
            continue
        acc.push(x)
        acc
    w.length()
f(\[1, 2, 3, 4\])"] [silent "${::foldDecl}fn f(xs: List\[int\]) -> int:
    w = fold x in xs with intermediate acc ints():
        copy = acc
        copy.push(x)
        if x < 0:
            continue
        copy
    w.length()
f(\[1, -2\])"]
} -result {1 1}

test dm-fold-struct-intermediate {a field of a struct intermediate mutated before an exit is a mutation of the intermediate} -body {
    sites "${::vec}struct State:
    seen: MutableVector\[int\]
    n: int
fn f(xs: List\[int\]) -> int:
