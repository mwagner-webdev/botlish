# loop-in.test -- "loop x in EXPR:" (core IR: listloop), the returning
# iterable loop (RETURNING-ITERABLE-LOOPS.md; originally the minimal
# element-binding List-traversal extension added for BYTE-SET.md).
#
# Covers the construct on its own (not only through byte::set): typing,
# left-to-right order, evaluating the iterable exactly once, an empty
# List, break/continue/return/error composition, nested loops, and
# four-way backend parity.
#
# break semantics (RETURNING-ITERABLE-LOOPS.md): a bare `break` ends a
# listloop immediately, returning the List collected so far (the
# "prefix") -- never `unit`, and never overriding the accumulator the way
# a plain `loop`'s own break still does (tests/loops.test, unchanged). A
# `break` carrying a value is rejected outright at compile time
# (LISTLOOP-BREAK-VALUE), since a listloop has exactly one stable result
# type. This supersedes the override-and-discard semantics
# LISTLOOP-BREAK-TYPE-SOUNDNESS.md audited for the original design; see
# RETURNING-ITERABLE-LOOPS.md's own "break-value decision" for the full
# rationale.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]

set parityBackends {interp compile cranelift-generic cranelift}

proc loopSourceHir {text} {
    return [surface::compile $text t.bot -strict 0]
}

proc loopParity {text} {
    set exprs [hir::lower [loopSourceHir $text]]
    set outcomes [lmap backend $::parityBackends {outcomeUnder $backend $exprs}]
    if {[llength [lsort -unique $outcomes]] == 1} { return same }
    return [join [lmap backend $::parityBackends outcome $outcomes {list $backend $outcome}] " / "]
}

proc loopInterpValue {text} {
    lindex [outcomeUnder interp [hir::lower [loopSourceHir $text]]] 1
}

# ---------------------------------------------------------------------------
# Basic shape, order, typing

test loop-in-basic-map {loop x in EXPR: BODY collects each iteration's body value, in order} -body {
    loopInterpValue {loop x in [1, 2, 3]:
    x + x
}
} -result {[2, 4, 6]}

test loop-in-parity {loop x in EXPR: agrees on every backend} -body {
    loopParity {loop x in [1, 2, 3]:
    x + x
}
} -result same

test loop-in-empty-list {an empty iterable runs the body zero times and yields an empty List, no error} -body {
    loopInterpValue {loop x in []:
    x
}
} -result {[]}

test loop-in-empty-list-parity {the empty case agrees on every backend} -body {
    loopParity {loop x in []:
    x
}
} -result same

test loop-in-one-element {a single-element List contributes exactly one value} -body {
    loopInterpValue {loop x in [7]:
    x * 2
}
} -result {[14]}

test loop-in-left-to-right {elements are visited left to right (order-sensitive body)} -body {
    loopInterpValue {result = loop x in [1, 2, 3, 4]:
    x
result
}
} -result {[1, 2, 3, 4]}

test loop-in-element-type-list-of-t {List[T] gives the loop binding type T, no runtime check} -body {
    set hir [loopSourceHir {fn f(xs: List[int]):
    loop x in xs:
        x + 1

f([1, 2])}]
    llength [hir::diagnostics $hir]
} -result 0

test loop-in-broad-element-type {a broad/unknown-element List gives the binding a broad (any) type, not a validation error} -body {
    set hir [loopSourceHir {fn passthrough(x):
    x

loop x in passthrough([1, 2, 3]):
    x}]
    llength [hir::diagnostics $hir]
} -result 0

test loop-in-static-type {loop x in EXPR: BODY has static type List[R], R the body's own type} -body {
    set hir [loopSourceHir {v = loop x in [1, 2, 3]:
    x + 1
v}]
    set e [lindex [dict get $hir roots] end]
    hir::types::show [hir::typeOf $hir $e]
} -result {List[int]}

# ---------------------------------------------------------------------------
# Iterable evaluated exactly once (raw core IR, test-tick/test-log's own
# hyphenated names are not valid Botlish surface identifiers -- matching
# loops.test's own convention for these side-effect-counting fixtures)

test loop-in-iterable-evaluated-once {the iterable expression is evaluated exactly once, not once per iteration} -setup resetEffects -body {
    list [run {listloop {call {block {} {call {ref test-tick}} {const list {1 2 3}}}} {block {x} {ref x}}}] \
         $::testTicks
} -result {{[1, 2, 3]} 1}

# ---------------------------------------------------------------------------
# break / continue / return / error composition

test loop-in-break-returns-prefix {a bare break ends the loop immediately, returning the List collected so far (the accumulated prefix) -- never unit, never a payload} -body {
    loopInterpValue {loop x in [1, 2, 3, 4]:
    if x == 3:
        break
    x
}
} -result {[1, 2]}

test loop-in-break-prefix-parity {break-returns-prefix agrees on every backend} -body {
    loopParity {loop x in [1, 2, 3, 4]:
    if x == 3:
        break
    x
}
} -result same

test loop-in-break-immediately {a break on the very first element returns an empty List, not an error} -body {
    loopInterpValue {loop x in [1, 2, 3]:
    if x == 1:
        break
    x
}
} -result {[]}

test loop-in-break-value-rejected {break with a value is rejected at compile time inside a returning iterable loop} -body {
    catch {surface::compile {loop x in [1, 2, 3]:
    if x == 2:
        break 99
    x} break-value-rejected.bot} message options
    list [dict get $options -errorcode] \
        [string match {*not valid inside a returning iterable loop*} $message]
} -result {{CORE SEMANTIC LISTLOOP-BREAK-VALUE} 1}

test loop-in-break-value-rejected-diagnostic {the same rejection, inspected as a kept (non-strict) diagnostic, confirming it comes from ordinary HIR resolution (hir/resolve.tcl), not a thrown error or a later type-checking pass} -body {
    set hir [loopSourceHir {loop x in [1, 2, 3]:
    if x == 2:
        break 99
    x}]
    set diags [hir::diagnostics $hir]
    list [llength $diags] [dict get [lindex $diags 0] kind]
} -result {1 LISTLOOP-BREAK-VALUE}

test loop-in-break-bare-value-declared-result-ok {a valueless break stays fully compatible with any declared List[int] result: only a VALUE-carrying break is rejected, not break itself} -body {
    set hir [loopSourceHir {fn f(xs: List[int]) -> List[int]:
    loop x in xs:
        if x == 0:
            break
        x

f([1, 2])}]
    llength [hir::diagnostics $hir]
} -result 0

test loop-in-break-value-nested-still-invalid {a break targeting an outer listloop from inside a nested block is still rejected for a value payload} -body {
    set hir [loopSourceHir {loop x in [1, 2]:
    loop y in [10, 20]:
        if y == 20:
            break 1
        y}]
    set diags [hir::diagnostics $hir]
    list [llength $diags] [dict get [lindex $diags 0] kind]
} -result {1 LISTLOOP-BREAK-VALUE}

test loop-in-break-value-plain-loop-unaffected {break VALUE is still fully valid inside a plain (non-listloop) loop: only a listloop target is restricted -- countloop/loop keep their own established override semantics unchanged} -body {
    run {loop {block {} {break {const 42}}}}
} -result 42

test loop-in-break-still-precise-type {a listloop's own static type stays exactly List[R] even where a bare break is reachable: its result is still List[R] (the collected prefix), not a separate payload type} -body {
    set hir [loopSourceHir {v = loop x in [1, 2, 3]:
    if x == 2:
        break
    x + 1
v}]
    set e [lindex [dict get $hir roots] end]
    hir::types::show [hir::typeOf $hir $e]
} -result {List[int]}

test loop-in-continue-skips {continue contributes nothing for that iteration and moves on} -body {
    loopInterpValue {loop x in [1, 2, 3]:
    if x == 2:
        continue
    else:
        x
}
} -result {[1, 3]}

test loop-in-continue-parity {continue agrees on every backend} -body {
    loopParity {loop x in [1, 2, 3]:
    if x == 2:
        continue
    else:
        x
}
} -result same

test loop-in-return-propagates {return inside the body returns from the enclosing function, not merely the loop} -body {
    loopInterpValue {fn f():
    loop x in [1, 2, 3]:
        if x == 2:
            return "escaped"
        else:
            x
    "unreachable"

f()}
} -result {"escaped"}

test loop-in-return-parity {return-from-inside-loop agrees on every backend} -body {
    loopParity {fn f():
    loop x in [1, 2, 3]:
        if x == 2:
            return "escaped"
        else:
            x
    "unreachable"

f()}
} -result same

# These two tests used to construct a source-defined refined type via the
# callable Small(x) constructor syntax, now removed entirely
# (EXPLICIT-ERROR-COMPLETIONS.md): a genuinely dynamic out-of-domain value
# is now an explicit `fail`, admitted here by `check`'s own `errors`
# declaration and left unhandled at the loop's own call site, so it
# propagates out of the whole listloop -- the same "no partial result"
# property, through the new mechanism. Left unhandled at the top level too
# (compiled with -strict 0, matching tests/byte-set.test's own
# moduleErrorKinds idiom) so both tests can still observe a real runtime
# outcome: every backend agrees on CORE SEMANTIC UNCAUGHT-ERROR
# (core/completion.tcl's atProgramBoundary), not CORE SEMANTIC RANGE, the
# old callable constructor's own kind, which no longer exists.

test loop-in-error-propagates {a failing checked construction inside the body propagates the ordinary error, with no partial result} -body {
    outcomeUnder interp [hir::lower [loopSourceHir {type Small = Int in 0..10
error TooBig
fn check(n) -> Small errors TooBig:
    if n > 10:
        fail TooBig
    else:
        n
loop x in [1, 20, 2]:
    check(x)
}]]
} -result {error {CORE SEMANTIC UNCAUGHT-ERROR} {uncaught propagated error: <error TooBig>} {}}

test loop-in-error-parity {the error case agrees on every backend} -body {
    set exprs [hir::lower [loopSourceHir {type Small = Int in 0..10
error TooBig
fn check(n) -> Small errors TooBig:
    if n > 10:
        fail TooBig
    else:
        n
loop x in [1, 20, 2]:
    check(x)
}]]
    lmap backend $::parityBackends {
        set outcome [outcomeUnder $backend $exprs]
        list [lindex $outcome 0] [lindex $outcome 1]
    }
} -result {{error {CORE SEMANTIC UNCAUGHT-ERROR}} {error {CORE SEMANTIC UNCAUGHT-ERROR}} {error {CORE SEMANTIC UNCAUGHT-ERROR}} {error {CORE SEMANTIC UNCAUGHT-ERROR}}}

# ---------------------------------------------------------------------------
# Nested loops

test loop-in-nested {a nested loop x in EXPR: composes naturally (already the ordinary evaluation-order case)} -body {
    loopInterpValue {loop x in [1, 2]:
    loop y in [10, 20]:
        x + y
}
} -result {[[11, 21], [12, 22]]}

test loop-in-nested-parity {nested loops agree on every backend (interp/compile/cranelift-generic/cranelift)} -body {
    loopParity {loop x in [1, 2]:
    loop y in [10, 20]:
        x + y
}
} -result same

# ---------------------------------------------------------------------------
# Closure-per-iteration (item 33 of RETURNING-ITERABLE-LOOPS.md): the
# element binding is a fresh, immutable binding each iteration (item 10),
# so a closure created in different iterations must capture that
# iteration's own value, never one shared mutable slot -- calling the
# resulting functions must yield 1, 2, 3, not 3, 3, 3.

test loop-in-closure-per-iteration {closures created in different iterations of a returning loop capture that iteration's own binding value} -body {
    loopInterpValue {fs = loop x in [1, 2, 3]:
    fn f():
        x
    f
results = loop g in fs:
    g()
results}
} -result {[1, 2, 3]}

test loop-in-closure-per-iteration-parity {closure-per-iteration agrees on every backend} -body {
    loopParity {fs = loop x in [1, 2, 3]:
    fn f():
        x
    f
results = loop g in fs:
    g()
results}
} -result same

# ---------------------------------------------------------------------------
# break/continue lexical-boundary rules are unchanged (shared with the
# pre-existing bare `loop:`, pinned in loops.test): a `loop x in ...:` is an
# ordinary loop scope for this purpose, verified directly here too (raw
# core IR, matching loops.test's own boundary-test style).

test loop-in-break-outside-callable-boundary {break cannot cross an ordinary callable boundary from inside a loop x in ...: body} -body {
    core::eval {listloop {const list {1}} {block {x} {call {block {} {break}}}}}
} -returnCodes error -errorCode {CORE SEMANTIC BREAK-OUTSIDE-LOOP} -result {break outside lexical loop}

test loop-in-continue-outside-callable-boundary {continue cannot cross an ordinary callable boundary from inside a loop x in ...: body} -body {
    core::eval {listloop {const list {1}} {block {x} {call {block {} {continue}}}}}
} -returnCodes error -errorCode {CORE SEMANTIC CONTINUE-OUTSIDE-LOOP} -result {continue outside lexical loop}

test loop-in-continue-outside-loop {continue outside any loop is still rejected} -body {
    core::eval {continue}
} -returnCodes error -errorCode {CORE SEMANTIC CONTINUE-OUTSIDE-LOOP} -match glob -result *

# ---------------------------------------------------------------------------
# Adversarial soundness, redone for RETURNING-ITERABLE-LOOPS.md's redefined
# break semantics: since a listloop now has exactly one stable result type
# (List[R], for both normal exhaustion and a bare break's collected prefix),
# the dangerous case the original design audited -- an incompatible break
# payload type reaching a declared List[int] result at runtime -- cannot
# arise at all: `break VALUE` is rejected outright at compile time
# (hir/resolve.tcl's LISTLOOP-BREAK-VALUE, exercised above), never merely
# widened to `any` or left for a later declared-result check to catch.

test loop-in-no-break-still-precise {a listloop with no break at all keeps its precise List[R] typing (byte::set's own no-break shape)} -body {
    set hir [loopSourceHir {v = loop x in [1, 2, 3]:
    x + 1
v}]
    set e [lindex [dict get $hir roots] end]
    hir::types::show [hir::typeOf $hir $e]
} -result {List[int]}

cleanupTests
