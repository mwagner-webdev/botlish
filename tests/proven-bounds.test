# proven-bounds.test -- PROOF-FACT-CENSUS.md gap G1: the bounds proofs
# hir/completions.tcl already makes are consumed by code generation.
#
#   PROVEN SAFE   -> check-free operation (NIR `*proven`, no `regioncheck`,
#                    the Tcl compiler's direct call instead of callValue)
#   UNKNOWN       -> the checked operation, declared error and all
#   PROVEN FAILURE-> compile-time KNOWN-ERROR (unchanged)
#
# Pinned here: the per-check verdict structure (one element per registered
# bounds check, so two checks raising the same error name are never
# conflated), what lowering does with it on every operation, that a handler
# or an `errors` clause is never mistaken for a proof, region lowering,
# Tcl-compiler parity, and that every backend computes the same values.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]

interp recursionlimit {} 100000

set boundsBackends {interp compile cranelift-generic cranelift}

proc boundsHir {source} {
    set path [makeFile [withImports $source] proven-bounds-case.bot]
    try {
        return [surface::readProgramFile $path -strict 0]
    } finally {
        removeFile proven-bounds-case.bot
    }
}

proc boundsNir {source args} {
    return [native::nir [boundsHir $source] {*}$args]
}

# How many times NIR TEXT has `op NAME` (the whole opcode word).
proc opCount {text name} {
    return [llength [regexp -all -inline "op $name\[ \n\]" $text]]
}

# {checked proven} counts of the opcode pair NAME / NAMEproven.
proc pairCounts {text name} {
    return [list [opCount $text $name] [opCount $text ${name}proven]]
}

# The first call node of the PROGRAM (not of a library module it imports: an
# import loads the module, whose own calls would otherwise come first) whose
# callee is spelled NAME.
proc nativeCall {hir name} {
    set files [dict get $hir files]
    foreach e [hir::walk $hir] {
        set origin [dict get [hir::node $hir $e] origin]
        if {[dict exists $origin file] && [string match "[file normalize $::core::libraryDir]/*" [file normalize [dict get $files [dict get $origin file] path]]]} {
            continue
        }
        if {[hir::kind $hir $e] eq "call"} {
            set callee [hir::get $hir $e callee]
            if {[hir::kind $hir $callee] eq "ref" && [hir::get $hir $callee name] eq $name} {
                return $e
            }
        }
    }
    error "no call of $name"
}

# The per-check verdicts and BoundsProven of the first call of NAME.
proc verdictOf {source name} {
    set hir [boundsHir $source]
    set e [nativeCall $hir $name]
    return [list [hir::completions::BoundsVerdictsOf $hir $e] [hir::completions::BoundsProven $hir $e]]
}

proc agreedValue {source} {
    set hir [boundsHir $source]
    set outcomes [lmap b $::boundsBackends {lrange [outcomeUnderHir $b $hir] 0 end-1}]
    if {[llength [lsort -unique $outcomes]] != 1} {
        return "DISAGREE: [join [lmap b $::boundsBackends o $outcomes {list $b $o}] { / }]"
    }
    return [lindex [lindex $outcomes 0] 1]
}

set unknownList "fn f(xs, i) errors IndexNotFound:\n    std::list::at(xs, i)\nf(\[1, 2\], 1)"

# ---------------------------------------------------------------------------
# The verdict structure

test bounds-verdict-index {an indexed access has one check: proven when the index provably designates an element, else it keeps IndexNotFound} -body {
    list \
        [verdictOf "xs = \[1, 2, 3\]\nloop i from 0 to 3:\n    std::list::at(xs, i)" std::list::at] \
        [verdictOf $unknownList std::list::at] \
        [verdictOf "a = std::mutable_array::allocate(3)\nstd::mutable_array::set(a, 2, 0)" std::mutable_array::set] \
        [verdictOf "fn f(a, i) errors IndexNotFound:\n    std::mutable_array::at(a, i)\nf(std::mutable_array::allocate(1), 0)" std::mutable_array::at]
} -result [list {{{}} 1} {IndexNotFound 0} {{{}} 1} {IndexNotFound 0}]

test bounds-verdict-slice {a slice has two bound checks, each ruled out on its own: the verdict names what each may still raise (the second case proves LowerUnderrun away with `n >= 0` and keeps UpperOverrun)} -body {
    list \
        [verdictOf "s = \"abcd\"\nstd::str::substring(s, 1, 3)" std::str::substring] \
        [verdictOf "fn f(s, n) errors LowerUnderrun, UpperOverrun:\n    if n >= 0:\n        std::str::substring(s, 0, n)\n    else:\n        \"\"\nf(\"ab\", 1)" std::str::substring] \
        [verdictOf "fn f(s, i) errors LowerUnderrun, UpperOverrun:\n    if i >= 0 and i < std::str::length(s):\n        std::str::substring(s, i, i + 1)\n    else:\n        \"\"\nf(\"ab\", 1)" std::str::substring] \
        [verdictOf "fn f(s, i, j) errors LowerUnderrun, UpperOverrun:\n    if i >= 0:\n        std::str::substring(s, i, j)\n    else:\n        \"\"\nf(\"ab\", 1, 2)" std::str::substring]
} -result [list {{{}} 1} {UpperOverrun 0} {{{}} 1} {{{LowerUnderrun UpperOverrun}} 0}]

test bounds-verdict-two-slices-not-conflated {std::mutable_array::copy checks a destination and a source slice that raise the same declared errors: the verdict keeps them apart, and only a call with both proven is proven} -body {
    set decl "fn f(%s) errors LowerUnderrun, UpperOverrun:\n    %s\n    std::mutable_array::copy(dst, 0, src, 0, 2)\nf(%s)"
    set dstOk "dst = std::mutable_array::allocate(4)"
    set srcOk "src = std::mutable_array::allocate(4)"
    list \
        [verdictOf [format $decl src $dstOk {std::mutable_array::allocate(1)}] std::mutable_array::copy] \
        [verdictOf [format $decl dst $srcOk {std::mutable_array::allocate(1)}] std::mutable_array::copy] \
        [verdictOf [format $decl k "$dstOk\n    $srcOk" 0] std::mutable_array::copy] \
        [verdictOf [format $decl "dst, src" "" {std::mutable_array::allocate(1), std::mutable_array::allocate(1)}] std::mutable_array::copy]
} -result [list {{{} UpperOverrun} 0} {{UpperOverrun {}} 0} {{{} {}} 1} {{UpperOverrun UpperOverrun} 0}]

test bounds-verdict-per-element-union {a literal-List loop walks its body once per element: a check is proven only if every walk proved it, in either order (a later element never overwrites an earlier unproven one)} -body {
    set ctx [hir::completions::NewCtx]
    hir::completions::NoteBounds ctx e1 {{}}
    hir::completions::NoteBounds ctx e1 {IndexNotFound}
    hir::completions::NoteBounds ctx e1 {{}}
    hir::completions::NoteBounds ctx e2 {IndexNotFound}
    hir::completions::NoteBounds ctx e2 {{}}
    hir::completions::NoteBounds ctx e3 {{} {UpperOverrun}}
    hir::completions::NoteBounds ctx e3 {{LowerUnderrun} {}}
    hir::completions::NoteBounds ctx e4 {{}}
    hir::completions::NoteBounds ctx e4 {{}}
    dict get $ctx bounds
} -result {e1 IndexNotFound e2 IndexNotFound e3 {LowerUnderrun UpperOverrun} e4 {{}}}

test bounds-verdict-literal-loop-walks {a call inside a literal-List loop is proven only if it is for every element; a body that fails for one element is checked} -body {
    set body "    std::list::at(\[10, 20\], x)"
    list \
        [verdictOf "loop x in \[0, 1\]:\n$body" std::list::at] \
        [verdictOf "loop x in \[1, 0\]:\n$body" std::list::at] \
        [verdictOf "loop x in \[0, 1, 2\]:\n    r = std::list::at(\[10, 20\], x):\n        on IndexNotFound:\n            0\n    r" std::list::at] \
        [verdictOf "loop x in \[2, 1\]:\n    r = std::list::at(\[10, 20\], x):\n        on IndexNotFound:\n            0\n    r" std::list::at]
} -result [list {{{}} 1} {{{}} 1} {IndexNotFound 0} {IndexNotFound 0}]

test bounds-verdict-stamped-on-native-call-not-handle {the verdict is on the native call node, whatever handles it: a handler's presence is not the proof (a handled unknown call is unproven, a handled proven call proven)} -body {
    list \
        [verdictOf "fn f(xs, i):\n    std::list::at(xs, i):\n        on IndexNotFound:\n            0\nf(\[1\], 0)" std::list::at] \
        [verdictOf "xs = \[1, 2, 3\]\nloop i from 0 to 3:\n    std::list::at(xs, i):\n        on IndexNotFound:\n            0" std::list::at]
} -result [list {IndexNotFound 0} {{{}} 1}]

test bounds-verdict-unreached-call-unproven {a call the proof never reaches carries no verdict: no verdict is never read as proven} -body {
    set hir [boundsHir "fn f(xs):\n    if 1 > 2:\n        std::list::at(xs, 0)\n    else:\n        0\nf(\[1\])"]
    set e [nativeCall $hir std::list::at]
    list [hir::completions::BoundsVerdictsOf $hir $e] [hir::completions::BoundsProven $hir $e]
} -result {{} 0}

# ---------------------------------------------------------------------------
# Reduced indices (hir::completions::ReducedIndex): mod by the container's
# own size, bit_and with its size minus one

# The first diagnostic kind of a strict compilation of SOURCE ("" when it
# compiles).
proc strictKind {source} {
    set path [makeFile [withImports $source] proven-bounds-strict.bot]
    try {
        surface::readProgramFile $path -warnings off
        return ""
    } on error {message options} {
        set first [lindex [dict get $options -diagnostics] 0]
        return [lindex [dict get $first errorcode] end]
    } finally {
        removeFile proven-bounds-strict.bot
    }
}

test bounds-reduced-mod-index {an index reduced mod the container's own size designates an element (mod returns only for a nonzero divisor, and then 0 <= r < |d|): every indexed access, every way of writing it (inline, method syntax, through local bindings of the size and of the index), a parameter or a local container} -body {
    list \
        [verdictOf "fn f(a: MutableArray\[int\], h: int) -> int:\n    std::mutable_array::at(a, mod(h, std::mutable_array::capacity(a)))\nf(std::mutable_array::create(3, 0), -7)" std::mutable_array::at] \
        [verdictOf "fn f(a: MutableArray\[int\], h: int):\n    c = std::mutable_array::capacity(a)\n    i = h.mod(c)\n    std::mutable_array::set(a, i, h)\nf(std::mutable_array::create(3, 0), -7)" std::mutable_array::set] \
        [verdictOf "fn f(xs: List\[int\], k) -> int:\n    std::list::at(xs, hash(k).mod(std::list::length(xs)))\nf(\[1, 2, 3\], \"k\")" std::list::at] \
        [verdictOf "fn f(s: str, h: int):\n    std::str::char_at(s, mod(h + 1, std::str::length(s)))\nf(\"abc\", 5)" std::str::char_at] \
        [verdictOf "fn f(h: int) -> int:\n    a = std::mutable_array::create(5, 0)\n    std::mutable_array::at(a, mod(h, std::mutable_array::capacity(a)))\nf(9)" std::mutable_array::at]
} -result [lrepeat 5 {{{}} 1}]

test bounds-reduced-mod-rejected {mod proves nothing by a divisor that is not exactly the container's size: another container's size, the size plus one, an unrelated Int, or the size of the container a read reached through another binding} -body {
    set decl "fn f(a: MutableArray\[int\], b: MutableArray\[int\], h: int, n: int) -> int errors IndexNotFound:\n    %s\nf(std::mutable_array::create(2, 0), std::mutable_array::create(3, 0), 5, 4)"
    list \
        [verdictOf [format $decl "std::mutable_array::at(a, mod(h, std::mutable_array::capacity(b)))"] std::mutable_array::at] \
        [verdictOf [format $decl "std::mutable_array::at(a, mod(h, std::mutable_array::capacity(a) + 1))"] std::mutable_array::at] \
        [verdictOf [format $decl "std::mutable_array::at(a, mod(h, n))"] std::mutable_array::at] \
        [verdictOf [format $decl "i = mod(h, std::mutable_array::capacity(b))\n    std::mutable_array::at(a, i)"] std::mutable_array::at]
} -result [lrepeat 4 {IndexNotFound 0}]

test bounds-reduced-mask-index {bit_and(x, m), in either operand order, is in 0..m for m >= 0 whatever x is, so it designates an element when m + 1 is the container's own size and m >= 0 is proven: by a guard on the size (== 0, <= 0 on a local binding, < 1), a known size, a nonnegative form, or m's own Range; no power of two is needed} -body {
    set decl "fn f(a: MutableArray\[int\], b: MutableArray\[int\], h: int, m: int) -> int:\n    %s\nf(std::mutable_array::create(3, 0), std::mutable_array::create(6, 0), -5, 4)"
    list \
        [verdictOf [format $decl "if std::mutable_array::capacity(a) == 0:\n        return 0\n    std::mutable_array::at(a, bit_and(h, std::mutable_array::capacity(a) - 1))"] std::mutable_array::at] \
        [verdictOf [format $decl "cap = std::mutable_array::capacity(a)\n    if cap <= 0:\n        return 0\n    std::mutable_array::at(a, bit_and(cap - 1, h))"] std::mutable_array::at] \
        [verdictOf [format $decl "if std::mutable_array::capacity(a) < 1:\n        return 0\n    std::mutable_array::at(a, bit_and(std::mutable_array::capacity(a) - 1, h))"] std::mutable_array::at] \
        [verdictOf [format $decl "c = std::mutable_array::create(6, 0)\n    std::mutable_array::at(c, bit_and(h, std::mutable_array::capacity(c) - 1))"] std::mutable_array::at] \
        [verdictOf [format $decl "c = std::mutable_array::create(std::mutable_array::capacity(b) + 1, 0)\n    std::mutable_array::at(c, bit_and(h, std::mutable_array::capacity(b)))"] std::mutable_array::at] \
        [verdictOf [format $decl "if m < 0:\n        return 0\n    c = std::mutable_array::create(m + 1, 0)\n    std::mutable_array::at(c, bit_and(h, m))"] std::mutable_array::at]
} -result [lrepeat 6 {{{}} 1}]

test bounds-reduced-mask-rejected {a mask proves nothing without m >= 0 (an empty container's mask is -1, and x & -1 = x), with the size itself as the mask, or with another container's size} -body {
    set decl "fn f(a: MutableArray\[int\], b: MutableArray\[int\], h: int) -> int errors IndexNotFound:\n    %s\nf(std::mutable_array::create(3, 0), std::mutable_array::create(6, 0), -5)"
    list \
        [verdictOf [format $decl "std::mutable_array::at(a, bit_and(h, std::mutable_array::capacity(a) - 1))"] std::mutable_array::at] \
        [verdictOf [format $decl "if std::mutable_array::capacity(a) == 0:\n        return 0\n    std::mutable_array::at(a, bit_and(h, std::mutable_array::capacity(a)))"] std::mutable_array::at] \
        [verdictOf [format $decl "if std::mutable_array::capacity(b) == 0:\n        return 0\n    std::mutable_array::at(a, bit_and(h, std::mutable_array::capacity(b) - 1))"] std::mutable_array::at]
} -result [lrepeat 3 {IndexNotFound 0}]

test bounds-reduced-empty-container-stays-known-error {a container of known size 0 has no element: a read of it whose index is reduced by that size is never reached (mod fails with ARITHMETIC first), and stays KNOWN-ERROR as before rather than becoming vacuously proven} -body {
    list \
        [verdictOf "fn f(h: int) -> int:\n    a = std::mutable_array::allocate(0)\n    std::mutable_array::at(a, mod(h, std::mutable_array::capacity(a)))\nf(3)" std::mutable_array::at] \
        [strictKind "fn f(h: int):\n    a = std::mutable_array::allocate(0)\n    std::mutable_array::at(a, mod(h, std::mutable_array::capacity(a)))\n0"] \
        [strictKind "fn f(h: int) -> int:\n    xs = \[\]\n    std::list::at(xs, h.mod(std::list::length(xs)))\n0"]
} -result {{IndexNotFound 0} KNOWN-ERROR KNOWN-ERROR}

test bounds-reduced-contradicted-size {a size a guard proved at least 1 that the call-specific walk knows to be 0 (an exact empty List argument) is a contradiction, like two disagreeing known sizes: the masked read is unreachable there, so the call has no effective errors; without the guard the same call may fail} -body {
    proc callErrors {source} {
        set hir [boundsHir $source]
        return [hir::completions::effectiveErrorsOf $hir [nativeCall $hir f]]
    }
    set body "    std::list::at(xs, bit_and(std::list::length(xs) - 1, h))\nf(\[\], -1)"
    list \
        [callErrors "fn f(xs: List\[int\], h: int):\n    if std::list::length(xs) < 1:\n        return -1\n$body"] \
        [callErrors "fn f(xs: List\[int\], h: int):\n    if std::list::length(xs) == 0:\n        return -1\n$body"] \
        [callErrors "fn f(xs: List\[int\], h: int) errors IndexNotFound:\n$body"]
} -result {{} {} IndexNotFound}

# ---------------------------------------------------------------------------
# Field paths (hir::cardinality::ValueKey): `t.slots` written twice is one
# value, so its size proves an access through the path

set fieldStructs "struct T:\n    s: MutableArray\[int\]\n    r: MutableArray\[int\]\nstruct Outer:\n    inner: T\nstruct Board:\n    cells: List\[int\]\n    name: str\n"

test bounds-field-path-index {a guard, a counted loop or a reduction on the size of a field path proves an access through the same path written again: a parameter's field, a nested path, a struct bound to a construction, a List and a String field, and a slice of a String field} -body {
    set decl "${fieldStructs}fn f(t: T, o: Outer, b: Board, a: MutableArray\[int\], i: int, h: int):\n    %s\nf(T {s: std::mutable_array::create(2, 0), r: std::mutable_array::create(3, 0)}, Outer {inner: T {s: std::mutable_array::create(2, 0), r: std::mutable_array::create(3, 0)}}, Board {cells: \[1\], name: \"ab\"}, std::mutable_array::create(1, 0), 1, 5)"
    list \
        [verdictOf [format $decl "if i < 0 or i >= std::mutable_array::capacity(t.s):\n        return 0\n    std::mutable_array::at(t.s, i)"] std::mutable_array::at] \
        [verdictOf [format $decl "loop k from 0 to std::list::length(b.cells):\n        std::list::at(b.cells, k)"] std::list::at] \
        [verdictOf [format $decl "std::mutable_array::at(o.inner.s, mod(h, std::mutable_array::capacity(o.inner.s)))"] std::mutable_array::at] \
        [verdictOf [format $decl "u = T {s: a, r: a}\n    std::mutable_array::at(u.s, mod(h, std::mutable_array::capacity(u.s)))"] std::mutable_array::at] \
        [verdictOf [format $decl "std::str::char_at(b.name, h.mod(std::str::length(b.name)))"] std::str::char_at] \
        [verdictOf [format $decl "if i < 0 or i > std::str::length(b.name):\n        return \"\"\n    std::str::substring(b.name, i, std::str::length(b.name))"] std::str::substring]
} -result [lrepeat 6 {{{}} 1}]

test bounds-field-path-write {a write through a field place, t.s.set(i, v), is proven by a guard or a reduction on the same path's capacity, or on a local copy of the field (a copy has the field's capacity): the in-place write has no local-alias form} -body {
    set decl "${fieldStructs}fn f(t: T, i: int, h: int) -> T:\n    %s\n    t\nf(T {s: std::mutable_array::create(2, 0), r: std::mutable_array::create(3, 0)}, 1, 5)"
    list \
        [verdictOf [format $decl "if i < 0 or i >= std::mutable_array::capacity(t.s):\n        return t\n    t.s.set(i, 7)"] std::mutable_array::set] \
        [verdictOf [format $decl "s = t.s\n    if i < 0 or i >= std::mutable_array::capacity(s):\n        return t\n    t.s.set(i, 7)"] std::mutable_array::set] \
        [verdictOf [format $decl "t.s.set(h.mod(t.s.capacity()), 7)"] std::mutable_array::set]
} -result [lrepeat 3 {{{}} 1}]

test bounds-field-path-rejected {a field path's size proves nothing about another field, the same field of another struct, or the field of a call result written twice (two calls, two values)} -body {
    set decl "${fieldStructs}fn mk(a: MutableArray\[int\]) -> T:\n    T {s: a, r: a}\nfn f(t: T, u: T, a: MutableArray\[int\], i: int, h: int) -> int errors IndexNotFound:\n    %s\nf(T {s: std::mutable_array::create(2, 0), r: std::mutable_array::create(3, 0)}, T {s: std::mutable_array::create(2, 0), r: std::mutable_array::create(3, 0)}, std::mutable_array::create(1, 0), 1, 5)"
    list \
        [verdictOf [format $decl "if i < 0 or i >= std::mutable_array::capacity(t.r):\n        return 0\n    std::mutable_array::at(t.s, i)"] std::mutable_array::at] \
        [verdictOf [format $decl "std::mutable_array::at(t.s, mod(h, std::mutable_array::capacity(u.s)))"] std::mutable_array::at] \
        [verdictOf [format $decl "std::mutable_array::at(mk(a).s, mod(h, std::mutable_array::capacity(mk(a).s)))"] std::mutable_array::at]
} -result [lrepeat 3 {IndexNotFound 0}]

test bounds-field-path-lockstep {the lockstep cardinality proof reads the same keys: a clause over a field's List and a counted clause to that field path's length are equal; a clause one longer is provably unequal, and the diagnostic names the path} -body {
    set decl "${fieldStructs}fn f(b: Board) -> List\[int\]:\n    loop x in b.cells and k from 0 to %s:\n        x + k\n0"
    set path [makeFile [withImports [format $decl "std::list::length(b.cells) + 1"]] proven-bounds-lockstep.bot]
    try {
        catch {surface::readProgramFile $path -warnings off} message options
    } finally {
        removeFile proven-bounds-lockstep.bot
    }
    set first [lindex [dict get $options -diagnostics] 0]
    list [strictKind [format $decl "std::list::length(b.cells)"]] [lindex [dict get $first errorcode] end] \
        [string match "*clause 1 iterates length(b.cells) times but clause 2 iterates length(b.cells) + 1 times*" [dict get $first message]]
} -result {{} LOCKSTEP-UNEQUAL 1}

# ---------------------------------------------------------------------------
# A loop over a MutableVector (hir::cardinality::IterationLength): a vector's
# length changes in place while its binding, field path or context member
# stays the same, so a loop over one the program resizes (a push, pop or
# clear on its place or on a place its value was copied through, or a
# callee's push through its context parameter) has the length the vector
# had when that loop evaluated it: two loops over it with a mutation
# between them are unrelated sizes, and two with none between them -- the
# vector built with pushes, then walked twice -- one (Evaluation, Epoch).
# A vector nothing resizes keeps its key's length, like a List.

set vectorDecls "import std::mutable_vector\nstruct Box:\n    v: MutableVector\[int\]\ncontext struct Log:\n    items: MutableVector\[int\]\nfn add(x: int, context log: Log):\n    log.items.push(x)\n"
# Each body reads a List an earlier loop collected over a vector at an index
# proven only against a later loop's length (or the reverse after a pop),
# the vector changed between them: {NAME BODY H}, f(..., H, ...) reaching an
# index the earlier List does not have.
set vectorSnapshots {
    local-counted {v = std::mutable_vector::from_list([1, 2, 3])
    ys = loop x in v:
        x * 10
    v.push(4)
    zs = loop x in v:
        x
    loop k from 0 to std::list::length(zs):
        ys.at(k)} 0
    local-mod {v = std::mutable_vector::from_list([1, 2, 3])
    ys = loop x in v:
        x * 10
    v.push(4)
    v.push(5)
    v.push(6)
    zs = loop x in v:
        x
    ys.at(h.mod(std::list::length(zs)))} 4
    local-mask {v = std::mutable_vector::from_list([1, 2])
    ys = loop x in v:
        x * 10
    v.push(3)
    v.push(4)
    zs = loop x in v:
        x
    if std::list::length(zs) == 0:
        return -1
    ys.at(bit_and(h, std::list::length(zs) - 1))} 3
    local-guard {v = std::mutable_vector::from_list([1, 2])
    ys = loop x in v:
        x * 10
    v.push(3)
    zs = loop x in v:
        x
    if h >= 0 and h < std::list::length(zs):
        return ys.at(h)
    -1} 2
    local-pop {v = std::mutable_vector::from_list([1, 2, 3])
    ys = loop x in v:
        x * 10
    v.pop():
        on IndexNotFound:
            0
    zs = loop x in v:
        x
    loop k from 0 to std::list::length(ys):
        zs.at(k)} 0
    local-clear {v = std::mutable_vector::from_list([1, 2])
    ys = loop x in v:
        x
    v.clear()
    zs = loop x in v:
        x
    zs.at(h.mod(std::list::length(ys)))} 1
    parameter {ys = loop x in w:
        x * 10
    w.push(4)
    zs = loop x in w:
        x
    loop k from 0 to std::list::length(zs):
        ys.at(k)} 0
    field-path {ys = loop x in b.v:
        x * 10
    b.v.push(4)
    b.v.push(5)
    zs = loop x in b.v:
        x
    ys.at(h.mod(std::list::length(zs)))} 4
    context-callee {ys = loop x in log.items:
        x * 10
    add(7)
    add(8)
    zs = loop x in log.items:
        x
    ys.at(h.mod(std::list::length(zs)))} 3
    copy-then-copy {v = std::mutable_vector::from_list([1, 2, 3])
    c1 = v
    v.push(4)
    c2 = v
    ys = loop x in c1:
        x * 10
    zs = loop x in c2:
        x
    ys.at(h.mod(std::list::length(zs)))} 3
    through-copy {v = std::mutable_vector::from_list([1, 2, 3])
    c1 = v
    c1.push(4)
    ys = loop x in v:
        x * 10
    zs = loop x in c1:
        x
    ys.at(h.mod(std::list::length(zs)))} 3
    loop-body {v = std::mutable_vector::from_list([1, 2, 3])
    ys = loop x in v:
        x * 10
    loop i from 0 to 2:
        v.push(i)
    zs = loop x in v:
        x
    ys.at(h.mod(std::list::length(zs)))} 4
    handler {v = std::mutable_vector::from_list([1, 2, 3])
    ys = loop x in v:
        x * 10
    n = v.at(7):
        on IndexNotFound:
            v.push(4)
            0
    zs = loop x in v:
        x
    ys.at(h.mod(std::list::length(zs)))} 3
    branch {v = std::mutable_vector::from_list([1, 2, 3])
    ys = loop x in v:
        x * 10
    if h > 0:
        v.push(4)
    zs = loop x in v:
        x
    ys.at(h.mod(std::list::length(zs)))} 3
    loop-encloses-later {v = std::mutable_vector::from_list([1, 2, 3])
    ys = loop x in v:
        x * 10
    loop t from 0 to 3:
        zs = loop x in v:
            x
        v.push(t)
        ys.at(h.mod(std::list::length(zs)))} 4
    own-body {v = std::mutable_vector::from_list([1, 2, 3])
    zs = loop x in v:
        v.push(x)
        x
    ws = loop x in v:
        x
    zs.at(h.mod(std::list::length(ws)))} 4
    copies-each-pushed {v = std::mutable_vector::from_list([1, 2, 3])
    c1 = v
    c1.push(4)
    c2 = v
    c2.push(5)
    c2.push(6)
    ys = loop x in c1:
        x * 10
    zs = loop x in c2:
        x
    ys.at(h.mod(std::list::length(zs)))} 4
    context-branch-callee {ys = loop x in log.items:
        x * 10
    if h > 0:
        add(h)
    zs = loop x in log.items:
        x
    ys.at(h.mod(std::list::length(zs)))} 2
    branch-push-then-read {v = std::mutable_vector::from_list([1, 2, 3])
    ys = loop x in v:
        x * 10
    if h > 0:
        v.push(4)
        zs = loop x in v:
            x
        return ys.at(h.mod(std::list::length(zs)))
    0} 3
    condition-site {v = std::mutable_vector::from_list([1, 2, 3])
    ys = loop x in v:
        x
    if v.pop() > 0:
        zs = loop x in v:
            x * 10
        return zs.at(h.mod(std::list::length(ys)))
    0} 2
    context-transitive {fn mid(x: int) -> int:
        add(x)
        x
    ys = loop x in log.items:
        x * 10
    k = mid(h)
    zs = loop x in log.items:
        x
    ys.at(k.mod(std::list::length(zs)))} 2
    context-resume {fn worker(context l: Log) -> int:
        l.items.push(7)
        yield 0
        l.items.push(8)
        0
    fn drive(s: Coroutine{args: [], return: int}) -> int:
        s()
    coroutine {step, first} = worker()
    ys = loop x in log.items:
        x * 10
    k = drive(step)
    zs = loop x in log.items:
        x
    ys.at(h.mod(std::list::length(zs))) + k} 3
    context-resume-value {fn worker(context l: Log) -> int:
        l.items.push(7)
        yield 0
        l.items.push(8)
        0
    fn drive(s: Coroutine{args: [], return: int}) -> int:
        s()
    fn apply(g: Fn{args: [Coroutine{args: [], return: int}], return: int}, s: Coroutine{args: [], return: int}) -> int:
        g(s)
    coroutine {step, first} = worker()
    ys = loop x in log.items:
        x * 10
    k = apply(drive, step)
    zs = loop x in log.items:
        x
    ys.at(h.mod(std::list::length(zs))) + k} 3
}
# The program of one snapshot shape: f declares ERRORS ("" for none) and is
# called at H (with HANDLER, if any, as the call's handler).
proc vectorSnapshotProgram {body h errors {handler ""}} {
    set signature "fn f(b: Box, h: int, w: MutableVector\[int\], context log: Log) -> any"
    if {$errors ne ""} {
        append signature " errors $errors"
    }
    set v "std::mutable_vector::from_list(\[1, 2, 3\])"
    return "${::vectorDecls}$signature:\n    $body\n\nwith context Log {items: std::mutable_vector::from_list(\[1, 2\])}\nf(Box {v: $v}, $h, $v)$handler\n"
}

test bounds-vector-snapshots-rejected {a List collected over a MutableVector has the length that loop's evaluation saw: an index proven against a later loop over the vector (a counted loop, mod, a mask, a guard) or an earlier one after a pop or clear, a mutation between them, proves nothing about it -- a local, a parameter, a field path, a context member a callee grows (also in a branch), two copies taken around a push, a push through a copy, a push in a loop body, a handler or a branch, a push in a loop body after a later loop over the vector in it, the earlier loop's own body pushing, a push in a branch before the later loop in it, a pop in the condition of the branch the later loop is in, a context member grown by a callee's callee, or by a coroutine body a callee resumes (directly, or through a function value given the handle) -- so the read is checked and a function without `errors` is rejected} -body {
    lmap {name body h} $vectorSnapshots {
        list $name [strictKind [vectorSnapshotProgram $body $h ""]] \
            [verdictOf [vectorSnapshotProgram $body $h IndexNotFound ":\n    on IndexNotFound:\n        -424242"] std::list::at]
    }
} -result {{local-counted UNHANDLED-ERROR {IndexNotFound 0}} {local-mod UNHANDLED-ERROR {IndexNotFound 0}} {local-mask UNHANDLED-ERROR {IndexNotFound 0}} {local-guard UNHANDLED-ERROR {IndexNotFound 0}} {local-pop UNHANDLED-ERROR {IndexNotFound 0}} {local-clear UNHANDLED-ERROR {IndexNotFound 0}} {parameter UNHANDLED-ERROR {IndexNotFound 0}} {field-path UNHANDLED-ERROR {IndexNotFound 0}} {context-callee UNHANDLED-ERROR {IndexNotFound 0}} {copy-then-copy UNHANDLED-ERROR {IndexNotFound 0}} {through-copy UNHANDLED-ERROR {IndexNotFound 0}} {loop-body UNHANDLED-ERROR {IndexNotFound 0}} {handler UNHANDLED-ERROR {IndexNotFound 0}} {branch UNHANDLED-ERROR {IndexNotFound 0}} {loop-encloses-later UNHANDLED-ERROR {IndexNotFound 0}} {own-body UNHANDLED-ERROR {IndexNotFound 0}} {copies-each-pushed UNHANDLED-ERROR {IndexNotFound 0}} {context-branch-callee UNHANDLED-ERROR {IndexNotFound 0}} {branch-push-then-read UNHANDLED-ERROR {IndexNotFound 0}} {condition-site UNHANDLED-ERROR {IndexNotFound 0}} {context-transitive UNHANDLED-ERROR {IndexNotFound 0}} {context-resume UNHANDLED-ERROR {IndexNotFound 0}} {context-resume-value UNHANDLED-ERROR {IndexNotFound 0}}}

# The two shapes that resume a coroutine run natively only where the native
# backend runs coroutines; on a host without (nativeCoroutines) this test
# leaves exactly them out, as a test needing coroutines throughout carries
# the constraint, and checks the others on every backend.
set coroutineSnapshots {context-resume context-resume-value}

test bounds-vector-snapshots-fail {each snapshot shape the prover leaves checked really reads past the end of the earlier List: declared and handled, every backend fails the read with IndexNotFound and runs the handler -- the rejection is necessary, not only conservative} -body {
    lmap {name body h} $vectorSnapshots {
        if {$name in $::coroutineSnapshots && ![testConstraint nativeCoroutines]} continue
        set hir [boundsHir [vectorSnapshotProgram $body $h IndexNotFound ":\n    on IndexNotFound:\n        -424242"]]
        set nir [native::nir $hir]
        list $name [lmap b $::boundsBackends {lindex [outcomeUnderHir $b $hir] 1}] \
            [expr {[opCount $nir listget] > 0}] [opCount $nir listgetproven]
    }
} -result [lmap name {local-counted local-mod local-mask local-guard local-pop local-clear parameter field-path context-callee copy-then-copy through-copy loop-body handler branch loop-encloses-later own-body copies-each-pushed context-branch-callee branch-push-then-read condition-site context-transitive context-resume context-resume-value} {
    if {$name in $::coroutineSnapshots && ![testConstraint nativeCoroutines]} continue
    list $name {-424242 -424242 -424242 -424242} 1 0
}]

test bounds-vector-snapshots-lockstep {a lockstep clause over a MutableVector and a List an earlier loop collected over it, the vector grown in between, are not proven equal (a local or a field path): LOCKSTEP-UNPROVEN, the diagnostic naming each loop's evaluation of the vector by where it is written} -body {
    set out {}
    foreach {v setup} {v "v = std::mutable_vector::from_list(\[1, 2, 3\])\n    " b.v ""} {
        set source "${vectorDecls}fn f(b: Box) -> List\[int\]:\n    ${setup}ys = loop x in $v:\n        x * 10\n    $v.push(4)\n    loop a in $v and y in ys:\n        a + y\n0"
        set path [makeFile [withImports $source] proven-bounds-vector-lockstep.bot]
        try {
            catch {surface::readProgramFile $path -warnings off} message options
        } finally {
            removeFile proven-bounds-vector-lockstep.bot
        }
        set first [lindex [dict get $options -diagnostics] 0]
        lappend out [lindex [dict get $first errorcode] end] [regexp -inline {could not prove [^(]*\([^)]*\) == [^(]*\([^)]*\)} [dict get $first message]]
    }
    set out
} -result {LOCKSTEP-UNPROVEN {{could not prove length(v at 13:15) == length(v at 10:20)}} LOCKSTEP-UNPROVEN {{could not prove length(b.v at 12:15) == length(b.v at 9:20)}}}

test bounds-vector-same-place-lockstep {a lockstep loop evaluates its domains once, in written order, before its first iteration: two clauses over the same vector place (a local, a field path), with no mutation before or between them in the loop's statement, walk the same vector and are proven equal (and agree on every backend); a copy of the vector (w = v, then v pushed) is another place and stays unproven} -body {
    set same "${vectorDecls}fn f(b: Box) -> List\[List\[int\]\]:\n    v = std::mutable_vector::from_list(\[1, 2, 3\])\n    v.push(4)\n    p = loop a in v and c in v:\n        a + c\n    q = loop a in b.v and c in b.v:\n        a * c\n    \[p, q\]\nf(Box {v: std::mutable_vector::from_list(\[5, 6\])})"
    set copy "${vectorDecls}fn f() -> List\[int\]:\n    v = std::mutable_vector::from_list(\[1, 2, 3\])\n    w = v\n    v.push(4)\n    loop a in v and c in w:\n        a + c\n0"
    list [strictKind $same] [agreedValue $same] [strictKind $copy]
} -result {{} {[[2, 4, 6, 8], [25, 36]]} LOCKSTEP-UNPROVEN}

test bounds-fixed-length-snapshots-proven {a List and a MutableArray keep their keyed lengths: two loops over one List or one MutableArray (a parameter, a field path), the array written in place between them, have one length, so a reduction or a counted loop by the later one proves a read of the earlier, and a lockstep over a field's array and a List collected over it is accepted; so does an iterable of no collection type (an untyped parameter), which a loop requires to be a List} -body {
    set decl "struct T:\n    s: MutableArray\[int\]\nfn f(xs: List\[int\], a: MutableArray\[int\], t: T, h: int) -> any:\n    %s\nf(\[1, 2, 3\], std::mutable_array::create(3, 0), T {s: std::mutable_array::create(3, 0)}, 7)"
    list \
        [verdictOf [format $decl "ys = loop x in xs:\n        x * 10\n    zs = loop x in xs:\n        x\n    ys.at(h.mod(std::list::length(zs)))"] std::list::at] \
        [verdictOf [format $decl "ys = loop x in a:\n        x * 10\n    a.set(h.mod(a.capacity()), 9)\n    zs = loop x in a:\n        x\n    ys.at(h.mod(std::list::length(zs)))"] std::list::at] \
        [verdictOf [format $decl "ys = loop x in t.s:\n        x * 10\n    t.s.set(h.mod(t.s.capacity()), 9)\n    zs = loop x in t.s:\n        x\n    loop k from 0 to std::list::length(zs):\n        ys.at(k)"] std::list::at] \
        [strictKind [format $decl "ys = loop x in t.s:\n        x * 10\n    t.s.set(h.mod(t.s.capacity()), 9)\n    loop x in t.s and y in ys:\n        x + y"]] \
        [strictKind "fn g(zs, h: int):\n    ys = loop x in zs:\n        x * 10\n    r = loop a in zs and y in ys:\n        a + y\n    ys.at(h.mod(std::list::length(r)))\ng(\[1, 2\], 3)"]
} -result [list {{{}} 1} {{{}} 1} {{{}} 1} {} {}]

# A vector nothing in the program mutates (vectorDecls' only mutation is the
# context member's, in add): {NAME BODY H}, f(..., H, ...).
set vectorUnmutated {
    local-counted {v = std::mutable_vector::from_list([1, 2, 3])
    ys = loop x in v:
        x * 10
    zs = loop x in v:
        x
    loop k from 0 to std::list::length(zs):
        ys.at(k)} 0
    parameter-mod {ys = loop x in w:
        x * 10
    zs = loop x in w:
        x
    ys.at(h.mod(std::list::length(zs)))} 4
    field-guard {ys = loop x in b.v:
        x * 10
    zs = loop x in b.v:
        x
    if h >= 0 and h < std::list::length(zs):
        return ys.at(h)
    -1} 2
    copy-mask {v = std::mutable_vector::from_list([1, 2, 3])
    c1 = v
    ys = loop x in v:
        x * 10
    zs = loop x in c1:
        x
    if std::list::length(zs) == 0:
        return -1
    ys.at(bit_and(h, std::list::length(zs) - 1))} 7
    lockstep-collected {v = std::mutable_vector::from_list([1, 2, 3])
    ys = loop x in v:
        x * 10
    loop a in v and y in ys:
        a + y} 0
    lockstep-field {ys = loop x in b.v:
        x * 10
    loop a in b.v and y in ys:
        a + y} 0
    lockstep-copy {v = std::mutable_vector::from_list([1, 2, 3])
    c1 = v
    loop a in v and c in c1:
        a + c} 0
}

test bounds-vector-unmutated-proven {a MutableVector the program never mutates keeps its key's length, like a List: two loops over a local, a parameter, a field path or a copy of the vector have one length, so a counted loop, a reduction, a guard or a mask by the later one proves a read of the earlier -- accepted without `errors`, the read proven, every backend agreeing -- and a lockstep over the vector and a List collected over it (a local, a field path) or over the vector and a copy is accepted} -body {
    lmap {name body h} $vectorUnmutated {
        set program [vectorSnapshotProgram $body $h ""]
        set proven [expr {[string match lockstep-* $name] ? "-" : [lindex [verdictOf $program std::list::at] 1]}]
        list $name [strictKind $program] $proven [agreedValue $program]
    }
} -result {{local-counted {} 1 {[10, 20, 30]}} {parameter-mod {} 1 20} {field-guard {} 1 30} {copy-mask {} 1 30} {lockstep-collected {} - {[11, 22, 33]}} {lockstep-field {} - {[11, 22, 33]}} {lockstep-copy {} - {[2, 4, 6]}}}

