        a + y} 0
}

test bounds-vector-quiet-runs-proven {two loops over one vector place with nothing between them that can mutate it have one length, whatever mutates it before or after them: the vector built by pushes in a loop, then walked twice; pushed before both loops or after both; both loops in one iteration of a loop that pushes after them; the later loop's own body pushing (its domain is evaluated first); a parameter, a field path, a context member no call between the loops can grow; a copy pushed between the loops (another place), also when the vector itself is pushed before both, or with the later loop in a nested function; the later loop in a branch or a handler before the body's own push (the body runs at most once, entered with nothing that can mutate the vector before it), or in the branch the other branch of which pushes (written before it or after it); a swap between the loops (registered -keeps-length: it replaces an element); a copy of a copy read while a third copy is pushed; a local copy of a context member a callee grows; a context member around a call of a function that cannot reach the installed context (it requires no context, or gets the context as an ordinary argument, a copy); a place nothing resizes read once in a nested function (a copy of a vector pushed before it, a local copy of a context member) -- a counted loop, a reduction, a guard or a mask by the later one proves a read of the earlier, accepted without `errors`, the read proven, every backend agreeing -- and a lockstep over the vector and a List collected over it after pushes, or with the lockstep's own body pushing, or around a swap, over a vector and a copy while a third copy is pushed, or over a local copy of a context member around a callee's push to the member, is accepted} -body {
    lmap {name body h} $vectorQuiet {
        set program [vectorSnapshotProgram $body $h ""]
        set proven [expr {[string match lockstep-* $name] ? "-" : [lindex [verdictOf $program std::list::at] 1]}]
        list $name [strictKind $program] $proven [agreedValue $program]
    }
} -result {{built-then-walked {} 1 {[0, 3, 12, 27, 48]}} {pushed-before {} 1 40} {pushed-after {} 1 20} {one-iteration {} 1 {[20, 10, 10]}} {own-body-after {} 1 20} {parameter-guard {} 1 40} {field-mask {} 1 40} {context-no-call {} 1 70} {copy-pushed {} 1 20} {copy-pushed-mutated {} 1 30} {nested-copy-pushed {} 1 30} {branch-read-then-push {} 1 24} {else-pushes {} 1 20} {then-pushes {} 1 20} {handler-read-then-push {} 1 24} {swap-between {} 1 21} {third-copy-pushed {} 1 24} {context-local-copy {} 1 20} {context-free-call {} 1 10} {context-value-argument {} 1 3220} {copy-of-pushed-nested {} 1 20} {context-copy-nested {} 1 20} {lockstep-built {} - {[11, 22, 33, 44]}} {lockstep-own-body {} - {[11, 22, 33]}} {lockstep-swap {} - {[18, 23, 34]}} {lockstep-third-copy {} - {[15, 26, 37]}} {lockstep-context-copy {} - {[11, 22]}}}

# A mutating operation called through a function value would grow a vector
# no size form sees grow (and alias the copies hir::mutvec never wrote out
# for it): {NAME BODY}, each rejected where the operation is taken as a
# value -- bound, passed or stored -- before any bounds proof is relied on.
# (The baseline accepted the counted-loop form and read past the List's
# end natively.)
set vectorOperationValues {
    local-counted {v = std::mutable_vector::from_list([1, 2, 3])
    ys = loop x in v:
        x * 10
    p = std::mutable_vector::push
    p(v, 4)
    zs = loop x in v:
        x
    loop k from 0 to std::list::length(zs):
        ys.at(k)}
    local-mod {v = std::mutable_vector::from_list([1, 2, 3])
    ys = loop x in v:
        x * 10
    p = std::mutable_vector::push
    p(v, 4)
    p(v, 5)
    zs = loop x in v:
        x
    ys.at(h.mod(std::list::length(zs)))}
    field-counted {ys = loop x in b.v:
        x * 10
    p = std::mutable_vector::push
    p(b.v, 4)
    zs = loop x in b.v:
        x
    loop k from 0 to std::list::length(zs):
        ys.at(k)}
    clear-argument {v = std::mutable_vector::from_list([1, 2])
    ys = loop x in v:
        x
    once(std::mutable_vector::clear, v)
    zs = loop x in v:
        x
    zs.at(h.mod(std::list::length(ys)))}
    lockstep {ys = loop x in b.v:
        x * 10
    p = std::mutable_vector::push
    p(b.v, 4)
    loop a in b.v and y in ys:
        a + y}
    capacity {v = std::mutable_vector::from_list([1, 2, 3])
    ys = loop x in v:
        x
    a = std::mutable_array::from_list(ys)
    g = Grow {grow: std::mutable_vector::push}
    g.grow(v, 4)
    zs = loop x in v:
        x
    c = std::mutable_array::from_list(zs)
    a.at(h.mod(c.capacity()))}
}

test bounds-vector-operation-value {a vector grown through a mutating operation taken as a value -- bound to a name, passed to a function, stored in a field -- is rejected at the operation (MUTABLE-PLACE-RECEIVER), so no proof made from two loops around the hidden push (a mod, a counted loop, a lockstep, two arrays' capacities) is ever relied on} -body {
    set extra "fn once(g: Fn{args: \[MutableVector\[int\]\], return: unit}, w: MutableVector\[int\]):\n    g(w)\nstruct Grow:\n    grow: Fn{args: \[MutableVector\[int\], int\], return: unit}\n"
    set decls [string map [list "import std::mutable_vector\n" "import std::mutable_vector\nimport std::mutable_array\n"] $::vectorDecls]$extra
    lmap {name body} $vectorOperationValues {
        list $name [strictKind [string map [list $::vectorDecls $decls] [vectorSnapshotProgram $body 4 ""]]]
    }
} -result {{local-counted MUTABLE-PLACE-RECEIVER} {local-mod MUTABLE-PLACE-RECEIVER} {field-counted MUTABLE-PLACE-RECEIVER} {clear-argument MUTABLE-PLACE-RECEIVER} {lockstep MUTABLE-PLACE-RECEIVER} {capacity MUTABLE-PLACE-RECEIVER}}

test bounds-vector-mutated-operand {a lockstep loop's domains run in written order before its body: a domain over a vector evaluated before a mutation in another domain's operands has the length the vector had before it (proven equal to a List collected over it earlier), one evaluated after it has its own length (LOCKSTEP-UNPROVEN, which the counts differing at run time confirm)} -body {
    set decl "${vectorDecls}fn f() -> List\[int\] errors IndexNotFound:\n    v = std::mutable_vector::from_list(\[1, 2, 3\])\n    ys = loop x in v:\n        x * 10\n    %s\n    r\nr = f():\n    on IndexNotFound:\n        \[\]\nr\n"
    set before [format $decl "r = loop a in ys and c in v and k from 0 to std::list::length(ys) + v.pop() * 0:\n        a + c"]
    set after [format $decl "r = loop a in ys and k from 0 to std::list::length(ys) + v.pop() * 0 and c in v:\n        a + c"]
    set counts [format $decl "n = std::list::length(ys) + v.pop() * 0\n    r = \[n, std::mutable_vector::length(v)\]"]
    list [strictKind $before] [agreedValue $before] [strictKind $after] [agreedValue $counts]
} -result {{} {[11, 22, 33]} LOCKSTEP-UNPROVEN {[3, 2]}}

test bounds-vector-context-yield {a yield of a coroutine body is a mutation of the context members it reads: the resumer runs before the body goes on, and may grow one through its own context parameter -- two loops over a member around a yield are unrelated (rejected without `errors`; declared and handled, every backend fails the read), and around a yield over a local vector they are one length} -constraints nativeCoroutines -body {
    set decl "${vectorDecls}fn body(h: int, context log: Log) -> int%s:\n    ys = loop x in log.items:\n        x * 10\n    yield 0\n    zs = loop x in log.items:\n        x\n    ys.at(h.mod(std::list::length(zs)))\nfn f(context log: Log) -> int%s:\n    coroutine {step, first} = body(3)\n    add(7)\n    add(8)\n    step()\nwith context Log {items: std::mutable_vector::from_list(\[1, 2\])}\nf()%s\n"
    set local "${vectorDecls}fn body(h: int) -> int:\n    v = std::mutable_vector::from_list(\[1, 2, 3\])\n    v.push(4)\n    ys = loop x in v:\n        x * 10\n    yield 0\n    zs = loop x in v:\n        x\n    ys.at(h.mod(std::list::length(zs)))\nfn f() -> int:\n    coroutine {step, first} = body(5)\n    step()\nf()\n"
    set handled [format $decl " errors IndexNotFound" " errors IndexNotFound" ":\n    on IndexNotFound:\n        -424242"]
    list [strictKind [format $decl "" "" ""]] [verdictOf $handled std::list::at] [agreedValue $handled] \
        [strictKind $local] [lindex [verdictOf $local std::list::at] 1] [agreedValue $local]
} -result {UNHANDLED-ERROR {IndexNotFound 0} -424242 {} 1 20}

test bounds-vector-static-block {a static compile block that binds names is compiled as a branch that always runs (hir/static.tcl): a loop over the vector in it before its own push continues the run before the block, so the block is accepted and its read proven, and a rejected one's lockstep diagnostic records the two evaluations its message locates as related origins (std::compiler::CompilerError's related, in the message's order)} -body {
    set accepted "import std::compiler\n${vectorDecls}fn g(h: int) -> int errors std::compiler::CompilerError:\n    v = std::mutable_vector::from_list(\[1, 2, 3\])\n    v.push(4)\n    ys = loop x in v:\n        x * 10\n    static compile:\n        zs = loop x in v:\n            x\n        r = ys.at(h.mod(std::list::length(zs)))\n        v.push(6)\n        r\nr = g(5):\n    on std::compiler::CompilerError {code, primary, message}:\n        -1\nr\n"
    set rejected "import std::compiler\n${vectorDecls}fn g() -> int errors std::compiler::CompilerError:\n    v = std::mutable_vector::from_list(\[1, 2, 3\])\n    static compile:\n        ys = loop x in v:\n            x * 10\n        v.push(4)\n        loop a in v and y in ys:\n            a + y\n        0\nr = g():\n    on std::compiler::CompilerError details:\n        loop at in details.related:\n            \[at.line, at.column\]\nr\n"
    list [agreedValue $accepted] [agreedValue $rejected]
} -result {20 {[[15, 19], [12, 24]]}}

# ---------------------------------------------------------------------------
# Guards on computed locals (hir::completions::RelationKey): a relation on a
# local bound to a computed value is keyed by its one defining expression

test bounds-guarded-local-index {a guard on a local bound to a computed index proves the access through it, or through an alias of it, in either guard form: an offset, a call result, a product; the guard's lower half may be the local's own Range} -body {
    set decl "fn g(n: int) -> int:\n    n - 1\nfn f(a: MutableArray\[int\], xs: List\[int\], s: str, i: int, h: int):\n    %s\nf(std::mutable_array::create(3, 0), \[1, 2\], \"abc\", 1, 5)"
    list \
        [verdictOf [format $decl "j = i + 1\n    if j < 0 or j >= std::mutable_array::capacity(a):\n        return 0\n    std::mutable_array::at(a, j)"] std::mutable_array::at] \
        [verdictOf [format $decl "t = g(i)\n    if t >= 0 and t < std::list::length(xs):\n        std::list::at(xs, t)\n    else:\n        0"] std::list::at] \
        [verdictOf [format $decl "j = i + 1\n    if j < 0 or j >= std::mutable_array::capacity(a):\n        return 0\n    k = j\n    std::mutable_array::set(a, k, 1)"] std::mutable_array::set] \
        [verdictOf [format $decl "j = h.mod(7)\n    if j >= std::mutable_array::capacity(a):\n        return 0\n    std::mutable_array::at(a, j)"] std::mutable_array::at] \
        [verdictOf [format $decl "j = i * 2\n    if j < 0 or j >= std::str::length(s):\n        return 0\n    std::str::char_at(s, j)"] std::str::char_at]
} -result [lrepeat 5 {{{}} 1}]

test bounds-guarded-local-rejected {a guard on a computed local proves nothing with only its upper half when the local may be negative, against another container's size, written inline (each written `i + 1` is its own expression), or once its scope ended (a guard on a nonnegative local in a loop body that may run zero times, the read after the loop)} -body {
    set decl "fn f(a: MutableArray\[int\], b: MutableArray\[int\], i: int) -> int errors IndexNotFound:\n    %s\nf(std::mutable_array::create(3, 0), std::mutable_array::create(5, 0), 1)"
    list \
        [verdictOf [format $decl "j = i + 1\n    if j >= std::mutable_array::capacity(a):\n        return 0\n    std::mutable_array::at(a, j)"] std::mutable_array::at] \
        [verdictOf [format $decl "j = i + 1\n    if j < 0 or j >= std::mutable_array::capacity(b):\n        return 0\n    std::mutable_array::at(a, j)"] std::mutable_array::at] \
        [verdictOf [format $decl "if i + 1 < 0 or i + 1 >= std::mutable_array::capacity(a):\n        return 0\n    std::mutable_array::at(a, i + 1)"] std::mutable_array::at] \
        [verdictOf [format $decl "j = mod(i, 1000)\n    loop k from 0 to i - 500:\n        if j >= std::mutable_array::capacity(a):\n            return k\n    std::mutable_array::at(a, j)"] std::mutable_array::at]
} -result [lrepeat 4 {IndexNotFound 0}]

test bounds-declared-signature-unchanged {proving a check never changes the native's declared signature: std::list::at is still errors IndexNotFound, and the call's effective errors are the proof's} -body {
    set hir [boundsHir "xs = \[1, 2, 3\]\nstd::list::at(xs, 1)"]
    set e [nativeCall $hir std::list::at]
    list [dict get [core::native::metadata std::list::at] errors] [dict get [core::native::metadata std::list::at] bounds] \
        [hir::completions::effectiveErrorsOf $hir $e]
} -result {IndexNotFound {index list 0 1} {}}

# ---------------------------------------------------------------------------
# Native lowering

test bounds-nir-index-ops {proven std::list::at / std::mutable_array::at / ::set lower to the check-free opcodes, unproven ones keep the checked opcode} -body {
    set text [boundsNir "xs = \[1, 2, 3\]\na = std::mutable_array::allocate(3)\nloop i from 0 to 3:\n    std::mutable_array::set(a, i, std::list::at(xs, i))\nloop j from 0 to 3:\n    std::mutable_array::at(a, j)"]
    set unknown [boundsNir "fn f(xs, a, i) errors IndexNotFound:\n    std::mutable_array::set(a, i, std::list::at(xs, i))\n    std::mutable_array::at(a, i)\nf(\[1\], std::mutable_array::allocate(1), 0)"]
    list [pairCounts $text listget] [pairCounts $text mutarrayget] [pairCounts $text mutarrayset] \
        [pairCounts $unknown listget] [pairCounts $unknown mutarrayget] [pairCounts $unknown mutarrayset]
} -result {{0 1} {0 1} {0 1} {1 0} {1 0} {1 0}}

test bounds-nir-reduced-index {a read or write whose index is reduced mod, or masked by, the container's own size lowers to the check-free opcode; reduced by another size (another array's, the length plus one) or masked without a proven m >= 0 it keeps the checked one} -body {
    set proven [boundsNir "fn f(a: MutableArray\[int\], xs: List\[int\], h: int) -> int:\n    i = h.mod(std::mutable_array::capacity(a))\n    std::mutable_array::set(a, i, h)\n    if std::mutable_array::capacity(a) == 0:\n        return 0\n    std::mutable_array::at(a, bit_and(h, std::mutable_array::capacity(a) - 1)) + std::list::at(xs, h.mod(std::list::length(xs)))\nf(std::mutable_array::create(3, 0), \[1, 2\], 7)"]
    set unknown [boundsNir "fn f(a: MutableArray\[int\], b: MutableArray\[int\], xs: List\[int\], h: int) -> int errors IndexNotFound:\n    i = h.mod(std::mutable_array::capacity(b))\n    std::mutable_array::set(a, i, h)\n    std::mutable_array::at(a, bit_and(h, std::mutable_array::capacity(a) - 1)) + std::list::at(xs, h.mod(std::list::length(xs) + 1))\nf(std::mutable_array::create(3, 0), std::mutable_array::create(3, 0), \[1, 2\], 7)"]
    list [pairCounts $proven mutarrayset] [pairCounts $proven mutarrayget] [pairCounts $proven listget] \
        [pairCounts $unknown mutarrayset] [pairCounts $unknown mutarrayget] [pairCounts $unknown listget]
} -result {{0 1} {0 1} {0 1} {1 0} {1 0} {1 0}}

test bounds-nir-field-path-write {a write through a field place reduced by the field path's own capacity lowers to mutarraysetproven, in place (no logical copy of the field: no mvshare), and the read through the path to mutarraygetproven; reduced by another field's capacity both stay checked} -body {
    set source "struct T:\n    s: MutableArray\[int\]\n    r: MutableArray\[int\]\nfn store(t: T, h: int) -> T%s:\n    t.s.set(h.mod(std::mutable_array::capacity(t.%s)), h)\n    t\nfn read(t: T, h: int) -> int%s:\n    std::mutable_array::at(t.s, h.mod(std::mutable_array::capacity(t.%s)))\nread(store(T {s: std::mutable_array::create(3, 0), r: std::mutable_array::create(4, 0)}, 5), 5)"
    set proven [boundsNir [format $source "" s "" s]]
    set unknown [boundsNir [format $source " errors IndexNotFound" r " errors IndexNotFound" r]]
    list [pairCounts $proven mutarrayset] [pairCounts $proven mutarrayget] [opCount $proven mvshare] \
        [pairCounts $unknown mutarrayset] [pairCounts $unknown mutarrayget]
} -result {{0 1} {0 1} 0 {1 0} {1 0}}

test bounds-nir-guarded-local {a read and a write at a computed local guarded against the container's size lower to the check-free opcodes; guarded on one side only they keep the checked ones} -body {
    set source "fn f(a: MutableArray\[int\], i: int) -> int%s:\n    j = i + 1\n    if %sj >= std::mutable_array::capacity(a):\n        return 0\n    std::mutable_array::set(a, j, i)\n    std::mutable_array::at(a, j)\nf(std::mutable_array::create(3, 0), 1)"
    set proven [boundsNir [format $source "" "j < 0 or "]]
    set unknown [boundsNir [format $source " errors IndexNotFound" ""]]
    list [pairCounts $proven mutarrayset] [pairCounts $proven mutarrayget] \
        [pairCounts $unknown mutarrayset] [pairCounts $unknown mutarrayget]
} -result {{0 1} {0 1} {1 0} {1 0}}

test bounds-nir-slice-ops {proven substring / freeze / copy lower to the check-free opcodes, unproven ones keep the checked opcode} -body {
    set text [boundsNir "s = \"abcd\"\na = std::mutable_array::allocate(3)\nb = std::mutable_array::allocate(5)\nstd::mutable_array::copy(a, 0, b, 2, 3)\n\[std::str::substring(s, 1, 3), std::mutable_array::freeze(a, 3)\]"]
    set unknown [boundsNir "fn f(s, a, b, n) errors LowerUnderrun, UpperOverrun:\n    std::mutable_array::copy(a, 0, b, 0, n)\n    \[std::str::substring(s, 0, n), std::mutable_array::freeze(a, n)\]\nf(\"abc\", std::mutable_array::allocate(3), std::mutable_array::allocate(3), 2)"]
    list [pairCounts $text substr] [pairCounts $text mutarrayfreeze] [pairCounts $text mutarraycopy] \
        [pairCounts $unknown substr] [pairCounts $unknown mutarrayfreeze] [pairCounts $unknown mutarraycopy]
} -result {{0 1} {0 1} {0 1} {1 0} {1 0} {1 0}}

test bounds-nir-substring-one-check-proven-stays-checked {a substring with LowerUnderrun ruled out (n >= 0) but UpperOverrun unproven keeps the checked operation} -body {
    set text [boundsNir "fn f(s, n) errors UpperOverrun:\n    if n >= 0:\n        std::str::substring(s, 0, n)\n    else:\n        \"\"\nf(\"abc\", 2)"]
    pairCounts $text substr
} -result {1 0}

test bounds-nir-copy-one-slice-proven-stays-checked {a copy with the destination slice proven and the source unknown (or the reverse) keeps the whole checked operation: per-check proof state is never turned into an error-name guess} -body {
    set decl "fn f(%s) errors LowerUnderrun, UpperOverrun:\n    %s\n    std::mutable_array::copy(dst, 0, src, 0, 2)\nf(%s)"
    list \
        [pairCounts [boundsNir [format $decl src "dst = std::mutable_array::allocate(4)" {std::mutable_array::allocate(1)}]] mutarraycopy] \
        [pairCounts [boundsNir [format $decl dst "src = std::mutable_array::allocate(4)" {std::mutable_array::allocate(1)}]] mutarraycopy] \
        [pairCounts [boundsNir [format $decl k "dst = std::mutable_array::allocate(4)\n    src = std::mutable_array::allocate(4)" 0]] mutarraycopy]
} -result {{1 0} {1 0} {0 1}}

test bounds-nir-handler-is-not-the-proof {a handler (or an errors clause) never makes a check unnecessary: an unknown handled call stays checked; a proven call with a handler is proven}  -body {
    set handledUnknown [boundsNir "fn f(xs, i):\n    std::list::at(xs, i):\n        on IndexNotFound:\n            -1\nf(\[1, 2\], 5)"]
    set handledProven [boundsNir "xs = \[1, 2, 3\]\nloop i from 0 to 3:\n    std::list::at(xs, i):\n        on IndexNotFound:\n            -1"]
    set declared [boundsNir "fn f(xs, i) errors IndexNotFound:\n    std::list::at(xs, i)\nf(\[1, 2\], 5):\n    on IndexNotFound:\n        -1"]
    list [pairCounts $handledUnknown listget] [pairCounts $handledProven listget] [pairCounts $declared listget]
} -result {{1 0} {0 1} {1 0}}

test bounds-nir-opt-off {-proven-bounds-opt 0 lowers every call checked, exactly as before the optimization} -body {
    set source "xs = \[1, 2, 3\]\nloop i from 0 to 3:\n    std::list::at(xs, i)"
    list [pairCounts [boundsNir $source -proven-bounds-opt 0] listget] [pairCounts [boundsNir $source] listget]
} -result {{1 0} {0 1}}

test bounds-nir-region-check-omitted {a String region (a substring consumed only by ==) validated by a proof needs no regioncheck; the unproven region keeps it} -body {
    set proven "fn is_a(s, i):\n    if i >= 0 and i < std::str::length(s):\n        std::str::substring(s, i, i + 1) == \"a\"\n    else:\n        false\nis_a(\"abc\", 0)"
    set unknown "fn is_a(s, i) errors LowerUnderrun, UpperOverrun:\n    std::str::substring(s, i, i + 1) == \"a\"\nis_a(\"abc\", 0)"
    list [opCount [boundsNir $proven] regioncheck] [opCount [boundsNir $unknown] regioncheck] \
        [opCount [boundsNir $proven -proven-bounds-opt 0] regioncheck] \
        [pairCounts [boundsNir $proven] substr]
} -result {0 1 1 {0 0}}

test bounds-nir-short-slice-region-check-omitted {the same for the ShortString slice form: the proven one has no regioncheck in front of strsliceshort} -body {
    set proven "fn first(s, i):\n    if i >= 0 and i < std::str::length(s):\n        c = std::str::substring(s, i, i + 1)\n        if c == \"a\":\n            1\n        else:\n            0\n    else:\n        0\nfirst(\"abc\", 0)"
    set text [boundsNir $proven]
    set off [boundsNir $proven -proven-bounds-opt 0]
    list [opCount $text regioncheck] [expr {[opCount $off regioncheck] >= 1}]
} -result {0 1}

test bounds-nir-refined-checks-benchmark {bench/refined-checks.bot (stdlib/web.bot's char_at): the census's redundant regioncheck and the proven substrings/reads are gone, at least the hot path's checks are check-free} -body {
    set hir [surface::readProgramFile [file join $::projectRoot bench refined-checks.bot] -strict 0]
    set text [native::nir $hir]
    list [opCount $text regioncheck] [opCount $text substr] [expr {[opCount $text listgetproven] > 0}] \
        [expr {[opCount [native::nir $hir -proven-bounds-opt 0] regioncheck] > 0}]
} -result {0 0 1 1}

test bounds-nir-get-is-ordinary-botlish {std::list::get is not special: it is Botlish over `at` with its own handler, its inner `at` is unproven (the index parameter is unconstrained in its own body), so it keeps the checked read -- a recorded frontier, not a special case} -body {
    set text [boundsNir "xs = \[1, 2, 3\]\nloop i from 0 to 3:\n    std::list::get(xs, i, 0)"]
    list [expr {[opCount $text listget] >= 1}] [opCount $text listgetproven]
} -result {1 0}

test bounds-nir-function-stops-being-fallible {a function whose only fallible operation is a proven read no longer may error, so its callers drop their completion checks (the check-free opcode is outside op_may_error); with the optimization off it still may} -body {
    set source "fn pick(xs, k):\n    if k >= 0 and k < std::list::length(xs):\n        std::list::at(xs, k) + 1\n    else:\n        0\npick(\[10, 20, 30\], 1) + pick(\[1\], 5)"
    proc mayError {source args} {
        set nir [native::nir [boundsHir $source] {*}$args -tiny-leaf-inline-opt 0]
        lmap line [native::Driver calls $nir] {
            if {![regexp {callee_name="pick" may_error=(\w+)} $line -> v]} continue
            set v
        }
    }
    list [mayError $source] [mayError $source -proven-bounds-opt 0]
} -result {{false false} {true true}}

test bounds-clif-no-bounds-path {the proven read is the bare element load: its CLIF has no bounds comparison and fewer branches, the checked read has both} -body {
    set source "xs = \[1, 2, 3\]\nloop i from 0 to 3:\n    std::list::at(xs, i)"
    set proven [native::clif [boundsHir $source]]
    set off [native::clif [boundsHir $source] -proven-bounds-opt 0]
    list [regexp -all {icmp ult} $proven] [expr {[regexp -all {icmp ult} $off] > 0}] \
        [expr {[regexp -all {brif} $proven] < [regexp -all {brif} $off]}]
} -result {0 1 1}

# ---------------------------------------------------------------------------
# The Tcl compiler

test bounds-compiler-direct-call {a proven bounds-bearing native is a direct call in the Tcl compiler's code, not core::runtime::callValue; a handled or declared unknown one still goes through callValue} -body {
    proc codeOf {source} {
        return [dict get [core::compiler::compileHir [boundsHir $source]] code]
    }
    set proven [codeOf "xs = \[1, 2, 3\]\nloop i from 0 to 3:\n    std::list::at(xs, i)"]
    set handled [codeOf "fn f(xs, i):\n    std::list::at(xs, i):\n        on IndexNotFound:\n            -1\nf(\[1, 2\], 5)"]
    set declared [codeOf $unknownList]
    # `import std::list` loads stdlib/list.bot, whose own handled `at` is a callValue
    # in every program that imports it: the baseline the proven call must not add to.
    set baseline [regexp -all {callValue} [codeOf "import std::list\n1"]]
    list [expr {[regexp -all {callValue} $proven] - $baseline}] [expr {[regexp -all {callValue} $handled] > $baseline}] [expr {[regexp -all {callValue} $declared] > $baseline}]
} -result {0 1 1}

# ---------------------------------------------------------------------------
# Runtime outcomes are identical on every backend

test bounds-values-agree-proven {programs whose every bounds check is proven compute the same values on every backend} -body {
    list \
        [agreedValue "xs = \[10, 20, 30\]\nloop i from 0 to 3:\n    std::list::at(xs, i) + 1"] \
        [agreedValue "a = std::mutable_array::allocate(4)\nloop i from 0 to 4:\n    std::mutable_array::set(a, i, i * i)\nloop j down from 3 through 0:\n    std::mutable_array::at(a, j)"] \
        [agreedValue "s = \"héllo\"\nloop i from 0 to 5:\n    std::str::substring(s, i, i + 1)"] \
        [agreedValue "a = std::mutable_array::from_list(\[1, 2, 3\])\nb = std::mutable_array::allocate(5)\nstd::mutable_array::copy(b, 1, a, 0, 3)\nstd::mutable_array::freeze(b, 5)"] \
        [agreedValue "fn is_a(s, i):\n    if i >= 0 and i < std::str::length(s):\n        std::str::substring(s, i, i + 1) == \"a\"\n    else:\n        false\n\[is_a(\"abc\", 0), is_a(\"abc\", 1), is_a(\"abc\", 9), is_a(\"\", 0)\]"]
} -result [list {[11, 21, 31]} {[9, 4, 1, 0]} {["h", "é", "l", "l", "o"]} {[unit, 1, 2, 3, unit]} {[true, false, false, false]}]

test bounds-values-agree-unknown {an unknown site still fails when its check fails, handled or not, on every backend} -body {
    list \
        [agreedValue "fn g(xs, i):\n    std::list::at(xs, i):\n        on IndexNotFound:\n            -1\n\[g(\[1, 2\], 1), g(\[1, 2\], 2), g(\[1, 2\], -1), g(\[\], 0)\]"] \
        [agreedValue "fn s(t, a, b):\n    std::str::substring(t, a, b):\n        on LowerUnderrun:\n            \"lo\"\n        on UpperOverrun:\n            \"hi\"\n\[s(\"abc\", 0, 2), s(\"abc\", -1, 2), s(\"abc\", 2, 1), s(\"abc\", 1, 9)\]"] \
        [agreedValue "fn st(a, i):\n    std::mutable_array::set(a, i, 1):\n        on IndexNotFound:\n            2\nb = std::mutable_array::allocate(2)\n\[st(b, 0), st(b, 2), st(b, -1)\]"] \
        [agreedValue "fn c(a, b, i, n):\n    std::mutable_array::copy(a, i, b, 0, n):\n        on LowerUnderrun:\n            \"lo\"\n        on UpperOverrun:\n            \"hi\"\nx = std::mutable_array::allocate(3)\ny = std::mutable_array::allocate(2)\n\[c(x, y, 0, 2), c(x, y, 0, 3), c(x, y, 2, 2), c(x, y, -1, 1)\]"]
} -result [list {[2, -1, -1, -1]} {["ab", "lo", "lo", "hi"]} {[unit, 2, 2]} {[unit, "hi", "hi", "lo"]}]

test bounds-values-agree-reduced {indices reduced mod or masked by the container's own size compute the same values on every backend, for negative indices, indices beyond a machine word, a capacity that is no power of two and an empty array} -body {
    set reads "fn pick(a: MutableArray\[int\], h: int) -> int:\n    std::mutable_array::at(a, mod(h, std::mutable_array::capacity(a)))\nfn masked(a: MutableArray\[int\], h: int) -> int:\n    if std::mutable_array::capacity(a) == 0:\n        return -1\n    std::mutable_array::at(a, bit_and(h, std::mutable_array::capacity(a) - 1))\nfn item(xs: List\[int\], h: int) -> int:\n    std::list::at(xs, h.mod(std::list::length(xs)))\nhs = \[0, 7, -1, -8, 4611686018427387904, -1180591620717411303424\]\na = std::mutable_array::from_list(\[10, 20, 30, 40, 50\])\n"
    list \
        [agreedValue "${reads}loop h in hs:\n    pick(a, h)"] \
        [agreedValue "${reads}loop h in hs:\n    masked(a, h)"] \
        [agreedValue "${reads}e = std::mutable_array::create(0, 0)\nloop h in hs:\n    masked(e, h)"] \
        [agreedValue "${reads}loop h in hs:\n    item(\[1, 2, 3\], h)"] \
        [agreedValue "fn put(a: MutableArray\[int\], h: int) -> MutableArray\[int\]:\n    a.set(h.mod(a.capacity()), h)\n    a\nb = std::mutable_array::create(3, 0)\nc = put(put(put(b, -1), 4), 9)\nloop i from 0 to std::mutable_array::capacity(c):\n    std::mutable_array::at(c, i)"]
} -result {{[10, 30, 50, 30, 50, 20]} {[10, 50, 50, 10, 10, 10]} {[-1, -1, -1, -1, -1, -1]} {[1, 2, 3, 2, 2, 3]} {[9, 4, -1]}}

test bounds-values-agree-field-path {accesses through field paths proven by the same path's size compute the same values on every backend: in-place writes reduced mod the field's capacity, guarded reads of every index around it, a reduced List read and a lockstep loop over a field} -body {
    set table "struct Table:\n    slots: MutableArray\[int\]\n    names: List\[str\]\nfn store(t: Table, h: int) -> Table:\n    t.slots.set(h.mod(std::mutable_array::capacity(t.slots)), h)\n    t\nfn read(t: Table, i: int) -> int:\n    if i < 0 or i >= std::mutable_array::capacity(t.slots):\n        return -1\n    std::mutable_array::at(t.slots, i)\nfn name(t: Table, h: int) -> str:\n    std::list::at(t.names, h.mod(std::list::length(t.names)))\nfn widths(t: Table) -> List\[int\]:\n    loop x in t.names and k from 0 to std::list::length(t.names):\n        std::str::length(x) + k\nt = store(store(store(Table {slots: std::mutable_array::create(5, 0), names: \[\"a\", \"bb\", \"ccc\"\]}, -3), 11), 1180591620717411303424)\n"
    list \
        [agreedValue "${table}loop i from -1 to 6:\n    read(t, i)"] \
        [agreedValue "${table}loop h in \[0, -1, 4, 1180591620717411303424\]:\n    name(t, h)"] \
        [agreedValue "${table}widths(t)"]
} -result {{[-1, 0, 11, -3, 0, 1180591620717411303424, -1]} {["a", "ccc", "bb", "bb"]} {[1, 3, 5]}}

test bounds-values-agree-guarded-local {reads and writes at computed locals proven by a guard compute the same values on every backend, for indices in range, just outside it on both sides and far outside it} -body {
    set fns "fn after(xs: List\[int\], i: int) -> int:\n    t = i + 1\n    if t < 0 or t >= std::list::length(xs):\n        return -1\n    std::list::at(xs, t)\nfn bump(a: MutableArray\[int\], i: int) -> MutableArray\[int\]:\n    j = i * 2\n    if j >= 0 and j < std::mutable_array::capacity(a):\n        std::mutable_array::set(a, j, std::mutable_array::at(a, j) + 1)\n    a\n"
    list \
        [agreedValue "${fns}loop i in \[-3, -2, -1, 0, 1, 2, 3, 1180591620717411303424\]:\n    after(\[10, 20, 30\], i)"] \
        [agreedValue "${fns}b = bump(bump(bump(bump(std::mutable_array::create(5, 0), 0), 2), 1), -1)\nloop k from 0 to std::mutable_array::capacity(b):\n    std::mutable_array::at(b, k)"]
} -result {{[-1, -1, 10, 20, 30, -1, -1, -1]} {[1, 0, 1, 0, 1]}}

test bounds-values-agree-known-error-checked {a certain failure (KNOWN-ERROR, accepted only without -strict) is never proven: it stays a checked operation and still fails identically everywhere} -body {
    list \
        [verdictOf "loop x in \[0, 5\]:\n    std::list::at(\[1, 2\], x):\n        on IndexNotFound:\n            7" std::list::at] \
        [agreedValue "loop x in \[0, 5\]:\n    std::list::at(\[1, 2\], x):\n        on IndexNotFound:\n            7"] \
        [agreedValue "std::list::at(\[1, 2\], 5):\n    on IndexNotFound:\n        7"]
} -result {{IndexNotFound 0} {[1, 7]} 7}

cleanupTests
