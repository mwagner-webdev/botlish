# show.bot -- the Raven scenarios' shared module (tests/raven.test): events
# and flags as text, so a scenario's value is a List of Strings the test
# compares.
import raven
import std::float64
import std::int
import std::list
import std::str

fn kind_name(kind: raven::EventKind) -> str:
    if kind == raven::EventKind::Clicked:
        return "Clicked"
    if kind == raven::EventKind::Toggled:
        return "Toggled"
    if kind == raven::EventKind::ValueChanged:
        return "ValueChanged"
    if kind == raven::EventKind::TextChanged:
        return "TextChanged"
    if kind == raven::EventKind::TextCommitted:
        return "TextCommitted"
    if kind == raven::EventKind::Selected:
        return "Selected"
    if kind == raven::EventKind::Action:
        return "Action"
    if kind == raven::EventKind::CloseRequested:
        return "CloseRequested"
    if kind == raven::EventKind::Resized:
        return "Resized"
    if kind == raven::EventKind::TimerElapsed:
        return "TimerElapsed"
    if kind == raven::EventKind::KeyPressed:
        return "KeyPressed"
    if kind == raven::EventKind::KeyRepeated:
        return "KeyRepeated"
    if kind == raven::EventKind::KeyReleased:
        return "KeyReleased"
    if kind == raven::EventKind::MousePressed:
        return "MousePressed"
    if kind == raven::EventKind::MouseReleased:
        return "MouseReleased"
    if kind == raven::EventKind::MouseMoved:
        return "MouseMoved"
    if kind == raven::EventKind::Wheel:
        return "Wheel"
    "Error"

fn flag(value: bool) -> str:
    if value:
        return "true"
    "false"

fn int(value: int) -> str:
    std::int::to_string(value)

# Which non-finite number a NonFiniteFloat names.
fn non_finite(result: NonFiniteResult) -> str:
    if result == NonFiniteResult::NotANumber:
        return "NotANumber"
    if result == NonFiniteResult::PositiveInfinity:
        return "PositiveInfinity"
    "NegativeInfinity"

# EVENT as "KIND value extra number [text]" (number rounded); WHO names its
# source among the handles the scenario made.
fn event(e: raven::Event, who: str) -> str:
    kind_name(e.kind).append_char(' ').concat(who).append_char(' ').concat(int(e.value)).append_char(' ').concat(int(e.extra)).append_char(' ').concat(int(std::float64::round(e.number))).concat(" [").concat(e.text).append_char(']')

# A raw input EVENT as "KIND value extra x y dx dy" (numbers rounded); WHO
# names its source.
fn input(e: raven::Event, who: str) -> str:
    kind_name(e.kind).append_char(' ').concat(who).append_char(' ').concat(int(e.value)).append_char(' ').concat(int(e.extra)).append_char(' ').concat(int(std::float64::round(e.x))).append_char(' ').concat(int(std::float64::round(e.y))).append_char(' ').concat(int(std::float64::round(e.dx))).append_char(' ').concat(int(std::float64::round(e.dy)))
