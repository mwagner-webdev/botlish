# native-listloop.test -- native (Cranelift) lowering of the returning
# iterable loop (`loop x in xs:`, RETURNING-ITERABLE-LOOPS.md): the
# discarded-vs-retained result distinction (items 20-22, 28-29, 34, 53),
# and allocation/structural pins for list::any?/all?/none?/find.
#
# Structural facts are read straight from the generated NIR text
# (native::nir) and from native::allocationReport, exactly like native-
# alloc.test's own style -- not from re-deriving them via a second
# analysis.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]

proc sourceHir {text} {
    return [surface::compile $text t.bot -strict 0]
}

# ---------------------------------------------------------------------------
# Retained vs discarded: NIR text distinguishes them (item 34's own
# "structural test"). A retained listloop's own result feeds a subsequent
# expression (here, the whole program's own value); a discarded one is a
# bare statement nothing reads.

test native-listloop-retained-builds-list {a listloop whose result is used lowers with real listnew/listappend instructions} -body {
    set text [native::nir [sourceHir {loop x in [1, 2, 3]:
    x + 1}]]
    list [expr {[string first "listnew" $text] >= 0}] [expr {[string first "listappend" $text] >= 0}]
} -result {1 1}

test native-listloop-discarded-no-list {a listloop whose result is provably unused (a bare statement, not the function's last value) lowers with no listappend at all -- the one "listnew" still present is the iterable LITERAL's own single-instruction construction ([1, 2, 3] -> one variadic "op listnew %r %r %r", never listappend; Const's own list case, unrelated to the loop), not an accumulator} -body {
    set text [native::nir [sourceHir {fn f():
    loop x in [1, 2, 3]:
        x + 1
    unit

f()}]]
    string first "listappend" $text
} -result -1

test native-listloop-discarded-still-traverses {a discarded listloop still lowers real traversal (listlen/listget), only the output builder is elided} -body {
    set text [native::nir [sourceHir {fn f():
    loop x in [1, 2, 3]:
        x + 1
    unit

f()}]]
    list [expr {[string first "listlen" $text] >= 0}] [expr {[string first "listget" $text] >= 0}]
} -result {1 1}

# ---------------------------------------------------------------------------
# Allocation census: a discarded listloop causes zero List allocations from
# the loop's own returning-loop semantics -- only the already-existing
# `rt_list_append` runtime's own copy-on-append behavior (native-alloc.
# test's own "list::append copies the existing elements" pin, unrelated to
# and unchanged by this milestone) makes a *retained* listloop's own List
# construction cost O(n) allocations, not the "one logical output List"
# item 14 describes as a semantic goal: an empty accumulator (`listnew`,
# one allocation) plus one `listappend` (one allocation, copying the prior
# elements) per contributed element. For an already-materialized N-element
# List traversed by a retained listloop that contributes every element:
# 1 (the input List itself) + 1 (the empty accumulator) + N (one copying
# append per element). This is recorded here as compiler evidence (item 55:
# "do not source-optimize around it"), not fixed in this milestone.

test native-listloop-retained-allocation-shape {a retained listloop's own List construction is 1 (empty accumulator) + N (one copying append per contributed element), on top of the input List's own 1 allocation -- 5 total for 3 elements} -body {
    set report [native::allocationReport [sourceHir {xs = [1, 2, 3]
loop x in xs:
    x + 1}] summary]
    dict get $report byKind List allocations
} -result 5

test native-listloop-discarded-allocates-no-output-list {a discarded listloop over an already-materialized List allocates only the input List (1), never the accumulator or any append -- zero allocations from the loop's own returning-loop semantics} -body {
    set report [native::allocationReport [sourceHir {fn f():
    xs = [1, 2, 3]
    loop x in xs:
        x + 1
    unit

f()}] summary]
    dict get $report byKind List allocations
} -result 1

# ---------------------------------------------------------------------------
# break's native lowering (items 29-30): a bare break in a retained listloop
# still lowers through the same builder path -- no separate list allocated
# for the break case itself, only the ordinary per-contributed-element
# append cost already pinned above, for however many elements were
# collected before the break (2 of the 4: x=1, x=2; x=3 breaks before its
# own append). 1 (input) + 1 (empty accumulator) + 2 (appends) = 4.

test native-listloop-break-allocation-shape {break inside a retained listloop allocates only for the elements actually collected before the break, nothing extra for the break path itself} -body {
    set report [native::allocationReport [sourceHir {xs = [1, 2, 3, 4]
loop x in xs:
    if x == 3:
        break
    x}] summary]
    dict get $report byKind List allocations
} -result 4

test native-listloop-discarded-break-no-output-list {a discarded listloop with a reachable break still allocates zero List of its own: break's own native lowering (moving a placeholder into $resultReg) never touches listnew/listappend} -body {
    set text [native::nir [sourceHir {fn f():
    loop x in [1, 2, 3, 4]:
        if x == 3:
            break
        x
    unit

f()}]]
    string first "listappend" $text
} -result -1

# ---------------------------------------------------------------------------
# list::any?/all?/none?/find (lib/list.bot): each one's own listloop result
# is unused, so the native backend must not allocate an output List for it
# (items 39-40 of the milestone's required allocation questions).

proc listlibModuleHir {source name} {
    set path [makeFile $source $name]
    try {
        return [surface::readProgramFile $path -strict 0]
    } finally {
        removeFile $name
    }
}

set isEven {
import list
fn is_even(x):
    mod(x, 2) == 0
}

test native-listloop-any-no-output-list {list::any? allocates no output List of its own: the only List allocation is the literal argument itself} -body {
    set hir [listlibModuleHir "$isEven\nlist::any?(\[1, 3, 4\], is_even)" native-any-alloc.bot]
    set report [native::allocationReport $hir summary]
    dict get $report byKind List allocations
} -result 1

test native-listloop-all-no-output-list {list::all? allocates no output List of its own} -body {
    set hir [listlibModuleHir "$isEven\nlist::all?(\[2, 4, 6\], is_even)" native-all-alloc.bot]
    set report [native::allocationReport $hir summary]
    dict get $report byKind List allocations
} -result 1

test native-listloop-none-no-output-list {list::none? allocates no output List of its own} -body {
    set hir [listlibModuleHir "$isEven\nlist::none?(\[1, 3, 5\], is_even)" native-none-alloc.bot]
    set report [native::allocationReport $hir summary]
    dict get $report byKind List allocations
} -result 1

test native-listloop-find-no-output-list-matching {list::find allocates no output List of its own on the matching path} -body {
    set matchHir [listlibModuleHir "$isEven\nlist::find(\[5, 6, 7\], is_even)" native-find-alloc-match.bot]
    dict get [native::allocationReport $matchHir summary] byKind List allocations
} -result 1

test native-listloop-find-no-output-list-failing {list::find's listloop allocates no output List of its own on the failing (NotFound) path either -- checked structurally (no listappend anywhere in the generated program), since running this program to completion for an allocation report would just raise the very NotFound error being tested} -body {
    set failHir [listlibModuleHir "$isEven\nlist::find(\[1, 3, 5\], is_even)" native-find-alloc-fail.bot]
    string first "listappend" [native::nir $failHir]
} -result -1

cleanupTests
