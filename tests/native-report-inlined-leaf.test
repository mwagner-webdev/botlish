# native-report-inlined-leaf.test -- native::report's guard accounting
# (a lowering's representation blockers == the kind guards it emits) holds
# across tiny exact-leaf inlining (native/lower.tcl's InlineLeafCall).
#
# Inlining lowers a leaf's body into its caller, so the leaf's kind guards
# are emitted there and counted in the caller's `guards`; the leaf's
# representation blockers were counted nowhere (its own function is not even
# emitted once every call to it inlines). native::report then threw for an
# ordinary uriEscape call (today: web::uri_escape_text, lib/web.bot), "generic lowering emitted 10 kind guard(s) for 8
# blocker(s)": web.bot's high_nibble inlines byte::high_nibble and
# byte::nibble, each of whose generic instance needs one `bit_and` guard.
# Those guards are the leaves' own checks, the same ones their functions make
# when the calls are not inlined, so the NIR is unchanged; a function's
# blockers now include each inlined leaf's, once per inlined call.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]

proc sourceHir {text} {
    return [surface::compile $text t.bot -strict 0]
}

# {generic-blockers generic-guards specialized-blockers specialized-guards
# nirGuards} of native::report on HIR (it throws on a mismatch itself).
proc reportCounts {hir} {
    set r [native::report $hir]
    return [list [dict get $r generic blockers] [dict get $r generic guards] \
        [dict get $r specialized blockers] [dict get $r specialized guards] \
        [dict get $r nirGuards]]
}

# The info dict of the one function named NAME in LOWERED (native::lowered).
proc loweredFunction {lowered name} {
    set found [lmap info [dict get $lowered functions] {
        if {[dict get $info name] ne $name} continue
        set info
    }]
    if {[llength $found] != 1} {
        error "expected one function $name, found [llength $found]"
    }
    return [lindex $found 0]
}

# The guard lines of function NAME's body in NIR text NIR, without their
# @E origins.
proc guardLines {nir name} {
    set lines {}
    set inside 0
    foreach line [split $nir \n] {
        if {[string match "func *" $line]} {
            set inside [string match "func * \"$name\" *" $line]
        } elseif {$inside && [regexp {^\s+guard(bool)? } $line]} {
            lappend lines [regsub { @e\d+$} [string trim $line] ""]
        }
    }
    return $lines
}

set uriEscapeSource "import web\nweb::uri_escape_text(\"a b\")"

# The generic blocker/guard counts of every uriEscape program below grew by
# one with STDLIB-NAMESPACES.md: web.bot's esc_bytes now guards its
# list::at read with `i < 0 or i >= list::length(bytes)` (which proves the
# read, so no IndexNotFound reaches uriEscape), and the new `i < 0` is one
# more Int comparison on the untyped parameter i -- one representation
# blocker, one kind guard. Guards still equal blockers.
#
# The declared slice errors (LowerUnderrun/UpperOverrun) moved them again,
# measured per function against the tree before that change: esc_from now
# guards its str::substring with `i < 0 or i >= str::length(text)`, one more
# Int comparison on its untyped i (3 -> 4 blockers: every uriEscape program
# +1); emailish?'s char_at guards its slice with `i < 0 or i >= n`, whose
# comparison is now the one kind check of i (the slice's i and i + 1 below
# it see a proven Int), so each of its two generic instances goes 2 -> 1
# (05-refined-strings.ir and 06-refined-strings.hir, which call both
# Emailish? and uriEscape: -2 + 1). REFINEMENT-VALUES.md replaced those two
# examples, whose natives (lib/web.tcl) are gone, with
# examples/refinement/refined-strings.bot.

test native-report-inlined-leaf-1 {native::report accepts an ordinary web::uri_escape_text call, directly and through an untyped wrapper, and web::emailish?(5) (-strict 0: its declared str parameter becomes a checked guard that always fails)} -body {
    lmap text [list \
        $uriEscapeSource \
        "import web\nfn h(x):\n    web::uri_escape_text(x)\nh(\"a b\")" \
        "import web\nweb::emailish?(5)"] {
        reportCounts [sourceHir $text]
    }
} -result {{12 12 0 0 0} {12 12 0 0 0} {7 7 0 0 1}}

test native-report-inlined-leaf-2 {web.bot's high_nibble owns the two inlined bit_and guards and their two blockers} -body {
    set lowered [native::lowered [sourceHir $uriEscapeSource] -specialize 0]
    set info [loweredFunction $lowered high_nibble]
    list [dict get $info blockers] [dict get $info guards] \
        [guardLines [dict get $lowered text] high_nibble]
} -result {2 2 {{guard int %0 "bit_and"} {guard int %3 "bit_and"}}}

test native-report-inlined-leaf-3 {inlining moves guards and blockers together: the totals do not depend on it} -body {
    set hir [sourceHir $uriEscapeSource]
    lmap opt {1 0} {
        set lowered [native::lowered $hir -specialize 0 -tiny-leaf-inline-opt $opt]
        list [dict get $lowered statistics blockers] [dict get $lowered statistics guards] \
            [llength [lmap info [dict get $lowered functions] {
                if {[dict get $info name] ni {byte::high_nibble byte::nibble}} continue
                set info
            }]]
    }
} -result {{12 12 0} {12 12 2}}

test native-report-inlined-leaf-4 {a leaf of an unproven argument inlined into the program, into a generic instance under specialization, and twice on one register} -body {
    lmap text {
        "fn inc(x):\n    x + 1\n\ninc(41)"
        "import list\nfn inc(x):\n    x + 1\n\nfn twice(y):\n    inc(inc(y))\n\nfs = \[twice\]\nlist::at(fs, 0)(4)"
        "import list\nfn mix(a, b):\n    bit_and(bit_or(a, b), 255)\n\nfn h(p):\n    mix(p, p)\n\nfs = \[h\]\nlist::at(fs, 0)(7)"
    } {
        reportCounts [sourceHir $text]
    }
} -result {{1 1 0 0 0} {2 2 1 1 1} {2 2 2 2 2}}

test native-report-inlined-leaf-5 {the example and benchmark programs that escape URI text or inline a module leaf} -body {
    lmap {path loader} {
        {examples refinement refined-strings.bot} bot
        {examples surface 14-modules.bot}      bot
        {bench uri-steady.bot}                 bot
    } {
        set path [file join $::projectRoot {*}$path]
        switch -- $loader {
            ir  { set hir [hir::build [core::loadProgramFile $path] -strict 0] }
            hir { set hir [hir::readFile $path] }
            bot { set hir [surface::readProgramFile $path -warnings off] }
        }
        list [file tail $path] {*}[reportCounts $hir]
    }
} -result {{refined-strings.bot 20 20 0 0 0} {14-modules.bot 2 2 0 0 0} {uri-steady.bot 15 15 0 0 0}}

cleanupTests
