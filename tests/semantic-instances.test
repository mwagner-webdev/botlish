# semantic-instances.test -- opportunistic semantic function instances
# (OPPORTUNISTIC-SEMANTIC-INSTANCES.md, hir/semantic.tcl).
#
# An ordinary untyped function is analyzed, per exact call, under the concrete
# argument types that reach it -- with no source-level generics. This file pins
# what that must give (identity carries MutableArray[T], list helpers relate
# element and result types, recursion terminates) and, harder, what must never
# happen: an instance may not erase a bearing contract, may not rescue a body
# that is invalid for its declared contract, may not turn a real type error
# into a generic fallback, and never changes KeyType, intrinsic contracts or
# public signatures.
#
# Sections: identity/aliasing, read-only wrappers, invalid instances,
# bearing soundness, declared contracts, lists, list helpers, recursion and
# budgets, the dynamic boundary, no-generics fences, the semantic/codegen
# separation, determinism, and runtime parity.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]

interp recursionlimit {} 100000

proc siCompile {src {strict 1}} {
    set path [makeFile $src si-program.bot]
    try {
        surface::readProgramFile $path -strict $strict
    } finally {
        removeFile si-program.bot
    }
}

# "accepted" or the first line of the diagnostic.
proc siMessage {src} {
    if {![catch {siCompile $src} message]} {
        return accepted
    }
    return $message
}

proc siRejects {src pattern} {
    set message [siMessage $src]
    if {$message eq "accepted"} {
        return accepted
    }
    return [string match $pattern $message]
}

# The semantic type of the last top-level expression of SRC.
proc siLast {src} {
    set hir [siCompile $src]
    hir::types::show [hir::typeOf $hir [lindex [hir::roots $hir] end]]
}

# The used semantic instances of SRC as sorted "name<args> -> result [status]".
proc siInstances {src} {
    set hir [siCompile $src]
    lsort [lmap row [hir::semantic::census $hir] {
        format {%s<%s> -> %s [%s]} [dict get $row name] \
            [join [lmap t [dict get $row args] {hir::semantic::ShowType $hir $t}] {, }] \
            [hir::semantic::ShowType $hir [dict get $row result]] [dict get $row status]
    }]
}

proc siBlock {hir name} {
    dict for {b binding} [dict get $hir bindings] {
        if {[dict get $binding name] ne $name || [dict get $binding declaredBy] eq ""} continue
        set value [hir::get $hir [dict get $binding declaredBy] value]
        if {[hir::kind $hir $value] eq "block"} { return $value }
    }
    error "no function named $name"
}

set idDef "import std::mutable_array\nfn identity(x):\n    x\n"

# ---------------------------------------------------------------------------
# identity: the parameter/result relation falls out of ordinary body analysis

test si-id-1 {identity(int) is int, identity(str) is str, identity(List[int]) is List[int]} -body {
    list [siLast "${idDef}identity(5)"] [siLast "${idDef}identity(\"a\")"] [siLast "${idDef}identity(\[1, 2\])"]
} -result {int str {List[int]}}

test si-id-2 {identity(MutableArray[T]) preserves the exact element contract} -body {
    list [siLast "${idDef}identity(std::mutable_array::create(2, \"x\"))"] [siLast "${idDef}identity(std::mutable_array::create(2, 1))"] \
        [siLast "${idDef}identity(std::mutable_array::create(2, \[\"x\"\]))"]
} -result {{MutableArray[str]} {MutableArray[int]} {MutableArray[List[str]]}}

test si-id-3 {one source function has several semantic instances at once} -body {
    siInstances "${idDef}a = identity(std::mutable_array::create(2, \"x\"))\nb = identity(std::mutable_array::create(2, 1))\nc = identity(3)\nunit"
} -result {{identity<MutableArray[int]> -> MutableArray[int] [valid]} {identity<MutableArray[str]> -> MutableArray[str] [valid]} {identity<int> -> int [valid]}}

test si-id-4 {the result is used by later analysis: a typed store through the returned alias is checked, a wrong one rejected} -body {
    set base "${idDef}m = std::mutable_array::create(2, \"x\")\nn = identity(m)\n"
    list [siLast "${base}w = std::mutable_array::set(n, 0, \"y\"):\n    on IndexNotFound:\n        unit\nv = std::mutable_array::at(n, 0):\n    on IndexNotFound:\n        \"z\"\nv"] \
        [siRejects "${base}w = std::mutable_array::set(n, 0, 123):\n    on IndexNotFound:\n        unit\nw" "*not admissible to element type str*"]
} -result {str 1}

test si-id-5 {an immutable alias inside the instance keeps the concrete type} -body {
    siLast "import std::mutable_array\nfn forward(x):\n    y = x\n    y\nforward(std::mutable_array::create(1, \"x\"))"
} -result {MutableArray[str]}

test si-id-6 {an identical call in a chain: nested instances compose} -body {
    siLast "${idDef}fn twice(x):\n    identity(identity(x))\ntwice(std::mutable_array::create(1, \"x\"))"
} -result {MutableArray[str]}

test si-id-7 {an argument that is genuinely any stays any: no type is invented} -body {
    siLast "${idDef}fn g(y):\n    identity(y)\ng(1)"
} -result int

test si-id-8 {no semantic instance for an any-typed call; the generic contract is untouched} -body {
    set hir [siCompile "${idDef}fn g(y):\n    identity(y)\ng(1)"]
    set id [siBlock $hir identity]
    list [dict get [hir::signatures::of $hir $id] result] \
        [lmap p [dict get [hir::signatures::of $hir $id] params] {dict get $p source}]
} -result {any none}

# ---------------------------------------------------------------------------
# read-only wrappers and typed reads

test si-ro-1 {a read-only untyped wrapper accepts a typed array (no raw-mutarray rejection)} -body {
    list [siLast "import std::mutable_array\nfn capacity(x):\n    std::mutable_array::capacity(x)\ncapacity(std::mutable_array::create(3, \"x\"))"] \
        [siLast "import std::mutable_array\nfn capacity(x):\n    std::mutable_array::capacity(x)\ncapacity(std::mutable_array::allocate(3))"]
} -result {int int}

test si-ro-2 {a typed read through an untyped wrapper is the element type} -body {
    list [siLast "import std::mutable_array\nfn first(x) errors IndexNotFound:\n    std::mutable_array::at(x, 0)\nv = first(std::mutable_array::create(2, \"x\")):\n    on IndexNotFound:\n        \"z\"\nv"] \
        [siLast "import std::mutable_array\nfn first(x) errors IndexNotFound:\n    std::mutable_array::at(x, 0)\nv = first(std::mutable_array::create(2, 1)):\n    on IndexNotFound:\n        0\nv"]
} -result {str int}

test si-ro-3 {both element types at once from one source function} -body {
    siInstances "import std::mutable_array\nfn first(x) errors IndexNotFound:\n    std::mutable_array::at(x, 0)\na = first(std::mutable_array::create(2, \"x\")):\n    on IndexNotFound:\n        \"z\"\nb = first(std::mutable_array::create(2, 1)):\n    on IndexNotFound:\n        0\nunit"
} -result {{first<MutableArray[int]> -> int [valid]} {first<MutableArray[str]> -> str [valid]}}

test si-ro-4 {freeze through a wrapper keeps List[T]} -body {
    siLast "import std::mutable_array\nfn freeze(x):\n    if std::mutable_array::capacity(x) > 0:\n        return std::mutable_array::freeze(x, 1)\n    std::mutable_array::freeze(x, 0)\nfreeze(std::mutable_array::create(2, 1))"
} -result {List[int]}

# ---------------------------------------------------------------------------
# invalid instances: rejected at the call, never globally, never by fallback

test si-bad-1 {smash: an untyped writer of a wrong value into MutableArray[str] is rejected at the call} -body {
    set src "import std::mutable_array\nfn smash(x):\n    w = x\n    std::mutable_array::set(w, 0, 123)\nm = std::mutable_array::create(2, \"x\")\nsmash(m)"
    list [siRejects $src "*call to smash with x : MutableArray\\\[str\\\] is invalid: value of type int is not admissible to element type str*"] \
        [siRejects $src "*(in the body of smash, at 4:*"]
} -result {1 1}

test si-bad-2 {the same function with a raw array (or a fitting value) is fine: one bad call does not condemn the function} -body {
    list [siLast "import std::mutable_array\nfn smash(x):\n    w = x\n    if std::mutable_array::capacity(w) > 0:\n        std::mutable_array::set(w, 0, 123)\nsmash(std::mutable_array::allocate(1))"] \
        [siLast "import std::mutable_array\nfn writer(x, v):\n    w = x\n    if std::mutable_array::capacity(w) > 0:\n        std::mutable_array::set(w, 0, v)\nwriter(std::mutable_array::create(1, \"x\"), \"ok\")"]
} -result {unit unit}

test si-bad-3 {f<int> valid, f<str> invalid: the incompatible call is the one rejected} -body {
    set def "fn f(x):\n    x + 1\n"
    list [siLast "${def}f(1)"] [siRejects "${def}f(\"a\")" *] [siRejects "${def}f(1)\nf(\"a\")" *]
} -result {int 1 1}

test si-bad-4 {a valid instance does not make every call valid: writer with the wrong value is rejected} -body {
    set def "import std::mutable_array\nfn writer(x, v):\n    w = x\n    if std::mutable_array::capacity(w) > 0:\n        std::mutable_array::set(w, 0, v)\n"
    list [siRejects "${def}writer(std::mutable_array::create(1, \"x\"), 5)" "*call to writer with x : MutableArray\\\[str\\\], v : int is invalid*"] \
        [siLast "${def}writer(std::mutable_array::create(1, \"x\"), \"ok\")\nwriter(std::mutable_array::create(1, 1), 5)"]
} -result {1 unit}

test si-bad-5 {an invalid callee makes the calling instance invalid: the diagnostic names both calls} -body {
    siRejects "import std::mutable_array\nfn a(x):\n    w = x\n    std::mutable_array::set(w, 0, 1)\nfn b(x):\n    a(x)\nb(std::mutable_array::create(1, \"x\"))" \
        "*call to b with x : MutableArray\\\[str\\\] is invalid: call to a with x : MutableArray\\\[str\\\] is invalid:*"
} -result 1

test si-bad-6 {the diagnostic is at the call and shows no synthetic names} -body {
    set message [siMessage "import std::mutable_array\nfn smash(x):\n    w = x\n    std::mutable_array::set(w, 0, 123)\nm = std::mutable_array::create(2, \"x\")\nsmash(m)"]
    list [string match "*:6:1: *" $message] [string match {*\$*} $message] [string match {*Instance*} $message]
} -result {1 0 0}

test si-bad-7 {an instance of a function whose body needs a declared contract cannot rescue an invalid definition} -body {
    list [siRejects "fn f(x: int) -> str:\n    x\nf(5)" *] [siRejects "fn f(x: int) -> str:\n    x\nunit" *]
} -result {1 1}

# ---------------------------------------------------------------------------
# bearing soundness: precise entry types are not permission to erase
#
# The probe is a typed function (`typed`), whose parameter contract is what
# an erasure would lose. (A typed MutableArray was the probe until
# MUTABLE-ARRAY.md made arrays values: an erased array is a logical copy, so
# it bears only what its elements bear.)

set ::siTyped "fn typed(k: int) -> int:\n    k + 1\n"

test si-brg-1 {a declared any (or list) result erases a callable's contract} -body {
    list [siRejects "${::siTyped}fn erase(x) -> any:\n    x\nerase(typed)" "*would erase the typed parameter requirements*"] \
        [siRejects "${::siTyped}fn erase(x) -> list:\n    \[x\]\nerase(typed)" "*would erase the typed parameter requirements*"]
} -result {1 1}

test si-brg-2 {storing a typed callable into raw storage is an erasure} -body {
    siRejects "import std::mutable_array\n${::siTyped}fn erase(x):\n    raw = std::mutable_array::allocate(1)\n    std::mutable_array::set(raw, 0, x)\n    raw\nerase(typed)" \
        "*call to erase with x : typed/1 -> int is invalid: \"typed\" has typed parameter requirements that cannot be preserved*"
} -result 1

test si-brg-3 {a join with an erasing value is rejected} -body {
    siRejects "${::siTyped}fn erase(x, c):\n    if c:\n        x\n    else:\n        0\nerase(typed, true)" \
        "*cannot be preserved in an \"if\" branch*"
} -result 1

test si-brg-4 {a kind test does not recover a writable untyped alias inside the instance} -body {
    siRejects "import std::mutable_array\nfn f(x):\n    w = x\n    if mutarray?(w):\n        std::mutable_array::set(w, 0, 123)\n    else:\n        unit\nm = std::mutable_array::from_list(\[\"a\"\])\nf(m)\nstd::mutable_array::at(m, 0)" \
        "*call to f with x : MutableArray\\\[str\\\] is invalid: value of type int is not admissible*"
} -result 1

test si-brg-5 {an unknown (structural) callee of a typed callable is an erasure: no exact target, no instance} -body {
    set src "import std::list\n${::siTyped}fn erase(x, f: Fn{args: \[any\], return: any, errors: \[\]}):\n    f(x)\nfn sink(y):\n    y\nfn sink2(y):\n    unit\nfn pick(fs, i) errors IndexNotFound:\n    std::list::at(fs, i)\nf = pick(\[sink, sink2\], 1):\n    on IndexNotFound:\n        sink\nerase(typed, f)"
    siRejects $src "*\"typed\" has typed parameter requirements that cannot be preserved*"
} -result 1

test si-brg-6 {an exact callable target that keeps the contract is fine (the identity of the code is known)} -body {
    siLast "import std::mutable_array\nfn erase(x, f):\n    f(x)\nfn sink(y):\n    y\nerase(std::mutable_array::create(1, \"x\"), sink)"
} -result {MutableArray[str]}

test si-brg-7 {a typed callable in a list is still preserved element-wise; erasing that list is rejected} -body {
    list [siLast "${::siTyped}fn stash(x):\n    \[x\]\nstash(typed)"] \
        [siRejects "${::siTyped}fn stash(x) -> list:\n    \[x\]\nstash(typed)" *]
} -result {{List[block(e2)/1 -> int]} 1}

test si-brg-8 {the erasures that were rejected without instances stay rejected; a typed array is a value now (MUTABLE-ARRAY.md), so only its wrong-element write still is} -body {
    lmap src [list \
        "${::siTyped}fn f(x: any):\n    x\nf(typed)" \
        "${::siTyped}fn f() -> any:\n    typed\nf()" \
        "import std::mutable_array\nfn f(x: mutarray):\n    x\nf(std::mutable_array::create(1, \"a\"))" \
        "import std::mutable_array\nm = std::mutable_array::create(1, \"a\")\nstd::mutable_array::set(m, 0, 1)" \
    ] {siRejects $src *}
} -result {1 1 accepted 1}

test si-brg-9 {a trusted-contract callee passed to an untyped parameter: the exact callee is analyzed, the wrong argument rejected} -body {
    set src "import std::mutable_array\nfn need(m: MutableArray\[str\]):\n    std::mutable_array::capacity(m)\nfn app(f, v):\n    f(v)\n"
    list [siLast "${src}app(need, std::mutable_array::create(1, \"x\"))"] \
        [siRejects "${src}app(need, std::mutable_array::create(1, 1))" "*is invalid*"]
} -result {int 1}

# ---------------------------------------------------------------------------
# declared parameter contracts stay the definition's contract

test si-decl-1 {a declared parameter is a definition contract; a narrower argument adds precision only} -body {
    set src "type Small = Int in 0..10\nfn keep(x: Small):\n    x\nkeep(3)"
    siLast $src
} -result {int[Small]}

test si-decl-2 {a declared parameter is never narrowed away: calls that do not prove it are rejected} -body {
    siRejects "fn f(x: int):\n    x\nf(\"a\")" *
} -result 1

test si-decl-3 {an exact callable narrower than a declared Fn parameter is used precisely} -body {
    siLast "fn f(g: Fn{args: \[int\], return: int, errors: \[\]}, n: int):\n    g(n)\nfn inc(x: int):\n    x + 1\nf(inc, 4)"
} -result int

# ---------------------------------------------------------------------------
# lists

test si-list-1 {first(List[str]) is str, first(List[int]) is int, first(List[MutableArray[str]]) is MutableArray[str]} -body {
    set def "import std::list\nimport std::mutable_array\nfn first(xs) errors IndexNotFound:\n    std::list::at(xs, 0)\n"
    set read "v = first(%s):\n    on IndexNotFound:\n        %s\nv"
    list [siLast "${def}[format $read {["x", "y"]} {"z"}]"] [siLast "${def}[format $read {[1, 2]} 0]"] \
        [siLast "${def}[format $read {[std::mutable_array::create(1, "x")]} {std::mutable_array::create(1, "z")}]"]
} -result {str int {MutableArray[str]}}

test si-list-2 {one source function, several semantic instances, both used in one program} -body {
    siInstances "import std::list\nfn first(xs) errors IndexNotFound:\n    std::list::at(xs, 0)\na = first(\[\"x\", \"y\"\])\nb = first(\[1, 2\])\nunit"
} -result {{first<List[int]> -> int [valid]} {first<List[str]> -> str [valid]}}

test si-list-3 {a returning loop over a typed list gives the typed list without hard-coding copy} -body {
    list [siLast "fn copy(xs):\n    loop x in xs:\n        x\ncopy(\[\"a\"\])"] [siLast "fn copy(xs):\n    loop x in xs:\n        x\ncopy(\[1\])"]
} -result {{List[str]} {List[int]}}

test si-list-4 {a recursive accumulator recovers its element type} -body {
    set def "import std::list\nfn collect(xs, i, acc) errors IndexNotFound:\n    if i == std::list::length(xs):\n        acc\n    else:\n        collect(xs, i + 1, std::list::append(acc, std::list::at(xs, i)))\n"
    set run "v = collect(%s, 0, \[\]):\n    on IndexNotFound:\n        %s\nv"
    list [siLast "${def}[format $run {["a", "b"]} {["z"]}]"] [siLast "${def}[format $run {[1]} {[0]}]"]
} -result {{List[str]} {List[int]}}

test si-list-5 {an empty caller's instance collects nothing: its loop is List[never] whatever the body's (handled) type, so it and the List[Byte] consumer's instance it requests are valid} -body {
    siInstances "import std::abi::bytes\nimport std::byte\nfn bytes_of(values: List\[int\]) -> std::abi::bytes::Bytes:\n    bs = loop v in values:\n        b = std::byte::from_int(v):\n            on std::byte::BelowRange:\n                0\n            on std::byte::AboveRange:\n                255\n        b\n    std::abi::bytes::from_list(bs)\nx = bytes_of(\[\])\nunit"
} -result {{bytes_of<List[never]> -> std::abi::bytes::Bytes [valid]} {std::abi::bytes::from_list<List[never]> -> std::abi::bytes::Bytes [valid]}}

# ---------------------------------------------------------------------------
# higher-order helpers: std::list::find / any? / all? / none?

set isB "import std::list\nfn is_b(s):\n    s == \"b\"\n"
set big "import std::list\nfn big(n):\n    n > 5\n"
set findStr "r = std::list::find(\[\"a\", \"b\"\], is_b):\n    on std::list::NotFound:\n        \"none\"\nr"
set findInt "r = std::list::find(\[1, 9\], big):\n    on std::list::NotFound:\n        0\nr"

test si-hof-1 {std::list::find(List[str], predicate) is str without a source type variable} -body {
    siLast "${isB}${findStr}"
} -result str

test si-hof-2 {std::list::find(List[int], predicate) is int} -body {
    siLast "${big}${findInt}"
} -result int

test si-hof-3 {a typed predicate now passes through the untyped helper parameter (its full contract is seeded)} -body {
    list [siLast "import std::list\nfn is_b(s: str):\n    s == \"b\"\n${findStr}"] [siLast "import std::list\nfn big(n: int):\n    n > 5\n${findInt}"]
} -result {str int}

test si-hof-4 {List[str] with an int predicate is rejected, untyped or typed, through ordinary body analysis} -body {
    set call "r = std::list::find(\[\"a\", \"b\"\], big):\n    on std::list::NotFound:\n        \"x\"\nr"
    list [siRejects "import std::list\nfn big(n):\n    n > 5\n${call}" "*call to std::list::find with xs : List\\\[str\\\], predicate : big/1 -> bool is invalid*"] \
        [siRejects "import std::list\nfn big(n: int):\n    n > 5\n${call}" "*call to std::list::find with xs : List\\\[str\\\]*"]
} -result {1 1}

test si-hof-5 {the instance's successful result and the declared std::list::NotFound error} -body {
    set hir [siCompile "${isB}${findStr}"]
    set find [lsearch -inline -glob [lmap row [hir::semantic::census $hir] {dict get $row name}] std::list::find]
    list $find [dict get [hir::signatures::of $hir [siBlock $hir std::list::find]] errors]
} -result {std::list::find std::list::NotFound}

test si-hof-6 {any?/all?/none? type their loop element and predicate call and stay bool} -body {
    list [siLast "${isB}std::list::any?(\[\"a\", \"b\"\], is_b)"] [siLast "import std::list\nfn pos(n):\n    n > 0\nstd::list::all?(\[1, 2\], pos)"] \
        [siLast "${isB}std::list::none?(\[\"a\"\], is_b)"]
} -result {bool bool bool}

test si-hof-7 {a callable of the wrong argument type is rejected for any?/all?/none? too} -body {
    lmap helper {any? all? none?} {
        siRejects "import std::list\nfn pos(n: int):\n    n > 0\nstd::list::${helper}(\[\"a\"\], pos)" "*is invalid*"
    }
} -result {1 1 1}

test si-hof-8 {a handler whose value does not fit the now-precise find result is the ordinary handled-result rule} -body {
    siRejects "${isB}r = std::list::find(\[\"a\"\], is_b):\n    on std::list::NotFound:\n        0\nr" "*not admissible as str*"
} -result 1

test si-hof-9 {a helper of typed arrays: find over List[MutableArray[str]] keeps the contract} -body {
    siLast "import std::list\nimport std::mutable_array\nfn nonempty(m):\n    std::mutable_array::capacity(m) > 0\nr = std::list::find(\[std::mutable_array::create(1, \"x\")\], nonempty):\n    on std::list::NotFound:\n        std::mutable_array::create(0, \"x\")\nr"
} -result {MutableArray[str]}

# ---------------------------------------------------------------------------
# recursion, mutual recursion, termination, budgets

test si-rec-1 {self recursion reuses the in-progress instance: one instance per concrete environment} -body {
    set hir [siCompile "fn count(xs, n):\n    if n == 0:\n        xs\n    else:\n        count(xs, n - 1)\ncount(\[\"a\"\], 3)"]
    list [hir::types::show [hir::typeOf $hir [lindex [hir::roots $hir] end]]] \
        [lmap row [hir::semantic::census $hir] {dict get $row name}] [dict get $hir semantic walks]
} -result {{List[str]} {count count} 4}

test si-rec-2 {mutual recursion between instances (functions that pass each other as arguments; no lexical forward reference) terminates and types both, independent of the definition order} -body {
    set ping "fn ping(xs, n, next):\n    if n == 0:\n        xs\n    else:\n        next(xs, n - 1, ping)\n"
    set pong "fn pong(xs, n, prev):\n    if n == 0:\n        xs\n    else:\n        prev(xs, n - 1, pong)\n"
    list [siLast "${ping}${pong}ping(\[\"a\"\], 3, pong)"] [siLast "${pong}${ping}ping(\[\"a\"\], 3, pong)"]
} -result {{List[str]} {List[str]}}

test si-rec-2b {the instance cycle above is real: each instance is read by the other} -body {
    set hir [siCompile "fn ping(xs, n, next):\n    if n == 0:\n        xs\n    else:\n        next(xs, n - 1, ping)\n\nfn pong(xs, n, prev):\n    if n == 0:\n        xs\n    else:\n        prev(xs, n - 1, pong)\n\nping(\[\"a\"\], 3, pong)"]
    set deps [dict get $hir semantic deps]
    set cyclic 0
    dict for {id readers} $deps {
        foreach reader [dict keys $readers] {
            if {$reader ne $id && [dict exists $deps $reader $id]} { set cyclic 1 }
        }
    }
    set cyclic
} -result 1

test si-rec-2c {lexical mutual recursion is rejected before any analysis} -body {
    catch {siCompile "fn ping(xs, n):\n    if n == 0:\n        xs\n    else:\n        pong(xs, n - 1)\nfn pong(xs, n):\n    if n == 0:\n        xs\n    else:\n        ping(xs, n - 1)\nping(\[\"a\"\], 3)"} m o
    dict get $o -errorcode
} -result {CORE SEMANTIC UNBOUND}

test si-rec-3 {type-changing recursion creates further instances and stops at the aggregate bound: the key space is finite without any per-function budget} -body {
    set hir [siCompile "fn wrap(x, n):\n    if n == 0:\n        x\n    else:\n        wrap(\[x\], n - 1)\nwrap(\"a\", 5)"]
    set rows [hir::semantic::census $hir]
    list [hir::types::show [hir::typeOf $hir [lindex [hir::roots $hir] end]]] \
        [expr {[llength $rows] <= 2 * ($hir::types::aggregateDepth + 2)}] [info exists hir::semantic::maxPerBlock]
} -result {any 1 0}

test si-rec-4 {even?/odd? over ints, as functions that pass each other} -body {
    siLast "fn even?(n, other):\n    if n == 0:\n        true\n    else:\n        other(n - 1, even?)\nfn odd?(n, other):\n    if n == 0:\n        false\n    else:\n        other(n - 1, odd?)\neven?(4, odd?)"
} -result bool

test si-rec-5 {no per-function budget: identity called with twenty distinct types gets twenty instances, each as precise as the first, and a bearing argument past them still gets its own (no generic fallback that could erase it)} -body {
    set src "${::siTyped}fn identity(x):\n    x\n"
    for {set i 1} {$i <= 20} {incr i} {
        append src "struct S$i:\n    v: int\n\n"
    }
    for {set i 1} {$i <= 20} {incr i} {
        append src "a$i = identity(S$i {v: $i})\n"
    }
    set hir [siCompile "${src}f = identity(typed)\nf(a20.v)"]
    list [llength [hir::semantic::census $hir]] [siLast "${src}a20"] \
        [hir::types::show [hir::typeOf $hir [lindex [hir::roots $hir] end]]] [dict get $hir semantic declinedCount]
} -result {21 S20 int {}}

test si-rec-6 {the total-instance guard fails the compilation explicitly (HIR SEMANTIC LIMIT, naming the function and its entry types), never a generic fallback: no TYPE error, no bearing argument accepted, and no run left in progress} -body {
    set saved $hir::semantic::maxInstances
    set hir::semantic::maxInstances 0
    try {
        lmap src [list "fn identity(x):\n    x\nidentity(1)" "${::siTyped}fn identity(x):\n    x\nidentity(typed)"] {
            catch {siCompile $src} message options
            list [dict get $options -errorcode] [string match "*semantic-instance limit was reached: 0 instances*identity (x : *)*" $message] \
                [hir::semantic::Active]
        }
    } finally {
        set hir::semantic::maxInstances $saved
    }
} -result {{{HIR SEMANTIC LIMIT} 1 0} {{HIR SEMANTIC LIMIT} 1 0}}

test si-rec-6b {the guard names the chain of instances being analyzed when the request was made} -body {
    set saved $hir::semantic::maxInstances
    set hir::semantic::maxInstances 1
    try {
        catch {siCompile "fn inner(y):\n    y\nfn outer(x):\n    inner(x)\nouter(1)"} message options
        list [dict get $options -errorcode] [string match "*inner (y : int), requested while analyzing outer (x : int)*" $message]
    } finally {
        set hir::semantic::maxInstances $saved
    }
} -result {{HIR SEMANTIC LIMIT} 1}

test si-rec-7 {instances are demand driven: a call in a statically unreachable branch requests none, a call in reachable source does} -body {
    set src "fn identity(x):\n    x\nfn unused(y):\n    identity(\"s\")\nif false:\n    identity(1)\nelse:\n    unit"
    siInstances $src
} -result {{identity<str> -> str [valid]}}

# ---------------------------------------------------------------------------
# budget independence (SEMANTIC-INSTANCE-SCALABILITY-MILESTONE-1.md): whether
# a program is valid never depends on how many unrelated types instantiated a
# helper. The reproducer of audit/mid-end-port/tools/budget.tcl: an untyped
# helper called with N struct types, whose result reaches a typed parameter
# (once rejected from the 17th type on, as a TYPE error at value(pick17.f)).

# The program: N struct types T1 .. TN holding a Fact; call I gives choose
# T((I - 1) mod K + 1) (K distinct types: N when K is ""), and its pick's
# field goes to the typed value. TAIL is the last statement (default: the
# running total). PREFIX goes before the calls.
proc siManyTypes {n {k ""} {tail ""} {prefix ""}} {
    set text "struct Fact:\n    v: int\n\nfn choose(c, x, y):\n    if c:\n        x\n    else:\n        y\n\nfn value(f: Fact) -> int:\n    f.v\n"
    for {set i 1} {$i <= $n} {incr i} {
        append text "\nstruct T$i:\n    f: Fact\n    tag$i: int\n"
    }
    append text "\n$prefix"
    for {set i 1} {$i <= $n} {incr i} {
        set t [expr {$k eq "" ? $i : ($i - 1) % $k + 1}]
        append text "pick$i = choose(true, T$t {f: Fact {v: $i}, tag$t: 0}, T$t {f: Fact {v: 0}, tag$t: 1})\n"
        if {$i == 1} {
            append text "total1 = value(pick1.f)\n"
        } else {
            append text "total$i = total[expr {$i - 1}] + value(pick$i.f)\n"
        }
    }
    if {$tail eq ""} {
        set tail total$n
    }
    return "$text$tail\n"
}

# For each N: whether the program compiles, the type of the last pick, the
# number of choose's instances, and the requests declined.
proc siBudgetRow {n} {
    set hir [siCompile [siManyTypes $n "" pick$n]]
    set count 0
    foreach row [hir::semantic::census $hir] {
        if {[dict get $row name] eq "choose"} { incr count }
    }
    list $n [hir::types::show [hir::typeOf $hir [lindex [hir::roots $hir] end]]] $count \
        [dict get $hir semantic declinedCount]
}

test si-budget-17 {the 17th, 64th and 256th distinct type through one untyped helper keep their precision: each pick is its own struct type, each a valid instance, none declined} -body {
    lmap n {16 17 64 256} {siBudgetRow $n}
} -result {{16 T16 16 {}} {17 T17 17 {}} {64 T64 64 {}} {256 T256 256 {}}}

test si-budget-1024 {1,024 distinct types through one helper compile, the sum of the picks' fields reaching a typed parameter each time} -body {
    set hir [siCompile [siManyTypes 1024]]
    list [hir::types::show [hir::typeOf $hir [lindex [hir::roots $hir] end]]] \
        [dict size [dict get $hir semantic instances]] [dict get $hir semantic declinedCount]
} -result {int 1024 {}}

test si-budget-unrelated {a call's typing and validity are the same whatever other types instantiated the helper before it, after it or not at all; so is an invalid call's diagnostic} -body {
    set probe "probe = choose(true, Fact {v: 7}, Fact {v: 8})\n"
    set bad "bad = value(choose(true, 1, 2))\n"
    set alone [siCompile [siManyTypes 0 "" probe $probe]]
    set before [siCompile [siManyTypes 40 "" probe $probe]]
    set after [siCompile "[siManyTypes 40 "" total40]$probe"]
    list [lsort -unique [lmap hir [list $alone $before $after] {
            hir::types::show [hir::typeOf $hir [lindex [hir::roots $hir] end]]
        }]] \
        [lsort -unique [lmap src [list [siManyTypes 0 "" 0 $bad] [siManyTypes 40 "" 0 $bad] "[siManyTypes 40]$bad"] {
            regsub {si-program.bot:[0-9]+:[0-9]+} [lindex [split [siMessage $src] \n] 0] {P} message
            set message
        }]]
} -match glob -result {Fact {{*P: argument for parameter "f" cannot be proven to satisfy Fact (argument type: int)}}}

# A helper valid for every struct with a MutableArray[int] field m, and
# invalid for one whose m is a MutableArray[str]: an instance-only error.
set ::siPut "import std::mutable_array\n\nfn put(x):\n    w = x.m\n    r = std::mutable_array::set(w, 0, 1):\n        on IndexNotFound:\n            unit\n    r\n\nstruct Bad:\n    m: MutableArray\[str\]\n\n"

test si-budget-real-error {a real type error inside an instance is reported at the call that needs it, with the same diagnostic, among any number of valid instances before or after it} -body {
    set def $::siPut
    set calls ""
    for {set i 1} {$i <= 30} {incr i} {
        append def "struct S$i:\n    m: MutableArray\[int\]\n\n"
        append calls "a$i = put(S$i {m: std::mutable_array::create(1, $i)})\n"
    }
    set call "b = put(Bad {m: std::mutable_array::create(1, \"s\")})\n"
    lsort -unique [lmap src [list "$def${call}0\n" "$def$calls${call}0\n" "$def$call${calls}0\n"] {
        regsub -all {si-program.bot:[0-9]+:[0-9]+|at [0-9]+:[0-9]+} [lindex [split [siMessage $src] \n] 0] {P} message
        set message
    }]
} -match glob -result {{*P: call to put with x : Bad is invalid: value of type int is not admissible to element type str of MutableArray*}}

test si-budget-holds {std::test::holds with twenty typed predicates compiles and runs (SIMCITY-WORKLOAD-KNOWN-GAPS.md, 3.1: the 17th was rejected as an erasure of its predicate's typed parameter, the budget declining its instance)} -body {
    set src "import std::test\nimport std::compiler\n\nfn register():\n    fn body() errors std::compiler::CompilerError:\n        static compile:\n            42\n"
    for {set i 1} {$i <= 20} {incr i} {
        append src "    fn check_$i\(p: int) -> bool:\n        p > $i\n    std::test::holds(\"case $i\", \"above $i\", check_$i, body)\n"
    }
    append src "\nwith context std::test::suite()\nregister()\nstd::test::report()\n"
    lassign [outcomeUnderHir interp [siCompile $src]] kind value
    list $kind [regexp -all {"PASS case [0-9]+"} $value] [string match {*"20 passed, 0 failed"\]} $value]
} -result {value 20 1}

test si-defer-1 {a request deeper than the nesting limit is deferred to the worklist, never declined: a chain of untyped functions longer than maxDepth keeps its precision, so the end of the chain satisfies a typed parameter} -body {
    set n [expr {$hir::semantic::maxDepth + 6}]
    set text "fn want(x: int) -> int:\n    x\n\nfn c$n\(x):\n    x\n\n"
    for {set i [expr {$n - 1}]} {$i >= 1} {incr i -1} {
        append text "fn c$i\(x):\n    c[expr {$i + 1}](x)\n\n"
    }
    set hir [siCompile "${text}want(c1(1))"]
    list [hir::types::show [hir::typeOf $hir [lindex [hir::roots $hir] end]]] \
        [expr {[dict get $hir semantic deferred] > 0}] [dict get $hir semantic declinedCount] \
        [llength [hir::semantic::census $hir]] \
        [lsort -unique [lmap row [hir::semantic::census $hir] {dict get $row status}]]
} -result [list int 1 {} [expr {$hir::semantic::maxDepth + 6}] valid]

test si-defer-2 {a deferred instance of an invalid body is still invalid: the call that needs it, through a chain longer than the nesting limit, is rejected with the instance's diagnostic} -body {
    set n [expr {$hir::semantic::maxDepth + 3}]
    set text $::siPut
    for {set i [expr {$n - 1}]} {$i >= 1} {incr i -1} {
        set next [expr {$i == $n - 1 ? "put" : "c[expr {$i + 1}]"}]
        append text "fn c$i\(x):\n    $next\(x)\n\n"
    }
    set src "${text}b = c1(Bad {m: std::mutable_array::create(1, \"s\")})\n0\n"
    regsub {si-program.bot:[0-9]+:[0-9]+} [lindex [split [siMessage $src] \n] 0] {P} message
    list $message [expr {[dict get [siCompile $src 0] semantic deferred] > 0}]
} -match glob -result {{*P: call to c1 with x : Bad is invalid: call to c2 with x : Bad is invalid: *value of type int is not admissible to element type str*} 1}

# ---------------------------------------------------------------------------
# region-local walks: an instance is typed in the program's own HIR, in place
# (hir/semantic.tcl, "Region-local walks"), and leaves it exactly as it was.

test si-region-audit {with the rollback audit on, every walk of a program with nested, recursive, deferred and many instances restores the HIR it typed exactly (hir::semantic::AuditRestore fails the compilation otherwise)} -body {
    set saved $hir::semantic::auditRollback
    set hir::semantic::auditRollback 1
    try {
        set n [expr {$hir::semantic::maxDepth + 3}]
        set chain "fn c$n\(x):\n    x\n\n"
        for {set i [expr {$n - 1}]} {$i >= 1} {incr i -1} {
            append chain "fn c$i\(x):\n    c[expr {$i + 1}](x)\n\n"
        }
        set src "import std::mutable_array\nfn mk(m) errors IndexNotFound:\n    fn get(i) errors IndexNotFound:\n        std::mutable_array::at(m, i)\n    get(0)\nfn wrap(x, n):\n    if n == 0:\n        x\n    else:\n        wrap(\[x\], n - 1)\n$chain"
        append src [siManyTypes 12 "" "0" "a = mk(std::mutable_array::create(1, \"x\")):\n    on IndexNotFound:\n        \"z\"\nb = mk(std::mutable_array::create(1, 1)):\n    on IndexNotFound:\n        0\nw = wrap(\"a\", 5)\nd = c1(\[1\])\n"]
        set hir [siCompile $src]
        list [llength [hir::semantic::census $hir]] [expr {[dict get $hir semantic deferred] > 0}]
    } finally {
        set hir::semantic::auditRollback $saved
    }
} -match glob -result {* 1}

test si-region-generic-intact {the generic facts of a helper's body survive any number of instance walks over it: after 40 instances, choose's parameter references are still typed any in the program's HIR, as the generic walk typed them} -body {
    set hir [siCompile [siManyTypes 40]]
    set block [siBlock $hir choose]
    set refs [lmap e [hir::semantic::Region $hir $block] {
        if {[hir::kind $hir $e] ne "ref" || [hir::get $hir $e name] ni {x y}} continue
        hir::types::show [hir::typeOf $hir $e]
    }]
    list [lsort -unique $refs] [llength $refs] [hir::types::show [hir::type $hir [hir::get $hir $block resultType]]]
} -result {any 2 any}

test si-region-isolated {instances of one function with incompatible entry types never see each other's facts, in the body of the closure it creates either: each snapshot types the captured x by its own instance's entry type (and the closure's own untyped y as any, as created)} -body {
    set src "fn pair(x):\n    fn both(y):\n        \[x, y\]\n    both(x)\na = pair(1)\nb = pair(\"s\")\nc = pair(\[true\])\n\[a, b, c\]"
    set hir [siCompile $src]
    set rows {}
    foreach row [hir::semantic::census $hir] {
        if {[dict get $row name] ne "pair"} continue
        set snapshot [dict get $hir semantic instances [dict get $row id] snapshot]
        set types {}
        dict for {e rec} [dict get $snapshot exprs] {
            if {[hir::kind $hir $e] eq "ref" && [hir::get $hir $e name] in {x y} && [dict get $rec type] ne ""} {
                lappend types [hir::types::show [dict get $rec type]]
            }
        }
        lappend rows [list [hir::types::show [lindex [dict get $row args] 0]] [lsort -unique $types] \
            [hir::types::show [dict get $row result]]]
    }
    lsort $rows
} -result {{int {any int} list} {str {any str} list} {{List[bool]} {{List[bool]} any} list}}

# The expression table object the walk's HIR variable holds before and after
# each instance walk (the address Tcl reports): a walk that copies the table
# (a shared table's first write) leaves the variable holding another one.
proc siTableAddress {value} {
    regexp {object pointer at (0x[0-9a-fA-F]+)} [tcl::unsupported::representation $value] -> address
    return $address
}

test si-region-no-copy {an instance walk writes the program's expression table in place: no walk of 64 instances copies it (each once copied all of it, so the walks cost the program's size)} -body {
    rename ::hir::semantic::Walk ::hir::semantic::WalkUnderTest
    proc ::hir::semantic::Walk {hirVar id} {
        upvar 1 $hirVar hir
        set before [siTableAddress [dict get $hir exprs]]
        set result [WalkUnderTest hir $id]
        lappend ::siWalkTables [expr {$before eq [siTableAddress [dict get $hir exprs]]}]
        return $result
    }
    set ::siWalkTables {}
    try {
        siCompile [siManyTypes 64]
    } finally {
        rename ::hir::semantic::Walk {}
        rename ::hir::semantic::WalkUnderTest ::hir::semantic::Walk
    }
    list [expr {[llength $::siWalkTables] >= 64}] [lsort -unique $::siWalkTables]
} -result {1 1}

test si-region-reorder {independent definitions and calls in another order give the same instances and the same types} -body {
    set forward [siManyTypes 24 "" pick24]
    set lines [split $forward \n]
    # The struct declarations in reverse order.
    set structs {}
    set rest {}
    set i 0
    while {$i < [llength $lines]} {
        set line [lindex $lines $i]
        if {[string match "struct T*" $line]} {
            set structs [linsert $structs 0 [join [lrange $lines $i [expr {$i + 2}]] \n]]
            incr i 4
            continue
        }
        lappend rest $line
        incr i
    }
    set head [lsearch -exact $rest "fn value(f: Fact) -> int:"]
    set reversed [join [concat [lrange $rest 0 [expr {$head + 2}]] $structs [list ""] [lrange $rest [expr {$head + 3}] end]] \n]
    set one [siInstances $forward]
    set two [siInstances $reversed]
    list [expr {$one eq $two}] [llength $one] [siLast $forward] [siLast $reversed]
} -result {1 24 T24 T24}

# ---------------------------------------------------------------------------
# aliases and captures

test si-alias-1 {an exact alias of a function keeps its identity: the call through the alias is an instance} -body {
    siLast "import std::mutable_array\nfn identity(x):\n    x\nf = identity\nf(std::mutable_array::create(1, \"x\"))"
} -result {MutableArray[str]}

test si-cap-1 {a closure created inside an instance sees that instance's types for what it captures; the same source closure is typed differently per enclosing instance} -body {
    set def "import std::mutable_array\nfn mk(m) errors IndexNotFound:\n    fn get(i) errors IndexNotFound:\n        std::mutable_array::at(m, i)\n    get(0)\n"
    set run "v = mk(std::mutable_array::create(1, %s)):\n    on IndexNotFound:\n        %s\nv"
    list [siLast "${def}[format $run {"x"} {"z"}]"] [siLast "${def}[format $run 1 0]"] \
        [siInstances "${def}a = mk(std::mutable_array::create(1, \"x\")):\n    on IndexNotFound:\n        \"z\"\nb = mk(std::mutable_array::create(1, 1)):\n    on IndexNotFound:\n        0\nunit"]
} -result {str int {{get<int> -> any [valid]} {mk<MutableArray[int]> -> int [valid]} {mk<MutableArray[str]> -> str [valid]}}}

test si-cap-2 {a bad write inside a nested closure of an instance is found by the instance (the closure is part of the region)} -body {
    siRejects "import std::mutable_array\nfn mk(m) errors IndexNotFound:\n    fn put(v):\n        local = m\n        std::mutable_array::set(local, 0, v)\n        local\n    put(5)\nmk(std::mutable_array::create(1, \"x\"))" \
        "*call to mk with m : MutableArray\\\[str\\\] is invalid: value of type any is not admissible*"
} -result 1

test si-cap-3 {a closure returned out of an instance keeps the result type computed in place; called later, it is never less precise} -body {
    siLast "import std::mutable_array\nfn mk(m):\n    fn get(i) errors IndexNotFound:\n        std::mutable_array::at(m, i)\n    get\ng = mk(std::mutable_array::create(1, \"x\"))\nv = g(0):\n    on IndexNotFound:\n        \"z\"\nv"
} -result str

test si-cap-4 {a captured typed value returned through a later-called closure stays typed} -body {
    siLast "import std::mutable_array\nfn mk(m) errors IndexNotFound:\n    fn me(i):\n        m\n    me\ng = mk(std::mutable_array::create(1, \"x\"))\ng(0)"
} -result {MutableArray[str]}

test si-cap-5 {a program-level closure capturing a program-level value is typed under the recorded creation environment} -body {
    siLast "import std::list\nnames = \[\"a\", \"b\"\]\nfn pick(i) errors IndexNotFound:\n    std::list::at(names, i)\nfn twice(f, i):\n    f(i)\ntwice(pick, 1)"
} -result str

test si-cap-6 {a closure capturing a binding typed by an enclosing recursive function's own (optimistically assumed) result is re-analyzed when that environment settles: the answer is the fixpoint's, never an early assumption's} -body {
    siLast "import std::list\nfn f(n):\n    y = if n == 0:\n        \"s\"\n    else:\n        f(n - 1)\n    fn get(i) errors IndexNotFound:\n        std::list::at(\[y\], i)\n    get(0)\nf(3)"
} -result str

# ---------------------------------------------------------------------------
# the dynamic boundary and forward calls

test si-dyn-1 {a call through a structural Fn or an open value creates no instance} -body {
    set src "import std::list\nfn apply(f: Fn{args: \[int\], return: int, errors: \[\]}, n: int):\n    f(n)\nfn inc(x: int):\n    x + 1\nfn pick(fs, i) errors IndexNotFound:\n    std::list::at(fs, i)\ng = pick(\[inc, inc\], 0):\n    on IndexNotFound:\n        inc\napply(g, 1)"
    siLast $src
} -result int

set fnDefs "import std::list\nfn apply(f, x):\n    f(x)\nfn inc(n: int):\n    n + 1\nfn dec(n: int):\n    n - 1\nfn pick(fs, i) errors IndexNotFound:\n    std::list::at(fs, i)\ng = pick(\[inc, dec\], 1):\n    on IndexNotFound:\n        inc\n"

test si-fn-1 {a structural Fn argument seeds the untyped parameter with its contract: the callee's result and its argument check come from that contract, the instance is keyed by the full Fn type} -body {
    list [siLast "${fnDefs}apply(g, 5)"] [siInstances "${fnDefs}apply(g, 5)"]
} -result {int {{apply<Fn{args: [int], return: int, errors: []}, int> -> int [valid]} {pick<List[Fn{args: [int], return: int, errors: []}], int> -> Fn{args: [int], return: int, errors: []} [valid]}}}

test si-fn-2 {...and an argument the contract does not admit is rejected at the call} -body {
    siRejects "${fnDefs}apply(g, \"s\")" "*call to apply with f : Fn{args: \\\[int\\\], return: int, errors: \\\[\\\]}, x : str is invalid: argument 1 cannot be proven to satisfy int*"
} -result 1

test si-dyn-2 {a call of a nested function with captures is typed under its creation environment} -body {
    siLast "fn outer(x):\n    fn inner(y):\n        y\n    inner(x)\nouter(\"s\")"
} -result str

test si-dyn-3 {a call before the definition is rejected (STRICT-REFERENCE-DETERMINISM.md); the callee-first order is the program} -body {
    catch {siCompile "fn a(x):\n    b(x)\nfn b(y):\n    y\na(\"s\")"} m o
    list [dict get $o -errorcode] [siLast "fn b(y):\n    y\nfn a(x):\n    b(x)\na(\"s\")"]
} -result {{CORE SEMANTIC UNBOUND} str}

test si-dyn-5 {a second whole-program walk is not about definition order: a recursive function with a declared result requests an instance of itself before its own nested closure has been walked once} -body {
    set hir [siCompile "fn f(n) -> int:\n    if n == 0:\n        return 0\n    r = f(n - 1)\n    fn g(x):\n        x + n\n    g(1) + r\n\nf(3)"]
    list [dict get $hir semantic rounds] [hir::types::show [hir::typeOf $hir [lindex [hir::roots $hir] end]]]
} -result {2 int}

test si-dyn-4 {captures: a closure's instance uses the environment its creation recorded} -body {
    siLast "import std::list\nfn mk(x) errors IndexNotFound:\n    fn get(i) errors IndexNotFound:\n        std::list::at(x, i)\n    get(0)\nv = mk(\[\"a\"\]):\n    on IndexNotFound:\n        \"z\"\nv"
} -result str

# ---------------------------------------------------------------------------
# no user-facing generics

test si-nogen-1 {no generic syntax or type variables exist} -body {
    lmap src {
        "fn f\[T\](x: T) -> T:\n    x\nf(1)"
        "fn f(x: T):\n    x\nf(1)"
        "fn f(x) where T:\n    x\nf(1)"
        "fn f(x: forall T):\n    x\nf(1)"
    } {expr {[siMessage $src] eq "accepted" ? "accepted" : "rejected"}}
} -result {rejected rejected rejected rejected}

test si-nogen-2 {public signatures never report instances: params stay the ordinary intrinsic contracts} -body {
    set hir [siCompile "import std::mutable_array\nfn identity(x):\n    x\na = identity(std::mutable_array::create(1, \"x\"))\nb = identity(1)\nunit"]
    set sig [dict get [hir::signatures::of $hir [siBlock $hir identity]] params]
    list [lmap p $sig {dict get $p source}] [hir::types::show [dict get [hir::signatures::of $hir [siBlock $hir identity]] result]]
} -result {none any}

test si-nogen-3 {module signatures of the library helpers carry no instance} -body {
    set hir [siCompile "${isB}${findStr}"]
    set sigs [hir::moduleSignatures $hir]
    list [dict get $sigs std::list::find params] [dict get $sigs std::list::find result]
} -result {{list any} any}

# ---------------------------------------------------------------------------
# semantic instances are not codegen instances

test si-sep-1 {KeyType is representation-oriented and unchanged: MutableArray[T] is the raw kind} -body {
    list [hir::specialize::KeyType {mutarray str}] [hir::specialize::KeyType {mutarray int}] \
        [hir::specialize::KeyType {list str}] [hir::specialize::KeyType [hir::types::MakeFn {int} bool {}]]
} -result {mutarray mutarray {list str} any}

test si-sep-2 {two semantic instances of identity share one codegen instance} -body {
    set src "import std::mutable_array\nfn identity(x):\n    x\na = identity(std::mutable_array::create(2, \"x\"))\nb = identity(std::mutable_array::create(2, 1))\nunit"
    set hir [siCompile $src]
    set semantic [llength [lmap row [hir::semantic::census $hir] {
        if {[dict get $row name] ne "identity"} continue
        set row
    }]]
    set spec [hir::specialize::analyze $hir]
    set id [siBlock $hir identity]
    set codegen 0
    foreach i [dict get $spec used] {
        if {[dict get $spec instances $i block] eq $id} { incr codegen }
    }
    list $semantic $codegen
} -result {2 1}

test si-sep-3 {an instance's key holds full semantic types, the codegen key does not} -body {
    set hir [siCompile "import std::mutable_array\nfn identity(x):\n    x\na = identity(std::mutable_array::create(2, \"x\"))\nb = identity(std::mutable_array::create(2, 1))\nunit"]
    set keys [lsort [lmap {key id} [dict get $hir semantic keys] {
        lassign $key block args
        join [lmap t $args {hir::types::show $t}] ,
    }]]
    list $keys [lmap k $keys {expr {[hir::specialize::KeyType [lindex [dict get $hir semantic instances s0 args] 0]] eq "mutarray"}}]
} -result {{{MutableArray[int]} {MutableArray[str]}} {1 1}}

test si-sep-4 {exact scalar values are not in the key: 0, 1, 2 are one instance} -body {
    siInstances "fn identity(x):\n    x\na = identity(0)\nb = identity(1)\nc = identity(2)\nunit"
} -result {{identity<int> -> int [valid]}}

test si-sep-5 {disabling the layer restores the pre-instance behavior exactly} -body {
    set hir::semantic::enabled 0
    try {
        list [siLast "fn identity(x):\n    x\nidentity(5)"] \
            [siRejects "${::siTyped}fn identity(x):\n    x\nidentity(typed)" "*cannot be preserved*"]
    } finally {
        set hir::semantic::enabled 1
    }
} -result {any 1}

# ---------------------------------------------------------------------------
# determinism

test si-det-1 {the same canonical instances and results whatever the (legal) definition order: independent helpers may swap, callees stay before callers} -body {
    set a "fn identity(x):\n    x\n"
    set b "fn first(xs) errors IndexNotFound:\n    std::list::at(xs, 0)\n"
    set imp "import std::list\nimport std::mutable_array\n"
    set c "fn both(xs) errors IndexNotFound:\n    identity(first(xs))\n"
    set use "both(\[\"a\"\])\nboth(\[1\])\nidentity(std::mutable_array::create(1, \"x\"))"
    set one [siInstances "${imp}${a}${b}${c}${use}"]
    set two [siInstances "${imp}${b}${a}${c}${use}"]
    list [expr {$one eq $two}] [llength $one] [catch {siCompile "${imp}${c}${b}${a}${use}"}]
} -result {1 7 1}

test si-det-2 {compiling twice gives identical tables} -body {
    set src "import std::list\nfn first(xs) errors IndexNotFound:\n    std::list::at(xs, 0)\na = first(\[\"x\"\])\nb = first(\[1\])\nunit"
    expr {[dict get [siCompile $src] semantic instances] eq [dict get [siCompile $src] semantic instances]}
} -result 1

# ---------------------------------------------------------------------------
# runtime parity: the instances are analysis-only, so behavior is unchanged

set parityBackends {interp compile cranelift-generic cranelift}

proc siParity {src} {
    set exprs [hir::lower [siCompile $src 0]]
    set outcomes [lmap backend $::parityBackends {outcomeUnder $backend $exprs}]
    if {[llength [lsort -unique $outcomes]] == 1} {
        return [lindex $outcomes 0]
    }
    return [join [lmap backend $::parityBackends outcome $outcomes {list $backend $outcome}] " / "]
}

test si-run-1 {identity/first/find/writer run identically on every backend; a writer mutates its own copy} -body {
    siParity "import std::list\nimport std::mutable_array\nfn identity(x):\n    x\nfn first(xs) errors IndexNotFound:\n    std::list::at(xs, 0)\nfn writer(x, v) errors IndexNotFound:\n    w = x\n    std::mutable_array::set(w, 0, v)\n    w\nm = std::mutable_array::create(2, \"x\")\nn = identity(m)\nw = writer(n, \"y\")\n\[first(\[\"p\", \"q\"\]), first(\[1, 2\]), std::mutable_array::at(w, 0), std::mutable_array::at(n, 0), std::mutable_array::capacity(identity(m))\]"
} -result {value {["p", 1, "y", "x", 2]} {}}

test si-run-2 {std::list::find with instances runs identically on every backend} -body {
    siParity "import std::list\nfn is_b(s):\n    s == \"b\"\nr = std::list::find(\[\"a\", \"b\"\], is_b):\n    on std::list::NotFound:\n        \"none\"\nr"
} -result {value {"b"} {}}

test si-run-3 {a helper instantiated with 20 distinct types computes the same value on every backend} -body {
    siParity [siManyTypes 20 5]
} -result {value 210 {}}

test si-det-3 {compiling a program with many instances twice gives identical instance tables, snapshots included} -body {
    set src [siManyTypes 30 7]
    expr {[dict get [siCompile $src] semantic instances] eq [dict get [siCompile $src] semantic instances]}
} -result 1

cleanupTests
