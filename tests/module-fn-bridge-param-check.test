# module-fn-bridge-param-check.test -- a module-bridged native keeps its own
# parameter check on the native backends.
#
# A native with a -module-fn (emailish?, uriEscape: lib/web.tcl) runs, on
# cranelift, the ordinary Botlish function it names (native::prepareHir's
# bridge) instead of its Tcl -impl. The bridge replaces the implementation
# only: the native's -param-types are still checked first, under the
# native's own name, as core::native::invoke (for a type test) and the -impl
# (uriEscape) check them on interp and compile. hir::aot::VisitCall requires
# them of a bridged call's arguments and native lowering emits the guards
# (BridgedCheckedNative). Without that, Emailish?(5) failed inside
# web::emailish?'s body as "length: expected str, got 5" on cranelift
# (tests/refined.test's refined-5 in the native coverage run).
#
# The four-backend comparisons here compare the whole outcome, message
# included: an error code alone (CORE SEMANTIC TYPE either way) does not
# show which operation failed.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]

set parityBackends {interp compile cranelift-generic cranelift}

# The outcome {value V} or {error CODE MESSAGE} of EXPRS if all four
# backends agree on it, message included; otherwise an error naming each.
proc fourWayFull {exprs} {
    set outcomes [lmap b $::parityBackends {
        set o [outcomeUnder $b $exprs]
        lrange $o 0 [expr {[lindex $o 0] eq "value" ? 1 : 2}]
    }]
    if {[llength [lsort -unique $outcomes]] != 1} {
        error "mismatch across $::parityBackends: $outcomes"
    }
    return [lindex $outcomes 0]
}

proc sourceIR {text} {
    return [hir::lower [surface::compile $text t.bot -strict 0]]
}

# Lines of function NAME's body in the NIR text NIR that match PATTERN.
proc nirLines {nir name pattern} {
    set lines {}
    set inside 0
    foreach line [split $nir \n] {
        if {[string match "func *" $line]} {
            set inside [string match "func * \"$name\" *" $line]
        } elseif {$inside && [regexp $pattern $line]} {
            lappend lines [regsub {^\s+} $line ""]
        }
    }
    return $lines
}

# A function h whose parameter is untyped, called with VALUES (core IR).
proc hCalls {native values} {
    return [list \
        [list bind h [list block {x} [list call [list ref $native] {ref x}]]] \
        [list call {ref list} {*}[lmap v $values {list call {ref h} $v}]]]
}

# ---------------------------------------------------------------------------
# An argument statically of the wrong kind (hir::aot's known error).

foreach {label native arg message} {
    emailish-int   emailish? {const 5}                   {emailish?: expected str, got 5}
    alias-int      Emailish? {const 5}                   {emailish?: expected str, got 5}
    emailish-list  emailish? {call {ref list} {const 1}} {emailish?: expected str, got [1]}
    uri-int        uriEscape {const 5}                   {uriEscape: expected str, got 5}
} {
    test bridge-param-check-static-$label "$native rejects a non-String argument under its own name, on every backend" -body {
        fourWayFull [list [list call [list ref $native] $arg]]
    } -result [list error {CORE SEMANTIC TYPE} $message]
}

test bridge-param-check-static-source {the same from source} -body {
    fourWayFull [sourceIR "emailish?(5)\n"]
} -result {error {CORE SEMANTIC TYPE} {emailish?: expected str, got 5}}

# ---------------------------------------------------------------------------
# An argument of no static kind: cranelift-generic compiles h once, with a
# run-time guard; cranelift compiles h's int instance with the known error.

test bridge-param-check-dynamic-emailish {emailish? checks a run-time argument under its own name, on every backend} -body {
    fourWayFull [hCalls Emailish? {{const str a@b.io} {const 5}}]
} -result {error {CORE SEMANTIC TYPE} {emailish?: expected str, got 5}}

test bridge-param-check-dynamic-uri {uriEscape checks a run-time argument under its own name, on every backend} -body {
    fourWayFull [hCalls uriEscape {{const str {a b}} {const 7}}]
} -result {error {CORE SEMANTIC TYPE} {uriEscape: expected str, got 7}}

test bridge-param-check-dynamic-passes {a String argument passes the guard and reaches web::emailish?, on every backend} -body {
    fourWayFull [hCalls Emailish? {{const str a@b.io} {const str nope}}]
} -result {value {[true, false]}}

test bridge-param-check-dynamic-source {the same from source} -body {
    fourWayFull [sourceIR "fn h(x):\n    emailish?(x)\n\n\[h(\"a@b.io\"), h(5)\]\n"]
} -result {error {CORE SEMANTIC TYPE} {emailish?: expected str, got 5}}

# ---------------------------------------------------------------------------
# NIR: where the check is.

test bridge-param-check-nir-generic {unspecialized, the caller guards the argument under the native's name, then calls web::emailish?} -body {
    set hir [hir::build [hCalls Emailish? {{const str a@b.io} {const 5}}] -strict 0]
    nirLines [native::nir $hir -specialize 0] h {guard|call|unreachable}
} -match regexp -result {^\{guard str %0 "emailish\?" @e[0-9]+\} \{%[0-9]+ = call [0-9]+ %0 @e[0-9]+\}$}

test bridge-param-check-nir-known-error {specialized for an Int argument, the guard always fails: no call of web::emailish? follows, and no Int instance of it is compiled} -body {
    set hir [hir::build [hCalls Emailish? {{const 5}}] -strict 0]
    set nir [native::nir $hir]
    list [nirLines $nir h {guard|call|unreachable}] \
        [regexp {func [0-9]+ "web::emailish\?"} $nir]
} -match regexp -result {^\{\{guard str %0 "emailish\?" @e[0-9]+\} \{unreachable @e[0-9]+\}\} 0$}

test bridge-param-check-nir-proven {a proven String argument needs no check: no guard names the native} -body {
    set hir [hir::build [hCalls Emailish? {{const str a@b.io}}] -strict 0]
    regexp {guard [a-z]+ %[0-9]+ "emailish\?"} [native::nir $hir]
} -result 0

::tcltest::cleanupTests
