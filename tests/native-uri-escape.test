# native-uri-escape.test -- str::encode_utf8 (core/strings.tcl, general: a
# String's UTF-8 encoding as a List of Int, one per byte) and
# web::uri_escape_text / web::uri_query_value? (lib/web.bot), the ordinary
# Botlish percent-encoding algorithm and the proof-producing predicate of the
# web::UriQueryValue refinement. See NATIVE-URI-ESCAPE.md for the algorithm's
# history and REFINEMENT-VALUES.md for the refinement.
#
# Everything is checked four-way (interp, compile, cranelift-generic,
# cranelift): a refined value is its carrier, so no backend may differ. The
# escaping is also checked against an independent Tcl reference (the former
# lib/web.tcl uriEscape implementation, uriEscapeReference below).

source [file join [file dirname [file normalize [info script]]] helpers.tcl]

set parityBackends {interp compile cranelift-generic cranelift}

proc encodeUtf8Program {s} {
    return [list [list call {ref str::encode_utf8} [list const str $s]]]
}

# S as a Botlish string literal.
proc botString {s} {
    return "\"[string map {\\ \\\\ \" \\\" \n \\n} $s]\""
}

# Percent-encodes every byte of the UTF-8 form of S except the RFC 3986
# unreserved characters: the reference the Botlish algorithm must match.
proc uriEscapeReference {s} {
    set escaped ""
    foreach byte [split [encoding convertto utf-8 $s] ""] {
        if {[regexp {^[A-Za-z0-9._~-]$} $byte]} {
            append escaped $byte
        } else {
            scan $byte %c code
            append escaped [format %%%02X $code]
        }
    }
    return $escaped
}

# The text web::uri_escape_text(S) has on every backend (a Tcl error if they
# disagree, or if it differs from the reference).
proc escapeText {s} {
    set outcome [sourceAgree "import web\nweb::uri_escape_text([botString $s])\n"]
    if {[lindex $outcome 0] ne "value"} {
        error "web::uri_escape_text raised: $outcome"
    }
    set text [string range [lindex $outcome 1] 1 end-1]
    if {$text ne [uriEscapeReference $s]} {
        error "web::uri_escape_text gives $text, the reference [uriEscapeReference $s]"
    }
    return $text
}

# ---------------------------------------------------------------------------
# str::encode_utf8: four-way value parity.

foreach {name s expect} {
    empty        {}      {[]}
    ascii        A       {[65]}
    space        { }     {[32]}
    two-byte     é       {[195, 169]}
    astral       😀      {[240, 159, 152, 128]}
    mixed        {a b}   {[97, 32, 98]}
} {
    test native-uri-escape-utf8-$name "str::encode_utf8($s) agrees across interp/compile/cranelift-generic/cranelift" -body {
        set exprs [encodeUtf8Program $s]
        set shown [lmap b $::parityBackends {lindex [outcomeUnder $b $exprs] 1}]
        if {[llength [lsort -unique $shown]] != 1} {
            error "mismatch across $::parityBackends: $shown"
        }
        lindex $shown 0
    } -result $expect
}

# ---------------------------------------------------------------------------
# web::uri_escape_text: text parity across all four backends and with the
# reference (RFC 3986 unreserved set: A-Za-z0-9._~-; everything else
# percent-encoded, byte by byte).

foreach {name s expect} {
    empty         {}                    {}
    unreserved    a~b_c-d.e             a~b_c-d.e
    space         {a b}                 a%20b
    at-sign       someone@example.com   someone%40example.com
    two-byte      é                     %C3%A9
    astral        😀                    %F0%9F%98%80
    percent-like  {50%}                 50%25
} {
    test native-uri-escape-text-$name "web::uri_escape_text($s) text agrees across interp/compile/cranelift-generic/cranelift" -body {
        escapeText $s
    } -result $expect
}

# ---------------------------------------------------------------------------
# web::uri_query_value?: the structural proposition of web::UriQueryValue --
# unreserved characters and "%XX" triplets of uppercase hex digits only.
# Every escaped text passes; text that is not safe to embed does not.

foreach {name s expect} {
    escaped-space      a%20b          true
    unreserved         a~b_c-d.e      true
    empty              {}             true
    escaped-astral     %F0%9F%98%80   true
    raw-space          {a b}          false
    raw-percent        {50%}          false
    truncated-escape   %2             false
    lowercase-hex      %2f            false
    non-hex            %G0            false
    raw-non-ascii      é              false
    reserved           a&b=c          false
} {
    test native-uri-escape-query-value-$name "web::uri_query_value?($s) is $expect on every backend" -body {
        sourceAgree "import web\nweb::uri_query_value?([botString $s])\n"
    } -result [list value $expect]
}

test native-uri-escape-escaped-is-query-value {web::uri_query_value? accepts what web::uri_escape_text produces, on every backend} -body {
    sourceAgree {import web

texts = ["", "a b", "someone@example.com", "é", "😀", "50%", "a&b=c", "déjà vu"]
loop t in texts:
    web::uri_query_value?(web::uri_escape_text(t))
}
} -result {value {[true, true, true, true, true, true, true, true]}}

test native-uri-escape-query-value-repeatable {web::uri_query_value? is proven repeatable} -body {
    set hir [surface::compile "import web\nweb::uri_query_value?(\"a\")\n" -warnings off]
    set binding [hir::get $hir [lindex [hirFind $hir ref web::uri_query_value?] 0] binding]
    hir::repeatable::explain $hir [hir::get $hir [dict get [hir::binding $hir $binding] declaredBy] value]
} -result {}

# ---------------------------------------------------------------------------
# GC stress: str::encode_utf8 and the escaping both allocate on the native
# backend (a List, and a chain of Strings/Lists respectively).

test native-uri-escape-gc-stress {web::uri_escape_text survives a collection forced before every allocation} -body {
    set ::env(BOTLISH_NATIVE_GC_STRESS) 1
    try {
        lrange [outcomeUnderHir cranelift [surface::compile "import web\nweb::uri_query_value?(web::uri_escape_text(\"a b c déjà vu 😀\"))\n" -warnings off]] 0 1
    } finally {
        unset ::env(BOTLISH_NATIVE_GC_STRESS)
    }
} -result {value true}

::tcltest::cleanupTests
