    set how [hir::cabi::VariadicArgument {refined int {std::ffi::c::Int std::ffi::c::Long}}]
    list [dict get $how problem] [dict get $how message]
} -cleanup removeApps -result {TYPE {its C type is ambiguous: the value is proven a std::ffi::c::Int and a std::ffi::c::Long at once, and a trailing argument is passed as exactly one C type -- convert it to the one the callee reads (a function whose declared result is that type)}}

test cf-va-strict0-replay {an unchecked (-strict 0) program's trailing argument with no C type replays its refusal on the native backends, the C call never made} -constraints cfFixture -body {
    set dir [bcfApp "import std::ffi::c\nimport bcf\n\nbcf::vsum(1, \"five\")\n"]
    set hir [appHir $dir main.bot 0]
    native::withLinkDirs [fixtureDirs] {
        lmap backend {interp compile cranelift cranelift-generic} {
            lassign [outcomeUnderHir $backend $hir] tag code message
