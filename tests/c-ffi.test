# c-ffi.test -- `extern c library` and `extern c fn`: real link-time C calls
# (C-FFI.md).
#
# An extern c fn is a truthful C ABI declaration with no body, carrying the
# foreign call contract every foreign call has (C-POINTER-BORROWING.md); an
# extern c library names a library of the program's link plan. The native
# backends link a program that calls C with the system linker and call the
# symbols directly with the platform C ABI; the Tcl backends refuse a C call
# at run time (NATIVE-ONLY).
#
# The C side of most tests is tests/cffi/fixture.c, compiled here with the
# host's C toolchain (tests/ctoolchain.tcl: GCC or Clang on Linux, Apple clang
# on macOS, MSVC's cl -- with ml64 for its Win64 assembly,
# tests/cffi/fixture-win64.asm -- on Windows) into a static library in a
# private directory (test infrastructure only) and bound by the module text
# below. The Tcl and BoringSSL acceptance tests run examples/ffi/
# against the installed libtcl9.0 and the package-owned static BoringSSL
# (tests/cffi/boringssl.tcl; skipped when it is not built). Every
# application is a fresh directory of the tcltest temporary directory.
#
# C calls run on every host the native backend links them on (nativeCCalls:
# Linux x86-64 and AArch64, macOS AArch64, Windows x86-64). What differs by
# target is the target's own C ABI, which the tests below model from the ABI
# documents (`::abi`) -- plain char's signedness, the width of long, how many
# arguments go in registers and whether by kind or by position, how stack
# arguments are laid out and where they start, which bits of a narrow
# argument the caller defines -- and check against the machine state a call
# arrives in and against calls the C compiler makes itself
# (MACOS-AARCH64-MILESTONE-6.md, WINDOWS-X86-64-MILESTONE-2.md). Variadic
# calls are lowered for the System V, Apple and Win64 conventions
# (nativeCVariadics; WINDOWS-X86-64-MILESTONE-6.md for Win64's, whose
# floating-point arguments of the first four positions are in both of their
# position's registers).

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]
source [file join $::projectRoot native native.tcl]
source [file join $::projectRoot tests cffi boringssl.tcl]

testConstraint nativeBuilt [expr {![catch {native::binary}]}]
testConstraint cCompiler [testConstraint cToolchain]
testConstraint linuxX86_64 [expr {$::tcl_platform(os) eq "Linux" && $::tcl_platform(machine) in {x86_64 amd64}}]
set ::hostTarget [core::cabi::hostTarget]
# The host compiles C with Apple clang for macOS, whose __builtin_available
# a C library may use (cf-availability-check).
testConstraint appleAvailability [expr {$::hostTarget eq "macos-aarch64" && [testConstraint nativeCCalls]}]

set mainScript [file join $::projectRoot main.tcl]
set ::appCounter 0

# The fixture library: built once, in a private directory, when a C compiler
# is there.
set ::windowsHost [expr {$::tcl_platform(platform) eq "windows"}]
testConstraint windowsHost $::windowsHost
set ::fixtureDir ""
if {[testConstraint cCompiler] && [testConstraint nativeCCalls]} {
    set ::fixtureDir [makeDirectory cffi-fixture-[pid]]
    if {[catch {
        set sources [list [file join $::projectRoot tests cffi fixture.c]]
        if {$::windowsHost} {
            lappend sources [file join $::projectRoot tests cffi fixture-win64.asm]
        }
        ctool::staticLibrary $::fixtureDir botlish_cffi_fixture {*}$sources
        # A second library that depends on the first (cf-link-order).
        set channel [open [file join $::fixtureDir dependent.c] w]
        puts $channel "int bcf_add(int a, int b);\nint bcf_add_twice(int a, int b) { return 2 * bcf_add(a, b); }"
        close $channel
        ctool::staticLibrary $::fixtureDir botlish_cffi_dependent [file join $::fixtureDir dependent.c]
    } message]} {
        puts stderr "c-ffi.test: the fixture library did not build: $message"
        set ::fixtureDir ""
    }
}
testConstraint cfFixture [expr {$::fixtureDir ne "" && [testConstraint nativeBuilt] && [testConstraint cLinker]}]
# The link directories of a test's links, for native::withLinkDirs: the
# fixture's, or none when it did not build. A test that needs no fixture
# (cf-system-library) still links then, and an empty directory is no
# directory (cf-link-directory-empty).
proc fixtureDirs {} {
    if {$::fixtureDir eq ""} {
        return {}
    }
    return [list $::fixtureDir]
}
# libtcl9.0, as the Tcl acceptance links it: a probe link with the host's
# linker driver.
proc tclLinkable {} {
    if {![testConstraint cCompiler]} {
        return 0
    }
    set dir [makeDirectory cffi-tclprobe-[pid]]
    set src [file join $dir probe.c]
    set channel [open $src w]
    puts $channel "void *Tcl_CreateInterp(void);\nint main(void) { return Tcl_CreateInterp() == 0; }"
    close $channel
    set ok [expr {[auto_execok cc] ne "" && ![catch {exec cc $src -o [file join $dir probe] -ltcl9.0}]}]
    file delete -force $dir
    return $ok
}
testConstraint tclLibrary [expr {[testConstraint nativeBuilt] && [testConstraint cLinker] && [tclLinkable]}]
testConstraint boringssl [expr {[testConstraint nativeBuilt] && [testConstraint cLinker] && [cffi::boringsslDir] ne ""}]

# The C calling convention a foreign call is compiled with on this host: the
# driver's reading of the host target's triple (system_v on Linux,
# apple_aarch64 on macOS arm64).
set ::cConvention [expr {[testConstraint nativeBuilt] && $::hostTarget ne ""
    ? [dict get [native::targetFacts [dict get [core::cabi::target $::hostTarget] triple]] c-call-conv] : "none"}]

# The host target's C ABI as these tests model it, from the platform ABI
# documents (the SysV x86-64 psABI, AAPCS64, Apple's "Writing ARM64 code for
# Apple platforms", Microsoft's "x64 calling convention") -- never from
# core::cabi or the compiler:
#
#   registers  argument registers: six integer ones on x86-64 System V,
#              eight on AArch64; four positions on Win64
#   positional 1 when a parameter's register is its position's, whatever its
#              kind (Win64: the first four parameters in rcx, rdx, r8, r9 or
#              xmm0-xmm3 by position, a double's integer register unused);
#              0 when integer and floating-point registers are counted apart
#              (System V, AAPCS64: doubles in v0-v7 or xmm0-xmm7)
#   stack      how stack arguments are laid out: `natural` (Apple: each at its
#              natural size and alignment, packed: a char one byte) or
#              `slot8` (each in its own 8-byte slot)
#   base       where the first stack argument is, from the stack pointer at
#              the call: 0, or Win64's 32 (the caller's shadow space for the
#              four register parameters comes first)
#   extended   how many low bits of a narrow argument's register the caller
#              defines: 32 (extended to 32 bits by its type: Apple's rule,
#              and x86-64 System V's as GCC and Clang callers make it and
#              their callees read it), or 0 (only the argument's own width:
#              AAPCS64 and Win64, whose callee extends -- MSVC's callees do)
#   floats     the floating-point argument registers bcf_capture records:
#              Win64's four (xmm0-xmm3); none elsewhere, where a double's
#              register is not observed and only its integers' places are
#   long       the bytes of a C long: 8 on LP64, 4 on LLP64 (Windows)
switch -- $::hostTarget {
    macos-aarch64 { set ::abi {registers 8 positional 0 stack natural base 0 extended 32 floats 0 long 8} }
    linux-aarch64 { set ::abi {registers 8 positional 0 stack slot8 base 0 extended 0 floats 0 long 8} }
    windows-x86_64 { set ::abi {registers 4 positional 1 stack slot8 base 32 extended 0 floats 4 long 4} }
    default { set ::abi {registers 6 positional 0 stack slot8 base 0 extended 32 floats 0 long 8} }
}
# A C long's range on this host's target, for the values the tests pass.
set ::cfLongBits [expr {8 * [dict get $::abi long]}]
set ::cfLongMin [expr {-(1 << ($::cfLongBits - 1))}]
set ::cfLongMax [expr {(1 << ($::cfLongBits - 1)) - 1}]
set ::cfULongMax [expr {(1 << $::cfLongBits) - 1}]
# The Cranelift type of a C long in a foreign signature, and its ABI class.
set ::cfLongClif [expr {$::cfLongBits == 64 ? "i64" : "i32"}]
set ::cfULongClass [expr {$::cfLongBits == 64 ? "u64" : "u32"}]

# The C types the ABI tests pass: Botlish name -> {bytes signed}, plain char
# at the host target's signedness (cfCharRange, below), a long at the
# target's width; a Double {8 f}.
proc cType {name} {
    switch -- $name {
        SChar { return {1 1} }
        UChar - Bool { return {1 0} }
        Char { return [list 1 [expr {[lindex $::cfCharRange 0] < 0}]] }
        Short { return {2 1} }
        UShort { return {2 0} }
        Int { return {4 1} }
        UInt { return {4 0} }
        Long { return [list [dict get $::abi long] 1] }
        ULong { return [list [dict get $::abi long] 0] }
        LongLong { return {8 1} }
        ULongLong - Ptr { return {8 0} }
        Double { return {8 f} }
    }
    error "no C type $name"
}

# Where the parameters of C types TYPES arrive under ::abi: {reg N}, {freg
# N} or {stack OFFSET} each, OFFSET from the stack pointer at the call.
proc abiLocations {types} {
    set out {}
    set reg 0
    set freg 0
    set position 0
    set next [dict get $::abi base]
    foreach type $types {
        set size [lindex [cType $type] 0]
        set double [expr {$type eq "Double"}]
        if {[dict get $::abi positional]} {
            if {$position < [dict get $::abi registers]} {
                lappend out [list [expr {$double ? "freg" : "reg"}] $position]
                incr position
                continue
            }
            incr position
        } elseif {$double && $freg < 8} {
            lappend out [list freg $freg]
            incr freg
            continue
        } elseif {!$double && $reg < [dict get $::abi registers]} {
            lappend out [list reg $reg]
            incr reg
            continue
        }
        if {[dict get $::abi stack] eq "natural"} {
            set offset [expr {($next + $size - 1) / $size * $size}]
            set next [expr {$offset + $size}]
        } else {
            set offset $next
            incr next 8
        }
        lappend out [list stack $offset]
    }
    return $out
}

# The 64 bits a C argument of type TYPE and VALUE is (a double's IEEE bits).
proc abiBits {type value} {
    if {$type eq "Double"} {
        binary scan [binary format d $value] w bits
        return [expr {$bits & 0xffffffffffffffff}]
    }
    return [expr {$value & 0xffffffffffffffff}]
}

# The mismatches between what a call of C types TYPES with VALUES arrived in
# -- REGS (each integer register's low 32 bits), STACK (the bytes at the
# stack pointer) and FREGS (the floating-point registers' 64 bits, those
# ::abi's floats says the capture records) -- and ::abi: in an integer
# register, the low 32 bits (`extended` 32) or the argument's own width, as
# its value extended by its type; in a floating-point register, the double's
# 64 bits; on the stack, the argument's own bytes at its offset,
# little-endian. Bytes and bits the ABI leaves undefined (padding, the rest
# of a slot or a register) are not read, nor a register the capture does not
# record. Empty when everything matches.
proc abiMismatches {who types values regs stack {fregs {}}} {
    set mismatches {}
    foreach type $types value $values location [abiLocations $types] {
        lassign [cType $type] size
        lassign $location where at
        set bits [abiBits $type $value]
        if {$where eq "reg"} {
            set width [expr {$size < 4 && [dict get $::abi extended] == 32 ? 32 : min(8 * $size, 32)}]
            set expected [expr {$bits & ((1 << $width) - 1)}]
            set observed [expr {[lindex $regs $at] & ((1 << $width) - 1)}]
        } elseif {$where eq "freg"} {
            if {$at >= [dict get $::abi floats]} {
                continue
            }
            set expected $bits
            set observed [lindex $fregs $at]
        } else {
            set expected [lmap i [lrange {0 1 2 3 4 5 6 7} 0 $size-1] {expr {($bits >> (8 * $i)) & 0xff}}]
            set observed [lrange $stack $at [expr {$at + $size - 1}]]
        }
        if {$expected != $observed} {
            lappend mismatches [list $who $type $value $location expected $expected observed $observed]
        }
    }
    return $mismatches
}

# A Botlish list display (of Ints and lists of them) as a Tcl list.
proc botlishList {text} {
    return [lindex [string map {[ "{" ] "}" , ""} $text] 0]
}

# The dynamic libraries executable EXE loads, as the host's tools list them:
# otool -L on macOS, ldd on Linux; on Windows the DLLs of its PE import
# directory (tests/binary-header.tcl's peFacts).
proc dynamicLibraries {exe} {
    if {$::tcl_platform(os) eq "Darwin"} {
        return [exec otool -L $exe]
    }
    if {$::windowsHost} {
        return [join [dict get [peFacts $exe] imports] \n]
    }
    return [exec ldd $exe]
}

# The file of the fixture's static library NAME in DIR (libNAME.a, NAME.lib).
proc fixtureLibrary {name {dir ""}} {
    return [file join [expr {$dir eq "" ? $::fixtureDir : $dir}] [ctool::staticName $name]]
}


# A fresh application directory holding FILES ({RELATIVE-PATH TEXT ...}): its
# absolute path.
proc app {files} {
    set dir [makeDirectory cf-app-[pid]-[incr ::appCounter]]
    foreach {relative text} $files {
        set path [file join $dir {*}[file split $relative]]
        file mkdir [file dirname $path]
        set channel [open $path w]
        fconfigure $channel -encoding utf-8 -translation lf
        puts -nonewline $channel $text
        close $channel
    }
    return $dir
}

proc removeApps {} {
    foreach dir [glob -nocomplain -directory [temporaryDirectory] cf-app-[pid]-*] {
        file delete -force $dir
    }
}

# The HIR of DIR/MAIN (strict unless STRICT is 0).
proc appHir {dir {main main.bot} {strict 1}} {
    return [surface::readProgramFile [file join $dir $main] -warnings off -cache "" -strict $strict]
}

# "KIND: MESSAGE" of the compilation of DIR/MAIN, with DIR spelled away, or
# accepted.
proc appRejection {dir {main main.bot}} {
    if {[catch {appHir $dir $main} message options]} {
        set kind [lindex [dict get $options -errorcode] end]
        return "$kind: [string map [list $dir/ ""] $message]"
    }
    return accepted
}

# The value of DIR/MAIN on each of BACKENDS (with the fixture's directory, if
# it built, on the linker's search path), or the backend's error: {CODE
# MESSAGE} with DIR spelled away.
proc appValues {dir backends {main main.bot}} {
    set hir [appHir $dir $main]
    native::withLinkDirs [fixtureDirs] {
        lmap backend $backends {
            lassign [outcomeUnderHir $backend $hir] tag value message
            expr {$tag eq "value" ? $value : [list [lrange $value end-1 end] [string map [list $dir/ ""] $message]]}
        }
    }
}

# The error code's last words of DIR/MAIN on BACKEND, or its value.
proc appCode {dir backend {main main.bot}} {
    set hir [appHir $dir $main]
    native::withLinkDirs [fixtureDirs] {
        lassign [outcomeUnderHir $backend $hir] tag value
    }
    return [expr {$tag eq "value" ? $value : [lrange $value end-1 end]}]
}

# {UNIT STATUS ...} of HIR's module directness, for UNITS (all when empty).
proc statuses {hir {units {}}} {
    set result {}
    dict for {unit u} [dict get $hir direct units] {
        if {$units ne {} && $unit ni $units} continue
        lappend result $unit [dict get $u status]
    }
    return $result
}

# The NIR of DIR/MAIN.
proc appNir {dir {main main.bot}} {
    return [native::nir [appHir $dir $main]]
}

# The fixture's binding module (an application module `bcf`).
set bcfModule {import std::ffi::c

extern c library "botlish_cffi_fixture"

extern c fn echo_schar named "bcf_echo_schar"(x: std::ffi::c::SChar) -> std::ffi::c::SChar
extern c fn echo_uchar named "bcf_echo_uchar"(x: std::ffi::c::UChar) -> std::ffi::c::UChar
extern c fn echo_char named "bcf_echo_char"(x: std::ffi::c::Char) -> std::ffi::c::Char
extern c fn echo_short named "bcf_echo_short"(x: std::ffi::c::Short) -> std::ffi::c::Short
extern c fn echo_ushort named "bcf_echo_ushort"(x: std::ffi::c::UShort) -> std::ffi::c::UShort
extern c fn echo_int named "bcf_echo_int"(x: std::ffi::c::Int) -> std::ffi::c::Int
extern c fn echo_uint named "bcf_echo_uint"(x: std::ffi::c::UInt) -> std::ffi::c::UInt
extern c fn echo_long named "bcf_echo_long"(x: std::ffi::c::Long) -> std::ffi::c::Long
extern c fn echo_ulong named "bcf_echo_ulong"(x: std::ffi::c::ULong) -> std::ffi::c::ULong
extern c fn echo_longlong named "bcf_echo_longlong"(x: std::ffi::c::LongLong) -> std::ffi::c::LongLong
extern c fn echo_ulonglong named "bcf_echo_ulonglong"(x: std::ffi::c::ULongLong) -> std::ffi::c::ULongLong
extern c fn widen_schar named "bcf_widen_schar"(x: std::ffi::c::SChar) -> std::ffi::c::Long
extern c fn widen_uchar named "bcf_widen_uchar"(x: std::ffi::c::UChar) -> std::ffi::c::Long
extern c fn widen_short named "bcf_widen_short"(x: std::ffi::c::Short) -> std::ffi::c::Long
extern c fn widen_ushort named "bcf_widen_ushort"(x: std::ffi::c::UShort) -> std::ffi::c::Long
extern c fn widen_int named "bcf_widen_int"(x: std::ffi::c::Int) -> std::ffi::c::LongLong
extern c fn widen_uint named "bcf_widen_uint"(x: std::ffi::c::UInt) -> std::ffi::c::ULongLong
extern c fn widen_char named "bcf_widen_char"(x: std::ffi::c::Char) -> std::ffi::c::Long
extern c fn add named "bcf_add"(a: std::ffi::c::Int, b: std::ffi::c::Int) -> std::ffi::c::Int
extern c fn many named "bcf_many"(a: std::ffi::c::Long, b: std::ffi::c::Int, c: std::ffi::c::Short, d: std::ffi::c::SChar, e: std::ffi::c::UChar, f: std::ffi::c::UShort, g: std::ffi::c::UInt, h: std::ffi::c::ULong, i: std::ffi::c::Long, j: std::ffi::c::Int) -> std::ffi::c::LongLong
extern c fn tenth named "bcf_tenth"(a: std::ffi::c::Int, b: std::ffi::c::Int, c: std::ffi::c::Int, d: std::ffi::c::Int, e: std::ffi::c::Int, f: std::ffi::c::Int, g: std::ffi::c::Int, h: std::ffi::c::Int, i: std::ffi::c::Int, j: std::ffi::c::Int) -> std::ffi::c::Int
extern c fn nothing named "bcf_nothing"() -> unit
extern c fn dirty_uchar named "bcf_dirty_uchar"() -> std::ffi::c::UChar
extern c fn dirty_schar named "bcf_dirty_schar"() -> std::ffi::c::SChar
extern c fn dirty_ushort named "bcf_dirty_ushort"() -> std::ffi::c::UShort
extern c fn dirty_short named "bcf_dirty_short"() -> std::ffi::c::Short
extern c fn dirty_uint named "bcf_dirty_uint"() -> std::ffi::c::UInt
extern c fn dirty_int named "bcf_dirty_int"() -> std::ffi::c::Int
extern c fn address named "bcf_address"() -> std::ffi::c::Ptr[std::ffi::c::Void] independent
extern c fn null named "bcf_null"() -> std::ffi::c::Ptr[std::ffi::c::Void] independent
extern c fn is_null named "bcf_is_null"(p: std::ffi::c::Ptr[std::ffi::c::Void] noescape) -> std::ffi::c::Int
extern c fn echo_ptr named "bcf_echo_ptr"(p: std::ffi::c::Ptr[std::ffi::c::Void] noescape) -> std::ffi::c::Ptr[std::ffi::c::Void] alias p
extern c fn same named "bcf_same"(a: std::ffi::c::Ptr[std::ffi::c::Void] noescape, b: std::ffi::c::Ptr[std::ffi::c::Void] noescape) -> std::ffi::c::Int
extern c fn wild named "bcf_wild"() -> std::ffi::c::Ptr[std::ffi::c::Void]
extern c fn sum named "bcf_sum"(data: std::ffi::c::Ptr[std::ffi::c::UChar] read noescape, count: std::ffi::c::ULong) -> std::ffi::c::ULong
extern c fn sum_proven named "bcf_sum"(data: std::ffi::c::Ptr[std::ffi::c::UChar] read proven noescape, count: std::ffi::c::ULong) -> std::ffi::c::ULong
extern c fn fill named "bcf_fill"(out: std::ffi::c::Ptr[std::ffi::c::UChar] write noescape, count: std::ffi::c::ULong, seed: std::ffi::c::UChar) -> unit
extern c fn reverse named "bcf_reverse"(data: std::ffi::c::Ptr[std::ffi::c::UChar] read noescape, count: std::ffi::c::ULong, out: std::ffi::c::Ptr[std::ffi::c::UChar] write noescape) -> std::ffi::c::Ptr[std::ffi::c::UChar] alias out
extern c fn reverse_off named "bcf_reverse_off"(data: std::ffi::c::Ptr[std::ffi::c::UChar] read noescape, count: std::ffi::c::ULong, out: std::ffi::c::Ptr[std::ffi::c::UChar] write noescape) -> std::ffi::c::Ptr[std::ffi::c::UChar] alias out
extern c fn find named "bcf_find"(data: std::ffi::c::Ptr[std::ffi::c::UChar] read noescape, count: std::ffi::c::ULong, byte: std::ffi::c::UChar) -> std::ffi::c::Ptr[std::ffi::c::UChar]
extern c fn next named "bcf_next"(p: std::ffi::c::Ptr[std::ffi::c::UChar] noescape) -> std::ffi::c::Ptr[std::ffi::c::UChar] alias p
extern c fn callback_twice named "bcf_callback_twice"() -> std::ffi::c::FnPtr[Fn{args: [std::ffi::c::Int], return: std::ffi::c::Int}]
extern c fn apply named "bcf_apply"(f: std::ffi::c::FnPtr[Fn{args: [std::ffi::c::Int], return: std::ffi::c::Int}] noescape, x: std::ffi::c::Int) -> std::ffi::c::Int
extern c fn count named "bcf_count"() -> std::ffi::c::ULong
extern c fn echo_bool named "bcf_echo_bool"(x: std::ffi::c::Bool) -> std::ffi::c::Bool
extern c fn bool_false named "bcf_bool_false"() -> std::ffi::c::Bool
extern c fn bool_true named "bcf_bool_true"() -> std::ffi::c::Bool
extern c fn observe_bool named "bcf_observe_bool"(x: std::ffi::c::Bool) -> std::ffi::c::Int
extern c fn negate named "bcf_not"(x: std::ffi::c::Bool) -> std::ffi::c::Bool
extern c fn is_positive named "bcf_is_positive"(x: std::ffi::c::Int) -> std::ffi::c::Bool
extern c fn bool_args named "bcf_bool_args"(a: std::ffi::c::Bool, b: std::ffi::c::Int, c: std::ffi::c::Bool) -> std::ffi::c::Int
extern c fn bool_stack named "bcf_bool_stack"(a: std::ffi::c::Long, b: std::ffi::c::Long, c: std::ffi::c::Long, d: std::ffi::c::Long, e: std::ffi::c::Long, f: std::ffi::c::Long, g: std::ffi::c::Long, h: std::ffi::c::Long, i: std::ffi::c::Bool, j: std::ffi::c::Bool) -> std::ffi::c::Int
extern c fn bool_register named "bcf_bool_register"(x: std::ffi::c::Bool) -> std::ffi::c::UInt
extern c fn dirty_bool_true named "bcf_dirty_bool_true"() -> std::ffi::c::Bool
extern c fn dirty_bool_false named "bcf_dirty_bool_false"() -> std::ffi::c::Bool
extern c fn invalid_bool named "bcf_invalid_bool"() -> std::ffi::c::Bool
extern c fn echo_bool_ptr named "bcf_echo_bool_ptr"(p: std::ffi::c::Ptr[std::ffi::c::Bool] noescape) -> std::ffi::c::Ptr[std::ffi::c::Bool] alias p
