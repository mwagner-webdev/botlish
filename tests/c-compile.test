# c-compile.test -- the C backend (ccompile/ccompile.tcl, main.tcl -emit-c;
# C-COMPILE-FREESTANDING-MILESTONE-1.md).
#
# Every parity test compiles one Botlish program to C, builds it with the
# host's C compilers under strict diagnostics (-std=c11 -pedantic -Wall
# -Wextra -Werror ...), runs it through the hosted harness
# (examples/c-freestanding/harness/host_main.c) and requires the line it
# prints -- "value: TEXT" or "error: MESSAGE (CODE)" -- to equal what the
# interpreter, the Tcl compiler and (when built) the native backend give the
# same HIR. The other tests check the runtime-service boundary itself: that
# a program needing a service compiles, fails to link without a provider
# (naming the service's symbol), links and runs with one; that the manifest
# lists exactly the services the C references; that a program needing none
# builds with no C library at all; and that what the backend cannot
# translate is C UNSUPPORTED at compile time, never a link error.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
if {[info commands ::surface::compile] eq ""} {
    source [file join $::projectRoot surface surface.tcl]
}
source [file join $::projectRoot ccompile ccompile.tcl]

testConstraint nativeBuilt [expr {![catch {native::binary}]}]
testConstraint gcc [expr {$::tcl_platform(platform) eq "unix" && [auto_execok gcc] ne ""}]
testConstraint clang [expr {$::tcl_platform(platform) eq "unix" && [auto_execok clang] ne ""}]
testConstraint hostCC [expr {[testConstraint gcc] || [testConstraint clang]}]
testConstraint nm [expr {[auto_execok nm] ne ""}]
testConstraint llvmNm [expr {[auto_execok llvm-nm] ne ""}]
testConstraint linuxX86_64 [expr {$::tcl_platform(os) eq "Linux" && $::tcl_platform(machine) in {x86_64 amd64}}]

set ::ccHarness [file join $::projectRoot examples c-freestanding harness]
set ::ccProviders [file join $::projectRoot examples c-freestanding providers]
set ::ccStrict {-std=c11 -pedantic-errors -Wall -Wextra -Werror -Wshadow -Wstrict-prototypes
    -Wmissing-prototypes -Wconversion -Wsign-conversion -Wcast-qual -Wundef}
set ::ccCompilers [lmap c {gcc clang} {expr {[testConstraint $c] ? $c : [continue]}}]
set ::ccCount 0

# A private directory in the tcltest temporary directory.
proc ccDir {} {
    return [makeDirectory cc-[incr ::ccCount]]
}

# The C translation of the Botlish source SOURCE as program PREFIX, written
# into a fresh directory: {dir DIR prefix PREFIX out OUT}.
proc ccGenerate {source {prefix prog}} {
    set hir [surface::compile $source -warnings off]
    set out [ccompile::program $hir -prefix $prefix -source $prefix.bot]
    set dir [ccDir]
    ccompile::write $out $dir
    return [dict create dir $dir prefix $prefix out $out]
}

# Runs COMMAND (a list); returns {STATUS OUTPUT} (stdout and stderr).
proc ccExec {command} {
    set status [catch {exec {*}$command 2>@1} output options]
    if {$status} {
        # (exec appends this line to the output of a command that failed.)
        regsub {\n?child process exited abnormally$} $output "" output
        set code [dict get $options -errorcode]
        if {[lindex $code 0] eq "CHILDSTATUS"} {
            return [list [lindex $code 2] $output]
        }
        return [list -1 $output]
    }
    return [list 0 $output]
}

# Builds GEN (ccGenerate's) with the hosted harness, its display unit and
# PROVIDERS (C files), by COMPILER at OPT under the strict flags (EXTRA
# appended); returns the executable's path, or raises with the compiler's
# output.
proc ccBuild {gen {compiler gcc} {providers {}} {opt -O1} {extra {}}} {
    set dir [dict get $gen dir]
    set p [dict get $gen prefix]
    set exe [file join $dir $p.$compiler[string map {- ""} $opt]]
    set command [list $compiler {*}$::ccStrict $opt -DBOTLISH_PROGRAM=$p "-DBOTLISH_PROGRAM_HEADER=\"$p.h\"" \
        -I $dir -I [file join $::projectRoot ccompile] {*}$extra \
        [file join $::ccHarness host_main.c] [file join $dir $p.c] [file join $dir ${p}_display.c] \
        {*}$providers -o $exe]
    lassign [ccExec $command] status output
    if {$status != 0} {
        error "C build failed ($compiler $opt):\n$output"
    }
    return $exe
}

# The line the harness printed running EXE.
proc ccRun {exe} {
    lassign [ccExec [list $exe]] status output
    return [string trim $output]
}

# What every other backend gives SOURCE, as the harness prints it: "value:
# TEXT" (core::value::show's development view, as main.tcl prints it) or
# "error: MESSAGE (CODE)" -- or a Tcl error naming each when they disagree.
proc ccReference {source {backends {interp compile cranelift}}} {
    return [ccReferenceOf [surface::compile $source -warnings off] $backends]
}

# The same, for the analyzed HIR program HIR (a program file with modules).
proc ccReferenceOf {hir {backends {interp compile cranelift}}} {
    set lines {}
    foreach backend $backends {
        if {$backend eq "cranelift" && ![testConstraint nativeBuilt]} continue
        set script [dict get {
            interp    {core::evalProgram [hir::lower $hir]}
            compile   {core::compiler::evalHir $hir}
            cranelift {native::evalHir $hir}
        } $backend]
        if {[catch $script value options]} {
            lappend lines [list $backend "error: $value ([dict get $options -errorcode])"]
        } else {
            lappend lines [list $backend "value: [core::value::show $value 1]"]
        }
    }
    if {[llength [lsort -unique [lmap l $lines {lindex $l 1}]]] != 1} {
        error "the backends disagree: $lines"
    }
    return [lindex $lines 0 1]
}

# The C backend's outcome of SOURCE under each available compiler (with the
# reference Int provider), followed by the reference's -- a list whose
# elements must all be equal.
proc ccParity {source {backends {interp compile cranelift}}} {
    set gen [ccGenerate $source]
    set provider [file join $::ccProviders botlish_rt_v1_int_arena.c]
    set results {}
    foreach compiler $::ccCompilers {
        foreach opt {-O0 -O2} {
            lappend results [ccRun [ccBuild $gen $compiler [list $provider] $opt]]
        }
    }
    lappend results [ccReference $source $backends]
    return [lsort -unique $results]
}

# ---------------------------------------------------------------------------
# The corpus: one program per area, each compared with every other backend.

set ::ccCorpus [dict create]

dict set ::ccCorpus recursion {
fn fib(n: int) -> int:
    if n < 2:
        n
    else:
        fib(n - 1) + fib(n - 2)

fn gcd(a: int, b: int) -> int:
    if b == 0:
        a
    else:
        gcd(b, mod(a, b))

fn fact(n: int) -> int:
    if n <= 1:
        1
    else:
        n * fact(n - 1)

[fib(20), gcd(1071, 462), fact(20), fact(25)]
}

dict set ::ccCorpus loops {
fn up_ex(n: int) -> int:
    fold i from 0 to n with intermediate s 0:
        s + i

fn up_in(n: int) -> int:
    fold i from 1 through n with intermediate s 1:
        s * 2 + i

fn down_ex(n: int) -> int:
    fold i down from n to 0 with intermediate s 0:
        if i == 3:
            continue
        s + i

fn down_in(n: int) -> int:
    fold i down from n through -2 with intermediate s 0:
        if i == -1:
            break
        s * 10 + mod(i, 10)

fn first_square_over(limit: int) -> int:
    fold with intermediate k 0:
        if k * k > limit:
            break
        k + 1

fn empty(n: int) -> int:
    fold i from n to 0 with intermediate s 42:
        s + i

fn counted(n: int) -> int:
    loop i from 0 to n:
        if i == 2:
            return i * 100
        i
    -1

fn forever(n: int) -> int:
    loop:
        if n > 0:
            return n
    0

[up_ex(10), up_in(5), down_ex(6), down_in(4), first_square_over(1000), empty(3), up_ex(0), up_in(70), counted(5), counted(1), forever(9)]
}

dict set ::ccCorpus errors {
error TooBig
error Odd

fn check(n: int) -> int errors TooBig, Odd:
    if n > 100:
        fail TooBig
    if mod(n, 2) == 1:
        fail Odd
    n

fn relay(n: int) -> int errors TooBig, Odd:
    check(n) * 2

fn classify(n: int) -> int:
    r = relay(n):
        on TooBig:
            -1
        on Odd:
            relay(n + 1):
                on TooBig:
                    -2
                on Odd:
                    -3
    r

fn quiet(n: int) -> bool:
    r = relay(n):
        on TooBig:
            0
        on Odd:
            1
    r > 50

[classify(4), classify(7), classify(101), classify(100), classify(99), quiet(3), quiet(1000)]
}

dict set ::ccCorpus bounds {
fn add(a: int, b: int) -> int:
    a + b

fn mul(a: int, b: int) -> int:
    a * b

fn sub(a: int, b: int) -> int:
    a - b

fn cmp(a: int, b: int) -> bool:
    a < b

max = 9223372036854775807
min = -9223372036854775808
[add(max, 1), sub(min, 1), mul(max, max), mul(min, -1), add(min, max), mod(min, -1), mod(-7, 3), mod(7, -3), mod(min, 7), mod(max, min), cmp(max + 1, max), 100000000000000000000000 * 3, mod(100000000000000000000000, -7), mod(-100000000000000000000000, 7), mul(4294967296, 4294967296), mul(-4294967296, 2147483648), mul(3037000499, 3037000499), mul(3037000500, 3037000500), -9223372036854775809 + 1, max + 1 == min - 1, sub(mul(max, 2), max) == max]
}

dict set ::ccCorpus domains {
type Byte = Int in 0..255

fn mix(a: Byte, b: Byte) -> int:
    bit_xor(bit_and(a, 15), shift_left(bit_or(a, b), 3))

fn halve(x: int) -> int:
    shift_right(x, 1)

fn far(x: Byte, k: int) -> int:
    shift_right(x - 128, k)

[mix(200, 7), mix(255, 255), halve(-7), halve(7), halve(-9223372036854775807), far(3, 2), far(3, 100), far(200, 0), bit_and(-6, 3), bit_or(-8, 3), bit_xor(-1, 5)]
}

dict set ::ccCorpus statics {
struct Config:
    base: int
    enabled: bool

limit = 7 * 6
config = Config {base: 1000, enabled: true}

fn scaled(n: int) -> int:
    if config.enabled:
        n * config.base + limit
    else:
        n

fn countdown(n: int, acc: int) -> int:
    if n == 0:
        return acc
    countdown(n - 1, acc + 1)

[scaled(3), countdown(100, 0), limit]
}

dict set ::ccCorpus structs {
enum Dir:
    North,
    East,
    South,
    West

struct Pos:
    x: int
    y: int

struct Robot:
    at: Pos
    facing: Dir

fn turn(d: Dir) -> Dir:
    if d == Dir::North:
        Dir::East
    elif d == Dir::East:
        Dir::South
    elif d == Dir::South:
        Dir::West
    else:
        Dir::North

fn step(r: Robot) -> Robot:
    p = r.at
    np = if r.facing == Dir::North:
        Pos {x: p.x, y: p.y + 1}
    elif r.facing == Dir::East:
        Pos {x: p.x + 1, y: p.y}
    elif r.facing == Dir::South:
        Pos {x: p.x, y: p.y - 1}
    else:
        Pos {x: p.x - 1, y: p.y}
    Robot {at: np, facing: r.facing}

fn walk(r: Robot, n: int) -> Robot:
    fold i from 0 to n with intermediate cur r:
        moved = step(cur)
        if mod(i, 3) == 2:
            Robot {at: moved.at, facing: turn(moved.facing)}
        else:
            moved

end = walk(Robot {at: Pos {x: 0, y: 0}, facing: Dir::North}, 10)
[end, end.facing == Dir::East, {sum: end.at.x + end.at.y, u: unit}, Dir::West == Dir::West, 3 == true, [], {}, true == false, unit == unit]
}

dict set ::ccCorpus pure {
type Byte = Int in 0..255
type Ticks = Int in 0..1000

enum Light:
    Red,
    Green,
    Yellow

struct State:
    light: Light
    left: Ticks

fn duration(l: Light) -> Ticks:
    if l == Light::Red:
        30
    elif l == Light::Green:
        25
    else:
        5

fn next(l: Light) -> Light:
    if l == Light::Red:
        Light::Green
    elif l == Light::Green:
        Light::Yellow
    else:
        Light::Red

fn tick(s: State) -> State:
    left = s.left
    if left < 1:
        n = next(s.light)
        State {light: n, left: duration(n)}
    else:
        State {light: s.light, left: left - 1}

fn run(steps: Ticks) -> State:
    fold i from 0 to steps with intermediate s State {light: Light::Red, left: 30}:
        tick(s)

fn crc_step(c: Byte) -> int:
    if bit_and(c, 1) == 1:
        bit_xor(shift_right(c, 1), 140)
    else:
        shift_right(c, 1)

fn crc8(b: Byte) -> int:
    fold i from 0 to 8 with intermediate c b:
        crc_step(mod(c, 256))

fn gcd(a: Ticks, b: Ticks) -> Ticks:
    if b == 0:
        return a
    gcd(b, mod(a, b))

[run(100), crc8(49), crc8(200), gcd(1000, 750), duration(Light::Yellow)]
}

dict set ::ccCorpus never-joins {
error Bad

fn pick(n: int) -> int errors Bad:
    v = if n > 5:
        return n * 2
    else:
        fail Bad
    v + 1

fn sure(n: int) -> int:
    r = pick(n):
        on Bad:
            return -7
    r

fn both(n: int) -> int errors Bad:
    x = pick(n):
        on Bad:
            fail Bad
    x

fn safe(n: int) -> int:
    r = both(n):
        on Bad:
            -1
    r

[sure(10), sure(1), safe(9), safe(0)]
}

dict set ::ccCorpus mod-zero {
fn g(a: int, b: int) -> int:
    mod(a, b)
[g(7, 3), g(7, 0)]
}

dict set ::ccCorpus mod-zero-big {
fn g(a: int, b: int) -> int:
    mod(a * a * a, b)
[g(3000000000000, 0)]
}

dict set ::ccCorpus shift-range {
fn far(x: int, k: int) -> int:
    shift_right(x, k)
[far(3, 2), far(3, 2000000)]
}

dict set ::ccCorpus shift-negative {
fn far(x: int, k: int) -> int:
    shift_right(x, k)
[far(3, -1)]
}

# Botlish names Tcl's expr reads as numbers (inf, nan, infinity: AGENTS.md,
# "Tcl's expr reads a numeric-looking result as a number") as functions,
# bindings, fields and enum cases: before the backend wrote if for every
# such selection, a function named nan stopped -emit-c with ARITH DOMAIN.
dict set ::ccCorpus numeric-names {
enum Kind:
    Inf,
    Nan

struct Box:
    inf: int
    nan: int

fn nan(x: int) -> int:
    x + 1

fn inf(x: int) -> int:
    nan(x) * 2

fn infinity(k: Kind) -> Kind:
    if k == Kind::Inf:
        Kind::Nan
    else:
        Kind::Inf

NaN = Box {inf: inf(3), nan: nan(4)}
[NaN, NaN.inf, infinity(Kind::Inf), infinity(Kind::Nan)]
}

# Contexts (C-CONTEXTS-FREESTANDING-MILESTONE-1.md): installation, context
# parameters, transitive requirements, a constructor that needs an earlier
# context, a context used as a value (stored, returned, displayed, opaque),
# recursion (a self tail call keeps its contexts), a nested function, an
# installed context nothing uses and a parameter its instance never reads.
dict set ::ccCorpus contexts {
type Small = Int in 0..1000
type Port = Int in 0..15

context struct Clock:
    ticks: Small

context struct Rates:
    fee: Small

context struct Unused:
    flag: bool

opaque context struct Bus:
    port: Port

context struct Gain:
    k: Small

struct Snapshot:
    clock: Clock
    note: Small

fn open(port: Port) -> Bus:
    Bus {port: port}

fn gain_for(context b: Bus) -> Gain:
    if b.port > 7:
        Gain {k: 9}
    else:
        Gain {k: 2}

fn now(context c: Clock) -> Small:
    c.ticks

fn fee(amount: Small, context r: Rates) -> int:
    amount * r.fee + now()

fn charge(amount: Small) -> int:
    fee(amount) + 1

fn ignore(n: Small, context c: Clock) -> Small:
    n

fn grab(context c: Clock) -> Clock:
    c

fn snap(note: Small) -> Snapshot:
    Snapshot {clock: grab(), note: note}

fn countdown(n: Small, acc: Small, context g: Gain) -> int:
    if n < 1:
        return acc + g.k
    countdown(n - 1, now())

fn tree(n: Small, context g: Gain) -> int:
    if n <= 1:
        g.k
    else:
        tree(n - 1) + tree(n - 2)

fn outer(n: Small) -> int:
    fn inner(m: Small, context r: Rates) -> int:
        m + r.fee
    inner(n) * 2

with context Clock {ticks: 42}
with context Rates {fee: 3}
with context Unused {flag: true}
with context open(11)
with context gain_for()

s = snap(9)
[charge(10), now(), ignore(5), s, s.clock.ticks, countdown(3, 0), tree(10), outer(7), grab(), open(4)]
}

# Context traits (selected statically: the C calls the installed provider's
# implementation), a provider declared but not installed, inject blocks,
# a declared error failing inside an implementation and handled outside it,
# and an ordinary trait's specialization whose implementation needs a
# context (twice<Box> requires Fee only through Box's size).
dict set ::ccCorpus context-traits {
type Tick = Int in 0..1000000
type Start = Int in 0..999999
type Cents = Int in 0..100
type Amount = Int in 0..1000

context trait Clock:
    fn now() -> Tick

context struct SimClock:
    start: Start

fn now(context c: SimClock) -> Tick:
    c.start + 1

context struct OtherClock:
    hour: Cents

context struct Fee:
    cents: Cents

error Declined

fn price(n: Amount, context clock: Clock, fee: Fee) -> int errors Declined:
    t = clock.now()
    if n > 500:
        fail Declined
    n * fee.cents + t

fn checkout(n: Amount) -> int:
    price(n):
        on Declined:
            -1

fn stamp(context clock: Clock) -> Tick:
    clock.now()

fn charge_only(n: Amount, context fee: Fee) -> int:
    n * fee.cents

trait Thing:
    fn size(t: Thing) -> int

struct Box:
    v: Amount

fn size(t: Box) -> int:
    charge_only(t.v)

fn twice(t: Thing) -> int:
    t.size() + t.size()

with context SimClock {start: 99}
with context Fee {cents: 7}

a = inject context Fee, Clock:
    checkout(10)
b = inject no context:
    3 + 4
c = inject context Fee:
    charge_only(6)
[a, checkout(600), b, c, stamp(), twice(Box {v: 5})]
}

# Declared errors through context calls: two identities, handlers at the top
# level selecting by identity, a handler in a function between them.
dict set ::ccCorpus context-errors {
type Small = Int in 0..1000

error Overdrawn
error Frozen

context struct Account:
    balance: Small
    frozen: bool

fn withdraw(n: Small, context a: Account) -> int errors Overdrawn, Frozen:
    if a.frozen:
        fail Frozen
    if n > a.balance:
        fail Overdrawn
    a.balance - n

fn spend(n: Small) -> int errors Overdrawn, Frozen:
    withdraw(n) + withdraw(n)

fn safe(n: Small) -> int errors Frozen:
    spend(n):
        on Overdrawn:
            0

with context Account {balance: 50, frozen: false}
first = spend(20):
    on Overdrawn:
        -1
    on Frozen:
        -2
second = spend(80):
    on Overdrawn:
        -1
    on Frozen:
        -2
third = safe(90):
    on Frozen:
        -2
[first, second, third]
}

# A run-time error of the language inside a context operation.
dict set ::ccCorpus context-mod-zero {
type Small = Int in 0..1000

context struct Divisor:
    d: Small

fn split(n: Small, context c: Divisor) -> int:
    n.mod(c.d)

fn total(n: Small) -> int:
    split(n) + 1

with context Divisor {d: 0}
total(17)
}

foreach name [dict keys $::ccCorpus] {
    test cc-parity-$name "the C backend agrees with every other backend on the $name corpus program" \
        -constraints hostCC -body {
        ccParity [dict get $::ccCorpus $name]
    } -match regexp -result {^\{(value|error): [^\n]*\}$}
}

# The repository's own example programs the backend compiles: each agrees
# with the reference (the gate against an unused variable or helper in the
# C of a program written for other backends, such as a binding only a
# discarded branch reads).
test cc-parity-examples "the example programs the C backend compiles agree with every other backend" -constraints hostCC -body {
    set provider [file join $::ccProviders botlish_rt_v1_int_arena.c]
    set mismatches {}
    foreach file {01-arithmetic 02-recursion 04-branch-value 05-shadowing 06-list 07-loop-break 08-return
            11-boolean-operators 14-modules} {
        set path [file join $::projectRoot examples surface $file.bot]
        set hir [surface::readProgramFile $path -warnings off]
        set out [ccompile::program $hir -prefix prog -source $file.bot]
        set dir [ccDir]
        ccompile::write $out $dir
        set gen [dict create dir $dir prefix prog out $out]
        set got [lsort -unique [lmap compiler $::ccCompilers {ccRun [ccBuild $gen $compiler [list $provider] -O2]}]]
        set reference [list]
        foreach script {{core::evalProgram [hir::lower $hir]} {core::compiler::evalHir $hir}} {
            lappend reference "value: [core::value::show [eval $script] 1]"
        }
        if {[lsort -unique [concat $got $reference]] ne [lsort -unique $reference] || [llength [lsort -unique $reference]] != 1} {
            lappend mismatches "$file: $got vs $reference"
        }
    }
    set mismatches
} -result {}

test cc-unsupported-erased-enum "an instance called with cases of different enums is C UNSUPPORTED, not an internal error" -body {
    set hir [surface::readProgramFile [file join $::projectRoot examples surface 15-enums.bot] -warnings off]
    catch {ccompile::program $hir -prefix u} message options
    list [dict get $options -errorcode] [string match "*an enum value whose enum is not known statically*" $message]
} -result {{C UNSUPPORTED} 1}

# The generated differential: arithmetic at the int64_t boundaries, in
# functions whose operands the compiler proves fit (int64_t arithmetic) and
# in folds, whose intermediates it does not (the Int path), against the
# interpreter and the Tcl compiler.
test cc-parity-generated "generated boundary arithmetic agrees with the reference backends" -constraints hostCC -body {
    set values {0 1 -1 2 -2 3 7 -7 255 4294967295 4294967296 -4294967296 3037000499 3037000500
        4611686018427387904 -4611686018427387904 9223372036854775807 -9223372036854775807
        -9223372036854775808 9223372036854775808 18446744073709551616}
    set lines {}
    set calls {}
    set seed 4242
    for {set k 0} {$k < 60} {incr k} {
        set seed [expr {($seed * 1103515245 + 12345) % 2147483648}]
        set a [lindex $values [expr {$seed % [llength $values]}]]
        set seed [expr {($seed * 1103515245 + 12345) % 2147483648}]
        set b [lindex $values [expr {$seed % [llength $values]}]]
        set seed [expr {($seed * 1103515245 + 12345) % 2147483648}]
        set op [lindex {+ - * < mod ==} [expr {$seed % 6}]]
        if {$op eq "mod" && $b == 0} {
            set b 3
        }
        if {$op eq "mod"} {
            set direct "mod(f$k\($a), $b)"
            set folded "mod(s, $b)"
        } else {
            set direct "f$k\($a) $op $b"
            set folded "s $op $b"
        }
        # f's parameter's Range is its one call's argument (int64_t where
        # that fits); the fold's intermediate has no Range the analysis
        # proves, so its Int operations take the botlish_rt_v1_int path.
        lappend lines "fn f$k\(x: int) -> int:\n    x" \
            "fn d$k\():\n    $direct" \
            "fn g$k\():\n    s = fold i from 0 to 1 with intermediate s $a:\n        s + 0\n    $folded"
        lappend calls "d$k\()" "g$k\()"
    }
    lappend lines "\[[join $calls {, }]\]"
    ccParity [join $lines \n\n] {interp compile}
} -match regexp -result {^\{value: \[[^\n]*\]\}$}

# ---------------------------------------------------------------------------
# The runtime-service boundary

test cc-pure-needs-nothing "a program whose Ints are proven to fit int64_t needs no service and no runtime header" -body {
    set gen [ccGenerate [dict get $::ccCorpus pure] pure]
    set out [dict get $gen out]
    list [dict get $out services] [dict get $out display] [lsort [dict keys [dict get $out files]]] \
        [string match *botlish_rt_v1* [dict get $out files pure.h]] \
        [regexp {"required_services": \[\]\n} [dict get $out files pure.runtime.json]]
} -result {{} {} {pure.c pure.h pure.runtime.json pure_display.c} 0 1}

test cc-numeric-looking-names "a function named inf, nan or infinity keeps its name in C (no expr reads it as a number)" -body {
    set gen [ccGenerate [dict get $::ccCorpus numeric-names] nums]
    set c [dict get [dict get $gen out] files nums.c]
    lsort -unique [lmap name [regexp -all -inline {nums_[0-9]+_[A-Za-z]+} $c] {
        regsub {^nums_[0-9]+_} $name ""
    }]
} -result {inf infinity nan}

test cc-manifest-lists-the-services "the manifest names exactly the services the generated C calls, per translation unit" -body {
    set gen [ccGenerate [dict get $::ccCorpus recursion] rec]
    set out [dict get $gen out]
    set manifest [dict get $out files rec.runtime.json]
    set c [dict get $out files rec.c]
    set d [dict get $out files rec_display.c]
    set called [lsort -unique [regexp -all -inline {botlish_rt_v1_int_[a-z_]+(?=\()} $c]]
    set shown [lsort -unique [regexp -all -inline {botlish_rt_v1_int_[a-z_]+(?=\()} $d]]
    list [dict get $out services] [dict get $out display] $called $shown \
        [regexp {"service": "int.mul",\s+"symbol": "botlish_rt_v1_int_mul",\s+"header": "botlish_rt_v1.h",[^\}]*"required_by": \["rec.c"\]} $manifest] \
        [regexp {"service": "int.to_decimal",\s+"symbol": "botlish_rt_v1_int_to_decimal",[^\}]*"required_by": \["rec_display.c"\]} $manifest] \
        [regexp {"runtime_abi": "1"} $manifest]
} -result {{int.compare int.mod int.mul} int.to_decimal {botlish_rt_v1_int_compare botlish_rt_v1_int_mod botlish_rt_v1_int_mul} botlish_rt_v1_int_to_decimal 1 1 1}

test cc-deterministic "the same program gives the same files, byte for byte" -body {
    set a [dict get [ccGenerate [dict get $::ccCorpus structs] same] out]
    set b [dict get [ccGenerate [dict get $::ccCorpus structs] same] out]
    expr {[dict get $a files] eq [dict get $b files]}
} -result 1

test cc-missing-service-compiles "a program needing a service compiles to objects without its provider" -constraints {hostCC nm} -body {
    set gen [ccGenerate {
fn fact(n: int) -> int:
    if n <= 1:
        1
    else:
        n * fact(n - 1)
fact(25)
} fact]
    set dir [dict get $gen dir]
    set compiler [lindex $::ccCompilers 0]
    set objects {}
    foreach unit {fact fact_display} {
        lassign [ccExec [list $compiler {*}$::ccStrict -ffreestanding -O0 -I $dir -c [file join $dir $unit.c] -o [file join $dir $unit.o]]] status output
        lappend objects $status
    }
    set undefined [lsort [regexp -all -inline {botlish_rt_v1_[a-z_]+} [lindex [ccExec [list nm -u [file join $dir fact.o]]] 1]]]
    set shown [lsort [regexp -all -inline {botlish_rt_v1_[a-z_]+} [lindex [ccExec [list nm -u [file join $dir fact_display.o]]] 1]]]
    list $objects $undefined $shown [dict get $gen out services] [dict get $gen out display]
} -result {{0 0} botlish_rt_v1_int_mul botlish_rt_v1_int_to_decimal int.mul int.to_decimal}

test cc-missing-service-link-error "linking without the provider fails, the linker naming the service's symbol" -constraints hostCC -body {
    set gen [ccGenerate {
fn fact(n: int) -> int:
    if n <= 1:
        1
    else:
        n * fact(n - 1)
fact(25)
} fact]
    catch {ccBuild $gen [lindex $::ccCompilers 0] {} -O0} message
    list [regexp {undefined reference to [`']botlish_rt_v1_int_mul'|Undefined symbols|botlish_rt_v1_int_mul} $message] \
        [string match "*C build failed*" $message] [string match *botlish_rt_v1_int_to_decimal* $message]
} -result {1 1 1}

test cc-supplied-service "with the reference provider linked in, the program runs and agrees" -constraints hostCC -body {
    set source {
fn fact(n: int) -> int:
    if n <= 1:
        1
    else:
        n * fact(n - 1)
fact(30)
}
    set gen [ccGenerate $source fact]
    set exe [ccBuild $gen [lindex $::ccCompilers 0] [list [file join $::ccProviders botlish_rt_v1_int_arena.c]] -O2]
    list [ccRun $exe] [ccReference $source]
} -result {{value: 265252859812191058636308480000000} {value: 265252859812191058636308480000000}}

test cc-provider-limit "a provider out of storage ends the run with C RUNTIME LIMIT, never a wrong value" -constraints hostCC -body {
    set gen [ccGenerate {
fn fact(n: int) -> int:
    if n <= 1:
        1
    else:
        n * fact(n - 1)
fact(60)
} fact]
    set exe [ccBuild $gen [lindex $::ccCompilers 0] [list [file join $::ccProviders botlish_rt_v1_int_arena.c]] -O1 \
        {-DBOTLISH_RT_INT_ARENA_LIMBS=8}]
    ccRun $exe
} -result {error: a runtime service could not complete an operation: its provider's storage is exhausted (C RUNTIME LIMIT)}

test cc-freestanding-objects "a service-free program's objects reference nothing, freestanding, at every optimization level" -constraints {hostCC nm} -body {
    set gen [ccGenerate [dict get $::ccCorpus pure] pure]
    set dir [dict get $gen dir]
    set result {}
    foreach compiler $::ccCompilers {
        foreach opt {-O1 -O2 -Os} {
            set undefined {}
            foreach unit {pure pure_display} {
                set object [file join $dir $unit.o]
                # (-fno-stack-protector: the stack protector's
                # __stack_chk_fail is a hosted C library's, which a
                # freestanding build does without.)
                lassign [ccExec [list $compiler {*}$::ccStrict -ffreestanding -fno-stack-protector $opt -I $dir \
                    -c [file join $dir $unit.c] -o $object]] status output
                if {$status} {
                    error $output
                }
                lappend undefined {*}[lmap line [split [lindex [ccExec [list nm -u $object]] 1] \n] {
                    if {[string trim $line] eq ""} continue
                    lindex $line end
                }]
            }
            lappend result "$compiler $opt: $undefined"
        }
    }
    lsort -unique [lmap r $result {regsub {^\S+ \S+: } $r ""}]
} -result {{}}

test cc-freestanding-executable "a service-free program links with no C library and runs from a bare _start" -constraints {gcc linuxX86_64} -body {
    set gen [ccGenerate [dict get $::ccCorpus pure] pure]
    set dir [dict get $gen dir]
    set exe [file join $dir pure.free]
    lassign [ccExec [list gcc {*}$::ccStrict -O2 -ffreestanding -nostdlib -static -fno-stack-protector -fno-pie -no-pie \
        -DBOTLISH_PROGRAM=pure "-DBOTLISH_PROGRAM_HEADER=\"pure.h\"" -I $dir \
        [file join $::ccHarness linux_start.c] [file join $dir pure.c] [file join $dir pure_display.c] -o $exe]] status output
    if {$status} {
        error $output
    }
    list [ccRun $exe] [ccReference [dict get $::ccCorpus pure]]
} -result {{value: [State {light: Light::Green, left: 19}, 224, 8, 250, 5]} {value: [State {light: Light::Green, left: 19}, 224, 8, 250, 5]}}

test cc-public-names-prefixed "every global symbol a program defines carries its prefix, so programs link side by side" -constraints {hostCC nm} -body {
    set gen [ccGenerate [dict get $::ccCorpus errors] errs]
    set dir [dict get $gen dir]
    set compiler [lindex $::ccCompilers 0]
    set names {}
    foreach unit {errs errs_display} {
        set object [file join $dir $unit.o]
        ccExec [list $compiler -std=c11 -O2 -I $dir -c [file join $dir $unit.c] -o $object]
        foreach line [split [lindex [ccExec [list nm -g $object]] 1] \n] {
            if {[llength $line] == 3 && [lindex $line 1] ne "U"} {
                # (Mach-O spells a C name with a leading underscore.)
                set name [lindex $line 2]
                if {$::tcl_platform(os) eq "Darwin"} {
                    regsub {^_} $name "" name
                }
                lappend names $name
            }
        }
    }
    list [lsort $names] [lsearch -all -inline -not -glob $names errs_*]
} -result {{errs_run errs_show errs_status_code errs_status_message} {}}

# Unoptimized, every object references exactly the manifest's services (an
# optimizer may prove some calls unreachable and drop them: the manifest is
# what the C references, an upper bound of what a link needs).
test cc-cross-targets "the generated C compiles for other architectures, word sizes and byte orders" -constraints {clang llvmNm} -body {
    set gen [ccGenerate [dict get $::ccCorpus recursion] rec]
    set dir [dict get $gen dir]
    set result {}
    foreach target {thumbv6m-none-eabi thumbv7m-none-eabi riscv32-unknown-elf riscv64-unknown-elf msp430-none-elf
            mips-unknown-elf powerpc-unknown-elf aarch64-none-elf} {
        set undefined {}
        foreach unit {rec rec_display} {
            set object [file join $dir $unit.$target.o]
            lassign [ccExec [list clang --target=$target {*}$::ccStrict -ffreestanding -O0 -I $dir \
                -c [file join $dir $unit.c] -o $object]] status output
            if {$status} {
                error "$target: $output"
            }
            foreach line [split [lindex [ccExec [list llvm-nm -u $object]] 1] \n] {
                if {[string match *botlish_rt_v1_* $line]} {
                    lappend undefined [lindex $line end]
                }
            }
        }
        lappend result [lsort -unique $undefined]
    }
    lsort -unique $result
} -result {{botlish_rt_v1_int_compare botlish_rt_v1_int_mod botlish_rt_v1_int_mul botlish_rt_v1_int_to_decimal}}

# Executing it there: each corpus program built with no C library at all
# (examples/c-freestanding/harness/linux_start.c's _start and system calls)
# for other Linux architectures -- AArch64, RISC-V 64, big-endian s390x,
# 32-bit ARM and i386 -- run under qemu-user (an emulator, not the hardware)
# or natively (i386), against the reference. A 32-bit target links the
# toolchain's own libgcc.a (64-bit % and * helpers): the toolchain's
# obligation, met by the cross libgcc packages where installed.
set ::ccCross {}
foreach {target emulator libgcc} {
    aarch64-linux-gnu qemu-aarch64 {}
    riscv64-linux-gnu qemu-riscv64 {}
    s390x-linux-gnu qemu-s390x {}
    armv7a-linux-gnueabihf qemu-arm /usr/lib/gcc-cross/arm-linux-gnueabihf/13/libgcc.a
    i686-linux-gnu {} /usr/lib/gcc-cross/i686-linux-gnu/13/libgcc.a
} {
    if {$emulator ne "" && [auto_execok $emulator] eq ""} continue
    if {$libgcc ne "" && ![file exists $libgcc]} continue
    if {$emulator eq "" && !([testConstraint linuxX86_64])} continue
    lappend ::ccCross $target $emulator $libgcc
}
testConstraint ccCross [expr {[testConstraint clang] && [auto_execok ld.lld] ne "" && $::ccCross ne ""}]

test cc-cross-execution "corpus programs built with no C library run on other architectures and agree" -constraints ccCross -body {
    set mismatches {}
    set runs 0
    foreach name {recursion loops errors bounds domains structs pure mod-zero} {
        set source [dict get $::ccCorpus $name]
        set gen [ccGenerate $source]
        set dir [dict get $gen dir]
        set expected [ccReference $source {interp compile}]
        foreach {target emulator libgcc} $::ccCross {
            set exe [file join $dir prog.$target]
            set command [list clang --target=$target -fuse-ld=lld {*}$::ccStrict -O2 -ffreestanding -nostdlib -static \
                -fno-stack-protector -fno-pic -DBOTLISH_PROGRAM=prog "-DBOTLISH_PROGRAM_HEADER=\"prog.h\"" \
                -I $dir -I [file join $::projectRoot ccompile] [file join $::ccHarness linux_start.c] \
                [file join $dir prog.c] [file join $dir prog_display.c] \
                [file join $::ccProviders botlish_rt_v1_int_arena.c] {*}$libgcc -o $exe]
            lassign [ccExec $command] status output
            if {$status} {
                lappend mismatches "$name $target: build: $output"
                continue
            }
            set got [string trim [lindex [ccExec [concat $emulator [list $exe]]] 1]]
            incr runs
            if {$got ne $expected} {
                lappend mismatches "$name $target: $got (expected $expected)"
            }
        }
    }
    list [expr {$runs > 0}] $mismatches
} -result {1 {}}

# ---------------------------------------------------------------------------
# What the backend does not translate: C UNSUPPORTED at compile time, at the
# construct -- never a runtime-service reference.

proc ccUnsupported {source} {
    set hir [surface::compile $source -warnings off]
    if {![catch {ccompile::program $hir -prefix u} message options]} {
        return "compiled"
    }
    set entries [lmap d [dict getdef $options -diagnostics {}] {dict get $d message}]
    return [list [dict get $options -errorcode] [regsub {^.*?:([0-9]+:[0-9]+): } [lindex $entries 0] {\1: }] [llength $entries]]
}

test cc-unsupported-string "a String is C UNSUPPORTED, located" -body {
    ccUnsupported {
fn greet(n: int) -> str:
    "hello"
greet(1)
}
} -result {{C UNSUPPORTED} {3:5: the C backend cannot compile a String yet (Compilerpedia's backend.c lists what it compiles); this is a limit of the backend, not a missing runtime service} 1}

test cc-unsupported-list-parameter "a List of unknown length is C UNSUPPORTED" -body {
    lrange [ccUnsupported {
import std::list
fn total(xs: List[int]) -> int:
    fold x in xs with intermediate s 0:
        s + x
total([1, 2, 3])
}] 0 0
} -result {{C UNSUPPORTED}}

test cc-unsupported-closure "a closure is C UNSUPPORTED" -body {
    set r [ccUnsupported {
fn adder(k: int) -> int:
    fn add(x: int) -> int:
        x + k
    add(1) + add(2)
adder(5)
}]
    list [lindex $r 0] [string match "*a closure*" [lindex $r 1]]
} -result {{C UNSUPPORTED} 1}

test cc-unsupported-payload "an error payload is C UNSUPPORTED" -body {
    set r [ccUnsupported {
error Bad:
    code: int

fn f(n: int) -> int errors Bad:
    if n > 1:
        fail Bad {code: n}
    n

r = f(0):
    on Bad:
        -1
r
}]
    list [lindex $r 0] [string match "*payload*" [lindex $r 1]]
} -result {{C UNSUPPORTED} 1}

test cc-unsupported-float "a Float64 is C UNSUPPORTED" -body {
    lindex [ccUnsupported {
fn half(x: int) -> int:
    x
2.5 / 2.0
}] 0
} -result {C UNSUPPORTED}

test cc-unsupported-several "every unsupported function is reported, each at its construct" -body {
    set r [ccUnsupported {
fn a(n: int) -> str:
    "a"

fn b(n: int) -> str:
    "b"

[a(1), b(2)]
}]
    list [lindex $r 0] [lindex $r 2]
} -result {{C UNSUPPORTED} 2}

test cc-unsupported-bitwise-unproven "bitwise operations on Ints not proven to fit int64_t are C UNSUPPORTED, not a service" -body {
    set r [ccUnsupported {
fn f(a: int, b: int) -> int:
    bit_and(a * a, b)
f(3000000000000, 7)
}]
    list [lindex $r 0] [string match "*bit_and*no bitwise services*" [lindex $r 1]]
} -result {{C UNSUPPORTED} 1}

# ---------------------------------------------------------------------------
# Contexts (C-CONTEXTS-FREESTANDING-MILESTONE-1.md): a context struct is a C
# struct, an installation an object of the program function's own frame, a
# function's transitive requirement its pointer parameters,
# a call passes the callee's requirement on. Beside the parity corpus
# programs above: the example application installed two ways and both
# configurations run in one executable, hosted and with no C library; the
# signatures state the requirements; nothing is stored at file scope; the
# manifest; what is C UNSUPPORTED; an unverified program refused.

set ::ccContexts [file join $::projectRoot examples c-freestanding contexts]

# The C translation of the program file PATH (an application with modules)
# written into DIR (a fresh directory when ""): {dir DIR prefix PREFIX out
# OUT hir HIR}, the prefix PATH's (ccompile::PrefixOf, as -emit-c names it).
proc ccGenerateFile {path {dir ""}} {
    set hir [surface::readProgramFile $path -warnings off]
    set prefix [ccompile::PrefixOf $path]
    set out [ccompile::program $hir -prefix $prefix -source [file tail $path]]
    if {$dir eq ""} {
        set dir [ccDir]
    }
    ccompile::write $out $dir
    return [dict create dir $dir prefix $prefix out $out hir $hir]
}

# The `# expect:` value of the example program PATH, as the harness prints it.
proc ccExpected {path} {
    set channel [open $path]
    set text [read $channel]
    close $channel
    regexp -line {^# expect: (.*)$} $text -> value
    return "value: $value"
}

# Builds programs A and B (ccGenerateFile's, in one directory) into one
# executable with harness/two_apps.c, by COMPILER under the strict flags:
# hosted (FREE 0), or (FREE 1) with no C library, its _start
# harness/linux_start.c's, for clang's TARGET when given (EXTRA: libgcc).
# Returns the executable's path.
proc ccTwoApps {a b compiler free {target ""} {extra {}}} {
    set dir [dict get $a dir]
    set pa [dict get $a prefix]
    set pb [dict get $b prefix]
    set defs [list -DBOTLISH_PROGRAM_A=$pa "-DBOTLISH_PROGRAM_A_HEADER=\"$pa.h\"" \
        -DBOTLISH_PROGRAM_B=$pb "-DBOTLISH_PROGRAM_B_HEADER=\"$pb.h\""]
    set units [list [file join $dir $pa.c] [file join $dir ${pa}_display.c] \
        [file join $dir $pb.c] [file join $dir ${pb}_display.c]]
    set exe [file join $dir two.$compiler.$free[expr {$target eq "" ? "" : ".$target"}]]
    set command [list $compiler {*}$::ccStrict -O2 {*}$defs -I $dir]
    if {$target ne ""} {
        lappend command --target=$target -fuse-ld=lld -fno-pic
    } elseif {$free} {
        lappend command -fno-pie -no-pie
    }
    if {$free} {
        lappend command -ffreestanding -nostdlib -static -fno-stack-protector \
            -DBOTLISH_START_ENTRY=two_apps_main [file join $::ccHarness linux_start.c]
    } else {
        lappend command -DTWO_APPS_HOSTED
    }
    lappend command [file join $::ccHarness two_apps.c] {*}$units {*}$extra -o $exe
    lassign [ccExec $command] status output
    if {$status != 0} {
        error "two-application build failed ($compiler $free $target):\n$output"
    }
    return $exe
}

# What two_apps.c must print for A and B: each run's line, interleaved A B B
# A A B, every line the reference backends' outcome of its program.
proc ccTwoAppsExpected {a b} {
    set reference [dict create A [ccReferenceOf [dict get $a hir]] B [ccReferenceOf [dict get $b hir]]]
    set name [dict create A [dict get $a prefix] B [dict get $b prefix]]
    set runs [dict create A 0 B 0]
    set lines {}
    foreach which {A B B A A B} {
        dict incr runs $which
        lappend lines "[dict get $name $which] run [dict get $runs $which]: [dict get $reference $which]"
    }
    lappend lines "repeated runs: identical"
    return [join $lines \n]
}

# The two example programs, generated into one directory once.
proc ccStores {} {
    if {![info exists ::ccStoresGen]} {
        set dir [ccDir]
        set ::ccStoresGen [lmap f {store_bench store_field} {
            ccGenerateFile [file join $::ccContexts $f.bot] $dir
        }]
    }
    return $::ccStoresGen
}

test cc-ctx-application "the example application, installed two ways, agrees with every backend and with its expect line; neither configuration needs a runtime service" -constraints hostCC -body {
    set results {}
    foreach gen [ccStores] f {store_bench store_field} {
        set got [lmap compiler $::ccCompilers {
            lmap opt {-O0 -O2} {ccRun [ccBuild $gen $compiler {} $opt]}
        }]
        set all [lsort -unique [concat {*}$got [list [ccReferenceOf [dict get $gen hir]]]]]
        set out [dict get $gen out]
        lappend results [expr {$all eq [list [ccExpected [file join $::ccContexts $f.bot]]]}] \
            [dict get $out services] [dict get $out display] [dict exists $out files botlish_rt_v1.h]
    }
    set results
} -result {1 {} {} 0 1 {} {} 0}

test cc-ctx-two-apps "two configurations of one application coexist in one executable: interleaved runs give each its own contexts, and repeated runs the same value" -constraints hostCC -body {
    lassign [ccStores] a b
    set expected [ccTwoAppsExpected $a $b]
    lsort -unique [lmap compiler $::ccCompilers {
        lassign [ccExec [list [ccTwoApps $a $b $compiler 0]]] status output
        list $status [expr {[string trim $output] eq $expected}]
    }]
} -result {{0 1}}

test cc-ctx-two-apps-freestanding "the two configurations run in one static executable with no C library, no Botlish runtime and no provider" -constraints {gcc linuxX86_64 nm} -body {
    lassign [ccStores] a b
    set exe [ccTwoApps $a $b gcc 1]
    lassign [ccExec [list $exe]] status output
    list $status [expr {[string trim $output] eq [ccTwoAppsExpected $a $b]}] \
        [string trim [lindex [ccExec [list nm -u $exe]] 1]]
} -result {0 1 {}}

test cc-ctx-two-apps-cross "the two-application executable, with no C library, runs on other architectures and agrees" -constraints ccCross -body {
    lassign [ccStores] a b
    set expected [ccTwoAppsExpected $a $b]
    set mismatches {}
    set runs 0
    foreach {target emulator libgcc} $::ccCross {
        set exe [ccTwoApps $a $b clang 1 $target $libgcc]
        lassign [ccExec [concat $emulator [list $exe]]] status output
        incr runs
        if {$status != 0 || [string trim $output] ne $expected} {
            lappend mismatches "$target: $status $output"
        }
    }
    list [expr {$runs > 0}] $mismatches
} -result {1 {}}

test cc-ctx-freestanding-objects "a context program's objects reference nothing, freestanding, under gcc and clang" -constraints {hostCC nm} -body {
    set undefined {}
    set gen [ccGenerate [dict get $::ccCorpus contexts] app]
    foreach g [concat [ccStores] [list $gen]] {
        set dir [dict get $g dir]
        set p [dict get $g prefix]
        foreach compiler $::ccCompilers {
            foreach unit [list $p ${p}_display] {
                set object [file join $dir $unit.$compiler.o]
                lassign [ccExec [list $compiler {*}$::ccStrict -O2 -ffreestanding -I $dir -c [file join $dir $unit.c] -o $object]] status output
                if {$status} {
                    error $output
                }
                lappend undefined {*}[lindex [ccExec [list nm -u $object]] 1]
            }
        }
    }
    set undefined
} -result {}

test cc-ctx-cross-targets "the context programs compile for other architectures, word sizes and byte orders (16-bit int and pointers included) and reference no Botlish service there" -constraints {clang llvmNm} -body {
    set result {}
    foreach target {thumbv6m-none-eabi thumbv7m-none-eabi riscv32-unknown-elf riscv64-unknown-elf msp430-none-elf
            {avr -mmcu=atmega328p} mips-unknown-elf powerpc-unknown-elf aarch64-none-elf} {
        set services {}
        foreach gen [ccStores] {
            set dir [dict get $gen dir]
            set p [dict get $gen prefix]
            foreach unit [list $p ${p}_display] {
                set object [file join $dir $unit.[lindex $target 0].o]
                lassign [ccExec [list clang --target=[lindex $target 0] {*}[lrange $target 1 end] {*}$::ccStrict \
                    -ffreestanding -O2 -I $dir -c [file join $dir $unit.c] -o $object]] status output
                if {$status} {
                    error "$target: $output"
                }
                foreach line [split [lindex [ccExec [list llvm-nm -u $object]] 1] \n] {
                    if {[string match *botlish* $line]} {
                        lappend services [lindex $line end]
                    }
                }
            }
        }
        lappend result $services
    }
    lsort -unique $result
} -result {{}}

# The C function of every instance takes exactly its block's transitive
# requirement, one pointer per context, after its ordinary parameters:
# its signature states its authority. Calls pass on only what the callee
# requires -- inside `inject context Fee:` only Fee.
proc ccContextParams {c prefix} {
    set result [dict create]
    foreach {- name params} [regexp -all -inline -line "^static ${prefix}_status ${prefix}_(?:\[0-9\]+_)?(\[A-Za-z0-9_\]+)\\((.*)\\);$" $c] {
        dict set result $name [regexp -all -inline {ctx_[A-Za-z0-9_]+(?=[,)])} $params]
    }
    return $result
}

test cc-ctx-requirements-are-signatures "each function's C parameters are its transitive context requirement; a call inside an inject block passes only the injected context" -body {
    set c [dict get [dict get [ccGenerate [dict get $::ccCorpus contexts] app] out] files app.c]
    set t [dict get [dict get [ccGenerate [dict get $::ccCorpus context-traits] tr] out] files tr.c]
    list [lsort -stride 2 [ccContextParams $c app]] \
        [regexp {tr_[0-9]+_charge_only\(INT64_C\(6\), &ctx_Fee, &r[0-9]+\)} $t] \
        [lsort -stride 2 [ccContextParams $t tr]]
} -result {{charge {ctx_Clock ctx_Rates} countdown {ctx_Clock ctx_Gain} fee {ctx_Clock ctx_Rates} gain_for ctx_Bus grab ctx_Clock ignore ctx_Clock inner ctx_Rates now ctx_Clock open {} outer ctx_Rates program {} snap ctx_Clock tree ctx_Gain} 1 {charge_only ctx_Fee checkout_Clock_SimClock {ctx_Fee ctx_SimClock} now ctx_SimClock price_Clock_SimClock {ctx_Fee ctx_SimClock} program {} size ctx_Fee stamp_Clock_SimClock ctx_SimClock twice_Box ctx_Fee}}

test cc-ctx-names-avoid-the-prefix "a program named ctx (its types ctx_Clock, ...) names its contexts cx_: no context name starts with the prefix, so none collides with a type" -constraints hostCC -body {
    set gen [ccGenerate [dict get $::ccCorpus contexts] ctx]
    set c [dict get [dict get $gen out] files ctx.c]
    list [regexp {[(,] ctx_Clock \*cx_Clock} $c] [regexp {[^A-Za-z_]ctx_Clock [^=]*= \(\(ctx_Clock\)} $c] \
        [expr {[ccRun [ccBuild $gen [lindex $::ccCompilers 0] {} -O2]] eq [ccReference [dict get $::ccCorpus contexts]]}]
} -result {1 1 1}

# Installed contexts are objects of the run's frame: no object of static
# storage duration holds one, every installation is an object of the
# program function, and the header says what a run writes. (A program whose
# functions read a top-level value keeps it at file scope, and says so.)
proc ccFileScopeObjects {text} {
    # Lines at column 0 that declare an object, not a function: what is not
    # const there is writable static storage.
    lmap line [split $text \n] {
        if {![regexp {^static } $line] || [regexp {\(} $line] || [regexp {^static const } $line]} continue
        set line
    }
}

test cc-ctx-installed-in-the-run "no installed context is stored at file scope: each is an object of the program function, and the header says the run writes no static storage" -body {
    set gen [ccGenerate [dict get $::ccCorpus contexts] app]
    set files [dict get $gen out files]
    set statics [dict get [dict get [ccGenerate [dict get $::ccCorpus statics] st] out] files]
    set program [lindex [regexp -inline {static app_status app_program\(app_list0 \*out\)\n\{.*?\n\}} [dict get $files app.c]] 0]
    list [ccFileScopeObjects [dict get $files app.c]] [ccFileScopeObjects [dict get $files app_display.c]] \
        [llength [regexp -all -inline {\n    app_[A-Za-z]+ ctx_[A-Za-z]+ = } $program]] \
        [llength [regexp -all -inline {\n *app_[A-Za-z]+ ctx_[A-Za-z]+ = } [dict get $files app.c]]] \
        [string match "*Writes no object of\n * static storage duration*" [dict get $files app.h]] \
        [string match "*Not reentrant*" [dict get $statics st.h]]
} -result {{} {} 5 5 1 1}

# No context pointer or installed object is const-qualified: GCC 15 (CI's
# ubuntu-26.04 image) took the address of an initialized installed context,
# passed to a pointer-to-const parameter of a recursive function it had
# cloned with the context's constant contents, for a read of an
# uninitialized object (-Wmaybe-uninitialized, an error under -Werror); GCC
# checks only pointer-to-const parameters that way (tree-ssa-uninit.cc's
# maybe_warn_pass_by_reference). The backend writes through none of them.
test cc-ctx-no-const-context-pointers "no context pointer parameter or installed context is const-qualified (GCC 15's -Wmaybe-uninitialized of pointer-to-const arguments)" -body {
    set c [dict get [dict get [ccGenerate [dict get $::ccCorpus contexts] app] out] files app.c]
    list [regexp {const app_[A-Za-z]+ \*ctx_} $c] [regexp {const app_[A-Za-z]+ ctx_[A-Za-z]+ = } $c] \
        [expr {[llength [regexp -all -inline {app_[A-Za-z]+ \*ctx_[A-Za-z]+[,)]} $c]] > 0}]
} -result {0 0 1}

test cc-ctx-big-int-field "a context whose field is an unbounded Int compiles to C (the run's frame holds it as an ordinary value; native lowering cannot slot it); its arithmetic needs the Int services" -constraints hostCC -body {
    set source {type Small = Int in 0..1000

context struct Ledger:
    base: int
    scale: Small

fn big(context l: Ledger) -> int:
    l.base * l.base * l.scale

fn twice() -> int:
    big() + big()

with context Ledger {base: 123456789012, scale: 3}
[twice(), big()]
}
    set native [expr {[testConstraint nativeBuilt] ? [catch {native::evalHir [surface::compile $source -warnings off]} m o] : 1}]
    list [ccParity $source {interp compile}] [dict get [dict get [ccGenerate $source big] out] services] \
        [expr {$native == 1}] [expr {![testConstraint nativeBuilt] || [lindex [dict get $o -errorcode] end] eq "CONTEXT-NATIVE-LOWERING-UNSUPPORTED"}]
} -result {{{value: [91449472518920903616864, 45724736259460451808432]}} {int.add int.mul} 1 1}

test cc-ctx-manifest-transitive "a service needed only inside a context implementation reached through a context trait is in the manifest, exactly as the C references it; the manifest has no context entry" -body {
    set gen [ccGenerate {context trait Meter:
    fn reading() -> int

context struct Big:
    base: int

fn reading(context b: Big) -> int:
    b.base * 1000000007

fn report(context m: Meter) -> int:
    m.reading()

fn summary() -> int:
    report()

with context Big {base: 99999999999}
summary()
} meter]
    set out [dict get $gen out]
    set c [dict get $out files meter.c]
    list [dict get $out services] [dict get $out display] \
        [lsort -unique [regexp -all -inline {botlish_rt_v1_int_[a-z_]+(?=\()} $c]] \
        [string match -nocase *context* [dict get $out files meter.runtime.json]]
} -result {int.mul int.to_decimal botlish_rt_v1_int_mul 0}

test cc-ctx-unsupported "a context the C backend cannot represent is C UNSUPPORTED, naming the context and why, at each use -- never malformed C or an internal error" -body {
    set result {}
    foreach source [list {context struct Named:
    name: str

fn greet(context n: Named) -> int:
    7

with context Named {name: "ab"}
greet()
} {import std::mutable_vector

context struct Log:
    lines: MutableVector[int]

fn count(context l: Log) -> int:
    l.lines.length()

with context Log {lines: std::mutable_vector::from_list([1, 2])}
count()
} {import std::ffi::c

context struct Dev:
    handle: std::ffi::c::Ptr[std::ffi::c::Void]

fn ok(context d: Dev) -> bool:
    std::ffi::c::null?(d.handle)

with context Dev {handle: std::ffi::c::null[std::ffi::c::Void]()}
ok()
}] {
        set hir [surface::compile $source -warnings off]
        catch {ccompile::program $hir -prefix u} message options
        set entries [lmap d [dict getdef $options -diagnostics {}] {dict get $d message}]
        lappend result [dict get $options -errorcode] [llength $entries] \
            [regsub {^.*?:([0-9]+:[0-9]+): the C backend cannot compile (.*?) yet .*$} [lindex $entries 0] {\1: \2}]
    }
    set result
} -result {{C UNSUPPORTED} 2 {7:14: the context struct Named, whose field "name" has type str,} {C UNSUPPORTED} 2 {9:14: the context struct Log, whose field "lines" has type MutableVector[int],} {C UNSUPPORTED} 2 {9:14: the context struct Dev, which owns affine state (a C pointer, a coroutine, or a struct or collection holding one)}}

# (The Linux program is compiled for a Linux target, the host's own on Linux:
# std::linux is the Linux platform's, UNSUPPORTED-PLATFORM for any other.)
test cc-ctx-unsupported-around-contexts "a program whose contexts are representable but which uses what C does not compile (the portable I/O over Linux system calls and Strings; a coroutine) is C UNSUPPORTED at those constructs" -body {
    set hello [surface::compile {import std::io
import std::linux::io

fn hello() -> unit errors std::io::WriteFailed:
    std::io::print_line("hello")

with context std::linux::io::create()
hello():
    on std::io::WriteFailed:
        unit
} -warnings off -target [linuxTarget]]
    set coro [surface::compile {type Small = Int in 0..100

context struct Base:
    k: Small

fn gen(n: Small, context b: Base) -> int:
    yield n + b.k
    0

with context Base {k: 1}
coroutine {step: c} = gen(3)
5
} -warnings off]
    lmap hir [list $hello $coro] {
        catch {ccompile::program $hir -prefix u} message options
        list [dict get $options -errorcode] [expr {[llength [dict getdef $options -diagnostics {}]] > 0}] \
            [string match "*context*" [lindex [split $message \n] 0]]
    }
} -result {{{C UNSUPPORTED} 1 0} {{C UNSUPPORTED} 1 0}}

test cc-ctx-unverified-refused "a lenient HIR that failed context verification is never compiled: its first context diagnostic is the error" -body {
    set hir [surface::compile "type Small = Int in 0..100\ncontext struct Clock:\n    t: Small\nfn now(context c: Clock) -> Small:\n    c.t\nnow()\n" -warnings off -strict 0]
    catch {ccompile::program $hir -prefix u} message options
    list [dict get $options -errorcode] [lindex [split $message \n] 0]
} -result {{CORE SEMANTIC MISSING-CONTEXT} {<input>:6:1: Clock is required by this call but is not installed here (install it with "with context EXPR" before the call):}}

test cc-ctx-example-warning-clean "the example application's entry programs and modules compile under -warnings error" -body {
    lmap f {store_bench store_field} {
        if {[catch {surface::readProgramFile [file join $::ccContexts $f.bot] -warnings error} message]} {
            set message
        } else {
            string cat clean
        }
    }
} -result {clean clean}

test cc-ctx-deterministic "a context program gives the same files, byte for byte" -body {
    set path [file join $::ccContexts store_bench.bot]
    expr {[dict get [ccGenerateFile $path] out files] eq [dict get [ccGenerateFile $path] out files]}
} -result 1

# ---------------------------------------------------------------------------
# The command line

test cc-cli-emit-c "-emit-c writes the files into -out DIR and names the services; nothing runs" -constraints unixShell -body {
    set dir [ccDir]
    set source [file join $dir Fact-1.bot]
    set channel [open $source w]
    puts $channel "fn fact(n: int) -> int:\n    if n <= 1:\n        1\n    else:\n        n * fact(n - 1)\nfact(25)"
    close $channel
    set out [file join $dir out]
    lassign [ccExec [list [info nameofexecutable] [file join $::projectRoot main.tcl] -warnings off -emit-c -out $out $source]] status output
    list $status [lsort [glob -tails -directory $out *]] [lindex [split $output \n] end]
} -result {0 {Fact_1.c Fact_1.h Fact_1.runtime.json Fact_1_display.c botlish_rt_v1.h} {runtime services: int.mul, int.to_decimal}}

test cc-cli-unsupported "-emit-c of a program it cannot compile reports C UNSUPPORTED and exits 1, writing nothing" -constraints unixShell -body {
    set dir [ccDir]
    set source [file join $dir s.bot]
    set channel [open $source w]
    puts $channel "\"text\""
    close $channel
    lassign [ccExec [list [info nameofexecutable] [file join $::projectRoot main.tcl] -emit-c $source]] status output
    list $status [string match "*(C UNSUPPORTED)*" $output] [glob -nocomplain -tails -directory $dir *.c *.h]
} -result {1 1 {}}

test cc-cli-out-needs-a-builder "-out without -emit-c or -emit-native-library is a usage error" -constraints unixShell -body {
    set dir [ccDir]
    lassign [ccExec [list [info nameofexecutable] [file join $::projectRoot main.tcl] -out $dir x.bot]] status output
    list $status [string match "*-out is an option of -emit-native-library and -emit-c*" $output]
} -result {2 1}

