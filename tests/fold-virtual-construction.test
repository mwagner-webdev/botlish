# fold-virtual-construction.test -- virtual construction across fold
# intermediates (FOLD-VIRTUAL-LIST-CONSTRUCTION-MILESTONE-1.md;
# hir/construction.tcl's plan fold, native/lower.tcl's LoopResultStart,
# LoopResultBind, FoldValue and LoopBody).
#
# A fold whose String/List intermediate is only extended carries it as a
# construction plan (M8A-VIRTUAL-IMMUTABLE-CONSTRUCTION.md), extended in
# place and materialized once, exactly as a self tail call's plan parameter
# is. Every value test is differential: the reference interpreter, the Tcl
# compiler, cranelift-generic, and cranelift with -virtual-construction-opt
# 1 (its default) and 0 (the eager fold, which copies the prefix on every
# append) must agree. Decision tests pin which folds the analysis accepts
# and why it declines the rest; structural tests pin where materialization
# happens (NIR) and what it costs (the runtime's copy and allocation
# counters).

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]
source [file join $::projectRoot native native.tcl]

testConstraint nativeBuilt [expr {![catch {native::binary}]}]

set ::fvcBackends {interp compile cranelift-generic cranelift}

proc fvcHir {text} {
    return [surface::compile $text t.bot -strict 0 -warnings off]
}

# HIR's outcome on cranelift with virtual construction off: the eager fold.
proc fvcEager {hir} {
    resetEffects
    if {[catch {native::evalHir $hir -virtual-construction-opt 0} result options]} {
        return [list error [dict get $options -errorcode] $result $::testLog]
    }
    return [list value [core::value::show $result 1 1] $::testLog]
}

# The value of program TEXT, the same on every backend and with virtual
# construction on and off; else what differs. EXTRA names more backends
# (cranelift-unfused for a coroutine).
proc fvc {text {extra {}}} {
    set hir [fvcHir $text]
    if {[hir::diagnostics $hir] ne ""} {
        return "DIAGNOSTICS: [lmap d [hir::diagnostics $hir] {dict get $d kind}]"
    }
    set labels [concat $::fvcBackends $extra eager]
    set outcomes {}
    foreach label $labels {
        if {$label eq "eager"} {
            lappend outcomes [fvcEager $hir]
        } else {
            lappend outcomes [outcomeUnderHir $label $hir]
        }
    }
    if {[llength [lsort -unique $outcomes]] != 1} {
        return "DISAGREE: [join [lmap label $labels outcome $outcomes {list $label $outcome}] { / }]"
    }
    set outcome [lindex $outcomes 0]
    if {[lindex $outcome 0] eq "value"} {
        return [lindex $outcome 1]
    }
    return "ERROR [lindex $outcome 1]"
}

# One entry per fold of TEXT's used instances, in instance and expression
# order: "LABEL NAME plan FAMILY" for a plan fold, "LABEL NAME flat REASON"
# for one the analysis declines.
proc fvcDecisions {text} {
    set lowered [native::lower::program [fvcHir $text]]
    set spec [dict get $lowered specialization]
    set analysis [dict get $lowered construction]
    set out {}
    foreach id [dict get $spec used] {
        set view [dict get $analysis regions $id view]
        foreach e [dict get $analysis regions $id exprs] {
            if {[hir::kind $view $e] ni {loop listloop countloop lockloop} || ![hir::isFold $view $e]} {
                continue
            }
            set name [dict get [hir::binding $view [hir::get $view $e foldBinding]] name]
            set family [hir::construction::foldFamily $analysis $id $e]
            set label [hir::specialize::label $spec $id]
            if {$family ne ""} {
                lappend out [list $label $name plan $family]
            } else {
                lappend out [list $label $name flat [dict getdef $analysis foldWhy $id $e ?]]
            }
        }
    }
    return $out
}

# Just the plan/flat verdicts of fvcDecisions.
proc fvcVerdicts {text} {
    return [lmap d [fvcDecisions $text] {lindex $d 2}]
}

proc fvcNir {text {opt 1}} {
    return [native::nir [fvcHir $text] -virtual-construction-opt $opt -short-string-opt 0]
}

# The body of NIR function NAME (first match) in NIR text NIR.
proc fvcFunc {nir name} {
    regexp "func \\d+ \"$name\"\[^\\n\]*\\n(.*?)\\nend" $nir -> body
    return $body
}

proc fvcCount {nir pattern} {
    return [regexp -all -line $pattern $nir]
}

proc fvcReport {text opt} {
    return [native::allocationReport [fvcHir $text] summary 1 -virtual-construction-opt $opt -short-string-opt 0]
}

# The append fold of N elements: list-fold.bot's shape.
proc fvcAppendProgram {n} {
    return "import std::list

fn build(xs: List\[int\]) -> List\[int\]:
    fold x in xs with intermediate acc \[\]:
        acc.append(x * 3 + 1)

xs = loop i from 0 to $n:
    i
std::list::length(build(xs))
"
}

# The same construction as a self tail call (the plan parameter).
proc fvcRecursiveProgram {n} {
    return "import std::list

fn build_from(xs: List\[int\], i: int, acc: List\[int\]) -> List\[int\]:
    if i < 0 or i >= xs.length():
        return acc
    build_from(xs, i + 1, acc.append(xs.at(i) * 3 + 1))

xs = loop i from 0 to $n:
    i
std::list::length(build_from(xs, 0, \[\]))
"
}

# ---------------------------------------------------------------------------
# Values: the optimized fold means exactly what the eager fold means

test fvc-append {appending each element: the plan fold's value on every backend, with virtual construction on and off} -constraints nativeBuilt -body {
    set text {import std::list

fn f(xs: List[int]) -> List[int]:
    fold x in xs with intermediate acc []:
        acc.append(x)

[f([]), f([1]), f([1, 2, 3])]
}
    list [fvc $text] [fvcDecisions $text]
} -result {{[[], [1], [1, 2, 3]]} {{{f<List[never]>} acc plan list} {{f<List[int]>} acc plan list}}}

test fvc-nonempty-initial {an initial List with elements: its elements first, in order} -constraints nativeBuilt -body {
    fvc {import std::list

fn f(xs: List[int]) -> List[int]:
    fold x in xs with intermediate acc [100, 200]:
        acc.append(x)

[f([]), f([1, 2])]
}
} -result {[[100, 200], [100, 200, 1, 2]]}

test fvc-empty-domain {an empty domain or List[never] never runs the body: the initial value, which no extension copied} -constraints nativeBuilt -body {
    set text {import std::list

a = fold x in [] with intermediate acc [7]:
    acc.append(x)
b = fold i from 3 to 3 with intermediate acc [8]:
    acc.append(i)
[a, b]
}
    list [fvc $text] [fvcVerdicts $text]
} -result {{[[7], [8]]} {plan plan}}

test fvc-list-of-lists {a List[List[int]] intermediate: inner Lists (empty ones included) appended whole, never flattened} -constraints nativeBuilt -body {
    fvc {import std::list

fn f(xs: List[int]) -> List[List[int]]:
    fold x in xs with intermediate acc []:
        if x == 0:
            acc.append([])
        else:
            acc.append([x, -x])

f([1, 0, 2])
}
} -result {[[1, -1], [], [2, -2]]}

test fvc-computed-elements {appended elements computed by ordinary expressions and calls, evaluated in order} -constraints nativeBuilt -body {
    fvc {import std::list

fn square(x: int) -> int:
    x * x

fn f(xs: List[int]) -> List[int]:
    fold x in xs with intermediate acc []:
        acc.append(square(x) + 1)

f([1, 2, 3, 4])
}
} -result {[2, 5, 10, 17]}

test fvc-heap-elements {appended elements that are heap values: fresh Strings and Lists} -constraints nativeBuilt -body {
    fvc {import std::list
import std::str

fn f(xs: List[str]) -> List[str]:
    fold x in xs with intermediate acc []:
        acc.append(std::str::concat(x, "!"))

fn g(n: int) -> List[List[int]]:
    fold i from 0 to n with intermediate acc []:
        row = loop j from 0 to i:
            j
        acc.append(row)

[f(["a", "bé", "🙂"]), g(4)]
}
} -result {[["a!", "bé!", "🙂!"], [[], [0], [0, 1], [0, 1, 2]]]}

test fvc-conditional {a conditional append: an iteration either extends the intermediate or keeps it} -constraints nativeBuilt -body {
    set text {import std::list

fn keep(x: int) -> bool:
    x.mod(3) != 0

fn f(xs: List[int]) -> List[int]:
    fold x in xs with intermediate acc [0]:
        if keep(x):
            acc.append(x * 10)
        else:
            acc

f([1, 2, 3, 4, 5, 6, 7])
}
    list [fvc $text] [fvcVerdicts $text]
} -result {{[0, 10, 20, 40, 50, 70]} plan}

test fvc-unchanged {an iteration that keeps the intermediate unchanged, and one fold that never appends at all} -constraints nativeBuilt -body {
    fvc {import std::list

fn f(xs: List[int]) -> List[int]:
    fold x in xs with intermediate acc [1]:
        if x > 100:
            acc.append(x)
        else:
            acc

[f([1, 2, 3]), f([5, 500, 6, 600])]
}
} -result {[[1], [1, 500, 600]]}

test fvc-continue {continue keeps the current intermediate: before other body operations, and after them} -constraints nativeBuilt -body {
    set text {import std::list

fn f(xs: List[int]) -> List[int]:
    fold x in xs with intermediate acc []:
        if x == 0:
            continue
        y = x * 2
        if y > 10:
            continue
        acc.append(y)

f([1, 0, 2, 9, 3, 0])
}
    list [fvc $text] [fvcVerdicts $text]
} -result {{[2, 4, 6]} plan}

test fvc-break {a bare break ends the fold with the intermediate the iteration started with: no element of the breaking iteration} -constraints nativeBuilt -body {
    set text {import std::list

fn f(xs: List[int]) -> List[int]:
    fold x in xs with intermediate acc []:
        if x > 5:
            break
        acc.append(x)

[f([1, 2, 9, 3]), f([9]), f([1, 2])]
}
    list [fvc $text] [fvcVerdicts $text]
} -result {{[[1, 2], [], [1, 2]]} plan}

test fvc-break-continue {continue and break in one body, on every path of a List[List[int]] fold} -constraints nativeBuilt -body {
    fvc {import std::list

fn f(xs: List[int]) -> List[List[int]]:
    fold t in xs with intermediate done []:
        if t == 0:
            continue
        if t > 1000:
            break
        if t < 0:
            done.append([t]).append([-t])
        elif t == 1:
            done.append([])
        elif t == 2:
            done
        else:
            done.append([t, t + 1])

f([3, 0, -4, 1, 2, 5, 2000, 6])
}
} -result {[[3, 4], [-4], [4], [], [5, 6]]}

test fvc-positions {a plan fold in every value position: bound, returned, the last expression, an if value, top level} -constraints nativeBuilt -body {
    fvc {import std::list

fn bound(xs: List[int]) -> int:
    r = fold x in xs with intermediate acc []:
        acc.append(x)
    r.length()

fn returned(xs: List[int]) -> List[int]:
    return fold x in xs with intermediate acc []:
        acc.append(x + 1)

fn branch(xs: List[int], c: bool) -> List[int]:
    if c:
        fold x in xs with intermediate acc []:
            acc.append(x * 2)
    else:
        []

top = fold x in [4, 5] with intermediate acc []:
    acc.append(x)
[[bound([1, 2, 3])], returned([1, 2]), branch([1, 2], true), branch([1], false), top]
}
} -result {[[3], [2, 3], [2, 4], [], [4, 5]]}

test fvc-generic {an untyped generic function's fold, specialized twice: each instance carries its own plan} -constraints nativeBuilt -body {
    set text {import std::list

fn f(xs):
    fold x in xs with intermediate acc []:
        acc.append(x)

[f([1, 2]), f(["a", "b"])]
}
    list [fvc $text] [fvcDecisions $text]
} -result {{[[1, 2], ["a", "b"]]} {{{f<List[int]>} acc plan list} {{f<List[str]>} acc plan list}}}

test fvc-refined {refined elements keep their refinement through a plan fold} -constraints nativeBuilt -body {
    fvc {import std::list

type FvcPercent = Int in 0..100

fn clamp(n: int) -> FvcPercent:
    if n < 0:
        return 0
    if n > 100:
        return 100
    n

fn f(xs: List[int]) -> List[FvcPercent]:
    fold x in xs with intermediate acc []:
        acc.append(clamp(x))

fn need(ps: List[FvcPercent]) -> List[FvcPercent]:
    ps

need(f([-5, 50, 500]))
}
} -result {[0, 50, 100]}

test fvc-string {a String intermediate extended by concat: the same carrier rule, a String plan (ASCII, BMP and astral pieces)} -constraints nativeBuilt -body {
    set text {import std::str

fn f(xs: List[str]) -> str:
    fold x in xs with intermediate s "<":
        s.concat(x).concat(",")

[f([]), f(["a", "bé", "🙂"])]
}
    list [fvc $text] [fvcVerdicts $text]
} -result {{["<", "<a,bé,🙂,"]} {plan plan}}

test fvc-domains {every iteration form carries a plan: a counted range, down from, a lockstep, a MutableMap through the loop protocol (its skipped entries are continues)} -constraints nativeBuilt -body {
    set text {import std::list
import std::mutable_map

fn keys(m: std::mutable_map::MutableMap[str, int]) -> List[str]:
    fold e in m with intermediate acc []:
        acc.append(e.key)

fn build() -> std::mutable_map::MutableMap[str, int] errors std::mutable_map::KeyNotFound:
    m = std::mutable_map::create[str, int]()
    m.set("a", 1)
    m.set("b", 20)
    m.set("c", 300)
    m.remove("b")
    m

m = build():
    on std::mutable_map::KeyNotFound:
        std::mutable_map::create[str, int]()
a = fold i from 0 to 3 with intermediate acc ["s"]:
    acc.append("x")
b = fold i down from 3 through 1 with intermediate acc []:
    acc.append(i)
c = fold x in [1, 2, 3] and i from 0 to 3 with intermediate acc []:
    acc.append(x + i)
[[a.length()], b, c, [keys(m).length()]]
}
    list [fvc $text] [fvcVerdicts $text]
} -result {{[[4], [3, 2, 1], [1, 3, 5], [2]]} {plan plan plan plan}}

test fvc-nested-independent {nested folds with independent intermediates: each its own plan, never shared} -constraints nativeBuilt -body {
    set text {import std::list

fn f(xs: List[int]) -> List[List[int]]:
    fold x in xs with intermediate outer []:
        inner = fold y in [x, x + 1] with intermediate acc []:
            acc.append(y * 2)
        outer.append(inner)

f([1, 5, 9])
}
    list [fvc $text] [fvcVerdicts $text]
} -result {{[[2, 4], [10, 12], [18, 20]]} {plan plan}}

test fvc-inner-seeded {an inner fold seeded with the outer intermediate: the inner carries a plan, the outer (whose next value is a fold's, never a construction) stays flat} -constraints nativeBuilt -body {
    set text {import std::list

fn f(xs: List[int]) -> List[int]:
    fold x in xs with intermediate outer [0]:
        fold y in [x, x] with intermediate inner outer:
            inner.append(y)

f([1, 2, 3])
}
    list [fvc $text] [fvcDecisions $text]
} -result {{[0, 1, 1, 2, 2, 3, 3]} {{{f<List[int]>} outer flat {the next intermediate (the body's trailing value) is not a construction}} {{f<List[int]>} inner plan list}}}

test fvc-handoff-to-inner-fold {an outer plan fold's extended intermediate is an inner plan fold's initial value: the inner fold extends that one continuation, the outer one carries the inner's result on} -constraints nativeBuilt -body {
    set text {import std::list

fn f(xs: List[int], ws: List[int]) -> List[int]:
    fold x in xs with intermediate acc []:
        y = acc.append(x)
        z = fold w in ws with intermediate inner y:
            inner.append(w * 10)
        z.append(0)

[f([1, 2], [3, 4]), f([5], [])]
}
    list [fvc $text] [fvcVerdicts $text]
} -result {{[[1, 30, 40, 0, 2, 30, 40, 0], [5, 0]]} {plan plan plan plan}}

test fvc-in-outer-loop {a fold inside a collecting loop's body: a fresh plan per outer iteration, each result its own List} -constraints nativeBuilt -body {
    set text {import std::list

loop k from 0 to 3:
    fold x in [1, 2] with intermediate acc [k]:
        acc.append(x)
}
    list [fvc $text] [fvcVerdicts $text]
} -result {{[[0, 1, 2], [1, 1, 2], [2, 1, 2]]} plan}

test fvc-several-appends {several appends in one iteration: one in-place extension of the intermediate} -constraints nativeBuilt -body {
    fvc {import std::list

fn f(xs: List[int]) -> List[List[int]]:
    fold x in xs with intermediate acc []:
        acc.append([x]).append([]).append([x, x])

f([1, 2])
}
} -result {[[1], [], [1, 1], [2], [], [2, 2]]}

test fvc-return-path {a return from the body: the intermediate extended and returned, the fold abandoned} -constraints nativeBuilt -body {
    fvc {import std::list

fn f(xs: List[int]) -> List[int]:
    fold x in xs with intermediate acc []:
        if x < 0:
            return acc.append(99)
        acc.append(x)

[f([1, 2]), f([1, -1, 2])]
}
} -result {[[1, 2], [1, 99]]}

test fvc-plan-initial {the initial value is itself a construction (a plan local): it seeds the intermediate's plan} -constraints nativeBuilt -body {
    fvc {import std::list

fn f(xs: List[int], base: List[int]) -> List[int]:
    start = base.append(0)
    fold x in xs with intermediate acc start:
        acc.append(x)

[f([1, 2], [7]), f([], [8])]
}
} -result {[[7, 0, 1, 2], [8, 0]]}

test fvc-shared-initial {the initial List is shared with another binding: the fold never modifies it} -constraints nativeBuilt -body {
    set text {import std::list

fn f(xs: List[int], base: List[int]) -> List[List[int]]:
    r = fold x in xs with intermediate acc base:
        acc.append(x)
    s = fold x in xs with intermediate acc base:
        acc.append(-x)
    [base, r, s]

f([1, 2], [7])
}
    list [fvc $text] [fvcVerdicts $text]
} -result {{[[7], [7, 1, 2], [7, -1, -2]]} {plan plan}}

test fvc-retained-element {an appended element that is retained elsewhere stays an ordinary shared value} -constraints nativeBuilt -body {
    fvc {import std::list

fn f(xs: List[int]) -> List[List[int]]:
    r = fold x in xs with intermediate acc []:
        acc.append(xs)
    r.append(xs)

f([1, 2])
}
} -result {[[1, 2], [1, 2], [1, 2]]}

test fvc-element-error {an error while evaluating an appended element leaves the fold; a caller handles it with a value of its own} -constraints nativeBuilt -body {
    fvc {import std::list

error FvcBad

fn check(x: int) -> int errors FvcBad:
    if x == 2:
        fail FvcBad
    x

fn f(xs: List[int]) -> List[int] errors FvcBad:
    fold x in xs with intermediate acc []:
        acc.append(check(x))

fn g(xs: List[int]) -> List[int]:
    r = f(xs):
        on FvcBad:
            [-1]
    r

[g([1, 3]), g([1, 2, 3])]
}
} -result {[[1, 3], [-1]]}

test fvc-error-before-commit {an error after the next intermediate is computed but before the body completes: nothing is committed, the caller's handler value wins} -constraints nativeBuilt -body {
    set text {import std::list

error FvcLate

fn check(x: int) -> int errors FvcLate:
    if x == 2:
        fail FvcLate
    x

fn f(xs: List[int]) -> List[int] errors FvcLate:
    fold x in xs with intermediate acc []:
        y = acc.append(x)
        check(x)
        y

fn g(xs: List[int]) -> List[int]:
    r = f(xs):
        on FvcLate:
            [-1]
    r

[g([1, 3]), g([1, 2, 3])]
}
    list [fvc $text] [fvcVerdicts $text]
} -result {{[[1, 3], [-1]]} plan}

test fvc-handled-in-body {a handled call in the body is an ordinary completion} -constraints nativeBuilt -body {
    fvc {import std::list

error FvcOdd

fn check(x: int) -> int errors FvcOdd:
    if x.mod(2) == 1:
        fail FvcOdd
    x

fn f(xs: List[int]) -> List[int]:
    fold x in xs with intermediate acc []:
        y = check(x):
            on FvcOdd:
                0
        acc.append(y)

f([1, 2, 3, 4])
}
} -result {[0, 2, 0, 4]}

test fvc-discarded {a plan fold whose own value is discarded still runs its body} -constraints nativeBuilt -body {
    set text {import std::list
import std::mutable_vector

fn note(place log: MutableVector[int], n: int) -> int:
    log.push(n)
    n

fn f(xs: List[int]) -> List[int]:
    log = std::mutable_vector::from_list([0])
    log.clear()
    fold x in xs with intermediate acc []:
        acc.append(note(log, x))
    loop v in log:
        v

f([3, 1, 2])
}
    list [fvc $text] [fvcVerdicts $text]
} -result {{[3, 1, 2]} plan}

test fvc-flat-composition {std::list::flat of a plan fold's result: flat sees an ordinary completed List, the fold's result is also returned, inspected, stored and passed on} -constraints nativeBuilt -body {
    fvc {import std::list

fn expand(x: int) -> List[int]:
    [x, x + 1]

fn chunks(xs: List[int]) -> List[List[int]]:
    fold x in xs with intermediate acc []:
        acc.append(expand(x))

fn count(cs: List[List[int]]) -> int:
    cs.length()

cs = chunks([1, 5, 9])
second = std::list::at(cs, 1):
    on IndexNotFound:
        []
[std::list::flat(cs), std::list::flat(chunks([])), [count(cs), cs.length()], second]
}
} -result {[[1, 2, 5, 6, 9, 10], [], [3, 3], [5, 6]]}

test fvc-coroutine {a yield inside a plan fold's body: the plan survives the suspension, fused and on the general runtime} -constraints nativeBuilt -body {
    set text {import std::list
import std::coroutine

fn running(xs: List[int]) -> List[int]:
    fold x in xs with intermediate acc []:
        yield [x * 10]
        acc.append(x)

fn drive() -> List[List[int]]:
    coroutine {step, first} = running([1, 2, 3])
    a = step()
    b = step()
    c = step()
    [first, a, b, c]

drive()
}
    list [fvc $text cranelift-unfused] [fvcVerdicts $text]
} -result {{[[10], [20], [30], [1, 2, 3]]} plan}

# ---------------------------------------------------------------------------
# Rejected: an intermediate whose earlier version is observable stays flat

test fvc-reject-break-after-append {an append computed before a break is never committed: the break passes the old intermediate on, a second reference, so the fold stays flat} -constraints nativeBuilt -body {
    set text {import std::list

fn f(xs: List[int]) -> List[int]:
    fold x in xs with intermediate acc []:
        y = acc.append(x)
        if x > 5:
            break
        y

f([1, 2, 9, 3])
}
    list [fvc $text] [fvcDecisions $text]
} -result {{[1, 2]} {{{f<List[int]>} acc flat {fork: referenced more than once on some path of an iteration (continue and break included)}}}}

test fvc-reject-continue-after-append {an append computed before a continue is discarded: the continue carries the old intermediate, so the fold stays flat} -constraints nativeBuilt -body {
    set text {import std::list

fn f(xs: List[int]) -> List[int]:
    fold x in xs with intermediate acc []:
        y = acc.append(x)
        if x == 2:
            continue
        y

f([1, 2, 9, 3])
}
    list [fvc $text] [fvcVerdicts $text]
} -result {{[1, 9, 3]} flat}

test fvc-reject-break-after-materialized {an append materialized (observed) before a break: the break passes the old intermediate on, so the fold stays flat (counting the break as a reference is what keeps the plan from being consumed twice)} -constraints nativeBuilt -body {
    set text {import std::list

fn f(xs: List[int]) -> List[int]:
    fold x in xs with intermediate acc []:
        y = acc.append(x)
        if y.length() > 3:
            break
        y.append(0)

f([1, 2, 9, 3])
}
    list [fvc $text] [fvcVerdicts $text]
} -result {{[1, 0, 2, 0]} flat}

test fvc-reject-continue-after-materialized {an append materialized (observed) before a continue: the continue carries the old intermediate on, so the fold stays flat} -constraints nativeBuilt -body {
    set text {import std::list

fn f(xs: List[int]) -> List[int]:
    fold x in xs with intermediate acc []:
        y = acc.append(x)
        if x == y.length():
            continue
        y.append(0)

f([1, 2, 9, 3])
}
    list [fvc $text] [fvcVerdicts $text]
} -result {{[2, 0, 9, 0, 3, 0]} flat}

