test fvc-scalar-and-struct-folds {an Int fold and a struct fold (with List fields) are never plan folds: their NIR has no construction plan} -constraints nativeBuilt -body {
    set text {import std::list

struct FvcChunks:
    done: List[List[int]]
    current: List[int]

fn total(xs: List[int]) -> int:
    fold x in xs with intermediate s 0:
        s + x

fn chunks(xs: List[int]) -> List[List[int]]:
    c = fold t in xs with intermediate st FvcChunks {done: [], current: []}:
        if t == 0:
            FvcChunks {done: st.done.append(st.current), current: []}
        else:
            FvcChunks {done: st.done, current: st.current.append(t)}
    c.done.append(c.current)

[[total([1, 2, 3])], chunks([1, 2, 0, 3])]
}
    set nir [fvcNir $text]
    list [fvc $text] [fvcDecisions $text] \
        [fvcCount [fvcFunc $nir total] {construct|planregs}] \
        [fvcCount [fvcFunc $nir chunks] {construct list plan}]
} -result {{[[6], [[1, 2], [3]]]} {{{total<List[int]>} s flat {not statically String/List-typed at every reference}} {{chunks<List[int]>} st flat {not statically String/List-typed at every reference}}} 0 0}

# ---------------------------------------------------------------------------
# Structure: where the plan lives and where it is materialized

test fvc-nir-carried {the NIR of an append fold: one in-place extension per iteration into a declared plan register, one materialization at exhaustion, no eager listappend} -constraints nativeBuilt -body {
    set nir [fvcNir [fvcAppendProgram 10]]
    set body [fvcFunc $nir build]
    regexp {func \d+ "build"[^\n]*planregs="([^"]*)"} $nir -> planregs
    regexp -line {^\s*(%\d+) = construct list plan (%\d+) elem} $body -> next acc
    list [fvcCount $body {= construct list plan %\d+ elem %\d+}] [fvcCount $body {= construct list flat %\d+}] \
        [fvcCount $body {op listappend}] [expr {[string range $acc 1 end] in $planregs}] \
        [fvcCount $body "^\\s*$acc = move $next"]
} -result {1 1 0 1 1}

test fvc-nir-break {a break materializes the intermediate where it leaves, as exhaustion does: two flat constructs of the plan register, one per exit} -constraints nativeBuilt -body {
    set body [fvcFunc [fvcNir {import std::list

fn f(xs: List[int]) -> List[int]:
    fold x in xs with intermediate acc []:
        if x > 5:
            break
        acc.append(x)

f([1, 9])
}] f]
    regexp -line {^\s*%\d+ = construct list plan (%\d+) elem} $body -> acc
    list [fvcCount $body "= construct list flat ${acc}( |\$)"] [fvcCount $body {op listappend}]
} -result {2 0}

test fvc-nir-off {-virtual-construction-opt 0: the eager fold, one listappend per iteration and no construction at all} -constraints nativeBuilt -body {
    set body [fvcFunc [fvcNir [fvcAppendProgram 10] 0] build]
    list [fvcCount $body {construct}] [fvcCount $body {op listappend}]
} -result {0 1}

test fvc-nir-flat-separate {std::list::flat of a fold stays two operations: the fold's one materialization, then one listflat, no fusion} -constraints nativeBuilt -body {
    set nir [fvcNir {import std::list

fn chunks(xs: List[int]) -> List[int]:
    cs = fold x in xs with intermediate acc []:
        acc.append([x, x])
    std::list::flat(cs)

chunks([1, 2])
}]
    set body [fvcFunc $nir chunks]
    list [fvcCount $body {construct list plan}] [fvcCount $body {construct list flat}] [fvcCount $body {op listflat}]
} -result {1 1 1}

test fvc-types-unchanged {expression types, instance keys and function counts are identical with virtual construction on and off} -constraints nativeBuilt -body {
    set text {import std::list
import std::str

fn f(xs):
    fold x in xs with intermediate acc []:
        if x == 0:
            continue
        acc.append(x)

fn g(xs: List[str]) -> str:
    fold x in xs with intermediate s "":
        s.concat(x)

[f([1, 0, 2]), f(["a"]), [g(["x", "y"])]]
}
    set hir [fvcHir $text]
    set facts {}
    foreach opt {0 1} {
        set lowered [native::lower::program $hir -virtual-construction-opt $opt -short-string-opt 0]
        set spec [dict get $lowered specialization]
        set types {}
        foreach id [dict get $spec used] {
            set view [hir::specialize::view $hir $spec $id]
            foreach e [dict get $spec context exprs [dict get $spec instances $id block]] {
                lappend types [list $e [hir::types::show [hir::typeOf $view $e]]]
            }
        }
        lappend facts [list [lsort [lmap id [dict get $spec used] {hir::specialize::label $spec $id}]] \
            [llength [dict get $lowered functions]] $types]
    }
    list [expr {[lindex $facts 0] eq [lindex $facts 1]}] [lindex $facts 0 1]
} -result {1 4}

test fvc-explain {hir::construction::explain names the plan fold} -constraints nativeBuilt -body {
    set hir [fvcHir [fvcAppendProgram 4]]
    set lowered [native::lower::program $hir]
    regexp -inline {build<List\[int\]> \(i\d+\):\n  fold intermediate acc \(b\d+ of e\d+\): a list plan carried across iterations} \
        [hir::construction::explain $hir [dict get $lowered specialization] [dict get $lowered construction]]
} -match regexp -result {^\{build<List\[int\]> \(i\d+\):\n  fold intermediate acc \(b\d+ of e\d+\): a list plan carried across iterations\}$}

# ---------------------------------------------------------------------------
# Cost: repeated-prefix copying is gone

test fvc-copies-linear {the append fold copies linearly (N and 4N) with a constant number of Lists; the eager fold copies quadratically, one List per append} -constraints nativeBuilt -body {
    set rows {}
    foreach n {500 2000} {
        set text [fvcAppendProgram $n]
        set on [fvcReport $text 1]
        set off [fvcReport $text 0]
        lappend rows [list [dict get $on copies listElements] [dict get $off copies listElements] \
            [dict get $on byKind List allocations] [dict get $off byKind List allocations] \
            [dict get $on construction materializations]]
    }
    lassign $rows small large
    list [expr {[lindex $large 0] <= 5 * [lindex $small 0]}] [expr {[lindex $large 1] >= 15 * [lindex $small 1]}] \
        [expr {[lindex $small 2] == [lindex $large 2]}] [expr {[lindex $large 3] >= 2000}] [lindex $large 4]
} -result {1 1 1 1 2}

test fvc-matches-recursion {the fold's construction costs exactly what the self tail call's plan parameter costs: the same Lists, plans, extensions and copied elements} -constraints nativeBuilt -body {
    set rows {}
    foreach text [list [fvcAppendProgram 1000] [fvcRecursiveProgram 1000]] {
        set r [fvcReport $text 1]
        lappend rows [list [dict get $r byKind List allocations] [dict get $r byKind ListPlan allocations] \
            [dict get $r construction extensions] [dict get $r construction materializations] \
            [dict get $r copies listElements]]
    }
    list [expr {[lindex $rows 0] eq [lindex $rows 1]}] [lindex $rows 0 0] [lindex $rows 0 3]
} -result {1 4 2}

test fvc-string-copies {a String fold's bytes are copied linearly too} -constraints nativeBuilt -body {
    set template {import std::str

fn build(n: int) -> str:
    fold i from 0 to n with intermediate s "":
        s.concat("ab")

std::str::length(build(%N%))
}
    set copies {}
    foreach n {500 2000} {
        set text [string map [list %N% $n] $template]
        lappend copies [dict get [fvcReport $text 1] copies stringBytes] [dict get [fvcReport $text 0] copies stringBytes]
    }
    lassign $copies smallOn smallOff largeOn largeOff
    list [expr {$largeOn <= 5 * $smallOn}] [expr {$largeOff >= 15 * $smallOff}]
} -result {1 1}

# ---------------------------------------------------------------------------
# Runtime safety: GC roots, releases, executables

test fvc-gc-stress {plan folds holding fresh heap elements, nested and broken off, under GC stress (a collection at every allocation)} -constraints nativeBuilt -body {
    set text {import std::list
import std::str

fn f(xs: List[str]) -> List[List[str]]:
    fold x in xs with intermediate outer []:
        if x == "stop":
            break
        inner = fold i from 0 to 3 with intermediate acc []:
            acc.append(std::str::concat(x, std::str::substring("0123", i, i + 1)))
        outer.append(inner)

r = f(["a", "bé", "🙂", "stop", "z"])
[r.length(), std::list::flat(r)]
}
    set ::env(BOTLISH_NATIVE_GC_STRESS) 1
    try {
        list [fvc $text] [fvcVerdicts $text]
    } finally {
        unset ::env(BOTLISH_NATIVE_GC_STRESS)
    }
} -result {{[3, ["a0", "a1", "a2", "bé0", "bé1", "bé2", "🙂0", "🙂1", "🙂2"]]} {plan plan}}

test fvc-release-in-body {an affine value that dies mid-body of a plan fold is released after its last use (SequenceTo releases, as Sequence does)} -constraints {nativeBuilt nativeCoroutines} -body {
    set text {import std::list
import std::coroutine

fn gen(n: int) -> int:
    yield n
    n + 1

fn f(xs: List[int]) -> List[int]:
    fold x in xs with intermediate acc []:
        coroutine {step, first} = gen(x)
        v = step()
        acc.append(first + v)

f([1, 2, 3])
}
    withoutCoroutineFusion {
        set report [native::allocationReport [fvcHir $text] summary 1]
    }
    list [fvc $text] [fvcVerdicts $text] [dict get $report coroutines released]
} -result {{[3, 5, 7]} plan 3}

test fvc-release-plan-join {the same fix outside folds: a plan-family if branch of a recurrence releases its coroutine (the eager lowering always did)} -constraints {nativeBuilt nativeCoroutines} -body {
    set text {import std::list
import std::coroutine

fn gen(n: int) -> int:
    yield n
    n + 1

fn build(xs: List[int], i: int, acc: List[int]) -> List[int]:
    if i < 0 or i >= xs.length():
        return acc
    next = if xs.at(i) > 0:
        coroutine {step, first} = gen(xs.at(i))
        v = step()
        acc.append(first + v)
    else:
        acc
    build(xs, i + 1, next)

build([1, 2, 3], 0, [])
}
    set released {}
    withoutCoroutineFusion {
        foreach opt {0 1} {
            lappend released [dict get [fvcReport $text $opt] coroutines released]
        }
    }
    list [fvc $text] $released
} -result {{[3, 5, 7]} {3 3}}

proc fvcAotParity {text} {
    set dir [makeDirectory {fold virtual construction executable test}]
    set path [file join $dir program.bot]
    set channel [open $path w]
    fconfigure $channel -encoding utf-8 -translation lf
    puts $channel $text
    close $channel
    try {
        set hir [surface::readProgramFile $path -warnings off]
        set values {}
        foreach backend $::fvcBackends {
            set outcome [outcomeUnderHir $backend $hir]
            if {[lindex $outcome 0] ne "value"} { error "$backend: $outcome" }
            lappend values [lindex $outcome 1]
        }
        exec [info nameofexecutable] [file join $::projectRoot main.tcl] -warnings off -emit-native-executable $path
        lappend values [runStandalone [file rootname $path]]
        lappend values [runStandalone [file rootname $path] BOTLISH_NATIVE_GC_STRESS 1]
        if {[llength [lsort -unique $values]] != 1} { error "values disagree: $values" }
        return [lindex $values 0]
    } finally {
        removeDirectory {fold virtual construction executable test}
    }
}

test fvc-executable {plan folds of Lists, Lists of Lists and Strings, with continue and break, in a standalone executable, plain and under GC stress} -constraints executableAot -body {
    fvcAotParity {import std::list
import std::str

fn chunks(xs: List[int]) -> List[List[int]]:
    fold t in xs with intermediate done []:
        if t == 0:
            continue
        if t > 100:
            break
        done.append([t, t * t])

fn text(xs: List[int]) -> str:
    fold x in xs with intermediate s "":
        s.concat("é").concat("!")

cs = chunks([1, 0, 2, 3, 500, 4])
[cs.length(), std::list::flat(cs).length(), text([1, 2, 3]).length()]
}
} -result {[3, 6, 6]}

cleanupTests
