test fvc-reject-retained {the intermediate retained in another List and passed to a retaining function, then extended: two uses} -constraints nativeBuilt -body {
    set text {import std::list
import std::mutable_vector

fn keep(place log: MutableVector[List[int]], l: List[int]) -> int:
    log.push(l)
    l.length()

fn f(xs: List[int]) -> List[List[int]]:
    log = std::mutable_vector::from_list([[0]])
    log.clear()
    r = fold x in xs with intermediate acc []:
        n = keep(log, acc)
        acc.append(n)
    s = fold x in xs with intermediate acc []:
        held = [acc]
        acc.append(held.length())
    snapshots = loop v in log:
        v
    snapshots.append(r).append(s)

f([5, 6, 7])
}
    list [fvc $text] [fvcVerdicts $text]
} -result {{[[], [0], [0, 1], [0, 1, 2], [1, 1, 1]]} {flat flat}}

test fvc-reject-retained-only {the intermediate's only use stores it (a retaining place parameter): every use needs a flat value, so no plan is built, although the next intermediate is a construction} -constraints nativeBuilt -body {
    set text {import std::list
import std::mutable_vector

fn keep(place log: MutableVector[List[int]], l: List[int]) -> int:
    log.push(l)
    l.length()

fn f(xs: List[int]) -> List[List[int]]:
    log = std::mutable_vector::from_list([[0]])
    log.clear()
    last = fold x in xs with intermediate acc [1]:
        n = keep(log, acc)
        [x].append(n)
    snapshots = loop v in log:
        v
    snapshots.append(last)

f([5, 6])
}
    list [fvc $text] [fvcDecisions $text]
} -result {{[[1], [5, 1], [6, 2]]} {{{f<List[int]>} acc flat {every use needs a flat value}}}}

