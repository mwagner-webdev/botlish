# mutarray-construction.test -- MutableArray construction and refinement
# (MUTABLEARRAY-CONSTRUCTION-REFINEMENT.md): mutable_array::from_list (a
# registered native since MUTABLE-ARRAY.md, core/mutarray.tcl) and the
# mutarray? type test (core/predicates.tcl).
#
# `mutarray` is Botlish's one static/runtime kind for a MutableArray. This
# milestone makes it an ordinary first-class construction/refinement fact:
# a constructor call is statically `mutarray`, `mutarray?` refines like
# integer?/string?/list?, and ordinary homogeneous List typing carries it
# (List[mutarray], list::at -> mutarray). What must NOT happen is pinned just
# as hard: no MutableArray[T], no per-slot typing, no positional record
# schema, no cast, no exact facts about a MutableArray's contents.
#
# Sections: registry metadata audit, construction typing, function result
# propagation, joins, List[mutarray] propagation, the mutarray? predicate
# (metadata, refinement, path-sensitive inference), negative controls,
# from_list semantics (differential across every backend), the predicate on
# every backend, no MutableArray-specific special cases.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]

interp recursionlimit {} 100000

set parityBackends {interp compile cranelift-generic cranelift}

proc mcCompile {src {strict 1}} {
    set path [makeFile $src mc-program.bot]
    try {
        surface::readProgramFile $path -strict $strict
    } finally {
        removeFile mc-program.bot
    }
}

# {ERRORCODE MATCHED} for a program rejected at compile time, else "accepted".
proc mcRejects {src pattern} {
    if {![catch {mcCompile $src} message options]} {
        return "accepted"
    }
    set code [lrange [dict get $options -errorcode] 0 2]
    list $code [string match $pattern $message]
}

# The expressions of IDS that come from the program's own file (`import
# mutable_array` loads the module, whose function bodies are in the HIR too).
proc mcOwn {hir ids} {
    set file [dict get $hir exprs [lindex [hir::roots $hir] end] origin file]
    lmap e $ids {
        if {[dict get $hir exprs $e origin file] ne $file} continue
        set e
    }
}

# The semantic type of the last top-level expression of SRC.
proc mcLast {src} {
    set hir [mcCompile $src]
    hir::types::show [hir::typeOf $hir [lindex [hir::roots $hir] end]]
}

proc mcBlock {hir name} {
    dict for {b binding} [dict get $hir bindings] {
        if {[dict get $binding name] ne $name || [dict get $binding declaredBy] eq ""} continue
        set value [hir::get $hir [dict get $binding declaredBy] value]
        if {[hir::kind $hir $value] eq "block"} { return $value }
    }
    error "no function named $name"
}

# The inferred result type of function NAME of SRC.
proc mcResult {src name} {
    set hir [mcCompile $src]
    set type [hir::typeOf $hir [mcBlock $hir $name]]
    string trim [lindex [split [hir::types::show $type] >] end]
}

# "PARAM: TYPE (SOURCE KIND)" for each parameter of function NAME.
proc mcSig {src name} {
    set hir [mcCompile $src]
    set sig [hir::signatures::of $hir [mcBlock $hir $name]]
    lmap p [dict get $sig params] {
        set kind ""
        if {[dict get $p source] eq "inferred"} {
            set kind [expr {[dict get $p trusted] ne {} ? " trusted" : " checked"}]
        }
        format {%s: %s (%s%s)} [dict get $p name] [hir::types::show [hir::signatures::paramType $p]] \
            [dict get $p source] $kind
    }
}

# "same" if every backend agrees on the outcome of source SRC; otherwise every
# outcome, backend by backend.
proc mcParity {src} {
    set exprs [hir::lower [mcCompile $src 0]]
    set outcomes [lmap backend $::parityBackends {outcomeUnder $backend $exprs}]
    if {[llength [lsort -unique $outcomes]] == 1} {
        return same
    }
    return [join [lmap backend $::parityBackends outcome $outcomes {list $backend $outcome}] " / "]
}

# The shown value of SRC under the reference interpreter.
proc mcValue {src} {
    set exprs [hir::lower [mcCompile $src 0]]
    lindex [outcomeUnder interp $exprs] 1
}

# ---------------------------------------------------------------------------
# Registry metadata audit (spec items 6, 51-53): every MutableArray native's
# parameter and result metadata, from the authoritative registry.

proc mcMeta {name} {
    set m [core::native::metadata $name]
    list [dict get $m paramTypes] [dict get $m resultType]
}

test mutarray-meta-1 {mutable_array::allocate is the constructor: result type mutarray} -body {
    mcMeta mutable_array::allocate
} -result {int mutarray}

test mutarray-meta-2 {every operation that needs a MutableArray says so in its parameter metadata} -body {
    lmap n {mutable_array::capacity mutable_array::at mutable_array::set mutable_array::copy mutable_array::freeze} {
        list $n [mcMeta $n]
    }
} -result {{mutable_array::capacity {mutarray int}} {mutable_array::at {{mutarray int} any}} {mutable_array::set {{mutarray int any} unit}} {mutable_array::copy {{mutarray int mutarray int int} unit}} {mutable_array::freeze {{mutarray int} list}}}

test mutarray-meta-3 {the operations registered to return the raw kind: allocate (raw), the consuming identity, and the constructors, which a -result-shape types at each call (MUTABLE-ARRAY.md)} -body {
    lmap n [lsort [core::native::names]] {
        if {[dict get [core::native::metadata $n] resultType] eq "mutarray"} {
            list $n [dict get [core::native::metadata $n] resultShape]
        } else continue
    }
} -result {{mutable_array#consume {same 0}} {mutable_array#generate_drop {mutarray-generate 1}} {mutable_array::allocate {}} {mutable_array::create {mutarray-create 1}} {mutable_array::from_list {mutarray-from-list 0}} {mutable_array::generate {mutarray-generate 1}}}

test mutarray-meta-4 {mutable_array::set returns unit and get returns any: results unchanged} -body {
    list [lindex [mcMeta mutable_array::set] 1] [lindex [mcMeta mutable_array::at] 1]
} -result {unit any}

test mutarray-meta-5 {mutarray? is a registered type test: any -> bool, refines argument 0 to mutarray} -body {
    set m [core::native::metadata mutarray?]
    list [dict get $m paramTypes] [dict get $m resultType] [dict get $m testsType] \
        [dict get $m refinesTrue] [dict get $m refinesFalse] [dict get $m runtime]
} -result {any bool mutarray {0 mutarray} {} {}}

test mutarray-meta-6 {mutarray? has exactly the shape of its sibling kind predicates} -body {
    set shape {m {lmap k {arity paramTypes resultType runtime resultShape resultRange contextFree} {dict get $m $k}}}
    expr {[apply $shape [core::native::metadata mutarray?]] eq [apply $shape [core::native::metadata list?]]}
} -result 1

# ---------------------------------------------------------------------------
# Construction typing (spec items 7-11, 19, 55-57, 62)

# PARAMETERIZED-MUTABLEARRAY.md: from_list is now the typed constructor
# (List[T] -> MutableArray[T]); the raw kind is `mutarray`, which
# mutable_array::allocate still returns.
test mutarray-type-1 {m = mutable_array::from_list(xs) is MutableArray[int] for xs : List[int]} -body {
    mcLast "import mutable_array\nxs = \[1, 2, 3\]\nm = mutable_array::from_list(xs)\nm"
} -result {MutableArray[int]}

test mutarray-type-2 {an immutable alias keeps the type} -body {
    mcLast "import mutable_array\nm = mutable_array::from_list(\[1, 2, 3\])\nn = m\nn"
} -result {MutableArray[int]}

test mutarray-type-3 {the source List stays an ordinary List[int]} -body {
    mcLast "import mutable_array\nxs = \[1, 2, 3\]\nm = mutable_array::from_list(xs)\nxs"
} -result {List[int]}

test mutarray-type-4 {the low-level constructor is mutarray as before} -body {
    mcLast "import mutable_array\nmutable_array::allocate(3)"
} -result mutarray

test mutarray-type-5 {a heterogeneous source List gives MutableArray[any]} -body {
    mcLast "import mutable_array\nmutable_array::from_list(\[\"x\", 1, true\])"
} -result {MutableArray[any]}

test mutarray-type-6 {the empty List gives MutableArray[any]} -body {
    mcLast "import mutable_array\nmutable_array::from_list(\[\])"
} -result {MutableArray[any]}

test mutarray-type-7 {slot reads of a typed array take the element type; raw arrays stay any} -body {
    list [mcLast "import mutable_array\nm = mutable_array::from_list(\[1, 2, 3\])\nmutable_array::at(m, 0)"] \
        [mcLast "import mutable_array\nm = mutable_array::allocate(3)\nmutable_array::at(m, 0)"]
} -result {int any}

test mutarray-type-8 {only the applied spelling exists: bare MutableArray and hyphenated spellings are rejected} -body {
    lmap src {
        "fn f(m: MutableArray):\n    0\nf(1)"
        "fn f(m: MutableArray[int]):\n    0\nf(1)"
        "fn f(m: mutable-array):\n    0\nf(1)"
    } {expr {[mcRejects $src *] eq "accepted" ? "accepted" : "rejected"}}
} -result {rejected rejected rejected}

test mutarray-type-9 {a mutarray parameter annotation accepts the raw constructor result and a typed array (the raw kind is MutableArray[any]; the parameter holds a copy)} -body {
    list [mcLast "import mutable_array\nfn cap(m: mutarray) -> int:\n    mutable_array::capacity(m)\ncap(mutable_array::allocate(2))"] \
        [mcLast "import mutable_array\nfn cap(m: mutarray) -> int:\n    mutable_array::capacity(m)\ncap(mutable_array::from_list(\[1, 2\]))"]
} -result {int int}

test mutarray-type-10 {mutable_array::from_list is a registered native: a list parameter, the raw mutarray substrate result, and the -result-shape that types its call sites} -body {
    set meta [core::native::metadata mutable_array::from_list]
    list [dict get $meta paramTypes] [dict get $meta resultType] [dict get $meta resultShape] \
        [mcLast "import mutable_array\nmutable_array::from_list(\[1\])"]
} -result {list mutarray {mutarray-from-list 0} {MutableArray[int]}}

# ---------------------------------------------------------------------------
# Function result propagation, forwarding, joins (spec items 55-58)

test mutarray-fn-1 {fn make(): mutable_array::from_list(...) infers MutableArray[int] with no annotation} -body {
    mcResult "import mutable_array\nfn make():\n    mutable_array::from_list(\[1, 2, 3\])\nmake()" make
} -result {MutableArray[int]}

test mutarray-fn-2 {forwarding keeps MutableArray[int]} -body {
    mcResult "import mutable_array\nfn make():\n    mutable_array::from_list(\[1, 2, 3\])\nfn forward():\n    make()\nforward()" forward
} -result {MutableArray[int]}

test mutarray-fn-3 {a function returning a bound constructor result infers MutableArray[int]} -body {
    mcResult "import mutable_array\nfn make():\n    m = mutable_array::from_list(\[1\])\n    mutable_array::set(m, 0, 2)\n    m\nmake()" make
} -result {MutableArray[int]}

test mutarray-fn-4 {a function returning the low-level constructor infers mutarray} -body {
    mcResult "import mutable_array\nfn make(n):\n    mutable_array::allocate(n)\nmake(3)" make
} -result mutarray

test mutarray-join-1 {same-contract branches join to that MutableArray through ordinary lub; raw branches to mutarray} -body {
    list [mcResult "import mutable_array\nfn a():\n    mutable_array::from_list(\[1\])\nfn b():\n    mutable_array::from_list(\[2\])\nfn pick(c):\n    if c:\n        a()\n    else:\n        b()\npick(true)" pick] \
        [mcResult "import mutable_array\nfn a():\n    mutable_array::allocate(1)\nfn b():\n    mutable_array::allocate(2)\nfn pick(c):\n    if c:\n        a()\n    else:\n        b()\npick(true)" pick]
} -result {{MutableArray[int]} mutarray}

test mutarray-join-2 {a mixed join uses the existing fallback (no union type)} -body {
    mcResult "import mutable_array\nfn a():\n    mutable_array::allocate(1)\nfn pick(c):\n    if c:\n        a()\n    else:\n        \[\]\npick(true)" pick
} -result any

test mutarray-join-3 {a join with an unknown value is not mutarray} -body {
    mcResult "import mutable_array\nfn pick(c, other):\n    if c:\n        mutable_array::allocate(1)\n    else:\n        other\npick(true, 1)" pick
} -result any

# ---------------------------------------------------------------------------
# List[mutarray] propagation (spec items 20-25, 43-45)

test mutarray-list-1 {a literal of constructor results is List[mutarray]} -body {
    mcLast "import mutable_array\nrows = \[mutable_array::from_list(\[1\]), mutable_array::from_list(\[2\]), mutable_array::from_list(\[3\])\]\nrows"
} -result {List[MutableArray[int]]}

test mutarray-list-1b {a literal of raw constructor results is List[mutarray]} -body {
    mcLast "import mutable_array\nrows = \[mutable_array::allocate(1), mutable_array::allocate(2)\]\nrows"
} -result {List[mutarray]}

test mutarray-list-2 {list::at with a dynamic index is the element contract} -body {
    mcResult "import list\nimport mutable_array\nrows = \[mutable_array::from_list(\[1\]), mutable_array::from_list(\[2\])\]\nfn row(i) errors IndexNotFound:\n    list::at(rows, i)\nrow(1)" row
} -result {MutableArray[int]}

test mutarray-list-3 {list::at through a function-returned List[mutarray] is mutarray} -body {
    mcResult "import list\nimport mutable_array\nfn mk():\n    mutable_array::allocate(3)\nfn rows():\n    \[mk(), mk(), mk()\]\nfn row(i) errors IndexNotFound:\n    list::at(rows(), i)\nv = row(1):\n    on IndexNotFound:\n        mutable_array::allocate(0)\nv" row
} -result mutarray

test mutarray-list-4 {list::append preserves List[MutableArray[int]]} -body {
    mcLast "import list\nimport mutable_array\nrows = list::append(\[mutable_array::from_list(\[1\])\], mutable_array::from_list(\[2\]))\nrows"
} -result {List[MutableArray[int]]}

test mutarray-list-5 {a consumer reached through list::at is statically proven, not checked at run time} -body {
    set src "import list\nimport mutable_array\nfn rows():\n    \[mutable_array::from_list(\[1\]), mutable_array::from_list(\[2, 3\])\]\nfn cap(i) errors IndexNotFound:\n    mutable_array::capacity(list::at(rows(), i))\nv = cap(1):\n    on IndexNotFound:\n        -1\nv"
    set hir [mcCompile $src]
    set caps [hirFind $hir call mutable_array::capacity]
    list [mcLast $src] [mcParity $src] [mcValue $src]
} -result {int same 2}

test mutarray-list-6 {the element type is homogeneous only: adding a non-mutarray element widens} -body {
    mcLast "import mutable_array\nrows = \[mutable_array::allocate(1), 5\]\nrows"
} -result list

test mutarray-list-7 {an empty-List accumulator's element type is recovered by the recursive accumulator's semantic instance (no accumulator generics, no annotation)} -body {
    mcResult "import list\nimport mutable_array\nfn collect(acc, n):\n    if n == 0:\n        return acc\n    collect(list::append(acc, mutable_array::allocate(n)), n - 1)\nfn go():\n    collect(\[\], 3)\ngo()" go
} -result {List[mutarray]}

# ---------------------------------------------------------------------------
# mutarray? : refinement (spec items 13-16, 34, 59-61)

test mutarray-pred-1 {mutarray? is bool with an any argument, accepting anything} -body {
    lmap src {
        "mutarray?(1)" "mutarray?(\"s\")" "mutarray?(\[1\])" "mutarray?(true)"
        "import mutable_array\nmutarray?(mutable_array::from_list(\[\]))"
        "fn p(x):\n    mutarray?(x)\np(1)"
    } {mcLast $src}
} -result {bool bool bool bool bool bool}

test mutarray-pred-2 {a wrapper's parameter stays unconstrained: mutarray? imposes nothing} -body {
    mcSig "fn p(x):\n    mutarray?(x)\np(1)" p
} -result {{x: any (none)}}

test mutarray-pred-3 {the true branch refines x to mutarray; the function accepts arbitrary x} -body {
    set src "import mutable_array\nfn f(x) errors IndexNotFound:\n    if mutarray?(x):\n        mutable_array::capacity(x)\n    else:\n        0\nf(1)"
    set hir [mcCompile $src]
    set refined [lmap e [mcOwn $hir [hirFind $hir ref x]] {hir::types::show [hir::typeOf $hir $e]}]
    list [mcSig $src f] $refined [mcResult $src f]
} -result {{{x: any (none)}} {any mutarray} int}

test mutarray-pred-4 {inside the true branch the capacity call raises no static TYPE complaint} -body {
    mcRejects "import mutable_array\nfn f(x) errors IndexNotFound:\n    if mutarray?(x):\n        mutable_array::capacity(x)\n    else:\n        0\n\[f(1), f(\"s\"), f(\[1\]), f(mutable_array::allocate(2))\]" *
} -result accepted

test mutarray-pred-5 {intrinsic inference: a guarded use does not impose mutarray on the parameter} -body {
    mcSig "import mutable_array\nfn maybe_capacity(x):\n    if mutarray?(x):\n        mutable_array::capacity(x)\n    else:\n        0\nmaybe_capacity(1)" maybe_capacity
} -result {{x: any (none)}}

test mutarray-pred-6 {intrinsic inference: an unconditional use still infers a checked mutarray requirement} -body {
    mcSig "import mutable_array\nfn capacity(x):\n    mutable_array::capacity(x)\ncapacity(mutable_array::allocate(1))" capacity
} -result {{x: mutarray (inferred checked)}}

test mutarray-pred-7 {an immutable alias inside the branch keeps the refined kind} -body {
    mcResult "import mutable_array\nfn f(x) errors IndexNotFound:\n    if mutarray?(x):\n        y = x\n        mutable_array::capacity(y)\n    else:\n        0\nf(1)" f
} -result int

test mutarray-pred-8 {nested alias: a second alias inside the branch is still proven} -body {
    mcRejects "import mutable_array\nfn f(x) errors IndexNotFound:\n    if mutarray?(x):\n        y = x\n        z = y\n        mutable_array::capacity(z)\n    else:\n        0\nf(1)" *
} -result accepted

test mutarray-pred-9 {the refined value flows out of the true branch typed mutarray} -body {
    mcResult "import mutable_array\nfn f(x) errors IndexNotFound:\n    if mutarray?(x):\n        x\n    else:\n        mutable_array::allocate(0)\nf(1)" f
} -result mutarray

test mutarray-pred-10 {the refinement does not escape the branch: the join is any} -body {
    mcResult "fn f(x) errors IndexNotFound:\n    if mutarray?(x):\n        0\n    x\nf(1)" f
} -result any

test mutarray-pred-11 {after the branch the parameter is still required to be a MutableArray} -body {
    mcSig "import mutable_array\nfn f(x) errors IndexNotFound:\n    if mutarray?(x):\n        0\n    mutable_array::capacity(x)\nf(mutable_array::allocate(1))" f
} -result {{x: mutarray (inferred checked)}}

test mutarray-pred-12 {a branch-local test does not narrow the value after the branch} -body {
    mcRejects "import mutable_array\nfn f(x) errors IndexNotFound:\n    if mutarray?(x):\n        0\n    mutable_array::capacity(x)\nf(1)" *
} -result {{CORE SEMANTIC TYPE} 1}

test mutarray-pred-13 {the else branch gains no positive kind (no complement types)} -body {
    mcResult "fn f(x) errors IndexNotFound:\n    if mutarray?(x):\n        0\n    else:\n        x\nf(1)" f
} -result any

test mutarray-pred-14 {mutarray? as a value has the same structural callable type as its sibling predicates} -body {
    list [mcLast "\[integer?, list?, mutarray?\]"] \
        [mcLast "fn apply(p: Fn{args: \[any\], return: bool, errors: \[\]}, v) -> bool:\n    p(v)\napply(mutarray?, 1)"]
} -result {{List[Fn{args: [any], return: bool, errors: []}]} bool}

test mutarray-pred-15 {a used specialization view keeps the bool result} -body {
    set hir [mcCompile "fn p(x):\n    mutarray?(x)\np(1)"]
    set spec [hir::specialize::analyze $hir]
    lmap id [dict get $spec used] {hir::types::show [dict get $spec instances $id result]}
} -result {bool bool}

# ---------------------------------------------------------------------------
# Negative controls: what must NOT be inferred (spec items 41-42, 46-48, 78-80)

test mutarray-neg-1 {a positional pair function result gains no slot typing} -body {
    mcResult "import list\nimport mutable_array\nfn mkpair():\n    \[mutable_array::allocate(1), 0\]\nfn first() errors IndexNotFound:\n    list::at(mkpair(), 0)\nv = first():\n    on IndexNotFound:\n        0\nv" first
} -result any

test mutarray-neg-2 {a List parameter gains no positional schema from a MutableArray slot} -body {
    set src "import list\nimport mutable_array\nfn first(p) errors IndexNotFound:\n    list::at(p, 0)\nv = first(\[mutable_array::allocate(1), 0\]):\n    on IndexNotFound:\n        0\nv"
    list [mcSig $src first] [mcLast $src]
} -result "{{p: list (inferred checked)}} any"

test mutarray-neg-3 {[storage, length]: the record consumer needs an independent proof} -body {
    mcRejects "import list\nimport mutable_array\nfn geo_new():\n    \[mutable_array::allocate(0), 0\]\nfn geo_capacity(builder) errors IndexNotFound:\n    mutable_array::capacity(list::at(builder, 0))\nv = geo_capacity(geo_new()):\n    on IndexNotFound:\n        0\nv" *
} -result accepted

test mutarray-neg-4 {a heterogeneous pair literal is a plain list, not a product of mutarray and int} -body {
    mcLast "import mutable_array\n\[mutable_array::allocate(1), 0\]"
} -result list

test mutarray-neg-5 {the only mutarray fact about a local pair is the pre-existing exact-value fact, not a type} -body {
    list [mcLast "import mutable_array\np = \[mutable_array::allocate(1), 0\]\np"] \
        [mcLast "import list\nimport mutable_array\np = \[mutable_array::allocate(1), 0\]\nlist::at(p, 0)"] \
        [mcResult "import list\nimport mutable_array\nfn mk():\n    \[mutable_array::allocate(1), 0\]\nfn snd() errors IndexNotFound:\n    list::at(mk(), 1)\nv = snd():\n    on IndexNotFound:\n        0\nv" snd]
} -result {list mutarray any}

test mutarray-neg-6 {no exact fact describes a MutableArray's contents} -body {
    set hir [mcCompile "import mutable_array\nm = mutable_array::from_list(\[1, 2, 3\])\nm"]
    set f [hir::exact::Of $hir [lindex [hir::roots $hir] end]]
    expr {$f eq "" ? "none" : [hir::exact::describe $hir $f]}
} -result none

test mutarray-neg-7 {an unknown value is never silently a mutarray (no cast exists)} -body {
    lmap name {as_mutarray as_list cast} {
        lindex [mcRejects "fn f(x) errors IndexNotFound:\n    ${name}(x)\nf(1)" *] 0
    }
} -result {{CORE SEMANTIC UNBOUND} {CORE SEMANTIC UNBOUND} {CORE SEMANTIC UNBOUND}}

# ---------------------------------------------------------------------------
# Constructor argument contract (spec items 65-66)

test mutarray-arg-1 {a statically non-List argument is the TYPE error of every intrinsic, at run time (from_list is a registered native since MUTABLE-ARRAY.md)} -body {
    set exprs [hir::lower [mcCompile "import mutable_array\nmutable_array::from_list(123)" 0]]
    list [mcRejects "import mutable_array\nmutable_array::from_list(123)" *] \
        [lmap backend $::parityBackends {lindex [outcomeUnder $backend $exprs] 1}]
} -result {accepted {{CORE SEMANTIC TYPE} {CORE SEMANTIC TYPE} {CORE SEMANTIC TYPE} {CORE SEMANTIC TYPE}}}

test mutarray-arg-2 {a string argument is a run-time TYPE error too} -body {
    set exprs [hir::lower [mcCompile "import mutable_array\nmutable_array::from_list(\"abc\")" 0]]
    lsort -unique [lmap backend $::parityBackends {lindex [outcomeUnder $backend $exprs] 1}]
} -result {{CORE SEMANTIC TYPE}}

test mutarray-arg-3 {an untyped parameter reaching from_list infers a checked list requirement} -body {
    mcSig "import mutable_array\nfn f(x) errors IndexNotFound:\n    mutable_array::from_list(x)\nf(\[1\])" f
} -match glob -result {{x: list (inferred *)}}

test mutarray-arg-4 {an argument that cannot be proven a list is rejected, not coerced} -body {
    lindex [mcRejects "import mutable_array\nfn f(x) errors IndexNotFound:\n    mutable_array::from_list(x)\nf(5)" *] 0
} -result {CORE SEMANTIC TYPE}

# ---------------------------------------------------------------------------
# from_list semantics: differential across every backend (spec items 10, 62-64)

test mutarray-sem-1 {order and values preserved} -body {
    set src "import mutable_array\nfn f() errors IndexNotFound:\n    m = mutable_array::from_list(\[10, 20, 30\])\n    \[mutable_array::capacity(m), mutable_array::at(m, 0), mutable_array::at(m, 1), mutable_array::at(m, 2)\]\nf()"
    list [mcParity $src] [mcValue $src]
} -result {same {[3, 10, 20, 30]}}

test mutarray-sem-2 {the result is mutable and mutation never reaches the source List} -body {
    set src "import mutable_array\nfn f() errors IndexNotFound:\n    xs = \[1, 2, 3\]\n    m = mutable_array::from_list(xs)\n    mutable_array::set(m, 0, 99)\n    mutable_array::set(m, 2, \"z\")\n    \[xs, mutable_array::at(m, 0), mutable_array::at(m, 1), mutable_array::at(m, 2)\]\nf()"
    list [mcParity $src] [mcValue $src]
} -result {same {[[1, 2, 3], 99, 2, "z"]}}

test mutarray-sem-3 {two constructions from one List are independent arrays} -body {
    set src "import mutable_array\nfn f() errors IndexNotFound:\n    xs = \[1, 2\]\n    a = mutable_array::from_list(xs)\n    b = mutable_array::from_list(xs)\n    mutable_array::set(a, 0, 7)\n    \[mutable_array::at(a, 0), mutable_array::at(b, 0)\]\nf()"
    list [mcParity $src] [mcValue $src]
} -result {same {[7, 1]}}

test mutarray-sem-4 {a copy is independent: MutableArray is a value since MUTABLE-ARRAY.md (it used to share storage with every alias)} -body {
    set src "import mutable_array\nfn f() errors IndexNotFound:\n    m = mutable_array::from_list(\[1, 2\])\n    n = m\n    mutable_array::set(m, 1, 5)\n    mutable_array::at(n, 1)\nf()"
    list [mcParity $src] [mcValue $src]
} -result {same 2}

test mutarray-sem-5 {the empty List: capacity 0, predicate true, any index is IndexNotFound -- statically known here, so a compile-time KNOWN-ERROR, and (run anyway) the declared error} -body {
    set ok "import mutable_array\nfn f():\n    m = mutable_array::from_list(\[\])\n    \[mutable_array::capacity(m), mutarray?(m)\]\nf()"
    set bad "import mutable_array\nfn f() errors IndexNotFound:\n    m = mutable_array::from_list(\[\])\n    mutable_array::set(m, 0, 1)\nf()"
    list [mcParity $ok] [mcValue $ok] [lsort -unique [lmap d [hir::diagnostics [mcCompile $bad 0]] {dict get $d kind}]] \
        [lindex [outcomeUnder interp [hir::lower [mcCompile $bad 0]]] 1]
} -result {same {[0, true]} KNOWN-ERROR {CORE SEMANTIC UNCAUGHT-ERROR}}

test mutarray-sem-6 {a heterogeneous source List is accepted and kept as is} -body {
    set src "import mutable_array\nfn f() errors IndexNotFound:\n    m = mutable_array::from_list(\[\"x\", 1, true\])\n    \[mutable_array::at(m, 0), mutable_array::at(m, 1), mutable_array::at(m, 2)\]\nf()"
    list [mcParity $src] [mcValue $src]
} -result {same {["x", 1, true]}}

test mutarray-sem-7 {a nested MutableArray element is a logical copy (copy-on-write, no deep copy): writing the original afterwards does not reach it} -body {
    set src "import mutable_array\nfn f() errors IndexNotFound:\n    inner = mutable_array::from_list(\[1\])\n    outer = mutable_array::from_list(\[inner\])\n    mutable_array::set(inner, 0, 42)\n    mutable_array::at(mutable_array::at(outer, 0), 0)\nf()"
    list [mcParity $src] [mcValue $src]
} -result {same 1}

test mutarray-sem-8 {freezing a from_list array gives back an equal immutable List} -body {
    set src "import mutable_array\nfn f() errors IndexNotFound:\n    xs = \[3, 1, 2\]\n    mutable_array::freeze(mutable_array::from_list(xs), 3) == xs\nf()"
    list [mcParity $src] [mcValue $src]
} -result {same true}

test mutarray-sem-9 {a larger List round-trips} -body {
    set src "import list\nimport mutable_array\nfn build(i, n, acc):\n    if i == n:\n        return acc\n    build(i + 1, n, list::append(acc, i * 2))\nfn f() errors IndexNotFound:\n    m = mutable_array::from_list(build(0, 1000, \[\]))\n    \[mutable_array::capacity(m), mutable_array::at(m, 0), mutable_array::at(m, 999)\]\nf()"
    list [mcParity $src] [mcValue $src]
} -result {same {[1000, 0, 1998]}}

test mutarray-sem-10 {a dynamic non-List value reaching from_list is a TYPE error on every backend (at run time, as for every intrinsic)} -body {
    set src "import mutable_array\nfn mixed(c):\n    if c:\n        1\n    else:\n        \[\]\nfn f() errors IndexNotFound:\n    mutable_array::capacity(mutable_array::from_list(mixed(true)))\nf()"
