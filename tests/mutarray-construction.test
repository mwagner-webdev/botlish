        [lmap backend $::parityBackends {lindex [outcomeUnder $backend $exprs] 1}]
} -result {accepted same {{CORE SEMANTIC TYPE} {CORE SEMANTIC TYPE} {CORE SEMANTIC TYPE} {CORE SEMANTIC TYPE}}}

