test mutarray-run-3 {the refined value is usable through an alias} -body {
    set src "import mutable_array\nfn f(x) errors IndexNotFound:\n    if mutarray?(x):\n        y = x\n        mutable_array::set(y, 0, 8)\n        mutable_array::at(y, 0)\n    else:\n        -1\nfn g() errors IndexNotFound:\n    \[f(mutable_array::from_list(\[1\])), f(1)\]\ng()"
    list [mcParity $src] [mcValue $src]
