test mutarray-run-5 {rows built from from_list are read back through list::at on every backend} -body {
    set src "import list\nimport mutable_array\nfn rows():\n    \[mutable_array::from_list(\[1, 2\]), mutable_array::from_list(\[3\]), mutable_array::from_list(\[\])\]\nfn cap(i) errors IndexNotFound:\n    mutable_array::capacity(list::at(rows(), i))\n\[cap(0), cap(1), cap(2)\]"
    list [mcParity $src] [mcValue $src]
} -result {same {[2, 1, 0]}}

test mutarray-run-7 {a statically proven mutarray argument needs no kind guard; an any argument keeps it} -body {
    set src "import list\nimport mutable_array\nfn cap(x):\n    mutable_array::capacity(x)\nfn mixed(c):\n    if c:\n        mutable_array::allocate(2)\n    else:\n        \[\]\nfn rows():\n    \[mutable_array::from_list(\[1\]), mutable_array::from_list(\[2, 3\])\]\nfn via_rows(i) errors IndexNotFound:\n    cap(list::at(rows(), i))\nvia_rows(1) + cap(mixed(true))"
    set path [makeFile $src mc-nir.bot]
    try {
        set hir [native::prepareHir [surface::readProgramFile $path -strict 0]]
        set nir [native::nir $hir]
    } finally {
        removeFile mc-nir.bot
    }
    set guards {}
    foreach {whole instance} [regexp -all -inline {func \d+ "cap" [^\n]*instance="(\w+)"[^\n]*\n(?:    [^\n]*\n)*?end} $nir] {
        lappend guards $instance [string match {*guard mutarray*} $whole]
    }
    lsort -stride 2 $guards
} -result {generic 1 mutarray 0}

test mutarray-run-8 {mutarray? as a first-class callable value agrees on every backend} -body {
    set src "import mutable_array\nfn apply(p, v):\n    p(v)\nfn f() errors IndexNotFound:\n    \[apply(mutarray?, mutable_array::from_list(\[1\])), apply(mutarray?, \[1\]), apply(mutarray?, 7)\]\nf()"
    list [mcParity $src] [mcValue $src]
} -result {same {[true, false, false]}}

testConstraint executableAot [expr {$::tcl_platform(os) eq "Linux" &&
    $::tcl_platform(machine) in {x86_64 amd64}}]

# The value of program TEXT under every in-process backend and as a standalone
# AOT executable (also under GC stress); errors unless they all agree.
proc mcAotParity {text} {
    set dir [makeDirectory {mutarray aot test}]
    set path [file join $dir program.bot]
    set channel [open $path w]
    fconfigure $channel -encoding utf-8 -translation lf
    puts $channel $text
    close $channel
    try {
        set hir [surface::readProgramFile $path]
        set expected {}
        foreach backend {interp compile cranelift-generic cranelift} {
            set outcome [outcomeUnderHir $backend $hir]
            if {[lindex $outcome 0] ne "value"} { error "$backend: $outcome" }
            lappend expected [lindex $outcome 1]
        }
        exec [info nameofexecutable] [file join $::projectRoot main.tcl] -emit-native-executable $path
        lappend expected [exec env PATH= [file rootname $path]]
        lappend expected [exec env PATH= BOTLISH_NATIVE_GC_STRESS=1 [file rootname $path]]
        if {[llength [lsort -unique $expected]] != 1} { error "values disagree: $expected" }
        return [lindex $expected 0]
    } finally {
        removeDirectory {mutarray aot test}
    }
}

test mutarray-run-6 {from_list and mutarray? in a standalone AOT executable agree with every backend, also under GC stress} -constraints executableAot -body {
    mcAotParity "import list\nimport mutable_array\nfn mixed(c):\n    if c:\n        mutable_array::allocate(3)\n    else:\n        \[1, 2, 3\]\nfn size(x):\n    if mutarray?(x):\n        mutable_array::capacity(x)\n    else:\n        -1\nfn f() errors IndexNotFound:\n    a = mutable_array::from_list(\[\"a\", \"b\"\])\n    e = mutable_array::from_list(\[\])\n    rows = \[a, mutable_array::create(1, \"z\")\]\n    \[size(mixed(true)), size(mixed(false)), mutable_array::capacity(list::at(rows, 0)), mutable_array::capacity(e), mutarray?(a)\]\nf()"
} -result {[3, -1, 2, 0, true]}

# ---------------------------------------------------------------------------
# No MutableArray-specific special cases outside metadata (spec items 9, 16)

test mutarray-arch-1 {no compiler pass names mutarray?; from_list is named only by the central container-rule registry} -body {
    set hits {}
    foreach dir {hir compiler surface} {
        foreach file [glob -nocomplain -directory [file join $::projectRoot $dir] *.tcl] {
            set c [open $file]
            fconfigure $c -encoding utf-8
            set text [read $c]
            close $c
            if {[string first mutarray? $text] >= 0 || [string first mutable_array::from_list $text] >= 0} {
                lappend hits [file join $dir [file tail $file]]
            }
        }
    }
    set hits
} -result hir/containers.tcl

cleanupTests
