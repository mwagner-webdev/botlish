    set src "import mutable_array\nfn f(x) errors IndexNotFound:\n    if mutarray?(x):\n        mutable_array::capacity(x)\n    else:\n        0\nfn g() errors IndexNotFound:\n    \[f(mutable_array::from_list(\[1, 2, 3\])), f(\[1, 2, 3\]), f(5), f(\"abc\"), f(true)\]\ng()"
