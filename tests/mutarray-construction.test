    set src "import immutable_set\nimport mutable_array\n\[mutarray?(mutable_array::allocate(1)), mutarray?(mutable_array::from_list(\[1\])), mutarray?(\[1\]), mutarray?(1), mutarray?(\"s\"), mutarray?(true), mutarray?(unit), mutarray?(\[\]), mutarray?(mutarray?), mutarray?(immutable_set::from_list(\[1\]))\]"
    list [mcParity $src] [mcValue $src]
} -result {same {[true, true, false, false, false, false, false, false, false, false]}}

