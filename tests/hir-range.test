# hir-range.test -- conservative integer range analysis (hir/range.tcl): the
# Range lattice itself, and what analyze proves about specialized instances.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]

proc r {min max} {
    return [dict create min $min max $max]
}

proc rangeOf {text} {
    set hir [surface::compile $text t.bot -strict 0]
    set spec [hir::specialize::analyze $hir]
    return [list $hir $spec [hir::range::analyze $hir $spec]]
}

# Like rangeOf, but with specialization off (-specialize 0): every block has
# exactly one (generic) instance, and every call -- direct or through a
# materialized value alike -- resolves to it.
proc rangeOfGeneric {text} {
    set hir [surface::compile $text t.bot -strict 0]
    set spec [hir::specialize::analyze $hir -specialize 0]
    return [list $hir $spec [hir::range::analyze $hir $spec]]
}

# The used InstanceId of block-bound function NAME, whose key types show as
# KEY (e.g. "int"), or its only/first used instance if KEY is "".
proc rangeInstance {spec name {key ""}} {
    foreach id [dict get $spec used] {
        set instance [dict get $spec instances $id]
        if {[dict get $instance name] ne $name} {
            continue
        }
        if {$key eq "" || [join [lmap t [dict get $instance args] {hir::types::show $t}] {, }] eq $key} {
            return $id
        }
    }
    error "no used instance of \"$name\" matching \"$key\""
}

proc paramRanges {analysis id} {
    return [lmap p [dict get [dict get $analysis instances $id] params] {hir::range::show $p}]
}

# Instance ID's block's parameter binding named NAME.
proc paramBinding {hir spec id name} {
    set block [dict get [dict get $spec instances $id] block]
    foreach b [hir::get $hir $block params] {
        if {[dict get [hir::binding $hir $b] name] eq $name} {
            return $b
        }
    }
    error "no parameter \"$name\" on instance $id"
}

# The Range of every `ref` expression of BINDING that instance ID's analysis
# recorded a fact for, in ExprId order (source order, for straight-line
# branch bodies): every branch-local narrowing a reference to it saw, not
# just its function-entry seed.
proc refRanges {hir analysis id binding} {
    set exprs [dict get [dict get $analysis instances $id] exprs]
    set result {}
    foreach e [lsort -dictionary [dict keys $exprs]] {
        if {[hir::kind $hir $e] eq "ref" && [hir::get $hir $e binding] eq $binding} {
            lappend result [hir::range::show [dict get $exprs $e]]
        }
    }
    return $result
}

# ---------------------------------------------------------------------------
# The Range lattice

test range-lattice-1 {unknown, point and nonneg} -body {
    list [hir::range::isUnknown [hir::range::unknown]] [hir::range::unknown] \
         [hir::range::point 7] [hir::range::nonneg]
} -result {1 {min -inf max +inf} {min 7 max 7} {min 0 max +inf}}

test range-lattice-2 {join is the least upper bound; never is the bottom} -body {
    list [hir::range::join [r 0 10] [r 3 7]] [hir::range::join [r 0 10] [r 20 30]] \
         [hir::range::join never [r 1 1]] [hir::range::join [r 1 1] never] \
         [hir::range::join [r 0 10] [hir::range::unknown]]
} -result {{min 0 max 10} {min 0 max 30} {min 1 max 1} {min 1 max 1} {min -inf max +inf}}

test range-lattice-3 {fitsSmall is exact at the runtime's small-Int boundary} -body {
    list [hir::range::fitsSmall [hir::range::point $hir::range::smallMax]] \
         [hir::range::fitsSmall [hir::range::point [expr {$hir::range::smallMax + 1}]]] \
         [hir::range::fitsSmall [hir::range::point $hir::range::smallMin]] \
         [hir::range::fitsSmall [hir::range::point [expr {$hir::range::smallMin - 1}]]] \
         $hir::range::smallMin $hir::range::smallMax
} -result {1 0 1 0 -4611686018427387904 4611686018427387903}

test range-lattice-4 {addition and subtraction: conservative interval bounds} -body {
    list [hir::range::add [r 0 10] [r 3 7]] [hir::range::sub [r 0 10] [r 3 7]] \
         [hir::range::add [r 0 10] [hir::range::unknown]] \
         [hir::range::add [r 0 10] [hir::range::nonneg]] \
         [hir::range::sub [hir::range::nonneg] [r 0 10]]
} -result {{min 3 max 17} {min -7 max 7} {min -inf max +inf} {min 0 max +inf} {min -10 max +inf}}

test range-lattice-5 {multiplication: the four endpoint products, or unknown if any bound is infinite} -body {
    list [hir::range::mul [r 2 3] [r 4 5]] [hir::range::mul [r -3 -2] [r 4 5]] \
         [hir::range::mul [r -2 3] [r -5 4]] [hir::range::mul [hir::range::nonneg] [r 2 2]]
} -result {{min 8 max 15} {min -15 max -8} {min -15 max 12} {min -inf max +inf}}

test range-lattice-6 {widening pushes a grown bound to infinity; a stable bound is kept} -body {
    list [hir::range::widen [r 0 0] [r 0 1]] [hir::range::widen [r 0 5] [r -3 5]] \
         [hir::range::widen [r 0 5] [r 0 5]] [hir::range::widen [r 0 0] [r -1 1]]
} -result {{min 0 max +inf} {min -inf max 5} {min 0 max 5} {min -inf max +inf}}

test range-lattice-7 {host range arithmetic is arbitrary precision: never overflows} -body {
    set huge [expr {2 ** 200}]
    hir::range::add [hir::range::point $huge] [hir::range::point $huge]
} -result [list min [expr {2 * 2 ** 200}] max [expr {2 * 2 ** 200}]]

# ---------------------------------------------------------------------------
# Analysis over specialized instances

test range-analyze-1 {an Int constant is an exact point, however large} -body {
    lassign [rangeOf "\[1, 0, 1000000000000000000000000000000\]"] hir spec analysis
    set id [dict get $spec keys program]
    dict for {e r} [dict get [dict get $analysis instances $id] exprs] {
        if {[hir::kind $hir $e] eq "const" && [core::value::kind [hir::get $hir $e value]] eq "int"} {
            lappend got [hir::range::show $r]
        }
    }
    lsort $got
} -result {{[0, 0]} {[1, 1]} {[1000000000000000000000000000000, 1000000000000000000000000000000]}}

test range-analyze-2 {a non-recursive parameter seeded only by literal calls is exact} -body {
    lassign [rangeOf "fn add1(x):\n    x + 1\n\n\[add1(5), add1(9)\]"] hir spec analysis
    paramRanges $analysis [rangeInstance $spec add1]
} -result {{[5, 9]}}

test range-analyze-3 {an exact call's Ref argument seeds the callee from the caller's own already-proven Range, not only a literal at the call site itself} -body {
    lassign [rangeOf "fn add1(x):\n    x + 1\n\nfn go(n):\n    add1(n)\n\ngo(3)"] hir spec analysis
    list [paramRanges $analysis [rangeInstance $spec add1]] [paramRanges $analysis [rangeInstance $spec go]]
} -result {{{[3, 3]}} {{[3, 3]}}}

test range-analyze-3b {a parameter with no evidence anywhere -- not even indirectly -- stays unknown: the callee only ever sees a genuinely unbounded expression's Range, never a syntactic "not a literal" restriction} -body {
    lassign [rangeOf "fn add1(x):\n    x + 1\n\nfn go(xs):\n    add1(list_get(xs, 0))\n\ngo(\[1, 2\])"] hir spec analysis
    paramRanges $analysis [rangeInstance $spec add1]
} -result {{[-∞, +∞]}}

test range-analyze-4 {a self-recursive counter decreasing to an == 0 guard: hir/induction.tcl proves it never goes negative either, on the side that grows} -body {
    lassign [rangeOf "fn count_up(n, acc):\n    if n == 0:\n        return acc\n    count_up(n - 1, acc + 1)\n\ncount_up(1000, 0)"] hir spec analysis
    set id [rangeInstance $spec count_up]
    paramRanges $analysis $id
} -result {{[0, 1000]} {[0, +∞]}}

test range-analyze-5 {a parameter passed unchanged through recursion, seeded by a literal, stays exact; the == 0-terminated decreasing one is now bounded below too} -body {
    lassign [rangeOf "fn walk(step, n):\n    if n == 0:\n        return 0\n    walk(step, n - 1)\n\nwalk(7, 3)"] hir spec analysis
    paramRanges $analysis [rangeInstance $spec walk]
} -result {{[7, 7]} {[0, 3]}}

test range-analyze-6 {a native's -result-range collection-length metadata (length, list_length) proves a String/List length is both non-negative and machine-representable, so length(s) is provably small with no relational reasoning} -body {
    lassign [rangeOf "fn f(s):\n    length(s)\n\nf(\"abc\")"] hir spec analysis
    set id [rangeInstance $spec f]
    set r [lindex [dict values [dict get [dict get $analysis instances $id] exprs]] end]
    list [hir::range::show $r] [hir::range::fitsSmall $r]
} -result [list "\[0, $hir::range::smallMax\]" 1]

test range-analyze-7 {if branches join conservatively: two exact branches bound, one unbounded branch spoils it} -body {
    lassign [rangeOf "fn pick(c):\n    if c:\n        1\n    else:\n        2\n\n\[pick(true), pick(false)\]"] hir spec analysis
    set id [rangeInstance $spec pick]
    set body [dict get [dict get $analysis instances $id] result]
    hir::range::show $body
} -result {[1, 2]}

test range-analyze-8 {only + - * and proven-nonneg natives establish a fact; everything else is unknown} -body {
    lassign [rangeOf "fn f(xs):\n    list_get(xs, 0)\n\nf(\[1, 2\])"] hir spec analysis
    set id [rangeInstance $spec f]
    set r [lindex [dict values [dict get [dict get $analysis instances $id] exprs]] end]
    hir::range::isUnknown $r
} -result 1

# ---------------------------------------------------------------------------
# hir/induction.tcl: the equality-termination induction-variable proof, and
# hir/range.tcl's branch-derived narrowing it builds on (spec #10, #14-19 of
# the milestone that added them)

test range-induction-1 {an == guard against a stable, immutable-collection-length bound with a +1 step (string_reverse's shape) proves the counter stays within [0, length]} -body {
    lassign [rangeOf "fn reverse_from(text, index, reversed):\n    if index == length(text):\n        return reversed\n    reverse_from(text, index + 1, reversed)\n\nreverse_from(\"hello\", 0, \"\")"] hir spec analysis
    set id [rangeInstance $spec reverse_from]
    lassign [paramRanges $analysis $id] textRange indexRange
    list $indexRange [hir::range::fitsSmall [lindex [dict get [dict get $analysis instances $id] params] 1]]
} -result [list "\[0, $hir::range::smallMax\]" 1]

test range-induction-2 {a parameter seeded, at every external call, only by a length/list_length-shaped argument (matmul's "count") is itself proven small (interprocedural, from hir::range::SeedRange, no relational reasoning needed for the bound itself), so the == guard against it proves the counter small too} -body {
    lassign [rangeOf "fn dot(a_row, b, column, k, count, total):\n    if k == count:\n        return total\n    dot(a_row, b, column, k + 1, count, total + 1)\n\ndot(\[1, 2\], \[\[1, 2\], \[3, 4\]\], 0, 0, list_length(\[1, 2\]), 0)"] hir spec analysis
    set id [rangeInstance $spec dot]
    set params [dict get [dict get $analysis instances $id] params]
    # k (index 3) is proven small; total (index 5), an unbounded accumulator
    # in the very same instance, is correctly left alone (spec #49: a raw
    # loop index must coexist with a BigInt-capable accumulator).
    list [hir::range::fitsSmall [lindex $params 3]] [hir::range::fitsSmall [lindex $params 5]]
} -result {1 0}

test range-induction-3 {a step of +-2 against an == guard is not proven (it could skip the terminator): the parameter widens to infinity on that side exactly as plain interval feedback always did, not [initial, bound]} -body {
    lassign [rangeOf "fn count2(n, acc):\n    if n == 0:\n        return acc\n    count2(n - 2, acc + 1)\n\ncount2(100000, 0)"] hir spec analysis
    paramRanges $analysis [rangeInstance $spec count2]
} -result {{[-∞, 100000]} {[0, +∞]}}

test range-induction-4 {an opaque, call-derived next value (csv's scan_records shape: no i + c pattern at all) is not a step candidate, so an otherwise-provable >= guard's own branch-narrowing still applies to the *comparison*, but the parameter's own range across the backedge is not tightened by hir/induction.tcl} -body {
    lassign [rangeOf "fn next_index(i):\n    i + 1\n\nfn scan(text, index, count):\n    if index >= length(text):\n        return count\n    scan(text, next_index(index), count + 1)\n\nscan(\"abcde\", 0, 0)"] hir spec analysis
    set id [rangeInstance $spec scan]
    lassign [paramRanges $analysis $id] textR indexR countR
    list $indexR [hir::range::fitsSmall [lindex [dict get [dict get $analysis instances $id] params] 1]]
} -result {{[-∞, +∞]} 0}

# ---------------------------------------------------------------------------
# Parameter branch narrowing (this milestone's Part A): the same
# ComparisonNarrowing machinery hir/range.tcl already had for `local`
# bindings, extended to immutable function parameters.

test range-narrow-param-1 {a `<`/`>=` guard narrows a parameter reference in each branch exactly as it already narrows a local, on both sides (spec #6, #34); the caller's own argument (an unbounded list element) is not itself informative, isolating this from Part B's own propagation} -body {
    lassign [rangeOf "fn f(n):\n    if n < 2:\n        n\n    else:\n        n\n\nfn use(xs):\n    f(list_get(xs, 0))\n\nuse(\[1, 2\])"] hir spec analysis
    set id [rangeInstance $spec f]
    set b [paramBinding $hir $spec $id n]
    refRanges $hir $analysis $id $b
} -result {{[-∞, +∞]} {[-∞, 1]} {[2, +∞]}}

test range-narrow-param-2 {branch narrowing on a parameter is not limited to a function's top-level body: it applies wherever it already applies to a local (spec #7)} -body {
    lassign [rangeOf "fn f(outer, n):\n    if outer:\n        if n >= 0:\n            n\n\nfn use(xs):\n    f(true, list_get(xs, 0))\n\nuse(\[1, 2\])"] hir spec analysis
    set id [rangeInstance $spec f]
    set b [paramBinding $hir $spec $id n]
    refRanges $hir $analysis $id $b
} -result {{[-∞, +∞]} {[0, +∞]}}

test range-narrow-param-3 {two nested comparisons on a parameter narrow it exactly as they would a local (spec #33)} -body {
    lassign [rangeOf "fn f(n):\n    if n >= 0:\n        if n < 10:\n            n\n\nfn use(xs):\n    f(list_get(xs, 0))\n\nuse(\[1, 2\])"] hir spec analysis
    set id [rangeInstance $spec f]
    set b [paramBinding $hir $spec $id n]
    refRanges $hir $analysis $id $b
} -result {{[-∞, +∞]} {[0, +∞]} {[0, 9]}}

test range-narrow-param-4 {a local binding narrows exactly as it did before this milestone (no regression: spec #38)} -body {
    lassign [rangeOf "fn f(n):\n    b = n\n    if b >= 0:\n        b\n\nfn use(xs):\n    f(list_get(xs, 0))\n\nuse(\[1, 2\])"] hir spec analysis
    set id [rangeInstance $spec f]
    # b is a *local* duplicate-free bind of n, not n's own BindingId.
    set localB ""
    dict for {bid binding} [dict get $hir bindings] {
        if {[dict get $binding kind] eq "local" && [dict get $binding name] eq "b"} {
            set localB $bid
        }
    }
    refRanges $hir $analysis $id $localB
} -result {{[-∞, +∞]} {[0, +∞]}}

# ---------------------------------------------------------------------------
# Caller-to-callee range propagation (this milestone's Part B): an exact
# call's argument Range -- however it was proven, not only a literal --
# seeds the callee parameter it targets.

test range-propagate-1 {an exact call's Ref argument, whose own Range the caller already proved, seeds the callee -- not only a syntactic literal (spec #8, #13, #15)} -body {
    lassign [rangeOf "fn work(i):\n    i + 1\n\nfn drive(i, total):\n    if i <= 0:\n        total\n    else:\n        work(i)\n        drive(i - 1, total + 1)\n\ndrive(500, 0)"] hir spec analysis
    list [paramRanges $analysis [rangeInstance $spec drive]] [paramRanges $analysis [rangeInstance $spec work]]
} -result {{{[-∞, 500]} {[0, +∞]}} {{[1, 500]}}}

test range-propagate-2 {fib's else branch proves n >= 2, and n-1/n-2 there inherit the tighter bound (spec #14, acceptance case)} -body {
    lassign [rangeOf "fn fib(n):\n    if n < 2:\n        n\n    else:\n        fib(n - 1) + fib(n - 2)\n\nfib(18)"] hir spec analysis
    set id [rangeInstance $spec fib]
    set b [paramBinding $hir $spec $id n]
    set entry [paramRanges $analysis $id]
    set branchRefs [refRanges $hir $analysis $id $b]
    set exprs [dict get [dict get $analysis instances $id] exprs]
    set subExprRanges {}
    foreach e [lsort -dictionary [dict keys $exprs]] {
        if {[hir::kind $hir $e] eq "call"} {
            lassign [hir::get $hir $e target] targetKind target
            if {$targetKind eq "native" && [dict get [hir::symbol $hir $target] name] eq "-"} {
                lappend subExprRanges [hir::range::show [dict get $exprs $e]]
            }
        }
    }
    list $entry $branchRefs $subExprRanges
} -result {{{[-∞, 18]}} {{[-∞, 18]} {[-∞, 1]} {[2, 18]} {[2, 18]}} {{[1, 17]} {[0, 16]}}}

test range-propagate-3 {multiple exact callers of the same instance join to a safe hull, not an intersection or whichever call site ran first (spec #11, #35)} -body {
    lassign [rangeOf "fn f(x):\n    x + 0\n\nfn caller_a():\n    f(5)\n\nfn caller_b():\n    f(150)\n\n\[caller_a(), caller_b()\]"] hir spec analysis
    paramRanges $analysis [rangeInstance $spec f]
} -result {{[5, 150]}}

test range-propagate-4 {a materialized (escaping) Block value's generic instance is never narrowed from a known direct caller's literal alone: the safe entry range must account for every possible caller, including the ones reachable only through the escaped value (spec #28-29, #36, #39)} -body {
    lassign [rangeOfGeneric "fn f(x):\n    x + 0\n\nfn call_it(cb):\n    cb(1)\n\n\[f(5), call_it(f)\]"] hir spec analysis
    paramRanges $analysis [rangeInstance $spec f]
} -result {{[-∞, +∞]}}

test range-propagate-5 {the same direct literal call, with nothing materializing f elsewhere, does narrow it: range-propagate-4's result is specifically because f escapes, not a blanket effect of -specialize 0 (spec #39)} -body {
    lassign [rangeOfGeneric "fn f(x):\n    x + 0\n\nf(5)"] hir spec analysis
    paramRanges $analysis [rangeInstance $spec f]
} -result {{[5, 5]}}

test range-propagate-6 {a self-recursive chain of caller-propagated facts (drive -> work, and drive's own self-tail feedback) converges to a fixed answer, deterministically, without oscillating or needing per-interval specialization (spec #12, #37)} -body {
    lassign [rangeOf "fn work(i):\n    i + 1\n\nfn drive(i, total):\n    if i <= 0:\n        total\n    else:\n        work(i)\n        drive(i - 1, total + 1)\n\ndrive(500, 0)"] hir spec analysis1
    lassign [rangeOf "fn work(i):\n    i + 1\n\nfn drive(i, total):\n    if i <= 0:\n        total\n    else:\n        work(i)\n        drive(i - 1, total + 1)\n\ndrive(500, 0)"] hir2 spec2 analysis2
    list [dict get $spec used] [dict get $spec2 used] \
        [paramRanges $analysis1 [rangeInstance $spec work]] [paramRanges $analysis2 [rangeInstance $spec2 work]]
} -result {{i0 i2 i1} {i0 i2 i1} {{[1, 500]}} {{[1, 500]}}}

cleanupTests
