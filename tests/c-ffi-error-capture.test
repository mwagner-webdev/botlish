# c-ffi-error-capture.test -- a C call's error state survives the
# representation of its result (C-FFI-ERROR-CAPTURE-MILESTONE-1.md).
#
# A C function that fails the POSIX way returns a sentinel (-1) and leaves
# the reason in errno, which its binding reads right after the call -- with
# a C call of __errno_location() (glibc) or __error() (Darwin) and a native
# view of the int it points to. Nothing the compiler inserts may run in
# between: an allocation or a runtime call there may change errno. A call
# with a `write noescape` byte parameter yields the write-back value
# {result: R, NAME: MutableBytes}; its representation is fields -- the C
# result and the private copy C wrote -- and nothing is built after the call:
# a MutableBytes only where a use reads it whole, the struct only where a use
# needs the object.
#
#   * NIR (every host, programs compiled for linux-x86_64 and
#     macos-aarch64): between the C call and the call of errno() there is
#     only the exposures' keepalive (no machine code) and the comparison,
#     for every shape a write-back value takes -- bound, projected straight
#     off the call, discarded, two written parameters, read and written
#     aliases, returned from a function, held in a struct, joined by an
#     `if`, in a loop, in a coroutine -- on both native lowerings; the
#     detector finds the old eager construction (-struct-opt 0);
#   * machine code (hosts that link C calls, objdump): the calls on every
#     path, in the object file, from the C call's return to the call of
#     errno() -- and in errno() from its entry to __errno_location/__error
#     and from there to the load -- are at most the BigInt slow paths of a
#     64-bit result (never taken by a small Int, the -1 sentinel); the
#     detector finds the eager construction's rt_struct_new;
#   * the instructions actually executed (Linux, ptrace: tests/cffi/
#     window-trace.c): from the C call's return to the load of errno, only
#     the wrapper, errno() and the C library's __errno_location run;
#   * behavior through real C (tests/cffi/fixture.c's errno functions, the
#     C library's own read(2)): distinct errnos in succession, a success
#     after a failure, bytes written before a failure kept, the original
#     never changed, two written parameters, aliases, results returned,
#     stored, captured and held across a suspension -- both native backends,
#     the executable, GC stress, and an allocator that changes errno on
#     every allocation (tests/cffi/errno-clobber.c), whose effect the eager
#     construction shows.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]
source [file join $::projectRoot native native.tcl]
source [file join $::projectRoot tests cffi window.tcl]

interp recursionlimit {} 100000

testConstraint nativeBuilt [expr {![catch {native::binary}]}]
testConstraint cCompiler [expr {[auto_execok cc] ne ""}]
testConstraint objdump [expr {[auto_execok objdump] ne "" && [auto_execok file] ne ""}]
set ::hostTarget [core::cabi::hostTarget]
set ::scratch [makeDirectory ec-[pid]]
set ::appCounter 0

# Writes TEXT to PATH as UTF-8 with LF line ends.
proc ecWrite {path text} {
    set channel [open $path w]
    fconfigure $channel -encoding utf-8 -translation lf
    puts -nonewline $channel $text
    close $channel
}

# The fixture library (c-ffi.test's), built once.
set ::fixtureDir ""
if {[testConstraint cCompiler] && [testConstraint nativeCCalls]} {
    set ::fixtureDir [file join $::scratch fixture]
    file mkdir $::fixtureDir
    if {[catch {
        exec cc -c -O2 -fPIC [file join $::projectRoot tests cffi fixture.c] -o [file join $::fixtureDir fixture.o]
        exec ar rcs [file join $::fixtureDir libbotlish_cffi_fixture.a] [file join $::fixtureDir fixture.o]
    } message]} {
        puts stderr "c-ffi-error-capture.test: the fixture library did not build: $message"
        set ::fixtureDir ""
    }
}
testConstraint ecFixture [expr {$::fixtureDir ne "" && [testConstraint nativeBuilt] && [testConstraint rustcLinker]}]

# The allocator that changes errno (LD_PRELOAD on Linux, DYLD_INSERT_LIBRARIES
# on macOS), built once: its path, or "".
proc ecClobberLibrary {} {
    if {![info exists ::clobberLibrary]} {
        set ::clobberLibrary ""
        if {$::tcl_platform(os) eq "Darwin"} {
            set path [file join $::scratch libbcf_errno_clobber.dylib]
            set flags -dynamiclib
        } else {
            set path [file join $::scratch libbcf_errno_clobber.so]
            set flags {-shared -fPIC}
        }
        if {![catch {exec cc {*}$flags -O2 [file join $::projectRoot tests cffi errno-clobber.c] -o $path}]} {
            set ::clobberLibrary $path
        }
    }
    return $::clobberLibrary
}
testConstraint ecClobber [expr {[testConstraint ecFixture] && $::tcl_platform(os) in {Linux Darwin}}]

# The single-step tracer (Linux), built once: its path, or "" where it does
# not build or ptrace is not allowed.
proc ecTracer {} {
    if {![info exists ::tracer]} {
        set ::tracer ""
        set path [file join $::scratch window-trace]
        if {![catch {exec cc -O2 [file join $::projectRoot tests cffi window-trace.c] -o $path -ldl}]
                && ![catch {exec $path /bin/true 0 0} probe]} {
            set ::tracer $path
        } elseif {[file exists $path]} {
            # A probe of a trivial program: START 0 is never reached, so a
            # working tracer reports that the program ended first.
            if {[catch {exec $path /bin/true 0 0} probe] && [string match "*ended before the window*" $probe]} {
                set ::tracer $path
            }
        }
    }
    return $::tracer
}
testConstraint ecTrace [expr {[testConstraint ecFixture] && $::tcl_platform(os) eq "Linux"
    && $::tcl_platform(machine) in {x86_64 amd64 aarch64 arm64} && [testConstraint cCompiler] && [ecTracer] ne ""}]

# ---------------------------------------------------------------------------
# The programs

# The C library's errno location function of TARGET's platform.
proc ecErrnoSymbol {target} {
    return [expr {[string match macos-* $target] ? "__error" : "__errno_location"}]
}

# The binding (an application module `ec`): the fixture's errno functions,
# the C library's read, open and close, and errno() -- darwin::errno's shape,
# through the platform's own errno location function.
set ecModule {direct module
import abi
import abi::bytes
import binary
import binary::native
import byte
import ffi::c
import list
import str

extern c library "botlish_cffi_fixture"

extern c fn c_errno_location named "ERRNO"() -> ffi::c::Ptr[ffi::c::Int] independent
extern c fn fill_errno named "bcf_fill_errno"(out: ffi::c::Ptr[ffi::c::UChar] write noescape, count: ffi::c::ULong, seed: ffi::c::UChar, err: ffi::c::Int, stale: ffi::c::Int) -> ffi::c::Long
extern c fn fill2_errno named "bcf_fill2_errno"(a: ffi::c::Ptr[ffi::c::UChar] write noescape, na: ffi::c::ULong, b: ffi::c::Ptr[ffi::c::UChar] write noescape, nb: ffi::c::ULong, err: ffi::c::Int) -> ffi::c::Long
extern c fn reverse_errno named "bcf_reverse_errno"(src: ffi::c::Ptr[ffi::c::UChar] read noescape, count: ffi::c::ULong, dst: ffi::c::Ptr[ffi::c::UChar] write noescape, err: ffi::c::Int) -> ffi::c::Long
extern c fn tick named "bcf_tick"() -> ffi::c::UChar
extern c fn c_read named "read"(fd: ffi::c::Int, buf: ffi::c::Ptr[ffi::c::Void] write noescape, nbyte: ffi::c::ULong) -> ffi::c::Long
extern c fn c_open named "open"(path: ffi::c::Ptr[ffi::c::Char] read noescape, oflag: ffi::c::Int, variadic) -> ffi::c::Int
extern c fn c_close named "close"(fd: ffi::c::Int) -> ffi::c::Int

layout ErrnoCell:
    size 4
    align 4
    field value: ffi::c::Int at 0

# What one C call did: its result, the errno a failure left (0 after a
# success: errno is never read then) and the buffer as C left it.
struct Outcome:
    result: int
    errno: int
    data: abi::bytes::MutableBytes

fn errno() -> int:
    location = c_errno_location()
    cell = binary::native::view(ErrnoCell, location):
        on NativeViewNull:
            return 0
    cell.value

fn mlen(d: abi::bytes::MutableBytes) -> ffi::c::ULong:
    abi::bytes::mutable_length(d).value

# bcf_fill_errno into a copy of DATA: darwin::read's shape.
fn fill(data: abi::bytes::MutableBytes, seed: ffi::c::UChar, err: ffi::c::Int, stale: ffi::c::Int) -> Outcome:
    r = fill_errno(data, mlen(data), seed, err, stale)
    if r.result < 0:
        failure = errno()
        return Outcome {result: r.result, errno: failure, data: r.out}
    Outcome {result: r.result, errno: 0, data: r.out}

# read(2) into a copy of DATA: darwin::read itself, on any platform.
fn read(fd: ffi::c::Int, data: abi::bytes::MutableBytes) -> Outcome:
    r = c_read(fd, data, mlen(data))
    if r.result < 0:
        failure = errno()
        return Outcome {result: r.result, errno: failure, data: r.buf}
    Outcome {result: r.result, errno: 0, data: r.buf}

fn terminator() -> byte::Byte:
    0

# open(2) of PATH with OFLAG: the descriptor, or -1 when it failed.
fn open(path: str, oflag: ffi::c::Int) -> ffi::c::Int:
    c_open(abi::bytes::from_list(str::encode_utf8(path).append(terminator())), oflag)

fn close(fd: ffi::c::Int) -> ffi::c::Int:
    c_close(fd)
}

# The write-back value's shapes, each a function reading errno right after a
# failed call (each NAME below), and a program running them all.
set shapesMain {direct module
import abi
import abi::bytes
import coroutine
import ffi::c
import list
import str
import ec

struct Event:
    value: int

fn status_only(data: abi::bytes::MutableBytes, err: ffi::c::Int) -> int:
    r = ec::fill_errno(data, ec::mlen(data), 5, err, 0)
    if r.result < 0:
        return ec::errno()
    0

fn direct(data: abi::bytes::MutableBytes, err: ffi::c::Int) -> int:
    if ec::fill_errno(data, ec::mlen(data), 5, err, 0).result < 0:
        return ec::errno()
    0

fn two(a: abi::bytes::MutableBytes, b: abi::bytes::MutableBytes, err: ffi::c::Int) -> list:
    r = ec::fill2_errno(a, ec::mlen(a), b, ec::mlen(b), err)
    if r.result < 0:
        failure = ec::errno()
        return [r.result, failure, r.a, r.b]
    [r.result, 0, r.a, r.b]

fn alias(m: abi::bytes::MutableBytes, err: ffi::c::Int) -> list:
    r = ec::reverse_errno(abi::bytes::freeze(m), ec::mlen(m), m, err)
    if r.result < 0:
        failure = ec::errno()
        return [r.result, failure, r.dst, m]
    [r.result, 0, r.dst, m]

fn raw(data: abi::bytes::MutableBytes, err: ffi::c::Int):
    ec::fill_errno(data, ec::mlen(data), 9, err, 0)

fn via_raw(data: abi::bytes::MutableBytes, err: ffi::c::Int) -> list:
    r = raw(data, err)
    if r.result < 0:
        failure = ec::errno()
        return [r.result, failure, r.out]
    [r.result, 0, r.out]

fn wrapped(data: abi::bytes::MutableBytes, err: ffi::c::Int) -> list:
    w = {r: ec::fill_errno(data, ec::mlen(data), 7, err, 0), tag: 1}
    if w.r.result < 0:
        failure = ec::errno()
        return [w.r.result, failure, w.r.out, w.tag]
    [w.r.result, 0, w.r.out, w.tag]

fn chosen(data: abi::bytes::MutableBytes, which: bool, err: ffi::c::Int) -> list:
    r = if which:
        ec::fill_errno(data, ec::mlen(data), 1, err, 0)
    else:
        ec::fill_errno(data, ec::mlen(data), 2, err, 0)
    if r.result < 0:
        failure = ec::errno()
        return [r.result, failure, r.out]
    [r.result, 0, r.out]

fn looped(data: abi::bytes::MutableBytes) -> list:
    loop i from 0 to 3:
        e = if i == 1:
            22
        else:
            0
        r = ec::fill_errno(data, ec::mlen(data), i, e, 0)
        if r.result < 0:
            [r.result, ec::errno(), r.out]
        else:
            [r.result, 0, r.out]

fn suspended(data: abi::bytes::MutableBytes) -> Event:
    r = ec::fill_errno(data, ec::mlen(data), 4, 33, 0)
    failure = if r.result < 0:
        ec::errno()
    else:
        0
    yield Event {value: failure}
    later = ec::fill_errno(data, ec::mlen(data), 6, 34, 0)
    if later.result < 0:
        return Event {value: ec::errno() + 1000 * abi::bytes::mutable_length(r.out).value}
    Event {value: 0}

fn captured(data: abi::bytes::MutableBytes):
    r = ec::fill_errno(data, ec::mlen(data), 3, 0, 0)
    fn get() -> abi::bytes::MutableBytes:
        r.out
    get

fn in_coroutine(m: abi::bytes::MutableBytes) -> list:
    coroutine {step, first} = suspended(m)
    [first.value, step().value]

m = abi::bytes::zeroed(abi::usize(4))
f = captured(m)
kept = [ec::fill(m, 1, 0, 0), ec::fill(m, 2, 13, 0), ec::fill(m, 3, 0, 99), ec::read(-1, m)]
[kept, status_only(m, 4), direct(m, 5), two(m, m, 6), alias(abi::bytes::from_bytes(abi::bytes::from_list(str::encode_utf8("abcd"))), 7), via_raw(m, 8), wrapped(m, 10), chosen(m, true, 11), chosen(m, false, 0), looped(m), in_coroutine(m), f(), m]
}

# The value shapesMain prints: MutableBytes as the runtime shows them (`<mutbytes N: HEX>`).
proc ecMut {hex} {
    return "abi::bytes::MutableBytes {storage: <mutbytes [expr {[string length $hex] / 2}]: $hex>}"
}
proc ecOutcome {result errno hex} {
    return "ec::Outcome {result: $result, errno: $errno, data: [ecMut $hex]}"
}
set shapesValue "\[\[[ecOutcome 4 0 01264b70], [ecOutcome -1 13 02274c71], [ecOutcome 4 0 03284d72], [ecOutcome -1 EBADF 00000000]\], 4, 5, \[-1, 6, [ecMut 01264b70], [ecMut 02274c71]\], \[-1, 7, [ecMut 64636261], [ecMut 61626364]\], \[-1, 8, [ecMut 092e5378]\], \[-1, 10, [ecMut 072c5176], 1\], \[-1, 11, [ecMut 01264b70]\], \[4, 0, [ecMut 02274c71]\], \[\[4, 0, [ecMut 00254a6f]\], \[-1, 22, [ecMut 01264b70]\], \[4, 0, [ecMut 02274c71]\]\], \[33, 4034\], [ecMut 03284d72], [ecMut 00000000]\]"

# The host's errno values, from its own headers: {EBADF N EISDIR N} (POSIX's
# usual values where no C compiler can say: the tests that use them need one).
proc ecErrnoFacts {} {
    if {![testConstraint cCompiler]} {
        return {EBADF 9 EISDIR 21}
    }
    if {![info exists ::errnoFacts]} {
        set dir [file join $::scratch facts]
        file mkdir $dir
        ecWrite [file join $dir facts.c] "#include <errno.h>\n#include <stdio.h>\nint main(void) { printf(\"EBADF %d EISDIR %d\", EBADF, EISDIR); return 0; }\n"
        exec cc [file join $dir facts.c] -o [file join $dir facts]
        set ::errnoFacts [exec [file join $dir facts]]
    }
    return $::errnoFacts
}

# shapesMain's value on the host, and as its executable shows it (opaque
# buffers).
proc ecExpected {} {
    return [string map [list EBADF [dict get [ecErrnoFacts] EBADF]] $::shapesValue]
}
proc ecShown {} {
    return [regsub -all {abi::bytes::MutableBytes \{storage: <mutbytes [0-9]+: [0-9a-f]*>\}} [ecExpected] {<opaque abi::bytes::MutableBytes>}]
}

# An application directory of MAIN and the binding for TARGET: its path.
proc ecApp {main {target ""}} {
    if {$target eq ""} {
        set target $::hostTarget
    }
    set dir [file join $::scratch app[incr ::appCounter]]
    file mkdir $dir
    ecWrite [file join $dir main.bot] $main
    ecWrite [file join $dir ec.bot] [string map [list ERRNO [ecErrnoSymbol $target]] $::ecModule]
    return $dir
}

proc ecHir {dir {target ""}} {
    if {$target eq ""} {
        set target $::hostTarget
    }
    return [surface::readProgramFile [file join $dir main.bot] -warnings off -cache "" -target $target]
}

# The NIR windows of the shapes (window::nirWindows, their ops), compiled for
# TARGET with lowering OPTIONS: {NAME OPS-OF-EACH-WINDOW ...}.
proc ecShapeWindows {target options} {
    set nir [native::nir [ecHir [ecApp $::shapesMain $target] $target] {*}$options]
    set result {}
    foreach name {ec::fill status_only direct two alias wrapped chosen looped suspended} {
        lappend result $name [lmap w [window::nirWindows $nir $name ec::errno] {window::nirOps $w}]
    }
    lappend result raw [lmap w [window::nirWindows $nir raw ""] {window::nirOps $w}]
    lappend result via_raw [lmap w [window::nirWindows $nir via_raw ec::errno {= callmulti }] {window::nirOps $w}]
    return $result
}

# The native outcome of DIR's program on both native backends, which must
# agree: {value TEXT} or {error CODE MESSAGE}.
proc ecOutcome {dir} {
    set hir [ecHir $dir]
    set outcomes [native::withLinkDirs [list $::fixtureDir] {
        lmap backend {cranelift cranelift-generic} {
            lrange [outcomeUnderHir $backend $hir] 0 end-1
        }
    }]
    if {[lindex $outcomes 0] ne [lindex $outcomes 1]} {
        error "cranelift and cranelift-generic disagree: $outcomes"
    }
    return [lindex $outcomes 0]
}

# The standalone executable of DIR's program (lowering OPTIONS): its path.
proc ecExecutable {dir {options {}}} {
    set name program[incr ::appCounter]
    return [native::withLinkDirs [list $::fixtureDir] {native::executable [ecHir $dir] [file join $dir $name] {*}$options}]
}

# What EXE prints, run with ENVIRONMENT ({NAME VALUE ...}).
proc ecRun {exe {environment {}}} {
    return [string trim [exec env {*}[lmap {k v} $environment {string cat $k=$v}] $exe 2>@1]]
}

# The environment that loads the errno-changing allocator into a run.
proc ecClobbering {{marker 77}} {
    set library [ecClobberLibrary]
    set variable [expr {$::tcl_platform(os) eq "Darwin" ? "DYLD_INSERT_LIBRARIES" : "LD_PRELOAD"}]
    return [list $variable $library BCF_ERRNO_CLOBBER $marker]
}

# ---------------------------------------------------------------------------
# NIR: what runs between the C call and errno()

test ec-nir-windows {between each shape's C call and its call of errno() there is the keepalive of every exposure (no machine code) and the comparison, nothing else -- a bound write-back value, a status read straight off the call, a discarded buffer, two written parameters, a read and a write exposure of one owner, a value held in a struct, an if joining two calls, a call in a loop, one in a coroutine; a write-back value returned from a function crosses as fields: the callee's C call is followed by its keepalive and the return, the caller's comparison by errno(); the same on the specializing and the generic lowering, for Linux and for macOS -- but for the value returned from a function: the generic lowering (-specialize 0, cranelift-generic) carries no struct across a call boundary as fields (STRUCTS.md, "Known limitations"), so there the callee builds it before it returns (C-FFI-ERROR-CAPTURE-MILESTONE-1.md, "Known limits")} -body {
    lmap target {linux-x86_64 macos-aarch64} {
        lmap options {{} {-specialize 0}} {
            ecShapeWindows $target $options
        }
    }
} -result [lrepeat 2 [list \
    {ec::fill {{keepalive ilt}} status_only {{keepalive ilt}} direct {{keepalive ilt}} two {{keepalive keepalive ilt}} alias {{keepalive keepalive ilt}} wrapped {{keepalive ilt}} chosen {{keepalive ilt} {keepalive ilt}} looped {{keepalive ilt}} suspended {{keepalive ilt} {keepalive ilt}} raw keepalive via_raw ilt} \
    {ec::fill {{keepalive ilt}} status_only {{keepalive ilt}} direct {{keepalive ilt}} two {{keepalive keepalive ilt}} alias {{keepalive keepalive ilt}} wrapped {{keepalive ilt}} chosen {{keepalive ilt} {keepalive ilt}} looped {{keepalive ilt}} suspended {{keepalive ilt} {keepalive ilt}} raw {{keepalive structnew structnew}} via_raw {}}]]

test ec-nir-no-hazard {no window of any shape holds anything that may allocate, call or collect (window::nirHazards), on either lowering} -body {
    set hazards {}
    foreach options {{} {-specialize 0}} {
        set nir [native::nir [ecHir [ecApp $::shapesMain linux-x86_64] linux-x86_64] {*}$options]
        foreach name {ec::fill ec::read status_only direct two alias wrapped chosen looped suspended} {
            foreach w [window::nirWindows $nir $name ec::errno] {
                lappend hazards {*}[window::nirHazards $w]
            }
        }
    }
    set hazards
} -result {}

test ec-nir-positive-control {the detector sees the eager construction: with struct scalar replacement off (-struct-opt 0, the lowering before this milestone) every shape's window holds the write-back value's MutableBytes and struct objects (structnew), and window::nirHazards reports them} -body {
    set windows [ecShapeWindows linux-x86_64 {-struct-opt 0}]
    list [dict get $windows ec::fill] [dict get $windows two] \
        [llength [window::nirHazards [lindex [window::nirWindows [native::nir [ecHir [ecApp $::shapesMain linux-x86_64] linux-x86_64] -struct-opt 0] ec::fill ec::errno] 0]]]
} -result {{{keepalive structnew structnew structget ilt}} {{keepalive keepalive structnew structnew structnew structget ilt}} 3}

test ec-nir-no-write-back-object {the write-back struct itself is never built in the shapes that read it field by field: no structnew of its shape anywhere in ec::fill, ec::read, status_only, direct, two, alias, raw, via_raw, wrapped, chosen or looped; a MutableBytes is built only after errno() (ec::fill's failure path: errno, then the MutableBytes, then the Outcome's fields returned)} -body {
    set nir [native::nir [ecHir [ecApp $::shapesMain linux-x86_64] linux-x86_64]]
    set shapes [dict create]
    foreach line [split $nir \n] {
        if {[regexp {^shape ([0-9]+) anon fields="([^"]*)"} $line -> id fields]} {
            dict set shapes $fields $id
        }
    }
    set writeBack [lmap fields {{out result} {a b result} {dst result}} {dict getdef $shapes $fields none}]
    set built {}
    foreach name {ec::fill ec::read status_only direct two alias raw via_raw wrapped chosen looped} {
        foreach body [window::nirBodies $nir $name] {
            foreach line $body {
                if {[regexp {= structnew ([0-9]+) } $line -> shape] && $shape in $writeBack} {
                    lappend built $name
                }
            }
        }
    }
    set fill [lindex [window::nirBodies $nir ec::fill] 0]
    set errno [lsearch -regexp $fill "= call [window::nirId $nir ec::errno]\$"]
    set mutable [lsearch -regexp $fill {= structnew }]
    list $built [expr {$errno >= 0 && $mutable > $errno}]
} -result {{} 1}

test ec-darwin-read-window {darwin::read (lib/darwin.bot, compiled for macos-aarch64): read(2), the keepalive of its private copy, the comparison, errno() -- and the detector finds the old window again when struct scalar replacement is off} -body {
    set dir [ecApp "direct module\nimport abi\nimport abi::bytes\nimport darwin\nr = darwin::read(0, abi::bytes::zeroed(abi::usize(4)))\n\[r.count, r.errno\]\n" macos-aarch64]
    set hir [ecHir $dir macos-aarch64]
    lmap options {{} {-specialize 0} {-struct-opt 0}} {
        lmap w [window::nirWindows [native::nir $hir {*}$options] darwin::read darwin::errno] {window::nirOps $w}
    }
} -result {{{keepalive ilt}} {{keepalive ilt}} {{keepalive structnew structnew structget ilt}}}

test ec-interchange {HIR interchange carries what the representation needs: the program written as text and read back after another compilation lowers to the same NIR (the write-back value's fields are a lowering decision, no new HIR fact)} -body {
    set hir [ecHir [ecApp $::shapesMain linux-x86_64] linux-x86_64]
    set text [hir::interchange::encode $hir]
    surface::compile "1 + 2\n" -warnings off
    set back [hir::interchange::decode $text -target linux-x86_64]
    expr {[native::nir $back] eq [native::nir $hir]}
} -result 1

test ec-tcl-backends {the Tcl backends run the binding up to its first C call, which they refuse (NATIVE-ONLY): the representation is native lowering's alone} -body {
    set hir [ecHir [ecApp $::shapesMain linux-x86_64] linux-x86_64]
    lmap backend {interp compile} {lrange [outcomeUnderHir $backend $hir] 0 1}
} -result {{error {CORE SEMANTIC NATIVE-ONLY}} {error {CORE SEMANTIC NATIVE-ONLY}}}

# ---------------------------------------------------------------------------
# Behavior through real C

test ec-fixture-shapes {every shape through the fixture's C functions, on both native backends: distinct errnos in succession (13, EBADF from read(2), 6, 7, 8, 10, 11, 22, 33, 34), a success after a failure reporting 0 (never the stale errno 99 a successful call left), the bytes C wrote before failing kept, two written parameters each with its own copy of one owner, a read and a write exposure of one owner (the read sees the original, the copy is written, the original unchanged), results returned, stored in lists, held in a struct, captured by a closure and held across a suspension, and the caller's MutableBytes never changed} -constraints ecFixture -body {
    ecOutcome [ecApp $::shapesMain]
} -result [list value [ecExpected]]

test ec-arguments-once {a write-exposing C call's arguments are evaluated once each, in order, before the call, and nothing of the call moves past the code after it: a counter C function as the seed argument (1), then again after the call (2); the buffer C wrote from seed 1} -constraints ecFixture -body {
    ecOutcome [ecApp "direct module\nimport abi\nimport abi::bytes\nimport ec\nfn once(m: abi::bytes::MutableBytes) -> list:\n    r = ec::fill_errno(m, ec::mlen(m), ec::tick(), 0, 0)\n    after = ec::tick()\n    \[r.result, after, r.out\]\nonce(abi::bytes::zeroed(abi::usize(4)))\n"]
} -result [list value "\[4, 2, [ecMut 01264b70]\]"]

test ec-fixture-executable {the same program as a standalone executable prints the same value (the runtime shows the buffers opaque), also under GC stress (a collection at every allocation site) and with an allocator that changes errno on every allocation (tests/cffi/errno-clobber.c): no allocation runs between a failed call and its errno read} -constraints ecClobber -body {
    set exe [ecExecutable [ecApp $::shapesMain]]
    set plain [ecRun $exe]
    list [expr {$plain eq [ecShown]}] [expr {[ecRun $exe {BOTLISH_NATIVE_GC_STRESS 1}] eq $plain}] \
        [expr {[ecRun $exe [ecClobbering]] eq $plain}] [expr {[ecRun $exe [concat [ecClobbering] {BOTLISH_NATIVE_GC_STRESS 1}]] eq $plain}]
} -result {1 1 1 1}

test ec-clobber-positive-control {the allocator does change errno where something allocates between a C call and the errno read: a program that builds a String there reads the marker, not the C call's errno; and the lowering before this milestone (-struct-opt 0: the write-back value built right after the call) reads the marker in every wrapper, while the same program lowered now reads each call's own errno} -constraints ecClobber -body {
    set allocating [ecApp "direct module\nimport abi\nimport abi::bytes\nimport ffi::c\nimport str\nimport ec\nfn f(m: abi::bytes::MutableBytes, s: str) -> int:\n    r = ec::fill_errno(m, ec::mlen(m), 1, 13, 0)\n    t = str::concat(s, s)\n    if str::length(t) > 0 and r.result < 0:\n        return ec::errno()\n    0\n\[f(abi::bytes::zeroed(abi::usize(4)), \"ab\"), f(abi::bytes::zeroed(abi::usize(4)), \"cd\")\]\n"]
    set exe [ecExecutable $allocating]
    set app [ecApp $::shapesMain]
    set eager [ecExecutable $app {-struct-opt 0}]
    set now [ecExecutable $app]
    list [ecRun $exe] [ecRun $exe [ecClobbering 77]] \
        [lsort -unique [regexp -all -inline {errno: -?[0-9]+} [ecRun $eager [ecClobbering 77]]]] \
        [lsort -unique [regexp -all -inline {errno: -?[0-9]+} [ecRun $now [ecClobbering 77]]]] \
        [expr {[ecRun $eager] eq [ecRun $now]}]
} -result [list {[13, 13]} {[77, 77]} {{errno: 0} {errno: 77}} [lsort -unique [list {errno: 0} {errno: 13} "errno: [dict get [ecErrnoFacts] EBADF]"]] 1]

# Real read(2) of the C library (glibc, libSystem): failures with their own
# errnos, successes between them, buffers of every size.
set readMain {direct module
import abi
import abi::bytes
import coroutine
import ffi::c
import list
import str
import ec

struct Event:
    value: int

fn summary(o: ec::Outcome) -> List[int]:
    [o.result, o.errno, abi::bytes::mutable_length(o.data).value]

fn zeros(n: int) -> abi::bytes::MutableBytes:
    size = abi::usize(n):
        on abi::AbiIntegerAboveRange:
            return abi::bytes::zeroed(abi::usize(0))
        on abi::AbiIntegerBelowRange:
            return abi::bytes::zeroed(abi::usize(0))
    abi::bytes::zeroed(size)

fn round(dir: str) -> List[List[int]]:
    wo = ec::open("/dev/null", 1)
    ro = ec::open("/dev/zero", 0)
    d = ec::open(dir, 0)
    rounds = [summary(ec::read(99, zeros(16))), summary(ec::read(wo, zeros(16))), summary(ec::read(d, zeros(16))),
        summary(ec::read(ro, zeros(64))), summary(ec::read(99, zeros(0))), summary(ec::read(ro, zeros(0))),
        summary(ec::read(ro, zeros(1048576))), summary(ec::read(wo, zeros(1048576)))]
    ec::close(wo)
    ec::close(ro)
    ec::close(d)
    rounds

fn worker(dir: str) -> Event:
    before = ec::read(99, zeros(8))
    yield Event {value: before.errno}
    after = ec::read(99, zeros(8))
    Event {value: after.errno + 1000 * abi::bytes::mutable_length(before.data).value}

fn filled() -> abi::bytes::MutableBytes:
    abi::bytes::from_bytes(abi::bytes::from_list(str::encode_utf8("ABCDEFGH")))

fn kept_read(dir: str) -> List[bool]:
    original = filled()
    ro = ec::open("/dev/zero", 0)
    good = ec::read(ro, original)
    bad = ec::read(99, original)
    ec::close(ro)
    [abi::bytes::freeze(good.data) == abi::bytes::freeze(zeros(8)), abi::bytes::freeze(bad.data) == abi::bytes::freeze(filled()), abi::bytes::freeze(original) == abi::bytes::freeze(filled())]

fn all(dir: str) -> List[any]:
    coroutine {step, first} = worker(dir)
    [round(dir), first.value, step().value, kept_read(dir), round(dir) == round(dir)]
}

test ec-real-read {the C library's own read(2) through a write exposure, the errno read right after it: EBADF for a descriptor that does not exist and for one opened write-only, EISDIR for a directory (the host's own values), each before and after a success that reports 0 -- a 64-byte read of /dev/zero, an empty one, a 1 MiB one -- and an empty read of a bad descriptor failing too; inside a coroutine before and after a suspension; the buffer C filled kept, a failed read's buffer as it was, the caller's never changed; on both native backends, as an executable, under GC stress and with the errno-changing allocator} -constraints ecClobber -body {
    set main $::readMain
    append main "all(\"[file normalize $::scratch]\")\n"
    set app [ecApp $main]
    set value [lindex [ecOutcome $app] 1]
    set exe [ecExecutable $app]
    set plain [ecRun $exe]
    list [expr {$value eq $plain}] [expr {[ecRun $exe {BOTLISH_NATIVE_GC_STRESS 1}] eq $plain}] \
        [expr {[ecRun $exe [ecClobbering]] eq $plain}] $plain
} -result [apply {{ebadf eisdir} {
    list 1 1 1 "\[\[\[-1, $ebadf, 16\], \[-1, $ebadf, 16\], \[-1, $eisdir, 16\], \[64, 0, 64\], \[-1, $ebadf, 0\], \[0, 0, 0\], \[1048576, 0, 1048576\], \[-1, $ebadf, 1048576\]\], $ebadf, [expr {8000 + $ebadf}], \[true, true, true\], true\]"
}} [dict get [ecErrnoFacts] EBADF] [dict get [ecErrnoFacts] EISDIR]]

# ---------------------------------------------------------------------------
# Machine code: the object file, read with its relocations

# The functions (window::machine) of the object file of DIR's program
# (lowering OPTIONS) and its NIR.
proc ecObject {dir options} {
    set hir [ecHir $dir]
    set path [file join $dir object[incr ::appCounter].o]
    native::object $hir $path {*}$options
    return [list [window::machine $path] [native::nir $hir {*}$options]]
}

# The calls on the paths from each shape's C call to its errno() call, in
# machine code: {NAME CALLS ...}.
proc ecMachineWindows {dir options} {
    lassign [ecObject $dir $options] functions nir
    set errno botlish_fn_[window::nirId $nir ec::errno]
    set result {}
    foreach {name foreign} {ec::fill bcf_fill_errno ec::read read status_only bcf_fill_errno direct bcf_fill_errno two bcf_fill2_errno
            alias bcf_reverse_errno wrapped bcf_fill_errno chosen bcf_fill_errno looped bcf_fill_errno suspended bcf_fill_errno} {
        set calls {}
        foreach id [regexp -all -inline -line "^func (\[0-9\]+) \"[string map {:: ::} $name]\" " $nir] {
            if {[string is integer -strict $id]} {
                lappend calls {*}[window::machineWindow $functions botlish_fn_$id $foreign $errno]
            }
        }
        lappend result $name [lsort -unique $calls]
    }
    return $result
}

test ec-machine-window {in the object file (objdump with relocations, every target's own call sequences), the calls on any path from each shape's C call to its call of errno() are at most the BigInt paths of a 64-bit result (window::bigIntPaths: taken only when the value is no small Int -- never for the -1 a failure returns), no allocation, no other runtime helper, no C function; errno() calls nothing from its entry to __errno_location/__error, and nothing from there to the load (rt_native_load)} -constraints {ecFixture objdump} -body {
    set dir [ecApp $::shapesMain]
    set windows [ecMachineWindows $dir {}]
    set others {}
    dict for {name calls} $windows {
        foreach call $calls {
            if {$call ni [window::bigIntPaths]} {
                lappend others $name $call
            }
        }
    }
    lassign [ecObject $dir {}] functions nir
    set errno botlish_fn_[window::nirId $nir ec::errno]
    set location [ecErrnoSymbol $::hostTarget]
    list $others [window::machineWindow $functions $errno "" $location] [window::machineWindow $functions $errno $location rt_native_load] \
        [expr {$location in [window::machineCalls $functions $errno] && "rt_native_load" in [window::machineCalls $functions $errno]}]
} -result {{} {} {} 1}

test ec-machine-positive-control {the machine-code detector sees the eager construction: the object file of the -struct-opt 0 lowering has rt_struct_new on the path from every shape's C call to errno()} -constraints {ecFixture objdump} -body {
    set windows [ecMachineWindows [ecApp $::shapesMain] {-struct-opt 0}]
    lsort -unique [dict values [dict map {name calls} $windows {expr {"rt_struct_new" in $calls}}]]
} -result 1

# The functions (by symbol) every instruction of TRACE belongs to, in order,
# each once per run of consecutive instructions: an executable's symbols
# (SYMBOLS, `nm`'s address -> name) and, for a library, its path.
proc ecTraceRuns {trace symbols errnoLib errnoOffset} {
    set addresses [lsort -integer [dict keys $symbols]]
    set runs {}
    foreach line [split $trace \n] {
        if {[regexp {^exe ([0-9a-f]+)$} $line -> hex]} {
            set address [expr {"0x$hex"}]
            set name ?
            foreach a $addresses {
                if {$a > $address} break
                set name [dict get $symbols $a]
            }
        } elseif {[regexp {^lib (\S+) ([0-9a-f]+)$} $line -> path offset]} {
            set at [expr {"0x$offset"}]
            if {$path eq $errnoLib && $at >= $errnoOffset && $at < $errnoOffset + 64} {
                set name __errno_location
            } else {
                set name lib:[file tail $path]
            }
        } else {
            continue
        }
        if {[lindex $runs end] ne $name} {
            lappend runs $name
        }
    }
    return $runs
}

# The functions DIR's executable (lowering OPTIONS) runs from the return of
# ec::fill's C call to the load of errno, by single-stepping it. The window
# starts at the instruction after the call of bcf_fill_errno: found in the
# object file of the same lowering (its relocation names the C function),
# at the same offset in the executable's ec::fill, whose code is checked to
# be the object's. With UNTILLIBRARY the trace ends at the first instruction
# of a shared library (the allocator's entry, for the eager lowering: its
# lock is not single-stepped, which on AArch64 would never end).
proc ecTraced {dir options {untilLibrary 0}} {
    set exe [ecExecutable $dir $options]
    lassign [ecObject $dir $options] functions nir
    set fill botlish_fn_[window::nirId $nir ec::fill]
    set offset [lindex [window::machineCallReturns $functions $fill bcf_fill_errno] 0]
    set symbols [dict create]
    foreach line [split [exec nm $exe] \n] {
        if {[regexp {^([0-9a-f]+) [tTwW] (\S+)$} $line -> address name]} {
            dict set symbols [expr {"0x$address"}] $name
        }
    }
    set linked [lindex [dict filter $symbols value $fill] 0]
    set copy [window::machineMnemonics [window::machine $exe $fill] $fill]
    if {$copy ne [window::machineMnemonics $functions $fill]} {
        error "the executable's $fill is not the object's"
    }
    set start [format %x [expr {$linked + $offset}]]
    set stop [format %x [lindex [dict filter $symbols value rt_native_load] 0]]
    set output [exec env WINDOW_TRACE_UNTIL_LIBRARY=[expr {$untilLibrary ? 1 : ""}] [ecTracer] $exe $start $stop]
    regexp -line {^errno (\S+) ([0-9a-f]+)$} $output -> lib at
    set runs [ecTraceRuns $output $symbols $lib [expr {"0x$at"}]]
    set errno botlish_fn_[window::nirId $nir ec::errno]
    return [lmap name $runs {
        expr {$name eq $fill ? "ec::fill" : ($name eq $errno ? "ec::errno" : $name)}
    }]
}

test ec-trace {the instructions actually executed (ptrace single-stepping the executable) from the return of ec::fill's failing C call to the load of errno: the wrapper's comparison and branch, errno()'s entry, the C library's __errno_location, errno() again up to the load -- no other function, no allocator; the -struct-opt 0 executable (the eager write-back value) runs rt_struct_new and enters the C library's allocator there (traced up to that entry)} -constraints ecTrace -body {
    set dir [ecApp "direct module\nimport abi\nimport abi::bytes\nimport ec\nr = ec::fill(abi::bytes::zeroed(abi::usize(4)), 1, 13, 0)\n\[r.result, r.errno\]\n"]
    set eager [ecTraced $dir {-struct-opt 0} 1]
    list [ecTraced $dir {}] [expr {"rt_struct_new" in $eager}] [expr {[lsearch -glob $eager lib:*] >= 0}]
} -result {{ec::fill ec::errno __errno_location ec::errno} 1 1}

file delete -force $::scratch
cleanupTests
