# tree-struct.test -- tree structs: finite recursive ordered values, and their
# traversal (TREE-STRUCT-MILESTONE-1.md).
#
#   tree struct Node:
#       value: int
#       children: List[Node]
#
# A tree struct has exactly one recursive field, of type List[Self]; its
# values are finite rooted ordered trees, immutable, with no node identity.
# `==`, the public hash, the keyed table hash and the printer mean exactly
# what they mean for any struct -- structural, order-sensitive -- and walk the
# tree's topology without the host's recursion, in both runtimes.
# std::tree::walk(root, order) traverses any tree struct's value in preorder
# (DepthFirst) or breadth-first order, handing over the subtree values
# themselves.
#
# Behavioral checks run on every backend through one HIR (sourceAgree);
# hashes under a fixed key are compared with the Hashable oracle
# (audit/hashable/tools/oracle.py: a tree's canonical input is its struct's).

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]

testConstraint python3 [expr {[auto_execok python3] ne ""
    && ![catch {exec python3 -I -c {print(6 * 7)}} answer] && $answer eq "42"}]
testConstraint nativeBuilt [expr {![catch {native::binary}]}]
testConstraint executableAot [expr {[testConstraint executableAot] && [testConstraint nativeBuilt]}]

set ::tsKey {1311768467750121216 18364758544493064720}

set ::tsDecls {import std::coroutine
import std::immutable_map
import std::immutable_set
import std::list
import std::mutable_map
import std::mutable_array
import std::mutable_vector
import std::tree

tree struct Node:
    value: int
    children: List[Node]

tree struct Labeled[T]:
    label: T
    kids: List[Labeled[T]]
    weight: int

struct Plain:
    value: int
    children: List[Plain]

nomethod fn leaf(v: int) -> Node:
    Node {value: v, children: []}

nomethod fn node(v: int, kids: List[Node]) -> Node:
    Node {value: v, children: kids}

# A chain of N + 1 nodes, BOTTOM at its leaf and N at its root, built
# without recursion (bottom-up through a vector).
nomethod fn chain(n: int, bottom: int) -> Node:
    acc = std::mutable_vector::from_list([leaf(bottom)])
    loop i from 1 through n:
        below = acc.pop():
            on IndexNotFound:
                leaf(0)
        acc.push(node(i, [below]))
    acc.at(0):
        on IndexNotFound:
            leaf(0)

# The values of ROOT's nodes in ORDER, as std::tree::walk hands them over.
nomethod fn values(root: Node, order: std::tree::Order) -> List[int]:
    out = std::mutable_vector::from_list([root.value])
    out.clear()
    coroutine {step, first} = std::tree::walk(root, order)
    out.push(first.value)
    loop:
        if std::coroutine::done?(step):
            break
        out.push(step().value)
    loop v in out:
        v

# {count, digest} of ROOT's nodes in ORDER: a positional checksum of the
# values, as cheap to compare as a large sequence.
nomethod fn digest(root: Node, order: std::tree::Order) -> List[int]:
    acc = std::mutable_array::create(2, 0)
    coroutine {step, first} = std::tree::walk(root, order)
    acc.set(0, 1):
        on IndexNotFound:
            unit
    acc.set(1, first.value):
        on IndexNotFound:
            unit
    loop:
        if std::coroutine::done?(step):
            break
        n = step()
        c = acc.at(0):
            on IndexNotFound:
                0
        d = acc.at(1):
            on IndexNotFound:
                0
        acc.set(0, c + 1):
            on IndexNotFound:
                unit
        acc.set(1, mod(d * 1000003 + n.value + 7, 2305843009213693951)):
            on IndexNotFound:
                unit
    std::mutable_array::freeze(acc, 2)

}

proc tsRun {body {backends {interp compile cranelift-generic cranelift}}} {
    return [sourceAgree "$::tsDecls$body" $backends]
}

proc tsHir {source} {
    return [surface::compile $source t.bot -warnings off]
}

# The kind and location-free message of the first diagnostic of SOURCE, or
# "accepted".
proc tsRejection {source} {
    if {[catch {surface::compile $source t.bot -warnings off} message options]} {
        if {[dict exists $options -diagnostics]} {
            set first [lindex [dict get $options -diagnostics] 0]
            set message [dict get $first message]
            set code [dict get $first errorcode]
        } else {
            set code [dict get $options -errorcode]
        }
        set kind [if {[lindex $code 0] eq "SURFACE" && [lindex $code 1] eq "SYNTAX"} {lindex $code 1} else {lindex $code end}]
        return [list $kind [regsub {^[^ ]*:[0-9]+:[0-9]+: } $message {}]]
    }
    return accepted
}

proc tsKind {source} {
    return [lindex [tsRejection $source] 0]
}

# The fixture module that may call the private table hash, as the standard
# library's hash structures do (HASHABLE-AND-KEYED-HASH.md).
proc tsKeyed {body {key ""}} {
    withPrivateLibrary {
        set f [open [file join $::core::libraryDir hashfix.bot] w]
        puts -nonewline $f "import std::table_hash\n\nfn keyed(x: Hashable) -> int:\n    std::table_hash::of(x)\n"
        close $f
        core::hashing::useTableHashKey $key
        try {
            set result [sourceAgree "import std::hashfix\n$::tsDecls$body" {interp compile cranelift-generic cranelift}]
        } finally {
            core::hashing::useTableHashKey ""
        }
    }
    return $result
}

# ---------------------------------------------------------------------------
# Declarations

test ts-decl-accepted {a tree struct records its child field in the registry and its sourceTypes entry; a parameterized one's child field is List[Self] applied to its own slots; an ordinary struct has none} -body {
    set hir [tsHir "$::tsDecls\n1\n"]
    set entries [lmap entry [hir::sourceTypes $hir] {
        if {[dict get $entry kind] ne "struct" || [dict get $entry name] ni {Node Labeled Plain}} continue
        list [dict get $entry name] [dict getdef $entry tree ""]
    }]
    list [hir::structs::treeField Node] [hir::structs::treeField Labeled] [hir::structs::treeField Plain] \
        [hir::structs::RuntimeTree Node] [hir::structs::RuntimeTree Labeled] [hir::structs::RuntimeTree Plain] $entries
} -result {children kids {} 1 1 {} {{Node children} {Labeled kids} {Plain {}}}}

test ts-decl-tree-is-contextual {`tree` is a modifier only before `struct`: a variable, a function, a field and a struct named tree are ordinary} -body {
    tsRun "struct tree:\n    tree: int\nfn tree_of(tree: int) -> tree:\n    tree {tree: tree}\ntree = 3\n\[tree, tree_of(tree).tree\]\n"
} -result {value {[3, 3]}}

test ts-decl-shapes-rejected {the one recursive shape is one List[Self] field: no recursive field, two, a field of Self, Self nested deeper, inside another container or function type, another application of the declaration, and mutual recursion are TREE-STRUCT-SHAPE, at the field, with the rule} -body {
    lmap body {
        "tree struct Node:\n    value: int\n1\n"
        "tree struct Node:\n    left: List\[Node\]\n    right: List\[Node\]\n1\n"
        "tree struct Node:\n    child: Node\n    children: List\[Node\]\n1\n"
        "tree struct Node:\n    children: List\[List\[Node\]\]\n1\n"
        "tree struct Node:\n    children: List\[Node\]\n    more: MutableVector\[Node\]\n1\n"
        "tree struct Node:\n    children: List\[Node\]\n    set: ImmutableSet\[Node\]\n1\n"
        "import std::immutable_map\ntree struct Node:\n    children: List\[Node\]\n    m: std::immutable_map::ImmutableMap\[str, Node\]\n1\n"
        "tree struct Node:\n    children: List\[Node\]\n    f: Fn{args: \[Node\], return: int}\n1\n"
        "tree struct Node\[T\]:\n    value: T\n    children: List\[Node\[int\]\]\n1\n"
        "tree struct A:\n    bs: List\[B\]\n    children: List\[A\]\ntree struct B:\n    as: List\[A\]\n    children: List\[B\]\n1\n"
        "struct Wrap:\n    inner: List\[Node\]\ntree struct Node:\n    w: Wrap\n    children: List\[Node\]\n1\n"
    } {tsRejection $body}
} -result {{TREE-STRUCT-SHAPE {tree struct "Node" has no recursive field: a tree struct has exactly one recursive field, of type List[Node] (the field that holds its ordered children)}} {TREE-STRUCT-SHAPE {tree struct "Node" has a second recursive field "right" (the first is "left"): a tree struct has exactly one recursive field, of type List[Node]}} {TREE-STRUCT-SHAPE {field "child" of tree struct "Node" (Node) holds "Node" itself, a recursive field that is not the List of its children: a tree struct has exactly one recursive field, of type List[Node], and every other field is an ordinary value that does not contain "Node"}} {TREE-STRUCT-SHAPE {field "children" of tree struct "Node" (List[List[Node]]) nests "Node" deeper than one List: a tree struct has exactly one recursive field, of type List[Node], and every other field is an ordinary value that does not contain "Node"}} {TREE-STRUCT-SHAPE {field "more" of tree struct "Node" (MutableVector[Node]) holds "Node" inside a MutableVector, a recursive edge a tree struct does not have: a tree struct has exactly one recursive field, of type List[Node], and every other field is an ordinary value that does not contain "Node"}} {TREE-STRUCT-SHAPE {field "set" of tree struct "Node" (ImmutableSet[Node]) holds "Node" inside a ImmutableSet, a recursive edge a tree struct does not have: a tree struct has exactly one recursive field, of type List[Node], and every other field is an ordinary value that does not contain "Node"}} {TREE-STRUCT-SHAPE {field "m" of tree struct "Node" (std::immutable_map::ImmutableMap[str, Node]) holds "Node" inside a std::immutable_map::ImmutableMap, a recursive edge a tree struct does not have: a tree struct has exactly one recursive field, of type List[Node], and every other field is an ordinary value that does not contain "Node"}} {TREE-STRUCT-SHAPE {field "f" of tree struct "Node" (Fn{args: [Node], return: int, errors: []}) holds "Node" inside a function type, a recursive edge a tree struct does not have: a tree struct has exactly one recursive field, of type List[Node], and every other field is an ordinary value that does not contain "Node"}} {TREE-STRUCT-SHAPE {field "children" of tree struct "Node" (List[Node[int]]) holds another application of "Node" than Node[T] (inside a List), but the children of a tree are values of its own type: a tree struct has exactly one recursive field, of type List[Node[T]], and every other field is an ordinary value that does not contain "Node"}} {TREE-STRUCT-SHAPE {field "bs" of tree struct "A" (List[B]) reaches "A" again through "B" (inside a List), which is mutual recursion between declarations, not a tree: a tree struct has exactly one recursive field, of type List[A], and every other field is an ordinary value that does not contain "A"}} {TREE-STRUCT-SHAPE {field "w" of tree struct "Node" (Wrap) reaches "Node" again through "Wrap", which is mutual recursion between declarations, not a tree: a tree struct has exactly one recursive field, of type List[Node], and every other field is an ordinary value that does not contain "Node"}}}

test ts-decl-unapplied-self {inside a parameterized tree struct, Self is an application: an unapplied List[Node] is the ordinary arity error} -body {
    tsKind "tree struct Node\[T\]:\n    value: T\n    children: List\[Node\]\n1\n"
} -result TYPE

test ts-decl-other-trees-allowed {an ordinary field may hold another tree struct, or an ordinary recursive struct of another declaration: neither reaches this one} -body {
    tsRun "tree struct Doc:\n    outline: Node\n    plain: List\[Plain\]\n    sections: List\[Doc\]\nd = Doc {outline: node(1, \[leaf(2)\]), plain: \[\], sections: \[Doc {outline: leaf(3), plain: \[\], sections: \[\]}\]}\n\[d == d, values(d.outline, std::tree::Order::DepthFirst)\]\n"
} -result {value {[true, [1, 2]]}}

test ts-decl-combinations {a tree struct declares no identity, is no context and is not opaque (TREE-STRUCT-COMBINATION); a duplicate modifier is a syntax error} -body {
    lmap body {
        "struct Bagless:\n    x: int\nopaque tree struct Node:\n    children: List\[Node\]\n    identity members(children)\n1\n"
        "tree context struct Node:\n    children: List\[Node\]\n1\n"
        "opaque tree struct Node:\n    children: List\[Node\]\n1\n"
        "tree tree struct Node:\n    children: List\[Node\]\n1\n"
    } {tsRejection $body}
} -result {{TREE-STRUCT-COMBINATION {tree struct "Node" cannot declare an identity: a tree's equality and hashing are its structure -- its fields and its ordered children, recursively -- and an identity clause would give it a second meaning}} {TREE-STRUCT-COMBINATION {context struct "Node" cannot be a tree struct: a context is installed and required by its type, never a recursive value}} {TREE-STRUCT-COMBINATION {tree struct "Node" cannot be opaque: std::tree::walk takes any tree apart into its subtrees, and taking an opaque struct's value apart is its owning module's alone (wrap the tree in an opaque struct of its own to hide it)}} {SYNTAX {duplicate modifier "tree" in this struct declaration}}}

test ts-decl-affine {a tree of affine values is AFFINE-CONTAINER-UNSUPPORTED: an affine field, and an application of a parameterized tree struct to an affine type where a value of it is constructed} -body {
    list [tsKind "fn gen() -> int:\n    yield 1\n    2\ntree struct Node:\n    co: Coroutine{args: \[\], return: int, errors: \[\]}\n    children: List\[Node\]\n1\n"] \
        [tsRejection "fn gen() -> int:\n    yield 1\n    2\ntree struct Node\[T\]:\n    v: T\n    children: List\[Node\[T\]\]\nfn mk() -> int:\n    coroutine {step, first} = gen()\n    n = Node {v: step, children: \[\]}\n    first\nmk()\n"]
} -result {AFFINE-CONTAINER-UNSUPPORTED {AFFINE-CONTAINER-UNSUPPORTED {the construction is invalid: Node[Coroutine{args: [], return: int, errors: []}] applies tree struct "Node" to an affine type: a tree of affine values nests to any depth, and an affine value is released by a static, finite walk of its type (a tree struct holds unrestricted values)}}}

test ts-decl-module-private {a module's tree struct is an ordinary type of it: private tree structs and their walks stay inside the module, and a public one is walked by importers} -body {
    withPrivateLibrary {
        set f [open [file join $::core::libraryDir treemod.bot] w]
        puts -nonewline $f "import std::coroutine\nimport std::tree\n\nprivate tree struct Secret:\n    v: int\n    kids: List\[Secret\]\n\ntree struct Open:\n    v: int\n    kids: List\[Open\]\n\nfn secret_count() -> int:\n    s = Secret {v: 1, kids: \[Secret {v: 2, kids: \[\]}\]}\n    coroutine {step, first} = std::tree::walk(s, std::tree::Order::DepthFirst)\n    second = step()\n    first.v + second.v\n\nfn make() -> Open:\n    Open {v: 5, kids: \[Open {v: 6, kids: \[\]}\]}\n"
        close $f
        set result [list [sourceAgree "import std::coroutine\nimport std::tree\nimport std::treemod\no = std::treemod::make()\ncoroutine {step, first} = std::tree::walk(o, std::tree::Order::BreadthFirst)\n\[std::treemod::secret_count(), first.v, step().v\]\n"] \
            [tsKind "import std::treemod\nx = std::treemod::Secret {v: 1, kids: \[\]}\n1\n"]]
    }
    set result
} -result {{value {[3, 5, 6]}} PRIVATE-ACCESS}

# ---------------------------------------------------------------------------
# HIR text, interchange, isolation, NIR

test ts-hir-text {HIR text prints a tree struct's child field and reads it back: the same text, the same registry entry, the same outcome} -body {
    set hir [tsHir "$::tsDecls\nnode(1, \[leaf(2)\]) == node(1, \[leaf(2)\])\n"]
    set text [hir::format $hir]
    set back [hir::parse $text]
    list [lsearch -all -inline [split $text \n] {struct Node *}] [lsearch -all -inline [split $text \n] {struct Labeled *}] \
        [expr {[hir::format $back] eq $text}] [hir::structs::treeField Node] [core::formatValue [core::compiler::evalHir $back]]
} -result {{{struct Node name Node ns - tree children fields value: int, children: List[Node]}} {{struct Labeled name Labeled ns - slots [T] tree kids fields label: T, kids: List[Labeled[T]], weight: int}} 1 children true}

test ts-hir-text-unknown-tree-field {HIR text naming a child field the struct does not have is refused} -body {
    set text [hir::format [tsHir "$::tsDecls\n1\n"]]
    catch {hir::parse [string map {"tree children fields" "tree kids fields"} $text]} message
    string match {*the tree field "kids" of struct Node is not one of its fields*} $message
} -result 1

test ts-interchange {interchange text carries the tree designation and child field: read back after a compilation that declares the same name as an ordinary struct, every backend walks and compares it as the tree it is} -constraints nativeBuilt -body {
    set source "$::tsDecls\[values(node(1, \[node(2, \[leaf(4)\]), leaf(3)\]), std::tree::Order::BreadthFirst), chain(5000, 1) == chain(5000, 1)\]\n"
    set hir [tsHir $source]
    set text [hir::interchange::encode $hir]
    tsHir "struct Node:\n    value: int\n    children: List\[Node\]\n1\n"
    set read [hir::interchange::decode $text]
    list [expr {$read eq [dict remove $hir traitSource]}] [hir::structs::treeField Node] [core::formatValue [core::compiler::evalHir $read]] \
        [core::formatValue [native::evalHir $read]] [core::formatValue [native::evalHir $read -specialize 0]]
} -result {1 children {[[1, 2, 3, 4], true]} {[[1, 2, 3, 4], true]} {[[1, 2, 3, 4], true]}}

test ts-compilation-isolation {a HIR keeps its own tree designation: run after another compilation declares Node as an ordinary struct, it still walks and compares as a tree (hir::activate)} -constraints nativeBuilt -body {
    set hir [tsHir "$::tsDecls\nvalues(node(1, \[leaf(2), leaf(3)\]), std::tree::Order::DepthFirst)\n"]
    set other [tsHir "struct Node:\n    value: int\n    children: List\[Node\]\n1\n"]
    list [hir::structs::treeField Node] [core::formatValue [core::compiler::evalHir $hir]] [core::formatValue [native::evalHir $hir]]
} -result {{} {[1, 2, 3]} {[1, 2, 3]}}

test ts-nir-shape {the NIR shape of a tree struct names its child field (tree="FIELD"); an ordinary struct's shape does not} -constraints nativeBuilt -body {
    set hir [tsHir "$::tsDecls\n\[node(1, \[\]) == node(1, \[\]), Plain {value: 1, children: \[\]} == Plain {value: 1, children: \[\]}, Labeled {label: 1, kids: \[\], weight: 0} == Labeled {label: 1, kids: \[\], weight: 0}\]\n"]
    set nir [dict get [native::lower::program $hir] text]
    lsort [lmap line [split $nir \n] {
        if {![regexp {^shape [0-9]+ named "(Node|Plain|Labeled)"} $line]} continue
        regsub {^shape [0-9]+ } $line {}
    }]
} -result {{named "Labeled" tree="kids" fields="label kids weight"} {named "Node" tree="children" fields="value children"} {named "Plain" fields="value children"}}

# ---------------------------------------------------------------------------
# Value semantics: construction, field access, subtrees, equality

test ts-construction-and-access {a tree is built with ordinary struct construction from child values that exist, and read with ordinary projections and destructuring; a parameterized tree is applied as any struct} -body {
    tsRun "t = node(1, \[node(2, \[leaf(4)\]), leaf(3)\])\nl = Labeled {label: \"a\", kids: \[Labeled {label: \"b\", kids: \[\], weight: 2}\], weight: 1}\n{value: v, children: kids} = t\n\[t.value, std::list::length(t.children), std::list::length(l.kids), l.weight, v, std::list::length(kids)\]\n"
} -result {value {[1, 2, 1, 1, 1, 2]}}

test ts-subtree-is-a-value {a subtree read from a tree is the value it represents: equal to an independently built tree, unchanged by building another tree around it, and no handle into its parent} -body {
    tsRun "t = node(1, \[node(2, \[leaf(4)\]), leaf(3)\])\nsub = t.children.at(0):\n    on IndexNotFound:\n        leaf(0)\nbigger = node(9, \[sub, sub\])\n\[sub == node(2, \[leaf(4)\]), bigger.children == \[sub, sub\], t == node(1, \[node(2, \[leaf(4)\]), leaf(3)\]), hash(sub) == hash(node(2, \[leaf(4)\]))\]\n"
} -result {value {[true, true, true, true]}}

test ts-equality {== is structural and order-sensitive: equal trees, a payload difference, children reordered, a child inserted or removed, a difference at a deep leaf, two declarations with the same fields} -body {
    tsRun "a = node(1, \[node(2, \[leaf(4), leaf(5)\]), leaf(3)\])\n\[
    a == node(1, \[node(2, \[leaf(4), leaf(5)\]), leaf(3)\]),
    a == node(1, \[node(2, \[leaf(4), leaf(6)\]), leaf(3)\]),
    a == node(1, \[leaf(3), node(2, \[leaf(4), leaf(5)\])\]),
    a == node(1, \[node(2, \[leaf(5), leaf(4)\]), leaf(3)\]),
    a == node(1, \[node(2, \[leaf(4), leaf(5)\]), leaf(3), leaf(3)\]),
    a == node(1, \[node(2, \[leaf(4)\]), leaf(3)\]),
    chain(300, 7) == chain(300, 7),
    chain(300, 7) == chain(300, 8),
    chain(300, 7) == chain(301, 7),
    Plain {value: 1, children: \[\]} == Plain {value: 1, children: \[\]},
    \[leaf(1)\] == \[leaf(1)\]
\]\n"
} -result {value {[true, false, false, false, false, false, true, false, false, true, true]}}

test ts-repeated-subtrees {two equal subtrees are two occurrences of the value: both are compared, hashed and visited} -body {
    tsRun "x = node(2, \[leaf(3)\])\nt = node(1, \[x, x\])\n\[t == node(1, \[node(2, \[leaf(3)\]), node(2, \[leaf(3)\])\]), t == node(1, \[x\]), values(t, std::tree::Order::DepthFirst), values(t, std::tree::Order::BreadthFirst)\]\n"
} -result {value {[true, false, [1, 2, 3, 2, 3], [1, 2, 2, 3, 3]]}}

test ts-printing {a tree prints as the struct it is, whatever its depth} -body {
    tsRun "node(1, \[node(2, \[leaf(4)\]), leaf(3)\])\n"
} -result {value {Node {value: 1, children: [Node {value: 2, children: [Node {value: 4, children: []}]}, Node {value: 3, children: []}]}}}

test ts-printing-same-as-struct {a tree's text, public hash and equality are the same as an ordinary struct's of the same shape and contents: the tree walks change how, never what} -body {
    set body {fn mk(n: int) -> T:
    if n == 0:
        return T {label: "z", tags: [n], children: [], weight: 1}
    T {label: "x", tags: [n, n + 1], children: [mk(n - 1), T {label: "y", tags: [], children: [], weight: n}], weight: n}
t = mk(4)
[hash(t), hash([t, t]), t == mk(4), t]
}
    set struct "struct T:\n    label: str\n    tags: List\[int\]\n    children: List\[T\]\n    weight: int\n$body"
    set tree "tree struct T:\n    label: str\n    tags: List\[int\]\n    children: List\[T\]\n    weight: int\n$body"
    list [expr {[sourceAgree $struct] eq [sourceAgree $tree]}] [lindex [sourceAgree $tree] 0]
} -result {1 value}

# ---------------------------------------------------------------------------
# Hashing, Equatable, Hashable

test ts-hash-coherent {equal trees hash equally in both hashes, however built; a reordered or changed tree hashes differently (these inputs)} -body {
    tsKeyed "a = node(1, \[node(2, \[leaf(4)\]), leaf(3)\])\nb = node(1, std::list::append(\[node(2, std::list::append(\[\], leaf(4)))\], leaf(3)))\nc = node(1, \[leaf(3), node(2, \[leaf(4)\])\])\n\[
    hash(a) == hash(b), std::hashfix::keyed(a) == std::hashfix::keyed(b),
    hash(a) == hash(c), std::hashfix::keyed(a) == std::hashfix::keyed(c),
    hash(chain(500, 1)) == hash(chain(500, 1)), std::hashfix::keyed(chain(500, 1)) == std::hashfix::keyed(chain(500, 1)),
    hash(chain(500, 1)) == hash(chain(500, 2))
\]\n" $::tsKey
} -result {value {[true, true, false, false, true, true, false]}}

test ts-hash-oracle {under a fixed test key, every backend computes the independent oracle's public and table hash of tree values: a tree's canonical input is its struct's, walked without recursion} -constraints python3 -body {
    proc tsJson {v kids} {
        return "{\"struct\": {\"id\": \"Node\", \"fields\": \[\[\"value\", {\"int\": \"$v\"}\], \[\"children\", {\"list\": \[[join $kids {, }]\]}\]\]}}"
    }
    set l4 [tsJson 4 {}]
    set l3 [tsJson 3 {}]
    set c [tsJson 0 {}]
    for {set i 1} {$i <= 40} {incr i} {
        set c [tsJson $i [list $c]]
    }
    set cases [list \
        {leaf(5)} [tsJson 5 {}] \
        {node(1, [node(2, [leaf(4)]), leaf(3)])} [tsJson 1 [list [tsJson 2 [list $l4]] $l3]] \
        {chain(40, 0)} $c \
        {[leaf(4), leaf(3)]} "{\"list\": \[$l4, $l3\]}"]
    set exprs {}
    set jsons {}
    foreach {e j} $cases {
        lappend exprs "\[hash($e), std::hashfix::keyed($e)\]"
        lappend jsons $j
    }
    set outcome [tsKeyed "\[[join $exprs {, }]\]\n" $::tsKey]
    set out [exec python3 -I [file join $::projectRoot audit hashable tools oracle.py] hash {*}$::tsKey << [join $jsons \n]]
    set expected "\[[join [lmap line [split $out \n] {format {[%s, %s]} {*}$line}] {, }]\]"
    expr {$outcome eq [list value $expected] ? "agree" : "$outcome != $expected"}
} -cleanup {rename tsJson {}} -result agree

test ts-hash-pinned {the public hash of a tree is fixed by its structure: deterministic across processes and backends} -body {
    tsRun "\[hash(leaf(5)), hash(node(1, \[node(2, \[leaf(4)\]), leaf(3)\]))\]\n"
} -result {value {[642836735067814376, 1750255903726798086]}}

test ts-totality-witnesses {a tree application is Equatable and Hashable exactly when its fields other than the child field are: a MutableMap and an ImmutableSet take tree keys, a set compares trees structurally} -body {
    tsRun {m = std::mutable_map::create[Node, str]()
m.set(node(1, [leaf(2)]), "a")
m.set(node(1, [leaf(3)]), "b")
m.set(node(1, [leaf(2)]), "c")
got = m.at(node(1, [leaf(2)])):
    on std::mutable_map::KeyNotFound:
        "none"
s = std::immutable_set::from_list([leaf(1), leaf(1), node(1, [leaf(1)])])
k = Labeled {label: [1, 2], kids: [], weight: 0}
[std::mutable_map::length(m), got, s == std::immutable_set::from_list([node(1, [leaf(1)]), leaf(1)]), std::immutable_set::contains(s, leaf(1)), hash(k) == hash(Labeled {label: [1, 2], kids: [], weight: 0})]
}
} -result {value {[2, "c", true, true, true]}}

test ts-totality-refused {a payload without total equality or hashing makes the application neither Equatable nor Hashable, and the reason names that payload field, never the child field} -body {
    list [tsRejection "$::tsDecls\nfn f(x: int) -> int:\n    x\nhash(Labeled {label: f, kids: \[\], weight: 0})\n"] \
        [tsKind "$::tsDecls\nhash(Labeled {label: std::mutable_vector::from_list(\[1\]), kids: \[\], weight: 0})\n"]
} -match glob -result {{TRAIT-NOT-SATISFIED {*field "label" of Labeled*}} TRAIT-NOT-SATISFIED}

test ts-totality-walk {the totality walk skips exactly the child field: Labeled[int] and Labeled[List[int]] are total, Labeled[any] is not known} -body {
    tsHir "$::tsDecls\n1\n"
    list [hir::types::Totality hash {nstruct Labeled int}] [hir::types::Totality equality {nstruct Labeled {{list int}}}] \
        [lindex [hir::types::Totality hash {nstruct Labeled any}] 0] [lindex [hir::types::Totality hash {nstruct Labeled {{fn {args {} return int errors {}}}}}] 0] \
        [hir::types::Totality hash {nstruct Node}]
} -result {{total ""} {total ""} unknown none {total ""}}

test ts-identity-payload {a payload with a representation-independent identity composes: two trees whose ImmutableMap attributes were built in different orders are equal and hash equally} -body {
    tsRun {tree struct Elem:
    attrs: std::immutable_map::ImmutableMap[str, int]
    children: List[Elem]
fn attrs(ks: List[str]) -> std::immutable_map::ImmutableMap[str, int]:
    m = std::mutable_map::create[str, int]()
    loop k in ks:
        m.set(k, 1)
    m.freeze()
a = Elem {attrs: attrs(["id", "class"]), children: [Elem {attrs: attrs(["xx", "yyy"]), children: []}]}
b = Elem {attrs: attrs(["class", "id"]), children: [Elem {attrs: attrs(["yyy", "xx"]), children: []}]}
c = Elem {attrs: attrs(["class", "id"]), children: [Elem {attrs: attrs(["yyy"]), children: []}]}
[a == b, hash(a) == hash(b), a == c]
}
} -result {value {[true, true, false]}}

test ts-equality-refusal {a tree whose payload has no total equality refuses == where it runs like any struct: the refusal names the values that have none} -body {
    set src "$::tsDecls\nfn mk() -> Labeled\[MutableVector\[int\]\]:\n    Labeled {label: std::mutable_vector::from_list(\[1\]), kids: \[\], weight: 0}\nfn same(a, b) -> bool:\n    a == b\nsame(mk(), mk())\n"
    set hir [tsHir $src]
    set result {}
    foreach run {{core::compiler::evalHir $hir} {native::evalHir $hir}} {
        catch $run message options
        lappend result [lindex [dict get $options -errorcode] end] [string match {*== is not defined for callables*} $message]
    }
    set result
} -result {EQUALITY 1 EQUALITY 1}

# ---------------------------------------------------------------------------
# Traversal

test ts-walk-orders {DepthFirst is preorder (a node, then each child's subtree, first to last) and BreadthFirst every node at depth N before any at depth N + 1, siblings in order; a one-node tree is its root} -body {
    tsRun "t = node(1, \[node(2, \[leaf(4), leaf(5)\]), leaf(3)\])\n\[values(t, std::tree::Order::DepthFirst), values(t, std::tree::Order::BreadthFirst), values(leaf(9), std::tree::Order::DepthFirst), values(leaf(9), std::tree::Order::BreadthFirst)\]\n"
} -result {value {[[1, 2, 4, 5, 3], [1, 2, 3, 4, 5], [9], [9]]}}

test ts-walk-levels {breadth-first visits depths in non-decreasing order, and each parent's children in their order, on an irregular tree} -body {
    tsRun "t = node(0, \[node(10, \[node(20, \[leaf(30)\]), leaf(21)\]), leaf(11), node(12, \[leaf(22), node(23, \[leaf(31), leaf(32)\])\])\])\n\[values(t, std::tree::Order::BreadthFirst), values(t, std::tree::Order::DepthFirst)\]\n"
} -result {value {[[0, 10, 11, 12, 20, 21, 22, 23, 30, 31, 32], [0, 10, 20, 30, 21, 11, 12, 22, 23, 31, 32]]}}

test ts-walk-yields-subtrees {a walk hands over the subtree values themselves, of the tree's own type: each one equals the subtree at its place, and its fields are read as any node's} -body {
    tsRun "t = node(1, \[node(2, \[leaf(4)\]), leaf(3)\])\ncoroutine {step, first} = std::tree::walk(t, std::tree::Order::DepthFirst)\nsecond = step()\nthird = step()\n\[first == t, second == node(2, \[leaf(4)\]), third.value, std::list::length(second.children), std::coroutine::done?(step)\]\n"
} -result {value {[true, true, 4, 1, false]}}

test ts-walk-handle-type {a walk's handle is an ordinary zero-message coroutine whose outward type is the tree's own (the semantic instance of the call types the construction)} -body {
    set hir [tsHir "$::tsDecls\ncoroutine {step, first} = std::tree::walk(leaf(1), std::tree::Order::DepthFirst)\nl = Labeled {label: \"a\", kids: \[\], weight: 0}\ncoroutine {step: step2, first: first2} = std::tree::walk(l, std::tree::Order::BreadthFirst)\n\[first.value, first2.label\]\n"]
    set types {}
    foreach name {step first step2 first2} {
        lappend types $name [hir::types::show [hir::typeOf $hir [lindex [hirFind $hir bind $name] end]]]
    }
    set types
} -result {step {Coroutine{args: [], return: Node, errors: []}} first Node step2 {Coroutine{args: [], return: Labeled[str], errors: []}} first2 {Labeled[str]}}

test ts-walk-parameterized {a parameterized tree is walked in both orders, its subtrees of its own application} -body {
    tsRun "fn labels(root: Labeled\[str\], order: std::tree::Order) -> List\[str\]:\n    out = std::mutable_vector::from_list(\[root.label\])\n    coroutine {step, first} = std::tree::walk(root, order)\n    loop:\n        if std::coroutine::done?(step):\n            break\n        out.push(step().label)\n    loop s in out:\n        s\nfn lb(s: str, kids: List\[Labeled\[str\]\]) -> Labeled\[str\]:\n    Labeled {label: s, kids: kids, weight: 0}\nt = lb(\"r\", \[lb(\"a\", \[lb(\"c\", \[\])\]), lb(\"b\", \[\])\])\n\[labels(t, std::tree::Order::DepthFirst), labels(t, std::tree::Order::BreadthFirst)\]\n"
} -result {value {[["r", "a", "c", "b"], ["r", "a", "b", "c"]]}}

test ts-walk-not-a-tree {walking a value that is no tree struct's is the call's TYPE error, explained (TREE-OPERAND): an Int, an ordinary recursive struct} -body {
    list [tsRejection "import std::tree\nfn go() -> int:\n    coroutine {step, first} = std::tree::walk(5, std::tree::Order::DepthFirst)\n    1\ngo()\n"] \
        [tsKind "$::tsDecls\nfn go() -> int:\n    coroutine {step, first} = std::tree::walk(Plain {value: 1, children: \[\]}, std::tree::Order::DepthFirst)\n    1\ngo()\n"]
} -match glob -result {{TYPE {call to std::tree::walk with root : int, order : std::tree::Order is invalid: a tree's children are taken of a value of a tree struct, but this value's type is int*}} TYPE}

test ts-walk-generic-caller {an untyped function that walks its argument is valid for the tree types its calls give it (semantic instances); one that may run with an unknown type is rejected, never looked up at run time} -body {
    list [tsRun "fn first_two(t):\n    coroutine {step, first} = std::tree::walk(t, std::tree::Order::DepthFirst)\n    \[first, step()\]\nfirst_two(node(1, \[leaf(2)\]))\n"] \
        [tsKind "$::tsDecls\nfn first_of(t):\n    coroutine {step, first} = std::tree::walk(t, std::tree::Order::DepthFirst)\n    first\nf = first_of\n1\n"]
} -result {{value {[Node {value: 1, children: [Node {value: 2, children: []}]}, Node {value: 2, children: []}]}} UNPROVEN-FIELD}

test ts-children-internal {std::tree::children is internal to the standard library: a program reads a tree's children as its field} -body {
    tsRejection "import std::tree\ntree struct Node:\n    children: List\[Node\]\nstd::tree::children(Node {children: \[\]})\n"
} -result {INTERNAL-NAMESPACE {"std::tree::children" is internal to the standard library: it gives the standard library's own modules a representation of "std::tree" that only they may see (the entry program is not one)}}

test ts-generic-construction-typed {a coroutine constructed from an untyped function is typed by the call's semantic instance: its first value and every resume have the instance's outward type, the join of what its yields send and what it returns (yielding a List of nodes and returning the empty List, its type is the List of nodes)} -body {
    tsRun "fn gen(x):\n    loop c in x.children:\n        yield c\n    x\nfn kids_then_none(x):\n    yield x.children\n    \[\]\nr = node(1, \[leaf(2), leaf(3)\])\ncoroutine {step, first} = gen(r)\nb = step()\nc = step()\ncoroutine {step: more, first: kids} = kids_then_none(r)\nvalues_of = loop k in kids:\n    k.value\n\[first.value, b.value, c.value, std::coroutine::done?(step), values_of, more()\]\n"
} -result {value {[2, 3, 1, true, [2, 3], []]}}

# ---------------------------------------------------------------------------
# Deep and wide trees

test ts-deep-chain {a chain 20,000 nodes deep -- twenty times the harness's recursion limit -- is built, compared equal and unequal near its leaf, hashed and walked in both orders on every backend, with no host recursion} -body {
    tsRun "a = chain(20000, 1)\nb = chain(20000, 1)\nc = chain(20000, 2)\n\[a == b, a == c, hash(a) == hash(b), hash(a) == hash(c), digest(a, std::tree::Order::DepthFirst), digest(a, std::tree::Order::BreadthFirst)\]\n"
} -result {value {[true, false, true, false, [20001, 2244320372828816551], [20001, 2244320372828816551]]}}

test ts-deep-chain-print {a chain thousands deep prints without host recursion} -body {
    set outcome [tsRun "chain(3000, 1)\n"]
    set text [lindex $outcome 1]
    list [lindex $outcome 0] [string length $text] \
        [string equal [string range $text 0 47] "Node \x7bvalue: 3000, children: \x5bNode \x7bvalue: 2999,"] \
        [string equal [string range $text end-5 end] "\x5d\x7d\x5d\x7d\x5d\x7d"]
} -result {value 94922 1 1}

test ts-deep-native {natively, a chain a million nodes deep compares, hashes, prints its root's field and walks in both orders on a 1 MiB worker stack: none of them recurses on the host's stack} -constraints nativeBuilt -body {
    set hir [tsHir "$::tsDecls\na = chain(1000000, 1)\nb = chain(1000000, 1)\nc = chain(1000000, 2)\n\[a == b, a == c, hash(a) == hash(b), hash(a) == hash(c), digest(a, std::tree::Order::DepthFirst), digest(a, std::tree::Order::BreadthFirst)\]\n"]
    set saved [expr {[info exists ::env(BOTLISH_NATIVE_STACK_BYTES)] ? $::env(BOTLISH_NATIVE_STACK_BYTES) : ""}]
    set ::env(BOTLISH_NATIVE_STACK_BYTES) 1048576
    try {
        core::formatValue [native::evalHir $hir]
    } finally {
        if {$saved eq ""} { unset ::env(BOTLISH_NATIVE_STACK_BYTES) } else { set ::env(BOTLISH_NATIVE_STACK_BYTES) $saved }
    }
} -result {[true, false, true, false, [1000001, 1785376435676727901], [1000001, 1785376435676727901]]}

test ts-wide {a root with 30,000 children, each with one child: child order, equality, hashes and both walks (the breadth-first queue drops its visited prefix as it goes)} -body {
    tsRun "fn wide(n: int, twist: int) -> Node:\n    kids = loop i from 0 to n:\n        if i == twist:\n            node(i, \[leaf(0 - i)\])\n        else:\n            node(i, \[leaf(i)\])\n    node(7, kids)\na = wide(30000, -1)\nb = wide(30000, -1)\nc = wide(30000, 29999)\n\[a == b, a == c, hash(a) == hash(b), hash(a) == hash(c), digest(a, std::tree::Order::DepthFirst), digest(a, std::tree::Order::BreadthFirst), values(node(1, \[leaf(2), leaf(3), leaf(4), leaf(5)\]), std::tree::Order::BreadthFirst)\]\n" {compile cranelift-generic cranelift}
} -result {value {[true, false, true, false, [60001, 2133005430066698954], [60001, 1260954226244719589], [1, 2, 3, 4, 5]]}}

test ts-wide-interp {the interpreter walks and compares a 2,000-child root as the other backends do} -body {
    tsRun "kids = loop i from 0 to 2000:\n    node(i, \[leaf(i)\])\na = node(7, kids)\n\[a == node(7, kids), digest(a, std::tree::Order::DepthFirst), digest(a, std::tree::Order::BreadthFirst)\]\n"
} -result {value {[true, [4001, 1063359645131734756], [4001, 491805807458027375]]}}

# ---------------------------------------------------------------------------
# Representation independence

test ts-representation-independence {trees with the same ordered value built through different histories -- bottom-up recursion, children appended one by one, a level-by-level build from the leaves up -- are equal, hash equally under both hashes and walk alike} -body {
    tsKeyed {fn pow2(k: int) -> int:
    if k == 0:
        return 1
    2 * pow2(k - 1)
fn upto(n: int) -> List[int]:
    loop i from 1 through n:
        i
fn rec(d: int, v: int) -> Node:
    if d == 0:
        return leaf(v)
    node(v, [rec(d - 1, v * 2), rec(d - 1, v * 2 + 1)])
fn by_append(d: int, v: int) -> Node:
    if d == 0:
        return leaf(v)
    kids = std::list::append(std::list::append([], by_append(d - 1, v * 2)), by_append(d - 1, v * 2 + 1))
    node(v, kids)
fn by_levels(d: int) -> Node:
    level = std::mutable_vector::from_list([leaf(0)])
    level.clear()
    loop v from pow2(d) to 2 * pow2(d):
        level.push(leaf(v))
    loop k down from d - 1 through 0:
        built = loop j from 0 to pow2(k):
            l = level.at(2 * j):
                on IndexNotFound:
                    leaf(0)
            r = level.at(2 * j + 1):
                on IndexNotFound:
                    leaf(0)
            node(pow2(k) + j, [l, r])
        level.clear()
        loop n in built:
            level.push(n)
    level.at(0):
        on IndexNotFound:
            leaf(0)
a = rec(6, 1)
b = by_append(6, 1)
c = by_levels(6)
[a == b, a == c, hash(a) == hash(b), hash(a) == hash(c), std::hashfix::keyed(a) == std::hashfix::keyed(c), values(a, std::tree::Order::DepthFirst) == values(c, std::tree::Order::DepthFirst), values(a, std::tree::Order::BreadthFirst) == values(c, std::tree::Order::BreadthFirst), values(c, std::tree::Order::BreadthFirst) == upto(127)]
} $::tsKey
} -result {value {[true, true, true, true, true, true, true, true]}}

# ---------------------------------------------------------------------------
# The filesystem specimen

test ts-filesystem-specimen {the motivating shape: a FileTree of paths with List[FileTree] children needs no reference-bearing node model, and a breadth-first walk lists it level by level} -body {
    sourceAgree {import std::coroutine
import std::mutable_vector
import std::tree

tree struct FileTree:
    path: str
    children: List[FileTree]

nomethod fn file(path: str) -> FileTree:
    FileTree {path: path, children: []}

nomethod fn paths(root: FileTree, order: std::tree::Order) -> List[str]:
    out = std::mutable_vector::from_list([root.path])
    coroutine {step, first} = std::tree::walk(root, order)
    loop:
        if std::coroutine::done?(step):
            break
        out.push(step().path)
    loop p in out:
        p

src = FileTree {path: "/src", children: [file("/src/main.bot"), FileTree {path: "/src/lib", children: [file("/src/lib/a.bot")]}]}
root = FileTree {path: "/", children: [src, file("/README.md")]}
[paths(root, std::tree::Order::BreadthFirst), paths(root, std::tree::Order::DepthFirst), root.children == [src, file("/README.md")]]
}
} -result {value {[["/", "/src", "/README.md", "/src/main.bot", "/src/lib", "/src/lib/a.bot"], ["/", "/src", "/src/main.bot", "/src/lib", "/src/lib/a.bot", "/README.md"], true]}}

# ---------------------------------------------------------------------------
# Standalone executables

test ts-executable {a standalone executable compares, hashes, walks and prints trees as the JIT does: the program descriptor carries each tree shape's child slot, so a chain 300,000 deep compares on a 1 MiB stack, and the executable prints its result with the native printer} -constraints executableAot -setup {
    set dir [makeDirectory {ts aot}]
} -body {
    set hir [tsHir "$::tsDecls\na = chain(300000, 1)\n\[a == chain(300000, 1), a == chain(300000, 2), hash(node(1, \[leaf(2)\])), values(node(1, \[node(2, \[leaf(4)\]), leaf(3)\]), std::tree::Order::BreadthFirst), node(1, \[node(2, \[leaf(4)\]), leaf(3)\])\]\n"]
    set binary [native::executable $hir [file join $dir program]]
    set saved [expr {[info exists ::env(BOTLISH_NATIVE_STACK_BYTES)] ? $::env(BOTLISH_NATIVE_STACK_BYTES) : ""}]
    set ::env(BOTLISH_NATIVE_STACK_BYTES) 1048576
    try {
        list [exec $binary] [core::formatValue [native::evalHir $hir]]
    } finally {
        if {$saved eq ""} { unset ::env(BOTLISH_NATIVE_STACK_BYTES) } else { set ::env(BOTLISH_NATIVE_STACK_BYTES) $saved }
    }
} -cleanup {
    removeDirectory {ts aot}
} -result {{[true, false, 1938861805063967348, [1, 2, 3, 4], Node {value: 1, children: [Node {value: 2, children: [Node {value: 4, children: []}]}, Node {value: 3, children: []}]}]} {[true, false, 1938861805063967348, [1, 2, 3, 4], Node {value: 1, children: [Node {value: 2, children: [Node {value: 4, children: []}]}, Node {value: 3, children: []}]}]}}

cleanupTests
