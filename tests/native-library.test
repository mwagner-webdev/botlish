# ---------------------------------------------------------------------------
# Lifecycle and threads

test nl-lifecycle {create, destroy, recreate; destroyed, foreign and NULL handles are refused} -constraints nativeLibraries -body {
    set dir [nlDir]
    set built [nlLibrary $dir chk $::nlChecked]
    set exe [nlExecutable $dir "[nlPrelude chk]
int main(void) {
    chk_instance *a, *b; chk_error *e = NULL; int64_t r;
    printf(\"abi %u\\n\", chk_abi_version());
    check(\"create a\", chk_create(&a, &e), &e);
    check(\"create b\", chk_create(&b, &e), &e);
    printf(\"distinct: %d\\n\", a != b);
    check(\"a\", chk_checked(a, 1, &r, &e), &e);
    check(\"destroy a\", chk_destroy(a), NULL);
    report(\"call a\", chk_checked(a, 1, &r, &e), &e);
    printf(\"destroy a again: %d\\n\", chk_destroy(a));
    check(\"b\", chk_checked(b, 2, &r, &e), &e); printf(\"b: %lld\\n\", (long long) r);
    report(\"call NULL\", chk_checked(NULL, 1, &r, &e), &e);
    report(\"call garbage\", chk_checked((chk_instance *) &r, 1, &r, &e), &e);
    report(\"create into NULL\", chk_create(NULL, &e), &e);
    for (int i = 0; i < 50; i++) {
        check(\"create\", chk_create(&a, &e), &e);
        check(\"call\", chk_checked(a, i, &r, &e), &e);
        check(\"destroy\", chk_destroy(a), NULL);
    }
    printf(\"50 instances made and destroyed\\n\");
    check(\"destroy b\", chk_destroy(b), NULL);
    return 0;
}
" [list [nlLink $built]]]
    nlRunBoth $exe
} -result {abi 1
distinct: 1
call a: status 4 INVALID-INSTANCE
destroy a again: 4
b: 4
call NULL: status 4 INVALID-INSTANCE
call garbage: status 4 INVALID-INSTANCE
create into NULL: status 4 NULL-POINTER
50 instances made and destroyed}

test nl-threads {an instance refuses other threads; instances on four threads run at once} -constraints nativeLibraries -body {
    set dir [nlDir]
    set source {
import std::str

exported c fn work(seed: int, rounds: int) -> int:
    xs = loop i from 0 to rounds:
        std::str::concat("item ", std::str::concat("x", "y"))
    total = loop x in xs:
        std::str::length(x) + seed
    std::list::length(total)

exported c fn add(a: int, b: int) -> int:
    a + b
}
    set built [nlLibrary $dir thr "import std::list\n$source"]
    set exe [nlExecutable $dir "[nlPrelude thr]
static thr_instance *shared;
static void *foreign_call(void *arg) {
    int64_t r; thr_error *e = NULL;
    report(\"call from another thread\", thr_add(shared, 1, 2, &r, &e), &e);
    printf(\"destroy from another thread: %d\\n\", thr_destroy(shared));
    return NULL;
}
static void *own(void *arg) {
    thr_instance *in; thr_error *e = NULL; int64_t r, sum = 0;
    if (thr_create(&in, &e) != thr_STATUS_OK) return (void *) 1;
    for (int i = 0; i < 20; i++) {
        if (thr_work(in, (int64_t) (intptr_t) arg, 300, &r, &e) != thr_STATUS_OK) return (void *) 2;
        sum += r;
    }
    thr_destroy(in);
    return sum == 20 * 300 ? NULL : (void *) 3;
}
int main(void) {
    thr_error *e = NULL; int64_t r;
    check(\"create\", thr_create(&shared, &e), &e);
    nl_thread t;
    nl_thread_start(&t, 0, foreign_call, NULL);
    nl_thread_join(&t);
    check(\"own thread still works\", thr_add(shared, 1, 2, &r, &e), &e);
    printf(\"add = %lld\\n\", (long long) r);
    nl_thread ts\[4\]; void *results\[4\];
    for (int i = 0; i < 4; i++) nl_thread_start(&ts\[i\], 0, own, (void *) (intptr_t) i);
    for (int i = 0; i < 4; i++) results\[i\] = nl_thread_join(&ts\[i\]);
    for (int i = 0; i < 4; i++) printf(\"thread %d: %s\\n\", i, results\[i\] == NULL ? \"ok\" : \"failed\");
    check(\"destroy\", thr_destroy(shared), NULL);
    return 0;
}
" [list [nlLink $built]] -lpthread]
    nlRunBoth $exe
} -result {call from another thread: status 4 WRONG-THREAD
destroy from another thread: 4
add = 3
thread 0: ok
thread 1: ok
thread 2: ok
thread 3: ok}

test nl-reentrant {a C function a Botlish export calls cannot call the same instance again; it can call another} -constraints nativeLibraries -body {
    set dir [nlDir]
    set source {
extern c fn host_callback(n: std::ffi::c::LongLong) -> std::ffi::c::LongLong

exported c fn outer(n: int) -> int:
    if n < -1000 or n > 1000:
        return 0
    host_callback(n) + 0

exported c fn inner(n: int) -> int:
    n * 10
}
    lassign [nlHostCallback $dir] declaration hostLibs
    set built [nlLibrary $dir re "import std::ffi::c\n$declaration$source" {} -shared 0]
    set exe [nlExecutable $dir "[nlPrelude re]
static re_instance *first, *second;
long long host_callback(long long n) {
    int64_t r; re_error *e = NULL;
    int32_t s = re_inner(first, n, &r, &e);
    report(\"reentrant call of the same instance\", s, &e);
    check(\"call of another instance\", re_inner(second, n, &r, &e), &e);
    return r;
}
int main(void) {
    re_error *e = NULL; int64_t r;
    NL_REGISTER(host_callback);
    check(\"create\", re_create(&first, &e), &e);
    check(\"create\", re_create(&second, &e), &e);
    check(\"outer\", re_outer(first, 7, &r, &e), &e);
    printf(\"outer(7) = %lld\\n\", (long long) r);
    check(\"after\", re_inner(first, 1, &r, &e), &e);
    printf(\"inner(1) = %lld\\n\", (long long) r);
    re_destroy(first); re_destroy(second);
    return 0;
}
" [list [nlLink $built] {*}$hostLibs]]
    nlRunBoth $exe
} -result {reentrant call of the same instance: status 4 REENTRANT-CALL
outer(7) = 70
inner(1) = 10}

# The general coroutine runtime inside a call: chain(n) drives a recursive
# yielding function, allocating on both stacks, and returns 2n.
set ::nlChain {
import std::str

struct Message:
    text: str

fn produce(i: int, n: int, acc: str, resume Message) -> str:
    if i >= n:
        return acc
    message = yield std::str::concat("item ", acc)
    produce(i + 1, n, std::str::concat(acc, message.text))

fn drive(step: Coroutine{args: [Message], return: str}, k: int, last: str) -> str:
    if k <= 0:
        return last
    next = step(Message {text: std::str::concat("x", "y")})
    drive(step, k - 1, next)

exported c fn chain(n: int) -> int:
    if n < 0 or n > 10000:
        return 0
    coroutine {step, first} = produce(0, n, "")
    std::str::length(drive(step, n + 1, first))
}

# A coroutine inside a call: the export drives a recursive yielding
# function (recursive, so never fused: the general runtime's stacks and
# switches), allocating on both stacks, while the collector walks the
# coroutine's stack and the call's, which ends at the call.
test nl-coroutine-inside {an export that runs a coroutine on the general runtime, many times, under GC stress} -constraints {nativeLibraries nativeCoroutines} -body {
    set dir [nlDir]
    set built [nlLibrary $dir co {
import std::str

struct Message:
    text: str

fn produce(i: int, n: int, acc: str, resume Message) -> str:
    if i >= n:
        return acc
    message = yield std::str::concat("item ", acc)
    produce(i + 1, n, std::str::concat(acc, message.text))

fn drive(step: Coroutine{args: [Message], return: str}, k: int, last: str) -> str:
    if k <= 0:
        return last
    next = step(Message {text: std::str::concat("x", "y")})
    drive(step, k - 1, next)

exported c fn chain(n: int) -> int:
    if n < 0 or n > 10000:
        return 0
    coroutine {step, first} = produce(0, n, "")
    std::str::length(drive(step, n + 1, first))
}]
    set exe [nlExecutable $dir "[nlPrelude co]
int main(void) {
    co_instance *in; co_error *e = NULL; int64_t r = 0, total = 0;
    check(\"create\", co_create(&in, &e), &e);
    for (int i = 0; i < 200; i++) {
        check(\"chain\", co_chain(in, i, &r, &e), &e);
        total += r;
    }
    check(\"chain\", co_chain(in, 3000, &r, &e), &e);
    printf(\"200 calls: %lld; chain(3000) = %lld\\n\", (long long) total, (long long) r);
    co_destroy(in);
    return 0;
}
" [list [nlLink $built]]]
    nlRunBoth $exe
} -result {200 calls: 39800; chain(3000) = 6000}

# Stack safety (NATIVE-LIBRARY-MILESTONE-1.md, "Stack safety"): a library
# installs no stack guard in its host, so its functions check their stack
# pointer (codegen::clif's prologue_stack_limit). Recursion that would exhaust
# the calling thread's stack -- the main thread's, or a small thread's such as
# a React Native JS thread (512 KiB) -- fails with the runtime error NATIVE
# LIMIT STACK, and the instance answers the next call.
set ::nlDepth {
fn down(n: int) -> int:
    if n <= 0:
        return 0
    down(n - 1) + 1

exported c fn depth(n: int) -> int:
    down(n)
}

test nl-stack-safety {exhausting a thread's stack is NATIVE LIMIT STACK, never the end of the process; the instance goes on} -constraints nativeLibraries -body {
    set dir [nlDir]
    set built [nlLibrary $dir st $::nlDepth]
    set exe [nlExecutable $dir "[nlPrelude st]
static void probe(const char *where) {
    st_instance *in; st_error *e = NULL; int64_t r = -1; int32_t s;
    check(\"create\", st_create(&in, &e), &e);
    s = st_depth(in, 2000, &r, &e);
    printf(\"%s: depth(2000) status %d = %lld\\n\", where, (int) s, (long long) r);
    s = st_depth(in, 100000000, &r, &e);
    report(where, s, &e);
    s = st_depth(in, 1000, &r, &e);
    printf(\"%s: then depth(1000) status %d = %lld\\n\", where, (int) s, (long long) r);
    check(\"destroy\", st_destroy(in), NULL);
}
static void *thread(void *where) { probe(where); return NULL; }
int main(void) {
    probe(\"main thread\");
    size_t sizes\[\] = {512 * 1024, 1024 * 1024};
    const char *names\[\] = {\"512 KiB thread\", \"1 MiB thread\"};
    for (int i = 0; i < 2; i++) {
        nl_thread t;
        nl_thread_start(&t, sizes\[i\], thread, (void *) names\[i\]);
        nl_thread_join(&t);
    }
    return 0;
}
" [list [nlLink $built]] -pthread]
    nlRunBoth $exe
} -result {main thread: depth(2000) status 0 = 2000
main thread: status 2 NATIVE LIMIT STACK
main thread: then depth(1000) status 0 = 1000
512 KiB thread: depth(2000) status 0 = 2000
512 KiB thread: status 2 NATIVE LIMIT STACK
512 KiB thread: then depth(1000) status 0 = 1000
1 MiB thread: depth(2000) status 0 = 2000
1 MiB thread: status 2 NATIVE LIMIT STACK
1 MiB thread: then depth(1000) status 0 = 1000}

# The same inside a coroutine, whose body runs on the coroutine's own stack
# (8 MiB by default) and is bounded by it: the check's limit follows every
# switch (Vm::publish_active_stack). `in_coroutine` hands its handle to
# another function, so its coroutine keeps the general runtime and really
# runs on a coroutine stack (codegen::fusion); the call runs on a 512 KiB
# thread, where `depth(50000)` cannot run, so `in_coroutine(50000)`
# succeeding shows the coroutine's stack bounding it. `fused` resumes its
# coroutine in place, which fusion inlines into it, on the thread's stack --
# and a library with a fused coroutine keeps its other exports' code
# (`depth`; codegen::fusion's drop_unreferenced).
test nl-stack-safety-coroutine {recursion on a coroutine's stack inside a call is bounded by that stack, not the thread's} -constraints {nativeLibraries nativeCoroutines} -body {
    set dir [nlDir]
    set built [nlLibrary $dir sc "$::nlDepth
struct Go:
    extra: int

fn later(n: int, resume Go) -> int:
    go = yield 0
    down(n + go.extra)

fn resume_with(step: Coroutine{args: \[Go\], return: int}, extra: int) -> int:
    step(Go {extra: extra})

exported c fn in_coroutine(n: int) -> int:
    coroutine {step, first} = later(n)
    resume_with(step, first)

exported c fn fused(n: int) -> int:
    coroutine {step, first} = later(n)
    step(Go {extra: first})
"]
    set exe [nlExecutable $dir "[nlPrelude sc]
static void call(sc_instance *in, const char *name, int64_t n) {
    sc_error *e = NULL; int64_t r = -1; int32_t s;
    if (name\[0\] == 'd') s = sc_depth(in, n, &r, &e);
    else if (name\[0\] == 'i') s = sc_in_coroutine(in, n, &r, &e);
    else s = sc_fused(in, n, &r, &e);
    char what\[64\];
    snprintf(what, sizeof what, \"%s(%lld)\", name, (long long) n);
    if (s != sc_STATUS_OK) report(what, s, &e);
    else printf(\"%s = %lld\\n\", what, (long long) r);
}
static void *thread(void *unused) {
    sc_instance *in; sc_error *e = NULL;
    (void) unused;
    check(\"create\", sc_create(&in, &e), &e);
    call(in, \"depth\", 3000);
    call(in, \"depth\", 50000);
    call(in, \"in_coroutine\", 50000);
    call(in, \"in_coroutine\", 100000000);
    call(in, \"fused\", 3000);
    call(in, \"fused\", 50000);
    call(in, \"in_coroutine\", 500);
    call(in, \"depth\", 1000);
    check(\"destroy\", sc_destroy(in), NULL);
    return NULL;
}
int main(void) {
    nl_thread t;
    nl_thread_start(&t, 512 * 1024, thread, NULL);
    nl_thread_join(&t);
    return 0;
}
" [list [nlLink $built]] -pthread]
    nlRunBoth $exe
} -result {depth(3000) = 3000
depth(50000): status 2 NATIVE LIMIT STACK
in_coroutine(50000) = 50000
in_coroutine(100000000): status 2 NATIVE LIMIT STACK
fused(3000) = 3000
fused(50000): status 2 NATIVE LIMIT STACK
in_coroutine(500) = 500
depth(1000) = 1000}

# A call made on a stack the instance did not make -- a host's own coroutine
# or fiber stack, here a ucontext on mapped memory -- has no limit of ours
# (Vm::stack_limit_at): it is never checked against the thread's stack, which
# would fail every call there. The thread's limit is back for the next call.
test nl-stack-safety-foreign-stack {a call on a host-made stack is not checked against the thread's limit, and its collections walk that stack; the next call on the thread is checked} -constraints {nativeLibraries nativeCoroutines} -body {
    set dir [nlDir]
    set built [nlLibrary $dir fs "$::nlChain$::nlDepth"]
    set exe [nlExecutable $dir "[nlPrelude fs]
#ifndef _WIN32
#include <sys/mman.h>
#include <ucontext.h>
static ucontext_t back, there;
#else
static void *back;
#endif
static fs_instance *in;
static void call(const char *where, int64_t n) {
    fs_error *e = NULL; int64_t r = -1;
    int32_t s = fs_depth(in, n, &r, &e);
    char what\[64\];
    snprintf(what, sizeof what, \"%s: depth(%lld)\", where, (long long) n);
    if (s != fs_STATUS_OK) report(what, s, &e);
    else printf(\"%s = %lld\\n\", what, (long long) r);
}
/* Coroutines and allocation on the host's stack: the collector walks it,
   the coroutine's resumer frames on it included, and code back on it after
   a switch checks no limit of the thread's. */
static void chain_there(void) {
    fs_error *e = NULL; int64_t r = -1;
    int32_t s = fs_chain(in, 300, &r, &e);
    if (s != fs_STATUS_OK) report(\"host stack: chain(300)\", s, &e);
    else printf(\"host stack: chain(300) = %lld\\n\", (long long) r);
}
#ifndef _WIN32
static void on_foreign_stack(void) { call(\"host stack\", 2000); chain_there(); }
#else
/* Windows: the host's own fiber, a stack of 1 MiB the host made. */
static void WINAPI on_foreign_stack(void *unused) { (void) unused; call(\"host stack\", 2000); chain_there(); SwitchToFiber(back); }
#endif
int main(void) {
    fs_error *e = NULL;
    check(\"create\", fs_create(&in, &e), &e);
    size_t size = 1024 * 1024;
#ifndef _WIN32
    void *stack = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_STACK, -1, 0);
    if (stack == MAP_FAILED) return 1;
    getcontext(&there);
    there.uc_stack.ss_sp = stack;
    there.uc_stack.ss_size = size;
    there.uc_link = &back;
    makecontext(&there, on_foreign_stack, 0);
    swapcontext(&back, &there);
#else
    back = ConvertThreadToFiber(NULL);
    void *there = CreateFiber(size, on_foreign_stack, NULL);
    if (back == NULL || there == NULL) return 1;
    SwitchToFiber(there);
    DeleteFiber(there);
    ConvertFiberToThread();
#endif
    call(\"thread\", 2000);
    call(\"thread\", 100000000);
    call(\"thread\", 1000);
    check(\"destroy\", fs_destroy(in), NULL);
    return 0;
}
" [list [nlLink $built]]]
    nlRunBoth $exe
} -result {host stack: depth(2000) = 2000
host stack: chain(300) = 600
thread: depth(2000) = 2000
thread: depth(100000000): status 2 NATIVE LIMIT STACK
thread: depth(1000) = 1000}

# The walk's boundary (Vm::stack_ceiling): a call's collections walk its own
# frames, never the frames above it. Instance `first`'s export holds a
# MutableVector across a C call (a safepoint) whose callback runs instance
# `second` of the same library, which collects. Were the walk to climb past
# `second`'s call into `first`'s frame -- the callback keeps a frame record
# -- `second` would mark `first`'s vector in `first`'s heap; `first` would
# then push into it and, at its next collection, skip the marked vector
# and free the new elements still in it.
test nl-walk-boundary {a call's collections never walk the frames above the call, an outer call of another instance included} -constraints nativeLibraries -body {
    set dir [nlDir]
    set source {
import std::ffi::c
import std::list
import std::mutable_vector
import std::str

DECLARATIONextern c fn host_callback(n: std::ffi::c::LongLong) -> std::ffi::c::LongLong

fn churn(k: int) -> int:
    xs = loop i from 0 to k:
        std::str::concat("churn ", std::str::concat("x", "y"))
    std::list::length(xs)

exported c fn outer(n: int) -> int errors IndexNotFound:
    if n < 0 or n > 1000000:
        return 0
    v = std::mutable_vector::from_list([std::str::concat("fir", "st")])
    r = host_callback(n) + 0
    v.push(std::str::concat("second ", "element"))
    v.push(std::str::concat("third ", "one"))
    c = churn(n)
    lengths = std::str::length(v.at(0)) + std::str::length(v.at(1)) + std::str::length(v.at(2))
    if r != n or c != n:
        return -1
    lengths

exported c fn busy(n: int) -> int:
    if n < 0 or n > 1000000:
        return 0
    churn(n)
}
    lassign [nlHostCallback $dir] declaration hostLibs
    set built [nlLibrary $dir wb [string map [list DECLARATION $declaration] $source] {} -shared 0]
    set exe [nlExecutable $dir "[nlPrelude wb]
static wb_instance *second;
long long host_callback(long long n) {
    int64_t r; wb_error *e = NULL;
    check(\"busy\", wb_busy(second, n, &r, &e), &e);
    return r;
}
int main(void) {
    wb_instance *first; wb_error *e = NULL; int64_t r;
    NL_REGISTER(host_callback);
    check(\"create\", wb_create(&first, &e), &e);
    check(\"create\", wb_create(&second, &e), &e);
    for (int i = 0; i < 3; i++) {
        check(\"outer\", wb_outer(first, 200000, &r, &e), &e);
        printf(\"outer = %lld\\n\", (long long) r);
    }
    wb_destroy(second); wb_destroy(first);
    return 0;
}
" [list [nlLink $built] {*}$hostLibs] -fno-omit-frame-pointer]
    nlRun $exe
} -result {outer = 28
outer = 28
outer = 28}

# ---------------------------------------------------------------------------
# Several libraries in one process

set ::nlFirst {
import std::str

error Negative:
    value: int

exported c fn twice(n: int) -> int errors Negative:
    if n < 0:
        fail Negative {value: n}
    n * 2

exported c fn tag(text: str) -> str:
    std::str::concat("first:", text)
}
set ::nlSecond {
import std::str
import std::list

error Negative:
    value: int
    why: str

exported c fn twice(n: int) -> int errors Negative:
    if n < 0:
        fail Negative {value: n, why: "second"}
    xs = loop i from 0 to n:
        i
    std::list::length(xs) * 3

exported c fn tag(text: str) -> str:
    std::str::concat(text, ":second")
}

test nl-two-libraries {two independently compiled libraries in one executable compute their own results, alternating, under GC stress} -constraints nativeLibraries -body {
    set dir [nlDir]
    set first [nlLibrary $dir one $::nlFirst]
    set second [nlLibrary $dir two $::nlSecond]
    set exe [nlExecutable $dir "[nlPrelude one]
#include \"two.h\"
static void report2(const char *what, int32_t status, two_error **ep) {
    const uint8_t *p; size_t l; two_error *e = *ep;
    printf(\"%s: status %d\", what, (int) status);
    if (e) { two_error_identity(e, &p, &l); printf(\" %.*s fields %zu\", (int) l, (const char *) p, two_error_field_count(e)); two_error_release(ep); }
    printf(\"\\n\");
}
int main(void) {
    one_instance *a; two_instance *b; one_error *ea = NULL; two_error *eb = NULL;
    int64_t r; one_bytes oa; two_bytes ob;
    check(\"one\", one_create(&a, &ea), &ea);
    if (two_create(&b, &eb) != two_STATUS_OK) return 1;
    for (int i = 0; i < 300; i++) {
        if (one_twice(a, i, &r, &ea) != 0 || r != 2 * i) { printf(\"one wrong at %d: %lld\\n\", i, (long long) r); return 1; }
        if (two_twice(b, i, &r, &eb) != 0 || r != 3 * i) { printf(\"two wrong at %d: %lld\\n\", i, (long long) r); return 1; }
        if (one_tag(a, (const uint8_t *) \"x\", 1, &oa, &ea) != 0 || two_tag(b, (const uint8_t *) \"y\", 1, &ob, &eb) != 0) return 1;
        if (oa.len != 7 || memcmp(oa.ptr, \"first:x\", 7) || ob.len != 8 || memcmp(ob.ptr, \"y:second\", 8)) { printf(\"tags wrong\\n\"); return 1; }
        one_bytes_release(&oa); two_bytes_release(&ob);
    }
    printf(\"300 alternating rounds right\\n\");
    report(\"one twice(-1)\", one_twice(a, -1, &r, &ea), &ea);
    report2(\"two twice(-1)\", two_twice(b, -1, &r, &eb), &eb);
    printf(\"releasing one's buffer through two: %d\\n\", (one_tag(a, (const uint8_t *) \"z\", 1, &oa, &ea), two_bytes_release((two_bytes *) &oa)));
    one_bytes_release(&oa);
    report(\"one's instance given to two\", (int32_t) two_twice((two_instance *) a, 1, &r, NULL), NULL);
    printf(\"destroying one's instance through two: %d\\n\", two_destroy((two_instance *) a));
    one_destroy(a); two_destroy(b);
    return 0;
}
" [list [nlLink $first] [nlLink $second]]]
    nlRunBoth $exe
} -result {300 alternating rounds right
one twice(-1): status 1 Negative value=-1
two twice(-1): status 1 Negative fields 2
releasing one's buffer through two: 4
one's instance given to two: status 4
destroying one's instance through two: 4}

test nl-two-instances {two instances of one library alternate allocating calls; destroying one leaves the other, and its own results, intact} -constraints nativeLibraries -body {
    set dir [nlDir]
    set built [nlLibrary $dir two $::nlSecond]
    set exe [nlExecutable $dir "[nlPrelude two]
int main(void) {
    two_instance *a, *b; two_error *e = NULL; int64_t r; two_bytes ta, tb;
    check(\"create a\", two_create(&a, &e), &e);
    check(\"create b\", two_create(&b, &e), &e);
    check(\"tag a\", two_tag(a, (const uint8_t *) \"a\", 1, &ta, &e), &e);
    for (int i = 0; i < 300; i++) {
        two_instance *x = i % 2 ? a : b;
        if (two_twice(x, i, &r, &e) != 0 || r != 3 * i) { printf(\"wrong at %d\\n\", i); return 1; }
        if (i == 150) {
            check(\"destroy a\", two_destroy(a), NULL);
            check(\"recreate a\", two_create(&a, &e), &e);
        }
    }
    check(\"tag b\", two_tag(b, (const uint8_t *) \"b\", 1, &tb, &e), &e);
    check(\"destroy b\", two_destroy(b), NULL);
    report(\"twice(-2) on the new a\", two_twice(a, -2, &r, &e), &e);
    printf(\"%.*s %.*s\\n\", (int) ta.len, (const char *) ta.ptr, (int) tb.len, (const char *) tb.ptr);
    two_bytes_release(&ta); two_bytes_release(&tb);
    check(\"destroy a\", two_destroy(a), NULL);
    return 0;
}
" [list [nlLink $built]]]
    nlRunBoth $exe
} -result {twice(-2) on the new a: status 1 Negative value=-2 why="second"
a:second b:second}

test nl-two-libraries-shared {the same two libraries as shared libraries} -constraints elfLibraries -body {
    set dir [nlDir]
    set first [nlLibrary $dir one $::nlFirst]
    set second [nlLibrary $dir two $::nlSecond]
    set lib [file join $dir lib]
    set exe [nlExecutable $dir "#include <stdio.h>
#include \"one.h\"
#include \"two.h\"
int main(void) {
    one_instance *a; two_instance *b; int64_t r1, r2;
    if (one_create(&a, NULL) || two_create(&b, NULL)) return 1;
    one_twice(a, 21, &r1, NULL); two_twice(b, 21, &r2, NULL);
    printf(\"%lld %lld\\n\", (long long) r1, (long long) r2);
    one_destroy(a); two_destroy(b);
    return 0;
}
" {} -L$lib -lone -ltwo -Wl,-rpath,$lib]
