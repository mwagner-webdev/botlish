# A call is scoped to its program: library A's export calls C, which calls
# library B, and A, continuing, shows an enum value. The display reads the
# program running on the thread, which B's call -- its own runtime copy,
# with its own thread-local -- leaves alone.
test nl-nested-libraries {a library called from inside another library's call leaves the outer call its own program} -constraints nativeLibraries -body {
    set dir [nlDir]
    set outer [nlLibrary $dir outer {
import std::ffi::c

enum Color:
    Red,
    Green

error Painted:
    color: Color

extern c fn host_callback(n: std::ffi::c::LongLong) -> std::ffi::c::LongLong

exported c fn paint(n: int) -> int errors Painted:
    if n < -1000 or n > 1000:
        return 0
    if host_callback(n) > 0:
        fail Painted {color: Color::Green}
    n
} {} -shared 0]
    set inner [nlLibrary $dir inner {
enum Shape:
    Circle,
    Square,
    Triangle

exported c fn grow(n: int) -> int:
    if Shape::Triangle == Shape::Triangle:
        return n * 10
    n
}]
    set exe [nlExecutable $dir "[nlPrelude outer]
#include \"inner.h\"
static inner_instance *helper;
long long host_callback(long long n) {
    int64_t r; inner_error *e = NULL;
    if (inner_grow(helper, n, &r, &e) != inner_STATUS_OK) return -1;
    return r;
}
int main(void) {
    outer_instance *in; outer_error *e = NULL; inner_error *ie = NULL; int64_t r;
    const uint8_t *p; size_t l;
    check(\"create\", outer_create(&in, &e), &e);
    if (inner_create(&helper, &ie) != inner_STATUS_OK) return 1;
    int32_t s = outer_paint(in, 7, &r, &e);
    printf(\"paint(7): status %d\", (int) s);
    if (e) { outer_error_message(e, &p, &l); printf(\" %.*s\", (int) l, (const char *) p); outer_error_release(&e); }
    printf(\"\\n\");
    inner_destroy(helper); outer_destroy(in);
    return 0;
}
" [list [dict get $outer static] [dict get $inner static]]]
    nlRunBoth $exe
} -result {paint(7): status 1 uncaught propagated error: <error Painted {color: Color::Green}>}

test nl-symbols {a library's only global symbols are its public C functions; its runtime and program are local} -constraints {nativeLibraries nm} -body {
    set dir [nlDir]
    set built [nlLibrary $dir chk $::nlChecked]
    set defined [lsort [lmap line [split [exec nm -g --defined-only [dict get $built static]] \n] {
        if {[llength $line] != 3} continue
        lindex $line 2
    }]]
    set expected [lsort [native::library::PublicNames chk [dict get $built exports]]]
    set dynamic [lsort [lmap line [split [exec nm -D --defined-only [dict get $built shared]] \n] {
        if {[llength $line] != 3 || ![string match chk_* [lindex $line 2]]} continue
        lindex $line 2
    }]]
    set local [exec nm [dict get $built static]]
    list [expr {$defined eq $expected}] [expr {$dynamic eq $expected}] \
        [regexp -line {^\S+ t botlish_fn_0$} $local] [regexp -line {^\S+ t rt_fail_declared$} $local] \
        [regexp -line {^\S+ T (botlish_|rt_)} $local]
} -result {1 1 1 1 0}

# ---------------------------------------------------------------------------
# The front end

test nl-front-end-diagnostics {an exported c fn's signature, placement, name and environment are checked in every compilation} -body {
    set dir [nlDir]
    set path [file join $dir bad.bot]
    nlWrite $path {
fn helper(n: int) -> int:
    n

exported c fn bad?(n: int, xs: List[int], q) -> List[int]:
    xs

exported c fn noresult(n: int):
    n

exported c fn flagged(n: int, flags :quick) -> int:
    n

limit = 3

exported c fn captures(n: int) -> int:
    n + limit + helper(n)

fn outer() -> int:
    exported c fn inner(n: int) -> int:
        n
    inner(2)

exported c fn yields() -> int:
    yield 1
    2

context struct Config:
    verbose: bool

fn verbose?(context config: Config) -> bool:
    config.verbose

exported c fn configured(n: int) -> bool:
    verbose?()

0
}
    set hir [surface::readProgramFile $path -warnings off -warning-channel "" -strict 0]
    lmap d [hir::diagnostics $hir] {
        if {![string match EXPORT-* [dict get $d kind]]} continue
        list [dict get $d kind] [dict get $d message]
    }
} -result {{EXPORT-NAME {exported c fn "bad?": its name is the suffix of its C symbol (LIBRARY_bad?), so it must be a C identifier -- ASCII letters, digits and _, not starting with a digit}} {EXPORT-SIGNATURE {exported c fn "bad?": parameter "xs" is declared List[int]; a C export's parameters are int (int64_t), bool, Float64 (double) or str (text: a pointer and a length)}} {EXPORT-SIGNATURE {exported c fn "bad?": parameter "q" has no declared type; a C export declares every parameter's type (int, bool, Float64 or str), since its C ABI is read from the declaration alone}} {EXPORT-SIGNATURE {exported c fn "bad?": the result is declared List[int]; a C export's result is int (int64_t), bool, Float64 (double), str (an owned buffer of text) or unit}} {EXPORT-SIGNATURE {exported c fn "noresult" declares no result type; a C export declares its result (int, bool, Float64, str, or -> unit for none), since its C ABI is read from the declaration alone}} {EXPORT-SIGNATURE {exported c fn "flagged" declares flags; a C export's parameters are ordinary ones only}} {EXPORT-ENVIRONMENT {exported c fn "captures" captures limit; a C export is environment-free (a top-level value it reads belongs in a module, where it is a module static)}} {EXPORT-PLACEMENT {"inner" is not a top-level function of a program or module: a C export is a top-level declaration}} {EXPORT-ENVIRONMENT {exported c fn "yields" may suspend (it yields, or calls a function that does); a C export runs to completion}} {EXPORT-ENVIRONMENT {exported c fn "configured" requires the context Config; a C caller installs no context}}}

