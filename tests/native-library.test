}
" [list [dict get $built static]]]
    list [nlRun $exe] [lmap d [dict get $options -diagnostics] {dict get $d shown}]
} -result {42 {EXPORT-SIGNATURE EXPORT-PLACEMENT}}

test nl-manifest {the manifest states the interface as data, from the compiler's facts} -constraints nativeLibraries -body {
    set dir [nlDir]
    set built [nlLibrary $dir ty $::nlTypes]
    set manifest [lsp::json::parse [core::ReadFile [dict get $built manifest]]]
    set odd [lindex [lmap e [lsp::json::elements [lsp::json::get $manifest exports]] {
        if {[lsp::json::text [lsp::json::get $e name]] ne "odd"} continue
        set e
    }] 0]
    set error [lindex [lsp::json::elements [lsp::json::get $odd errors]] 0]
    list [lsp::json::integer [lsp::json::get $manifest schema]] [lsp::json::text [lsp::json::get $manifest library]] \
        [lsp::json::text [lsp::json::get [lsp::json::get $manifest artifacts] static]] \
        [lsp::json::text [lsp::json::get $odd symbol]] [lsp::json::text [lsp::json::get $odd botlish]] \
        [lmap f [lsp::json::elements [lsp::json::get $error fields]] {
            list [lsp::json::text [lsp::json::get $f name]] [lsp::json::text [lsp::json::get $f type]]
        }] \
        [lmap e [lsp::json::elements [lsp::json::get $manifest exports]] {lsp::json::text [lsp::json::get $e name]}] \
        [expr {[core::ReadFile [dict get $built manifest]] eq [core::ReadFile [dict get [nlLibrary $dir ty $::nlTypes] manifest]]}]
} -result {1 ty libty.a ty_odd {odd(n: int) -> int errors Odd {count: int, flag: bool, items: other, note: str, ratio: Float64}} {{count int} {flag bool} {items other} {note str} {ratio float64}} {negate half echo length joined nothing odd huge range_error} 1}

test nl-main-cli {main.tcl -emit-native-library builds a library from one input} -constraints nativeLibraries -body {
    set dir [nlDir]
    nlWrite [file join $dir cli.bot] $::nlChecked
    set out [exec [info nameofexecutable] [file join $::projectRoot main.tcl] -warnings off \
        -emit-native-library cli -out [file join $dir lib] [file join $dir cli.bot]]
    lmap line [split $out \n] {lindex [split $line :] 0}
} -result {static shared header manifest}

cleanupTests
