    set exe [nlExecutable $dir "[nlPrelude listed]
int main(void) {
    listed_instance *in; listed_error *e = NULL; int64_t r;
    check(\"create\", listed_create(&in, &e), &e);
    check(\"plus\", listed_plus(in, 40, 2, &r, &e), &e);
    printf(\"%lld\\n\", (long long) r);
