# context-traits.test -- context traits: trait-aware contexts with static
# exactly-one implementation selection (CONTEXT-TRAITS.md):
#
#   context trait Out:
#       fn emit(n: int) -> int errors WriteFailed
#
#   fn twice(n: int, context out: Out) -> int errors WriteFailed:
#       out.emit(n) + out.emit(n)
#
#   context struct A: ...
#   fn emit(n: int, context c: A) -> int errors WriteFailed: ...   (A's owner)
#
#   with context a::create()
#   twice(3)                  # A is the one installed context implementing Out
#
# A context trait is an environment abstraction: operations an installed
# context supplies, used only through a context parameter. A concrete context
# struct satisfies it structurally, from its owner namespace alone; a
# top-level call that needs it selects, statically, the one installed context
# that implements it (none: MISSING-CONTEXT; several:
# AMBIGUOUS-CONTEXT-IMPLEMENTATION); every function whose requirement
# includes the trait is cloned for the selection and every operation becomes
# a direct call of the selected context's implementation. Nothing exists at
# run time: no slot, no provider table, no dispatch, no hidden argument.
#
# Every behavioral case runs on interp, compile, cranelift-generic and
# cranelift through one HIR (moduleAgree / sourceAgree).

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]

interp recursionlimit {} 100000

# Linux on x86-64 or AArch64: the native backend's whole runtime (native
# stack maps, the stack guard, coroutines), and syscalls through the portable
# wrappers (std::linux::write, std::linux::read, std::linux::io: each architecture's own
# transport, LINUX-SYSCALL-TRANSPORTS.md).
testConstraint nativeLinux [expr {$::tcl_platform(os) eq "Linux" &&
    $::tcl_platform(machine) in {x86_64 amd64 aarch64}}]
testConstraint objdump [expr {[auto_execok objdump] ne ""}]
testConstraint posixShell [expr {[auto_execok sh] ne ""}]
testConstraint strace [expr {[auto_execok strace] ne "" && ![catch {exec strace -f -qq -o /dev/null true 2>@1}]}]

# ---------------------------------------------------------------------------
# Helpers

# The kind and location-free message of the first compile rejection of
# SOURCE, or "accepted".
proc rejection {source} {
    if {[catch {surface::compile $source -warnings off} message options]} {
        set code [dict get $options -errorcode]
        set kind [expr {[lindex $code 1] eq "SYNTAX" ? "SYNTAX" : [lindex $code end]}]
        if {[lindex $code 1] eq "SYNTAX" && [dict exists [lindex $code 2] code]} {
            set kind [dict get [lindex $code 2] code]
        }
        return [list $kind [regsub {^[^ ]*:[0-9]+:[0-9]+: } $message {}]]
    }
    return accepted
}

proc rejectionKind {source} {
    return [lindex [rejection $source] 0]
}

# Writes the module files FILES ({PATH TEXT ...}, PATH relative to the
# library) into the current (private) library.
proc writeModules {files} {
    foreach {path text} $files {
        set full [file join $::core::libraryDir $path]
        file mkdir [file dirname $full]
        set f [open $full w]
        fconfigure $f -encoding utf-8
        puts -nonewline $f $text
        close $f
    }
}

# sourceAgree of SOURCE with the module files FILES in a private library.
proc moduleAgree {files source {backends {interp compile cranelift-generic cranelift}}} {
    withPrivateLibrary {
        writeModules $files
        set result [sourceAgree $source $backends]
    }
    return $result
}

proc moduleRejection {files source} {
    withPrivateLibrary {
        writeModules $files
        set result [rejection $source]
    }
    return $result
}

proc moduleHir {files source} {
    withPrivateLibrary {
        writeModules $files
        set hir [surface::compile $source -warnings off]
    }
    return $hir
}

# The body lines of NIR function NAME in NIR text, expression origins
# normalized away.
proc nirBody {nir name} {
    set lines {}
    set inside 0
    foreach line [split $nir \n] {
        if {[string match "func *" $line]} {
            set inside [string match "func * \"$name\" *" $line]
            continue
        }
        if {$line eq "end"} {
            set inside 0
            continue
        }
        if {$inside} {
            lappend lines [string trim [regsub -all {@e[0-9]+} $line ""]]
        }
    }
    return $lines
}

# The NIR header line of function NAME (origin removed), or "".
proc nirHeader {nir name} {
    foreach line [split $nir \n] {
        if {[string match "func * \"$name\" *" $line]} {
            return [regsub { @e[0-9]+$} $line ""]
        }
    }
    return ""
}

# The NIR function id of the function named NAME in NIR.
proc nirId {nir name} {
    foreach line [split $nir \n] {
        if {[string match "func * \"$name\" *" $line]} {
            return [lindex $line 1]
        }
    }
    return ""
}

# The function binding names of HIR (clones included), sorted.
proc functionNames {hir} {
    set names {}
    foreach e [hirFind $hir bind] {
        if {[hir::kind $hir [hir::get $hir $e value]] eq "block"} {
            lappend names [dict get $hir bindings [hir::get $hir $e binding] name]
        }
    }
    return [lsort $names]
}

# The block ExprId of the function bound to NAME (its binding name as HIR
# keeps it: a module function qualified, a clone by its clone name).
proc blockOf {hir name} {
    foreach e [hirFind $hir bind] {
        if {[dict get $hir bindings [hir::get $hir $e binding] name] eq $name
                && [hir::kind $hir [hir::get $hir $e value]] eq "block"} {
            return [hir::get $hir $e value]
        }
    }
    return ""
}

# 1 if HIR (a compiled program) contains no context-trait operation, no
# context-trait binding and no context-trait type; else what it found.
proc contextTraitFree {hir} {
    dict for {e node} [dict get $hir exprs] {
        if {[dict exists $node traitCall]} {
            return [list traitCall $e]
        }
        if {[hir::contexts::isLoad $hir $e] && [hir::contexts::isTrait [hir::contexts::loadId $hir $e]]} {
            return [list load $e]
        }
        if {[dict exists $node contextParams]} {
            foreach record [dict get $node contextParams] {
                if {[dict exists $record trait]} {
                    return [list contextParam $e]
                }
            }
        }
    }
    dict for {t type} [dict get $hir types] {
        if {[hir::types::MentionedContextTrait $type] ne ""} {
            return [list type $type]
        }
    }
    return 1
}

# The synthetic context library: a context trait Out (std::ct::out) with a
# consumer twice; two concrete contexts A and B (std::ct::a, std::ct::b) in
# their own owners, each implementing Out differently (A adds its k, B
# multiplies by its k); a caller module std::ct::app with no context
# parameter; a Clock context and a context Timed whose implementation of Out
# needs the Clock.
set ctLib {
ct/out.bot {error WriteFailed

context trait Out:
    fn emit(n: int) -> int errors WriteFailed

fn twice(n: int, context out: Out) -> int errors WriteFailed:
    out.emit(n) + out.emit(n)
}
ct/a.bot {import std::ct::out
type Small = Int in 0..1000

context struct A:
    k: Small

fn create() -> A:
    A {k: 1}

fn emit(n: int, context c: A) -> int errors std::ct::out::WriteFailed:
    n + c.k
}
ct/b.bot {import std::ct::out
type Small = Int in 0..1000

context struct B:
    k: Small

fn create() -> B:
    B {k: 100}

fn emit(n: int, context c: B) -> int errors std::ct::out::WriteFailed:
    n * c.k
}
ct/app.bot {import std::ct::out

fn run(n: int) -> int errors std::ct::out::WriteFailed:
    std::ct::out::twice(n) + 1
}
ct/clock.bot {type Tick = Int in 0..1000

context struct Clock:
    now: Tick

fn create() -> Clock:
    Clock {now: 7}

fn now(context c: Clock) -> int:
    c.now
}
ct/timed.bot {import std::ct::out
import std::ct::clock
type Small = Int in 0..1000

context struct Timed:
    k: Small

fn create() -> Timed:
    Timed {k: 2}

fn emit(n: int, context c: Timed) -> int errors std::ct::out::WriteFailed:
    n * c.k + std::ct::clock::now()
}
}

# A one-file program over the same shape: the entry program owns the trait,
# the context A and A's implementation.
set entryPrelude {error WriteFailed
type Small = Int in 0..1000

context trait Out:
    fn emit(n: int) -> int errors WriteFailed

context struct A:
    k: Small

fn emit(n: int, context c: A) -> int errors WriteFailed:
    n + c.k

fn twice(n: int, context out: Out) -> int errors WriteFailed:
    out.emit(n) + out.emit(n)

}

# The program calling std::ct::app::run(5) after the installations INSTALLS
# (lines), every ct module imported.
proc selectionProgram {installs} {
    set text "import std::ct::out\nimport std::ct::app\nimport std::ct::a\nimport std::ct::b\nimport std::ct::clock\nimport std::ct::timed\n\n"
    foreach line $installs {
        append text "with context $line\n"
    }
    append text "r = std::ct::app::run(5):\n    on std::ct::out::WriteFailed:\n        0\nr\n"
    return $text
}

# ---------------------------------------------------------------------------
# Syntax

test ct-syntax {`context trait NAME:` is a traitdecl with context 1 (the struct modifier, on a trait); its requirements are ordinary signatures with no receiver; the AST prints it back} -body {
    set ast [surface::parse "error E\ncontext trait Out:\n    fn emit(n: int) -> int errors E\n    fn flush()\n"]
    set decl [lindex [dict get $ast body] 1]
    list [dict get $decl kind] [dict get $decl name] [dict get $decl context] \
        [lmap r [dict get $decl requirements] {list [dict get $r name] [lmap p [dict get $r params] {lindex $p 0}]}] \
        [lrange [split [surface::formatAst $ast] \n] 1 3]
} -result {traitdecl Out 1 {{emit n} {flush {}}} {{context trait Out} {    fn emit (n:int) -> int errors E} {    fn flush ()}}}

test ct-contextual {`context` and `trait` stay ordinary names everywhere but before `trait NAME` / a name: variables, parameters, fields, calls} -body {
    sourceAgree {context = 3
trait = 4
fn f(context, trait):
    context * trait
struct S:
    context: int
s = S {context: 5}
[context + trait, f(context, trait), s.context]
}
} -result {value {[7, 12, 5]}}

test ct-modifiers {`context` is the one trait modifier: opaque, a repeated modifier, and opaque context are syntax errors; a context trait nested in a function is TRAIT-NESTED} -body {
    list [rejection "opaque trait T:\n    fn f(v: T) -> int\n"] \
        [rejection "context context trait T:\n    fn f() -> int\n"] \
        [rejectionKind "opaque context trait T:\n    fn f() -> int\n"] \
        [rejectionKind "fn g():\n    context trait T:\n        fn f() -> int\n    1\ng()\n"]
} -result {{SYNTAX {"opaque" does not modify a trait declaration (the only trait modifier is "context": "context trait NAME:")}} {SYNTAX {duplicate modifier "context" in this trait declaration}} SYNTAX TRAIT-NESTED}

test ct-declaration-diagnostics {context-trait declarations: empty, body on a requirement, flags, a context parameter, an ordinary trait parameter or result, a context trait parameter, duplicate requirement, name collision, undeclared error} -body {
    list [rejectionKind "context trait T:\n1\n"] \
        [rejectionKind "context trait T:\n    fn f() -> int:\n        1\n"] \
        [rejectionKind "context trait T:\n    fn f(flags :x) -> int\n"] \
        [rejectionKind "struct C:\n    x: int\ncontext trait T:\n    fn f(context c: C) -> int\n"] \
        [rejection "trait P:\n    fn p(v: P) -> int\ncontext trait T:\n    fn f(v: P) -> int\n"] \
        [rejection "trait P:\n    fn p(v: P) -> int\ncontext trait T:\n    fn f() -> P\n"] \
        [rejectionKind "context trait T:\n    fn f(t: T) -> int\n"] \
        [rejectionKind "context trait T:\n    fn f() -> int\n    fn f(n: int) -> int\n"] \
        [rejectionKind "struct T:\n    x: int\ncontext trait T:\n    fn f() -> int\n"] \
        [rejectionKind "context trait T:\n    fn f() -> int errors Nope\n"]
} -result {TRAIT-EMPTY TRAIT-REQUIREMENT-BODY TRAIT-REQUIREMENT-FLAGS TRAIT-CONTEXT-REQUIREMENT {TRAIT-OTHER-TRAIT {requirement "f" of context trait "T" mentions a trait (P) in parameter "v": a context-trait requirement takes ordinary values only (an operation chosen jointly by the context's witness and a value's trait witness is not supported yet)}} {TRAIT-OTHER-TRAIT {requirement "f" of context trait "T" returns a trait (P): a context-trait requirement returns an ordinary concrete value (trait-typed results of context operations are not supported yet)}} TRAIT-OTHER-TRAIT TRAIT-DUPLICATE-REQUIREMENT TRAIT-NAME-COLLISION UNDECLARED-ERROR}

test ct-requirements-no-receiver {a requirement has no receiver: no parameter at all, untyped parameters and ordinary types are fine; the registry marks the trait context and every parameter self 0} -body {
    set hir [surface::compile "context trait T:\n    fn tick() -> int\n    fn put(a, b: str)\n1\n" -warnings off]
    set entry [lindex [dict get $hir traits] 0]
    list [dict get $entry context] [lmap r [dict get $entry requirements] {
        list [dict get $r name] [lmap p [dict get $r params] {list [dict get $p name] [dict get $p type] [dict get $p self]}] [dict get $r result]
    }]
} -result {1 {{tick {} {type int self 0}} {put {{a any 0} {b str 0}} {}}}}

# ---------------------------------------------------------------------------
# Structural satisfaction (hir::contexts::satisfiesTrait / explainTrait)

test ct-satisfies-structural {a concrete context satisfies a context trait from its owner's declarations: the result names the trait, the witness, the owner and the static requirement -> implementation mapping; an ordinary value never satisfies a context trait} -body {
    set hir [moduleHir $::ctLib "import std::ct::a\nimport std::ct::b\nimport std::ct::timed\n1\n"]
    set a [hir::contexts::satisfiesTrait std::ct::a::A std::ct::out::Out]
    set t [hir::contexts::satisfiesTrait {nstruct std::ct::timed::Timed} std::ct::out::Out]
    list [dict get $a ok] [dict get $a trait] [dict get $a witness] [dict get $a owner] \
        [lmap {r impl} [dict get $a impls] {list $r [dict get $impl unit] [dict get $impl name]}] \
        [dict get $t ok] [dict get [hir::traits::satisfies {nstruct std::ct::a::A} std::ct::out::Out] ok] \
        [hir::contexts::explainTrait std::ct::a::A std::ct::out::Out]
} -result {1 std::ct::out::Out std::ct::a::A std::ct::a {{emit std::ct::a emit}} 1 0 {}}

# The library of a trait whose candidate implementations are wrong one way
# each (module cx owns the contexts and the functions).
set brokenLib {
cx/out.bot {error WriteFailed
error Other

context trait Out:
    fn emit(n: int) -> int errors WriteFailed
}
cx/param.bot {import std::cx::out
context struct C:
    k: bool
fn emit(n: str, context c: C) -> int errors std::cx::out::WriteFailed:
    1
}
cx/result.bot {import std::cx::out
context struct C:
    k: bool
fn emit(n: int, context c: C) -> str:
    "x"
}
cx/errs.bot {import std::cx::out
context struct C:
    k: bool
fn emit(n: int, context c: C) -> int errors std::cx::out::WriteFailed, std::cx::out::Other:
    1
}
cx/ctx.bot {import std::cx::out
context struct C:
    k: bool
context struct D:
    k: bool
fn emit(n: int, context d: D) -> int:
    1
}
cx/none.bot {import std::cx::out
context struct C:
    k: bool
fn emit(n: int) -> int:
    1
}
cx/two.bot {import std::cx::out
context struct C:
    k: bool
context struct D:
    k: bool
fn emit(n: int, context c: C, d: D) -> int:
    1
}
cx/missing.bot {import std::cx::out
context struct C:
    k: bool
}
cx/arity.bot {import std::cx::out
context struct C:
    k: bool
fn emit(n: int, m: int, context c: C) -> int:
    1
}
cx/undeclared.bot {import std::cx::out
context struct C:
    k: bool
fn emit(n: int, context c: C):
    1
}
cx/value.bot {import std::cx::out
context struct C:
    k: bool
emit = 3
}
cx/flags.bot {import std::cx::out
context struct C:
    k: bool
fn emit(n: int, flags :loud, context c: C) -> int:
    1
}
cx/fewer.bot {import std::cx::out
context struct C:
    k: bool
fn emit(n, context c: C) -> int:
    1
}
}

test ct-explain-mismatches {why a context does not satisfy a context trait: a wrong parameter, a wrong result, an error the requirement does not admit, another context type, no context parameter, two context parameters, no implementation, a wrong arity, no declared result, a value binding, flags; fewer errors and a wider (untyped) parameter are fine} -body {
    set hir [moduleHir $::brokenLib "import std::cx::param\nimport std::cx::result\nimport std::cx::errs\nimport std::cx::ctx\nimport std::cx::none\nimport std::cx::two\nimport std::cx::missing\nimport std::cx::arity\nimport std::cx::undeclared\nimport std::cx::value\nimport std::cx::flags\nimport std::cx::fewer\n1\n"]
    lmap m {param result errs ctx none two missing arity undeclared value flags fewer} {
        set s [hir::contexts::satisfiesTrait std::cx::${m}::C std::cx::out::Out]
        list $m [dict get $s ok] [dict get $s reason]
    }
} -result {{param 0 {parameter 1 requires str, which does not admit the required int}} {result 0 {return type str does not satisfy required int}} {errs 0 {it may fail with std::cx::out::Other, which the requirement's error contract [std::cx::out::WriteFailed] does not admit}} {ctx 0 {the context parameter of std::cx::ctx::emit is std::cx::ctx::D, not std::cx::ctx::C: an implementation receives exactly the concrete context it implements}} {none 0 {std::cx::none::emit declares no context parameter: an implementation of a context-trait operation receives the context it implements as its one context parameter ("context NAME: C")}} {two 0 {std::cx::two::emit declares 2 context parameters (std::cx::two::C, std::cx::two::D): an implementation takes exactly one, the context std::cx::two::C it implements}} {missing 0 {no function std::cx::missing::emit exists: "emit" is not defined by module "std::cx::missing" (only the namespace that owns std::cx::missing::C implements its context-trait operations)}} {arity 0 {it takes 2 parameter(s), the requirement 1}} {undeclared 0 {std::cx::undeclared::emit declares no result type: satisfaction is decided from declarations, so an implementation of a requirement with a result must declare it ("-> int")}} {value 0 {std::cx::value::emit is not a function declaration (a value binding cannot implement a requirement)}} {flags 0 {std::cx::flags::emit declares flags (:loud): implementations with flags are not supported yet}} {fewer 1 {}}}

test ct-explain-text {explainTrait: the required and found signatures (the context section included) and the reason} -body {
    set hir [moduleHir $::brokenLib "import std::cx::param\n1\n"]
    regsub -all {\(declared at [^)]*\)|\(at [^)]*\)} [hir::contexts::explainTrait std::cx::param::C std::cx::out::Out $hir] {(at ...)}
} -result {std::cx::param::C does not satisfy std::cx::out::Out
required:
    fn emit(int) -> int errors std::cx::out::WriteFailed   (at ...)
found:
    fn std::cx::param::emit(str, context std::cx::param::C) -> int errors std::cx::out::WriteFailed   (at ...)
parameter 1 requires str, which does not admit the required int}

test ct-owner-only {only the context's owner implements: a function of the operation's name with the right signature in the calling program, or in an imported module, does not make a context satisfy the trait} -body {
    set files [concat $::brokenLib {cx/helper.bot {import std::cx::out
import std::cx::missing
fn emit(n: int, context c: std::cx::missing::C) -> int errors std::cx::out::WriteFailed:
    n
}}]
    list [moduleRejection $files "import std::cx::out\nimport std::cx::missing\nimport std::cx::helper\nimport type std::cx::out::Out\n\nfn emit(n: int, context c: std::cx::missing::C) -> int errors std::cx::out::WriteFailed:\n    n\n\nfn use(context o: Out) -> int errors std::cx::out::WriteFailed:\n    o.emit(1)\n\nwith context std::cx::missing::C {k: true}\nr = use():\n    on std::cx::out::WriteFailed:\n        0\nr\n"]
} -result {{MISSING-CONTEXT {std::cx::out::Out is required by this call, but no installed context implements it (install one with "with context EXPR" before the call):
    use
        directly requires std::cx::out::Out
installed contexts:
    std::cx::missing::C (does not implement std::cx::out::Out: no function std::cx::missing::emit exists: "emit" is not defined by module "std::cx::missing" (only the namespace that owns std::cx::missing::C implements its context-trait operations))}}}

test ct-import-independence {adding imports to the calling program changes neither the satisfaction answer nor the mapping} -body {
    set one [moduleHir $::ctLib "import std::ct::a\n1\n"]
    set first [hir::contexts::satisfiesTrait std::ct::a::A std::ct::out::Out]
    set two [moduleHir $::ctLib "import std::ct::a\nimport std::ct::b\nimport std::ct::timed\nimport std::ct::app\nimport std::ct::clock\n1\n"]
    set second [hir::contexts::satisfiesTrait std::ct::a::A std::ct::out::Out]
    list [expr {$first eq $second}] [dict get $second ok]
} -result {1 1}

test ct-two-importers {two modules that import the same context and context trait get one satisfaction answer and one mapping (cached per compilation, owner-only); neither acquires implementation authority} -body {
    set files [concat $::ctLib {ct/m1.bot {import std::ct::out
import std::ct::a
fn one(n: int) -> int errors std::ct::out::WriteFailed:
    std::ct::out::twice(n)
} ct/m2.bot {import std::ct::out
import std::ct::a
fn two(n: int) -> int errors std::ct::out::WriteFailed:
    std::ct::out::twice(n) * 10
}}]
    set value [moduleAgree $files "import std::ct::out\nimport std::ct::m1\nimport std::ct::m2\nimport std::ct::a\nfn both() -> List\[int\] errors std::ct::out::WriteFailed:\n    \[std::ct::m1::one(1), std::ct::m2::two(1)\]\nwith context std::ct::a::create()\nr = both():\n    on std::ct::out::WriteFailed:\n        \[\]\nr\n"]
    set hir [moduleHir $files "import std::ct::m1\nimport std::ct::m2\nimport std::ct::a\n1\n"]
    set s [hir::contexts::satisfiesTrait std::ct::a::A std::ct::out::Out]
    list $value [lmap {r impl} [dict get $s impls] {list $r [dict get $impl unit] [dict get $impl name]}]
} -result {{value {[4, 40]}} {{emit std::ct::a emit}}}

# ---------------------------------------------------------------------------
# The context-trait binding: one-way abstraction

test ct-one-way {inside `fn f(context out: Out)` the binding is only the trait's operations: returning, passing (to a parameter of the only installed context's type, or untyped), projecting a field of the hidden context, type-testing, comparing, storing it, calling an operation the trait does not declare -- all rejected, whatever is installed} -body {
    set pre "$::entryPrelude"
    lmap body {
        {out}
        {take_a(out)}
        {fn untyped(x):\n        1\n    untyped(out)}
        {out.k}
        {string?(out)}
        {out == out}
        {[out]}
        {out.nope(1)}
        {if out:\n        1\n    else:\n        2}
    } {
        set src "${pre}fn take_a(a: A) -> int:\n    1\n\nfn f(context out: Out):\n    [subst -nocommands -novariables $body]\n\nwith context A {k: 1}\n1\n"
        rejectionKind $src
    }
} -result {CONTEXT-TRAIT-MISUSE CONTEXT-TRAIT-MISUSE CONTEXT-TRAIT-MISUSE CONTEXT-TRAIT-MISUSE CONTEXT-TRAIT-MISUSE CONTEXT-TRAIT-MISUSE CONTEXT-TRAIT-MISUSE TRAIT-UNKNOWN-OPERATION CONTEXT-TRAIT-MISUSE}

test ct-one-way-message {the misuse diagnostic names the binding and the trait; an undeclared operation names the trait's operations} -body {
    list [lindex [rejection "${::entryPrelude}fn f(context out: Out):\n    out\n1\n"] 1] \
        [lindex [rejection "${::entryPrelude}fn f(context out: Out):\n    out.k()\n1\n"] 1]
} -result {{"out" is a context-trait binding (Out): it is not a value -- the only use of a context-trait binding is calling one of Out's operations on it (out.emit(...)); it cannot be passed, stored, returned, compared, projected or tested, and the installed context that provides it is never recovered} {context trait Out has no operation "k" (its operations: emit): a context-trait binding exposes exactly its trait's requirements, whatever installed context provides them}}

test ct-positions {a context trait is not a value type: an ordinary parameter, a result, a struct field, a List or MutableArray element, a function type, a refinement carrier, a value-trait requirement reject it} -body {
    set pre "error WriteFailed\ncontext trait Out:\n    fn emit(n: int) -> int errors WriteFailed\n"
    list [rejectionKind "${pre}fn f(x: Out):\n    1\n1\n"] \
        [rejectionKind "${pre}fn f() -> Out:\n    1\n1\n"] \
        [rejectionKind "${pre}struct S:\n    o: Out\n1\n"] \
        [rejectionKind "${pre}fn f(x: List\[Out\]):\n    1\n1\n"] \
        [rejectionKind "${pre}fn f(x: MutableArray\[Out\]):\n    1\n1\n"] \
        [rejectionKind "${pre}fn f(x: Fn{args: \[Out\], return: int, errors: \[\]}):\n    1\n1\n"] \
        [rejectionKind "${pre}refined type R = Out\n1\n"] \
        [rejectionKind "${pre}trait P:\n    fn p(v: P, o: Out) -> int\n1\n"]
} -result {CONTEXT-TRAIT-POSITION CONTEXT-TRAIT-POSITION CONTEXT-TRAIT-POSITION CONTEXT-TRAIT-POSITION CONTEXT-TRAIT-POSITION CONTEXT-TRAIT-POSITION REFINEMENT-CARRIER TRAIT-OTHER-TRAIT}

test ct-orthogonal {an ordinary trait is not a context: a context parameter of a value trait is NOT-A-CONTEXT, a value-trait view cannot be installed (CONTEXT-TYPE-NOT-EXACT), and a context-trait binding cannot be a value-trait argument} -body {
    set pre "${::entryPrelude}trait P:\n    fn p(v: P) -> int\nstruct Q:\n    v: int\nfn p(v: Q) -> int:\n    v.v\nfn make() -> P:\n    Q {v: 1}\nfn use_p(v: P) -> int:\n    v.p()\n"
    list [rejectionKind "${pre}fn f(context x: P):\n    1\n1\n"] \
        [rejectionKind "${pre}with context make()\n1\n"] \
        [rejectionKind "${pre}fn f(context out: Out):\n    use_p(out)\n1\n"]
} -result {NOT-A-CONTEXT CONTEXT-TYPE-NOT-EXACT CONTEXT-TRAIT-MISUSE}

test ct-duplicate-parameter {one context trait twice in one function is DUPLICATE-CONTEXT-PARAMETER; an exact context and a context trait together are fine} -body {
