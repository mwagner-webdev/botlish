test ct-shapes {recursion, a nested function calling the operation (capturing the binding), method syntax to a consumer, and a function polymorphic in an ordinary trait and a context trait at once} -body {
    set files [concat $::ctLib {ct/named.bot {trait Named:
    fn name(v: Named) -> int

struct P:
    v: int

fn name(v: P) -> int:
    v.v
}}]
    moduleAgree $files {import std::ct::out
import std::ct::a
import std::ct::named
import type std::ct::out::Out

fn countdown(n: int, context out: Out) -> int errors std::ct::out::WriteFailed:
    if n <= 0:
        return 0
    fn step(m: int) -> int errors std::ct::out::WriteFailed:
        out.emit(m)
    step(n) + countdown(n - 1)

fn both(v: std::ct::named::Named, context out: Out) -> int errors std::ct::out::WriteFailed:
    out.emit(v.name())

fn by_method(n: int) -> int errors std::ct::out::WriteFailed:
    n.countdown()

fn all() -> List[int] errors std::ct::out::WriteFailed:
    [countdown(3), both(std::ct::named::P {v: 40}), by_method(2)]

with context std::ct::a::create()
r = all():
    on std::ct::out::WriteFailed:
        []
r
}
} -result {value {[9, 41, 5]}}

