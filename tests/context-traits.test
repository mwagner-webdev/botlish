        [moduleAgree $::ctLib "import std::ct::out\nimport std::ct::a\nimport std::ct::b\nwith context std::ct::a::create()\nr = std::ct::a::emit(1):\n    on std::ct::out::WriteFailed:\n        0\nr\n"]
