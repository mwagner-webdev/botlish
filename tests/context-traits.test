# ---------------------------------------------------------------------------
# Transitive requirements

test ct-transitive {a function with no context parameter that calls a context-trait consumer requires the trait (direct/required, the context fixed point); the chain is the shortest call chain} -body {
    set hir [moduleHir $::ctLib [selectionProgram {std::ct::a::create()}]]
    set source [dict get $hir traitSource]
    set run [hir::traits::ContextTraitsOf $source [lindex [lmap e [hirFind $source bind] {
        expr {[dict get $source bindings [hir::get $source $e binding] name] eq "std::ct::app::run" ? [hir::get $source $e value] : [continue]}}] 0]]
    set twice [lindex [lmap e [hirFind $source bind] {
        expr {[dict get $source bindings [hir::get $source $e binding] name] eq "std::ct::out::twice" ? [hir::get $source $e value] : [continue]}}] 0]
    list $run [hir::contexts::of $source $twice] [hir::contexts::explain $source $twice std::ct::out::Out]
} -result {std::ct::out::Out {direct std::ct::out::Out required std::ct::out::Out} {    std::ct::out::twice
        directly requires std::ct::out::Out}}

