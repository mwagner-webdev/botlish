# ---------------------------------------------------------------------------
# Specialization and lowering: no context trait below HIR

test ct-mono-hir {the compiled program has no context-trait operation, binding or type: every function requiring the trait is replaced by one clone under the selection (an intermediate function in another module included), each operation is a direct call of the selected context's implementation; the checked source keeps the bindings and operations} -body {
    set hir [moduleHir $::ctLib [selectionProgram {std::ct::b::create()}]]
    set source [dict get $hir traitSource]
    set ops 0
    dict for {e node} [dict get $source exprs] {
        if {[dict exists $node traitCall context]} { incr ops }
    }
    set impls {}
    dict for {e node} [dict get $hir exprs] {
        if {[dict exists $node traitImpl]} {
            set impl [dict get $node traitImpl]
            lappend impls [list [dict get $impl trait] [dict get $impl requirement] [dict get $impl witness] [dict get $impl implementation] [lindex [dict get $node target] 0]]
        }
    }
    list [contextTraitFree $hir] $ops [lsearch -all -inline -glob [functionNames $hir] *<*] [lsort -unique $impls] \
        [hir::get $hir [blockOf $hir std::ct::out::twice<std::ct::out::Out=std::ct::b::B>] contextClone]
} -result {1 2 {std::ct::app::run<std::ct::out::Out=std::ct::b::B> std::ct::out::twice<std::ct::out::Out=std::ct::b::B>} {{std::ct::out::Out emit {nstruct std::ct::b::B} std::ct::b::emit block}} {std::ct::out::Out std::ct::b::B}}

test ct-hir-text {HIR text shows the context trait declaration, each clone's selection and each operation's selected implementation; a one-file program reads back to the same text and runs the same on every backend} -body {
    set src "${::entryPrelude}fn run(n: int) -> int errors WriteFailed:\n    twice(n) + 1\nwith context A {k: 1}\nr = run(5):\n    on WriteFailed:\n        0\nr\n"
    set hir [surface::compile $src -warnings off]
    set text [hir::format $hir]
    set lines [split $text \n]
    set again [hir::parse $text]
    list [lsearch -inline -glob $lines {trait Out *}] \
        [lindex [regexp -inline {contextclone \([^)]*\)} [lsearch -inline -glob $lines {*contextclone*}]] 0] \
        [llength [lsearch -all -glob $lines {*contexttrait Out.emit witness A*}]] \
        [expr {[hir::format $again] eq $text}] \
        [lsort -unique [lmap b {interp compile cranelift-generic cranelift} {lrange [outcomeUnderHir $b $again] 0 end-1}]]
} -result {{trait Out context owner - requires emit(n: int) -> int errors WriteFailed} {contextclone (Out=A)} 2 1 {{value 13}}}

# The evidence program: a context trait without errors, a consumer twice
# over it, and the same function written by hand against the concrete
# context (twice_a); sum/sum_a call each 50 times.
set evidence {type Small = Int in 0..1000

context trait Out:
    fn emit(n: int) -> int

context struct A:
    k: Small

fn emit(n: int, context c: A) -> int:
    n + c.k

fn twice(n: int, context out: Out) -> int:
    out.emit(n) + out.emit(n)

fn twice_a(n: int, context c: A) -> int:
    emit(n) + emit(n)

fn sum(i: int, acc: int) -> int:
    if i == 0:
        return acc
    sum(i - 1, acc + twice(i))

fn sum_a(i: int, acc: int) -> int:
    if i == 0:
        return acc
    sum_a(i - 1, acc + twice_a(i))

with context A {k: 1}
}

test ct-nir-direct {NIR: the clone calls the selected implementation directly with its one ordinary operand (params=1, no extra argument, no callvalue); the implementation loads its context from the fixed slot; the clone's body is the hand-written concrete function's} -body {
    set hir [surface::compile "$::evidence\n\[sum(50, 0), sum_a(50, 0)\]\n" -warnings off]
    set nir [native::nir $hir]
    set emit [nirId $nir emit]
    list [nirHeader $nir twice<Out=A>] [nirBody $nir twice<Out=A>] \
        [expr {[nirBody $nir twice<Out=A>] eq [nirBody $nir twice_a]}] \
        [nirBody $nir emit] [regexp -all {callvalue|callindirect} $nir] $emit
} -result {{func 4 "twice<Out=A>" params=1 env=0 regs=5 pnames="n" captures=0 instance="int" rawregs="0 1 2 3" rawparams="0"} {{%1 = call 1 %0} {%2 = call 1 %0} {%3 = op riadd %1 %2} {%4 = op rbox %3} {ret %4}} 1 {{%1 = contextload 0} {%2 = op runbox %1} {%3 = op riadd %0 %2} {ret %3}} 0 1}

test ct-native-context-area {the native context area has a slot for the installed context struct only: a context trait never gets a slot, a tag or a table} -body {
    set nir [native::nir [surface::compile "$::evidence\nsum(50, 0)\n" -warnings off]]
    lsearch -all -inline -regexp [split $nir \n] {^(nir|context) }
} -result {{nir 1 call-effects=1 statics=0 contexts=8} {context 0 "A" offset=0 words=1 fields="k"}}

test ct-allocation-free {context-trait specialization allocates nothing: 100 operations through the trait, like 100 direct calls of the concrete implementation, allocate 0 objects} -constraints {nativeLinux} -body {
    lmap last {{sum(50, 0)} {sum_a(50, 0)}} {
        set report [native::allocationReport [surface::compile "$::evidence\n$last\n" -warnings off] summary]
        list [dict get $report total allocations] [dict get $report total allocatedBytes]
    }
} -result {{0 0} {0 0}}

test ct-machine-code-direct {machine code: the clone calls the implementation with a direct call (no indirect call), and is exactly as long as the hand-written concrete function} -constraints {nativeLinux objdump posixShell symbolLinker} -body {
    set dir [makeDirectory ct-exe-[pid]]
    set exe [file join $dir evidence]
    set hir [surface::compile "$::evidence\n\[sum(50, 0), sum_a(50, 0)\]\n" -warnings off]
    native::executable $hir $exe
    set nir [native::nir $hir]
    set clone botlish_fn_[nirId $nir twice<Out=A>]
    set concrete botlish_fn_[nirId $nir twice_a]
    set emit botlish_fn_[nirId $nir emit]
    set symbols [exec objdump -t $exe]
    set sizes [lmap f [list $clone $concrete] {
        regexp "(\[0-9a-f\]+)\\s+$f\n" "$symbols\n" -> size
        scan $size %x
    }]
    set code [exec objdump -d --no-show-raw-insn $exe]
    set body [lindex [regexp -inline "<$clone>:\n(.*?)\n\n" "$code\n\n"] 1]
    # A direct call and an indirect one in the host's own disassembly: x86-64
    # `call ADDR <f>` and `call *...`, AArch64 `bl ADDR <f>` and `blr REG`.
    if {$::tcl_platform(machine) eq "aarch64"} {
        set direct "bl\\s+\[0-9a-f\]+ <$emit>"
        set indirect {blr\s}
    } else {
        set direct "call +\[0-9a-f\]+ <$emit>"
        set indirect {call +\*}
    }
    set result [list [exec $exe] [lindex $sizes 0] [expr {[lindex $sizes 0] == [lindex $sizes 1]}] \
        [regexp -all $direct $body] [regexp -all $indirect $body]]
    removeDirectory ct-exe-[pid]
    set result
} -result [expr {$::tcl_platform(machine) eq "aarch64"
    ? {{[2650, 2650]} 76 1 2 0} : {{[2650, 2650]} 89 1 2 0}}]

test ct-tooling {-contexts names the context trait, its bindings, the source functions requiring it, each call's selection with its implementation mapping, and the clones; -traits shows which context structs implement it} -body {
    set hir [moduleHir $::ctLib [selectionProgram {std::ct::a::create()}]]
    set summary [split [hir::contexts::summary $hir] \n]
    list [lsearch -all -inline -regexp $summary {^(contexttrait|    emit|contextselect|    emit ->|contextclone)}] \
        [lsearch -all -inline -glob $summary {source-function std::ct::app::run *}] \
        [lsearch -all -inline -glob [split [hir::traits::report $hir] \n] {*context std::ct::* implement*}]
} -match glob -result {{{contexttrait std::ct::out::Out} {    emit(n: int) -> int errors std::ct::out::WriteFailed} {contexttraitparam e* out std::ct::out::Out} {contextselect e* std::ct::out::Out std::ct::a::A} {    emit -> std::ct::a::emit} {contextclone std::ct::out::twice<std::ct::out::Out=std::ct::a::A> std::ct::out::Out=std::ct::a::A} {contextclone std::ct::app::run<std::ct::out::Out=std::ct::a::A> std::ct::out::Out=std::ct::a::A}} {{source-function std::ct::app::run e* direct-contexts () required-contexts (std::ct::out::Out)}} {{    context std::ct::a::A implements std::ct::out::Out (emit -> std::ct::a::emit)} {    context std::ct::b::B implements std::ct::out::Out (emit -> std::ct::b::emit)} {    context std::ct::clock::Clock does not implement std::ct::out::Out: *} {    context std::ct::timed::Timed implements std::ct::out::Out (emit -> std::ct::timed::emit)}}}

test ct-no-traits-unchanged {a program that declares no trait or context trait is built once, with no trait metadata} -body {
    set hir [surface::compile "fn f(n: int) -> int:\n    n + 1\nf(2)\n" -warnings off]
    list [dict exists $hir traitSource] [dict exists $hir traits]
} -result {0 0}

# ===========================================================================
# Operation identity (CONTEXT-TRAIT-YIELD-EDGE-CORRECTNESS-MILESTONE-1.md):
# `d.wait(5)` on a context-trait binding is the trait's operation whatever
# functions named `wait` are visible. A visible function of that name -- here
# a yielding `wait` of the trait's own module -- is never its callee: no
# coroutine edge, no flags, no variadic collection, no nomethod rule. The
# operation's implementation is the selected context's, whose own yields
# still reach every caller.

set ::cyLib {ty/drv.bot {struct Reg:
    slot: int

context trait Driver:
    fn wait(deadline: int) -> int

fn wait(reg: Reg) -> int:
    yield reg.slot
    1

fn run(context d: Driver) -> int:
    d.wait(5)

fn wrapper(context d: Driver) -> int:
    run() + 1

fn poll(reg: Reg) -> int:
    wait(reg) + 10

fn deep(reg: Reg) -> int:
    poll(reg) + 100

fn both(reg: Reg, context d: Driver) -> int:
    d.wait(5) + reg.wait()
}
ty/sim.bot {type Base = Int in 0..10000

opaque context struct Sim:
    base: Base

fn create() -> Sim:
    Sim {base: 100}

fn wait(deadline: int, context s: Sim) -> int:
    deadline + s.base
}
ty/alt.bot {type Base = Int in 0..10000

opaque context struct Alt:
    base: Base

fn create() -> Alt:
    Alt {base: 1000}

fn wait(deadline: int, context s: Alt) -> int:
    deadline + s.base
}
ty/ysim.bot {type Base = Int in 0..10000

opaque context struct YSim:
    base: Base

fn create() -> YSim:
    YSim {base: 100}

fn wait(deadline: int, context s: YSim) -> int:
    yield deadline
    deadline + s.base
}}

# The kinds of every diagnostic of SOURCE's rejection, in order, or
# "accepted".
proc diagnosticKinds {source} {
    if {[catch {surface::compile $source -warnings off} message options]} {
        if {[dict exists $options -diagnostics]} {
            return [lmap d [dict get $options -diagnostics] {lindex [dict get $d errorcode] end}]
        }
        return [list [lindex [dict get $options -errorcode] end]]
    }
    return accepted
}

# The program importing the operation-identity library with INSTALLS
# installed and BODY as its statements.
proc cyProgram {installs body} {
    set text "import std::ty::drv\nimport std::ty::sim\nimport std::ty::alt\nimport std::ty::ysim\n"
    foreach line $installs {
        append text "with context std::ty::${line}::create()\n"
    }
    return "$text$body"
}

test ct-operation-identity-repro {the event-loop exploration's reduced reproduction (audit/event-loop/repro/trait-op-yield-edge: a yielding `wait` beside the context trait whose operation `d.wait(5)` calls) compiles with warnings as errors and evaluates to the trait implementation's value on both Tcl backends (its context struct's unbounded Int field has no fixed native slot: CONTEXT-NATIVE-LOWERING-UNSUPPORTED, so the native backends run the same program with a bounded field: ct-operation-identity-unrelated-yield)} -body {
    set hir [surface::readProgramFile [file join $::projectRoot audit event-loop repro trait-op-yield-edge app.bot] -warnings error]
    lsort -unique [lmap b {interp compile} {lrange [outcomeUnderHir $b $hir] 0 end-1}]
} -result {{value 5}}

test ct-operation-identity-unrelated-yield {a non-yielding context-trait operation does not acquire the yield effect of a same-named yielding function of the trait's module: the operation, a wrapper calling it and its value through either of two implementations} -body {
    list [moduleAgree $::cyLib [cyProgram sim "\[std::ty::drv::run(), std::ty::drv::wrapper()\]\n"]] \
        [moduleAgree $::cyLib [cyProgram alt "\[std::ty::drv::run(), std::ty::drv::wrapper()\]\n"]]
} -result {{value {[105, 106]}} {value {[1005, 1006]}}}

test ct-operation-identity-genuine-yield {a genuinely yielding call keeps its effect: the same-named yielding function called directly, or through a wrapper, is UNWRAPPED-YIELD at the top level and runs as a coroutine; a function making both the operation and a method-syntax call of the yielding function yields through the latter} -body {
    list [lindex [moduleRejection $::cyLib [cyProgram sim "std::ty::drv::poll(std::ty::drv::Reg {slot: 7})\n"]] 0] \
        [lindex [moduleRejection $::cyLib [cyProgram sim "std::ty::drv::deep(std::ty::drv::Reg {slot: 7})\n"]] 0] \
        [lindex [moduleRejection $::cyLib [cyProgram sim "std::ty::drv::both(std::ty::drv::Reg {slot: 3})\n"]] 0] \
        [moduleAgree $::cyLib [cyProgram sim "coroutine {step, first} = std::ty::drv::deep(std::ty::drv::Reg {slot: 7})\n\[first, step()\]\n"]] \
        [moduleAgree $::cyLib [cyProgram sim "coroutine {step, first} = std::ty::drv::both(std::ty::drv::Reg {slot: 3})\n\[first, step()\]\n"]]
} -result {UNWRAPPED-YIELD UNWRAPPED-YIELD UNWRAPPED-YIELD {value {[7, 111]}} {value {[3, 106]}}}

test ct-operation-identity-genuine-chain {the UNWRAPPED-YIELD of a function making both calls explains the yield through the method-syntax call of the yielding function, never through the operation} -body {
    lindex [moduleRejection $::cyLib [cyProgram sim "std::ty::drv::both(std::ty::drv::Reg {slot: 3})\n"]] 1
} -match glob -result {*std::ty::drv::both, which calls std::ty::drv::wait at *drv.bot:24:17
     -> std::ty::drv::wait, which yields directly at *drv.bot:8:5}

test ct-operation-identity-implementation-yield {a selected implementation that yields reaches every caller of the operation: a top-level call of the operation's function is UNWRAPPED-YIELD in the checked program, explained through the operation and its implementation (std::ty::ysim::wait), never through the same-named function of the trait's module and never in terms of the monomorphized program (TRAIT-IMPLEMENTATION-YIELD-INFERENCE-MILESTONE-1.md)} -body {
    set r [moduleRejection $::cyLib [cyProgram ysim "std::ty::drv::run()\n"]]
    list [lindex $r 0] \
        [string match {std::ty::drv::run may suspend, but this call does not start a coroutine*std::ty::drv::run, which calls std::ty::ysim::wait, the implementation of std::ty::drv::Driver's operation wait for the installed context std::ty::ysim::YSim, at *drv.bot:12:5*} [lindex $r 1]] \
        [string match {*std::ty::drv::wait *} [lindex $r 1]] [string match {*monomorphized*} [lindex $r 1]]
} -result {UNWRAPPED-YIELD 1 0 0}

test ct-implementation-yield-coroutine {a coroutine whose only suspension is its operation's selected implementation runs (the milestone's limitation, COROUTINE-RHS-NOT-YIELDING before TRAIT-IMPLEMENTATION-YIELD-INFERENCE-MILESTONE-1.md): started at the operation's function or at a wrapper of it, with and without a same-named yielding function in the trait's module, on every backend} -body {
    list [moduleAgree $::cyLib [cyProgram ysim "coroutine {step, first} = std::ty::drv::run()\n\[first, step()\]\n"]] \
        [moduleAgree $::cyLib [cyProgram ysim "coroutine {step, first} = std::ty::drv::wrapper()\n\[first, step()\]\n"]] \
        [moduleAgree {ty/plain.bot {context trait Driver:
    fn wait(deadline: int) -> int

fn run(context d: Driver) -> int:
    d.wait(5)
}
ty/ysim.bot {type Base = Int in 0..10000

opaque context struct YSim:
    base: Base

fn create() -> YSim:
    YSim {base: 100}

fn wait(deadline: int, context s: YSim) -> int:
    yield deadline
    deadline + s.base
}} "import std::ty::plain\nimport std::ty::ysim\nwith context std::ty::ysim::create()\ncoroutine {step, first} = std::ty::plain::run()\n\[first, step()\]\n"]
} -result {{value {[5, 105]}} {value {[5, 106]}} {value {[5, 105]}}}

test ct-operation-identity-order {declaration order decides nothing: the yielding function declared before or after the trait, before or after the operation's function (where it is not visible to it), the modules imported in either order} -body {
    set reg "struct Reg:\n    slot: int\n\n"
    set trait "context trait Driver:\n    fn wait(deadline: int) -> int\n\n"
    set yielding "fn wait(reg: Reg) -> int:\n    yield reg.slot\n    1\n\n"
    set run "fn run(context d: Driver) -> int:\n    d.wait(5)\n\n"
    set sim [lindex $::cyLib 3]
    set results {}
    foreach order [list [list $reg $trait $yielding $run] [list $reg $yielding $trait $run] [list $trait $run $reg $yielding]] {
        set files [list ty/ord.bot [join $order ""] ty/sim.bot $sim]
        lappend results [moduleAgree $files "import std::ty::ord\nimport std::ty::sim\nwith context std::ty::sim::create()\nstd::ty::ord::run()\n"]
        lappend results [moduleAgree $files "import std::ty::sim\nimport std::ty::ord\nwith context std::ty::sim::create()\nstd::ty::ord::run()\n"]
    }
    lsort -unique $results
} -result {{value 105}}

test ct-operation-identity-modules {a yielding function of the operation's name in another module -- imported by the trait's module (a method candidate), imported beside a local one (two candidates), or the entry program's own -- never becomes the operation's callee} -body {
    set other {ty/other.bot {struct Reg:
    slot: int

fn wait(reg: Reg) -> int:
    yield reg.slot
    1
}}
    set imported [concat $other [list ty/imp.bot {import std::ty::other

context trait Driver:
    fn wait(deadline: int) -> int

fn run(context d: Driver) -> int:
    d.wait(5)
} ty/sim.bot [lindex $::cyLib 3]]]
    set twoCandidates [concat $other [list ty/two.bot {import std::ty::other

struct Local:
    slot: int

context trait Driver:
    fn wait(deadline: int) -> int

fn wait(l: Local) -> int:
    yield l.slot
    2

fn run(context d: Driver) -> int:
    d.wait(5)
} ty/sim.bot [lindex $::cyLib 3]]]
    list [moduleAgree $imported "import std::ty::imp\nimport std::ty::sim\nwith context std::ty::sim::create()\nstd::ty::imp::run()\n"] \
        [moduleAgree $twoCandidates "import std::ty::two\nimport std::ty::sim\nwith context std::ty::sim::create()\nstd::ty::two::run()\n"] \
        [moduleAgree $::cyLib [cyProgram sim "struct R:\n    slot: int\nfn wait(r: R) -> int:\n    yield r.slot\n    3\nstd::ty::drv::run()\n"]]
} -result {{value 105} {value 105} {value 105}}

test ct-operation-identity-call-shape {a visible function of the operation's name gives the operation no call shape of its own: its flags are not appended, its variadic parameter collects nothing, and its nomethod declaration does not reject the operation} -body {
    set results {}
    foreach decl {
        "fn wait(deadline: int, flags :urgent) -> int:\n    deadline + 1"
        "fn wait(variadic xs: List\[int\]) -> int:\n    0"
        "nomethod fn wait(x: int) -> int:\n    x"
    } {
        set files [list ty/shape.bot "context trait Driver:\n    fn wait(deadline: int) -> int\n\n$decl\n\nfn run(context d: Driver) -> int:\n    d.wait(5)\n" ty/sim.bot [lindex $::cyLib 3]]
        lappend results [moduleAgree $files "import std::ty::shape\nimport std::ty::sim\nwith context std::ty::sim::create()\nstd::ty::shape::run()\n"]
    }
    set results
} -result {{value 105} {value 105} {value 105}}

test ct-operation-identity-rejections {invalid calls stay rejected without a substitute callee: an operation the trait does not declare (a yielding function of that name is visible) is TRAIT-UNKNOWN-OPERATION and nothing else, two installed implementations are AMBIGUOUS-CONTEXT-IMPLEMENTATION and none MISSING-CONTEXT, each without a yield diagnostic; passing the binding to the yielding function in an ordinary call is CONTEXT-TRAIT-MISUSE, and that call is a real call of the yielding function (UNWRAPPED-YIELD as well)} -body {
    set unknown [list ty/unk.bot "struct Reg:\n    slot: int\n\ncontext trait Driver:\n    fn wait(deadline: int) -> int\n\nfn nope(reg: Reg) -> int:\n    yield reg.slot\n    1\n\nfn run(context d: Driver) -> int:\n    d.nope(5)\n" ty/sim.bot [lindex $::cyLib 3]]
    set misuse [list ty/mis.bot "struct Reg:\n    slot: int\n\ncontext trait Driver:\n    fn wait(deadline: int) -> int\n\nfn wait(reg) -> int:\n    yield 1\n    1\n\nfn run(context d: Driver) -> int:\n    wait(d)\n" ty/sim.bot [lindex $::cyLib 3]]
    withPrivateLibrary {
        writeModules $unknown
        set a [diagnosticKinds "import std::ty::unk\nimport std::ty::sim\nwith context std::ty::sim::create()\nstd::ty::unk::run()\n"]
    }
    withPrivateLibrary {
        writeModules $misuse
        set b [diagnosticKinds "import std::ty::mis\nimport std::ty::sim\nwith context std::ty::sim::create()\nstd::ty::mis::run()\n"]
    }
    withPrivateLibrary {
        writeModules $::cyLib
        set c [diagnosticKinds [cyProgram {sim alt} "std::ty::drv::run()\n"]]
        set d [diagnosticKinds [cyProgram {} "std::ty::drv::run()\n"]]
    }
    list $a [lindex $b 0] [expr {"UNWRAPPED-YIELD" in $b}] $c $d
} -result {TRAIT-UNKNOWN-OPERATION CONTEXT-TRAIT-MISUSE 1 AMBIGUOUS-CONTEXT-IMPLEMENTATION MISSING-CONTEXT}

test ct-operation-identity-hir {the checked source program: the operation is the call of the projection `d.wait` (no candidate consulted: no `method` record, a field-shaped trait call), it has no callee for any analysis (hir::contexts::Callee), the coroutine analysis has no edge out of its function into a yield-capable one and nothing to set aside, and the same function's method-syntax call of the yielding function is such an edge} -body {
    set hir [dict get [moduleHir $::cyLib [cyProgram sim "coroutine {step, first} = std::ty::drv::both(std::ty::drv::Reg {slot: 3})\n\[std::ty::drv::run(), first, step()\]\n"]] traitSource]
    set ops {}
    dict for {e node} [dict get $hir exprs] {
        if {[dict get $node kind] eq "call" && [dict exists $node traitCall]} {
            lappend ops [list [dict exists $node method] [dict get $node traitCall shape] \
                [hir::contexts::Callee $hir $e] [hir::kind $hir [dict get $node callee]]]
        }
    }
    set edges {}
    dict for {b list} [dict get $hir coroutines edges] {
        foreach edge $list {
            if {![dict exists $hir coroutines blocks [lindex $edge 1]]} continue
            lappend edges [list [hir::contexts::BlockName $hir $b] [hir::contexts::BlockName $hir [lindex $edge 1]]]
        }
    }
    list [lsort -unique $ops] [lsort -unique $edges] [dict get $hir coroutines operations]
} -result {{{0 field {} project}} {{std::ty::drv::both std::ty::drv::wait} {std::ty::drv::deep std::ty::drv::poll} {std::ty::drv::poll std::ty::drv::wait}} {}}

# ===========================================================================
# Implementation yields (TRAIT-IMPLEMENTATION-YIELD-INFERENCE-MILESTONE-1.md):
# the selected installed context's implementation of an operation is what
# the operation calls, so its yields are the call's -- in the checked
# program, before monomorphization -- and nothing else's: not a same-named
# visible function's, not another context's.

# A driver trait whose implementations reach a yield in three ways: through
# another context trait the implementation requires (w: Clock's tick), through
# an ordinary yielding helper (h), and with a resume protocol of its own (m).
set ::ciLib {ty/d.bot {context trait Driver:
    fn wait(deadline: int) -> int

context trait Clock:
    fn tick() -> int

fn run(context d: Driver) -> int:
    d.wait(5)

fn wrapper(context d: Driver) -> int:
    run() * 2

fn both(context d: Driver) -> int:
    yield 1
    d.wait(5) + 1
}
ty/w.bot {import std::ty::d

type Base = Int in 0..10000

opaque context struct W:
    n: Base

fn create() -> W:
    W {n: 1}

fn pause(context c: std::ty::d::Clock) -> int:
    c.tick()

fn wait(deadline: int, context w: W) -> int:
    pause() + deadline
}
ty/c.bot {type Base = Int in 0..10000

opaque context struct C:
    n: Base

fn create() -> C:
    C {n: 7}

fn tick(context c: C) -> int:
    yield 100
    3
}
ty/h.bot {type Base = Int in 0..10000

opaque context struct H:
    n: Base

fn create() -> H:
    H {n: 1}

fn helper(x: int) -> int:
    yield x
    x + 1

fn wait(deadline: int, context w: H) -> int:
    helper(deadline)
}
ty/m.bot {type Base = Int in 0..10000

struct Msg:
    v: int

opaque context struct M:
    n: Base

fn create() -> M:
    M {n: 1}

fn wait(deadline: int, context w: M, resume Msg) -> int:
    m = yield deadline
    m.v + deadline
}
ty/e.bot {import std::ty::d

struct Other:
    k: int

fn other(resume Other) -> int:
    o = yield 1
    o.k

fn mixed(context d: std::ty::d::Driver) -> int:
    d.wait(1) + other()
}}

# The program importing the implementation-yield library with the contexts
# INSTALLS installed (in order) and BODY as its statements.
proc ciProgram {installs body} {
    set text "import std::ty::d\nimport std::ty::w\nimport std::ty::c\nimport std::ty::h\nimport std::ty::m\nimport std::ty::e\n"
    foreach line $installs {
        append text "with context std::ty::${line}::create()\n"
    }
    return "$text$body"
}

test ct-implementation-yield-negative {the yield effect is the selected implementation's and no other's: with the non-yielding Sim selected, a coroutine of the operation's function is COROUTINE-RHS-NOT-YIELDING although a yielding implementation (YSim's) is imported and a yielding function of the operation's name is visible; the same source with YSim installed runs} -body {
    list [moduleRejection $::cyLib [cyProgram sim "coroutine {step, first} = std::ty::drv::wrapper()\nfirst\n"]] \
        [moduleRejection $::cyLib [cyProgram alt "coroutine {step, first} = std::ty::drv::run()\nfirst\n"]] \
        [moduleAgree $::cyLib [cyProgram sim "\[std::ty::drv::run(), std::ty::drv::wrapper()\]\n"]] \
        [moduleAgree $::cyLib [cyProgram ysim "coroutine {step, first} = std::ty::drv::wrapper()\n\[first, step()\]\n"]]
} -result {{COROUTINE-RHS-NOT-YIELDING {std::ty::drv::wrapper never yields (it has no reachable yield and calls no function that may yield), so there is no coroutine to start: call it directly}} {COROUTINE-RHS-NOT-YIELDING {std::ty::drv::run never yields (it has no reachable yield and calls no function that may yield), so there is no coroutine to start: call it directly}} {value {[105, 106]}} {value {[5, 106]}}}

test ct-implementation-yield-transitive {an implementation's yield reaches the coroutine however deep: through the implementation's own context-trait operation (W's wait calls Clock's tick, C's implementation yields), through an ordinary yielding helper of the implementation, through a wrapper of the operation's function, and beside a direct yield of the function itself} -body {
    list [moduleAgree $::ciLib [ciProgram {c w} "coroutine {step, first} = std::ty::d::run()\n\[first, step()\]\n"]] \
        [moduleAgree $::ciLib [ciProgram {c w} "coroutine {step, first} = std::ty::d::wrapper()\n\[first, step()\]\n"]] \
        [moduleAgree $::ciLib [ciProgram h "coroutine {step, first} = std::ty::d::wrapper()\n\[first, step()\]\n"]] \
        [moduleAgree $::ciLib [ciProgram h "coroutine {step, first} = std::ty::d::both()\na = step()\n\[first, a, step()\]\n"]]
} -result {{value {[100, 8]}} {value {[100, 16]}} {value {[5, 12]}} {value {[1, 5, 7]}}}

test ct-implementation-yield-chain {UNWRAPPED-YIELD of a top-level call explains the yield through each operation and the implementation the program selected for it, down to the yield} -body {
    lindex [moduleRejection $::ciLib [ciProgram {c w} "std::ty::d::wrapper()\n"]] 1
} -match glob -result {std::ty::d::wrapper may suspend, but this call does not start a coroutine (start it with "coroutine {step, first} = std::ty::d::wrapper(...)", or call it from a function that runs inside a coroutine):
    std::ty::d::wrapper, which calls std::ty::d::run at *d.bot:11:5
     -> std::ty::d::run, which calls std::ty::w::wait, the implementation of std::ty::d::Driver's operation wait for the installed context std::ty::w::W, at *d.bot:8:5
     -> std::ty::w::wait, which calls std::ty::w::pause at *w.bot:15:5
     -> std::ty::w::pause, which calls std::ty::c::tick, the implementation of std::ty::d::Clock's operation tick for the installed context std::ty::c::C, at *w.bot:12:5
     -> std::ty::c::tick, which yields directly at *c.bot:10:5}

test ct-implementation-yield-protocol {the coroutine's resume protocol is its implementation's: M's wait declares resume Msg, so the coroutine -- of the operation's function or of a wrapper of it -- is resumed with a Msg (none: COROUTINE-RESUME-ARITY; another type: TYPE), and a function calling both the operation and a function declaring another protocol is COROUTINE-RESUME-CONFLICT, explained through the implementation} -body {
    list [moduleAgree $::ciLib [ciProgram m "coroutine {step, first} = std::ty::d::run()\n\[first, step(std::ty::m::Msg {v: 30})\]\n"]] \
        [moduleAgree $::ciLib [ciProgram m "coroutine {step, first} = std::ty::d::wrapper()\n\[first, step(std::ty::m::Msg {v: 30})\]\n"]] \
        [lindex [moduleRejection $::ciLib [ciProgram m "coroutine {step, first} = std::ty::d::run()\n\[first, step()\]\n"]] 0] \
        [lindex [moduleRejection $::ciLib [ciProgram m "coroutine {step, first} = std::ty::d::run()\n\[first, step(std::ty::e::Other {k: 1})\]\n"]] 0] \
        [moduleRejection $::ciLib [ciProgram m "coroutine {step, first} = std::ty::e::mixed()\nfirst\n"]]
} -match glob -result {{value {\[5, 35\]}} {value {\[5, 70\]}} COROUTINE-RESUME-ARITY TYPE {COROUTINE-RESUME-CONFLICT {std::ty::e::mixed needs two different resume protocols, and one coroutine has exactly one (no union is inferred: declare a struct with the fields both need, or split the coroutine):
    resume std::ty::m::Msg: it calls std::ty::m::wait, the implementation of std::ty::d::Driver's operation wait for the installed context std::ty::m::M (*e.bot:11:5), which declares it
    resume std::ty::e::Other: it calls std::ty::e::other (*e.bot:11:17), which declares it}}}

test ct-implementation-yield-selection-errors {without one selected implementation the yield effect is unknown: a coroutine of the operation's function with no implementation installed is MISSING-CONTEXT, with two AMBIGUOUS-CONTEXT-IMPLEMENTATION -- each alone, never followed by a COROUTINE-RHS-NOT-YIELDING that guesses (both were reported before) -- and no other implementation is chosen; a construction no call selects for (in a function the program never calls) is judged as before, COROUTINE-RHS-NOT-YIELDING} -body {
    withPrivateLibrary {
        writeModules $::cyLib
        set results [list [diagnosticKinds [cyProgram {} "coroutine {step, first} = std::ty::drv::run()\nfirst\n"]] \
            [diagnosticKinds [cyProgram {sim ysim} "coroutine {step, first} = std::ty::drv::run()\nfirst\n"]] \
            [diagnosticKinds [cyProgram {ysim alt} "coroutine {step, first} = std::ty::drv::wrapper()\nfirst\n"]] \
            [diagnosticKinds [cyProgram {} "fn later(context d: std::ty::drv::Driver):\n    coroutine {step, first} = std::ty::drv::run()\n    first\n\n1\n"]]]
    }
    set results
} -result {MISSING-CONTEXT AMBIGUOUS-CONTEXT-IMPLEMENTATION AMBIGUOUS-CONTEXT-IMPLEMENTATION COROUTINE-RHS-NOT-YIELDING}

test ct-implementation-yield-order {declaration and import order decide nothing: the implementation's module before or after the trait's, the yielding helper before or after its caller -- the same coroutine, on every backend} -body {
    set lib [list ty/d.bot [lindex $::ciLib 1] ty/h.bot [lindex $::ciLib 7]]
    set reordered [list ty/h.bot [string map [list "fn helper(x: int) -> int:\n    yield x\n    x + 1\n\nfn wait(deadline: int, context w: H) -> int:\n    helper(deadline)\n" "fn helper(x: int) -> int:\n    yield x\n    x + 1\n\nfn wait(deadline: int, context w: H) -> int:\n    helper(deadline)\n\nfn unused() -> int:\n    1\n"] [lindex $::ciLib 7]] ty/d.bot [lindex $::ciLib 1]]
    set results {}
    foreach files [list $lib $reordered] {
        foreach imports {"import std::ty::d\nimport std::ty::h\n" "import std::ty::h\nimport std::ty::d\n"} {
            lappend results [moduleAgree $files "${imports}with context std::ty::h::create()\ncoroutine {step, first} = std::ty::d::wrapper()\n\[first, step()\]\n"]
        }
    }
    lsort -unique $results
} -result {{value {[5, 12]}}}

test ct-implementation-yield-event-loop {the event-loop exploration's scheduler, unchanged, under a host-stepped driver (audit/event-loop/repro/host-stepped-driver): the selected implementation of evloop::Driver's block yields each deadline through a helper, so the program's main is a coroutine the host steps -- with warnings as errors, the host receives the deadlines 100 and 200 and then the loop's two turns, the tasks' trace the same on every backend (COROUTINE-RHS-NOT-YIELDING before TRAIT-IMPLEMENTATION-YIELD-INFERENCE-MILESTONE-1.md)} -body {
    set dir [file join [temporaryDirectory] ct-host-stepped]
    file delete -force $dir
    file mkdir $dir
    file copy [file join $::projectRoot audit event-loop src evloop.bot] $dir
    foreach f {stepdrv.bot app.bot} {
        file copy [file join $::projectRoot audit event-loop repro host-stepped-driver $f] $dir
    }
    try {
        set hir [surface::readProgramFile [file join $dir app.bot] -warnings error]
        set outcomes [lsort -unique [lmap b {interp compile cranelift-generic cranelift} {lrange [outcomeUnderHir $b $hir] 0 end-1}]]
    } finally {
        file delete -force $dir
    }
    list [llength $outcomes] [string range [lindex $outcomes 0 1] 0 24] [string match {*"t=1: woke 1"*"t=2: woke 2"*"t=2: no live work"*} [lindex $outcomes 0 1]]
} -result {1 {[[100], [200, 2], ["t=0: } 1}

test ct-implementation-yield-hir {the checked program: the operation's call in run has an edge to the selected implementation (YSim's wait) in the coroutine call graph and nowhere else -- not to the same-named function of the trait's module -- which hir/staticdeps.tcl reads as its call target (hir::coroutines::ImplementationTargets); the operation's function and its wrapper may yield. The operation in both, a function the program never calls, has no edge: the plan binds nothing there (the monomorphized program drops both). With the non-yielding Sim selected no edge is kept} -body {
    set hir [dict get [moduleHir $::cyLib [cyProgram ysim "coroutine {step, first} = std::ty::drv::wrapper()\n\[first, step()\]\n"]] traitSource]
    set ops {}
    dict for {e node} [dict get $hir exprs] {
        if {[dict get $node kind] eq "call" && [dict exists $node traitCall]} {
            lappend ops $e
        }
    }
    set targets [lsort -unique [concat {*}[lmap op $ops {
        lmap b [dict getdef [hir::coroutines::ImplementationTargets $hir] $op {}] {hir::contexts::BlockName $hir $b}
    }]]]
    set edges {}
    dict for {b list} [dict get $hir coroutines edges] {
        foreach edge $list {
            if {[lindex $edge 0] in $ops} {
                lappend edges [list [hir::coroutines::Name $hir $b] [hir::coroutines::Name $hir [lindex $edge 1]]]
            }
        }
    }
    set yielding [lsort [lmap b [dict keys [dict get $hir coroutines mayYield]] {hir::coroutines::Name $hir $b}]]
    set quiet [moduleHir $::cyLib [cyProgram sim "\[std::ty::drv::run(), std::ty::drv::wrapper()\]\n"]]
    list [llength $ops] $targets [lsort $edges] $yielding [dict getdef [dict get $quiet traitSource] coroutines graph {}]
} -result {2 std::ty::ysim::wait {{std::ty::drv::run std::ty::ysim::wait}} {std::ty::drv::both std::ty::drv::deep std::ty::drv::poll std::ty::drv::run std::ty::drv::wait std::ty::drv::wrapper std::ty::ysim::wait} {}}

test ct-source-audit {no backend implements context traits: core/, compiler/ and native/ never name a library context trait, context or refinement, never read the trait registry, satisfaction or selection, and the only context-trait mention below HIR is the dead-code placeholder's comment} -body {
    set hits {}
    foreach dir {core compiler native native/src native/src/codegen native/src/runtime} {
        foreach file [glob -nocomplain -directory [file join $::projectRoot $dir] *.tcl *.rs] {
            set f [open $file r]
            set text [read $f]
            close $f
            foreach pattern {std::io::IO LinuxIO LinuxPath std::io::path satisfiesTrait isContext selections hir::traits:: contextClone traitImpl} {
                if {[string first $pattern $text] >= 0} {
                    lappend hits [list [file tail $file] $pattern]
                }
            }
        }
    }
    lsort -unique $hits
} -result {}

cleanupTests
