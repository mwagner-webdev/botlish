# (A module of its own, std::winpath: `std::windows` is the Windows
# platform's namespace, WINDOWS-X86-64-MILESTONE-2.md.)
test trait-future-path-shape {a Path-like trait with a non-receiver parameter and self results specializes to a refined str and to a module struct, with no erased path object} -body {
    set lib {winpath.bot {import std::str

struct WindowsPath:
    text: str

fn concat(path: WindowsPath, component: str) -> WindowsPath:
    WindowsPath {text: std::str::concat(std::str::concat(path.text, "\\"), component)}

fn parent(path: WindowsPath) -> WindowsPath:
