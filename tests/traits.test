test trait-refinement-witness-identity {sibling refinements of str with different operations are distinct witnesses: distinct specializations, distinct targets, one representation} -body {
    # (one namespace declares one `display`: each refinement in its own module)
    set lib {wa.bot {import std::str

refined type A = str

fn a?(s: str) -> bool proves s: A:
    std::str::length(s) > 0

fn display(value: A) -> str:
    std::str::concat("A:", value)
}
wb.bot {import std::str

refined type B = str

fn b?(s: str) -> bool proves s: B:
    std::str::length(s) > 0

fn display(value: B) -> str:
    std::str::concat("B:", value)
}}
    # One value proven both A and B has no single witness; prove them apart:
    set source "import std::wa\nimport std::wb\ntrait Displayable:\n    fn display(value: Displayable) -> str\nfn show(v: Displayable) -> str:\n    v.display()\nfn one(s: str) -> str:\n    if std::wa::a?(s):\n        show(s)\n    else:\n        \"\"\nfn two(s: str) -> str:\n    if std::wb::b?(s):\n        show(s)\n    else:\n        \"\"\n\[one(\"x\"), two(\"y\")\]\n"
    withPrivateLibrary {
        writeModules $lib
        set hir [surface::compile $source -warnings off]
        set nir [native::nir $hir -tiny-leaf-inline-opt 0]
        set value [sourceAgree $source]
    }
    set a [nirBody $nir show<std::wa::A>]
    set b [nirBody $nir show<std::wb::B>]
    list $value [expr {$a ne $b}] \
         [string match "*= call [nirId $nir std::wa::display] %0" [lindex $a 0]] \
         [string match "*= call [nirId $nir std::wb::display] %0" [lindex $b 0]] \
         [regexp {func [0-9]+ "show<std::wa::A>" params=1 env=0 [^\n]*instance="str"} $nir] \
         [regexp {func [0-9]+ "show<std::wb::B>" params=1 env=0 [^\n]*instance="str"} $nir]
} -result {{value {["A:x", "B:y"]}} 1 1 1 1 1}

