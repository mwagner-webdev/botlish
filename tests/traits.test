test trait-independent-parameters {two trait parameters have independent witnesses: show_pair(person, service) is one specialization with both} -body {
    set source "${principalHeader}fn show_pair(a: Named, b: Named) -> List\[str\]:\n    \[a.name(), b.name()\]\nshow_pair(Person {value: \"p\"}, std::services::make_service(\"s\"))\n"
    list [moduleAgree $principalLib $source] \
         [lsearch -all -inline -glob [functionNames [moduleHir $principalLib $source]] show_pair*]
} -result {{value {["p", "svc:s"]}} show_pair<Person,std::services::Service>}

test trait-passing-onward {a view passed to another trait consumer keeps its witness, statically} -body {
    set source "${prelude}fn inner(v: Named) -> str:\n    v.name()\nfn outer(v: Named) -> str:\n    inner(v)\nouter(Person {value: \"o\"})\n"
    set hir [surface::compile $source -warnings off]
    set outerClone [lindex [hirFind $hir bind outer<Person>] 0]
    set call [lindex [hir::get $hir [hir::get $hir $outerClone value] body] 0]
    list [sourceAgree $source] [dict get $hir bindings [hir::get $hir [hir::get $hir $call callee] binding] name]
} -result {{value {"o"}} inner<Person>}

test trait-recursion-two-witnesses {a recursive trait-polymorphic function specializes once per witness, each calling itself directly} -body {
    set source "${principalHeader}fn recurse(value: Named, n: int) -> str:\n    if n > 0:\n        recurse(value, n - 1)\n    else:\n        value.name()\n\[recurse(Person {value: \"p\"}, 3), recurse(std::services::make_service(\"s\"), 4)\]\n"
    set hir [moduleHir $principalLib $source]
    set self {}
    foreach clone {recurse<Person> recurse<std::services::Service>} {
        set block [hir::get $hir [lindex [hirFind $hir bind $clone] 0] value]
        foreach e [hirFind $hir call] {
            if {[hir::get $hir $e target] eq [list block $block]} {
                lappend self $clone
            }
        }
    }
    list [moduleAgree $principalLib $source] [lsort -unique $self] [llength [lsearch -all [functionNames $hir] recurse*]]
} -result {{value {["p", "svc:s"]}} {recurse<Person> recurse<std::services::Service>} 2}

test trait-instance-budget-fallback {a trait-polymorphic function called with more distinct argument types than the semantic-instance budget still specializes: past the budget, an instance keyed by its witnesses alone} -body {
    set structs ""
    set calls {}
    for {set i 0} {$i < 20} {incr i} {
        append structs "struct S$i:\n    v: int\n"
        lappend calls "tag(Person {value: \"t\"}, S$i {v: $i})"
    }
    set source "${prelude}${structs}fn tag(value: Named, extra) -> str:\n    value.name()\n\[[join $calls {, }]\]\n"
    set hir [surface::compile $source -warnings off]
    list [sourceAgree $source] [lsearch -all -inline -glob [functionNames $hir] tag*]
} -result [list [list value "\[[join [lrepeat 20 {"t"}] {, }]\]"] tag<Person>]

# A dead call of a trait-polymorphic function (COMPILER-BOTTLENECKS.md, 4.2):
# mk() is `never` once its static block is rejected (it declares no result
# type: a declared one would type its calls), so a call taking it as an
# argument never reaches its callee and the semantic
# layer requests no instance for it. The plan does not report
# TRAIT-INSTANCE-BUDGET there (no budget is involved, and the call cannot
# run): it keeps the arguments, which still run in order up to the one that
# raises the reified CompilerError, and calls the placeholder of
# never-executed code -- for a call with the view as that argument (dead1),
# as another argument after one that runs (dead2: bump() runs before mk()
# raises), a
# method-syntax call (dead3), and a dead call in a clone's body (dead4: in
# outer<Person>).
set deadCalls "import std::compiler
import std::mutable_array

${prelude}context struct Counter:
    a: MutableArray\[int\]

fn bump(context c: Counter) -> int:
    v = std::mutable_array::at(c.a, 0):
        on IndexNotFound:
            0
    std::mutable_array::set(c.a, 0, v + 1):
        on IndexNotFound:
            unit
    v + 1

fn count(context c: Counter) -> int:
    std::mutable_array::at(c.a, 0):
        on IndexNotFound:
            -1

fn want_str(s: str) -> str:
    s

fn tagged(n: int, value: Named, extra: Person) -> str:
    value.name()

fn mk() errors std::compiler::CompilerError:
    static compile:
        Person {value: want_str(1)}

fn outer(value: Named) -> str errors std::compiler::CompilerError:
    tagged(1, value, mk())

fn dead1() -> str errors std::compiler::CompilerError:
    describe(mk())

fn dead2() -> str errors std::compiler::CompilerError:
    tagged(bump(), Person {value: \"p\"}, mk())

fn dead3() -> str errors std::compiler::CompilerError:
    mk().describe()

fn dead4() -> str errors std::compiler::CompilerError:
    outer(Person {value: \"o\"})

with context Counter {a: std::mutable_array::create(1, 0)}
r1 = dead1():
    on std::compiler::CompilerError:
        \"e1\"
r2 = dead2():
    on std::compiler::CompilerError:
        \"e2\"
c1 = count()
r2b = dead2():
    on std::compiler::CompilerError:
        \"e2\"
r3 = dead3():
    on std::compiler::CompilerError:
        \"e3\"
r4 = dead4():
    on std::compiler::CompilerError:
        \"e4\"
\[r1, r2, c1, r2b, count(), r3, r4, describe(Person {value: \"live\"})\]
"

test trait-dead-call-keeps-arguments {a dead call of a trait-polymorphic function compiles: no TRAIT-INSTANCE-BUDGET, its arguments still run up to the one that raises, each becomes a call of the placeholder with its arguments, and a function only dead calls reach (tagged) gets no clone -- on every backend} -body {
    set hir [surface::compile $deadCalls -warnings off]
    set placeholders {}
    dict for {e node} [dict get $hir exprs] {
        if {[dict get $node kind] eq "call" && [lindex [dict get $node target] 0] eq "native"
                && [dict get [hir::symbol $hir [lindex [dict get $node target] 1]] name] eq "context#unreachable"} {
            lappend placeholders [llength [dict get $node args]]
        }
    }
    list [sourceAgree $deadCalls] [traitFree $hir] [lsort $placeholders] \
        [lsort [lsearch -all -inline -regexp [functionNames $hir] {^(describe|tagged|outer)}]]
} -cleanup {unset -nocomplain hir placeholders} -result {{value {["e1", "e2", 1, "e2", 2, "e3", "e4", "live"]}} 1 {1 1 3 3} {describe<Person> outer<Person>}}

test trait-polymorphic-recursion-rejected {recursion between different witnesses' specializations is rejected} -body {
    set lib {other.bot {struct O:
    v: str

fn name(o: O) -> str:
    o.v
}}
    lindex [moduleRejection $lib "import std::other\n${prelude}fn flip(v: Named, n: int) -> str:\n    if n == 0:\n        v.name()\n    else:\n        if mod(n, 2) == 0:\n            flip(Person {value: \"p\"}, n - 1)\n        else:\n            flip(std::other::O {v: \"o\"}, n - 1)\nflip(Person {value: \"x\"}, 3)\n"] 0
} -result TRAIT-POLYMORPHIC-RECURSION

