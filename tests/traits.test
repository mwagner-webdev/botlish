    path.text
}}
    set source {import std::str
import std::winpath

trait Path:
    fn concat(path: Path, component: str) -> Path
    fn parent(path: Path) -> Path
    fn render(path: Path) -> str

refined type LinuxPath = str

fn linux?(s: str) -> bool proves s: LinuxPath:
    std::str::length(s) > 0

fn concat(path: LinuxPath, component: str) -> LinuxPath:
    joined = std::str::concat(std::str::concat(path, "/"), component)
    if linux?(joined):
        joined
    else:
        path

fn parent(path: LinuxPath) -> LinuxPath:
    path

fn render(path: LinuxPath) -> str:
    path

fn somewhere(path: Path) -> Path:
    path.concat("child")

fn home() -> str:
    "/home"

h = home()
lin = if linux?(h):
    somewhere(h).render()
else:
    ""
[lin, somewhere(std::winpath::WindowsPath {text: "C:"}).parent().render()]
}
    list [moduleAgree $lib $source] \
         [lsort [lsearch -all -inline -glob [functionNames [moduleHir $lib $source]] somewhere*]] \
         [traitFree [moduleHir $lib $source]]
} -result {{value {["/home/child", "C:\\child"]}} {somewhere<LinuxPath> somewhere<std::winpath::WindowsPath>} 1}

