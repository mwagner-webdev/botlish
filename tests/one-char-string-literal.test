} -result {{2:5 4:5 5:12} 1}

test oc-module-literal-located-in-the-module {a module's literal is located in the module file, and reported once for the program that loads it} -body {
    withModules {seps.bot {fn comma():
    ","
fn pair():
    "<>"
}} {
        set hir [compileWith {import seps
[seps::comma(), seps::pair(), seps::comma()]}]
        lmap w [literalsOf $hir] {file tail [hir::originLocation $hir [dict get $w primary]]}
    }
