test oc-instances-never-walked {the pass reads the generic source HIR once: a literal in a polymorphic function with three semantic instances is one warning; collecting over HIR stripped of the semantic side table gives the identical warnings} -body {
    set hir [compileWith {fn poly(x):
    sep = ","
    x == sep
[poly(1), poly("ab"), poly(true)]}]
    set site [dict get [lindex [literalsOf $hir] 0] data site]
    set covering [lmap {id instance} [dict get $hir semantic instances] {
        if {![dict exists $instance snapshot exprs $site]} continue
        set id
    }]
    list [llength $covering] [llength [literalsOf $hir]] \
        [expr {[hir::warnings::OneCharStringLiteral $hir] eq [hir::warnings::OneCharStringLiteral [dict remove $hir semantic]]}]
} -result {3 1 1}

test oc-trait-program-warned-as-written {a trait-polymorphic function's literal is one warning: the program is warned as written (its checked source build), never as monomorphized, where the literal exists once per witness} -body {
    withModules {wa.bot {struct A:
    v: str
fn name(value: A) -> str:
    value.v
} wb.bot {struct B:
    t: str
fn name(value: B) -> str:
    value.t
}} {
        set hir [compileWith {import str
import wa
import wb
trait Named:
    fn name(value: Named) -> str
fn describe(value: Named) -> str:
    sep = "-"
    value.name().concat(sep)
[describe(wa::A {v: "ab"}), describe(wb::B {t: "cd"})]}]
        set clones 0
        dict for {e node} [dict get $hir exprs] {
            if {[dict get $node kind] eq "const" && [dict get $node value] eq {str -}} {
                incr clones
            }
        }
        list [where {}] $clones [lmap w [literalsOf $hir] {loc $hir [dict get $w primary]}] [lindex [outcomeUnderHir interp $hir] 1]
    }
} -result {{} 2 7:11 {["ab-", "cd-"]}}

# ---------------------------------------------------------------------------
# Interleaving with the five existing codes (item 9)

set ::sixSource {refined type E = str
error Bad
fn dup(x):
    if x < 0:
        return 0
    if x > 100:
        return 0
    return 1
fn two(a, b):
    a
fn pair(a, b):
    [a, b]
fn t(x):
    return two(x, 1)
fn check(x) errors Bad:
    if x < 0:
        fail Bad
    if x > 9:
        fail Bad
    x
fn emailish(v: str) -> bool proves v: E:
    v == "@"}

