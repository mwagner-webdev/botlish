# ---------------------------------------------------------------------------
# The command line

test oc-cli-modes {main.tcl: default prints the warnings on stderr and runs; off is silent; error rejects before running} -constraints executableAot -body {
    set main [file join $::projectRoot main.tcl]
    set path [makeFile $::runSource oc-cli-[pid].bot]
    set results {}
    foreach mode {default off error} {
        set status [catch {exec [info nameofexecutable] $main -warnings $mode $path 2>@1} out]
        lappend results [list $mode $status \
            [regexp -all {: warning: the String literal `"[^`]*"` is one character long; a single character is written as a character literal \(ONE-CHAR-STRING-LITERAL\)} $out] \
            [regexp {note:} $out] \
            [regexp {value: } $out] \
            [regexp {CORE SEMANTIC ONE-CHAR-STRING-LITERAL} $out]]
    }
    removeFile oc-cli-[pid].bot
    set results
} -result {{default 0 6 0 1 0} {off 0 0 0 1 0} {error 1 0 0 0 1}}

test oc-cli-no-wno-option {-Wno-one-char-string-literal is an unknown option, not a file name} -constraints executableAot -body {
    set main [file join $::projectRoot main.tcl]
    set path [makeFile $::runSource oc-cli-wno-[pid].bot]
    catch {exec [info nameofexecutable] $main -Wno-one-char-string-literal $path 2>@1} out
    removeFile oc-cli-wno-[pid].bot
    list [string match "*unknown option*-Wno-one-char-string-literal*" $out] [string match "*value:*" $out]
} -result {1 0}

test oc-cli-unknown-mode {main.tcl rejects an unknown mode} -constraints executableAot -body {
    set main [file join $::projectRoot main.tcl]
    set path [makeFile $::runSource oc-cli-mode-[pid].bot]
    set status [catch {exec [info nameofexecutable] $main -warnings literals $path 2>@1} out]
    removeFile oc-cli-mode-[pid].bot
    list $status [string match "*unknown warnings mode*" $out]
} -result {1 1}

test oc-cli-stdout-clean {the warnings go to stderr: program stdout carries no warning text} -constraints executableAot -body {
    set main [file join $::projectRoot main.tcl]
    set path [makeFile $::runSource oc-cli-stdout-[pid].bot]
    set stderrPath [makeFile {} oc-cli-stderr-[pid].txt]
    set out [exec [info nameofexecutable] $main -warnings default $path 2> $stderrPath]
    set err [viewFile oc-cli-stderr-[pid].txt]
    removeFile oc-cli-stdout-[pid].bot
    removeFile oc-cli-stderr-[pid].txt
    list [string match *warning* $out] [string match "*one character long*" $out] [regexp -all {ONE-CHAR-STRING-LITERAL} $err] \
        [string match {*value: *} $out]
} -result {0 0 6 1}

test oc-error-cli-stops-before-backend {main.tcl -backend cranelift -warnings error rejects without lowering or running anything} -constraints executableAot -body {
    set main [file join $::projectRoot main.tcl]
    set path [makeFile $::runSource oc-cli-error-[pid].bot]
    catch {exec [info nameofexecutable] $main -backend cranelift -warnings error $path 2>@1} out
    removeFile oc-cli-error-[pid].bot
    list [string match "*value:*" $out] [regexp {\(CORE SEMANTIC ONE-CHAR-STRING-LITERAL\)} $out]
} -result {0 1}

# The warning lines (and their notes) of main.tcl's stderr for PATH on
# BACKEND, with the file's directory stripped.
proc cliWarningText {path backend} {
    set main [file join $::projectRoot main.tcl]
    set err [makeFile {} oc-cli-err-[pid].txt]
    catch {exec [info nameofexecutable] $main -backend $backend -warnings default $path 2> $err}
    set lines [lmap line [split [viewFile oc-cli-err-[pid].txt] \n] {
        if {![string match "*: warning: *" $line] && ![string match "*: note: *" $line]} continue
        set line
    }]
    removeFile oc-cli-err-[pid].txt
    return $lines
}

test oc-cli-backend-independent {main.tcl prints the identical warning text, all six codes, on every backend} -constraints executableAot -body {
    set path [makeFile "$::sixSource\ny = check(3):\n    on Bad:\n        0\n\[y, emailish(\"ab\")\]" oc-cli-six-[pid].bot]
    set texts [lmap backend $::allBackends {cliWarningText $path $backend}]
    removeFile oc-cli-six-[pid].bot
    set first [lindex $texts 0]
    list [llength [lsort -unique $texts]] [llength [lsearch -all $first *ONE-CHAR-STRING-LITERAL*]] [llength $first]
} -result {1 1 8}

test oc-cli-backend-independent-corpus {main.tcl prints the identical warning text (every code, notes included) on every backend over the stdlib corpus, the refinement example and the string-heavy surface and bench programs; this warning's lines are there} -constraints executableAot -body {
    set programs [lsort [glob -directory [file join $::projectRoot examples stdlib] *.bot]]
    lappend programs [file join $::projectRoot examples refinement refined-strings.bot] \
        [file join $::projectRoot examples surface 06-csv-records.bot] \
        [file join $::projectRoot bench lex-strategy.bot]
    set mismatches {}
    set total 0
    set literals 0
    foreach path $programs {
        set texts [lmap backend $::allBackends {cliWarningText $path $backend}]
        incr total [llength [lindex $texts 0]]
        incr literals [llength [lsearch -all [lindex $texts 0] *ONE-CHAR-STRING-LITERAL*]]
        if {[llength [lsort -unique $texts]] != 1} {
            lappend mismatches [file tail $path]
        }
    }
    list $mismatches [expr {$total > $literals}] [expr {$literals > 0}]
} -result {{} 1 1}

# ---------------------------------------------------------------------------
# The spelling law at unit level (item 14): each finding's character spelling
# lexes and parses, and its exact value is the UnicodeChar of the same code
# point; where the character type is required, it type-checks

test oc-spelling-law-unit {for a letter, punctuation, both quotes, a backslash, newline, tab, carriage return, a two-byte, a three-byte and a supplementary-plane character: the warned String's character spelling compiles, its exact value is the UnicodeChar of the same code point, and a UnicodeChar parameter takes it} -body {
    set chars [list a , \" ' \\ \n \t \r "é" "世" "\U1F600"]
    set source "\[[join [lmap c $chars {string cat \" [string map [list \\ \\\\ \" \\\" \n \\n \t \\t \r \\r] $c] \"}] {, }]\]"
    set hir [compileWith $source]
    set results {}
    foreach w [literalsOf $hir] {
        set text [core::value::strOf [dict get $w data value]]
        set codepoint [scan $text %c]
        set spelling [charSpelling $text]
        set probe [compileWith "x = $spelling\nx" off]
        set consts [lmap {e node} [dict get $probe exprs] {
            if {[dict get $node kind] ne "const"} continue
            set e
        }]
        set fact [expr {[llength $consts] == 1 ? [hir::exact::Of $probe [lindex $consts 0]] : "consts: $consts"}]
        set typed [behavior "import char\nfn code(c: UnicodeChar) -> int:\n    char::scalar_value(c)\ncode($spelling)"]
        lappend results [expr {$fact eq [list val [list UnicodeChar $codepoint]] && $typed eq [list value $codepoint]}]
    }
    list [llength [literalsOf $hir]] [lsort -unique $results]
} -result {11 1}

test oc-spelling-law-no-gap-sampled {no spelling gap: every Unicode scalar of a sample across all planes (the controls, the surrogate boundaries, each plane's first and last scalars) has a one-character String spelling and a character-literal spelling the lexer reads as that scalar (the audit fuzzer checks all 1112064)} -body {
    set sample {}
    for {set cp 0} {$cp < 0x100} {incr cp} {
        lappend sample $cp
    }
    lappend sample 0xD7FF 0xE000 0xFFFD 0xFFFE 0xFFFF
    for {set plane 1} {$plane <= 16} {incr plane} {
        lappend sample [expr {$plane << 16}] [expr {($plane << 16) | 0xFFFF}]
    }
    set gaps {}
    foreach cp $sample {
        set ch [format %c $cp]
        set diagnostics {}
        set string [surface::lexer::String "\"[string map [list \\ \\\\ \" \\\" \n \\n \t \\t \r \\r] $ch]\"" 0 f 1 0 diagnostics]
        set char [surface::lexer::Char [charSpelling $ch] 0 f 1 0 diagnostics]
        if {$diagnostics ne "" || [dict get $string value] ne $ch || [dict get $char value] != $cp} {
            lappend gaps [format U+%04X $cp]
        }
    }
    list [llength $sample] $gaps
} -result {293 {}}

# ---------------------------------------------------------------------------
# Fuzzing: constructed programs, an independent oracle, all three modes and
# the spelling law

test oc-fuzz-smoke {60 generated programs: predicted warnings (anchor, value) and only them, off silent with identical HIR, error iff warned, and the spelling law} -constraints executableAot -body {
    set fuzz [file join $::projectRoot audit one-char-string-literal tools fuzz.tcl]
    lindex [split [string trim [exec [info nameofexecutable] $fuzz 60 1]] \n] end
} -result {seeds 60 (from 1): * with warnings, * without; failures 0; extra warnings 0; spelling law * of * findings, failures 0*} -match glob

cleanupTests
