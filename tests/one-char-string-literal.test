    list [llength [literalsOf $a]] [llength [literalsOf $b]] $c [llength [literalsOf $d]] [llength [literalsOf $e]]
} -result {0 2 1 0 2}

test oc-warnings-attached-structurally {hir::warnings::of equals collect} -body {
    set hir [compileWith $::sixSource default]
