} -result {1 6}

test oc-error-stops-before-backend {error mode rejects before any backend lowers anything (traces on all four entry points)} -body {
    set ::lowerCalls 0
    foreach command {native::evalHir native::prepareHir hir::lower core::compiler::evalHir} {
        trace add execution $command enter {apply {{args} {incr ::lowerCalls}}}
    }
    try {
        set rejected [catch {compileWith $::literalSource error} message options]
    } finally {
        foreach command {native::evalHir native::prepareHir hir::lower core::compiler::evalHir} {
            trace remove execution $command enter {apply {{args} {incr ::lowerCalls}}}
        }
    }
    list $rejected [dict get $options -errorcode] $::lowerCalls
} -result {1 {CORE SEMANTIC ONE-CHAR-STRING-LITERAL} 0}

