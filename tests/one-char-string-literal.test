set ::runSource {import str
sep = ","
fn quote(text: str) -> str:
    "\"".concat(text).concat("\"")
fn joined(a, b):
    a.concat(sep).concat(b)
fn width(text: str) -> int:
    str::length(text)
[quote("a"), joined("x", "yz"), width(";"), width(""), [',', "ab"]]}

