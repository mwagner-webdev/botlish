# one-char-string-literal.test -- the ONE-CHAR-STRING-LITERAL compiler warning
# (WARNINGS-ONE-CHAR-STRING-LITERAL.md) on the warning framework
# WARNINGS-SAME-RETURN.md built (hir/warnings.tcl).
#
# The theorem: a literal site is reported exactly when it is a written String
# literal whose exact value is a String of character length 1. One diagnostic
# per site, anchored at the literal, no secondary locations; everything else
# is silent:
#
#   * the empty String and Strings of two or more characters (length counted
#     in characters, i.e. Unicode scalar values, as str::length counts: escapes
#     resolved, a supplementary-plane character is one, a base character plus
#     a combining mark is two);
#   * character literals ('x', a UnicodeChar);
#   * anything that is not a written literal: a binding read at a use site, an
#     alias, a parameter, a call result, a computed String -- whatever its
#     value -- and the one String const the frontend synthesizes (a context
#     parameter's load key).
#
# The pass is context-blind (it never looks at what consumes a literal, so it
# warns exactly where the character spelling would not type-check today: that
# is the API-deficiency surface it exists to expose) and has no reachability
# notion (a literal in a dead branch or an uncalled function warns). The
# message renders the written literal's exact value and never the character
# spelling: the warning is deliberately not autofixable.
#
# Like the other warning test files, every compile here passes its policy and
# channel explicitly (`-warnings MODE`, `-warning-channel ""` to collect
# without printing), so this file exercises default, off and error whatever
# the harness's process default is.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]

testConstraint executableAot [expr {$::tcl_platform(os) eq "Linux" &&
    $::tcl_platform(machine) in {x86_64 amd64}}]

set ::allBackends {interp compile cranelift-generic cranelift}
set ::ocCode ONE-CHAR-STRING-LITERAL

# The HIR of SOURCE under policy MODE (default off error), collecting
# warnings without printing them.
proc compileWith {source {mode default}} {
    return [surface::compile $source t.bot -warnings $mode -warning-channel ""]
}

# "LINE:COL" of ORIGIN in HIR, without the file name when it is t.bot.
proc loc {hir origin} {
    return [regsub {^t\.bot:} [hir::originLocation $hir $origin] {}]
}

# The ONE-CHAR-STRING-LITERAL warnings of HIR.
proc literalsOf {hir} {
    return [lmap w [hir::warnings::of $hir] {
        if {[dict get $w code] ne $::ocCode} continue
        set w
    }]
}

# Each ONE-CHAR-STRING-LITERAL warning of SOURCE as {PRIMARY VALUE}, VALUE the
# data's exact value as the repository displays it (core::value::show).
proc sites {source} {
    set hir [compileWith $source]
    return [lmap w [literalsOf $hir] {
        list [loc $hir [dict get $w primary]] [core::value::show [dict get $w data value]]
    }]
}

# "LINE:COL" of each ONE-CHAR-STRING-LITERAL warning of SOURCE, in order.
proc where {source} {
    return [lmap s [sites $source] {lindex $s 0}]
}

# "MESSAGE @ PRIMARY" for each ONE-CHAR-STRING-LITERAL warning of SOURCE.
proc shown {source} {
    set hir [compileWith $source]
    return [lmap w [literalsOf $hir] {
        string cat [dict get $w message] " @ " [loc $hir [dict get $w primary]]
    }]
}

# 1 if SOURCE compiles with no ONE-CHAR-STRING-LITERAL warning.
proc silent {source} {
    return [expr {[literalsOf [compileWith $source]] eq ""}]
}

# Every warning of SOURCE (all codes) as {CODE PRIMARY}.
proc allWarnings {source} {
    set hir [compileWith $source]
    return [lmap w [hir::warnings::of $hir] {list [dict get $w code] [loc $hir [dict get $w primary]]}]
}

# The rejection of SOURCE under MODE: {errorcode message}, or "compiled".
proc rejection {source mode} {
    if {[catch {compileWith $source $mode} message options]} {
        return [list [dict get $options -errorcode] $message]
    }
    return compiled
}

# What SOURCE does on the reference interpreter, compiled with warnings off:
# {value V}, {runtime ERRORCODE} or {rejected ERRORCODE}.
proc behavior {source} {
    if {[catch {compileWith $source off} hir options]} {
        return [list rejected [dict get $options -errorcode]]
    }
    set outcome [outcomeUnderHir interp $hir]
    if {[lindex $outcome 0] eq "value"} {
        return [list value [lindex $outcome 1]]
    }
    return [list runtime [lindex $outcome 1]]
}

# Runs SCRIPT with module files FILES ({NAME TEXT ...}) in a private library
# directory (a per-process name in the tcltest temporary directory).
proc withModules {files script} {
    set saved $::core::libraryDir
    set dir [makeDirectory oc-scratch-[pid]]
    foreach entry [glob -nocomplain -directory $saved *] {
        file copy -force $entry $dir
    }
    set ::core::libraryDir $dir
    try {
        foreach {name text} $files {
            set channel [open [file join $dir $name] w]
            fconfigure $channel -encoding utf-8
            puts -nonewline $channel $text
            close $channel
        }
        uplevel 1 $script
    } finally {
        set ::core::libraryDir $saved
        removeDirectory oc-scratch-[pid]
    }
}

# The character-literal spelling of the one character CH: the mechanical
# rewrite the spelling law checks (WARNINGS-ONE-CHAR-STRING-LITERAL.md). It
# lives here and in the audit tools only; the compiler never computes it.
proc charSpelling {ch} {
    return "'[string map [list \\ \\\\ ' \\' \n \\n \t \\t \r \\r] $ch]'"
}

# ---------------------------------------------------------------------------
# Shape and the length boundary (items 3, 5)

test oc-motivating-rendered {the motivating quote literal: one warning at the literal, rendered exactly, no notes} -body {
    set hir [surface::compile {fn peek(text, index):
    text
fn scan_quoted(text, index, field):
    character = peek(text, index)
    if character == "\"":
        return field
    scan_quoted(text, index + 1, field)} f.bot -warnings default -warning-channel ""]
    lmap w [literalsOf $hir] {hir::warnings::render $hir $w}
} -result {{f.bot:5:21: warning: the String literal `"\""` is one character long; a single character is written as a character literal (ONE-CHAR-STRING-LITERAL)}}

test oc-length-boundary {0, 1 and 2 characters: only the one-character literal warns} -body {
    sites {["", "a", "ab"]}
} -result {{1:6 {"a"}}}

test oc-empty-string-silent {the empty String is length 0: silent, wherever it is} -body {
    silent {fn f(x):
    if x == "":
        return ""
    [x, ""]
f("")}
} -result 1

test oc-two-or-more-characters-silent {Strings of two or more characters are silent, escapes included} -body {
    silent {["ab", "\n\n", "\\\\", "\"a", "abc", "a b"]}
} -result 1

test oc-escaped-one-character {an escape denoting one character warns: newline, tab, carriage return, a quote inside, a backslash; the value is the one character} -body {
    set hir [compileWith {["\n", "\t", "\r", "\"", "\\"]}]
    lmap w [literalsOf $hir] {
        list [loc $hir [dict get $w primary]] [scan [core::value::strOf [dict get $w data value]] %c]
    }
} -result {{1:2 10} {1:8 9} {1:14 13} {1:20 34} {1:26 92}}

test oc-escapes-are-resolved-by-the-exact-value {the exact value decides, not the spelling: "\n" (two source characters) is one character; "\\n" (a backslash and an n) is two} -body {
    sites {["\n", "\\n"]}
} -result {{1:2 {"\n"}}}

test oc-apostrophe-in-a-string {a one-character String holding an apostrophe warns like any other} -body {
    sites {["'", "''"]}
} -result {{1:2 {"'"}}}

test oc-non-bmp-single-code-point {a supplementary-plane character is one character: it warns} -body {
    set hir [compileWith "\[\"\U1F600\", \"\U1D11E\", \"\U1F600\U1F600\"\]"]
    lmap w [literalsOf $hir] {
        set text [core::value::strOf [dict get $w data value]]
        list [loc $hir [dict get $w primary]] [string length $text] [format %X [scan $text %c]]
    }
} -result {{1:2 1 1F600} {1:7 1 1D11E}}

test oc-grapheme-of-two-code-points-silent {a base character plus a combining mark is two characters (a grapheme cluster, never a character): silent; the precomposed character warns} -body {
    set decomposed "é"
    set precomposed "é"
    set hir [compileWith "\[\"$decomposed\", \"$precomposed\"\]"]
    list [lmap w [literalsOf $hir] {loc $hir [dict get $w primary]}] \
        [string length $decomposed] [string length $precomposed]
} -result {1:8 2 1}

test oc-length-is-str-length {the length is the language's own: the literals that warn are exactly those whose str::length is 1, on every backend} -body {
    set strings [list "" a ab "é" "é" "\U1F600" "\U1F600a" "\\\\" "\\n"]
    set items [lmap s $strings {string cat "str::length(\"" $s "\")"}]
    set source "import str\n\[[join $items {, }]\]"
    set hir [compileWith $source]
    set lengths [lsort -unique [lmap b $::allBackends {lindex [outcomeUnderHir $b $hir] 1}]]
    set warned [lmap w [literalsOf $hir] {core::value::show [dict get $w data value]}]
    list $lengths $warned
} -result {{{[0, 1, 2, 2, 1, 1, 2, 1, 1]}} {{"a"} {"é"} {"😀"} {"\\"} {"\n"}}}

# ---------------------------------------------------------------------------
# Literals only: no heroic proving (items 4, 6)

test oc-initializer-is-the-site {a binding's written initializer is the site, once; reads of the binding at use sites are never sites} -body {
    sites {import str
sep = ","
fn join2(a, b):
    a.concat(sep).concat(b)
[join2("ab", "cd"), sep, sep.concat(sep), [sep]]}
} -result {{2:7 {","}}}

test oc-alias-silent {an alias of a literal is silent at the alias and at its uses: the literal is the site} -body {
    where {first = ";"
second = first
third = second
[first, second, third]}
} -result 1:9

test oc-parameters-silent {a parameter is never a site, whatever its callers pass: the call's literal is the site} -body {
    where {import str
fn twice(c):
    c.concat(c)
fn width(c: str) -> int:
    str::length(c)
[twice("x"), width("y"), twice("xy")]}
} -result {6:8 6:20}

test oc-call-results-silent {a call result is never a site, even when every possible result is one character} -body {
    set source {import str
fn second() -> str:
    "xy".substring(1, 2)
fn pick(flag) -> str:
    if flag:
        "ab".substring(0, 1)
    else:
        "cd".substring(1, 2)
[second(), pick(true), pick(false)]}
    list [silent $source] [behavior $source]
} -result {1 {value {["y", "a", "d"]}}}

test oc-computed-strings-silent {a computed String is never a site: concatenations, substrings and lowercase are not evaluated; only the written one-character literal inside is} -body {
    set hir [compileWith {import str
a = str::concat("ab", "")
b = "AB".lowercase().substring(0, 1)
c = str::concat("x", "")
[a, b, c]}]
    list [lmap w [literalsOf $hir] {loc $hir [dict get $w primary]}] [lindex [outcomeUnderHir interp $hir] 1]
} -result {4:17 {["ab", "a", "x"]}}

test oc-list-and-struct-elements-are-sites {list elements and struct field values written as literals are sites, nested ones included} -body {
    where {xs = ["a", "bc", "d"]
ys = [["e"], ["fg", "h"]]
p = {left: "(", right: "()", inner: {mark: "!"}}
[xs, ys, p]}
} -result {1:7 1:18 2:8 2:21 3:12 3:44}

test oc-nested-positions {sites in every position: a nested function, a closure, a loop body, a handler body, a condition, a method receiver and argument, a return} -body {
    where {import str
error Bad
fn risky(x) errors Bad:
    if x == "!":
        fail Bad
    x
fn outer(s):
    fn inner(t):
        t.concat("-")
    fn k(t):
        s.concat("+")
    parts = loop c in ["p", "qr"]:
        c
    r = risky(s):
        on Bad:
            return "?"
    if s == "=":
        return inner("*".concat("~"))
    [inner(s), k(s), parts, r]
outer("ab")}
} -result {4:13 9:18 11:18 12:24 16:20 17:13 18:22 18:33}

# ---------------------------------------------------------------------------
# Context-blindness (item 7): the literal is all the pass reads

test oc-str-parameter-is-the-api-deficiency-shape {API-DEFICIENCY SHAPE, pinned: a one-character literal passed to a str-typed parameter warns, although its character spelling does not type-check there today} -body {
    set original {fn width(text: str) -> int:
    7
width("a")}
    set rewritten [string map {{"a"} {'a'}} $original]
    list [where $original] [behavior $original] [lindex [behavior $rewritten] 0] [lindex [behavior $rewritten] 1]
} -result {3:7 {value 7} rejected {CORE SEMANTIC TYPE}}

test oc-str-native-argument-warns {a one-character literal passed to a native's str parameter warns; its character spelling compiles there and fails at run time (native parameter types are checked at run time)} -body {
    set original {import str
str::length("a")}
    set rewritten [string map {{"a"} {'a'}} $original]
    list [where $original] [behavior $original] [behavior $rewritten]
} -result {2:13 {value 1} {runtime {CORE SEMANTIC TYPE}}}

test oc-comparison-with-a-string-warns {a one-character literal compared with a String warns; its character spelling compiles there and silently changes the value (== of two kinds is false): the hazard an autofix would hide} -body {
    set original {fn is_quote(text: str) -> bool:
    text == "\""
[is_quote("\""), is_quote("ab")]}
    set rewritten [string map {{== "\""} {== '"'}} $original]
    list [where $original] [behavior $original] [behavior $rewritten]
} -result {{2:13 3:11} {value {[true, false]}} {value {[false, false]}}}

test oc-character-accepting-context-warns {the same literal warns in a context that accepts the character type: a kind-tolerant consumer, where the character spelling compiles and gives the same value} -body {
    set original {fn is_comma(c):
    c == ',' or c == ","
is_comma(",")}
    set rewritten [string map {{is_comma(",")} {is_comma(',')}} $original]
    list [where $original] [behavior $original] [behavior $rewritten] [where $rewritten]
} -result {{2:22 3:10} {value true} {value true} 2:22}

test oc-character-typed-parameter {a UnicodeChar parameter takes the character spelling; the String spelling there is a TYPE error, so no program the warning runs on has one} -body {
    set char {import char
fn code(c: UnicodeChar) -> int:
    char::scalar_value(c)
code(',')}
    set string [string map {{code(',')} {code(",")}} $char]
    list [where $char] [behavior $char] [lindex [rejection $string default] 0]
} -result {{} {value 44} {CORE SEMANTIC TYPE}}

test oc-the-message-names-no-context {the message is the literal's own: the same literal in five different consumers yields five identical messages} -body {
    set hir [compileWith {import str
fn width(text: str) -> int:
    str::length(text)
fn same(c):
    c == c
x = "."
[width("."), ".".concat("ab"), same("."), "." == x]}]
    list [llength [literalsOf $hir]] [lsort -unique [lmap w [literalsOf $hir] {dict get $w message}]]
} -result {5 {{the String literal `"."` is one character long; a single character is written as a character literal}}}

test oc-dead-branch-literal-warns {no reachability notion: a literal in a statically dead branch, after a return and under a range-infeasible branch warns -- where METHOD-ELIGIBLE skips the dead call beside it (the milestone-2 contrast)} -body {
    allWarnings {fn two(a, b):
    a
fn f(x):
    if 1 == 2:
        y = two(x, "a")
        return y
    if x < 0:
        if x > 5:
            return "b"
    return x
    "c"
f(1)}
} -result {{ONE-CHAR-STRING-LITERAL 5:20} {ONE-CHAR-STRING-LITERAL 9:20} {ONE-CHAR-STRING-LITERAL 11:5}}

test oc-uncalled-and-unreachable-functions-warn {a function nobody calls and one declared in a dead branch are written source: their literals warn} -body {
    where {fn never_called(x):
    [x, "a"]
fn f(x):
    if 1 == 2:
        fn dead(y):
            [y, "b"]
        return dead(x)
    x
f(1)}
} -result {2:9 6:17}

test oc-no-completion-walk {no completion walk runs for this warning: hir::completions::reachedExprs is never called by the pass} -body {
    set hir [compileWith {fn f(x):
    if x == 1:
        return "a"
    if x < 0:
        if x > 5:
            return "b"
    "c"} off]
    set ::walks 0
    trace add execution hir::completions::reachedExprs enter {apply {{args} {incr ::walks}}}
    try {
        set warnings [hir::warnings::OneCharStringLiteral $hir]
    } finally {
        trace remove execution hir::completions::reachedExprs enter {apply {{args} {incr ::walks}}}
    }
    list [llength $warnings] $::walks
} -result {3 0}

# ---------------------------------------------------------------------------
# Kind (item 13): character literals are never Strings

test oc-character-literals-never-warn {character literals are silent: letters, escapes, quotes, a supplementary-plane character} -body {
    silent "\['a', '\\n', '\\t', '\\\\', '\\'', '\"', '\U1F600'\]"
} -result 1

test oc-string-beside-character-of-the-same-character {a one-character String beside a character literal of the same character: the String warns, the character is silent} -body {
    where {["a", 'a', "\n", '\n']}
} -result {1:2 1:12}

# ---------------------------------------------------------------------------
# Written String literals: the representation and its robustness (item 4)

test oc-hir-text-input-warns {HIR text keeps a String literal's value: the parsed HIR has the same findings (the written-literal nature survives format and parse)} -body {
    set hir [compileWith {fn f(x):
    if x == ",":
        return ";"
    [x, "ab", '!']
f(":")} off]
    set parsed [hir::parse [hir::format $hir]]
    set warnings [hir::warnings::collect $parsed]
    list [lmap w $warnings {dict get $w code}] [lmap w $warnings {core::value::show [dict get $w data value]}] \
        [lmap w $warnings {lindex [dict get $w primary] 0}]
} -result {{ONE-CHAR-STRING-LITERAL ONE-CHAR-STRING-LITERAL ONE-CHAR-STRING-LITERAL} {{","} {";"} {":"}} {ir ir ir}}

test oc-context-load-key-is-not-a-literal {SYNTHESIZED, pinned: a context parameter is bound to context#load("ID"), a String const the frontend builds -- one character for a context struct named C; it is no written literal and silent, while a written "C" warns, from source and from HIR text} -body {
    set source {context struct C:
    v: int
fn f(context c: C):
    c.v
with context C {v: 3}
x = "C"
[f(), x]}
    set hir [compileWith $source]
    set keys [lmap e [dict keys [dict get $hir exprs]] {
        if {![hir::contexts::isLoad $hir $e]} continue
        set key [lindex [dict get $hir exprs $e args] 0]
        list [dict get $hir exprs $key kind] [dict get $hir exprs $key value] [loc $hir [dict get $hir exprs $key origin]]
    }]
    set parsed [hir::parse [hir::format [compileWith $source off]]]
    list $keys [where $source] [lmap w [hir::warnings::collect $parsed] {core::value::show [dict get $w data value]}] \
        [lindex [outcomeUnderHir interp $hir] 1]
} -result {{{const {str C} 3:14}} 6:5 {{"C"}} {[3, "C"]}}

test oc-context-trait-key-is-not-a-literal {SYNTHESIZED, pinned: a context-trait parameter is bound to context#load("TRAIT") in the checked source build -- one character for a context trait named T; it is silent, while a written "T" warns, from source and from HIR text} -body {
    set source {context trait T:
    fn tick(n: int) -> int
context struct W:
    v: int
fn tick(n: int, context w: W) -> int:
    w.v + n
fn f(n: int, context t: T) -> int:
    t.tick(n)
with context W {v: 3}
x = "T"
[f(1), x]}
    set hir [compileWith $source]
    set checked [dict get $hir traitSource]
    set keys [lmap e [dict keys [dict get $checked exprs]] {
        if {![hir::contexts::isLoad $checked $e]} continue
        dict get $checked exprs [lindex [dict get $checked exprs $e args] 0] value
    }]
    set parsed [hir::parse [hir::format [compileWith $source off]]]
    list [lsort $keys] [lmap w [literalsOf $hir] {loc $hir [dict get $w primary]}] \
        [lmap w [hir::warnings::collect $parsed] {core::value::show [dict get $w data value]}] [lindex [outcomeUnderHir interp $hir] 1]
} -result {{{str T} {str W}} 10:5 {{"T"}} {[4, "T"]}}

test oc-synthesized-string-consts-enumerated {SOURCE AUDIT: the frontend builds a String const in exactly three places -- the written literal (surface/lower.tcl) and the context load key of a context struct and of a context trait (hir/contexts.tcl) -- and every const node is built by hir::syntax::constNode or read from core IR (hir::syntax::fromIR); a new synthesized String const fails here} -body {
    set found {}
    foreach path [lsort [concat [glob [file join $::projectRoot hir *.tcl]] [glob [file join $::projectRoot surface *.tcl]]]] {
        set channel [open $path]
        set lines [split [read $channel] \n]
        close $channel
        set n 0
        foreach line $lines {
            incr n
            if {[regexp {^\s*#} $line]} continue
            if {[regexp {constNode \S+ str\M} $line] || [regexp {Node const } $line]} {
                lappend found [list [file join [file tail [file dirname $path]] [file tail $path]] [string trim $line]]
            }
        }
    }
    set found
} -result {{hir/contexts.tcl {[hir::syntax::constNode $origin str $trait]]]}} {hir/contexts.tcl {[hir::syntax::constNode $origin str $id]]]}} {hir/syntax.tcl {return [Node const $origin literal $args]}} {hir/syntax.tcl {return [Node const $origin literal [lrange $node 1 end]]}} {surface/lower.tcl {return [hir::syntax::constNode $origin str [dict get $node value]]}}}

test oc-desugarings-build-no-string-const {every construct the frontend desugars -- unary minus, !=, not, and, or, elif, struct destructuring, flags, with context, collecting and lockstep loops, method sugar -- builds no String const: a program using them all without a written String literal has none but the context load key, and no warning} -body {
    set hir [compileWith {context struct Box:
    v: int
fn get(context b: Box):
    b.v
fn flagged(x, flags :neg):
    if neg:
        -x
    else:
        x
fn f(a, b):
    {p, q: r} = {p: a, q: b}
    t = if not (p != r) and (p == 1 or r == 2):
        1
    elif p < r:
        2
    else:
        3
    s = loop v in [p, r] and i from 0 to 2:
        v + i
    {t: t, s: s, n: flagged(p, :neg), m: p.flagged()}
with context Box {v: 4}
[1.f(2), get()]}]
    set keys [dict create]
    dict for {e node} [dict get $hir exprs] {
        if {[hir::contexts::isLoad $hir $e]} {
            dict set keys [lindex [dict get $node args] 0] 1
        }
    }
    set strings [lmap {e node} [dict get $hir exprs] {
        if {[dict get $node kind] ne "const" || [lindex [dict get $node value] 0] ne "str"} continue
        list [dict get $node value] [dict exists $keys $e]
    }]
    list $strings [hir::warnings::of $hir]
} -result {{{{str Box} 1}} {}}

# ---------------------------------------------------------------------------
# Structure (items 8, 9, 13): record, data, message, ordering

set ::literalSource {import str
fn quote(text: str) -> str:
    text.concat("\"")
fn width(text: str) -> int:
    str::length(text)
[quote("ab"), width(","), width("")]}

test oc-record-shape {the record is {code message primary secondary data}, secondary empty} -body {
    set w [lindex [literalsOf [compileWith $::literalSource]] 0]
    list [lsort [dict keys $w]] [dict get $w secondary]
} -result {{code data message primary secondary} {}}

test oc-record-data-fields {data: site (the literal's ExprId) and value (the exact String value, the repository's representation) -- nothing else} -body {
    set hir [compileWith $::literalSource]
    lmap w [literalsOf $hir] {
        set site [dict get $w data site]
        list [lsort [dict keys [dict get $w data]]] [dict get $hir exprs $site kind] [dict get $w data value] \
            [expr {[list val [dict get $w data value]] eq [hir::exact::Of $hir $site]}]
    }
} -result {{{site value} const {str {"}} 1} {{site value} const {str ,} 1}}

test oc-primary-is-the-literal {primary is the literal's own origin: the span of the written token, quotes included} -body {
    set hir [compileWith {x = "\t"}]
    set origin [dict get [lindex [literalsOf $hir] 0] primary]
    set fields [lrange $origin 2 end]
    list [dict get $fields line] [dict get $fields column] [dict get $fields endColumn] \
        [expr {$origin eq [dict get $hir exprs [dict get [lindex [literalsOf $hir] 0] data site] origin]}]
} -result {1 5 9 1}

test oc-render-has-no-notes {secondary is empty, so rendering is one line: no note: lines} -body {
    set hir [compileWith $::literalSource]
    lmap w [literalsOf $hir] {llength [split [hir::warnings::render $hir $w] \n]}
} -result {1 1}

test oc-message-template {the template: the written literal (its exact value, as the repository displays values), the fact, the form; nothing else} -body {
    shown $::literalSource
} -result {{the String literal `"\""` is one character long; a single character is written as a character literal @ 3:17} {the String literal `","` is one character long; a single character is written as a character literal @ 6:21}}

test oc-message-renders-the-value-convention {the literal is rendered by the repository's exact-value convention (core::value::show), escapes included} -body {
    set hir [compileWith {["\\", "\n", "\r", "\t", "\"", "'", "%"]}]
    lmap w [literalsOf $hir] {
        expr {[string first "`[core::value::show [dict get $w data value]]`" [dict get $w message]] >= 0}
    }
} -result {1 1 1 1 1 1 1}

test oc-message-escapes-a-carriage-return {the warning for "\r" shows the literal as "\r", as the other escapes: neither the message nor the rendered line carries a raw carriage return (tests/value-display.test)} -body {
    set hir [compileWith {["\r"]}]
    set w [lindex [literalsOf $hir] 0]
    list [dict get $w message] [string first \r [hir::warnings::render $hir $w]]
} -result {{the String literal `"\r"` is one character long; a single character is written as a character literal} -1}

test oc-no-character-spelling-anywhere {the character spelling is never printed -- not in a message, not in data, not in the rendered text -- and nothing is prescribed: no rewrite, no API advice, no imperative} -body {
    set chars [list a , \" \\ ' \n \t % "\U1F600"]
    set source "\[[join [lmap c $chars {string cat \" [string map [list \\ \\\\ \" \\\" \n \\n \t \\t] $c] \"}] {, }]\]"
    set hir [compileWith $source]
    set seen {}
    foreach w [literalsOf $hir] {
        set texts [list [dict get $w message] [dict get $w data] [hir::warnings::render $hir $w]]
        foreach text $texts {
            foreach c $chars {
                if {[string first [charSpelling $c] $text] >= 0} {
                    lappend seen [charSpelling $c]
                }
            }
            foreach word {should consider " use " instead prefer replace rewrite "did you mean" suggest fix -> callee parameter API stdlib str:: UnicodeChar " Char "} {
                if {[string first $word $text] >= 0} {
                    lappend seen $word
                }
            }
        }
    }
    list [llength [literalsOf $hir]] [lsort -unique $seen]
} -result {9 {}}

test oc-one-diagnostic-per-site {one diagnostic per written literal, no grouping: two identical literals are two warnings} -body {
    where {a = "x"
b = "x"
[a, b, "x"]}
} -result {1:5 2:5 3:8}

