    if x > 9:
        fail Bad
    x
fn two(a, b):
    a
fn t(x):
    return two(x, 1)
fn pair(a, b):
    [a, b]
fn dup(x):
    if x < 0:
        return 0
    if x > 100:
        return 0
    return 1}
} -result {{PROVES-NAMING 3:1} {ONE-CHAR-STRING-LITERAL 4:10} {SAME-FAILURE 7:9} {METHOD-ELIGIBLE 14:12} {FIXED-ARITY-LIST-RETURN 16:5} {SAME-RETURN-VALUE 19:9}}

