test oc-off-runs-no-warning-pass-via-trace {an execution trace on the pass proves it is not invoked when off} -body {
    set ::passCalls 0
    trace add execution hir::warnings::OneCharStringLiteral enter {apply {{args} {incr ::passCalls}}}
    try {
        compileWith $::literalSource off
        set off $::passCalls
        compileWith $::literalSource default
        set on $::passCalls
    } finally {
        trace remove execution hir::warnings::OneCharStringLiteral enter {apply {{args} {incr ::passCalls}}}
    }
    list $off $on
} -result {0 1}

