# surface-lowering.test -- surface AST to HIR (surface/lower.tcl).
#
# Lowering restates syntax; HIR decides meaning. These tests check both
# halves: the tree handed to HIR (via hir::lower, which for today's HIR gives
# it back) and the facts HIR derives from it (via hir::format).

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]

proc hirText {source} {
    return [hir::format [surface::compile $source t.bot]]
}

proc loweredIR {source} {
    return [canonicalProgram [hir::lower [surface::compile $source t.bot -strict 0]]]
}

# "LINE:COLUMN" of an origin.
proc at {origin} {
    set fields [lrange $origin 2 end]
    return [dict get $fields line]:[dict get $fields column]
}

# ---------------------------------------------------------------------------
# Lowering rules

foreach {name source ir} {
    int         "42"                      {{const 42}}
    big-int     "123456789012345678901234567890" {{const 123456789012345678901234567890}}
    string      "\"hello world\""         {{const str {hello world}}}
    digit-string "\"42\""                 {{const str 42}}
    booleans    "true\nfalse\nunit"       {{ref true} {ref false} {ref unit}}
    name        "x = 1\nx"                {{bind x {const 1}} {ref x}}
    operator    "1 + 2 * 3"               {{call {ref +} {const 1} {call {ref *} {const 2} {const 3}}}}
    comparison  "1 <= 2"                  {{call {ref <=} {const 1} {const 2}}}
    unary       "-5"                      {{call {ref -} {const 0} {const 5}}}
    call        "fn f(a, b):\n    b\nf(1, 2)" {{bind f {block {a b} {ref b}}} {call {ref f} {const 1} {const 2}}}
    list        "\[1, \"a\", \[\]\]"      {{call {ref list} {const 1} {const str a} {call {ref list}}}}
    function    "fn add(a, b):\n    a + b" {{bind add {block {a b} {call {ref +} {ref a} {ref b}}}}}
    if-else     "if true:\n    1\nelse:\n    2" {{if {ref true} {block {} {const 1}} {block {} {const 2}}}}
    if-no-else  "if true:\n    1"         {{if {ref true} {block {} {const 1}} {block {}}}}
    elif-else   "if true:\n    1\nelif false:\n    2\nelse:\n    3" {{if {ref true} {block {} {const 1}} {block {} {if {ref false} {block {} {const 2}} {block {} {const 3}}}}}}
    elif-no-else "if true:\n    1\nelif false:\n    2" {{if {ref true} {block {} {const 1}} {block {} {if {ref false} {block {} {const 2}} {block {}}}}}}
    elif-chain  "if true:\n    1\nelif false:\n    2\nelif true:\n    3\nelse:\n    4" {{if {ref true} {block {} {const 1}} {block {} {if {ref false} {block {} {const 2}} {block {} {if {ref true} {block {} {const 3}} {block {} {const 4}}}}}}}}
    break-unit  "loop:\n    break"        {{loop {block {} break}}}
    continue    "loop:\n    continue"     {{loop {block {} continue}}}
    return      "fn f():\n    return\nfn g():\n    return 1" {{bind f {block {} {return {ref unit}}}} {bind g {block {} {return {const 1}}}}}
} {
    test lower-rule-$name "lowering rule: $name" -body {
        loweredIR $source
    } -result [canonicalProgram $ir]
}

# ---------------------------------------------------------------------------
# What HIR makes of it

test lower-hir-function {a function declaration is a binding of a block} -body {
    hirText "fn add(a, b):\n    a + b\n\nadd(1, 2)"
} -result {program s2 binds b1 add
e1 bind b1 add : block(e2)/2 -> int
    e2 block s3 (b2 a, b3 b) captures () : block(e2)/2 -> int
        e3 call native(+) : int
            e4 ref b4 + : native +
            e5 ref b2 a : any
            e6 ref b3 b : any
e7 call block(e2) : int
    e8 ref b1 add : block(e2)/2 -> int
    e9 const 1 : int
    e10 const 2 : int}

test lower-hir-closure {a nested function is an ordinary block that HIR finds captures for} -body {
    hirText "fn make_adder(x):\n    fn add(y):\n        x + y\n\n    add\n\nmake_adder(10)(32)"
} -result {program s2 binds b1 make_adder
e1 bind b1 make_adder : block(e2)/1 -> block(e4)/1 -> int
    e2 block s3 (b2 x) captures () binds b3 add : block(e2)/1 -> block(e4)/1 -> int
        e3 bind b3 add : block(e4)/1 -> int
            e4 block s4 (b4 y) captures (b2 x) : block(e4)/1 -> int
                e5 call native(+) : int
                    e6 ref b5 + : native +
                    e7 ref b2 x : any
                    e8 ref b4 y : any
        e9 ref b3 add : block(e4)/1 -> int
e10 call block(e4) : int
    e11 call block(e2) : block(e4)/1 -> int
        e12 ref b1 make_adder : block(e2)/1 -> block(e4)/1 -> int
        e13 const 10 : int
    e14 const 32 : int}

test lower-hir-branch-scopes {branches are inline scopes of the enclosing invocation, not blocks} -body {
    set h [surface::compile "fn f(flag):\n    if flag:\n        x = 1\n        x\n    else:\n        loop:\n            break" t.bot]
    set if [hirFind $h if]
    set loop [hirFind $h loop]
    set block [hirFind $h block]
    list [llength $block] \
         [dict get [hir::scope $h [hir::get $h $if thenScope]] kind] \
         [dict get [hir::scope $h [hir::get $h $if elseScope]] kind] \
         [dict get [hir::scope $h [hir::get $h $loop bodyScope]] kind] \
         [expr {[dict get [hir::scope $h [hir::get $h $if thenScope]] invocation] eq $block}] \
         [expr {[dict get [hir::scope $h [hir::get $h $loop bodyScope]] invocation] eq $block}] \
         [hir::get $h [hirFind $h break] target] $loop
} -match glob -result {1 branch branch loop 1 1 e* e*}

test lower-hir-shadowing {a branch binding shadows without replacing the outer binding} -body {
    set h [surface::compile "x = 1\n\nif true:\n    x = 2\n    x\n\nx" t.bot]
    set refs [hirRefBindings $h x]
    set binds [lmap e [hirFind $h bind x] {hir::get $h $e binding}]
    list [llength [lsort -unique $binds]] [lindex $refs 0] [lindex $binds 1] [lindex $refs 1] [lindex $binds 0]
} -result {2 b3 b3 b1 b1}

test lower-hir-recursion {recursion resolves through the function's own binding} -body {
    set h [surface::compile "fn fact(n):\n    if n <= 1:\n        return 1\n    n * fact(n - 1)\n\nfact(5)" t.bot]
    set ref [lindex [hirFind $h ref fact] 0]
    list [hir::get $h $ref binding] [hir::get $h $ref init] \
         [hir::types::show [hir::bindingType $h b1]] \
         [hir::get $h [hirFind $h return] target] [lindex [hirFind $h block] 0]
} -result {b1 yes {block(e2)/1 -> int} e2 e2}

test lower-hir-operators-are-calls {operators and list literals are ordinary calls with native targets} -body {
    set h [surface::compile "a = 1\n\[a + 2, a * 3, a < 4, a == 5, -a\]" t.bot]
    lsort -unique [lmap e [hirFind $h call] {hir::format::Target $h [hir::get $h $e target]}]
} -result {native(*) native(+) native(-) native(<) native(==) native(list)}

test lower-hir-mutual-recursion {mutually recursive functions are rejected: the earlier function's reference to the later one is unresolved, the later one's reference to the earlier resolves} -body {
    set h [surface::compile "fn even(n):\n    if n == 0:\n        return true\n    odd(n - 1)\nfn odd(n):\n    if n == 0:\n        return false\n    even(n - 1)\neven(4)" t.bot -strict 0]
    list [hirRefBindings $h odd] [hirRefBindings $h even] [lmap d [hir::diagnostics $h] {dict get $d kind}]
} -result {{{}} {b1 b1} UNBOUND}

# ---------------------------------------------------------------------------
# Source origins

test lower-origins {expressions, scopes and bindings originate in the source} -body {
    set h [surface::compile "fn add(a, b):\n    a + b\n\nadd(1, 20)" demo.bot]
    set plus [hirFind $h ref +]
    set call [lindex [hirFind $h call] 0]
    set block [hirFind $h block]
    list [hir::get $h $plus origin] \
         [at [hir::get $h $call origin]] \
         [at [hir::get $h $block origin]] \
         [at [dict get [hir::binding $h b1] origin]] \
         [at [dict get [hir::binding $h b3] origin]] \
         [at [dict get [hir::scope $h [hir::get $h $block bodyScope]] origin]] \
         [at [dict get [hir::scope $h [hir::top $h]] origin]] \
         [hir::sourceFile $h f1]
} -result {{file f1 node add()/binary/op start 20 end 21 line 2 column 7 endLine 2 endColumn 8} 2:5 1:7 1:1 1:11 1:7 1:1 {id f1 path demo.bot}}

test lower-origins-branches {branch and loop scopes originate at their suites} -body {
    set h [surface::compile "if true:\n    1\nelse:\n    loop:\n        break" t.bot]
    set if [hirFind $h if]
    list [at [dict get [hir::scope $h [hir::get $h $if thenScope]] origin]] \
         [at [dict get [hir::scope $h [hir::get $h $if elseScope]] origin]] \
         [at [dict get [hir::scope $h [hir::get $h [hirFind $h loop] bodyScope]] origin]]
} -result {2:5 4:5 5:9}

# elif (ELIF.md) lowers to the HIR of the nested spelling, and keeps
# clause-level locations.

foreach {name elif nested} {
    one-else
        "if a:\n    1\nelif b:\n    2\nelse:\n    3"
        "if a:\n    1\nelse:\n    if b:\n        2\n    else:\n        3"
    chain
        "if a:\n    1\nelif b:\n    2\nelif c:\n    3\nelif d:\n    4\nelse:\n    5"
        "if a:\n    1\nelse:\n    if b:\n        2\n    else:\n        if c:\n            3\n        else:\n            if d:\n                4\n            else:\n                5"
    no-else
        "if a:\n    1\nelif b:\n    2\nelif c:\n    3"
        "if a:\n    1\nelse:\n    if b:\n        2\n    else:\n        if c:\n            3"
    value
        "x = if a:\n    1\nelif b:\n    2\nelse:\n    3\nx"
        "x = if a:\n    1\nelse:\n    if b:\n        2\n    else:\n        3\nx"
    return
        "fn f():\n    return if a:\n        1\n    elif b:\n        2\n    else:\n        3\nf()"
        "fn f():\n    return if a:\n        1\n    else:\n        if b:\n            2\n        else:\n            3\nf()"
    elif-in-branch
        "if a:\n    if b:\n        1\n    elif c:\n        2\nelif d:\n    if e:\n        3\n    else:\n        4\nelse:\n    5"
        "if a:\n    if b:\n        1\n    else:\n        if c:\n            2\nelse:\n    if d:\n        if e:\n            3\n        else:\n            4\n    else:\n        5"
    scoped-bindings
        "if a:\n    x = 1\n    x\nelif b:\n    x = 2\n    x\nelse:\n    x = 3\n    x"
        "if a:\n    x = 1\n    x\nelse:\n    if b:\n        x = 2\n        x\n    else:\n        x = 3\n        x"
    control
        "fn f(a, b):\n    loop:\n        if a:\n            continue\n        elif b:\n            return 1\n        else:\n            break\n    2"
        "fn f(a, b):\n    loop:\n        if a:\n            continue\n        else:\n            if b:\n                return 1\n            else:\n                break\n    2"
} {
    test lower-elif-same-hir-$name "elif ($name) has exactly the HIR (and core IR) of the nested spelling" -body {
        # Unbound names a..e are diagnostics, not errors, under -strict 0; the
        # diagnostics (which carry source locations) are compared by message
        # only.
        set e [surface::compile $elif t.bot -strict 0]
        set n [surface::compile $nested t.bot -strict 0]
        set messages {}
        foreach h [list $e $n] {
            lappend messages [lmap d [hir::diagnostics $h] {dict get $d message}]
        }
        list [expr {[hir::format $e] eq [hir::format $n]}] \
            [expr {[canonicalProgram [hir::lower $e]] eq [canonicalProgram [hir::lower $n]]}] \
            [expr {[lindex $messages 0] eq [lindex $messages 1]}]
    } -result {1 1 1}
}

test lower-elif-origins {an elif clause's if and the else scope holding it originate at the elif keyword; its condition and branch keep their own locations} -body {
    set h [surface::compile "if true:\n    1\nelif false:\n    2\nelif true:\n    3\nelse:\n    4" t.bot]
    lmap e [hirFind $h if] {
        list [at [hir::get $h $e origin]] [at [hir::get $h [hir::get $h $e condition] origin]] \
            [at [dict get [hir::scope $h [hir::get $h $e thenScope]] origin]] \
            [at [dict get [hir::scope $h [hir::get $h $e elseScope]] origin]]
    }
} -result {{1:1 1:4 2:5 3:1} {3:1 3:6 4:5 5:1} {5:1 5:6 6:5 8:5}}

test lower-elif-origins-no-else {without a final else the last clause's empty else originates at the end of the chain, as for a plain if} -body {
    set h [surface::compile "if true:\n    1\nelif false:\n    2" t.bot]
    set inner [lindex [hirFind $h if] 1]
    list [at [hir::get $h $inner origin]] [at [dict get [hir::scope $h [hir::get $h $inner elseScope]] origin]]
} -result {3:1 4:6}

test lower-elif-origin-node-ids {the node ids in an elif clause's origins are the nested ids} -body {
    set h [surface::compile "if true:\n    1\nelif false:\n    2\nelse:\n    3" t.bot]
    list [llength [surface::hirExprs $h if/else/if]] \
        [lmap e [surface::hirExprs $h if/else/if/cond] {hir::kind $h $e}] \
        [lmap e [surface::hirExprs $h if/else/if/else/int] {hir::kind $h $e}]
} -result {1 ref const}

test lower-elif-error-location {a static error in an elif condition names the elif condition's own line and column} -body {
    catch {surface::compile "x = 1\nif x < 0:\n    1\nelif nope:\n    2\nelif x > 3:\n    3\nelse:\n    4" t.bot} message
    set message
} -result {t.bot:4:6: unbound name "nope"}

test lower-elif-error-location-in-branch {a static error in an elif branch names its own line and column} -body {
    catch {surface::compile "x = 1\nif x < 0:\n    1\nelif x > 3:\n    2\nelse:\n    nope" t.bot} message
    set message
} -result {t.bot:7:5: unbound name "nope"}

test lower-origins-query {hir::exprsAt finds expressions by source origin} -body {
    set h [surface::compile "x = 1\nx" t.bot]
    set origin [hir::get $h [hirFind $h ref x] origin]
    list [hir::exprsAt $h $origin] [hirFind $h ref x]
} -result {e3 e3}

test lower-origins-every-node {every expression, scope and binding from source has a file origin} -body {
    set source [core::ReadFile [file join $::projectRoot examples surface 08-return.bot]]
    set h [surface::compile $source 08-return.bot]
    set missing {}
    dict for {e node} [dict get $h exprs] {
        if {[lindex [dict get $node origin] 0] ne "file"} { lappend missing $e }
    }
    dict for {s scope} [dict get $h scopes] {
        if {[dict get $scope kind] ne "root" && [lindex [dict get $scope origin] 0] ne "file"} { lappend missing $s }
    }
    dict for {b binding} [dict get $h bindings] {
        if {[dict get $binding kind] ne "root" && [lindex [dict get $binding origin] 0] ne "file"} { lappend missing $b }
    }
    set missing
} -result {}

test lower-origins-ir-default {IR-built HIR keeps IR path origins} -body {
    set h [hir::build {{bind x {const 1}}}]
    list [hir::get $h e1 origin] [dict get [hir::scope $h s2] origin] [dict get $h files]
} -result {{ir 0} {ir {}} {}}

# ---------------------------------------------------------------------------
# Semantic errors are HIR's, reported at source positions

foreach {name source code message} {
    duplicate        "x = 1\nx = 2"                       DUPLICATE {t.bot:2:1: duplicate binding "x" in the same lexical scope}
    duplicate-fn     "fn f():\n    1\nfn f():\n    2"    DUPLICATE {t.bot:3:1: duplicate binding "f" in the same lexical scope}
    param-rebind     "fn f(a):\n    a = 1"             DUPLICATE {t.bot:2:5: duplicate binding "a" in the same lexical scope}
    unbound          "y = nope"                         UNBOUND   {t.bot:1:5: unbound name "nope"}
    before-binding   "y = x\nx = 1"                     UNBOUND   {t.bot:1:5: unbound name "x": "x" is declared later; forward references are not allowed (a binding is visible only after it is established)}
    return-outside   "return 1"                         RETURN-OUTSIDE-CALLABLE {t.bot:1:1: return outside callable invocation}
    break-outside    "if true:\n    break"              BREAK-OUTSIDE-LOOP {t.bot:2:5: break outside lexical loop}
    break-in-fn      "loop:\n    fn f():\n        continue\n    break" CONTINUE-OUTSIDE-LOOP {t.bot:3:9: continue outside lexical loop}
} {
    test lower-semantic-$name "semantic error: $name" -body {
        catch {surface::compile $source t.bot} result options
        list [dict get $options -errorcode] $result
    } -result [list [list CORE SEMANTIC $code] $message]
}

test lower-non-strict {with -strict 0 diagnostics stay in the HIR and raise at run time} -body {
    set h [surface::compile "x = 1\nif false:\n    x = 2\n    x = 3\nx" t.bot -strict 0]
    list [lmap d [hir::diagnostics $h] {dict get $d kind}] \
         [core::formatValue [core::evalProgram [hir::lower $h]]] \
         [core::formatValue [core::compiler::evalHir $h]]
} -result {DUPLICATE 1 1}

# ---------------------------------------------------------------------------
# Boolean operators and if values

foreach {name source ir} {
    not-equal   "1 != 2"     {{if {call {ref ==} {const 1} {const 2}} {block {} {ref false}} {block {} {ref true}}}}
    not         "not true"   {{if {ref true} {block {} {ref false}} {block {} {ref true}}}}
    and         "true and false" {{if {ref true} {block {} {if {ref false} {block {} {ref true}} {block {} {ref false}}}} {block {} {ref false}}}}
    or          "true or false"  {{if {ref true} {block {} {ref true}} {block {} {if {ref false} {block {} {ref true}} {block {} {ref false}}}}}}
    if-value    "x = if true:\n    1\nelse:\n    2" {{bind x {if {ref true} {block {} {const 1}} {block {} {const 2}}}}}
    return-if   "fn f():\n    return if true:\n        1" {{bind f {block {} {return {if {ref true} {block {} {const 1}} {block {}}}}}}}
} {
    test lower-rule-$name "lowering rule: $name" -body {
        loweredIR $source
    } -result [canonicalProgram $ir]
}

# PAYLOAD-FREE-BREAK.md: unlike return-if above, "break if ...:" is not a
# lowering rule at all -- it is a syntax error (break never has a value, not
# even an if-valued one), raised by surface::compile itself, not merely by
# surface::parse.
test lower-break-if-value-error {break's own if-value is a syntax error through the whole compile pipeline} -body {
    catch {surface::compile "loop:\n    break if true:\n        1" t.bot} result options
    list [lrange [dict get $options -errorcode] 0 1] $result
} -result {{SURFACE SYNTAX} {t.bot:2:11: "break" does not take a value, found "if"}}

test lower-boolean-values {truth tables and short-circuiting} -body {
    set h [surface::compile "fn t(a, b):\n    \[a and b, a or b, not a, a != b\]\n\[t(true, true), t(true, false), t(false, true), t(false, false)\]" t.bot]
    list [core::formatValue [core::evalProgram [hir::lower $h]]] \
         [core::formatValue [core::compiler::evalHir $h]]
} -result [lrepeat 2 {[[true, true, false, false], [false, true, false, true], [false, true, true, true], [false, false, true, false]]}]

test lower-boolean-short-circuit {the right operand is not evaluated when the left decides} -body {
    # nope is unbound: evaluating it would fail.
    set h [surface::compile "fn f(x):\n    \[x or nope(), not x and nope()\]\nf(true)" t.bot -strict 0]
    core::formatValue [core::evalProgram [hir::lower $h]]
} -result {[true, false]}

test lower-boolean-operands {operands must be Booleans} -body {
    set results {}
    foreach source {"1 and true" "true and 1" "false or 1" "not 1"} {
        catch {core::evalProgram [hir::lower [surface::compile $source t.bot]]} message options
        lappend results [dict get $options -errorcode]
    }
    set results
} -result {{CORE SEMANTIC NOT-BOOLEAN} {CORE SEMANTIC NOT-BOOLEAN} {CORE SEMANTIC NOT-BOOLEAN} {CORE SEMANTIC NOT-BOOLEAN}}

test lower-boolean-types {Boolean operators have type bool} -body {
    set h [surface::compile "fn f(a, b):\n    c = a and b\n    d = not a\n    e = a != b\n    \[c, d, e\]" t.bot]
    lmap name {c d e} {hir::types::show [hir::bindingType $h [hir::lookup $h s3 $name]]}
} -result {bool bool bool}

test lower-if-value-scopes {an if value's branches are inline scopes} -body {
    set h [surface::compile "x = 1\ny = if x == 1:\n    x = 2\n    x\nelse:\n    0\n\[x, y\]" t.bot]
    list [core::formatValue [core::compiler::evalHir $h]] \
         [dict get [hir::scope $h [hir::get $h [hirFind $h if] thenScope]] kind] \
         [hir::types::show [hir::bindingType $h [hir::get $h [lindex [hirFind $h bind y] 0] binding]]]
} -result {{[1, 2]} branch int}

# ---------------------------------------------------------------------------
# Hygiene: names the frontend introduces cannot be shadowed

test lower-hygiene-list {binding list does not change list literals} -body {
    set h [surface::compile "list = 5\n\[1, list\]" t.bot]
    list [core::formatValue [core::evalProgram [hir::lower $h]]] \
         [core::formatValue [core::compiler::evalHir $h]] \
         [canonicalProgram [hir::lower $h]]
} -result {{[1, 5]} {[1, 5]} {{bind list#1 {const 5}} {call {ref list} {const 1} {ref list#1}}}}

test lower-hygiene-nested {a list parameter and a list binding in a branch} -body {
    set h [surface::compile "fn f(list):\n    if true:\n        list = 2\n        \[list\]\n    else:\n        \[list\]\n\[f(1), \[\]\]" t.bot]
    list [core::formatValue [core::evalProgram [hir::lower $h]]] \
         [core::formatValue [core::compiler::evalHir $h]]
} -result {{[[2], []]} {[[2], []]}}

test lower-hygiene-diagnostics {diagnostics keep the source spelling} -body {
    catch {surface::compile "list = 1\nlist = 2\n\[\]" t.bot} message
    set message
} -result {t.bot:2:1: duplicate binding "list" in the same lexical scope}

test lower-hygiene-analysis {hygienic HIR is what analysis of its lowered IR derives} -body {
    set h [surface::compile "list = 5\nfn g():\n    \[list\]\ng()" t.bot]
    expr {[hir::format $h] eq [hir::format [hir::build [hir::lower $h]]]}
} -result 1

# ---------------------------------------------------------------------------
# Node ids in origins

test lower-node-ids {HIR expressions from an AST node carry its id} -body {
    set h [surface::compile "fn add(a, b):\n    a != b\nadd(1, 2)" t.bot]
    list [lmap e [surface::hirExprs $h add()/binary] {hir::kind $h $e}] \
         [lmap e [surface::hirExprs $h add()/binary/op] {hir::kind $h $e}] \
         [lmap e [surface::hirExprs $h add()/block] {hir::kind $h $e}] \
         [dict get [lrange [dict get [hir::binding $h [lindex [hir::get $h [surface::hirExprs $h add()/block] params] 1]] origin] 2 end] node]
} -result {{if call} {ref ref ref} block add()/(b)}

test lower-duplicate-params-located {duplicate parameters are reported at the function} -body {
    catch {surface::compile "x = 1\nfn f(a, b, a):\n    a" t.bot} message options
    list [dict get $options -errorcode] $message
} -result {{CORE SEMANTIC DUPLICATE} {t.bot:2:5: duplicate binding "a" in the same lexical scope (block parameters)}}

test lower-parse-without-analysis {the AST of a semantically invalid program is available} -body {
    set ast [surface::parse "x = 1\nx = 2" t.bot]
    list [llength [dict get $ast body]] \
         [catch {surface::lowerToHir $ast}]
} -result {2 1}

# Method calls (METHOD-SUGAR.md): `receiver.name(args)` lowers to a call of the
# projection `receiver.name` marked `method`; HIR resolution turns it into the
# ordinary call `name(receiver, args)` when `name` is visible, so the HIR (and
# core IR) is exactly the free spelling's.

foreach {name method free} {
    unary       "fn f(a):\n    a\nx = 1\nx.f()"                              "fn f(a):\n    a\nx = 1\nf(x)"
    binary      "fn f(a, b):\n    b\nx = 1\nx.f(2)"                          "fn f(a, b):\n    b\nx = 1\nf(x, 2)"
    chain       "fn f(a, b):\n    b\nx = 1\nx.f(2).f(3).f(4)"                 "fn f(a, b):\n    b\nx = 1\nf(f(f(x, 2), 3), 4)"
    nested      "fn f(a, b):\n    b\nx = 1\nx.f(x.f(2))"                     "fn f(a, b):\n    b\nx = 1\nf(x, f(x, 2))"
    receiver-call "fn f(a, b):\n    b\nf(1, 2).f(3)"                         "fn f(a, b):\n    b\nf(f(1, 2), 3)"
    native      "length = list::length\n\[1, 2\].length()"                    "length = list::length\nlength(\[1, 2\])"
    alias       "fn f(a):\n    a\ng = f\n1.g()"                              "fn f(a):\n    a\ng = f\ng(1)"
    in-function "fn f(a, b):\n    b\nfn h(x):\n    x.f(1)\nh(2)"             "fn f(a, b):\n    b\nfn h(x):\n    f(x, 1)\nh(2)"
    in-branch   "fn f(a):\n    a\nif true:\n    1.f()\nelse:\n    2.f()"     "fn f(a):\n    a\nif true:\n    f(1)\nelse:\n    f(2)"
    in-loop     "fn f(a):\n    a\nloop x in \[1, 2\]:\n    x.f()"            "fn f(a):\n    a\nloop x in \[1, 2\]:\n    f(x)"
    handled     "error E\nfn f(a) errors E:\n    fail E\nr = 1.f():\n    on E:\n        0\nr"  "error E\nfn f(a) errors E:\n    fail E\nr = f(1):\n    on E:\n        0\nr"
} {
    test lower-method-same-hir-$name "method call ($name) has exactly the HIR (and core IR) of the free spelling" -body {
        set m [surface::compile $method t.bot -strict 0]
        set f [surface::compile $free t.bot -strict 0]
        list [expr {[hir::format $m] eq [hir::format $f]}] \
            [expr {[hir::lower $m] eq [hir::lower $f]}] \
            [expr {[lmap d [hir::diagnostics $m] {dict get $d message}] eq [lmap d [hir::diagnostics $f] {dict get $d message}]}]
    } -result {1 1 1}
}

test lower-method-call-node {the lowered syntax of a method call is the call of a projection, marked method} -body {
    set ast [surface::parse "x.f(a, b)" t.bot]
    set node [surface::lower::Node [lindex [dict get $ast body] 0]]
    list [dict get $node kind] [dict get $node method] [dict get $node callee kind] [dict get $node callee name] \
        [dict get $node callee receiver kind] [llength [dict get $node args]]
} -result {call 1 project f ref 2}

test lower-method-call-is-an-ordinary-call-after-resolution {no HIR node of a resolved method call knows the spelling except the call's own diagnostic marker: no project node, the callee is a reference to the function} -body {
    set h [surface::compile "fn f(a, b):\n    b\nx = 1\nx.f(2)" t.bot]
    set call [lindex [hirFind $h call] 0]
    list [llength [hirFind $h project]] [hir::kind $h [hir::get $h $call callee]] \
        [hir::get $h [hir::get $h $call callee] name] \
        [lmap a [hir::get $h $call args] {hir::kind $h $a}] [dict get $h exprs $call method name]
} -result {0 ref f {ref const} f}

test lower-method-call-targets-the-same-callable {the call target (the callable the call is resolved to) is the free call's} -body {
    set m [surface::compile "fn f(a, b):\n    b\nx = 1\nx.f(2)" t.bot]
    set f [surface::compile "fn f(a, b):\n    b\nx = 1\nf(x, 2)" t.bot]
    list [hir::get $m [lindex [hirFind $m call] 0] target] [hir::get $f [lindex [hirFind $f call] 0] target] \
        [hir::get $m [hir::get $m [lindex [hirFind $m call] 0] callee] binding] [hir::get $f [hir::get $f [lindex [hirFind $f call] 0] callee] binding]
} -match glob -result {{block *} {block *} * *}

test lower-method-call-origins {a method call originates at the receiver through the closing parenthesis; the callee reference at the method name; the receiver and each argument at their own text} -body {
    set h [surface::compile "fn f(a, b):\n    b\nx = 1\nx.f(2)" t.bot]
    set call [lindex [hirFind $h call] 0]
    set callee [hir::get $h $call callee]
    lassign [hir::get $h $call args] receiver argument
    list [at [hir::get $h $call origin]] [at [hir::get $h $callee origin]] [at [hir::get $h $receiver origin]] [at [hir::get $h $argument origin]] \
        [dict get [lrange [hir::get $h $callee origin] 2 end] end] [dict get [lrange [hir::get $h $call origin] 2 end] endColumn]
} -result {4:1 4:3 4:1 4:5 27 7}

test lower-method-call-origin-node-ids {origins carry the node ids of the method call and of its parts} -body {
    set h [surface::compile "fn f(a, b):\n    b\nx = 1\nx.f(2)" t.bot]
    set call [lindex [hirFind $h call] 0]
    lmap e [list $call [hir::get $h $call callee] {*}[hir::get $h $call args]] {
        dict get [lrange [hir::get $h $e origin] 2 end] node
    }
} -result {methodcall methodcall/method methodcall/receiver methodcall/arg1}

test lower-method-call-unvisible-keeps-the-field-call {with no function of that name visible the call is the call of a field value, and its callee projection is marked for diagnostics} -body {
    set h [surface::compile "s = {cb: 5, v: 1}\ns.v(1)" t.bot -strict 0]
    set call [lindex [hirFind $h call] 0]
    list [hir::kind $h [hir::get $h $call callee]] [dict exists [dict get $h exprs $call] method] [dict get $h exprs [hir::get $h $call callee] methodCallee]
} -result {project 0 1}

test lower-method-call-visibility-is-lexical {the sugar sees what a reference to the name would: a later binding, a shadowing local, a parameter} -body {
    lmap source {
        "fn f(a):\n    a\nx = 1\nx.f()"
        "x = 1\nx.f()\nfn f(a):\n    a"
        "fn f(a):\n    a\nfn g(f):\n    1.f()\ng(2)"
        "fn f(a):\n    a\nfn g():\n    f = 5\n    1.f()\ng()"
    } {
        set h [surface::compile $source t.bot -strict 0]
        set call [lindex [hirFind $h call] 0]
        list [dict exists [dict get $h exprs $call] method] [hir::kind $h [hir::get $h $call callee]]
    }
} -result {{1 ref} {0 project} {1 ref} {1 ref}}

# ---------------------------------------------------------------------------
# Struct destructuring (STRUCT-DESTRUCTURING.md): `{a, b: c} = e` lowers to a
# hygienic temporary bound to `e`, then ordinary `project` binds in written
# order, then `unit`: the statement's own value (the generated bindings are
# implementation details and none of them is its result). More in
# struct-destructuring.test.

test lower-destructure-is-bind-and-projections {the statements it lowers to: tmp = e, a = tmp.a, c = tmp.b, unit} -body {
    set h [surface::compile "r = \{a: 1, b: 2\}\n\{a, b: c\} = r" t.bot -strict 0]
    lmap e [hir::walk $h] {
        switch -- [hir::kind $h $e] {
            bind    { list bind [regsub {destructure#[0-9]+} [hir::get $h $e name] tmp] }
            project { list project [hir::get $h $e name] }
            ref     { list ref [regsub {destructure#[0-9]+} [hir::get $h $e name] tmp] }
            default { continue }
        }
    }
} -result {{bind r} {bind tmp} {ref r} {bind a} {project a} {ref tmp} {bind c} {project b} {ref tmp} {ref unit}}

test lower-destructure-ends-in-explicit-unit {the last statement a destructure lowers to is the root unit, not the last projection bind} -body {
    set h [surface::compile "r = \{a: 1, b: 2\}\n\{a, b: c\} = r" t.bot -strict 0]
    set last [lindex [hir::walk $h] end]
    list [hir::kind $h $last] [hir::get $h $last name] [string match *destructure/unit* [hir::get $h $last origin]]
} -result {ref unit 1}

test lower-destructure-unit-only-after-the-last-binding {the unit follows the last generated binding and is not repeated per field or per nested level} -body {
    set h [surface::compile "\{u: \{x, y\}, v\} = \{u: \{x: 1, y: 2\}, v: 3\}" t.bot -strict 0]
    set kinds [lmap e [hir::walk $h] {
        if {[hir::kind $h $e] ne "ref" || [hir::get $h $e name] ne "unit"} continue
        set e
    }]
    list [llength $kinds] [expr {[lindex $kinds 0] eq [lindex [hir::walk $h] end]}]
} -result {1 1}

test lower-destructure-same-core-ir-as-explicit {the core IR is the explicit spelling's (ending in the explicit unit), modulo the temporary's name} -body {
    set d [hir::lower [surface::compile "r = \{a: 1, b: 2\}\n\{a, b: c\} = r\n\[a, c\]" t.bot -strict 0]]
    set e [hir::lower [surface::compile "r = \{a: 1, b: 2\}\nt = r\na = t.a\nc = t.b\nunit\n\[a, c\]" t.bot -strict 0]]
    expr {[regsub -all {destructure#[0-9]+} $d t] eq $e}
} -result 1

test lower-destructure-last-statement-core-ir {as the last statement the destructure's core IR ends in the unit, where the old expansion ended in the last projection} -body {
    set d [hir::lower [surface::compile "r = \{a: 1, b: 2\}\n\{a, b: c\} = r" t.bot -strict 0]]
    set e [hir::lower [surface::compile "r = \{a: 1, b: 2\}\nt = r\na = t.a\nc = t.b\nunit" t.bot -strict 0]]
    set old [hir::lower [surface::compile "r = \{a: 1, b: 2\}\nt = r\na = t.a\nc = t.b" t.bot -strict 0]]
    list [expr {[regsub -all {destructure#[0-9]+} $d t] eq $e}] [expr {[regsub -all {destructure#[0-9]+} $d t] ne $old}]
} -result {1 1}

test lower-destructure-origins {a projection originates at its pattern entry, reports the field name read, and its bind originates at the name bound} -body {
    set h [surface::compile "r = \{a: 1, b: 2\}\n\{a, b: c\} = r" t.bot -strict 0]
    set result {}
    foreach e [hir::walk $h] {
        if {[hir::kind $h $e] eq "project"} {
            lappend result [list [hir::get $h $e name] [at [hir::get $h $e origin]] [at [hir::get $h $e nameOrigin]]]
        }
    }
    set result
} -result {{a 2:2 2:2} {b 2:5 2:5}}

cleanupTests
