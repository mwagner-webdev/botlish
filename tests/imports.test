# ABI migration

test imports-abi-types {abi::U8Value is the one type: qualified, imported and in the declaring module} -body {
    list [agree "import abi\nfn f(x: abi::U8Value):\n    x\nf(200)\n"] \
        [agree "import abi\nimport type abi::U8Value\nfn f(x: U8Value) -> abi::U8Value:\n    x\nf(200)\n"] \
        [rejectionKind "import type abi::U8Value\nfn f(x: U8Value):\n    x\nf(300)\n"]
} -match glob -result {200 200 TYPE}

test imports-abi-program-with-own-u8value {a program's own U8Value coexists with abi::U8Value} -body {
    agree "import abi\ntype U8Value = Int in 0..5\nfn f(x: U8Value):\n    x\n\[f(3), abi::u8(200).value\]\n"
} -result {[3, 200]}

test imports-raw-getpid-example {examples/linux/getpid.bot declares its dependencies} -body {
    set text [core::ReadFile [file join $::projectRoot examples linux getpid.bot]]
    list [regexp {(?n)^import abi::x86_64$} $text] [regexp {(?n)^import linux::abi$} $text] [regexp {(?n)^import abi$} $text]
} -result {1 1 0}

# ---------------------------------------------------------------------------
# Loader: cache, graph, cycles, protected intrinsics

test imports-cache-does-not-leak-importer-state {one cached module AST serves two importers with different type imports and method visibility} -body {
    withScratchLibrary {
        writeFixtures $dir
        writeModule $dir shared "import type example_types::Count\nimport leafc\n\nfn id(x: Count):\n    x.deep()\n"
        set a [rejectionKind "import shared\nshared::id(1)\n"]
        # A second importer, with other imports of its own: nothing of the
        # first compilation (its short types, its methods) is visible.
        set b [rejectionKind "import shared\nimport example_types\nx = 1\nx.deep()\n"]
        set c [agree "import shared\nshared::id(1)\n"]
        list $a $b $c
    }
} -result {accepted NOT-A-STRUCT 8}

test imports-dependency-graph {the loader records each file's direct imports} -body {
    withScratchLibrary {
        writeFixtures $dir
        set loaded [surface::modules::LoadNamespaces {midb}]
        dict get $loaded imports
    }
} -result {leafc {namespaces {} types {}} midb {namespaces leafc types {}}}

test imports-cycle {a cycle through imports is the existing CYCLE diagnostic} -body {
    withScratchLibrary {
        writeModule $dir cyca "import cycb\n\nfn f(x):\n    cycb::g(x)\n"
        writeModule $dir cycb "import cyca\n\nfn g(x):\n    cyca::f(x)\n"
        rejection "import cyca\n1\n"
    }
} -match glob -result {CYCLE: FILE: module dependency cycle: cyca -> cycb -> cyca}

test imports-protected-intrinsic-needs-no-import-and-grants-no-authority {importing list does not let a module define list::at} -body {
    withScratchLibrary {
        writeModule $dir list "fn at(xs, i):\n    0\n"
        rejectionKind "import list\n1\n"
    }
} -result DUPLICATE-NATIVE

test imports-entry-program-defines-what-a-module-could-not {an entry program is in no namespace: it may define at (a module list.bot may not), and `namespace` declarations do not exist} -body {
    list [agree "import str\n\nfn at(xs, i):\n    0\n\[at(\[1\], 0)\]\n"] \
        [rejectionKind "namespace list\n\nfn at(xs, i):\n    0\n"]
} -result {{[0]} SYNTAX}

# ---------------------------------------------------------------------------
# Programs

test imports-entry-program-programs-run {an entry program with imports runs on every backend} -body {
    agree "import str\nimport list\ntext = str::concat(\"a\", \"b\")\nvalue = list::at(\[1, 2\], 0):\n    on IndexNotFound:\n        0\n\[text, value\]\n"
} -result {["ab", 1]}

test imports-surface-compile-text {surface::compile of program text applies the same rules (imports validated, modules loaded)} -body {
    list [catch {surface::compile "list::length(\[1\])\n" t.bot} m] \
        [core::formatValue [core::evalProgram [hir::lower [surface::compile "import list\nlist::get(\[1\], 0, 0)\n" t.bot]]]]
} -result {1 1}

cleanupTests
