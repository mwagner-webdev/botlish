# Nested collections (items 25-28, 36-39)

test ma-nested-affine {items 25, 27, 38, 39: MutableArray[MutableVector[Coroutine]] and MutableVector[MutableArray[Coroutine]] are affine by composition; their factories, pops, swaps and consuming loops move whole collections; every coroutine is released once (an array right after its last use, a consumed one per iteration) on every backend and under GC stress} -constraints linuxX86_64 -body {
    set text "${maDecls}fn pair(i: int) -> MutableVector\[Coroutine{args: \[Command\], return: Event}\]:
    mutable_vector::from_list(\[make(i), make(i + 10)\])
fn f() -> List\[int\] errors IndexNotFound:
    a = mutable_array::generate(2, pair)
    v = mutable_vector::from_list(\[mutable_array::generate(2, make)\])
    w = v.pop()
    old = a.swap(0, mutable_vector::from_list(\[make(50)\]))
    xs = loop q in old:
        q(Command {value: 1}).value
    ys = loop q in w:
        q(Command {value: 2}).value
    list::append(xs, list::length(ys))
r = f():
    on IndexNotFound:
        \[\]
r
"
    set hir [surface::compile $text -warnings off]
    list [maReleases $text] [maReleases $text compile] [maNativeReleases $text] [withGcStress {maNativeReleases $text}] \
        [hir::types::Affinity [maBindingType $hir a]] [hir::types::Affinity [maBindingType $hir v]]
} -cleanup {unset -nocomplain text hir} -result {{{value {[1, 11, 2]}} 7 1 {7 3 4 1 2 5 6}} {{value {[1, 11, 2]}} 7 1 {7 3 4 1 2 5 6}} {7 0} {7 0} affine affine}

# ---------------------------------------------------------------------------
# Evidence: copy-on-write counters, HIR, native code (items 43, 50, 51)

test ma-cow-counters {item 50: a copy is O(1) -- one share whatever the length -- the first write after it detaches once, copying the elements, and later writes to the now unique backing never detach again (native counters); the Tcl runtime counts one array and one logical copy} -constraints linuxX86_64 -body {
    lmap n {10 1000} {
        set text "import mutable_array\nfn f() -> int errors IndexNotFound:\n    a = mutable_array::create($n, 0)\n    b = a\n    b.set(0, 1)\n    b.set(1, 2)\n    b.set(2, 3)\n    a.at(0) + b.at(0)\nr = f():\n    on IndexNotFound:\n        0\nr\n"
        core::mutarray::resetCounters
        outcomeUnderHir interp [surface::compile $text -warnings off]
        list [lindex [maNative $text] 1] [core::mutarray::counters]
    }
} -cleanup {unset -nocomplain n text} -result {{{shares 1 detaches 1 detachElements 10} {created 1 shares 1}} {{shares 1 detaches 1 detachElements 1000} {created 1 shares 1}}}

set maEvidence "${maDecls}fn affine() -> int errors IndexNotFound:
    a = mutable_array::generate(2, make)
    old = a.swap(0, make(5))
    n = a.capacity()
    xs = loop w in a:
        w(Command {value: 1}).value
    n
fn copies() -> int errors IndexNotFound:
    a = mutable_array::create(3, 0)
    b = a
    b.set(0, 9)
    b.set(1, 8)
    v = mutable_vector::from_list(\[a\])
    c = v.at(0)
    c.at(0) + b.at(0)
a = affine():
    on IndexNotFound:
        0
c = copies():
    on IndexNotFound:
        0
\[a, c\]
"

test ma-hir-evidence {item 43: in HIR, an affine generate and swap are the dropping forms carrying the element's drop descriptor (`c`), the loop over the affine array is consuming, the unrestricted copy is one mutable_vector#share of descriptor `h`, mutations name their place, and an exit's releases are recorded} -body {
    set hir [surface::compile [string map [list "import list\n" ""] $::maEvidence] -warnings off]
    set flags {}
    foreach line [split [hir::format $hir] \n] {
        foreach pattern {{call native\(mutable_array::[a-z?_]+\)} {call native\(mutable_array#[a-z_]+\)} {call native\(mutable_vector#[a-z_]+\)} {place=[b0-9.a-z]+} {listloop s[0-9]+ \([^)]*\) : \S+ consuming} {const str h\M} {const str c\M} {release=[^ ]+}} {
            if {[regexp $pattern $line match]} {
                lappend flags [regsub -all {b[0-9]+} [regsub {s[0-9]+} $match {S}] B]
            }
        }
    }
    lsort -unique $flags
} -cleanup {unset -nocomplain hir flags line pattern match} -result {{call native(mutable_array#generate_drop)} {call native(mutable_array#swap_drop)} {call native(mutable_array::at)} {call native(mutable_array::capacity)} {call native(mutable_array::create)} {call native(mutable_array::set)} {call native(mutable_vector#share)} {const str c} {const str h} {listloop S (B w) : List[int] consuming} place=B release=B release=IndexNotFound=B}

test ma-native-evidence {item 51: natively an affine generate, swap and consuming loop are single runtime operations on the header register (mutarraygeneratedrop, mutarrayswapdrop, mutarraytakefront), the displaced element a corelease and the array's death one affinedrop by `ac`; an unrestricted copy is one mvshare whose first write detaches inside mutarrayset; a vector element read only for reading is not copied; no ownership object exists} -constraints linuxX86_64 -body {
    set nir [maNir $::maEvidence]
    list [maOps [maFunc $nir affine]] [lsearch -all -inline -regexp [maFunc $nir affine] {str "a}] [maOps [maFunc $nir copies]] [maAgree $::maEvidence]
} -cleanup {unset -nocomplain nir} -result {{mutarraygeneratedrop call mutarrayswapdrop affinedrop corelease mutarraycapacity listnew mutarrayempty mutarraytakefront structnew coresume corelease} {{%13 = str "ac"}} {mutarraycreate mvshare mutarraysetproven mutarraysetproven listnew mvfromlist mvat mutarrayget mutarraygetproven iadd} {value {[2, 9]}}}


cleanupTests
