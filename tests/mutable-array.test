# Factory construction (items 16-20, 27-30, 64)

test ma-generate-failure {items 17, 18, 30: a factory failing at slot 2 leaves no array: the two coroutines it already made are released, first to last, and its declared error propagates to the caller's handler -- on both Tcl backends, natively and under GC stress; an unhandled factory error is the caller's UNHANDLED-ERROR} -body {
    set text "${maDecls}fn make_until(i: int) -> Coroutine{args: \[Command\], return: Event} errors Boom:\n    if i == 2:\n        fail Boom\n    make(i)\nfn f() -> int errors Boom:\n    a = mutable_array::generate(4, make_until)\n    mutable_array::capacity(a)\nr = f():\n    on Boom:\n        -1\nr\n"
    list [maReleases $text] [maReleases $text compile] [maNativeReleases $text] [withGcStress {maNativeReleases $text}] \
        [maCode "${maDecls}fn make_until(i: int) -> Coroutine{args: \[Command\], return: Event} errors Boom:\n    if i == 2:\n        fail Boom\n    make(i)\nfn f() -> int:\n    a = mutable_array::generate(4, make_until)\n    mutable_array::capacity(a)\nf()\n"]
} -constraints linuxX86_64 -cleanup {unset -nocomplain text} -result {{{value -1} 2 1 {1 2}} {{value -1} 2 1 {1 2}} {2 0} {2 0} UNHANDLED-ERROR}

test ma-generate-contract {item 19: a factory is an ordinary callable of the existing contract model, called with each slot's Int index: a narrower parameter (a refinement), a second parameter or a coroutine handle (whose contract takes its resume message) is TYPE} -body {
    list [maCode "${maDecls}type Small = Int in 0..3\nfn mk(i: Small) -> int:\n    i\na = mutable_array::generate(5, mk)\n0\n"] \
        [string match {the factory of mutable_array::generate is called with one Int argument (each slot's index, 0 to the count - 1), but its contract is block(e*)/1 -> int (contract Fn{args: \[int\[Small\]\], return: int, errors: \[\]})} \
            [maMessage "${maDecls}type Small = Int in 0..3\nfn mk(i: Small) -> int:\n    i\na = mutable_array::generate(5, mk)\n0\n"]] \
        [maCode "${maDecls}fn mk(i: int, j: int) -> int:\n    i\na = mutable_array::generate(5, mk)\n0\n"] \
        [maCode "${maDecls}fn f() -> int:\n    c = make(1)\n    a = mutable_array::generate(2, c)\n    1\nf()\n"]
} -result {TYPE 1 TYPE TYPE}

test ma-duplication-generic {items 14, 15, 22: create repeats its value, so an affine value is rejected wherever it reaches create -- an affine struct, a vector of coroutines, and through a user's generic or typed wrapper (its semantic instance or its own body), never by name} -body {
    list [maCode "${maDecls}struct Job:\n    step: Coroutine{args: \[Command\], return: Event}\nfn f() -> int:\n    a = mutable_array::create(2, Job {step: make(1)})\n    1\nf()\n"] \
        [maCode "${maDecls}fn f() -> int:\n    a = mutable_array::create(2, mutable_vector::from_list(\[make(1)\]))\n    1\nf()\n"] \
        [maCode "${maDecls}fn dup(x):\n    mutable_array::create(2, x)\nfn f() -> int:\n    a = dup(make(1))\n    1\nf()\n"] \
        [maCode "${maDecls}fn dup(x: Coroutine{args: \[Command\], return: Event}) -> MutableArray\[Coroutine{args: \[Command\], return: Event}\]:\n    mutable_array::create(2, x)\n1\n"] \
        [maCode "${maDecls}fn dup(x):\n    mutable_array::create(2, x)\nfn f() -> int errors IndexNotFound:\n    a = dup(5)\n    a.at(1)\nr = f():\n    on IndexNotFound:\n        0\nr\n"]
} -result {AFFINE-DUPLICATION-UNSUPPORTED AFFINE-DUPLICATION-UNSUPPORTED AFFINE-DUPLICATION-UNSUPPORTED AFFINE-DUPLICATION-UNSUPPORTED ok}

test ma-roles-audit {items 21, 23, 31-34, 53, 54: every collection primitive's ownership roles are registration metadata (core/native.tcl's -ownership), the one thing the ownership discipline reads: repeat for create's value, factory for generate's, move for what an operation stores, place for a receiver mutated in place, copy-out for a container read while it keeps its elements, equality for a set's members (byte stores take only Bytes: the default)} -body {
    set rows {}
    foreach n [lsort [core::native::names]] {
        if {![regexp {^(mutable_array|mutable_vector|list|immutable_set)(::|#)|^list$} $n]} continue
        lappend rows [list $n [dict get [core::native::metadata $n] ownership]]
    }
    set rows
} -cleanup {unset -nocomplain rows n} -result {{immutable_set::contains {equality equality}} {immutable_set::from_list equality} {list element} {list::append {copy-out copy-out}} {list::at {copy-out observe}} {list::length observe} {mutable_array#consume move} {mutable_array#generate_drop {observe factory observe}} {mutable_array#set_drop {place observe move observe}} {mutable_array#swap_drop {place observe move observe}} {mutable_array#take_front place} {mutable_array#to_list copy-out} {mutable_array::allocate observe} {mutable_array::at {copy-out observe}} {mutable_array::capacity observe} {mutable_array::copy {place observe copy-out observe observe}} {mutable_array::create {observe repeat}} {mutable_array::freeze {copy-out observe}} {mutable_array::from_list move} {mutable_array::generate {observe factory}} {mutable_array::set {place observe move}} {mutable_array::swap {place observe move}} {mutable_vector#clear_drop {place observe}} {mutable_vector#consume move} {mutable_vector#share {}} {mutable_vector#swap_drop {place observe move observe}} {mutable_vector#take_front place} {mutable_vector#to_list copy-out} {mutable_vector::at {copy-out observe}} {mutable_vector::clear place} {mutable_vector::empty? observe} {mutable_vector::from_list move} {mutable_vector::length observe} {mutable_vector::pop place} {mutable_vector::push {place move}} {mutable_vector::swap {place observe move}} {mutable_vector::take {place observe}}}

test ma-equality {item 41: == of two arrays is the EQUALITY error it always was (no identity or backing leaks into equality); of affine arrays, AFFINE-EQUALITY-UNSUPPORTED} -body {
    list [lrange [maAgree "import mutable_array\na = mutable_array::create(2, 0)\nb = a\na == b\n"] 0 1] \
        [maCode "${maDecls}fn f() -> bool:\n    a = mutable_array::generate(1, make)\n    b = mutable_array::generate(1, make)\n    a == b\nf()\n"]
} -result {{error {CORE SEMANTIC EQUALITY}} AFFINE-EQUALITY-UNSUPPORTED}

