# cbx.bot -- the binding of tests/cffi/callback-fixture.c (tests/c-callbacks.test,
# bench/c-callbacks.tcl; C-CALLBACK-MILESTONE-1.md). A test copies it beside
# its program as the application module `cbx`.
#
# Every function pointer parameter C calls during the call and keeps no
# longer is declared noescape: those are the calls during which C may call
# back (every call of one is a foreign transition). `store` keeps its
# pointer (`captures`): a retaining C call, which only a direct module may
# make (hir/direct.tcl), and whose pointer C may call later only to have
# the runtime refuse it.
import std::ffi::c

extern c library "botlish_callback_fixture"

extern c fn apply named "cbx_apply"(f: std::ffi::c::FnPtr[Fn{args: [std::ffi::c::Int], return: std::ffi::c::Int}] noescape, x: std::ffi::c::Int) -> std::ffi::c::Int
