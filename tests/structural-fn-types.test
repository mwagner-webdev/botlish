[list::all?(["a", "_"], choose(true)), list::all?(["a", "_"], choose(false))]} "# lib/list.bot declares its own NotFound\n"
} -result {[false, true]}

test fn-accept-cross-module {a module function may declare an Fn parameter; another file passes it a local Block and a native, and the module's own call through it is checked and runs on every backend} -body {
    set libPath [file join $::core::libraryDir fntypeslib.bot]
