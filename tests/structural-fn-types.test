    fconfigure $ch -encoding utf-8
    puts $ch {namespace fntypeslib

fn count_where(xs: List[str], keep: Fn{args: [str], return: bool}) -> int:
    kept = loop x in xs:
        if not keep(x):
            continue
        x
    list_length(kept)
}
    close $ch
    try {
        fnRun {fn vowel?(c):
    c == "a" or c == "e"
[fntypeslib::count_where(["a", "b", "e"], vowel?), fntypeslib::count_where(["a", "1", "-"], is_tcl_alnum)]} "\n"
    } finally {
        file delete $libPath
    }
} -result {[2, 2]}

# ---------------------------------------------------------------------------
# Surface rejection (spec items 44, 78, 81)

test fn-reject-arity {a callable of the wrong arity does not satisfy an Fn parameter, and the diagnostic says so} -body {
    fnRejects "$::applyStr
fn two(a, b):
    true
apply(two, \"a\")" {*cannot be proven to satisfy Fn\{args: \[str\]*arity mismatch: the callable takes 2 argument(s), the function type 1*}
} -result {{CORE SEMANTIC TYPE} 1}

test fn-reject-argument-too-narrow {a callable whose parameter is narrower than the contract's argument type is rejected at the argument position} -body {
    fnRejects {fn apply(f: Fn{args: [int], return: int}):
    f(1000)
fn take_byte(x: Byte) -> int:
    x
apply(take_byte)} {*argument 1 is incompatible: the callable's parameter requires int\[Byte\], but callers of the function type may pass any int*}
} -result {{CORE SEMANTIC TYPE} 1}

test fn-reject-return-too-broad {a callable returning a wider type than the contract promises is rejected as a return incompatibility} -body {
    fnRejects "$::applyStr
fn ident(x):
    x
apply(ident, \"a\")" {*return incompatible: the callable returns any, not usable as bool*}
} -result {{CORE SEMANTIC TYPE} 1}

test fn-reject-extra-error {a callable that may raise an error the contract does not allow is rejected, naming the extra error} -body {
    fnRejects {fn apply(f: Fn{args: [str], return: int, errors: [NotFound]}) -> int:
    f("a"):
        on NotFound:
            0
fn find(x) -> int errors NotFound, PermissionDenied:
    if x == "a":
        fail PermissionDenied
    1
apply(find)} {*error set incompatible: the callable may raise PermissionDenied, but the function type allows only \[NotFound\]*}
} -result {{CORE SEMANTIC TYPE} 1}

test fn-reject-non-callable {a non-callable value does not satisfy an Fn parameter} -body {
    fnRejects "$::applyStr
apply(5, \"a\")" {*a value of type int is not known to be callable*}
} -result {{CORE SEMANTIC TYPE} 1}

test fn-reject-any-is-not-fn {an unknown (any) value is not a known callable: passing it where an Fn is required is rejected, never checked at run time} -body {
    # An element of a heterogeneous List: any, and not a parameter whose
    # own body could infer a contract (fn-accept-untyped-forwarder).
    fnRejects "$::applyStr
fn pass(gs):
    apply(list_get(gs, 0), \"a\")
pass(\[is_tcl_alpha, 1\])" {*a value of type any is not known to be callable*}
} -result {{CORE SEMANTIC TYPE} 1}

test fn-accept-untyped-forwarder {an untyped parameter passed where an Fn is declared infers that Fn as its own trusted contract (INTRINSIC-FUNCTION-CONTRACT-INFERENCE.md): the forwarder is valid, and its callers are held to the contract -- it used to be rejected as "any is not known to be callable"} -body {
    list [fnRun "$::applyStr
fn pass(g):
    apply(g, \"a\")
pass(is_tcl_alpha)"] [fnRejects "$::applyStr
fn pass(g):
    apply(g, \"a\")
pass(1)" {*argument for parameter "g" cannot be proven to satisfy Fn\{args: \[str\], return: bool, errors: \[\]\}, the parameter type inferred from the function body*}]
} -result {true {{CORE SEMANTIC TYPE} 1}}

test fn-reject-call-argument {a call through an Fn is held to the contract's argument types (no runtime check)} -body {
    fnRejects {fn apply(f: Fn{args: [Byte], return: int}) -> int:
    f(9999)
1} {*argument 1 cannot be proven to satisfy int\[Byte\], the parameter type the callee's function type Fn\{args: \[int\[Byte\]\]*}
} -result {{CORE SEMANTIC TYPE} 1}

test fn-reject-call-arity {a call through an Fn with the wrong number of arguments is rejected statically} -body {
    fnRejects "$::applyStr
fn bad(f: Fn{args: \[str\], return: bool}):
    f(\"a\", \"b\")
1" {*passes 2 argument(s) to a callable of function type Fn\{args: \[str\]*whose contract takes 1*}
} -result {{CORE SEMANTIC TYPE} 1}

test fn-reject-incompatible-join-falls-back {joining callables with no common contract never produces an unsound Fn: different arity falls back to the bare kind (untyped: still callable dynamically), and incompatible typed contracts are rejected at the join as an erasure} -body {
    set hir [fnCompile {fn one(a):
    1
fn two(a, b):
    2
fn choose(c):
    if c:
        one
    else:
        two
choose(true)(5)}]
    list [hir::types::show [hir::typeOf $hir [fnIfIn $hir choose]]] \
        [fnRejects {fn take_byte(x: Byte) -> int:
    x
fn take_str(x: str) -> str:
    x
fn choose(c):
    if c:
        take_byte
    else:
        take_str
choose(true)} {*typed parameter requirements that cannot be preserved*}]
} -result {block {{CORE SEMANTIC TYPE} 1}}

# ---------------------------------------------------------------------------
# Error contracts (spec items 6-8, 35-36, 67, 79-80, 102)
#
# No registered native declares an error set (hir::types::structuralOf:
# natives never do), so native error-set coverage below uses empty-error
# natives only (spec item 80).

test fn-errors-impl-none-declared-a {an implementation that emits no error may declare [A]: a declared set is an upper bound} -body {
    fnRun {fn f(x) -> int errors NotFound:
    1
f(1):
    on NotFound:
        0}
} -result 1

test fn-errors-impl-a-declared-ab {an implementation that emits [A] may declare [A, B]} -body {
    fnRun {fn f(x) -> int errors NotFound, PermissionDenied:
    if x == 1:
        fail NotFound
    2
fn g(x) -> int:
    r = f(x):
        on NotFound:
            0
        on PermissionDenied:
            -1
    r
[g(1), g(2)]}
} -result {[0, 2]}

test fn-errors-impl-ab-declared-a {an implementation that may emit [A, B] declaring only [A] is a compile-time error} -body {
    fnRejects {fn f(x) -> int errors NotFound:
    if x == 1:
        fail NotFound
    if x == 2:
        fail PermissionDenied
    2
f(3):
    on NotFound:
        0} {*"fail PermissionDenied" is not admitted here*}
} -result {{CORE SEMANTIC UNHANDLED-ERROR} 1}

test fn-errors-narrower-satisfies-wider {a callable declaring fewer errors satisfies a contract allowing more, and the error propagates through the structural call on every backend} -body {
    fnRun {fn apply(f: Fn{args: [str], return: int, errors: [NotFound, PermissionDenied]}, v: str) -> int:
    f(v):
        on NotFound:
            0
        on PermissionDenied:
            -1
fn find(x) -> int errors NotFound:
    if x == "a":
        fail NotFound
    1
[apply(find, "a"), apply(find, "b")]}
} -result {[0, 1]}

test fn-errors-wider-rejected {a callable declaring more errors than the contract allows is rejected} -body {
    fnRejects {fn apply(f: Fn{args: [str], return: int}) -> int:
    f("a")
fn find(x) -> int errors NotFound:
    1
apply(find)} {*error set incompatible: the callable may raise NotFound, but the function type allows only \[\]*}
} -result {{CORE SEMANTIC TYPE} 1}

test fn-errors-structural-call-propagates {a call through an Fn exposes its declared errors to static error analysis: unhandled and undeclared is rejected} -body {
    fnRejects {fn apply(f: Fn{args: [str], return: int, errors: [NotFound]}) -> int:
    f("a")
1} {*through a callable of function type Fn{args: \[str\], return: int, errors: \[NotFound\]} may produce the declared error "NotFound"*}
} -result {{CORE SEMANTIC UNHANDLED-ERROR} 1}

test fn-errors-structural-call-declared {an enclosing errors declaration admits a structural call's errors, which then propagate to an exact caller's handler at run time on every backend} -body {
    fnRun {fn apply(f: Fn{args: [str], return: int, errors: [NotFound]}) -> int errors NotFound:
    f("a")
fn find(x) -> int errors NotFound:
    if x == "a":
        fail NotFound
    1
apply(find):
    on NotFound:
        42}
} -result 42

test fn-errors-join-union {joining two compatible callables unions their declared errors; the joined call must account for both} -body {
    set src {fn a(x) -> int errors NotFound:
    1
fn b(x) -> int errors PermissionDenied:
    2
fn choose(c):
    if c:
        a
    else:
        b
choose(true)(0):
    on NotFound:
        -1
    on PermissionDenied:
        -2}
    set hir [fnCompile $src]
    list [hir::types::show [hir::typeOf $hir [fnIfIn $hir choose]]] [fnRun $src] \
        [fnRejects {fn a(x) -> int errors NotFound:
    1
fn b(x) -> int errors PermissionDenied:
    2
fn choose(c):
    if c:
        a
    else:
        b
choose(true)(0):
    on NotFound:
        -1} {*may produce the declared error "PermissionDenied"*}]
} -result {{Fn{args: [any], return: int, errors: [NotFound, PermissionDenied]}} 1 {{CORE SEMANTIC UNHANDLED-ERROR} 1}}

test fn-errors-exact-call-keeps-narrower-set {an exact callable keeps its own narrower declared error set wherever it is still exact, even though it also crosses a boundary expecting a wider contract: its direct call needs to handle only NotFound, never PermissionDenied} -body {
    fnRun {fn find(x) -> int errors NotFound:
    if x == "a":
        fail NotFound
    1
fn apply(f: Fn{args: [str], return: int, errors: [NotFound, PermissionDenied]}) -> int:
    f("b"):
        on NotFound:
            0
        on PermissionDenied:
            -1
direct = find("a"):
    on NotFound:
        0
[apply(find), direct]}
} -result {[1, 0]}

# ---------------------------------------------------------------------------
# Typed-callable escape audit (TYPED-CALLABLE-ESCAPE-SOUNDNESS.md) with Fn

test fn-escape-declared-param-erased {a declared Fn parameter carrying a typed contract passed on to an untyped parameter: the semantic instance of the helper seeds that parameter with the full Fn contract (OPPORTUNISTIC-SEMANTIC-INSTANCES.md), so the unsafe argument is rejected by the contract itself at the call} -body {
    fnRejects {fn take_byte(x: Byte) -> int:
    x
fn apply(f: Fn{args: [Byte], return: int}):
    fn inner(g, v):
        g(v)
    inner(f, 9999)
apply(take_byte)} {*call to inner with g : Fn\{args: \[int\[Byte\]\]*v : int is invalid: argument 1 cannot be proven to satisfy int\[Byte\]*}
} -result {{CORE SEMANTIC TYPE} 1}

test fn-escape-typed-list {a List of typed callables is List[Fn{args: [Byte], ...}]: callable through its elements with checked arguments; through an untyped parameter the helper's semantic instance keeps that element contract, so an unsafe call inside it is rejected at the call} -body {
    list [fnRun {fn a(x: Byte) -> int:
    x
fn b(x: Byte) -> int:
    x + 1
fs = [a, b]
loop f in fs:
    f(3)}] [fnRejects {fn a(x: Byte) -> int:
    x
fn b(x: Byte) -> int:
    x + 1
fn sneak(xs):
    loop f in xs:
        f(9999)
sneak([a, b])} {*call to sneak with xs : List\[Fn\{args: \[int\[Byte\]\]*is invalid: argument 1 cannot be proven to satisfy int\[Byte\]*}]
} -result {{[3, 4]} {{CORE SEMANTIC TYPE} 1}}

test fn-escape-returning-loop-element {a returning loop's collected element is a join too: collecting typed callables keeps their contract, but collecting them into a List whose element type the aggregate depth bound cuts is rejected as an erasure} -body {
    list [fnRun {fn tb(x: Byte) -> int:
    x
ys = loop x in [1, 2]:
    tb
loop f in ys:
    f(7)}] [fnRejects {fn tb(x: Byte) -> int:
    x
nested = [[[tb]]]
ys = loop x in [1]:
    nested
list_get(list_get(list_get(list_get(ys, 0), 0), 0), 0)(9999)} {*cannot be preserved as a returning loop's collected element*}]
} -result {{[7, 7]} {{CORE SEMANTIC TYPE} 1}}

test fn-escape-returned-typed-callable {a callable that returns a typed callable is itself precondition-bearing: erasing it would let the returned callable be called unchecked (previously accepted, then ran take_byte(9999))} -body {
    fnRejects {fn take_byte(x: Byte) -> int:
    x
fn chooser():
    take_byte
fn apply(f):
    g = f()
    g(9999)
apply(chooser)} {*"chooser" has typed parameter requirements that cannot be preserved*}
} -result {{CORE SEMANTIC TYPE} 1}

test fn-escape-declared-result-must-preserve {a declared Fn result type must keep the returned callable's own obligations} -body {
    fnRejects {fn take_byte(x: Byte) -> int:
    x
fn chooser():
    take_byte
fn wrap() -> Fn{args: [], return: any}:
    chooser
1} {*declared result type Fn{args: \[\], return: any, errors: \[\]} would erase*}
} -result {{CORE SEMANTIC TYPE} 1}

# ---------------------------------------------------------------------------
# Specialization keys (spec items 60-62, 101)

# EXACT-CALLABLE-CLOSED-CALLER.md: two different code targets no longer share
# one specialization (that sharing was the erasure the milestone repairs),
# until the exact-target budget is spent -- then they share the kind-only
# key again. The contract never selects an instance either way.
test fn-specialization-shared-instance {two different code targets of the same kind get one specialization each (exact keys); once the exact-target budget is spent they share the kind-only key} -body {
    set text "$::applyStr
fn a?(c):
    c == \"a\"
fn b?(c):
    c == \"b\"
\[apply(a?, \"a\"), apply(b?, \"a\")\]"
    set labels {}
    foreach limit {4 1} {
        set hir [fnCompile $text]
        set spec [hir::specialize::analyze $hir -exact-callable-limit $limit]
        lappend labels [lsort [lmap id [dict get $spec used] {
            set label [hir::specialize::label $spec $id]
            if {![string match apply<* $label]} continue
            regsub {e\d+} $label eN
        }]]
    }
    set labels
} -result {{{apply<block(eN), str>} {apply<block(eN), str>}} {{apply<block(eN), str>} {apply<block, str>}}}

# ---------------------------------------------------------------------------
# HIR text round trip (spec item 89)

test fn-hir-text-roundtrip {HIR text with Fn parameter/result types and typed blocks reads back to the same text and the same canonical types} -body {
    set hir [fnCompile {fn apply(f: Fn{args: [Byte, str], return: int, errors: [NotFound]}, b: Byte) -> int errors NotFound:
    f(b, "x")
fn g(x: Byte, s) -> int errors NotFound:
    if x == 0:
        fail NotFound
    x
fn pick(c) -> Fn{args: [Byte, str], return: int, errors: [NotFound]}:
    g
apply(g, 3):
    on NotFound:
        0}]
    set text [hir::format $hir]
    set back [hir::parse $text]
    set same 1
    foreach b [dict keys [dict get $hir bindings]] {
        if {![dict exists $back bindings $b] || [dict get $hir bindings $b kind] ne "local"} continue
        if {[hir::bindingType $hir $b] ne [hir::bindingType $back $b]} { set same 0 }
    }
    list [expr {[hir::format $back] eq $text}] $same [core::formatValue [core::compiler::evalHir $back]]
} -result {1 1 3}

# ---------------------------------------------------------------------------
# Higher-order dogfooding benchmarks (spec items 51-54, 74-76)

proc fnBench {name} {
    return [surface::readProgramFile [file join $::projectRoot bench $name.bot]]
}

test fn-dogfood-source-checks {source-checks.bot: the checks List is List[Fn...] and its loop element is that Fn; check(c) is still an indirect call} -body {
    set hir [fnBench source-checks]
    set call [lindex [hirFind $hir call] [lsearch -exact [lmap e [hirFind $hir call] {
        expr {[hir::kind $hir [hir::get $hir $e callee]] eq "ref" && [hir::get $hir [hir::get $hir $e callee] name] eq "check"}
    }] 1]]
    list [fnBindingType $hir checks] [hir::types::show [hir::typeOf $hir [hir::get $hir $call callee]]] \
         [hir::get $hir $call target]
} -result {{List[Fn{args: [any], return: bool, errors: []}]} {Fn{args: [any], return: bool, errors: []}} {}}

test fn-dogfood-lex-strategy {lex-strategy.bot: choose_classifier's if is a structural Fn, not any; classifier keeps it; classifier(c) is still an indirect call} -body {
    set hir [fnBench lex-strategy]
    set if [fnIfIn $hir choose_classifier]
    set call [lindex [hirFind $hir call] [lsearch -exact [lmap e [hirFind $hir call] {
        expr {[hir::kind $hir [hir::get $hir $e callee]] eq "ref" && [hir::get $hir [hir::get $hir $e callee] name] eq "classifier"}
    }] 1]]
    list [hir::types::show [hir::typeOf $hir $if]] [fnBindingType $hir classifier] [hir::get $hir $call target]
} -result {{Fn{args: [any], return: bool, errors: []}} {Fn{args: [any], return: bool, errors: []}} {}}

test fn-dogfood-test-selection {test-selection.bot: the factory-returned changed? stays an exact Block through binding and direct call (callenv), never widened to Fn} -body {
    set hir [fnBench test-selection]
    set exact [fnBindingType $hir changed_a?]
    set call [lindex [hirFind $hir call] [lsearch -exact [lmap e [hirFind $hir call] {
        expr {[hir::kind $hir [hir::get $hir $e callee]] eq "ref" && [hir::get $hir [hir::get $hir $e callee] name] eq "changed_a?"}
    }] 1]]
    set nir [native::nir $hir]
    list [string match {block(e*)/1 -> bool} $exact] [lindex [hir::get $hir $call target] 0] \
         [regexp "= callenv \[^\n\]*@$call\n" $nir]
} -result {1 block 1}

cleanupTests
