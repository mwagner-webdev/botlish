# scalarbits.test -- the generic bitwise Int primitives (core/scalarbits.tcl)
# on interp/compile (core IR level; native/cross-file byte::/nibble
# integration is tests/native-byte.test).
#
# Byte/Nibble/LowNibble/HighNibble checked construction and predicates used
# to be tested here directly against raw core IR ({ref Byte}, ...), because
# core/scalarbits.tcl registered them as root natives at Tcl-source-load
# time. They are ordinary Botlish source declarations in lib/byte.bot now
# (see SOURCE-DEFINED-INTEGER-DOMAINS.md): a raw core-IR program that never
# loads byte.bot has no "Byte" at all any more (item 87's own documented
# limitation -- byte.bot is not a prelude). Those tests moved to
# tests/native-byte.test (byte.bot loaded the ordinary way, through the
# module system) and tests/source-types.test (the *generic* declaration
# feature, tested with its own synthetic types, independent of Byte).

source [file join [file dirname [file normalize [info script]]] helpers.tcl]

# ---------------------------------------------------------------------------
# Bitwise primitives: total (AND/OR/XOR), checked (shift amount).

test scalarbits-bitand-1 {AND masks to the mask's own bits} -body {
    list [run {call {ref bit_and} {const 171} {const 240}}] \
         [run {call {ref bit_and} {const 171} {const 15}}]
} -result {160 11}

test scalarbits-bitor-1 {basic OR} -body {
    run {call {ref bit_or} {const 5} {const 8}}
} -result 13

test scalarbits-bitxor-1 {basic XOR} -body {
    run {call {ref bit_xor} {const 255} {const 15}}
} -result 240

test scalarbits-bitand-negative {AND is well-defined (two's complement) for negative operands} -body {
    list [run {call {ref bit_and} {const -5} {const 240}}] [differential {{call {ref bit_and} {const -5} {const 240}}}]
} -result {240 same}

test scalarbits-bitand-bigint {bitwise ops work on values outside the small-Int range} -body {
    run {call {ref bit_and} {const 1000000000000000000000000000000} {const 15}}
} -result 0

test scalarbits-shift-left-1 {shift_left is exact multiplication by 2^k} -body {
    list [run {call {ref shift_left} {const 1} {const 4}}] [run {call {ref shift_left} {const 1} {const 0}}]
} -result {16 1}

test scalarbits-shift-right-1 {shift_right is exact floor division by 2^k} -body {
    list [run {call {ref shift_right} {const 171} {const 4}}] [run {call {ref shift_right} {const 15} {const 4}}]
} -result {10 0}

test scalarbits-shift-negative-amount {a negative shift amount is a RANGE error, not silent truncation} -body {
    list [errorCodeOf {call {ref shift_left} {const 1} {const -1}}] \
         [errorCodeOf {call {ref shift_right} {const 1} {const -1}}]
} -result {{CORE SEMANTIC RANGE} {CORE SEMANTIC RANGE}}

test scalarbits-shift-huge-amount {an absurdly large shift amount is RANGE, not an attempted allocation} -body {
    errorCodeOf {call {ref shift_left} {const 1} {const 100000000000}}
} -result {CORE SEMANTIC RANGE}

test scalarbits-bitwise-differential {bitwise ops agree between interp and compile} -body {
    differential {
        {call {ref list}
            {call {ref bit_and} {const 171} {const 15}}
            {call {ref bit_or} {const 171} {const 15}}
            {call {ref bit_xor} {const 171} {const 15}}
            {call {ref shift_left} {const 3} {const 5}}
            {call {ref shift_right} {const 200} {const 3}}}
    }
} -result same

cleanupTests
