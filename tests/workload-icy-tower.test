# workload-icy-tower.test -- the Icy Tower vertical slice
# (examples/games/icy-tower/, ICY-TOWER-VERTICAL-SLICE-1.md) as part of the
# Tcl suite: its golden suite on the backends of this pass, its modules
# warning-clean (the SDL ones staged with the generated SDL3 binding), the
# headless simulation's summary on every backend, and -- where the
# package-owned libSDL3.so is built (tests/cffi/sdl3.tcl; CI's icy-tower
# workflow) -- the Linux executable: built by build.sh, run headless, run
# through the real SDL loop on SDL's dummy video driver (also under GC
# stress), its failure and usage paths, its link, and the independent
# oracle (audit/icy-tower/oracle.py) over a grid of seeds. Where SDL3.dll is
# built on Windows, the Windows executable (ICY-TOWER-WINDOWS.md): built by
# build-windows.sh against the MSVC binding it generates, its imports, and
# its headless, dummy-driver, failure and usage runs.
#
# The pure modules (tower.bot, hud.bot, options.bot) and their programs
# (headless.bot, golden.bot) need no SDL and run on every backend; game.bot,
# sdl.bot, render.bot and the entry programs (main.bot on Linux,
# main-windows.bot on Windows) import the generated binding, which build.sh,
# build-windows.sh and the warning test here stage beside them.
#
# Backends, as tests/workload-2048.test's: the outer pass's own (CORE_BACKEND
# interp or compile) plus cranelift in the interp pass and
# cranelift-generic in the compile pass; all four when run directly.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]
source [file join $::projectRoot examples games icy-tower run.tcl]
source [file join $::projectRoot tests cffi sdl3.tcl]
source [file join $::projectRoot tests binary-header.tcl]

interp recursionlimit {} 100000

if {![info exists ::env(CORE_BACKEND)]} {
    set workloadBackends {interp compile cranelift-generic cranelift}
} elseif {$::env(CORE_BACKEND) eq "interp"} {
    set workloadBackends {interp cranelift}
} elseif {$::env(CORE_BACKEND) eq "compile"} {
    set workloadBackends {compile cranelift-generic}
} else {
    set workloadBackends [list $::env(CORE_BACKEND)]
}
# stdlib/test.bot's runner is a coroutine: natively, Linux x86-64 and AArch64
# only (COROUTINES.md), as tests/golden.test.
set nativeSuite [expr {$::tcl_platform(os) eq "Linux" && $::tcl_platform(machine) in {x86_64 amd64 aarch64}}]
set suiteBackends [expr {$nativeSuite ? $workloadBackends : [lsearch -all -inline -not -glob $workloadBackends cranelift*]}]
testConstraint suiteBackends [expr {[llength $suiteBackends] > 0}]
set nativeBackends [lsearch -all -inline -glob $workloadBackends cranelift*]
testConstraint nativeBuilt [expr {![catch {native::binary}]}]
# The executable: Linux x86-64 (the slice's one target), a built native
# backend, rustc-linked executables, and the package-owned libSDL3.so.
testConstraint icyTowerExecutable [expr {$::tcl_platform(os) eq "Linux" &&
    $::tcl_platform(machine) in {x86_64 amd64} && [testConstraint nativeBuilt] &&
    [testConstraint executableAot] && [testConstraint cLinker] && [cffi::sdl3Dir] ne ""}]
testConstraint python3 [expr {[auto_execok python3] ne ""}]

set gameDir [file join $::projectRoot examples games icy-tower]

# The summary of seed 7's 600-frame autopilot run (audit/icy-tower/oracle.py
# summary 7 600).
set seed7 {frames=600 round=1 floor=26 score=260 best=29.1 time=10.0 over=no x=263 y=2947 camera=2551 platforms=11 rng=3699965314}

test workload-icy-tower-golden-suite "golden.bot: compiles once, all 67 tests pass on [join $suiteBackends {, }], the same report on each" -constraints suiteBackends -body {
    set result [golden::suite [file join $gameDir golden.bot] $suiteBackends]
    set status [dict get $result status]
    if {$status eq "compile-error"} {
        return "compile error: [lindex [dict get $result compile] 1]"
    }
    set problems {}
    foreach {backend outcome} [dict get $result outcomes] {
        if {[lindex $outcome 0] eq "abort"} {
            lappend problems "$backend aborted: [lindex $outcome 1]"
            continue
        }
        set lines [lindex $outcome 1]
        foreach line $lines {
            if {[string match "FAIL *" $line]} { lappend problems "$backend: $line" }
        }
        set names [lmap line [golden::verdicts $lines] {string range $line 5 end}]
        if {[llength $names] != 67 || [llength [lsort -unique $names]] != 67} {
            lappend problems "$backend: [llength $names] verdicts, [llength [lsort -unique $names]] distinct, expected 67"
        }
        if {[lindex $lines end] ne "67 passed, 0 failed"} {
            lappend problems "$backend: [lindex $lines end]"
        }
    }
    if {$status eq "disagree"} {
        lappend problems "the backends' reports differ"
    }
    expr {$problems eq {} ? "ok" : [join $problems \n]}
} -result ok

test workload-icy-tower-headless "headless.bot's summary of seed 7 after 600 frames is the same on [join $workloadBackends {, }] and equals the independent oracle's" -body {
    set hir [icytower::compile [file join $gameDir headless.bot]]
    lmap backend $workloadBackends {
        core::value::strOf [icytower::run $hir $backend]
    }
} -result [lrepeat [llength $workloadBackends] $seed7]

test workload-icy-tower-warning-clean {the pure modules and their programs have no warnings, and compile under -warnings error} -body {
    set found {}
    foreach name {headless.bot golden.bot} {
        if {[catch {surface::readProgramFile [file join $gameDir $name] -warnings error -warning-channel ""} message]} {
            lappend found "$name: [lindex [split $message \n] 0]"
        }
    }
    join $found \n
} -result {}

# The HIR of main.bot, staged with the committed generated SDL3 binding
# installed as its package .bot_modules/sdl3 (tools/c-bindgen.tcl stage
# -package 1, as build.sh stages it: BOT-MODULES-MILESTONE-1.md) and
# compiled under -warnings error for
# linux-x86_64; compiled once, for the tests that read it.
proc icyStagedHir {} {
    if {[info exists ::icyStagedHir]} {
        return $::icyStagedHir
    }
    set stage [file join [tcltest::temporaryDirectory] icy-tower-stage]
    file delete -force $stage
    exec [info nameofexecutable] [file join $::projectRoot tools c-bindgen.tcl] stage sdl3 -target linux-x86_64 -app $::gameDir -into $stage -package 1
    try {
        set ::icyStagedHir [surface::readProgramFile [file join $stage main.bot] -warnings error -warning-channel "" -target linux-x86_64]
    } finally {
        file delete -force $stage
    }
    return $::icyStagedHir
}

test workload-icy-tower-sdl-modules-warning-clean {main.bot, game.bot, sdl.bot and render.bot, staged with the committed generated SDL3 binding (tools/c-bindgen.tcl stage), compile under -warnings error for linux-x86_64: no warning of the game's own, none of the binding's -- and no module of the game is direct: sdl.bot's raw calls (retaining C calls, native views and edits) are all mediated by its own Sdl context (DIRECT-MODULES.md), so render.bot, game.bot and the entry program stay ordinary} -body {
    set hir [icyStagedHir]
    set statuses {}
    foreach line [split [hir::direct::summary $hir] \n] {
        if {[regexp {^module (tower|hud|options|sdl|render|game): (\S+)} $line -> module status]
                || [regexp {^(entry program): (\S+)} $line -> module status]} {
            lappend statuses $module $status
        }
    }
    list ok [lsort -stride 2 $statuses]
} -result {ok {{entry program} ordinary game ordinary hud ordinary options ordinary render ordinary sdl contextualized tower ordinary}}

# The game module of expression E (its file's name), "" outside the game: a
# file of the stage's root, never of a subdirectory (the staged binding has
# a render.bot of its own, sdl3/render.bot).
proc icyModuleOf {hir e} {
    set origin [dict get $hir exprs $e origin]
    if {[lindex $origin 0] ne "file"} { return "" }
    set path [lindex [split [hir::originLocation $hir $origin] :] 0]
    if {[file normalize [file dirname $path]] ne [file normalize [file join [tcltest::temporaryDirectory] icy-tower-stage]]} { return "" }
    set file [file rootname [file tail $path]]
    return [expr {$file in {main game sdl render tower hud options} ? $file : ""}]
}

# 1 if call E is a context installation (`with context EXPR`: the call of
# context#install) or the installed expression, the value of its hygienic
# temporary's binding (surface/lower.tcl).
proc icyInstallation {hir e} {
    if {[hir::contexts::isInstall $hir $e]} { return 1 }
    dict for {x node} [dict get $hir exprs] {
        if {[dict get $node kind] eq "bind" && [dict get $node value] eq $e
                && [string match context#* [dict get $hir bindings [dict get $node binding] name]]} {
            return 1
        }
    }
    return 0
}

test workload-icy-tower-sdl-airlock {SDL stays behind the sdl::Sdl context (ICY-TOWER-CONTEXT-REFACTOR-CENSUS.md): outside sdl.bot no function's parameter or result holds a C pointer, no call passes or returns one, no SDL function is called, and no native view or edit is made -- every SDL object lives in the installed context's session, and render.bot, game.bot and main.bot use operations only. The one affine value outside sdl.bot is the opaque Sdl itself, which the entry program's installation moves into the installed context (CONTEXT-OWNED-AFFINE-STATE-MILESTONE-1.md): sdl::create()'s result and context#install's argument, its pointers sealed inside it} -body {
    set hir [icyStagedHir]
    set found {}
    dict for {e node} [dict get $hir exprs] {
        set module [icyModuleOf $hir $e]
        if {$module in {"" sdl}} continue
        set where "$module.bot:[lindex [split [hir::originLocation $hir [dict get $node origin]] :] end-1]"
        switch -- [dict get $node kind] {
            block {
                set signature [hir::signatures::of $hir $e]
                foreach type [concat [lmap p [dict get $signature params] {dict get $p trusted}] [list [dict get $signature result]]] {
                    if {$type ne "" && [hir::types::IsAffine $type]} { lappend found "$where: a function holding a pointer" }
                }
            }
            call {
                set native [hir::affine::NativeName $hir $e]
                if {[string match extern#sdl3::* $native]} { lappend found "$where: calls [string range $native 7 end]" }
                if {$native in {std::binary::native::view std::binary::native::edit}} { lappend found "$where: makes a native view or edit" }
                foreach value [concat [list $e] [dict get $node args]] {
                    set type [hir::typeOf $hir $value]
                    if {$type eq {nstruct sdl::Sdl} && [icyInstallation $hir $e]} continue
                    if {$type ne "" && [hir::types::IsAffine $type]} { lappend found "$where: a call passing or returning a pointer" }
                }
            }
        }
    }
    lsort -unique $found
} -result {}

# 1 if TYPE holds a C pointer, a native view or a native edit: itself, or
# through struct fields (HIR's sourceTypes), Lists, vectors and arrays.
proc icyHoldsRaw {hir type {seen {}}} {
    if {[llength $type] < 2} { return 0 }
    set head [lindex $type 0]
    if {$head in {cptr cfnptr nview nedit}} { return 1 }
    if {$head eq "nstruct"} {
        set id [lindex $type 1]
        if {$id in $seen} { return 0 }
        foreach entry [hir::sourceTypes $hir] {
            if {[dict exists $entry kind] && [dict get $entry kind] eq "struct" && [dict get $entry id] eq $id} {
                foreach {field fieldType} [dict get $entry fields] {
                    if {[icyHoldsRaw $hir $fieldType [concat $seen [list $id]]]} { return 1 }
                }
            }
        }
        return 0
    }
    foreach part [lrange $type 1 end] {
        if {[icyHoldsRaw $hir $part $seen]} { return 1 }
    }
    return 0
}

test workload-icy-tower-sdl-records-opaque {every struct sdl.bot declares that holds a C pointer, a native view or a native edit is opaque, so an importer can neither make one nor read a pointer out of one: a view is unrestricted, and reading one someone else made takes no authority (ICY-TOWER-CONTEXT-REFACTOR-CENSUS.md, 6.D)} -body {
    set hir [icyStagedHir]
    set found {}
    foreach entry [hir::sourceTypes $hir] {
        if {![dict exists $entry kind] || [dict get $entry kind] ne "struct" || [dict get $entry namespace] ne "sdl"} continue
        if {[icyHoldsRaw $hir [list nstruct [dict get $entry id]]] && ![dict get $entry opaque]} {
            lappend found [dict get $entry id]
        }
    }
    set found
} -result {}

# 1 if TYPE exposes a C pointer, a native view or a native edit to code of
# another module: icyHoldsRaw, stopping at an opaque struct, whose
# representation no other module reads.
proc icyExposesRaw {hir type {seen {}}} {
    if {[llength $type] < 2} { return 0 }
    set head [lindex $type 0]
    if {$head in {cptr cfnptr nview nedit}} { return 1 }
    if {$head eq "nstruct"} {
        set id [lindex $type 1]
        if {$id in $seen} { return 0 }
        foreach entry [hir::sourceTypes $hir] {
            if {[dict exists $entry kind] && [dict get $entry kind] eq "struct" && [dict get $entry id] eq $id} {
                if {[dict get $entry opaque]} { return 0 }
                foreach {field fieldType} [dict get $entry fields] {
                    if {[icyExposesRaw $hir $fieldType [concat $seen [list $id]]]} { return 1 }
                }
            }
        }
        return 0
    }
    foreach part [lrange $type 1 end] {
        if {[icyExposesRaw $hir $part $seen]} { return 1 }
    }
    return 0
}

# The declarations of sdl.bot that are private (hir/privacy.tcl's record of
# the module), by category: {values {NAME ...} types {NAME ...}}.
proc icyPrivate {hir} {
    set result {}
    dict for {category names} [dict get $hir moduleDecls sdl private] {
        lappend result $category [lsort [dict keys $names]]
    }
    return $result
}

test workload-icy-tower-sdl-helpers-private {every function of sdl.bot whose parameter or result exposes a C pointer, a native view or a native edit (an opaque struct hides one) is private, and so is every layout of native memory and the session (MODULE-PRIVACY-AND-CONTEXT-ESCAPE-MILESTONE-1.md): no importer can call a pointer-taking helper or name the session's record} -body {
    set hir [icyStagedHir]
    set found {}
    set decls [dict get $hir moduleDecls]
    dict for {e node} [dict get $hir exprs] {
        if {[icyModuleOf $hir $e] ne "sdl" || [dict get $node kind] ne "bind"} continue
        set value [dict get $node value]
        if {[dict get $hir exprs $value kind] ne "block" || ![hir::isModuleBinding $hir [dict get $node binding]]} continue
        set name [namespace tail [hir::semantic::SourceName $hir [dict get $node binding]]]
        set signature [hir::signatures::of $hir $value]
        set raw 0
        foreach type [concat [lmap p [dict get $signature params] {dict get $p trusted}] [list [dict get $signature result]]] {
            if {$type ne "" && [icyExposesRaw $hir $type]} { set raw 1 }
        }
        if {$raw && [hir::privacy::Entry $decls sdl values $name] eq ""} {
            lappend found "public $name holds a pointer, a view or an edit"
        }
    }
    list [lsort $found] [icyPrivate $hir]
} -result {{} {types {EventType KeyState Session TextBuffer} values {cstring down? error_text free_text nul printable quit_requested? read_text release session_clear session_color session_fill session_line session_present session_scale session_synced? session_text text_of write_chars write_text write_text_unchecked}}}

test workload-icy-tower-no-resource-escape {the refactored airlock hands nothing raw across its boundary: no CONTEXT-RESOURCE-ESCAPE (the warning-clean test above compiles it under -warnings error; this asks the pass itself)} -body {
    set hir [icyStagedHir]
    hir::resourceescape::findings [dict getdef $hir traitSource $hir]
} -result {}

test workload-icy-tower-baseline-warnings {the original Icy Tower boundary (audit/icy-tower/context-refactor/baseline/, commit 6df89a8e) draws exactly the twelve CONTEXT-RESOURCE-ESCAPE warnings the census predicted: seven drawing functions taking the renderer, open, poll and close carrying the Video, and the open structs Video and Polled taken apart outside sdl.bot} -body {
    set stage [file join [tcltest::temporaryDirectory] icy-tower-baseline-stage]
    file delete -force $stage
    exec [info nameofexecutable] [file join $::projectRoot tools c-bindgen.tcl] stage sdl3 -target linux-x86_64 \
        -app [file join $::projectRoot audit icy-tower context-refactor baseline] -into $stage
    try {
        set hir [surface::readProgramFile [file join $stage main.bot] -warnings default -warning-channel "" -target linux-x86_64 -cache ""]
    } finally {
        file delete -force $stage
    }
    lsort [lmap w [hir::warnings::of $hir] {
        if {[dict get $w code] ne "CONTEXT-RESOURCE-ESCAPE"} continue
        list [dict get $w data declaration] [dict get $w data rules] [lmap pair [dict get $w data consumers] {
            expr {[lindex $pair 0] eq "" ? "main" : [lindex $pair 0]}
        }]
    }]
} -result {{sdl::Polled R4 main} {sdl::Video R4 render} {sdl::clear R2 render} {sdl::close R2 main} {sdl::color R2 render} {sdl::fill R2 render} {sdl::line R2 render} {sdl::open R2 main} {sdl::poll R2 main} {sdl::present R2 render} {sdl::scale R2 render} {sdl::text R2 render}}

test workload-icy-tower-dt-tests-use-exact-steps {the golden suite's motion tests step by exact binary fractions, so its written Float64 expectations are exact results (a guard on the suite itself)} -body {
    set text [core::ReadFile [file join $gameDir golden.bot]]
    lsort -unique [regexp -all -inline {motion\([a-z]+\(\), [0-9.]+\)} $text]
} -result {{motion(both(), 0.125)} {motion(idle(), 0.125)} {motion(idle(), 0.25)} {motion(left(), 0.125)} {motion(right(), 0.125)}}

# ---------------------------------------------------------------------------
# The executable

set executable [file join [tcltest::temporaryDirectory] icy-tower-aot icy-tower]

# Runs SCRIPT (in the caller's scope) with the environment variables of
# the dict ENV set, then restores each: unsetting the whole ::env array
# would unlink it from the process environment.
proc withEnv {env script} {
    set saved {}
    dict for {k v} $env {
        dict set saved $k [expr {[info exists ::env($k)] ? [list $::env($k)] : {}}]
        set ::env($k) $v
    }
    try {
        uplevel 1 $script
    } finally {
        dict for {k old} $saved {
            if {[llength $old]} { set ::env($k) [lindex $old 0] } else { unset ::env($k) }
        }
    }
}

# Runs the executable EXE with ARGS, on SDL's dummy video driver, with the
# environment variables of ENV (a dict) added: {exit-status stdout stderr}.
proc icyExec {exe env args} {
    set out [file join [tcltest::temporaryDirectory] icy-tower-out]
    set err [file join [tcltest::temporaryDirectory] icy-tower-err]
    set env [dict merge [dict create SDL_VIDEO_DRIVER dummy] $env]
    try {
        withEnv $env {
            set status [catch {exec $exe {*}$args >$out 2>$err}]
        }
        set code 0
        if {$status} {
            set code [lindex $::errorCode 2]
            if {[lindex $::errorCode 0] ne "CHILDSTATUS"} { set code $::errorCode }
        }
        list $code [string trim [core::ReadFile $out]] [string trim [core::ReadFile $err]]
    } finally {
        file delete -force $out $err
    }
}

# Runs the Linux executable with ARGS, on SDL's dummy video driver and the
# package-owned libSDL3.so, with the environment variables of ENV (a dict)
# added: {exit-status stdout stderr}.
proc icyRun {env args} {
    icyExec $::executable [dict merge [dict create LD_LIBRARY_PATH [cffi::sdl3Dir]] $env] {*}$args
}

test workload-icy-tower-executable-builds {build.sh stages the game with the generated SDL3 binding, compiles it under -warnings error and links it with -lSDL3: a stripped PIE x86-64 executable that needs libSDL3.so.0 and nothing beyond glibc and libgcc} -constraints icyTowerExecutable -body {
    file delete -force [file dirname $executable]
    exec sh [file join $gameDir build.sh] $executable 2>@1
    set needed [regexp -all -inline {NEEDED\s+(\S+)} [exec objdump -p $executable]]
    list [file executable $executable] [string match "*ELF 64-bit LSB pie executable, x86-64*stripped*" [exec file $executable]] \
        [lsort [lmap {- lib} $needed {set lib}]]
} -result {1 1 {ld-linux-x86-64.so.2 libSDL3.so.0 libc.so.6 libgcc_s.so.1 libm.so.6}}

test workload-icy-tower-executable-headless {the executable's --headless run prints seed 7's summary, the oracle's, and exits 0} -constraints icyTowerExecutable -body {
    icyRun {} --headless --frames 600 --seed 7
} -result [list 0 "\"$seed7\"" {}]

test workload-icy-tower-executable-dummy-driver {the real SDL loop on SDL's dummy video driver -- SDL_Init, a window, a renderer, events, the keyboard state, every frame drawn (rectangles, lines, debug text through C floats) and presented, then everything released -- plays the same 600 frames as the headless run, with the autopilot and fixed steps} -constraints icyTowerExecutable -body {
    icyRun {} --autopilot --fixed-step --frames 600 --seed 7
} -result [list 0 "\"$seed7\"" {}]

test workload-icy-tower-executable-gc-stress {the dummy-driver run under BOTLISH_NATIVE_GC_STRESS=1 (a collection at every allocation): 120 frames, the same state as without} -constraints icyTowerExecutable -body {
    set plain [icyRun {} --autopilot --fixed-step --frames 120 --seed 11]
    set stressed [icyRun {BOTLISH_NATIVE_GC_STRESS 1} --autopilot --fixed-step --frames 120 --seed 11]
    list [lindex $plain 0] [expr {$plain eq $stressed}]
} -result {0 1}

test workload-icy-tower-executable-restarts {a long autopilot run on the dummy driver loses and restarts games (the round counts them) and ends cleanly} -constraints icyTowerExecutable -body {
    lassign [icyRun {} --autopilot --fixed-step --frames 2400 --seed 7] code out err
    list $code [regexp {round=([2-9]|\d\d)} $out] $err
} -result {0 1 {}}

test workload-icy-tower-executable-sdl-failure {when SDL cannot start (an unknown video driver), the run releases what it made, reports SDL's own error (SDL_GetError's text, copied out with SDL_strlcpy) on standard error and exits 1} -constraints icyTowerExecutable -body {
    icyRun {SDL_VIDEO_DRIVER nosuch} --frames 10
} -result {1 {} {Icy Tower: SDL_Init failed: nosuch not available}}

test workload-icy-tower-executable-renderer-failure {when the renderer cannot be made (an unknown render driver), the window and SDL made before it are released again, SDL's error is reported and the run exits 1} -constraints icyTowerExecutable -body {
    icyRun {SDL_RENDER_DRIVER nosuch} --frames 10
} -result {1 {} {Icy Tower: SDL_CreateRenderer failed: nosuch not available}}

testConstraint valgrind [expr {[auto_execok valgrind] ne ""}]

test workload-icy-tower-executable-no-leaks {valgrind's memcheck over a whole dummy-driver run (SDL_Init to SDL_Quit, 30 frames): no invalid access and nothing lost -- the window, the renderer and the native scratch memory (SDL_malloc'd, written through layouts) are all released} -constraints {icyTowerExecutable valgrind} -body {
    lassign [icyRun {} --autopilot --fixed-step --frames 30 --seed 7] code out
    set log [file join [tcltest::temporaryDirectory] icy-tower-memcheck]
    withEnv [dict create LD_LIBRARY_PATH [cffi::sdl3Dir] SDL_VIDEO_DRIVER dummy] {
        catch {exec valgrind --leak-check=full --error-exitcode=9 --log-file=$log $::executable --autopilot --fixed-step --frames 30 --seed 7} output
    }
    set text [core::ReadFile $log]
    file delete $log
    list $code [string trim $output] [regexp {definitely lost: 0 bytes} $text] [regexp {indirectly lost: 0 bytes} $text] [regexp {ERROR SUMMARY: 0 errors} $text]
} -result [list 0 "\"frames=30 round=1 floor=0 score=0 best=1.9 time=0.5 over=no x=375 y=222 camera=0 platforms=10 rng=768150900\"" 1 1 1]

test workload-icy-tower-executable-usage {an unknown option is a usage error, status 2; --help prints the usage, status 0} -constraints icyTowerExecutable -body {
    lassign [icyRun {} --fly] code1 out1 err1
    lassign [icyRun {} --help] code2 out2 err2
    list $code1 [lindex [split $err1 \n] 0] $code2 [lindex [split $out2 \n] 0]
} -result {2 {icy-tower: unknown option: --fly} 0 {usage: icy-tower [--seed N] [--frames N] [--headless] [--autopilot] [--fixed-step] [--help]}}

test workload-icy-tower-oracle {the executable's headless summaries equal the independent oracle's (audit/icy-tower/oracle.py) for 8 seeds and 1, 60, 600 and 3600 frames} -constraints {icyTowerExecutable python3} -body {
    withEnv [dict create LD_LIBRARY_PATH [cffi::sdl3Dir]] {
        set status [catch {exec python3 [file join $::projectRoot audit icy-tower oracle.py] compare $::executable} output]
    }
    list $status [lindex [split $output \n] end]
} -result {0 {0 differences}}

testConstraint cc [expr {[auto_execok cc] ne ""}]
testConstraint clangxx [expr {[auto_execok clang++] ne ""}]

# The pinned SDL3 source (tools/c-bindgen.tcl fetch sdl3): there whenever
# the package-owned SDL3 is built.
proc icySdlSource {} {
    set fetched [exec [info nameofexecutable] [file join $::projectRoot tools c-bindgen.tcl] fetch sdl3]
    return [lindex [split [string trim $fetched] \n] end]
}

test workload-icy-tower-trace-reference {the SDL call trace of the Linux executable's deterministic dummy-driver run (--autopilot --fixed-step --frames 600 --seed 7), normalized and cut into frames, is the committed reference the macOS executable's traces are compared with (audit/icy-tower/trace-reference.txt; audit/icy-tower/tools/trace-reference.sh EXECUTABLE write after a change to what the game draws or calls)} -constraints {icyTowerExecutable python3 cc} -body {
    withEnv [dict create SDL3_DIR [cffi::sdl3Dir]] {
        set status [catch {exec sh [file join $::projectRoot audit icy-tower tools trace-reference.sh] $::executable check} output]
    }
    list $status [lindex [split $output \n] end]
} -result {0 {identical: every call, argument and result of every frame, and the teardown}}

test workload-icy-tower-abi-check {every SDL function, constant and layout the game uses has, in the committed generated binding of this target, the C types SDL3's own headers give it (audit/icy-tower/tools/abi-check.py: the parameter and result types by template deduction from the prototypes, the values, the sizes and offsets; the tool the macOS build runs against its generated binding)} -constraints {icyTowerExecutable python3 clangxx} -body {
    set work [file join [tcltest::temporaryDirectory] icy-tower-abi]
    set status [catch {exec python3 -I [file join $::projectRoot audit icy-tower tools abi-check.py] \
        [file join $::projectRoot generated c sdl3 [core::cabi::hostTarget]] [file join [icySdlSource] include] $work} output]
    file delete -force $work
    list $status [regexp {(\d+) checks, 0 failed$} $output -> n] [expr {$n >= 100}]
} -result {0 1 1}

file delete -force [file dirname $executable]

# ---------------------------------------------------------------------------
# The Windows executable (ICY-TOWER-WINDOWS.md)

# Windows, a built native backend, executables, the package-owned SDL3.dll
# and SDL3.lib (tests/cffi/sdl3.tcl), clang for the MSVC SDL3 binding
# build-windows.sh generates, and Git for Windows' sh to run it. (Not
# `bash`: the first one on a Windows PATH can be System32's, WSL's
# launcher.)
testConstraint icyTowerWindowsExecutable [expr {$::tcl_platform(platform) eq "windows" &&
    [testConstraint nativeBuilt] && [testConstraint executableAot] && [cffi::sdl3Dir] ne "" &&
    [auto_execok clang] ne "" && [auto_execok sh] ne ""}]

set windowsGame [file join [tcltest::temporaryDirectory] icy-tower-windows]

# Runs the Windows executable with ARGS, as icyRun runs the Linux one: it
# loads SDL3.dll from its own directory.
proc icyRunWindows {env args} {
    icyExec [file join $::windowsGame icy-tower.exe] $env {*}$args
}

# The DLLs of the PE image PATH that are a C runtime's: the Visual C++
# runtime's (vcruntime, msvcp, concrt) or the UCRT's (ucrtbase,
# api-ms-win-crt-*), none of which the game may need beside it.
proc icyRuntimeDlls {path} {
    lsearch -all -inline -regexp -nocase [dict get [peFacts $path] imports] {^(vcruntime|msvcp|concrt|ucrtbase|api-ms-win-crt-)}
}

test workload-icy-tower-windows-builds {build-windows.sh generates the MSVC SDL3 binding (windows-x86_64), stages the game with it, compiles main-windows.bot under -warnings error and links it with SDL3.lib: icy-tower.exe, a console x86-64 PE beside SDL3.dll, importing SDL3.dll; neither needs a C runtime DLL (the executable's C runtime is static, SDL3.dll is built without one)} -constraints icyTowerWindowsExecutable -body {
    file delete -force $windowsGame
    exec sh [file join $gameDir build-windows.sh] $windowsGame 2>@1
    set exe [file join $windowsGame icy-tower.exe]
    set dll [file join $windowsGame SDL3.dll]
    set pe [peFacts $exe]
    list [binaryHeader $exe] [dict get $pe subsystem] [expr {"SDL3.dll" in [dict get $pe imports]}] \
        [file exists $dll] [icyRuntimeDlls $exe] [icyRuntimeDlls $dll]
} -result {{pe x86_64 executable} 3 1 1 {} {}}

test workload-icy-tower-windows-headless {the Windows executable's --headless run prints seed 7's summary, the oracle's, and exits 0} -constraints icyTowerWindowsExecutable -body {
    icyRunWindows {} --headless --frames 600 --seed 7
} -result [list 0 "\"$seed7\"" {}]

test workload-icy-tower-windows-dummy-driver {the real SDL loop on Windows, on SDL's dummy video driver -- SDL_Init, a window, a renderer, events, the keyboard state, every frame drawn (rectangles, lines, debug text through C floats) and presented, then everything released -- plays the same 600 frames as the headless run} -constraints icyTowerWindowsExecutable -body {
    icyRunWindows {} --autopilot --fixed-step --frames 600 --seed 7
} -result [list 0 "\"$seed7\"" {}]

test workload-icy-tower-windows-gc-stress {the Windows dummy-driver run under BOTLISH_NATIVE_GC_STRESS=1: 120 frames, the same state as without} -constraints icyTowerWindowsExecutable -body {
    set plain [icyRunWindows {} --autopilot --fixed-step --frames 120 --seed 11]
    set stressed [icyRunWindows {BOTLISH_NATIVE_GC_STRESS 1} --autopilot --fixed-step --frames 120 --seed 11]
    list [lindex $plain 0] [expr {$plain eq $stressed}]
} -result {0 1}

test workload-icy-tower-windows-sdl-failure {on Windows too, when SDL cannot start (an unknown video driver), the run releases what it made, reports SDL's own error on standard error and exits 1} -constraints icyTowerWindowsExecutable -body {
    icyRunWindows {SDL_VIDEO_DRIVER nosuch} --frames 10
} -result {1 {} {Icy Tower: SDL_Init failed: nosuch not available}}

test workload-icy-tower-windows-usage {the Windows executable's usage error is status 2; --help prints the usage, status 0} -constraints icyTowerWindowsExecutable -body {
    lassign [icyRunWindows {} --fly] code1 out1 err1
    lassign [icyRunWindows {} --help] code2 out2 err2
    list $code1 [lindex [split $err1 \n] 0] $code2 [lindex [split $out2 \n] 0]
} -result {2 {icy-tower: unknown option: --fly} 0 {usage: icy-tower [--seed N] [--frames N] [--headless] [--autopilot] [--fixed-step] [--help]}}

file delete -force $windowsGame

# ---------------------------------------------------------------------------
# The macOS executable (ICY-TOWER-MACOS-MILESTONE-1.md)

# An Apple Silicon Mac with Apple's developer tools, a built native backend,
# executables, and CMake and git for the static SDL3 and the binding
# build-macos.sh makes (or reuses: ICY_TOWER_BINDING_FROM). The compiler is
# ICY_TOWER_BOTLISH (Botlish.app) when set, else this checkout's.
testConstraint icyTowerMacosExecutable [expr {$::tcl_platform(os) eq "Darwin" &&
    $::tcl_platform(machine) eq "arm64" && [testConstraint nativeBuilt] && [testConstraint executableAot] &&
    [auto_execok clang] ne "" && [auto_execok cmake] ne "" && [auto_execok git] ne ""}]

set macosGame [file join [tcltest::temporaryDirectory] icy-tower-macos]

# Runs the macOS executable with ARGS, on SDL's dummy video driver: it needs
# no library path (SDL3 is linked into it).
proc icyRunMacos {env args} {
    icyExec [file join $::macosGame icy-tower] $env {*}$args
}

# The dynamic libraries of the Mach-O PATH (otool -L), and its LC_MAIN stack
# size.
proc icyMachO {path} {
    set libs [lmap line [lrange [split [exec otool -L $path] \n] 1 end] {lindex [string trim $line] 0}]
    regexp {cmd LC_MAIN.*?stacksize (\d+)} [exec otool -l $path] -> stack
    list $libs $stack
}

test workload-icy-tower-macos-builds {build-macos.sh stages the game with the macos-aarch64 SDL3 binding and the pinned static SDL3 (macos_link.bot checked against SDL3's sdl3.pc), compiles main-macos.bot under -warnings error with -native-startup main-thread and links it with the link plan: a Mach-O arm64 executable with LC_MAIN's 512 MiB stack, SDL3 inside it, every dynamic library the system's (/usr/lib, /System/Library) and none SDL3's} -constraints icyTowerMacosExecutable -body {
    file delete -force $macosGame
    exec bash [file join $gameDir build-macos.sh] $macosGame 2>@1
    set exe [file join $macosGame icy-tower]
    lassign [icyMachO $exe] libs stack
    set foreign [lsearch -all -inline -not -regexp $libs {^(/usr/lib/|/System/Library/)}]
    list [string match "*Mach-O 64-bit executable arm64*" [exec file $exe]] $stack \
        [lsearch -all -inline -nocase $libs *sdl*] $foreign [expr {"/System/Library/Frameworks/Metal.framework/Versions/A/Metal" in $libs}]
} -result {1 536870912 {} {} 1}

test workload-icy-tower-macos-headless {the macOS executable's --headless run prints seed 7's summary, the oracle's, and exits 0} -constraints icyTowerMacosExecutable -body {
    icyRunMacos {} --headless --frames 600 --seed 7
} -result [list 0 "\"$seed7\"" {}]

test workload-icy-tower-macos-dummy-driver {the real SDL loop on macOS, on SDL's dummy video driver, on the process's main thread -- SDL_Init, a window, a renderer, events, the keyboard state, every frame drawn and presented, everything released -- plays the same 600 frames as the headless run} -constraints icyTowerMacosExecutable -body {
    icyRunMacos {} --autopilot --fixed-step --frames 600 --seed 7
} -result [list 0 "\"$seed7\"" {}]

test workload-icy-tower-macos-gc-stress {the macOS dummy-driver run under BOTLISH_NATIVE_GC_STRESS=1 (a collection at every allocation, the main thread's stack walked): 120 frames, the same state as without} -constraints icyTowerMacosExecutable -body {
    set plain [icyRunMacos {} --autopilot --fixed-step --frames 120 --seed 11]
    set stressed [icyRunMacos {BOTLISH_NATIVE_GC_STRESS 1} --autopilot --fixed-step --frames 120 --seed 11]
    list [lindex $plain 0] [expr {$plain eq $stressed}]
} -result {0 1}

test workload-icy-tower-macos-restarts {a long autopilot run on the dummy driver loses and restarts games and ends cleanly} -constraints icyTowerMacosExecutable -body {
    lassign [icyRunMacos {} --autopilot --fixed-step --frames 2400 --seed 7] code out err
    list $code [regexp {round=([2-9]|\d\d)} $out] $err
} -result {0 1 {}}

test workload-icy-tower-macos-sdl-failure {when SDL cannot start (an unknown video driver), the macOS executable releases what it made, reports SDL's own error on standard error (std::darwin::io) and exits 1} -constraints icyTowerMacosExecutable -body {
    icyRunMacos {SDL_VIDEO_DRIVER nosuch} --frames 10
} -result {1 {} {Icy Tower: SDL_Init failed: nosuch not available}}

test workload-icy-tower-macos-renderer-failure {when the renderer cannot be made, the window and SDL are released again, SDL's error is reported and the run exits 1} -constraints icyTowerMacosExecutable -body {
    icyRunMacos {SDL_RENDER_DRIVER nosuch} --frames 10
} -result {1 {} {Icy Tower: SDL_CreateRenderer failed: nosuch not available}}

test workload-icy-tower-macos-usage {the macOS executable's usage error is status 2; --help prints the usage, status 0} -constraints icyTowerMacosExecutable -body {
    lassign [icyRunMacos {} --fly] code1 out1 err1
    lassign [icyRunMacos {} --help] code2 out2 err2
    list $code1 [lindex [split $err1 \n] 0] $code2 [lindex [split $out2 \n] 0]
} -result {2 {icy-tower: unknown option: --fly} 0 {usage: icy-tower [--seed N] [--frames N] [--headless] [--autopilot] [--fixed-step] [--help]}}

test workload-icy-tower-macos-oracle {the macOS executable's headless summaries equal the independent oracle's for 8 seeds and 1, 60, 600 and 3600 frames} -constraints {icyTowerMacosExecutable python3} -body {
    set status [catch {exec python3 [file join $::projectRoot audit icy-tower oracle.py] compare [file join $::macosGame icy-tower]} output]
    list $status [lindex [split $output \n] end]
} -result {0 {0 differences}}

test workload-icy-tower-macos-failed-build-keeps-old {a build that fails (here the link: an archive without SDL3 in it) leaves the executable of the last good build as it was} -constraints icyTowerMacosExecutable -body {
    set exe [file join $::macosGame icy-tower]
    set before [exec shasum -a 256 $exe]
    set work [file join [tcltest::temporaryDirectory] icy-tower-empty]
    file mkdir $work
    exec clang -c -x c /dev/null -o [file join $work empty.o]
    exec ar rcs [file join $work libempty.a] [file join $work empty.o] 2>@1
    withEnv [dict create ICY_TOWER_SDL3_ARCHIVE [file join $work libempty.a]] {
        set status [catch {exec bash [file join $::gameDir build-macos.sh] $::macosGame 2>@1} output]
    }
    file delete -force $work
    list $status [regexp {Undefined symbols} $output] [regexp {the compilation failed \(OUTDIR is unchanged\)} $output] \
        [expr {[exec shasum -a 256 $exe] eq $before}]
} -result {1 1 1 1}

file delete -force $macosGame

test workload-icy-tower-macos-session-selftest {the macOS graphical acceptance's frame checks (audit/icy-tower/tools/macos-session.py selftest) pass on synthetic frames of the oracle's worlds and reject their positive controls: a blank capture, the player missing, platforms not where the oracle puts them, the wrong banner, a frame that did not change, a player that did not move} -constraints python3 -body {
    set status [catch {exec python3 -I [file join $::projectRoot audit icy-tower tools macos-session.py] selftest} output]
    list $status [lindex [split $output \n] end]
} -result {0 {10 selftest checks, 0 failed}}

cleanupTests
