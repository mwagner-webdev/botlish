# emission-claims.test -- emission claims (EMISSION-CLAIMS-MILESTONE-1.md):
# `fn F(...) emits R:` certified from F's declaration and implementation
# alone, or rejected.
#
# * the guarantee is the declaration's: declared domains, never callers;
# * value facts (hir/intset.tcl over hir::range): holes, order, arithmetic,
#   registered result sets, huge values, the end and non-symbols;
# * control flow: loops (fixpoints, peeling, exact counts), recursion,
#   early returns, break and continue, functions that never return;
# * failures and handlers: failure points after a yield, guards;
# * coroutine boundaries: a constructed coroutine's yields are its own;
# * the recognizer semantics (core/dfa.tcl's one outcome model) against the
#   reference interpreter (tests/dfa-support.tcl), and the token boundaries
#   between helpers;
# * the compiler's integration: the clause's grammar and resolution, its
#   diagnostics' recovery, HIR text, interchange's trust boundary (a
#   certificate in text is never a proof), the in-process certificate memo
#   and its invalidation, static intrinsics, the compiler service;
# * erasure: a claim changes no code.
#
# The prototype's tests (audit/emission-proofs/tests/emission-proofs.test)
# are ported here, renamed ec-*; their programs are the same, their
# directives (`#: emits R`) now the clause. The prototype's verdict "not
# proved" is the compiler's `rejected` (an EMIT-REJECTED-family violation
# found) or `not-proved` (facts missing); "disproven" needs a run (the
# witness tool, audit/emission-claims/tools/witness.tcl).

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]
source [file join $::projectRoot service service.tcl]
source [file join $::projectRoot tests emission-support.tcl]
source [file join $::projectRoot audit emission-claims tools witness.tcl]
interp recursionlimit {} 100000
core::useProgramRecursionLimit

# The claims of the program TEXT (main.bot, beside the JSON workload's
# modules; FILES more files), checked: {NAME VERDICT KINDS}... of the
# claims of main.bot and FILES (every claim with -all 1).
proc claims {text args} {
    set options [dict merge {-files {} -all 0} $args]
    set dir [emit::workspace main.bot $text {*}[dict get $options -files]]
    set hir [emit::compile [file join $dir main.bot]]
    if {[dict get $options -all]} {
        return [emit::results $hir *]
    }
    return [emit::results $hir [concat main.bot [dict keys [dict get $options -files]]]]
}

proc verdicts {text args} {
    return [lmap c [claims $text {*}$args] {list [lindex $c 0] [lindex $c 1]}]
}

# A program: imports, then BODY.
proc program {body {imports {json_lex json_grammar}}} {
    set text ""
    foreach i $imports {
        append text "import $i\n"
    }
    return "$text\n$body\n"
}

proc readFile {path} {
    return [emit::readText $path]
}

# A recognizer of one digit, the head of many programs below.
set digitDfa "import std::dfa\n\nclass digit = '0'..'9'\n\ndfa digit_token over ascii:\n    start:\n        digit -> accept\n\n"

testConstraint python3 [expr {![catch {exec python3 -I -c "import json"}]}]

# ---------------------------------------------------------------------------
# The guarantee is the declaration's

test ec-declared-domain {an unguarded digit is rejected from its declared domain, though the program only ever passes 3} -body {
    verdicts [program {fn digit(d: int) -> unit emits json_grammar::digit_symbol:
    yield 48 + d
    unit

fn src() -> int:
    digit(3)
    -1

coroutine {step, first} = src()
first}]
} -result {{digit rejected}}

test ec-declared-domain-witness {...and a concrete run disproves it (the witness tool, outside the compiler): d = -1 yields '/'} -body {
    set dir [emit::workspace main.bot [program {fn digit(d: int) -> unit emits json_grammar::digit_symbol:
    yield 48 + d
    unit

0}]]
    set hir [emit::compile [file join $dir main.bot]]
    set record [lindex [hir::emission::claims $hir] end]
    lindex [emitw::witness $dir [file join $dir main.bot] $hir $record] 0
} -result {-1}

test ec-unused {a function no program calls is certified, or rejected, all the same} -body {
    verdicts [program {fn good(d: int) -> unit emits json_grammar::digit_symbol:
    if d >= 0 and d <= 9:
        yield 48 + d
    else:
        yield 48
    unit

fn bad(d: int) -> unit emits json_grammar::digit_symbol:
    if d >= 0 and d <= 10:
        yield 48 + d
    else:
        yield 48
    unit

0}]
} -result {{good proven} {bad rejected}}

test ec-undeclared-parameter {a parameter without a declared type enters with no fact from its body's inferred contract: a yield of it is checked against every value it may hold, never against none} -body {
    list [verdicts [program {fn raw(c) -> unit emits json_grammar::digit_symbol:
    yield c
    unit

fn plus(c) -> unit emits json_grammar::digit_symbol:
    yield c + 0
    unit

0}]] [verdicts [program {fn guarded(c) -> unit emits json_grammar::digit_symbol:
    if c >= 48 and c <= 57:
        yield c
    else:
        yield 48
    unit

0}]]
} -result {{{raw not-proved} {plus rejected}} {{guarded proven}}}

test ec-domain-parameter {a declared integer domain is a parameter fact: 0..9 proves a digit, 0..10 does not} -body {
    verdicts [program {type D9 = Int in 0..9
type D10 = Int in 0..10

fn nine(d: D9) -> unit emits json_grammar::digit_symbol:
    yield 48 + d
    unit

fn ten(d: D10) -> unit emits json_grammar::digit_symbol:
    yield 48 + d
    unit

0}]
} -result {{nine proven} {ten rejected}}

test ec-callers-stable {the independent library's verdicts are the same from five unrelated programs -- safe values only, the whole domain, invalid values, compositions, no call at all -- an unguarded digit and two glued numbers rejected in every one; compose.bot's own two claims certified through the library's certificates} -body {
    set lib [readFile [file join $::emit::jsonDir emitlib.bot]]
    set lib [string map {
        "fn digit_unchecked(d: int) -> unit:" "fn digit_unchecked(d: int) -> unit emits json_grammar::digit_symbol:"
        "fn pair_glued(a: int, b: int) -> unit errors IndexNotFound:" "fn pair_glued(a: int, b: int) -> unit errors IndexNotFound emits json_grammar::json_text:"
    } $lib]
    set callers [file join $::projectRoot audit emission-claims callers]
    set out {}
    set own {}
    foreach caller {safe full invalid compose unused} {
        set dir [emit::workspace main.bot [readFile [file join $callers $caller.bot]] emitlib.bot $lib]
        set hir [emit::compile [file join $dir main.bot]]
        lappend out [lsort [lmap c [emit::results $hir emitlib.bot] {list [lindex $c 0] [lindex $c 1]}]]
        if {$caller eq "compose"} {
            set own [emit::results $hir main.bot]
        }
    }
    list [llength [lsort -unique $out]] [lindex $out 0] $own
} -result {1 {{digit_checked proven} {digit_checked_source proven} {digit_of proven} {digit_unchecked rejected} {json_string proven} {json_string_source proven} {member proven} {pair_glued rejected}} {{digits proven {}} {object proven {}}}}

test ec-library-json-string-runs {emitlib's strict string emitter run on the texts the milestone names -- empty, quotation marks, reverse solidi, every control, supplementary characters, U+2028, 2,000 characters -- every output one strict JSON string token for the reference interpreter, and decoding (CPython) to its text} -constraints python3 -body {
    set dir [emit::workspace main.bot "import emitlib\n\n0\n"]
    set controls ""
    for {set c 0} {$c < 32} {incr c} { append controls [format %c $c] }
    set texts [list "" "\"" "\\" "\"\\\"" $controls "\x7f/é" "😀a😀" "  " "퟿￿" \
        [string repeat "aé😀\"\\\n" 333]]
    set saved $::emitw::limit
    set ::emitw::limit 4000
    set copy [emitw::Stripped $dir]
    set runs [emitw::traces $copy emitlib::json_string_source {str} {IndexNotFound} [lmap t $texts {list $t}]]
    set ::emitw::limit $saved
    set model [emit::reference $copy]
    set bad {}
    set lines {}
    foreach run $runs t $texts {
        lassign $run tuple outcome symbols
        if {$outcome ne "complete" || [emit::judge $model {json_lex json_string_strict} $outcome $symbols] ne "ok"} {
            lappend bad [list $tuple $outcome]
        }
        lappend lines [join [lmap c $symbols {format %c $c}] ""]
    }
    emit::writeText [file join $dir out.txt] [join $lines \n]
    set decoded [exec python3 -I -c {
import json, sys
for line in open(sys.argv[1], encoding="utf-8").read().split("\n"):
    print(" ".join(str(ord(c)) for c in json.loads(line)))
} [file join $dir out.txt]]
    set want [join [lmap t $texts {join [lmap ch [split $t ""] {scan $ch %c}] " "}] \n]
    list $bad [expr {$decoded eq $want}] [llength $runs]
} -result {{} 1 10}

# ---------------------------------------------------------------------------
# The recognizer semantics against the reference interpreter

set laText "import std::dfa\n\ndfa ab over ascii:\n    start:\n        'a' -> one\n    one:\n        'b' -> two\n    two:\n        'c' -> accept before 2\n        end -> accept\n\ndfa ab_more over ascii:\n    start:\n        'b' -> more\n    more:\n        'b' -> more\n        ')' 'c' -> accept before\n        end -> reject\n\ndfa wrap over ascii:\n    start:\n        '(' -> inner\n    inner:\n        'a' -> call ab then accept\n        'b' -> call ab_more then close\n    close:\n        ')' -> accept\n        'c' -> accept\n"

test ec-outcome-model {core/dfa.tcl's one statement of a code's meaning: a run function's result encodes its class and decodes back; Resume and Unread agree with what the generated recognizer function computes from it} -body {
    set out {}
    foreach class {taken current {more 1} {more 3}} {
        set r [core::dfa::RunResult $class]
        if {$r eq "c"} {
            lappend out [list $class [core::dfa::ClassOf 65] [core::dfa::ClassOf -1]]
        } else {
            lappend out [list $class [core::dfa::ClassOf $r]]
        }
        lappend out [core::dfa::Resume accept $class] [core::dfa::Resume s $class] \
            [core::dfa::Unread $class 0] [core::dfa::Unread $class 1]
    }
    set out
} -result {{taken taken} propagate {wait s} 0 0 {current current current} propagate {reconsider s} 1 0 {{more 1} {more 1}} propagate reject 1 1 {{more 3} {more 3}} propagate reject 3 3}

# ---------------------------------------------------------------------------
# Value facts

test ec-negation-holes {`c == 34 or c == 92` false excludes both values from a scalar value: a raw character of the string body} -body {
    verdicts [program {import std::char
import std::str

fn body(c: int) -> unit:
    if c == 34 or c == 92:
        yield 92
        yield c
    elif c < 32:
        yield 92
        yield 110
    else:
        yield c
    unit

fn s(text: str) -> unit errors IndexNotFound emits json_lex::json_string:
    yield 34
    loop i from 0 to text.length():
        body(std::char::scalar_value(text.char_at(i)))
        continue
    yield 34
    unit

fn body_bad(c: int) -> unit:
    if c == 34:
        yield 92
        yield c
    elif c < 32:
        yield 92
        yield 110
    else:
        yield c
    unit

fn s_bad(text: str) -> unit errors IndexNotFound emits json_lex::json_string:
    yield 34
    loop i from 0 to text.length():
        body_bad(std::char::scalar_value(text.char_at(i)))
        continue
    yield 34
    unit

0} {json_lex}]
} -result {{s proven} {s_bad rejected}}

test ec-trusted-scalar {a scalar value is never a surrogate (the trusted fact), but its controls are not excluded: raw scalar values above the controls are a string body, all of them are not} -body {
    verdicts [program {import std::char
import std::str

fn upper(text: str) -> unit errors IndexNotFound emits json_lex::json_string:
    yield 34
    loop i from 0 to text.length():
        c = std::char::scalar_value(text.char_at(i))
        if c >= 93:
            yield c
        continue
    yield 34
    unit

fn all(text: str) -> unit errors IndexNotFound emits json_lex::json_string:
    yield 34
    loop i from 0 to text.length():
        c = std::char::scalar_value(text.char_at(i))
        if c != 34 and c != 92:
            yield c
        continue
    yield 34
    unit

0} {json_lex}]
} -result {{upper proven} {all rejected}}

test ec-surrogate-codes {an Int from a List may be a surrogate until a check excludes it; json_string_strict rejects a raw surrogate} -body {
    verdicts [program {import std::list

error NotScalar:
    at: int

fn checked(codes: List[int]) -> unit errors NotScalar emits json_lex::json_string_strict:
    yield 34
    loop c in codes:
        if c < 93 or c > 1114111 or (c >= 55296 and c <= 57343):
            fail NotScalar {at: c}
        yield c
        continue
    yield 34
    unit

fn unchecked(codes: List[int]) -> unit errors NotScalar emits json_lex::json_string_strict:
    yield 34
    loop c in codes:
        if c < 93 or c > 1114111:
            fail NotScalar {at: c}
        yield c
        continue
    yield 34
    unit

0} {json_lex}]
} -result {{checked proven} {unchecked rejected}}

test ec-arithmetic {hir::range's transfers, per component: 48 + d, 57 - d, (v - 64) shift_right 1, v mod 10} -body {
    verdicts [program {fn add(d: int) -> unit emits json_grammar::digit_symbol:
    if d >= 0 and d <= 9:
        yield 48 + d
    else:
        yield 49
    unit

fn sub(d: int) -> unit emits json_grammar::digit_symbol:
    if d >= 0 and d <= 9:
        yield 57 - d
    else:
        yield 49
    unit

fn sub_bad(d: int) -> unit emits json_grammar::digit_symbol:
    if d >= 0 and d <= 9:
        yield 58 - d
    else:
        yield 49
    unit

fn shift(v: int) -> unit emits json_grammar::digit_symbol:
    if v >= 64 and v <= 83:
        yield 48 + (v - 64).shift_right(1)
    else:
        yield 49
    unit

fn modulo(v: int) -> unit emits json_grammar::digit_symbol:
    yield 48 + v.mod(10)
    unit

fn modulo_bad(v: int) -> unit emits json_grammar::digit_symbol:
    yield 48 + v.mod(11)
    unit

0}]
} -result {{add proven} {sub proven} {sub_bad rejected} {shift proven} {modulo proven} {modulo_bad rejected}}

test ec-hole-edge {`c != 48` removes 48, and only 48: 47 is still possible} -body {
    verdicts [program {fn edge(c: int) -> unit emits json_grammar::digit_symbol:
    if c != 48 and c >= 47 and c <= 57:
        yield c
    else:
        yield 48
    unit

fn inner(c: int) -> unit emits json_grammar::digit_symbol:
    if c != 47 and c >= 47 and c <= 57:
        yield c
    else:
        yield 48
    unit

0}]
} -result {{edge rejected} {inner proven}}

test ec-lift-components {an operator applies to every component of a value with holes, on either side: v + 48 and 48 + v for v in {1, 15} may be '?'} -body {
    verdicts [program {fn two(v: int) -> unit emits json_grammar::digit_symbol:
    if v == 1 or v == 15:
        yield v + 48
    else:
        yield 48
    unit

fn two_right(v: int) -> unit emits json_grammar::digit_symbol:
    if v == 1 or v == 15:
        yield 48 + v
    else:
        yield 48
    unit

fn two_ok(v: int) -> unit emits json_grammar::digit_symbol:
    if v == 1 or v == 9:
        yield v + 48
    else:
        yield 48
    unit

0}]
} -result {{two rejected} {two_right rejected} {two_ok proven}}

test ec-context-sensitive {one helper, two calls with different facts: each analyzed with its own} -body {
    verdicts [program {fn put(n: int) -> unit:
    yield 48 + n
    unit

fn twice(d: int) -> unit emits json_lex::json_number:
    if d >= 1 and d <= 9:
        put(d)
        put(d + 20)
    else:
        yield 49
    unit

fn twice_ok(d: int) -> unit emits json_lex::json_number:
    if d >= 1 and d <= 9:
        put(d)
        put(d - 1)
    else:
        yield 49
    unit

0} {json_lex}]
} -result {{twice rejected} {twice_ok proven}}

test ec-order-narrowing {branches narrow by order, on both outcomes} -body {
    verdicts [program {fn clamp(c: int) -> unit emits json_grammar::digit_symbol:
    if c < 48:
        yield 48
    elif c > 57:
        yield 57
    else:
        yield c
    unit

fn clamp_bad(c: int) -> unit emits json_grammar::digit_symbol:
    if c < 48:
        yield 48
    elif c > 58:
        yield 57
    else:
        yield c
    unit

fn reversed(c: int) -> unit emits json_grammar::digit_symbol:
    if 48 <= c and 57 >= c:
        yield c
    else:
        yield 50
    unit

0}]
} -result {{clamp proven} {clamp_bad rejected} {reversed proven}}

test ec-negation-boundary {the false outcome of `x < K` keeps K itself: below 47 a '0', else the value up to '9' -- '/' (47) possible, rejected; below 48, certified} -body {
    verdicts [program {fn below47(c: int) -> unit emits json_grammar::digit_symbol:
    if c < 47:
        yield 48
    elif c <= 57:
        yield c
    else:
        yield 48
    unit

fn below48(c: int) -> unit emits json_grammar::digit_symbol:
    if c < 48:
        yield 48
    elif c <= 57:
        yield c
    else:
        yield 48
    unit

fn above58(c: int) -> unit emits json_grammar::digit_symbol:
    if c > 58 or c < 48:
        yield 48
    else:
        yield c
    unit

0}]
} -result {{below47 rejected} {below48 proven} {above58 rejected}}

test ec-sentinel {a value past every bound the recognizers use is still a value: 10^23 is rejected} -body {
    claims [program {fn big() -> unit emits json_lex::json_number:
    yield 49
    yield 100000000000000000000000
    unit

0}]
} -result {{big rejected EMIT-REJECTED}}

test ec-end-symbol {-1 is the end, never a symbol} -body {
    claims [program {fn m(n: int) -> unit emits json_grammar::digit_symbol:
    if n >= 0 and n <= 10:
        yield n - 1
    else:
        yield 48
    unit

0}]
} -result {{m rejected {EMIT-END-SYMBOL EMIT-REJECTED}}}

test ec-not-symbol {a String yielded is no symbol} -body {
    claims [program {fn s() -> unit emits json_grammar::digit_symbol:
    yield "1"
    unit

0}]
} -result {{s not-proved EMIT-NOT-SYMBOL}}

# ---------------------------------------------------------------------------
# Control flow

test ec-loop-fixpoint {a loop of digits after a nonzero one is a number; after a zero it is not} -body {
    verdicts [program {fn one_then_zeros(n: int) -> unit emits json_lex::json_number:
    yield 49
    loop i from 0 to n:
        yield 48
        continue
    unit

fn zero_then_ones(n: int) -> unit emits json_lex::json_number:
    yield 48
    loop i from 0 to n:
        yield 49
        continue
    unit

0} {json_lex}]
} -result {{one_then_zeros proven} {zero_then_ones rejected}}

test ec-loop-first-iteration {the list printer's separator, `if i > 0:`, proved by the first iteration's own facts; without it, rejected} -body {
    verdicts [program {import number_emit

fn list(n: int) -> unit errors IndexNotFound emits json_grammar::json_text:
    yield 91
    loop i from 0 to n:
        if i > 0:
            yield 44
        number_emit::integer(i)
        continue
    yield 93
    unit

fn list_bad(n: int) -> unit errors IndexNotFound emits json_grammar::json_text:
    yield 91
    loop i from 0 to n:
        number_emit::integer(i)
        continue
    yield 93
    unit

0}]
} -result {{list proven} {list_bad rejected}}

test ec-loop-second-iteration {the loop's fixpoint: a '.' in a second iteration, after a '0', is rejected in the fraction it starts} -body {
    verdicts [program {fn dots(n: int) -> unit emits json_lex::json_number:
    yield 49
    loop i from 0 to n:
        if i.mod(2) == 0:
            yield 48
        else:
            yield 46
        continue
    unit

fn dotted(n: int) -> unit emits json_lex::json_number:
    yield 49
    loop:
        if n > 5:
            break
        yield 46
        yield 48
        continue
    unit

0} {json_lex}]
} -result {{dots rejected} {dotted rejected}}

test ec-loop-later-iterations {a counted loop's later iterations are past its start: what only they write is checked} -body {
    verdicts [program {fn later(n: int) -> unit emits json_lex::json_number:
    loop i from 0 to n:
        if i > 0:
            yield 120
        yield 49
        continue
    yield 49
    unit

0} {json_lex}]
} -result {{later rejected}}

test ec-loop-exact-count {a loop of exactly one iteration emits one digit; one of n iterations may emit none} -body {
    verdicts [program {fn once() -> unit emits json_grammar::digit_symbol:
    loop i from 0 to 1:
        yield 55
        continue
    unit

fn twice() -> unit emits json_grammar::digit_symbol:
    loop i from 0 to 2:
        yield 55
        continue
    unit

fn maybe(n: int) -> unit emits json_lex::json_number:
    loop i from 0 to n:
        yield 55
        continue
    unit

0}]
} -result {{once proven} {twice rejected} {maybe rejected}}

# ---------------------------------------------------------------------------
# Entered counted loops (EMISSION-COUNTED-LOOP-PRECISION-MILESTONE-1.md): a
# counted loop has no zero-iteration exit when its bounds' facts prove the
# body runs; every exit of the iterations that run stays.

# Two recognizers of nonempty tokens: `ones` ('1'+) and `ab` ('a' 'b'*).
set onesDfa "import std::dfa\n\ndfa ones over ascii:\n    start:\n        '1' -> more\n    more:\n        '1' -> more\n        end -> accept\n\ndfa ab over ascii:\n    start:\n        'a' -> rest\n    rest:\n        'b' -> rest\n        end -> accept\n\nerror Bad\n\n"

# The claims of the entry program of BODY (after onesDfa's header):
# {NAME VERDICT KINDS}... with -kinds 1, else {NAME VERDICT}...
proc loopClaims {body args} {
    set options [dict merge {-kinds 0 -files {}} $args]
    set r [claims "$::onesDfa$body\n\n0\n" -files [dict get $options -files]]
    if {[dict get $options -kinds]} { return $r }
    return [lmap c $r {lrange $c 0 1}]
}

test ec-loop-entered-guards {a loop's bounds proved entered by the facts the code before it establishes -- a failing guard, a returning branch, `not`, `or`, `and`, an earlier binding, a declared domain, an exact bound past the unrolling limit -- has no zero-iteration exit; the same loops without the fact may run zero times} -body {
    loopClaims {type Pos = Int in 1..1000
type Nat = Int in 0..1000

fn fail_guard(n: int) -> unit errors Bad emits ones:
    if n <= 0:
        fail Bad
    loop i from 0 to n:
        yield 49
        continue
    unit

fn return_guard(n: int) -> unit emits ones:
    if n < 1:
        yield 49
        return unit
    loop i from 0 to n:
        yield 49
        continue
    unit

fn not_guard(n: int) -> unit errors Bad emits ones:
    if not (n > 0):
        fail Bad
    loop i from 0 to n:
        yield 49
        continue
    unit

fn or_guard(n: int) -> unit errors Bad emits ones:
    if n < 1 or n > 10:
        fail Bad
    loop i from 0 to n:
        yield 49
        continue
    unit

fn and_branch(n: int) -> unit emits ones:
    if n >= 1 and n <= 10:
        loop i from 0 to n:
            yield 49
            continue
    else:
        yield 49
    unit

fn binding(n: int) -> unit errors Bad emits ones:
    if n < 0:
        fail Bad
    m = n + 1
    loop i from 0 to m:
        yield 49
        continue
    unit

fn domain(n: Pos) -> unit emits ones:
    loop i from 0 to n:
        yield 49
        continue
    unit

fn exact_big() -> unit emits ones:
    big = 100000000000000000000000
    loop i from 0 to big:
        yield 49
        continue
    unit

fn unguarded(n: int) -> unit emits ones:
    loop i from 0 to n:
        yield 49
        continue
    unit

fn wrong_guard(n: int) -> unit errors Bad emits ones:
    if n < 0:
        fail Bad
    loop i from 0 to n:
        yield 49
        continue
    unit

fn nat_domain(n: Nat) -> unit emits ones:
    loop i from 0 to n:
        yield 49
        continue
    unit

fn check(n: int) -> unit errors Bad:
    if n <= 0:
        fail Bad
    unit

fn handled_guard(n: int) -> unit emits ones:
    check(n):
        on Bad:
            unit
    loop i from 0 to n:
        yield 49
        continue
    unit}
