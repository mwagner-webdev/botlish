    yield 125
    unit

fn after_comma(k: str, n: int) -> unit errors IndexNotFound emits json_grammar::json_text:
    yield 123
    emitlib::member(k, n)
    yield 44
    emitlib::member(k, n)
    yield 125
    unit

0} {json_grammar}]
} -result {{after_digit rejected {EMIT-BOUNDARY EMIT-REJECTED}} {after_comma proven {}}}

test ec-compose-weaker-certificate {a helper certified for the permissive string grammar, composed into a strict claim: its tokens may hold a lone surrogate escape} -body {
    list [verdicts [program {fn lone() -> unit emits json_lex::json_string:
    yield 34
    yield 92
    yield 117
    yield 100
    yield 56
    yield 48
    yield 48
    yield 34
    unit

fn strict() -> unit emits json_lex::json_string_strict:
