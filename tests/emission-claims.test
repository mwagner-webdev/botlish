    unit

0} {json_lex}]]
} -result {{{lone proven} {strict rejected}}}

# ---------------------------------------------------------------------------
# Certificates

test ec-statement-digest {what a certificate states -- its exits, visits, failure states, result, boundary -- is in its statement digest; what its proof read is not} -body {
    set cert [dict create function f recognizer r depends [dict create recognizers [dict create r X] functions {f A}] \
        domain int exits {a} visits {a b} fails {a} result {{-1 -1}} follow self]
    set d0 [hir::emission::StatementDigest $cert]
    set out {}
    foreach {k v} {exits {b} visits {a} fails {} result {{0 0}} follow {}} {
        lappend out [expr {[hir::emission::StatementDigest [dict replace $cert $k $v]] ne $d0}]
    }
    lappend out [expr {[hir::emission::StatementDigest [dict replace $cert depends [dict create recognizers [dict create r X] functions {f B}]]] eq $d0}]
} -result {1 1 1 1 1 1}

# The claims of the program at PATH in a fresh analysis: {NAME VERDICT
# REUSED}... (every claim).
proc reuse {path} {
    set hir [emit::compile $path]
    set reused [dict getdef $::hir::emission::stats reusedClaims {}]
    return [lmap r [hir::emission::claims $hir] {
        list [namespace tail [dict get $r function]] [dict get $r verdict] \
            [expr {[list [dict get $r function] [dict get $r recognizer]] in $reused}]
    }]
}

test ec-memo-reuse {a certificate this process proved is reused by a later compilation of another program -- validated against that program's code, never proved again -- and decides the same} -body {
    set ::hir::emission::memo [dict create]
    set dir [emit::workspace a.bot "import emitlib\n\n0\n" b.bot "import emitlib\nimport std::coroutine\n\ncoroutine {step, first} = emitlib::digit_checked_source(4)\nfirst\n"]
    set first [reuse [file join $dir a.bot]]
    set second [reuse [file join $dir b.bot]]
    set ::hir::emission::useMemo 0
    set fresh [reuse [file join $dir b.bot]]
    set ::hir::emission::useMemo 1
    list [lsort -unique [lmap c $first {lindex $c 2}]] [lsort -unique [lmap c $second {lindex $c 2}]] \
        [expr {[lmap c $second {lrange $c 0 1}] eq [lmap c $fresh {lrange $c 0 1}]}] [llength $second]
} -cleanup {set ::hir::emission::useMemo 1} -result {0 1 1 10}

test ec-memo-invalidate {a helper's change invalidates the certificate whose proof analyzed it, not one that composed with that certificate's unchanged statement; a recognizer's change invalidates every certificate reading it; a comment and a new caller invalidate nothing} -body {
    set ::hir::emission::memo [dict create]
    set dir [emit::workspace main.bot "import emitlib\n\n0\n" other.bot "# another caller\nimport emitlib\n\nfn uses() -> int:\n    3\n\nuses()\n"]
    reuse [file join $dir main.bot]
    set lib [file join $dir emitlib.bot]
    set text [readFile $lib]
    set out {}
    # A comment, and a new program: everything reused.
    emit::writeText $lib "# a comment\n$text"
    lappend out [lsort [lmap c [reuse [file join $dir other.bot]] {if {[lindex $c 2]} continue; lindex $c 0}]]
    # A helper's code (hex_digit's letters uppercase): its analyzer re-proved.
    emit::writeText $lib [string map {"        yield 87 + n" "        yield 55 + n"} $text]
    lappend out [lsort [lmap c [reuse [file join $dir main.bot]] {if {[lindex $c 2]} continue; lindex $c 0}]]
    emit::writeText $lib $text
    reuse [file join $dir main.bot]
    # The recognizer: json_lex's escapes lose `\/`.
    set lex [file join $dir json_lex.bot]
    set ltext [readFile $lex]
    emit::writeText $lex [string map {"'\"' '\\\\' '/' 'b'" "'\"' '\\\\' 'b'"} $ltext]
    lappend out [lsort [lmap c [reuse [file join $dir main.bot]] {if {[lindex $c 2]} continue; lindex $c 0}]]
    set out
} -result {{} json_string {json_string json_string_source member}}

test ec-memo-types {a memoized certificate is invalidated by a type its proof read: a struct field's declared domain changed from 0..9 to every Int -- the claimed function's code unchanged -- is proved again, and rejected} -body {
    set ::hir::emission::memo [dict create]
    set out {}
    foreach domain {"Int in 0..9" "int"} {
        set dir [emit::workspace main.bot "import json_grammar\nimport m\n\nfn d(p: m::P) -> unit emits json_grammar::digit_symbol:\n    yield 48 + p.x\n    unit\n\n0\n" \
            m.bot "type D = Int in 0..9\n\nstruct P:\n    x: [string map {"Int in 0..9" D} $domain]\n"]
        lappend out [lmap c [reuse [file join $dir main.bot]] {lrange $c 1 2}]
    }
    set out
} -result {{{proven 0}} {{rejected 0}}}

test ec-memo-registered {a memoized certificate is invalidated when a native result set its proof read is not the registration's any more} -body {
    set ::hir::emission::memo [dict create]
    set dir [emit::workspace main.bot "import emitlib\n\n0\n"]
    reuse [file join $dir main.bot]
    set id [list emitlib::json_string json_lex::json_string_strict]
    set cert [dict get $::hir::emission::memo $id]
    list [dict keys [dict get $cert depends registered]] [lindex [hir::emission::Valid $cert] 0] \
        [hir::emission::Valid [dict set cert depends registered std::char::scalar_value {interval 0 1114111}]]
} -result {{std::char::scalar_value std::str::length} 1 {0 {the registered result set of std::char::scalar_value changed}}}

test ec-syntax-recovery {a program with a syntax error is analyzed past it (the compiler service's partial revisions): a claim whose code is intact is still certified, one whose code holds the malformed statement is dependent, never certified} -body {
    set dir [emit::workspace main.bot "${::digitDfa}type DigitValue = Int in 0..9\n\nfn good(d: DigitValue) -> unit emits digit_token:\n    yield 48 + d\n    unit\n\nfn broken(d: DigitValue) -> unit emits digit_token:\n    x = = 3\n    yield 48 + d\n    unit\n\n0\n"]
    set hir [surface::readProgramFile [file join $dir main.bot] -warnings off -strict 0 -recover-syntax 1]
    lmap r [hir::emission::claims $hir] {list [dict get $r function] [dict get $r verdict]}
} -result {{good proven} {broken dependent}}

test ec-clause-coexists {the clause beside the other parts of a declaration: private, nomethod, a proof clause, errors -- each keeps its meaning, the claim is certified} -body {
    set hir [surface::compile "${::digitDfa}error Bad:\n    v: int\n\nprivate nomethod fn d(x: int) -> unit errors Bad emits digit_token:\n    if x < 0 or x > 9:\n        fail Bad {v: x}\n    yield 48 + x\n    unit\n\nrefined type Small = int\n\nfn small?(x: int) -> bool proves x: Small:\n    x < 10\n\n0\n" -warnings off]
    set block [dict get [lindex [hir::emission::claims $hir] 0] block]
    list [lmap r [hir::emission::claims $hir] {list [dict get $r function] [dict get $r verdict]}] \
        [dict get $hir exprs $block declaredErrors] [dict exists $hir exprs $block nomethod]
} -result {{{d proven}} Bad 1}

test ec-fingerprint {a function's fingerprint ignores comments and unrelated code, and changes with a constant, and with the declared type of a module binding it reads} -body {
    set out {}
    foreach text [list "fn f(n: int) -> int:\n    48 + n\n\n0\n" \
            "# a comment\nfn g() -> int:\n    5\n\nfn f(n: int) -> int:\n    # another\n    48 + n\n\n0\n" \
            "fn f(n: int) -> int:\n    49 + n\n\n0\n"] {
        set hir [surface::compile $text -warnings off -strict 0]
        hir::emission::Reset $hir
        lappend out [hir::emission::FunctionFingerprint [dict get $::hir::emission::byName f]]
    }
    set fps {}
    foreach domain {"Int in 0..9" "Int in 0..10"} {
        set dir [emit::workspace main.bot "import m\n\nfn f() -> int:\n    m::k\n\n0\n" m.bot "type K = $domain\n\nfn make() -> K:\n    3\n\nk = make()\n"]
        set hir [emit::compile [file join $dir main.bot]]
        hir::emission::Reset $hir
        lappend fps [hir::emission::FunctionFingerprint [dict get $::hir::emission::byName f]]
    }
    list [expr {[lindex $out 0] eq [lindex $out 1]}] [expr {[lindex $out 0] ne [lindex $out 2]}] [expr {[lindex $fps 0] ne [lindex $fps 1]}]
} -result {1 1 1}

test ec-exploratory-false-proofs {the exploratory checker certified a symbol of 10^23 and a quotation mark after a caught failure, for this very program; the compiler rejects both} -body {
    verdicts [program {error Oops:
    at: int

fn h(n: int) -> unit errors Oops:
    yield 34
    if n > 0:
        fail Oops {at: 1}
    unit

fn s(n: int) -> unit emits json_lex::json_string:
    yield 34
    h(n):
        on Oops:
            yield 34
    unit

fn big() -> unit emits json_lex::json_number:
    yield 49
    yield 100000000000000000000000
    unit

fn src(n: int) -> int:
    s(n)
    big()
    -1

coroutine {step, first} = src(1)
first} {json_lex}]
} -result {{s rejected} {big rejected}}

# ---------------------------------------------------------------------------
# Erasure

test ec-claim-erased {a claim is erased: the JSON emitters with and without their claims lower to the same core IR} -body {
    set dir [emit::workspace main.bot "import value_emit\nimport emitlib\n\n0\n"]
    set a [hir::lower [emit::compile [file join $dir main.bot]]]
    foreach f {number_emit string_emit value_emit emitlib} {
        set path [file join $dir $f.bot]
        emit::writeText $path [emit::strip [readFile $path]]
    }
    set hir [emit::compile [file join $dir main.bot]]
    set b [hir::lower $hir]
    list [expr {$a eq $b}] [llength [hir::emission::claims $hir]] [expr {[string length $a] > 10000}]
} -result {1 0 1}

test ec-native-erasure {a certified emitter's fused code holds no transition of its grammar, and is the code of the same emitter without its claim} -constraints nativeCoroutines -body {
    set main "import emitlib\nimport std::coroutine\n\nfn text(t: str) -> int errors IndexNotFound:\n    coroutine {step, first} = emitlib::json_string_source(t)\n    n = first\n    loop:\n        if std::coroutine::done?(step):\n            break\n        step()\n        continue\n    n\n\ntext(\"a\\\"b\"):\n    on IndexNotFound:\n        -2\n"
    set dir [emit::workspace main.bot $main]
    set nir [native::fusedNir [surface::readProgramFile [file join $dir main.bot] -warnings off]]
    set lib [file join $dir emitlib.bot]
    emit::writeText $lib [emit::strip [readFile $lib]]
    set bare [native::fusedNir [surface::readProgramFile [file join $dir main.bot] -warnings off]]
    list [regexp -all {rtabload} $nir] [regexp -all -line {^\s*switch } $nir] [regexp -all {dfa#transition} $nir] [expr {$nir eq $bare}]
} -result {0 0 0 1}

# ---------------------------------------------------------------------------
# The clause

proc parsedEmits {text} {
    set ast [surface::parse $text]
    return [lmap s [dict get $ast body] {
        if {[dict get $s kind] ne "function"} continue
        lmap c [dict get $s emits] {list [dict get $c name] [dict get $c qualified] [dict get $c rooted]}
    }]
}

test ec-syntax-forms {`emits R, ...` after the result type and `errors`, or alone; qualified and rooted names; `emits` an ordinary name everywhere else} -body {
    list [parsedEmits "fn a() -> unit emits r:\n    unit\nfn b() -> unit errors E emits ns::r, ::x::y::z:\n    unit\nfn c() emits r:\n    unit\nfn d(emits: int) -> int:\n    emits\n"] \
        [expr {[dict get [surface::compile "emits = 2\nfn f(emits: int) -> int:\n    emits + 1\nf(emits)\n" -warnings off] roots] ne {}}]
} -result {{{{r {} 0}} {{ns::r {ns r} 0} {x::y::z {x::y z} 1}} {{r {} 0}} {}} 1}

proc syntaxError {text} {
    if {[catch {surface::parse $text} message options]} {
        return [list [lrange [dict get $options -errorcode] 0 1] $message]
    }
    return ok
}

test ec-syntax-errors {the clause's order is errors then emits; one clause; a recognizer's name after it; a rooted name has a namespace} -body {
    list [syntaxError "fn a() -> unit emits r errors E:\n    unit\n"] [syntaxError "fn a() -> unit emits r emits s:\n    unit\n"] \
        [syntaxError "fn a() -> unit emits:\n    unit\n"] [lindex [syntaxError "fn a() -> unit emits ::r:\n    unit\n"] 0]
} -result {{{SURFACE SYNTAX} {<input>:1:24: a function's "errors" declaration comes before its emission claims: write "errors E emits R"}} {{SURFACE SYNTAX} {<input>:1:24: a function's emission claims are one clause: write "emits R1, R2"}} {{SURFACE SYNTAX} {<input>:1:21: expected the name of a recognizer after "emits", found ":"}} {SURFACE SYNTAX}}

# {KIND LINE:COLUMN} of every diagnostic of the program TEXT (one file).
proc diagnosticsOf {text} {
    set hir [surface::compile $text -warnings off -strict 0]
    return [lmap d [dict get $hir diagnostics] {
        set origin [hir::static::PrimaryOrigin $hir $d]
        list [dict get $d kind] [dict get [lrange $origin 2 end] line]:[dict get [lrange $origin 2 end] column]
    }]
}


test ec-recognizer-resolution {a claim names a recognizer: an unknown name, an ordinary function, one declared after the function, one claimed twice -- each EMIT-RECOGNIZER at the claim} -body {
    list [diagnosticsOf "${digitDfa}fn a() -> unit emits nothing:\n    yield 49\n    unit\n\n0\n"] \
        [diagnosticsOf "${digitDfa}fn helper() -> unit:\n    yield 49\n    unit\n\nfn a() -> unit emits helper:\n    yield 49\n    unit\n\n0\n"] \
        [diagnosticsOf "import std::dfa\n\nfn a() -> unit emits later:\n    yield 49\n    unit\n\ndfa later over ascii:\n    start:\n        '1' -> accept\n\n0\n"] \
        [diagnosticsOf "${digitDfa}fn a() -> unit emits digit_token, digit_token:\n    yield 49\n    unit\n\n0\n"]
} -result {{{EMIT-RECOGNIZER 9:22}} {{EMIT-RECOGNIZER 13:22}} {{EMIT-RECOGNIZER 3:22}} {{EMIT-RECOGNIZER 9:35}}}

test ec-recognizer-later-message {the message of a forward reference says so} -body {
    set hir [surface::compile "import std::dfa\n\nfn a() -> unit emits later:\n    yield 49\n    unit\n\ndfa later over ascii:\n    start:\n        '1' -> accept\n\n0\n" -warnings off -strict 0]
    string match "*\"later\" is declared later*" [dict get [lindex [dict get $hir diagnostics] 0] message]
} -result 1

test ec-recognizer-import {a module's recognizer is named NS::NAME after `import NS`, the loader's rule for every qualified name: without the import, MISSING-IMPORT; a rooted name resolves the same} -body {
    set dir [emit::workspace main.bot "fn a() -> unit emits json_grammar::digit_symbol:\n    yield 49\n    unit\n\n0\n" \
        rooted.bot "import json_grammar\n\nfn a() -> unit emits ::json_grammar::digit_symbol:\n    yield 49\n    unit\n\n0\n"]
    catch {emit::compile [file join $dir main.bot]} message options
    list [lindex [dict get $options -errorcode] end] [emit::results [emit::compile [file join $dir rooted.bot]] rooted.bot]
} -result {MISSING-IMPORT {{a proven {}}}}

test ec-strict-raises {a strict compilation of a rejected claim raises its diagnostic, located at the yield, with the claim and the recognizer's state as related data} -body {
    catch {surface::compile "${digitDfa}type Nibble = Int in 0..15\n\nfn a(d: Nibble) -> unit emits digit_token:\n    yield 48 + d\n    unit\n\n0\n" -warnings off} message options
    set entry [lindex [dict get $options -diagnostics] 0]
    list [dict get $options -errorcode] [dict get $entry location line] [dict get $entry location column] \
        [llength [dict get $entry related]] [lmap n [dict get $entry notes] {dict get $n summary}]
} -result {{CORE SEMANTIC EMIT-REJECTED} 12 5 1 {{state start of digit_token is declared here}}}

test ec-nested-function {a claim on a nested function is checked from its own declaration; what it captures is read through its type} -body {
    set hir [surface::compile "${digitDfa}fn outer(k: int) -> int:\n    fn inner(d: int) -> unit emits digit_token:\n        if d >= 0 and d <= 9:\n            yield 48 + d\n        else:\n            yield 48 + k\n        unit\n    3\n\n0\n" -warnings off -strict 0]
    lmap r [hir::emission::claims $hir] {list [dict get $r function] [dict get $r verdict]}
} -result {{inner rejected}}

test ec-recovery-dependent {a claim whose code holds another diagnostic says nothing more (dependent); an independent claim in the same program is still reported} -body {
    set hir [surface::compile "${digitDfa}fn a() -> unit emits digit_token:\n    yield 48 + \"x\"\n    unit\n\nfn b(d: int) -> unit emits digit_token:\n    yield 48 + d\n    unit\n\n0\n" -warnings off -strict 0]
    list [lmap d [hir::recovery::reported $hir] {dict get $d kind}] \
        [lmap r [hir::emission::claims $hir] {list [dict get $r function] [dict get $r verdict]}]
} -result {{TYPE EMIT-END-SYMBOL EMIT-REJECTED} {{a dependent} {b rejected}}}

# ---------------------------------------------------------------------------
# Unresolved callees (EMISSION-CALLEE-DEPENDENCY-CORRECTNESS-MILESTONE-1.md)
#
# An unresolved name is typed `never` with no target (DIAGNOSTIC-RECOVERY.md,
# section 2): to every other analysis a divergence. A claim whose walk reads
# such a call -- directly, in any position, or through a helper whose code
# holds one -- is dependent on the UNBOUND, which stays the one diagnostic:
# never proven (the walk stopping at the `never`), never rejected (the walk
# missing what the call does), no certificate, no EMIT diagnostic.

# The program TEXT compiled leniently: {REPORTED CLAIMS EMIT}: the kinds of
# the diagnostics a rejecting compilation reports (hir::recovery::reported),
# each claim's {NAME VERDICT CERTIFIED} (1 when its record holds a
# certificate), and the kinds of the emission checker's own diagnostics in
# the HIR, reported or not.
proc dependency {text} {
    set hir [surface::compile $text -warnings off -strict 0]
    list [lmap d [hir::recovery::reported $hir] {dict get $d kind}] \
        [lmap r [hir::emission::claims $hir] {list [dict get $r function] [dict get $r verdict] [dict exists $r certificate]}] \
        [lmap d [dict get $hir diagnostics] {if {![dict exists $d emission]} continue; dict get $d kind}]
}

test ec-callee-unbound {a claimed function calling a name declared later (a forward reference) or never declared: UNBOUND, the claim dependent, no certificate, nothing memoized -- this was "proven": the call's never ended the walk before its yield} -setup {
    set ::hir::emission::memo [dict create]
} -body {
    set forward "${digitDfa}fn emitter() -> unit emits digit_token:\n    later()\n    yield 49\n    unit\n\nfn later() -> unit:\n    unit\n\n0\n"
    set out [list [dependency $forward] \
        [dependency "${digitDfa}fn emitter() -> unit emits digit_token:\n    missing()\n    yield 49\n    unit\n\n0\n"]]
    set hir [surface::compile $forward -warnings off -strict 0]
    set d [lindex [hir::recovery::reported $hir] 0]
    set origin [lrange [hir::static::PrimaryOrigin $hir $d] 2 end]
    lappend out [dict get $origin line]:[dict get $origin column] [string match "*\"later\" is declared later*" [dict get $d message]] \
        [dict size $::hir::emission::memo]
} -result {{UNBOUND {{emitter dependent 0}} {}} {UNBOUND {{emitter dependent 0}} {}} 10:5 1 0}

test ec-callee-positions {an unresolved call makes the claim dependent wherever the walk reads it: inside an expression, a condition, after a yield, in a handled call, as an argument, in a loop body, with a coroutine handle} -body {
    set D "${digitDfa}error Oops:\n    v: int\n\nfn h(x: int) -> unit:\n    unit\n\nfn src() -> int:\n    yield 7\n    0\n\n"
    lmap body [list "    yield 48 + missing()" \
            "    if missing():\n        yield 49\n    else:\n        yield 50" \
            "    yield 49\n    missing()" \
            "    missing():\n        on Oops:\n            unit\n    yield 49" \
            "    h(missing())\n    yield 49" \
            "    loop i from 0 to 3:\n        missing()\n        continue\n    yield 49" \
            "    coroutine {step, first} = src()\n    missing(step)\n    yield 49"] {
        lrange [dependency "import std::coroutine\n${D}fn emitter() -> unit emits digit_token:\n$body\n    unit\n\n0\n"] 0 1
    }
} -result {{UNBOUND {{emitter dependent 0}}} {UNBOUND {{emitter dependent 0}}} {UNBOUND {{emitter dependent 0}}} {UNBOUND {{emitter dependent 0}}} {UNBOUND {{emitter dependent 0}}} {UNBOUND {{emitter dependent 0}}} {UNBOUND {{emitter dependent 0}}}}

test ec-callee-helpers {the dependency follows the helpers the walk reads: a helper declared to return, one whose inferred result is never because of the unresolved call (its body was never read: "proven"), two levels down, a yielding helper (this was "rejected", an EMIT-INCOMPLETE the walk made up), recursion -- every one dependent, with no EMIT diagnostic} -body {
    lmap helper [list "fn helper() -> unit:\n    missing()\n    unit\n\nfn emitter() -> unit emits digit_token:\n    helper()\n    yield 49\n    unit" \
            "fn helper():\n    missing()\n\nfn emitter() -> unit emits digit_token:\n    helper()\n    yield 49\n    unit" \
            "fn h2():\n    missing()\n\nfn helper() -> unit:\n    h2()\n    unit\n\nfn emitter() -> unit emits digit_token:\n    yield 49\n    helper()\n    unit" \
            "fn helper() -> unit:\n    missing()\n    yield 49\n    unit\n\nfn emitter() -> unit emits digit_token:\n    helper()\n    unit" \
            "fn r(n: int) -> unit:\n    if n > 0:\n        r(n - 1)\n    else:\n        missing()\n    unit\n\nfn emitter(n: int) -> unit emits digit_token:\n    r(n)\n    yield 49\n    unit" \
            "fn r(n: int) -> unit:\n    if n > 0:\n        r(n - 1)\n    else:\n        missing()\n        yield 49\n    unit\n\nfn emitter(n: int) -> unit emits digit_token:\n    r(n)\n    unit"] {
        dependency "${digitDfa}$helper\n\n0\n"
    }
} -result {{UNBOUND {{emitter dependent 0}} {}} {UNBOUND {{emitter dependent 0}} {}} {UNBOUND {{emitter dependent 0}} {}} {UNBOUND {{emitter dependent 0}} {}} {UNBOUND {{emitter dependent 0}} {}} {UNBOUND {{emitter dependent 0}} {}}}

test ec-callee-independent {the dependency is the walk's, not the program's: a claim that reads no unresolved call is decided as ever beside one that does; a helper's clean summary, reused by a later claim after a claim that also called the unresolved name, stays clean; a tainted helper's summary, reused, stays tainted} -body {
    set text "${digitDfa}type DigitValue = Int in 0..9\n\nfn helper(d: DigitValue) -> unit:\n    yield 48 + d\n    unit\n\nfn broken() -> unit:\n    missing()\n    yield 49\n    unit\n\nfn a() -> unit emits digit_token:\n    helper(1)\n    missing()\n    unit\n\nfn b() -> unit emits digit_token:\n    helper(1)\n    unit\n\nfn c() -> unit emits digit_token:\n    broken()\n    unit\n\nfn d() -> unit emits digit_token:\n    broken()\n    unit\n\nfn e(n: int) -> unit emits digit_token:\n    yield 48 + n\n    unit\n\n0\n"
    list [dependency $text] [expr {[dict get $::hir::emission::stats summariesReused] > 0}]
} -result {{{UNBOUND UNBOUND EMIT-END-SYMBOL EMIT-REJECTED} {{a dependent 0} {b proven 1} {c dependent 0} {d dependent 0} {e rejected 0}} {EMIT-END-SYMBOL EMIT-REJECTED}} 1}

test ec-callee-genuine-nonreturn {a call that genuinely never returns still ends the trace: a helper whose inferred result is never (a loop without end, a recursion without end) -- the claim proven, a yield after the call unreachable -- and the never helper's code is part of the proof (its certificate depends on it); its code is read, not judged: a trait operation it calls, which the checker cannot follow, does not make the claim not proved (an accepted program stays accepted); a helper declared to return that loops is walked past, as before} -setup {
    set ::hir::emission::memo [dict create]
} -body {
    set out [lmap helper [list "fn spin():\n    loop:\n        continue" \
            "fn forever(n: int):\n    forever(n + 1)\n\nfn spin():\n    forever(0)"] {
        lrange [dependency "${digitDfa}$helper\n\nfn emitter() -> unit emits digit_token:\n    yield 49\n    spin()\n    yield 65\n    unit\n\n0\n"] 1 2
    }]
    lappend out [dict keys [dict get $::hir::emission::memo {emitter digit_token} depends functions]]
    set hir [surface::compile "${digitDfa}trait Coded:\n    fn code(self: Coded) -> int\n\nstruct Seven:\n    unused: int\n\nfn code(s: Seven) -> int:\n    55\n\nfn spin(c: Coded):\n    k = c.code()\n    loop:\n        continue\n\nfn emitter() -> unit emits digit_token:\n    yield 49\n    spin(Seven {unused: 0})\n    unit\n\n0\n" -warnings off]
    lappend out [lmap r [hir::emission::claims $hir] {list [dict get $r function] [dict get $r verdict]}]
    lappend out [lrange [dependency "${digitDfa}fn spin() -> unit:\n    loop:\n        continue\n    unit\n\nfn emitter() -> unit emits digit_token:\n    yield 49\n    spin()\n    unit\n\n0\n"] 1 2]
} -result {{{{emitter proven 1}} {}} {{{emitter proven 1}} {}} {emitter forever spin} {{emitter proven}} {{{emitter proven 1}} {}}}

test ec-callee-unreachable {an unresolved call the walk never reads -- in a branch decided false, after a call that genuinely never returns -- is no part of the proof: the claim proven, the UNBOUND reported; the same as a TYPE diagnostic there} -body {
    lmap body [list "    yield 49\n    if false:\n        missing()" \
            "    yield 49\n    if false:\n        x = 48 + \"x\"" \
            "    yield 49\n    spin()\n    missing()"] {
        lrange [dependency "${digitDfa}fn spin():\n    loop:\n        continue\n\nfn emitter() -> unit emits digit_token:\n$body\n    unit\n\n0\n"] 0 1
    }
} -result {{UNBOUND {{emitter proven 1}}} {TYPE {{emitter proven 1}}} {UNBOUND {{emitter proven 1}}}}

test ec-callee-independent-path {a claim the walk finds an unresolved call in is dependent even where another path holds a violation of its own -- the existing rule, a TYPE diagnostic there makes it dependent too; once the name resolves, the violation is reported} -body {
    set body "fn emitter(n: int) -> unit emits digit_token:\n    if n > 0:\n        %s\n    yield 65\n    unit\n\n0\n"
    list [dependency "${digitDfa}[format $body missing()]"] [dependency "${digitDfa}[format $body {x = 48 + "x"}]"] \
        [dependency "${digitDfa}fn missing() -> unit:\n    unit\n\n[format $body missing()]"]
} -result {{UNBOUND {{emitter dependent 0}} {}} {TYPE {{emitter dependent 0}} {}} {EMIT-REJECTED {{emitter rejected 0}} EMIT-REJECTED}}

test ec-callee-multiple-claims {every claim of a function whose code reads an unresolved call is dependent; another function's two claims are proven} -body {
    dependency "${digitDfa}dfa one over ascii:\n    start:\n        '1' -> accept\n\nfn emitter() -> unit emits digit_token, one:\n    missing()\n    yield 49\n    unit\n\nfn good() -> unit emits digit_token, one:\n    yield 49\n    unit\n\n0\n"
} -result {UNBOUND {{emitter dependent 0} {emitter dependent 0} {good proven 1} {good proven 1}} {}}

test ec-callee-coroutine {a coroutine constructed from an unresolved name: dependent; one constructed from a function whose code holds one: its yields are its own (the boundary), the constructor's claim proven; a claimed coroutine source whose own code holds one: dependent} -body {
    set D "import std::coroutine\n${digitDfa}fn src() -> int:\n    yield 7\n    missing()\n    0\n\n"
    list [lrange [dependency "${D}fn emitter() -> unit emits digit_token:\n    coroutine {step, first} = absent()\n    yield 49\n    unit\n\n0\n"] 1 1] \
        [lrange [dependency "${D}fn emitter() -> unit emits digit_token:\n    coroutine {step, first} = src()\n    step()\n    yield 49\n    unit\n\n0\n"] 1 1] \
        [lrange [dependency "import std::coroutine\n${digitDfa}fn source() -> int emits digit_token:\n    missing()\n    yield 49\n    0\n\nfn consumer() -> int:\n    coroutine {step, first} = source()\n    first\n\n0\n"] 1 1]
} -result {{{{emitter dependent 0}}} {{{emitter proven 1}}} {{{source dependent 0}}}}

test ec-callee-memo {the in-process memo across the dependency: a certificate is never reused for code that calls an unresolved name, the claim proved again once it resolves (reused: the code is what it was); a never helper's code is a dependency of the certificate that read it -- it gains an unresolved call, the claim is dependent (this reused the certificate); an unrelated function changes nothing} -setup {
    set ::hir::emission::memo [dict create]
} -body {
    set dir [emit::workspace]
    set path [file join $dir main.bot]
    set before "${digitDfa}fn later() -> unit:\n    unit\n\nfn emitter() -> unit emits digit_token:\n    later()\n    yield 49\n    unit\n\n0\n"
    set after "${digitDfa}fn emitter() -> unit emits digit_token:\n    later()\n    yield 49\n    unit\n\nfn later() -> unit:\n    unit\n\n0\n"
    set out {}
    foreach text [list $before $after $before] {
        emit::writeText $path $text
        lappend out [reuse $path]
    }
    set ::hir::emission::memo [dict create]
    set spin "fn h():\n    loop:\n        continue"
    set program "${digitDfa}%s\n\nfn emitter() -> unit emits digit_token:\n    yield 49\n    h()\n    unit\n\n0\n"
    foreach helper [list $spin "fn h():\n    missing()" $spin "$spin\n\nfn other() -> int:\n    3"] {
        emit::writeText $path [format $program $helper]
        lappend out [reuse $path]
    }
    set out
} -result {{{emitter proven 0}} {{emitter dependent 0}} {{emitter proven 1}} {{emitter proven 0}} {{emitter dependent 0}} {{emitter proven 1}} {{emitter proven 1}}}

test ec-callee-interchange {a lenient HIR whose claim is dependent on an unresolved call reads back from interchange text verified again, the claim dependent; the dependent record forged proven, with a certificate, is refused} -body {
    set hir [surface::compile "${digitDfa}fn emitter() -> unit emits digit_token:\n    missing()\n    yield 49\n    unit\n\nfn good() -> unit emits digit_token:\n    yield 49\n    unit\n\n0\n" -warnings off -strict 0]
    set back [hir::interchange::decode [hir::interchange::encode $hir]]
    set records [dict get $hir emissions]
    set forged [lmap r $records {
        if {[dict get $r verdict] eq "dependent"} {
            dict set r verdict proven
            dict set r certificate [dict get [lindex $records 1] certificate]
        }
        set r
    }]
    list [expr {$back eq $hir}] [lmap r [hir::emission::claims $back] {dict get $r verdict}] \
        [catch {hir::interchange::decode [hir::interchange::encode [dict replace $hir emissions $forged]]} m o] [dict get $o -errorcode]
} -result {1 {dependent proven} 1 {HIR INTERCHANGE EMISSION}}

test ec-callee-cache {the front-end cache across the dependency: the certified program is cached; the edit that leaves the call unresolved is a miss and raises UNBOUND, never a cached certificate; the repaired program reads its entry again, verified, proven} -body {
    set dir [emit::workspace]
    set path [file join $dir main.bot]
    set cache [file join $dir cache]
    file mkdir $cache
    set good "${digitDfa}fn later() -> unit:\n    unit\n\nfn emitter() -> unit emits digit_token:\n    later()\n    yield 49\n    unit\n\n0\n"
    set bad "${digitDfa}fn emitter() -> unit emits digit_token:\n    later()\n    yield 49\n    unit\n\nfn later() -> unit:\n    unit\n\n0\n"
    set out {}
    foreach text [list $good $bad $good] {
        emit::writeText $path $text
        set hits [dict get $::surface::cache::stats hits]
        if {[catch {surface::readProgramFile $path -warnings off -cache $cache} hir options]} {
            lappend out [lindex [dict get $options -errorcode] end]
        } else {
            lappend out [list [expr {[dict get $::surface::cache::stats hits] - $hits}] [lmap r [hir::emission::claims $hir] {dict get $r verdict}]]
        }
    }
    set out
} -result {{0 proven} UNBOUND {1 proven}}

test ec-callee-static-compile {a claim in a static compile block calling an unresolved name rejects the block with UNBOUND, its first diagnostic, never an EMIT code; a claimed function holding a rejected static compile block whose body calls one is certified: the block's diagnostics are its own, its failure a failure point} -body {
    set a [surface::compile "import std::compiler\n${digitDfa}fn probe() -> str errors std::compiler::CompilerError:\n    static compile:\n        fn bad() -> unit emits digit_token:\n            missing()\n            yield 49\n            unit\n        0\n    \"accepted\"\n\nprobe():\n    on std::compiler::CompilerError {code}:\n        \"rejected\"\n" -warnings off]
    set b [surface::compile "import std::compiler\n${digitDfa}fn emitter() -> unit errors std::compiler::CompilerError emits digit_token:\n    static compile:\n        missing()\n    yield 49\n    unit\n\n0\n" -warnings off]
    list [lmap {key site} [hir::static::sites $a] {list [dict get $site outcome] [dict get $site diagnostic kind]}] \
        [lmap {key site} [hir::static::sites $b] {list [dict get $site outcome] [dict get $site diagnostic kind]}] \
        [lmap r [hir::emission::claims $b] {list [dict get $r function] [dict get $r verdict]}] [dict get $b diagnostics]
} -result {{{rejected UNBOUND}} {{rejected UNBOUND}} {{emitter proven}} {}}

test ec-callee-syntax-recovery {a partial revision (a syntax error elsewhere) with an unresolved call: the claim that reads it is dependent, an intact one proven; a malformed call is a hole, dependent as before} -body {
    set dir [emit::workspace main.bot "${digitDfa}fn good() -> unit emits digit_token:\n    yield 49\n    unit\n\nfn emitter() -> unit emits digit_token:\n    missing()\n    yield 49\n    unit\n\nfn malformed() -> unit emits digit_token:\n    missing(1 +)\n    yield 49\n    unit\n\nfn other() -> unit:\n    x = = 3\n    unit\n\n0\n"]
    set hir [surface::readProgramFile [file join $dir main.bot] -warnings off -strict 0 -recover-syntax 1]
    lmap r [hir::emission::claims $hir] {list [dict get $r function] [dict get $r verdict]}
} -result {{good proven} {emitter dependent} {malformed dependent}}

test ec-callee-service {the compiler service's hover shows the current verdict: an unresolved call, not checked; resolved by an edit, certified; unresolved again, not checked; an independent claim certified throughout, also in a partial revision} -body {
    set dir [emit::workspace main.bot "0\n"]
    set path [file join $dir main.bot]
    set ws [service::workspace -root $dir]
    set good "fn good() -> unit emits digit_token:\n    yield 49\n    unit\n\n"
    set emitter "fn emitter() -> unit emits digit_token:\n    later()\n    yield 49\n    unit\n\n"
    set later "fn later() -> unit:\n    unit\n\n"
    set out {}
    # {TEXT LINE-OF-EMITTER}: the emitter at line 13 before later, 16 after it.
    foreach {text line} [list "${digitDfa}$good$emitter${later}0\n" 13 "${digitDfa}$good$later${emitter}0\n" 16 \
            "${digitDfa}$good$emitter${later}0\n" 13 "${digitDfa}$good$emitter${later}fn other() -> unit:\n    x = = 3\n    unit\n\n0\n" 13] {
        service::setDocument $ws $path $text
        set rev [service::analyze $ws $path]
        lappend out [list [lmap d [service::diagnostics $rev] {lindex [dict get $d code] end}] \
            [lindex [split [dict get [service::at $rev $path 9 4] hover] \n] 1] \
            [lindex [split [dict get [service::at $rev $path $line 4] hover] \n] 1]]
    }
    service::closeWorkspace $ws
    set out
} -result {{UNBOUND {emits digit_token: certified to emit digit_token: every normal completion has yielded exactly one token, every prefix it yields is viable; its token completes on its own last symbol} {emits digit_token: not checked -- its code holds another diagnostic}} {{} {emits digit_token: certified to emit digit_token: every normal completion has yielded exactly one token, every prefix it yields is viable; its token completes on its own last symbol} {emits digit_token: certified to emit digit_token: every normal completion has yielded exactly one token, every prefix it yields is viable; its token completes on its own last symbol}} {UNBOUND {emits digit_token: certified to emit digit_token: every normal completion has yielded exactly one token, every prefix it yields is viable; its token completes on its own last symbol} {emits digit_token: not checked -- its code holds another diagnostic}} {{SYNTAX UNBOUND} {emits digit_token: certified to emit digit_token: every normal completion has yielded exactly one token, every prefix it yields is viable; its token completes on its own last symbol} {emits digit_token: not checked -- its code holds another diagnostic}}}

# ---------------------------------------------------------------------------
# Function identity and branch feasibility (EMISSION-IDENTITY-AND-
# FEASIBILITY-CORRECTNESS-MILESTONE-1.md)
#
# Two representation ambiguities made accepted programs carry false
# certificates (EMISSION-BINDING-AND-SIGNATURE-DEPENDENCY-CENSUS-
# MILESTONE-1.md, sections 13.3, 13.4, 15.3):
#
# * a function's name identified it in the memo, the certificate table and
#   a certificate's dependencies -- two functions of one name in different
#   lexical scopes shared a certificate. A name that identifies no function
#   now selects nothing: the claim is proved from its own code, a call
#   walks the body it names, a proof that read such a name is not
#   memoized;
# * `Facts` answered "" both for an infeasible branch and for a feasible
#   one through an environment with no binding -- a function without
#   parameters lost both branches of its first `if`. It now answers a
#   feasibility flag beside the environment.
#
# The census's programs are named after its cases (N1 ... N6, F1 ... F4).

# The run of TEXT with every claim erased, on the Tcl backends and, with
# native coroutines, the native ones (one outcome on all of them): {SYMBOLS
# JUDGMENT}, the program's value (a List of symbols) judged against
# RECOGNIZER by the reference interpreter -- `ok` or `invalid`.
proc erasedRun {text {recognizer digit_token}} {
    set stripped [emit::strip $text]
    set dir [emit::workspace main.bot $stripped]
    set model [emit::reference $dir]
    set backends {interp compile}
    if {[testConstraint nativeCoroutines]} {
        lappend backends cranelift-generic cranelift
    }
    lassign [sourceAgree $stripped $backends] tag value
    if {$tag ne "value"} {
        return [list $tag $value]
    }
    set symbols [lmap x [split [string trim $value {[]}] ,] {string trim $x}]
    return [list $symbols [lindex [emit::judge $model [list "" $recognizer] complete $symbols] 0]]
}

# The value of a function whose coroutine is CALL: [first], [first, second]
# or [first, second, -9] (more than two symbols), as a block of
# statements indented by INDENT.
proc collector {call {indent ""}} {
    set lines [list "coroutine {step: k, first} = $call" "second = k()" "if std::coroutine::done?(k):" \
        "    \[first\]" "else:" "    third = k()" "    if std::coroutine::done?(k):" "        \[first, second\]" \
        "    else:" "        \[first, second, -9\]"]
    return [join [lmap l $lines {string cat $indent $l}] \n]\n
}

# {NAME VERDICT CERTIFIED}... of TEXT's claims, compiled in memory with the
# memo as it is.
proc identity {text} {
    set hir [surface::compile $text -warnings off -strict 0]
    return [lmap r [hir::emission::claims $hir] {
        list [dict get $r function] [dict get $r verdict] [dict exists $r certificate]
    }]
}

# The strict outcome of TEXT: accepted, or the kind it raises.
proc strictOf {text} {
    if {[catch {surface::compile $text -warnings off} message options]} {
        return [lindex [dict get $options -errorcode] end]
    }
    return accepted
}

set coDfa "import std::coroutine\n$digitDfa"
set ::idN1 [string cat $digitDfa {fn outer1() -> int:
    fn inner() -> unit emits digit_token:
        yield 49
        unit
    3

fn outer2() -> int:
    fn inner() -> unit emits digit_token:
        yield 65
        unit
    4

0
}]
set ::idN2 [string cat $coDfa {fn emitter() -> int emits digit_token:
    yield 49
    0

fn outer() -> List[int]:
    fn emitter() -> int emits digit_token:
        yield 65
        0
} [collector emitter() "    "] {
outer()
}]
set ::idN3 [string cat $digitDfa {fn outer() -> int:
    fn inner() -> unit emits digit_token:
        yield 49
        unit
    if true:
        fn inner() -> unit emits digit_token:
            yield 65
            unit
        2
    3

0
}]
# N4a/N4b: two nested helpers of one name; the claimed function calls
# outer2's, which N4b edits.
proc idN4 {symbol {otherName helper}} {
    return [string cat $::coDfa "fn outer1() -> int:\n    fn $otherName\(d: int) -> unit:\n        yield 49\n        unit\n    3\n\n" \
        "fn outer2() -> List\[int\]:\n    fn helper(d: int) -> unit:\n        yield $symbol\n        unit\n" \
        "    fn emitter() -> int emits digit_token:\n        helper(0)\n        0\n" [collector emitter() "    "] "\nouter2()\n"]
}
# N6a/N6b: one proof reads the nested `step` and, through g, the top-level
# one; N6b removes the nested one.
proc idN6 {nested} {
    set text [string cat "import std::coroutine\nimport std::dfa\n\nclass digit = '0'..'9'\nclass letter = 'A'..'Z'\n\n" \
        "dfa pair_token over ascii:\n    start:\n        digit -> second\n    second:\n        letter -> accept\n\n" \
        "fn step() -> unit:\n    yield 65\n    unit\n\nfn g() -> unit:\n    step()\n    unit\n\nfn outer() -> List\[int\]:\n"]
    if {$nested} {
        append text "    fn step() -> unit:\n        yield 49\n        unit\n"
    }
    return [string cat $text "    fn emitter() -> int emits pair_token:\n        step()\n        g()\n        0\n" \
        [collector emitter() "    "] "\nouter()\n"]
}

test ec-identity-same-name {two claimed functions of one name in different lexical scopes -- two nested ones, a top-level and a nested one, one shadowing another -- are each checked from their own code, with the memo on or off: the second, which yields 'A', is rejected (this reused the first's certificate, and the programs were accepted), and the top-level/nested pair's run, claims erased, is the invalid trace the rejection predicts} -setup {
    set ::hir::emission::memo [dict create]
} -body {
    set out {}
    foreach memo {1 0} {
        set ::hir::emission::useMemo $memo
        foreach text [list $::idN1 $::idN2 $::idN3] {
            set ::hir::emission::memo [dict create]
            lappend out [identity $text]
        }
    }
    set ::hir::emission::useMemo 1
    lappend out [lmap text [list $::idN1 $::idN2 $::idN3] {strictOf $text}] [erasedRun $::idN2]
} -cleanup {set ::hir::emission::useMemo 1} -result {{{inner proven 1} {inner rejected 0}} {{emitter proven 1} {emitter rejected 0}} {{inner proven 1} {inner rejected 0}} {{inner proven 1} {inner rejected 0}} {{emitter proven 1} {emitter rejected 0}} {{inner proven 1} {inner rejected 0}} {EMIT-REJECTED EMIT-REJECTED EMIT-REJECTED} {65 invalid}}

test ec-identity-memo-sequence {N4a then N4b in one process, the memo kept: N4b's edit of the helper its claim calls is proved again, and rejected (this validated the certificate against the other helper of the name, reused it, and accepted a program whose run yields 'A'); with unique helper names the certificate is memoized and reused, and validates against neither helper once the name is shared again (the first of the name has the code it recorded), nor the edited one} -setup {
    set ::hir::emission::memo [dict create]
} -body {
    set dir [emit::workspace]
    set path [file join $dir main.bot]
    set out {}
    foreach text [list [idN4 49] [idN4 65] [idN4 49 other] [idN4 49 other] [idN4 65] [idN4 65 other]] {
        emit::writeText $path $text
        lappend out [reuse $path]
    }
    lappend out [erasedRun [idN4 49]] [erasedRun [idN4 65]] [strictOf [idN4 65]]
} -result {{{emitter proven 0}} {{emitter rejected 0}} {{emitter proven 0}} {{emitter proven 1}} {{emitter rejected 0}} {{emitter rejected 0}} {49 ok} {65 invalid} EMIT-REJECTED}

test ec-identity-read-set {a proof that read two functions of one name -- the nested `step` and, through g, the top-level one -- is certified, but never memoized: its certificate records one fingerprint for the name, and a later compilation in which the name identifies the other function would validate it. N6b, without the nested step, is proved again and rejected; its run yields two letters (the census's prototype reused N6a's certificate here)} -setup {
    set ::hir::emission::memo [dict create]
} -body {
    set dir [emit::workspace]
    set path [file join $dir main.bot]
    set out {}
    emit::writeText $path [idN6 1]
    lappend out [reuse $path] [dict keys $::hir::emission::memo]
    emit::writeText $path [idN6 0]
    lappend out [reuse $path] [erasedRun [idN6 1] pair_token] [erasedRun [idN6 0] pair_token]
} -result {{{emitter proven 0}} {} {{emitter rejected 0}} {{49 65} ok} {{65 65} invalid}}

set ::idCompose [string cat "import std::coroutine\nimport std::dfa\n\nclass digit = '0'..'9'\n\n" \
    "dfa digit_token over ascii:\n    start:\n        digit -> accept\n\n" \
    "dfa two_digits over ascii:\n    start:\n        digit -> second\n    second:\n        digit -> accept\n\n" {fn h() -> unit emits digit_token:
    yield 49
    unit

fn plain() -> unit:
    yield 49
    unit

fn stop():
    loop:
        continue

fn g() -> unit:
    h()
    unit

fn outer1() -> int:
    fn h() -> unit emits digit_token:
        yield 50
        unit
    fn a() -> unit emits digit_token:
        h()
        unit
    3

fn outer2() -> int:
    fn h() -> unit emits digit_token:
        yield 65
        unit
    fn b() -> unit emits digit_token:
        h()
        unit
    4

fn outer3() -> int:
    fn plain() -> unit:
        yield 66
        unit
    fn c() -> unit emits digit_token:
        plain()
        unit
    5

fn outer4() -> int:
    fn h() -> unit emits digit_token:
        yield 50
        unit
    fn both() -> unit emits two_digits:
        h()
        g()
        unit
    6

fn outer5() -> int:
    fn stop() -> unit:
        unit
    fn d() -> unit emits digit_token:
        yield 49
        stop()
        yield 50
        unit
    7

fn e() -> unit emits digit_token:
    yield 49
    stop()
    yield 50
    unit

fn solo() -> unit emits digit_token:
    yield 49
    unit

0
}]

test ec-identity-composition {a call of a claimed helper whose name four functions share walks the body the call names, never the certificate the name finds: outer2's b, calling a helper yielding 'A', is rejected (it composed with another h's certificate and was proven); a helper without a claim is walked by block whatever its name (c); a proof reading both a nested and the top-level h is certified (both) but not memoized; a function that genuinely never returns still ends the walk (e: certified, not memoized, its proof read `stop`, a name of two functions), and its same-named returning sibling does not (d); a claim whose proof read only identified functions is memoized (solo)} -setup {
    set ::hir::emission::memo [dict create]
} -body {
    list [identity $::idCompose] [lsort [lmap k [dict keys $::hir::emission::memo] {lindex $k 0}]]
} -result {{{h proven 1} {h proven 1} {h rejected 0} {c rejected 0} {h proven 1} {d rejected 0} {e proven 1} {solo proven 1} {a proven 1} {b rejected 0} {both proven 1}} solo}

# A claimed d composing with a top-level h's certificate; then a nested h
# of the same name, yielding SYMBOL, beside d (d's call means it).
proc idComposed {nested} {
    set text [string cat $::coDfa "fn h() -> unit emits digit_token:\n    yield 49\n    unit\n\nfn outer() -> List\[int\]:\n"]
    if {$nested} {
        append text "    fn h() -> unit emits digit_token:\n        yield 65\n        unit\n"
    }
    return [string cat $text "    fn d() -> int emits digit_token:\n        h()\n        0\n" [collector d() "    "] "\nouter()\n"]
}

test ec-identity-certificate-dependency {a memoized certificate that composed with a helper's certificate is not validated through the helper's name once it is shared: d composed with the top-level h's certificate and was memoized; a nested h of the name, yielding 'A', now beside d (its call means it) -- d is proved again from the nested h's body, and rejected; its run yields 'A'} -setup {
    set ::hir::emission::memo [dict create]
} -body {
    set dir [emit::workspace]
    set path [file join $dir main.bot]
    set out {}
    foreach nested {0 1} {
        emit::writeText $path [idComposed $nested]
        lappend out [reuse $path] [lsort [lmap k [dict keys $::hir::emission::memo] {lindex $k 0}]]
    }
    lappend out [erasedRun [idComposed 0]] [erasedRun [idComposed 1]]
} -result {{{h proven 0} {d proven 0}} {d h} {{h proven 0} {h rejected 0} {d rejected 0}} {d h} {49 ok} {65 invalid}}

test ec-identity-qualified-reuse {functions of one name in different modules are qualified (a::emitter, b::emitter): identified, memoized and reused as ever; and duplicate names elsewhere in a program -- unclaimed, unread -- leave a uniquely named claim's reuse alone} -setup {
    set ::hir::emission::memo [dict create]
} -body {
    set dir [emit::workspace digits.bot "import std::dfa\n\nclass digit = '0'..'9'\n\ndfa digit_token over ascii:\n    start:\n        digit -> accept\n" \
        a.bot "import digits\n\nfn emitter() -> unit emits digits::digit_token:\n    yield 49\n    unit\n" \
        b.bot "import digits\n\nfn emitter() -> unit emits digits::digit_token:\n    yield 50\n    unit\n" \
        main.bot "import a\nimport b\n\n0\n" \
        dup.bot [string cat $::digitDfa "fn good() -> unit emits digit_token:\n    yield 49\n    unit\n\n" \
            "fn outer1() -> int:\n    fn tmp() -> int:\n        1\n    tmp()\n\nfn outer2() -> int:\n    fn tmp() -> int:\n        2\n    tmp()\n\n0\n"]]
    list [reuse [file join $dir main.bot]] [reuse [file join $dir main.bot]] \
        [reuse [file join $dir dup.bot]] [reuse [file join $dir dup.bot]]
} -result {{{emitter proven 0} {emitter proven 0}} {{emitter proven 1} {emitter proven 1}} {{good proven 0}} {{good proven 1}}}

# The programs of the memo-history test: a uniquely named claim beside two
# claims of one name (outer1's emitter, and outer2's, yielding SYMBOL); the
# program's value is outer2's emitter's run.
proc historyProgram {symbol {good "yield 48 + d"}} {
    return [string cat $::coDfa "type Digit = Int in 0..9\n\nfn good(d: Digit) -> unit emits digit_token:\n    $good\n    unit\n\n" \
        "fn outer1() -> int:\n    fn emitter() -> int emits digit_token:\n        yield 49\n        0\n    3\n\n" \
        "fn outer2() -> List\[int\]:\n    fn emitter() -> int emits digit_token:\n        yield $symbol\n        0\n" \
        [collector emitter() "    "] "\nouter2()\n"]
}

# What a compilation of the program at PATH decides, as data: each claim's
# record (verdict, certificate), the diagnostics' kinds, locations and
# messages, and the strict outcome.
proc decided {path} {
    set memo $::hir::emission::memo
    set hir [emit::compile $path]
    set records [hir::emission::claims $hir]
    set diags [lmap d [dict get $hir diagnostics] {list [dict get $d kind] [dict get $d origin] [dict get $d message]}]
    set ::hir::emission::memo $memo
    set strict accepted
    if {[catch {surface::readProgramFile $path -warnings off} message options]} {
        set strict [lindex [dict get $options -errorcode] end]
    }
    return [list $records $diags $strict]
}

# The verdicts of the program at PATH compiled by a fresh process.
proc freshProcess {path} {
    set script [file join [file dirname $path] fresh.tcl]
    emit::writeText $script {
set root [lindex $argv 0]
set path [lindex $argv 1]
set argv {}
source [file join $root tests helpers.tcl]
source [file join $root surface surface.tcl]
set hir [surface::readProgramFile $path -warnings off -strict 0]
puts [lmap r [hir::emission::claims $hir] {list [dict get $r function] [dict get $r verdict] [dict exists $r certificate]}]
}
    return [string trim [exec [info nameofexecutable] $script $::projectRoot $path]]
}

test ec-identity-memo-history {a compilation's verdicts, certificates, diagnostics and strict outcome are the same whatever this process compiled before -- a fresh process; an empty memo; a memo holding a certificate of the name from another program, whose function is top-level and has the code of the first of the two (a name's first function is what a validation by name compares), or is nested in another scope with other code; the program's earlier version; a version whose code differs elsewhere (another claim's body, a helper's name); an unrelated program -- for a rejected program with two claims of one name, its accepted version, whose run is valid, and N4b, whose verdict depended on the history (proven after N4a or after a version with unique helper names; rejected otherwise)} -setup {
    set ::hir::emission::memo [dict create]
} -body {
    set dir [emit::workspace]
    set path [file join $dir main.bot]
    set history [file join $dir history.bot]
    set unique [string cat $::digitDfa "type Digit = Int in 0..9\n\nfn good(d: Digit) -> unit emits digit_token:\n    yield 48 + d\n    unit\n\n" \
        "fn emitter() -> int emits digit_token:\n    yield 49\n    0\n\n0\n"]
    set scoped [string cat $::digitDfa "fn outer9() -> int:\n    fn emitter() -> int emits digit_token:\n        yield 51\n        0\n    9\n\n0\n"]
    set out {}
    foreach {final earlier changed} [list [historyProgram 65] [historyProgram 50] [historyProgram 65 "yield 47 + d + 1"] \
            [historyProgram 50] [historyProgram 65] [historyProgram 50 "yield 47 + d + 1"] \
            [idN4 65] [idN4 49] [idN4 49 other]] {
        emit::writeText $path $final
        set results {}
        set ::hir::emission::memo [dict create]
        lappend results fresh-memo [decided $path]
        foreach {name program} [list unique $unique another-scope $scoped earlier $earlier changed $changed \
                unrelated "import emitlib\n\n0\n"] {
            set ::hir::emission::memo [dict create]
            emit::writeText $history $program
            emit::compile $history
            lappend results $name [decided $path]
        }
        set reference [dict get $results fresh-memo]
        lappend out [lmap {name r} $results {expr {$r eq $reference}}] \
            [lmap r [lindex $reference 0] {list [dict get $r verdict] [dict exists $r certificate]}] [lindex $reference 2] \
            [expr {[freshProcess $path] eq [lmap r [lindex $reference 0] {list [dict get $r function] [dict get $r verdict] [dict exists $r certificate]}]}] \
            [erasedRun $final]
    }
    set out
} -result {{1 1 1 1 1 1} {{proven 1} {proven 1} {rejected 0}} EMIT-REJECTED 1 {65 invalid} {1 1 1 1 1 1} {{proven 1} {proven 1} {proven 1}} accepted 1 {50 ok} {1 1 1 1 1 1} {{rejected 0}} EMIT-REJECTED 1 {65 invalid}}

# Pairs {FIRST SECOND} of programs whose one claim, `emitter` (a unique
# name), has the same text in both, while what it reads through a binding
# changes: a captured local, a captured parameter's declared type, a module
# binding, the same code moved into another function, a module binding
# naming another function, a function held by a module binding or a
# captured local whose own code changes. The first is valid, the second
# yields 'A'.
proc memoBindingCases {} {
    set h [string cat $::digitDfa "type Digit = Int in 0..9\n\n"]
    set out {}
    foreach x {49 65} {
        lappend out "${h}fn outer() -> int:\n    k = $x\n    fn emitter() -> unit emits digit_token:\n        yield k\n        unit\n    3\n\n0\n"
    }
    foreach t {Digit int} {
        lappend out "${h}fn outer(d: $t) -> int:\n    fn emitter() -> unit emits digit_token:\n        yield 48 + d\n        unit\n    3\n\n0\n"
    }
    foreach x {49 65} {
        lappend out "${h}k = $x\n\nfn emitter() -> unit emits digit_token:\n    yield k\n    unit\n\n0\n"
    }
    foreach {o x} {outer1 49 outer2 65} {
        lappend out "${h}fn ${o}() -> int:\n    k = $x\n    fn emitter() -> unit emits digit_token:\n        yield k\n        unit\n    3\n\n0\n"
    }
    foreach f {a b} {
        lappend out "${h}fn a() -> int:\n    49\n\nfn b() -> int:\n    65\n\nf = $f\n\nfn emitter() -> unit emits digit_token:\n    yield f()\n    unit\n\n0\n"
    }
    foreach x {49 65} {
        lappend out "${h}fn a() -> unit:\n    yield $x\n    unit\n\nf = a\n\nfn emitter() -> unit emits digit_token:\n    f()\n    unit\n\n0\n"
    }
    foreach x {49 65} {
        lappend out "${h}fn a() -> unit:\n    yield $x\n    unit\n\nfn outer() -> int:\n    g = a\n    fn emitter() -> unit emits digit_token:\n        g()\n        unit\n    3\n\n0\n"
    }
    return $out
}

test ec-memo-bindings {a memoized certificate is not reused when what its function reads through a binding changes, its text unchanged and its name unique (the memo validates by the fingerprints of the functions a proof read, which take an outer binding by its name, exact Int value and type facts, and every expression by its type fact): a captured local (49, then 65), a captured parameter's declared type (Digit, then int), a module binding (49, then 65), the same code moved into another function with another captured value, a module binding naming another function, and a function held by a module binding or a captured local whose code yields a letter instead -- each second program, compiled after the first with the memo kept, decides exactly what a fresh compilation of it decides: rejected} -setup {
    set ::hir::emission::memo [dict create]
} -body {
    set out {}
    foreach {first second} [memoBindingCases] {
        set ::hir::emission::memo [dict create]
        set a [identity $first]
        set after [identity $second]
        set ::hir::emission::memo [dict create]
        set fresh [identity $second]
        lappend out [list [lmap r $a {lindex $r 1}] [lmap r $after {lindex $r 1}] [expr {$after eq $fresh}]]
    }
    set out
} -cleanup {
    set ::hir::emission::memo [dict create]
} -result {{proven rejected 1} {proven rejected 1} {proven rejected 1} {proven rejected 1} {proven rejected 1} {proven rejected 1} {proven rejected 1}}

# The 1-based line and column of the name of the Nth (1-based) function
# declaration `fn NAME(` in TEXT.
proc declarationOf {text name {nth 1}} {
    set n 0
    set i 0
    foreach line [split $text \n] {
        incr i
        if {[regexp -indices "^\\s*fn ($name)\\(" $line -> span] && [incr n] == $nth} {
            return [list $i [expr {[lindex $span 0] + 1}]]
        }
    }
    error "no declaration $nth of $name"
}

test ec-identity-service {the compiler service across revisions, the process's memo kept: two valid claims of one name, one made invalid, repaired, the other edited, a third of the name added, the ambiguity removed, an unrelated edit -- at every revision the hovers say what a fresh compilation of the revision decides, a uniquely named claim stays certified (and is reused), and no certificate is reused for a name of two functions} -setup {
    set ::hir::emission::memo [dict create]
} -body {
    set dir [emit::workspace main.bot "0\n"]
    set path [file join $dir main.bot]
    set fresh [file join $dir fresh.bot]
    set ws [service::workspace -root $dir]
    set good "fn good() -> unit emits digit_token:\n    yield 48\n    unit\n\n"
    proc scope {outer symbol {name emitter}} {
        return "fn $outer\() -> int:\n    fn $name\() -> unit emits digit_token:\n        yield $symbol\n        unit\n    3\n\n"
    }
    set revisions [list \
        [string cat $::digitDfa $good [scope outer1 49] [scope outer2 50] 0\n] \
        [string cat $::digitDfa $good [scope outer1 49] [scope outer2 65] 0\n] \
        [string cat $::digitDfa $good [scope outer1 49] [scope outer2 50] 0\n] \
        [string cat $::digitDfa $good [scope outer1 51] [scope outer2 50] 0\n] \
        [string cat $::digitDfa $good [scope outer1 51] [scope outer2 50] [scope outer3 65] 0\n] \
        [string cat $::digitDfa $good [scope outer1 51] [scope outer2 50 emitter2] 0\n] \
        [string cat $::digitDfa $good [scope outer1 51] [scope outer2 50 emitter2] "fn unrelated() -> int:\n    7\n\n" 0\n]]
    set out {}
    foreach text $revisions {
        service::setDocument $ws $path $text
        set rev [service::analyze $ws $path]
        set reused [dict getdef $::hir::emission::stats reusedClaims {}]
        set hovers {}
        foreach name {good emitter emitter2} {
            for {set nth 1} {![catch {declarationOf $text $name $nth} at]} {incr nth} {
                set hover [lindex [split [dict get [service::at $rev $path {*}$at] hover] \n] 1]
                lappend hovers [lindex [split $hover :] 1]
            }
        }
        # A fresh compilation of the revision's text.
        emit::writeText $fresh $text
        set memo $::hir::emission::memo
        set ::hir::emission::memo [dict create]
        set ::hir::emission::useMemo 0
        set verdicts [lmap r [hir::emission::claims [emit::compile $fresh]] {dict get $r verdict}]
        set ::hir::emission::useMemo 1
        set ::hir::emission::memo $memo
        set expected [lmap v $verdicts {dict get {proven " certified to emit digit_token" rejected " rejected -- the analysis found a trace the recognizer does not accept (see its diagnostics)"} $v}]
        lappend out [list [lmap d [service::diagnostics $rev] {lindex [dict get $d code] end}] \
            [lsort -unique [lmap h $hovers {string trim [lindex [split $h ,] 0]}]] [expr {[lsort $hovers] eq [lsort $expected]}] \
            [lmap id $reused {lindex $id 0}]]
    }
    service::closeWorkspace $ws
    set out
} -cleanup {set ::hir::emission::useMemo 1; rename scope {}} -result {{{} {{certified to emit digit_token}} 1 {}} {EMIT-REJECTED {{certified to emit digit_token} {rejected -- the analysis found a trace the recognizer does not accept (see its diagnostics)}} 1 good} {{} {{certified to emit digit_token}} 1 good} {{} {{certified to emit digit_token}} 1 good} {EMIT-REJECTED {{certified to emit digit_token} {rejected -- the analysis found a trace the recognizer does not accept (see its diagnostics)}} 1 good} {{} {{certified to emit digit_token}} 1 good} {{} {{certified to emit digit_token}} 1 {good emitter emitter2}}}

test ec-identity-interchange {interchange text of programs whose claims share a name, or whose parameterless claims begin with an if, is verified again by its reader to the writer's records, with the reader's memo on or off (with it on, N2's false certificate was repeated; with it off, the text was refused); a reader in another process agrees; a forged or stale certificate for the invalid claim -- the valid one's, or N4a's for N4b -- is refused} -setup {
    set ::hir::emission::memo [dict create]
} -body {
    set f1 [string cat $::digitDfa "fn flip() -> bool:\n    true\n\nfn emitter() -> unit emits digit_token:\n    if flip():\n        yield 65\n    else:\n        yield 66\n    unit\n\nfn good() -> unit emits digit_token:\n    if flip():\n        yield 49\n    else:\n        yield 50\n    unit\n\n0\n"]
    set out {}
    set dir [emit::workspace]
    foreach text [list $::idN2 $f1 [idN4 65]] {
        set ::hir::emission::memo [dict create]
        set hir [surface::compile $text -warnings off -strict 0]
        set encoded [hir::interchange::encode $hir]
        set row {}
        foreach memo {1 0} {
            set ::hir::emission::useMemo $memo
            lappend row [expr {[catch {hir::interchange::decode $encoded} back] ? "refused" : [expr {$back eq $hir ? "kept" : "differs"}]}]
        }
        set ::hir::emission::useMemo 1
        # Another process reads the text.
        set file [file join $dir hir.hirx]
        emit::writeText $file $encoded
        set script [file join $dir read.tcl]
        emit::writeText $script {
set root [lindex $argv 0]
set file [lindex $argv 1]
set argv {}
source [file join $root tests helpers.tcl]
source [file join $root surface surface.tcl]
set f [open $file]
fconfigure $f -encoding utf-8
set text [read $f]
close $f
if {[catch {hir::interchange::decode $text} back]} {
    puts refused
} else {
    puts [lmap r [hir::emission::claims $back] {dict get $r verdict}]
}
}
        lappend row [string trim [exec [info nameofexecutable] $script $::projectRoot $file]]
        # Forged: every claim that is not proven gets a proven claim's
        # certificate (N4b: N4a's, a stale one).
        set records [dict get $hir emissions]
        set proven [lsearch -inline -index 9 $records proven]
        if {$text eq [idN4 65]} {
            set ::hir::emission::memo [dict create]
            set proven [lindex [dict get [surface::compile [idN4 49] -warnings off -strict 0] emissions] 0]
        }
        set forged [lmap r $records {
            if {[dict get $r verdict] ne "proven"} {
                dict set r verdict proven
                dict set r certificate [dict get $proven certificate]
            }
            set r
        }]
        foreach memo {1 0} {
            set ::hir::emission::useMemo $memo
            lappend row [expr {[catch {hir::interchange::decode [hir::interchange::encode [dict replace $hir emissions $forged]]} m o] ? [lindex [dict get $o -errorcode] end] : "accepted"}]
        }
        set ::hir::emission::useMemo 1
        lappend out $row
    }
    set out
} -cleanup {set ::hir::emission::useMemo 1} -result {{kept kept {proven rejected} EMISSION EMISSION} {kept kept {rejected proven} EMISSION EMISSION} {kept kept rejected EMISSION EMISSION}}

test ec-identity-native-erasure {the milestone's accepted programs -- two claims of one name (N4a; two nested emitters, one beside a uniquely named claim), parameterless claims that begin with an if -- lower to the same fused native code with their claims and without them: a correction of the checker changes no code} -constraints nativeCoroutines -body {
    set ::hir::emission::memo [dict create]
    set both [string cat $::coDfa "fn flip() -> bool:\n    true\n\nfn emitter() -> int emits digit_token:\n    if flip():\n        yield 49\n    else:\n        yield 50\n    0\n\n" \
        "fn run() -> List\[int\]:\n" [collector emitter() "    "] "\nrun()\n"]
    lmap text [list [idN4 49] [historyProgram 50] $both] {
        set claimed [native::fusedNir [surface::compile $text -warnings off]]
        set bare [native::fusedNir [surface::compile [emit::strip $text] -warnings off]]
        list [expr {$claimed eq $bare}] [regexp -all {dfa#transition} $claimed]
    }
} -result {{1 0} {1 0} {1 0}}

set ::feasibilityBase [string cat $coDfa {error Oops:
    at: int

fn flip() -> bool:
    true

fn flop() -> bool:
    false

fn pick() -> int:
    7

fn emitter() -> int emits digit_token:
    if flip():
        yield 65
    else:
        yield 66
    0

fn after_token() -> unit emits digit_token:
    yield 49
    if true:
        yield 65
    unit

fn helper() -> unit:
    if true:
        yield 65
    unit

fn calls_helper(n: int) -> int emits digit_token:
    helper()
    0

fn with_parameter(n: int) -> unit emits digit_token:
    if n > 0:
        yield 65
    else:
        yield 66
    unit

fn decided_false() -> int emits digit_token:
    if false:
        yield 65
    else:
        yield 49
    0

fn both_valid() -> int emits digit_token:
    if flip():
        yield 49
    else:
        yield 50
    0

}]
# The feasibility program, its value the run of CALL's coroutine.
proc feasibility {call} {
    return [string cat $::feasibilityBase "fn run() -> List\[int\]:\n" [collector $call "    "] "\nrun()\n"]
}

test ec-feasibility-empty-environment {a function without parameters whose walk reaches an if before any binding is decided on both branches: the census's F1 (letters on both branches), F2 (a second symbol in a branch decided true) and F3 (a parameterless helper's if, through its caller) rejected -- each was certified, the walk ending at the if, and F1's and F3's runs yield 'A' -- F4 (the same if with a parameter) as before; a parameterless claim decided false, or with a digit on both branches, certified, with its normal completion (exits done; they were none)} -setup {
    set ::hir::emission::memo [dict create]
} -body {
    set text [feasibility emitter()]
    set hir [surface::compile $text -warnings off -strict 0]
    set records [hir::emission::claims $hir]
    list [lmap r $records {
            set kinds [lsort -unique [lmap d [dict get $hir diagnostics] {
                if {[dict getdef $d expr ""] ne [dict get $r block]} continue
                dict get $d kind
            }]]
            list [dict get $r function] [dict get $r verdict] $kinds \
                [expr {[dict exists $r certificate] ? [dict get $r certificate exits] : "-"}]
        }] [strictOf $text] [erasedRun $text] [erasedRun [feasibility calls_helper(0)]]
} -result {{{emitter rejected EMIT-REJECTED -} {after_token rejected EMIT-AFTER-TOKEN -} {calls_helper rejected EMIT-REJECTED -} {with_parameter rejected EMIT-REJECTED -} {decided_false proven {} done} {both_valid proven {} done}} EMIT-REJECTED {65 invalid} {65 invalid}}

set ::shapes [string cat $digitDfa {type Small = Int in 0..20

error Oops:
    at: int

fn flip() -> bool:
    true

fn flop() -> bool:
    false

fn pick() -> int:
    if flip():
        7
    else:
        70

fn decided_true() -> unit emits digit_token:
    if true:
        yield 49
    unit

fn decided_true_dead_else() -> unit emits digit_token:
    if true:
        yield 49
    else:
        yield 65
    unit

fn decided_false_no_else() -> unit emits digit_token:
    if false:
        yield 65
    yield 49
    unit

fn unknown_differ() -> unit emits digit_token:
    if flip():
        yield 49
    else:
        yield 65
    unit

fn unknown_no_else() -> unit emits digit_token:
    if flip():
        yield 49
    unit

fn nested_valid() -> unit emits digit_token:
    if flip():
        if flop():
            yield 49
        else:
            yield 50
    else:
        yield 51
    unit

fn nested_invalid() -> unit emits digit_token:
    if flip():
        if flop():
            yield 49
        else:
            yield 65
    else:
        yield 51
    unit

fn one_fails() -> unit errors Oops emits digit_token:
    if flip():
        fail Oops {at: 0}
    else:
        yield 49
    unit

fn fails_after_letter() -> unit errors Oops emits digit_token:
    if flip():
        yield 65
        fail Oops {at: 0}
    else:
        yield 49
    unit

fn one_returns() -> int emits digit_token:
    if flip():
        yield 49
        return 1
    yield 50
    0

fn returns_empty() -> int emits digit_token:
    if flip():
        return 1
    yield 50
    0

fn then_yield() -> unit emits digit_token:
    if flip():
        unit
    else:
        unit
    yield 65
    unit

fn after_yield() -> unit emits digit_token:
    yield 49
    if flip():
        yield 50
    unit

fn digit_helper() -> unit:
    if flip():
        yield 49
    else:
        yield 50
    unit

fn letter_helper() -> unit:
    if flop():
        yield 49
    else:
        yield 65
    unit

fn via_digit_helper(n: int) -> int emits digit_token:
    digit_helper()
    0

fn via_letter_helper(n: int) -> int emits digit_token:
    letter_helper()
    0

fn may_fail() -> unit errors Oops:
    if flip():
        fail Oops {at: 0}
    unit

fn after_handled_join() -> unit emits digit_token:
    may_fail():
        on Oops:
            unit
    if flop():
        yield 49
    else:
        yield 65
    unit

fn after_if_join() -> unit emits digit_token:
    if flip():
        unit
    else:
        unit
    if flop():
        yield 49
    else:
        yield 65
    unit

fn local_bound() -> unit emits digit_token:
    x = pick()
    if x > 5:
        yield 49
    else:
        yield 50
    unit

fn local_unbounded() -> unit emits digit_token:
    x = pick()
    if x > 5:
        yield 48 + x
    else:
        yield 50
    unit

fn parameter_bound(n: int) -> unit emits digit_token:
    if n > 0:
        yield 49
    else:
        yield 50
    unit

fn either_second_path(d: Small) -> unit emits digit_token:
    if d < 3 or d > 12:
        yield 48 + d
    else:
        yield 49
    unit

fn either_first_path(d: Small) -> unit emits digit_token:
    if d > 12 or d < 3:
        yield 48 + d
    else:
        yield 49
    unit

0
}]

test ec-feasibility-shapes {the shapes a walk through an empty environment takes, each decided from its code: an if decided true or false (the dead branch excluded, with or without an else), unknown with a letter on one branch or no else (incomplete), nested, failing, returning, followed by a yield, after a yield, in a parameterless helper (valid and not), after a handled call's join and after an if's join (both leave the environment empty); and with a local or a parameter in the environment, as before -- an `or`'s two feasible paths joined, whichever holds the out-of-range symbols} -setup {
    set ::hir::emission::memo [dict create]
} -body {
    claims $::shapes
} -result {{decided_true proven {}} {decided_true_dead_else proven {}} {decided_false_no_else proven {}} {unknown_differ rejected EMIT-REJECTED} {unknown_no_else rejected EMIT-INCOMPLETE} {nested_valid proven {}} {nested_invalid rejected EMIT-REJECTED} {one_fails proven {}} {fails_after_letter rejected EMIT-REJECTED} {one_returns proven {}} {returns_empty rejected EMIT-INCOMPLETE} {then_yield rejected EMIT-REJECTED} {after_yield rejected EMIT-AFTER-TOKEN} {via_digit_helper proven {}} {via_letter_helper rejected EMIT-REJECTED} {after_handled_join rejected EMIT-REJECTED} {after_if_join rejected EMIT-REJECTED} {local_bound proven {}} {local_unbounded rejected EMIT-REJECTED} {parameter_bound proven {}} {either_second_path rejected EMIT-REJECTED} {either_first_path rejected EMIT-REJECTED}}

test ec-feasibility-flag {Facts answers a feasibility flag beside the environment: a feasible path through an environment with no binding is {1 {}}, an outcome a known condition excludes {0 ...}, a comparison its binding's facts contradict {0 ...}, a binding with no value at all infeasible on both outcomes (no completion manufactured), and the union of an `or`'s feasible paths, each narrowing its binding} -body {
    set hir [surface::compile [string cat $::digitDfa "type Small = Int in 0..20\n\nfn flip() -> bool:\n    true\n\nfn f(d: Small) -> unit emits digit_token:\n    if flip():\n        yield 49\n    if true:\n        yield 50\n    if d < 0:\n        yield 51\n    if d < 3 or d > 12:\n        yield 52\n    unit\n\n0\n"] -warnings off -strict 0]
    hir::emission::Reset $hir
    set f [lindex [hir::emission::claims $hir] 0 1]
    set conditions [lmap x [dict get $hir exprs $f body] {
        if {[dict get $hir exprs $x kind] ne "if"} continue
        dict get $hir exprs $x condition
    }]
    set d [lindex [dict get $hir exprs $f params] 0]
    set ::hir::emission::exprVal [dict create]
    # The operands' values, as the walk computes them before Facts.
    dict for {e node} [dict get $hir exprs] {
        if {[dict get $node kind] eq "ref" && [dict get $node binding] eq $d} {
            dict set ::hir::emission::exprVal $e {{0 20}}
        } elseif {[dict get $node kind] eq "const" && [core::value::kind [dict get $node value]] eq "int"} {
            set k [core::value::intOf [dict get $node value]]
            dict set ::hir::emission::exprVal $e [list [list $k $k]]
        }
    }
    lassign $conditions call known compare either
    set out {}
    set ::hir::emission::env [dict create]
    lappend out [hir::emission::Facts $call 1] [hir::emission::Facts $call 0] \
        [hir::emission::Facts $known 1] [lindex [hir::emission::Facts $known 0] 0]
    set ::hir::emission::env [dict create $d {{0 20}}]
    lappend out [lindex [hir::emission::Facts $compare 1] 0] [hir::emission::Facts $compare 0] \
        [hir::emission::Facts $either 1] [hir::emission::Facts $either 0]
    set ::hir::emission::env [dict create $d {}]
    lappend out [lindex [hir::emission::Facts $compare 1] 0] [lindex [hir::emission::Facts $compare 0] 0]
    string map [list $d D] $out
} -cleanup {set ::hir::emission::hir ""; set ::hir::emission::env [dict create]; set ::hir::emission::exprVal [dict create]} -result {{1 {}} {1 {}} {1 {}} 0 0 {1 {D {{0 20}}}} {1 {D {{0 2} {13 20}}}} {1 {D {{3 12}}}} 0 0}

test ec-result-not-symbol {a claimed function's result is no symbol, whatever its type: an Int-returning source emits its token and completes with any Int -- its argument, 0, -1 -- certified alike (CSV-EMISSION-VALIDATION-MILESTONE-1.md, section 18; this was EMIT-TERMINAL-VALUE's -1 rule)} -body {
    set hir [surface::compile "${digitDfa}fn s(n: int) -> int emits digit_token:\n    yield 55\n    n\n\nfn z() -> int emits digit_token:\n    yield 55\n    0\n\nfn e() -> int emits digit_token:\n    yield 55\n    -1\n\n0\n" -warnings off -strict 0]
    list [lmap d [dict get $hir diagnostics] {dict get $d kind}] \
        [lmap r [hir::emission::claims $hir] {list [dict get $r function] [dict get $r verdict]}]
} -cleanup {unset -nocomplain hir} -result {{} {{s proven} {z proven} {e proven}}}

test ec-result-not-symbol-runs {the consumer of such a source tells its symbols from its final value with std::coroutine::done?, never by the value: the token's symbol, then the unrelated result, stable when resumed again -- the same on every backend} -constraints nativeCoroutines -body {
    sourceAgree "import std::coroutine\n${digitDfa}fn s(n: int) -> int emits digit_token:\n    yield 55\n    n\n\ncoroutine {step, first} = s(42)\nbefore = std::coroutine::done?(step)\nlast = step()\nafter = std::coroutine::done?(step)\nagain = step()\n\[first, last, again, before, after\]\n"
} -result {value {[55, 42, 42, false, true]}}

test ec-byte-character {a character's scalar value sent to a recognizer over bytes} -body {
    diagnosticsOf "import std::dfa\nimport std::char\nimport std::str\n\ndfa byte_token over bytes:\n    start:\n        0..255 -> accept\n\nfn first_char(text: str) -> unit errors IndexNotFound emits byte_token:\n    yield std::char::scalar_value(text.char_at(0))\n    unit\n\n0\n"
} -result {{EMIT-BYTE-CHARACTER 10:5} {EMIT-REJECTED 10:5}}

test ec-unknown-value {an element of List[any] is of no known Int set: not proved, EMIT-UNKNOWN-VALUE (no violation is claimed)} -body {
    set hir [surface::compile "import std::list\n${digitDfa}fn first(xs: List\[any\]) -> unit errors IndexNotFound emits digit_token:\n    yield std::list::at(xs, 0)\n    unit\n\n0\n" -warnings off -strict 0]
    list [lmap d [dict get $hir diagnostics] {dict get $d kind}] [lmap r [hir::emission::claims $hir] {dict get $r verdict}]
} -result {EMIT-UNKNOWN-VALUE not-proved}

test ec-trait-unsupported {a trait-polymorphic emitter's specialization calls the implementation this program selects: EMIT-UNSUPPORTED, not proved -- never certified from the selection} -body {
    set hir [surface::compile "${digitDfa}trait Coded:\n    fn code(self: Coded) -> int\n\nstruct Seven:\n    unused: int\n\nfn code(s: Seven) -> int:\n    55\n\nfn emit(c: Coded) -> unit emits digit_token:\n    yield c.code()\n    unit\n\nfn source() -> int:\n    emit(Seven {unused: 0})\n    -1\n\ncoroutine {step, first} = source()\nfirst\n" -warnings off -strict 0]
    list [lmap d [dict get $hir diagnostics] {dict get $d kind}] [lmap r [hir::emission::claims $hir] {dict get $r verdict}]
} -result {EMIT-UNSUPPORTED not-proved}

test ec-budget {an analysis past its budget is EMIT-BUDGET: not proved, never proved} -body {
    set saved $::hir::emission::maxRounds
    set ::hir::emission::maxRounds 1
    try {
        set hir [surface::compile "${digitDfa}fn ones(n: int) -> unit:\n    if n > 0:\n        yield 49\n        ones(n - 1)\n    unit\n\nfn d(n: int) -> unit emits digit_token:\n    ones(n)\n    unit\n\n0\n" -warnings off -strict 0]
    } finally {
        set ::hir::emission::maxRounds $saved
    }
    list [lsort -unique [lmap d [dict get $hir diagnostics] {dict get $d kind}]] [lmap r [hir::emission::claims $hir] {dict get $r verdict}]
} -result {EMIT-BUDGET not-proved}

test ec-domain-admission {a certificate never admits an argument: a call of a domain-typed emitter with a value outside its domain is the caller's rejection, certified callee or not} -body {
    set hir [surface::compile "${digitDfa}type DigitValue = Int in 0..9\n\nfn digit(d: DigitValue) -> unit emits digit_token:\n    yield 48 + d\n    unit\n\nfn source() -> int:\n    digit(12)\n    -1\n\ncoroutine {step, first} = source()\nfirst\n" -warnings off -strict 0]
    list [lmap d [dict get $hir diagnostics] {dict get $d kind}] [lmap r [hir::emission::claims $hir] {dict get $r verdict}]
} -result {TYPE proven}

# ---------------------------------------------------------------------------
# HIR text, interchange, the cache: a certificate in text is never a proof

test ec-loop-entered-trust {a certificate resting on an entered loop is verified again from interchange text; the memoized one is reused while the code it read is the same, and invalidated when the bound fact it read changes (the guard's constant): proved again, and rejected} -body {
    set ::hir::emission::memo [dict create]
    set body "${::onesDfa}fn g(n: int) -> unit errors Bad emits ones:\n    if n < %s:\n        fail Bad\n    loop i from 0 to n:\n        yield 49\n        continue\n    unit\n\n0\n"
    set hir [surface::compile [format $body 1] -warnings off]
    set back [hir::interchange::decode [hir::interchange::encode $hir]]
    set out [list [expr {$back eq $hir}] [lmap r [hir::emission::claims $back] {dict get $r verdict}]]
    foreach k {1 1 0} {
        set dir [emit::workspace main.bot [format $body $k]]
        lappend out [reuse [file join $dir main.bot]]
    }
    set out
} -result {1 proven {{g proven 1}} {{g proven 1}} {{g rejected 0}}}

test ec-hir-text {HIR text prints a block's claims (the recognizer's binding and name) and reads them back; text carries no recognizer table, so a claim read back is not proved, never certified} -body {
    set hir [surface::compile "${digitDfa}type DigitValue = Int in 0..9\n\nfn digit(d: DigitValue) -> unit emits digit_token:\n    yield 48 + d\n    unit\n\n0\n" -warnings off]
    set text [hir::format $hir]
    set read [hir::read::Program $text]
    set printed [regexp -inline {emits \(b[0-9]+ digit_token\)} $text]
    list [llength $printed] [lmap r [hir::emission::claims $read] {dict get $r verdict}] \
        [lmap d [dict get $read diagnostics] {dict get $d kind}]
} -result {1 not-proved EMIT-UNSUPPORTED}

test ec-interchange-roundtrip {interchange text of a certified program reads back as the same HIR: its claims verified again by the reader, with the same certificates} -body {
    set hir [surface::compile "${digitDfa}type DigitValue = Int in 0..9\n\nfn digit(d: DigitValue) -> unit emits digit_token:\n    yield 48 + d\n    unit\n\n0\n" -warnings off]
    set back [hir::interchange::decode [hir::interchange::encode $hir]]
    list [expr {$back eq $hir}] [lmap r [hir::emission::claims $back] {dict get $r verdict}]
} -result {1 proven}

test ec-interchange-forged {a forged or stale certificate in interchange text is refused (HIR INTERCHANGE EMISSION): a rejected claim turned proven, a certificate whose statement was edited, a claim's diagnostics removed} -body {
    set hir [surface::compile "${digitDfa}type DigitValue = Int in 0..9\n\nfn digit(d: DigitValue) -> unit emits digit_token:\n    yield 48 + d\n    unit\n\nfn bad(d: int) -> unit emits digit_token:\n    yield 48 + d\n    unit\n\n0\n" -warnings off -strict 0]
    set records [dict get $hir emissions]
    set out {}
    # 1. The rejected claim reported proven, with the certificate of the other.
    set forged [lmap r $records {
        if {[dict get $r verdict] eq "rejected"} {
            dict set r verdict proven
            dict set r certificate [dict get [lindex $records 0] certificate]
        }
        set r
    }]
    lappend out [catch {hir::interchange::decode [hir::interchange::encode [dict replace $hir emissions $forged]]} m o] [dict get $o -errorcode]
    # 2. A certificate's statement edited.
    set stale [lreplace $records 0 0 [dict set [lindex $records 0] certificate exits {anything}]]
    lappend out [catch {hir::interchange::decode [hir::interchange::encode [dict replace $hir emissions $stale]]} m o] [dict get $o -errorcode]
    # 3. The claim's diagnostics removed.
    set clean [lmap d [dict get $hir diagnostics] {if {[string match EMIT-* [dict get $d kind]]} continue; set d}]
    lappend out [catch {hir::interchange::decode [hir::interchange::encode [dict replace $hir diagnostics $clean]]} m o] [dict get $o -errorcode]
} -result {1 {HIR INTERCHANGE EMISSION} 1 {HIR INTERCHANGE EMISSION} 1 {HIR INTERCHANGE EMISSION}}

test ec-cache {a front-end cache entry is verified again when it is read: a hit equals the build; an entry whose certificate was forged is a miss, rebuilt} -body {
    set dir [emit::workspace main.bot "import emitlib\n\n0\n"]
    set cache [file join $dir cache]
    file mkdir $cache
    set a [surface::readProgramFile [file join $dir main.bot] -warnings off -cache $cache]
    set before [dict get $::surface::cache::stats hits]
    set b [surface::readProgramFile [file join $dir main.bot] -warnings off -cache $cache]
    set hit [expr {[dict get $::surface::cache::stats hits] - $before}]
    # Forge every entry: one claim's verdict.
    foreach entry [glob -directory $cache -type f *] {
        set text [readFile $entry]
        emit::writeText $entry [regsub {statement [0-9a-f]{16}} $text {statement 0000000000000000}]
    }
    set invalid [dict get $::surface::cache::stats invalid]
    set c [surface::readProgramFile [file join $dir main.bot] -warnings off -cache $cache]
    list [expr {$a eq $b}] $hit [expr {[dict get $::surface::cache::stats invalid] - $invalid}] [expr {$c eq $a}]
} -result {1 1 1 1}

# ---------------------------------------------------------------------------
# Static intrinsics

test ec-static-compile {a claim in a static compile block is decided like any diagnostic: a rejected claim rejects the block, with its DiagnosticCode} -body {
    set text "import std::compiler\n${digitDfa}fn probe() -> str errors std::compiler::CompilerError:\n    static compile:\n        fn bad(d: int) -> unit emits digit_token:\n            yield 48 + d\n            unit\n        0\n    \"accepted\"\n\nprobe():\n    on std::compiler::CompilerError {code}:\n        \"rejected\"\n"
    set hir [surface::compile $text -warnings off]
    set sites [hir::static::sites $hir]
    lmap {key site} $sites {
        list [dict get $site outcome] [dict get $site diagnostic kind] [hir::static::CodeOf [dict get $site diagnostic kind]]
    }
} -result {{rejected EMIT-END-SYMBOL EmitEndSymbol}}

# ---------------------------------------------------------------------------
# The compiler service

test ec-service {hover on a claimed function shows its guarantee (or why it has none); on the claim's recognizer name, the recognizer: its definition, and its references, the claim among them} -body {
    set dir [emit::workspace main.bot "${digitDfa}type DigitValue = Int in 0..9\n\nfn digit(d: DigitValue) -> unit emits digit_token:\n    yield 48 + d\n    unit\n\nfn bad(d: int) -> unit emits digit_token:\n    yield 48 + d\n    unit\n\n0\n"]
    set ws [service::workspace -root $dir]
    set rev [service::analyze $ws [file join $dir main.bot]]
    set path [file join $dir main.bot]
    set good [service::at $rev $path 11 4]
    set badHover [service::at $rev $path 15 4]
    set claim [service::at $rev $path 11 41]
    set out [list [lindex [split [dict get $good hover] \n] 1] [lindex [split [dict get $badHover hover] \n] 1] \
        [dict get $claim construct kind] [dict get $claim definition line] \
        [lmap r [dict get $claim references] {dict get $r line}]]
    service::closeWorkspace $ws
    set out
} -result {{emits digit_token: certified to emit digit_token: every normal completion has yielded exactly one token, every prefix it yields is viable; its token completes on its own last symbol} {emits digit_token: rejected -- the analysis found a trace the recognizer does not accept (see its diagnostics)} emits-claim 5 {11 15}}

# ---------------------------------------------------------------------------
# The examples

test ec-examples-certified {examples/dfa/json's emitters: every claim certified, from a program that calls none of them and from the probe program that runs them all} -body {
    set dir [emit::workspace main.bot "import value_emit\nimport emitlib\n\n0\n"]
    set a [emit::results [emit::compile [file join $dir main.bot]] *]
    set b [emit::results [emit::compile [file join $dir emit_probes.bot]] *]
    list [llength $a] [lsort -unique [lmap c $a {lindex $c 1}]] [llength $b] [lsort -unique [lmap c $b {lindex $c 1}]]
} -result {28 proven 22 proven}

test ec-examples-run {emit_probes.bot runs the same on the Tcl compiler and on fused native code; its integers are one json_number each, its texts one json_text each (the reference interpreter), and CPython reads them as the values they denote} -constraints {nativeCoroutines python3} -body {
    set dir [emit::workspace]
    set hir [surface::readProgramFile [file join $dir emit_probes.bot] -warnings off]
    set a [outcomeUnderHir compile $hir]
    set b [outcomeUnderHir cranelift $hir]
    set outputs [lindex [string map {\[ \{ \] \} , ""} [lindex $a 1]] 0]
    set model [emit::reference $dir emit_probes.bot]
    set verdicts {}
    foreach i {0 1 2 3 4} {
        lappend verdicts [dfaref::text [dfaref::run $model json_lex json_number [concat [lindex $outputs $i] -1] 0]]
    }
    set text [lindex $outputs 10]
    lappend verdicts [lindex [dfaref::text [dfaref::run $model json_grammar json_text [concat $text -1] 0]] 0]
    set json [join [lmap c $text {format %c $c}] ""]
    emit::writeText [file join $dir doc.json] $json
    set parsed [exec python3 -I -c {
import json, sys
v = json.loads(open(sys.argv[1], encoding="utf-8").read())
print(len(v), json.dumps(v["ab"], separators=(",", ":"))[:40])
} [file join $dir doc.json]]
    set ints [lmap i {0 1 2 3 4} {join [lmap c [lindex $outputs $i] {format %c $c}] ""}]
    # json.bot's own validator over the same text.
    emit::writeText [file join $dir validate.bot] "import json\n\njson::validate_scalars(\[\[[join $text {, }]\]\], 64, 4096):\n    on json::Lexical:\n        json::Summary {tokens: -1, symbols: 0}\n    on json::Truncated:\n        json::Summary {tokens: -2, symbols: 0}\n    on json::Structure:\n        json::Summary {tokens: -3, symbols: 0}\n    on json::TooDeep:\n        json::Summary {tokens: -4, symbols: 0}\n    on json::TokenTooLong:\n        json::Summary {tokens: -5, symbols: 0}\n"
    set summary [outcomeUnderHir compile [surface::readProgramFile [file join $dir validate.bot] -warnings off]]
    list [expr {$a eq $b}] [lindex $a 0] $verdicts $parsed $ints [expr {[string match "*tokens: -*" $summary] == 0}]
} -result {1 value {{accept 1 0} {accept 4 0} {accept 20 0} {accept 1 0} {accept 3 0} accept} {4 -12} {0 -120 98765432109876543210 0 -77} 1}

test ec-examples-warning-clean {the emitter modules compile under -warnings error (the warning gate's corpus does not include examples/dfa)} -body {
    set dir [emit::workspace main.bot "import value_emit\nimport emitlib\nimport sinks\n\n0\n"]
    surface::readProgramFile [file join $dir main.bot] -warnings error
    string cat ok
} -result ok

test ec-example-invalid {examples/dfa/json/invalid_emitter.bot is rejected, its diagnostic the guarantee's demonstration} -body {
    catch {surface::readProgramFile [file join $::emit::jsonDir invalid_emitter.bot] -warnings off} message options
    lindex [dict get $options -errorcode] end
} -result EMIT-BOUNDARY

emit::cleanup
cleanupTests
