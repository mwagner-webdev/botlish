    unit

fn absorbed(c: int) -> unit emits json_grammar::digit_symbol:
    json_grammar::digit_symbol(c):
        on std::dfa::UnrecognizedInput:
            0
        on std::dfa::UnexpectedEnd:
            0
    yield c
    unit

0} {json_grammar}]
} -result {{good proven} {other rejected} {derived rejected} {absorbed rejected}}

