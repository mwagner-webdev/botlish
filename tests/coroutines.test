    coAgree "error Boom\nstruct Ev:\n    v: int\nfn w() -> Ev errors Boom:\n    yield Ev {v: 1}\n    fail Boom\nfn g() -> list:\n    coroutine {step, first} = w():\n        on Boom:\n            Ev {v: 0}\n    last = step():\n        on Boom:\n            Ev {v: -1}\n    again = step():\n        on Boom:\n            Ev {v: -2}\n    \[first, last, again\]\ng()\n"
} -result {value {[Ev {v: 1}, Ev {v: -1}, Ev {v: -2}]}}

test co-errors-declared-propagation {an unhandled segment error propagates through a function that declares it; uncaught at the top it is an ordinary UNHANDLED-ERROR} -body {
    list [coAgree "${errorDecls}fn inner() -> int errors Broken:\n    coroutine {step, first} = worker(2)\n    a = step(Msg {v: -5})\n    a.v\nfn outer() -> int:\n    inner():\n        on Broken:\n            42\nouter()\n"] \
        [coCode "${errorDecls}coroutine {step} = worker(2)\n"] \
        [lmap d [hir::diagnostics [surface::compile "${errorDecls}coroutine {step} = worker(2)\nstep(Msg {v: 1}):\n    on Broken:\n        Ev {v: 0}\nstep(Msg {v: 1})\n" -warnings off -strict 0]] {
            dict get $d message
        }]
} -result {{value 42} {CORE SEMANTIC UNHANDLED-ERROR} {{this coroutine construction may produce the declared error "Broken", which is neither handled here nor admitted by the enclosing function's own "errors" declaration} {this coroutine resume may produce the declared error "Broken", which is neither handled here nor admitted by the enclosing function's own "errors" declaration}}}

test co-errors-internal {a failure handled inside the coroutine never reaches the step call} -body {
    coAgree "${errorDecls}fn handled(n: int, resume Msg) -> Ev:\n    v = deep(n):\n        on Broken:\n            42\n    m = yield Ev {v: v}\n    return Ev {v: m.v + 1}\ncoroutine {step, first} = handled(0 - 5)\nsecond = step(Msg {v: 10})\n\[first.v, second.v\]\n"
