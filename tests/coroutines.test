# Errors (items 18-20, 22, 56)

set errorDecls {import coroutine

error Broken

struct Msg:
    v: int

struct Ev:
    v: int

fn deep(v: int, resume Msg) -> int errors Broken:
    if v < 0:
        fail Broken
    m = yield Ev {v: v}
    if m.v < 0:
        fail Broken
    m.v

fn worker(v: int, resume Msg) -> Ev errors Broken:
    x = deep(v)
    y = deep(x + 1)
    return Ev {v: x + y}

}

test co-errors-startup {an unhandled fail before the first yield crosses the construction: its handler runs, the handle is failed} -body {
    coAgree "${errorDecls}fn early(n: int) -> list:\n    coroutine {step, first} = worker(n):\n        on Broken:\n            Ev {v: -1}\n    again = step(Msg {v: 1}):\n        on Broken:\n            Ev {v: -2}\n    \[first.v, coroutine::done?(step), again.v\]\nearly(0 - 1)\n"
} -result {value {[-1, true, -2]}}

test co-errors-segment {a deep fail after resumes crosses the resume call; the failed handle raises the same error again and never resumes} -body {
    coAgree "${errorDecls}fn later() -> list errors Broken:\n    coroutine {step, first} = worker(1)\n    a = step(Msg {v: 5})\n    b = step(Msg {v: -1}):\n        on Broken:\n            Ev {v: 999}\n    c = step(Msg {v: 7}):\n        on Broken:\n            Ev {v: 1000}\n    \[first.v, a.v, b.v, c.v, coroutine::done?(step)\]\nlater():\n    on Broken:\n        \[\]\n"
} -result {value {[1, 6, 999, 1000, true]}}

