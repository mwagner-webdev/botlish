# The affine discipline (items 25-30, 49, 58)

test co-affine-branch-join {a move in one branch leaves the handle not definitely live after the join} -body {
    list [coCode "${principalDecls}fn f(c: bool) -> int:\n    coroutine {step, first} = worker(10)\n    if c:\n        other = step\n    x = step(Message {value: 1})\n    x.value\nf(true)\n"] \
        [lindex [split [coMessage "${principalDecls}fn f(c: bool) -> int:\n    coroutine {step, first} = worker(10)\n    if c:\n        other = step\n    x = step(Message {value: 1})\n    x.value\nf(true)\n"] \n] 0]
} -result {{CORE SEMANTIC AFFINE-NOT-DEFINITELY-LIVE} {`step` is not definitely live here: its coroutine value was moved on some path reaching this use}}

test co-affine-terminating-branch {a move in a branch that returns leaves the handle live on the remaining path} -body {
    coAgree "${principalDecls}fn f(c: bool) -> int:\n    coroutine {step, first} = worker(10)\n    if c:\n        other = step\n        x = other(Message {value: 5})\n        return x.value\n    y = step(Message {value: 6})\n    y.value\n\[f(true), f(false)\]\n"
} -result {value {[5, 6]}}

test co-affine-loop {a move inside a loop body reaches its next iteration: rejected; resumes in a loop keep ownership, past completion too} -body {
    list [coCode "${principalDecls}fn f(n: int) -> int:\n    coroutine {step, first} = worker(10)\n    loop i from 0 to n:\n        other = step\n        i\n    1\n"] \
        [coAgree "import coroutine\nstruct T:\n    n: int\nfn t() -> T:\n    loop i from 0 to 3:\n        yield T {n: i}\n    return T {n: 99}\ncoroutine {step, first} = t()\nseen = loop i from 0 to 5:\n    x = step()\n    x.n\n\[first.n, seen, coroutine::done?(step)\]\n"]
} -result {{CORE SEMANTIC AFFINE-NOT-DEFINITELY-LIVE} {value {[0, [1, 2, 99, 99, 99], true]}}}

test co-affine-done-does-not-move {coroutine::done? observes the handle; sequential resumes keep ownership; dropping a handle is allowed} -body {
    coAgree "import coroutine\n${principalDecls}coroutine {step, first} = worker(1)\na = coroutine::done?(step)\nb = coroutine::done?(step)\nx = step(Message {value: 2})\ny = step(Message {value: 3})\ncoroutine {step: dropped} = worker(5)\n\[a, b, x.value, y.value, coroutine::done?(step)\]\n"
} -result {value {[false, false, 2, 3, true]}}

test co-affine-move-never-forks {a moved handle continues the one coroutine: resuming the new owner picks up where the old one stopped, and a second move chain still has one continuation} -body {
    coAgree "struct T:\n    n: int\nfn t() -> T:\n    yield T {n: 1}\n    yield T {n: 2}\n    yield T {n: 3}\n    return T {n: 4}\ncoroutine {step, first} = t()\na = step()\nnext = step\nb = next()\nthird = next\nc = third()\nd = third()\n\[first.n, a.n, b.n, c.n, d.n\]\n"
} -result {value {[1, 2, 3, 4, 4]}}

test co-affine-move-chain-use-after {each owner in a move chain is dead after its own move} -body {
    coCode "struct T:\n    n: int\nfn t() -> T:\n    yield T {n: 1}\n    return T {n: 4}\ncoroutine {step} = t()\nnext = step\nthird = next\nnext()\n"
} -result {CORE SEMANTIC USE-AFTER-MOVE}

# ---------------------------------------------------------------------------
# The storage frontier (items 31, 32, 59)

set storageDecls {struct T:
    n: int

fn t() -> T:
    yield T {n: 1}
    return T {n: 2}

}

test co-storage-frontier {a handle in a List, a struct field, an erasing argument, a function's result, a closure capture or a module binding is rejected; a structural Fn parameter is COROUTINE-NOT-FUNCTION} -body {
    lmap body {
        "coroutine {step} = t()\nxs = \[step\]\n"
        "coroutine {step} = t()\ns = {h: step}\n"
        "fn keep(x):\n    x\ncoroutine {step} = t()\nk = keep(step)\n"
        "fn make():\n    coroutine {step} = t()\n    step\n"
        "fn g() -> int:\n    coroutine {step} = t()\n    fn h():\n        step()\n    3\ng()\n"
        "fn apply(f: Fn{args: \[\], return: T}) -> T:\n    f()\ncoroutine {step} = t()\nx = apply(step)\n"
        "coroutine {step} = t()\nstep\n"
        "coroutine {step} = t()\nx = if true:\n    step\nelse:\n    step\n"
    } {lindex [coCode "${storageDecls}$body"] 2}
} -result {COROUTINE-STORAGE-UNSUPPORTED COROUTINE-STORAGE-UNSUPPORTED COROUTINE-STORAGE-UNSUPPORTED COROUTINE-STORAGE-UNSUPPORTED COROUTINE-STORAGE-UNSUPPORTED COROUTINE-NOT-FUNCTION COROUTINE-STORAGE-UNSUPPORTED COROUTINE-STORAGE-UNSUPPORTED}

test co-storage-equality {a handle has no equality (rejected as storage: it would be erased into an argument)} -body {
    lindex [coCode "${storageDecls}coroutine {step: a} = t()\ncoroutine {step: b} = t()\nx = a == b\n"] 2
} -result COROUTINE-STORAGE-UNSUPPORTED

# ---------------------------------------------------------------------------
# Contexts and traits (items 37, 38, 60)

set contextProgram {error WriteFailed
type Small = Int in 0..1000

context trait Out:
    fn emit(n: int) -> int errors WriteFailed

context struct A:
    k: Small

fn emit(n: int, context c: A) -> int errors WriteFailed:
    n + c.k

struct Ev:
    n: int

fn deep(n: int, context out: Out) -> int errors WriteFailed:
    x = out.emit(n)
    yield Ev {n: x}
    out.emit(x)

fn worker(n: int) -> Ev errors WriteFailed:
    y = deep(n)
    return Ev {n: y}

with context A {k: 5}
coroutine {step, first} = worker(10):
    on WriteFailed:
        Ev {n: -1}
second = step():
    on WriteFailed:
        Ev {n: -2}
[first.n, second.n]
}

test co-context-trait {a deep context-trait operation inside a coroutine: the provider is selected statically at construction and the same implementation runs after a resume} -body {
    coAgree $contextProgram
} -result {value {[15, 20]}}

test co-context-trait-native {native evidence: the yielding clone of deep takes no context argument and calls the selected implementation directly; the thunk calls the clone of worker} -constraints linuxX86_64 -body {
    set nir [coNir $contextProgram]
    set deep [lsearch -inline -regexp [split $nir \n] {^func [0-9]+ "deep<}]
    list [regexp {params=1 } $deep] [regexp {op coyield} $nir] [expr {[regexp -all {op cocreate} $nir] == 1}] \
        [regexp {callvalue} $nir]
} -cleanup {unset -nocomplain nir deep} -result {1 1 1 0}

test co-trait-polymorphic {a trait-polymorphic yielding function is monomorphized into an ordinary yielding clone} -body {
    coAgree {import str

trait Named:
    fn name(value: Named) -> str

struct Person:
    first: str

fn name(p: Person) -> str:
    p.first

struct Ev:
    text: str

fn greet(x: Named) -> Ev:
    yield Ev {text: str::concat("hello ", x.name())}
    return Ev {text: str::concat("bye ", x.name())}

coroutine {step, first} = greet(Person {first: "Ada"})
last = step()
[first.text, last.text]
}
} -result {value {["hello Ada", "bye Ada"]}}

# ---------------------------------------------------------------------------
# HIR and NIR evidence (items 47, 48)

test co-hir-text {checked HIR states each yielding function's effect, the handle type and every move, and reads back to the same text} -body {
    set hir [surface::compile "${principal}other = step\nx = other(Message {value: 1})\nx.value\n" -warnings off]
    set text [hir::format $hir]
    list [regexp -all {coroutine-effect \(yields Event, resume Message\)} $text] \
        [regexp {bind b[0-9]+ step : Coroutine\{resume: Message, yield: Event, errors: \[\]\}} $text] \
        [regexp {bind b[0-9]+ other : Coroutine\{[^\n]*\} move} $text] \
        [expr {[hir::format [hir::parse $text]] eq $text}]
} -cleanup {unset -nocomplain hir text} -result {2 1 1 1}

test co-nir-operations {construction is cocreate then costart (eager); a resume is coresume of the one handle register; a move copies no state; done? is codone; a yield is coyield in the deep function, reached by an ordinary direct call} -constraints linuxX86_64 -body {
    set nir [coNir "import coroutine\n${principal}other = step\nx = other(Message {value: 1})\ny = coroutine::done?(other)\nx.value\n"]
    set ops {}
    set handle ""
    foreach line [coFunc $nir <program>] {
        if {[regexp {^(%[0-9]+) = op (co[a-z0-9]+) ([^@]*)} $line -> target op regs]} {
            lappend ops $op [llength $regs]
            if {$op eq "cocreate"} {
                set handle $target
            } elseif {[lindex $regs 0] ne $handle} {
                lappend ops other-register
            }
        }
    }
    list $ops \
        [llength [lsearch -all -regexp [coFunc $nir deep] {= op coyield}]] \
        [llength [lsearch -all -regexp [coFunc $nir worker] {= call [0-9]+ }]]
} -cleanup {unset -nocomplain nir ops handle line target op regs} -result {{cocreate 1 costart 1 coresume 2 codone 1} 1 1}

# ---------------------------------------------------------------------------
# GC (items 40-43)

set gcProgram {import str
import list

struct Ev:
    text: str

fn churn(n: int) -> int:
    xs = loop i from 0 to n:
        str::concat("x", str::concat("y", "z"))
    list::length(xs)

fn deep(k: int, label: str) -> int:
    held = [label, str::concat(label, "!"), [k, k + 1]]
    if k == 0:
        yield Ev {text: str::concat("bottom:", label)}
        churn(50)
        yield Ev {text: str::concat("after:", list::at(held, 1))}
        return 1
    mine = str::concat(label, "-")
    r = deep(k - 1, mine)
    yield Ev {text: str::concat(mine, list::at(held, 0))}
    r + 1

fn worker(k: int, label: str) -> Ev:
    n = deep(k, label)
    return Ev {text: str::concat("done ", label)}

fn run(k: int, label: str) -> list:
    coroutine {step: a, first: fa} = worker(k, label)
    coroutine {step: b, first: fb} = worker(k + 2, str::concat(label, "B"))
    coroutine {step: dropped} = worker(3, "dropped")
    churn(100)
    out = loop i from 0 to k + 4:
        x = a()
        churn(20)
        y = b()
        [x.text, y.text]
    [fa.text, fb.text, out]

run(2, "L")
}

set gcExpected {value {["bottom:L--", "bottom:LB----", [["after:L--!", "after:LB----!"], ["L--L-", "LB----LB---"], ["L-L", "LB---LB--"], ["done L", "LB--LB-"], ["done L", "LB-LB"], ["done L", "done LB"]]]}}

test co-gc-suspended-stacks {values held only by suspended frames at several depths survive collections run by other coroutines and by the main program} -body {
    coAgree $gcProgram
} -result $gcExpected

test co-gc-stress {the same program with a collection before every native allocation} -constraints linuxX86_64 -body {
    withGcStress {
        set hir [surface::compile $gcProgram -warnings off]
        list [outcomeUnderHir cranelift $hir] [outcomeUnderHir cranelift-generic $hir]
    }
} -cleanup {unset -nocomplain hir} -result [list [concat $gcExpected {{}}] [concat $gcExpected {{}}]]

test co-gc-many-coroutines {thousands of short coroutines: abandoned and finished ones are reclaimed (their stacks pooled), the program stays correct} -body {
    coAgree "import list\nstruct V:\n    n: int\nfn w(k: int) -> V:\n    yield V {n: k}\n    return V {n: k * 2}\nfn one(k: int) -> int:\n    coroutine {step, first} = w(k)\n    coroutine {step: abandoned} = w(k + 1)\n    last = step()\n    first.n + last.n\nxs = loop i from 0 to 2000:\n    one(i)\nlast = list::at(xs, 1999):\n    on IndexNotFound:\n        0\nlist::length(xs) + last\n"
} -result {value 7997}

cleanupTests
