# GC (items 40-43)

set gcProgram {import str
import list

struct Ev:
    text: str

fn churn(n: int) -> int:
    xs = loop i from 0 to n:
        str::concat("x", str::concat("y", "z"))
    list::length(xs)

fn deep(k: int, label: str) -> int:
    held = [label, str::concat(label, "!"), [k, k + 1]]
    if k == 0:
        yield Ev {text: str::concat("bottom:", label)}
        churn(50)
        yield Ev {text: str::concat("after:", list::at(held, 1))}
        return 1
    mine = str::concat(label, "-")
    r = deep(k - 1, mine)
    yield Ev {text: str::concat(mine, list::at(held, 0))}
    r + 1

fn worker(k: int, label: str) -> Ev:
    n = deep(k, label)
    return Ev {text: str::concat("done ", label)}

fn run(k: int, label: str) -> list:
    coroutine {step: a, first: fa} = worker(k, label)
    coroutine {step: b, first: fb} = worker(k + 2, str::concat(label, "B"))
    coroutine {step: dropped} = worker(3, "dropped")
    churn(100)
    out = loop i from 0 to k + 4:
        x = a()
        churn(20)
        y = b()
        [x.text, y.text]
    [fa.text, fb.text, out]

run(2, "L")
}

set gcExpected {value {["bottom:L--", "bottom:LB----", [["after:L--!", "after:LB----!"], ["L--L-", "LB----LB---"], ["L-L", "LB---LB--"], ["done L", "LB--LB-"], ["done L", "LB-LB"], ["done L", "done LB"]]]}}

test co-gc-suspended-stacks {values held only by suspended frames at several depths survive collections run by other coroutines and by the main program} -body {
    coAgree $gcProgram
} -result $gcExpected

test co-gc-stress {the same program with a collection before every native allocation} -constraints linuxX86_64 -body {
    withGcStress {
        set hir [surface::compile $gcProgram -warnings off]
        list [outcomeUnderHir cranelift $hir] [outcomeUnderHir cranelift-generic $hir]
    }
} -cleanup {unset -nocomplain hir} -result [list [concat $gcExpected {{}}] [concat $gcExpected {{}}]]

test co-gc-many-coroutines {thousands of short coroutines: abandoned and finished ones are reclaimed (their stacks pooled), the program stays correct} -body {
    coAgree "import list\nstruct V:\n    n: int\nfn w(k: int) -> V:\n    yield V {n: k}\n    return V {n: k * 2}\nfn one(k: int) -> int:\n    coroutine {step, first} = w(k)\n    coroutine {step: abandoned} = w(k + 1)\n    last = step()\n    first.n + last.n\nxs = loop i from 0 to 2000:\n    one(i)\nlast = list::at(xs, 1999):\n    on IndexNotFound:\n        0\nlist::length(xs) + last\n"
} -result {value 7997}

# ---------------------------------------------------------------------------
# Release at the last use (COROUTINES.md): the affine analysis releases a
# coroutine right after the last statement of its handle's own sequence that
# refers to it, when the handle still owns it on every path.

# Test-only probes of the Tcl runtime: the Tcl coroutines alive, and the
# evaluator's live frames.
proc coLiveCoroutines {} {
    return [core::value::int [llength [info commands {::core::coroutines::co[0-9]*}]]]
}
proc coLiveFrames {} {
    return [core::value::int [core::env::liveCount]]
}
if {"test_live_coroutines" ni [core::native::names]} {
    core::registerNative test_live_coroutines -arity 0 -impl coLiveCoroutines
    core::registerNative test_live_frames -arity 0 -impl coLiveFrames
}

# The release table of TEXT, in statement order: {STATEMENT RELEASED...} with
# STATEMENT "bind NAME" or the statement's kind, and a hygienic handle
# temporary shown as <handle>.
proc coReleases {text} {
    set hir [surface::compile $text -warnings off]
    set name {{hir b} {
        set n [dict get $hir bindings $b name]
        expr {[regexp {^coroutine#[0-9]+$} $n] ? "<handle>" : [regsub {#[0-9]+$} $n ""]}
    }}
    set rows {}
    foreach e [lsort -dictionary [dict keys [dict get $hir affine releases]]] {
        set node [dict get $hir exprs $e]
        set label [dict get $node kind]
        if {$label eq "bind"} {
            set label "bind [apply $name $hir [dict get $node binding]]"
        }
        lappend rows [list $label {*}[lmap b [dict get $hir affine releases $e] {apply $name $hir $b}]]
    }
    return $rows
}

set releaseDecls {import coroutine
import list
import mutable_array
struct V:
    n: int
fn w(k: int) -> V:
    yield V {n: k}
    return V {n: k + 1}
}

test co-release-placement {a release follows the last statement of the handle's own sequence that refers to it: after the last resume, per loop iteration, after a loop using it, after a function's last statement, after the branch that moved it on one path (its new owner is released inside); a moved-from handle is not released (its new owner is), nor one whose last use cannot complete} -body {
    lmap body {
        "coroutine {step, first} = w(1)\na = step()\nb = step()\n\[first.n, a.n, b.n\]\n"
        "coroutine {step} = w(1)\nother = step\nx = other()\nx.n\n"
        "coroutine {step} = w(1)\nif coroutine::done?(step):\n    gone = step\n1\n"
        "fn f() -> int:\n    coroutine {step} = w(1)\n    step().n\nf()\n"
        "xs = loop i from 0 to 3:\n    coroutine {first} = w(i)\n    first.n\nxs\n"
        "coroutine {step} = w(1)\nxs = loop i from 0 to 3:\n    step().n\nxs\n"
        "fn g(c: bool) -> int:\n    coroutine {step, first} = w(1)\n    if c:\n        return first.n\n    step().n\ng(true)\n"
        "fn h() -> int:\n    coroutine {step} = w(1)\n    return step().n\nh()\n"
    } {coReleases "${releaseDecls}$body"}
} -cleanup {unset -nocomplain body} -result {{{{bind b} step}} {{{bind x} other}} {{if step} {{bind gone} gone}} {{project step}} {{{bind first} <handle>}} {{{bind xs} step}} {{project step}} {}}

test co-release-values {a release changes no value: after a last statement whose value is a function's result, a loop element, an if's value or the program's result, the value is kept; a released suspended body runs no further code} -body {
    coAgree "${releaseDecls}fn note(a: MutableArray\[int\], v: int) -> int:
    mutable_array::set(a, 0, v):
        on IndexNotFound:
            unit
    v
fn seen(a: MutableArray\[int\]) -> int:
    mutable_array::at(a, 0):
        on IndexNotFound:
            -1
fn noisy(a: MutableArray\[int\]) -> V:
    note(a, 1)
    yield V {n: 10}
    note(a, 2)
    return V {n: 20}
fn f(k: int) -> int:
    coroutine {step} = w(k)
    step().n
log = mutable_array::create(1, 0)
fn abandon(a: MutableArray\[int\]) -> int:
    coroutine {first} = noisy(a)
    first.n
xs = loop i from 0 to 3:
    coroutine {step} = w(i)
    step().n
y = if f(1) > 0:
    coroutine {step} = w(7)
    step().n
else:
    0
z = abandon(log)
coroutine {step} = w(5)
\[f(3), xs, y, z, seen(log), step().n\]
"
} -result {value {[4, [1, 2, 3], 8, 10, 1, 6]}}

test co-release-branch-move {a handle moved on one path only: its new owner is released inside the branch, the old binding after it, a no-op on the path that moved it -- the same values on every backend, on both paths} -body {
    coAgree "${releaseDecls}fn pick(c: bool) -> int:\n    coroutine {step, first} = w(10)\n    if c:\n        other = step\n        x = other()\n    first.n\nfn keep(c: bool) -> int:\n    coroutine {step, first} = w(20)\n    y = if c:\n        other = step\n        other().n\n    else:\n        0\n    first.n + y\n\[pick(true), pick(false), keep(true), keep(false)\]\n"
} -result {value {[10, 10, 41, 20]}}

test co-release-tcl-runtime {on the Tcl backends a released suspended coroutine is unwound: its Tcl coroutine and its frames end with its handle (the interpreter's 9 frames of a coroutine suspended 5 calls deep are gone after the handle's last use; a loop of abandoned coroutines leaves exactly what a loop creating a closure does)} -body {
    set pre "import coroutine\nstruct V:\n    n: int\nfn deep(d: int, k: int) -> int:\n    if d == 0:\n        yield V {n: k}\n        return 0\n    deep(d - 1, k) + 1\nfn holder(k: int) -> V:\n    return V {n: deep(5, k)}\nbefore = test_live_frames()\n"
    set programs [list \
        "coroutine {step: a} = holder(1)\nheld = test_live_frames() - before\nd = coroutine::done?(a)\ngone = test_live_frames() - before\n\[held, gone, test_live_coroutines()\]\n" \
        "xs = loop i from 0 to 50:\n    coroutine {first} = holder(i)\n    first.n\n\[test_live_frames() - before, test_live_coroutines()\]\n" \
        "xs = loop i from 0 to 50:\n    fn g() -> int:\n        i\n    g()\n\[test_live_frames() - before, test_live_coroutines()\]\n"]
    set results [lmap backend {interp compile} {
        lmap text $programs {
            lindex [outcomeUnderHir $backend [surface::compile "$pre$text" -warnings off]] 1
        }
    }]
    # The Tcl compiler's own entry from HIR (main.tcl's compile backend),
    # which compiles the releases itself (core::compiler::CompileSequence).
    lappend results [lmap text $programs {
        core::value::show [core::compiler::evalHir [surface::compile "$pre$text" -warnings off]] 1 1
    }]
} -cleanup {unset -nocomplain pre programs results} -result {{{[9, 0, 0]} {[50, 0]} {[50, 0]}} {{[0, 0, 0]} {[50, 0]} {[50, 0]}} {{[0, 0, 0]} {[50, 0]} {[50, 0]}}}

test co-release-native-stacks {natively a released suspended coroutine's stack goes back to the pool at once: 2000 constructions abandoned in a loop map one stack and reuse it 1999 times, and no collection sweeps a coroutine still holding one; the same under GC stress} -constraints linuxX86_64 -body {
    set hir [surface::compile "${releaseDecls}xs = loop i from 0 to 2000:\n    coroutine {first} = w(i)\n    first.n\nlist::length(xs)\n" -warnings off]
    set report [native::allocationReport $hir summary]
    list [dict get $report coroutines] [withGcStress {lrange [outcomeUnderHir cranelift $hir] 0 1}]
} -cleanup {unset -nocomplain hir report} -result {{stacksMapped 1 stacksReused 1999 released 2000 releasedSuspended 2000 sweptSuspended 0} {value 2000}}

# ---------------------------------------------------------------------------
# Release on every early exit (COROUTINES.md): a return, fail, break or
# continue, or a call propagating a declared error, that leaves a handle's
# scope before its last use releases the coroutine it still owns.

# The exit releases of TEXT, in ExprId order: {KIND BEFORE AFTER} for an exit
# statement (released before its value, and after it), {call|handle NAME
# RELEASED} for a call (or handled call) propagating declared error NAME.
proc coExits {text} {
    set hir [surface::compile $text -warnings off]
    set name {{hir b} {regsub {#[0-9]+$} [dict get $hir bindings $b name] ""}}
    set rows {}
    set table [dict merge [dict get $hir affine exits] [dict get $hir affine errorExits]]
    foreach e [lsort -dictionary [dict keys $table]] {
        if {[dict exists $hir affine exits $e]} {
            lassign [hir::affine::releasesOnExit $hir $e] before after
            lappend rows [list [hir::kind $hir $e] [lmap b $before {apply $name $hir $b}] [lmap b $after {apply $name $hir $b}]]
        } else {
            dict for {error bs} [dict get $hir affine errorExits $e] {
                lappend rows [list [hir::kind $hir $e] $error [lmap b $bs {apply $name $hir $b}]]
            }
        }
    }
    return $rows
}

set exitDecls {import coroutine
struct V:
    n: int
error Boom
error Late
fn w(k: int) -> V:
    yield V {n: k}
    return V {n: k + 1}
fn bad(k: int) -> int errors Boom:
    if k > 2:
        fail Boom
    k
fn worse(k: int) -> int errors Boom, Late:
    if k > 4:
        fail Late
    bad(k)
}

# One function per kind of exit, and a row of all their results for one k.
set exitProgram {fn ret(k: int) -> int:
    coroutine {step, first} = w(k)
    if k > 1:
        return first.n
    step().n
fn uses(k: int) -> int:
    coroutine {step} = w(k)
    return step().n
fn failing(k: int) -> int errors Boom:
    coroutine {step} = w(k)
    if k > 1:
        fail Boom
    step().n
fn calling(k: int) -> int errors Boom:
    coroutine {step} = w(k)
    x = bad(k)
    step().n + x
fn handled(k: int) -> int errors Late:
    coroutine {step} = w(k)
    x = worse(k):
        on Boom:
            step().n
    x + 100
fn looping(k: int) -> int:
    coroutine {step, first} = w(k)
    xs = loop i from 0 to 4:
        coroutine {step: inner, first: one} = w(i)
        if i == k:
            break
        if i < k:
            continue
        inner().n + one.n
    step().n * 10 + first.n
fn tail(k: int) -> int errors Boom:
    coroutine {step} = w(k)
    if k > 1:
        return tail(k - 1)
    step().n + bad(k)
fn moved(k: int) -> int:
    coroutine {step} = w(k)
    if k > 1:
        other = step
        if k > 2:
            return 0
        other().n
    else:
        step().n
fn row(k: int) -> list:
    a = failing(k):
        on Boom:
            -1
    b = calling(k):
        on Boom:
            -1
    c = handled(k):
        on Late:
            -1
    d = tail(k):
        on Boom:
            -1
    [ret(k), uses(k), a, b, c, looping(k), d, moved(k)]
}

test co-exit-release-placement {an exit releases what it takes out of scope before the handle's last use: a return before its value (after it, when the value uses the handle), a fail, a call's unhandled declared error, a break or continue only the loop body's own handle; a handled error releases nothing, a shadowed name and a self tail call's error nothing, a moved-from handle nothing (its new owner instead), a handle bound after the exit or used for the last time before it nothing (released at that last use)} -body {
    lmap body {
        "fn f(k: int) -> int:\n    coroutine {step, first} = w(k)\n    if k > 1:\n        return first.n\n    step().n\nf(1)\n"
        "fn f(k: int) -> int:\n    coroutine {step} = w(k)\n    return step().n\nf(1)\n"
        "fn f(k: int) -> int errors Boom:\n    coroutine {step} = w(k)\n    if k > 1:\n        fail Boom\n    step().n\nf(1):\n    on Boom:\n        0\n"
        "fn f(k: int) -> int errors Boom:\n    coroutine {step} = w(k)\n    x = bad(k)\n    step().n + x\nf(1):\n    on Boom:\n        0\n"
        "fn f(k: int) -> int errors Late:\n    coroutine {step} = w(k)\n    x = worse(k):\n        on Boom:\n            step().n\n    step().n + x\nf(1):\n    on Late:\n        0\n"
        "fn f(k: int) -> int:\n    coroutine {step} = w(k)\n    xs = loop i from 0 to 3:\n        coroutine {step: inner} = w(i)\n        if i == k:\n            break\n        if i > k:\n            continue\n        inner().n\n    step().n\nf(1)\n"
        "fn f(k: int) -> int:\n    coroutine {step} = w(k)\n    xs = loop i from 0 to 3:\n        step = i\n        if i == k:\n            return step\n        i\n    step().n\nf(1)\n"
        "fn f(k: int) -> int errors Boom:\n    coroutine {step} = w(k)\n    if k > 1:\n        return f(k - 1)\n    step().n\nf(1):\n    on Boom:\n        0\n"
        "fn f(k: int) -> int errors Boom:\n    coroutine {step} = w(k)\n    if k > 1:\n        return bad(k) + step().n\n    step().n\nf(1):\n    on Boom:\n        0\n"
        "fn f(k: int) -> int:\n    coroutine {step} = w(k)\n    if k > 1:\n        other = step\n        if k > 2:\n            return 0\n        other().n\n    else:\n        step().n\nf(1)\n"
        "fn f(k: int) -> int:\n    if k > 1:\n        return 0\n    coroutine {step} = w(k)\n    step().n\nf(1)\n"
        "fn f(k: int) -> int:\n    coroutine {step} = w(k)\n    x = step().n\n    if x > 1:\n        return 0\n    x\nf(1)\n"
    } {coExits "${exitDecls}$body"}
} -cleanup {unset -nocomplain body} -result {{{return step {}}} {{return {} step}} {{fail step {}}} {{call Boom step}} {{handle Late step}} {{break inner {}} {continue inner {}}} {} {{return step {}}} {{return {} step} {call Boom step}} {{return other {}}} {} {}}

test co-exit-release-values {a release on an exit changes no value: every exit kind, a handler resuming the handle after a handled error, a loop's break and continue leaving the function's own handle live, a self tail call -- the same values on every backend} -body {
    coAgree "${exitDecls}${exitProgram}xs = loop k from 0 to 7:\n    row(k)\nxs\n"
} -result {value {[[1, 1, 1, 1, 100, 10, 1, 1], [2, 2, 2, 3, 101, 21, 3, 2], [2, 3, -1, 5, 102, 32, 3, 3], [3, 4, -1, -1, 104, 43, 3, 0], [4, 5, -1, -1, 105, 54, 3, 0], [5, 6, -1, -1, -1, 65, 3, 0], [6, 7, -1, -1, -1, 76, 3, 0]]}}

test co-exit-release-tcl-runtime {on the Tcl backends no exit leaves a suspended coroutine behind: after every exit kind on every path, no Tcl coroutine is alive (57 were before exits released), on both compile routes} -body {
    set text "${exitDecls}${exitProgram}xs = loop k from 0 to 7:\n    row(k)\ntest_live_coroutines()\n"
    list {*}[lmap backend {interp compile} {
        lrange [outcomeUnderHir $backend [surface::compile $text -warnings off]] 0 1
    }] [core::value::show [core::compiler::evalHir [surface::compile $text -warnings off]] 1 1]
} -cleanup {unset -nocomplain text} -result {{value 0} {value 0} 0}

test co-exit-release-native-stacks {natively every coroutine an exit leaves is released, none is left for a collection: 2100 rows (27900 constructions, 18000 abandoned suspended on an exit or at a last use) map two stacks (an outer and a loop's inner coroutine are alive at once) and sweep none; the same under GC stress} -constraints linuxX86_64 -body {
    set hir [surface::compile "import list\n${exitDecls}${exitProgram}xs = loop j from 0 to 300:\n    ys = loop k from 0 to 7:\n        row(k)\n    list::length(ys)\nlist::length(xs)\n" -warnings off]
    set report [native::allocationReport $hir summary]
    list [dict get $report coroutines] [withGcStress {lrange [outcomeUnderHir cranelift $hir] 0 1}]
} -cleanup {unset -nocomplain hir report} -result {{stacksMapped 2 stacksReused 27898 released 27900 releasedSuspended 18000 sweptSuspended 0} {value 300}}

test co-exit-release-hir-text {HIR text states each exit's releases and each call's per error, and reads back to the same text and the same lowered program} -body {
    set hir [surface::compile "${exitDecls}fn f(k: int) -> int errors Boom:\n    coroutine {step} = w(k)\n    if k > 1:\n        return step().n\n    x = bad(k)\n    if k > 5:\n        fail Boom\n    step().n + x\nf(1):\n    on Boom:\n        0\n" -warnings off]
    set text [hir::format $hir]
    set back [hir::parse $text]
    list [llength [regexp -all -inline { exit-release=b[0-9]+} $text]] \
        [llength [regexp -all -inline { error-release=Boom=b[0-9]+} $text]] \
        [expr {[hir::format $back] eq $text}] [expr {[hir::lower $back] eq [hir::lower $hir]}]
} -cleanup {unset -nocomplain hir text back} -result {2 1 1 1}

# ---------------------------------------------------------------------------
# Source audit (item 66): what the milestone must not contain.

proc coSource {path} {
    set f [open [file join $::projectRoot $path] r]
    fconfigure $f -encoding utf-8
    set text [read $f]
    close $f
    return $text
}

# Every implementation source file: the compiler, the runtimes, the native
# backend, the library.
proc coImplementationFiles {} {
    set files {}
    foreach pattern {core/*.tcl compiler/*.tcl hir/*.tcl surface/*.tcl native/*.tcl
                     native/src/*.rs native/src/*/*.rs native/src/*/*/*.rs lib/*.bot lib/*/*.bot} {
        foreach path [glob -nocomplain -directory $::projectRoot $pattern] {
            lappend files [string range $path [string length $::projectRoot/] end]
        }
    }
    return [lsort $files]
}

test co-source-no-iterator-or-exhaustion {no iterator protocol, StopIteration-like error, exhaustion condition, yieldto, fork or clone operation, or resumable error anywhere in the implementation} -body {
    set hits {}
    foreach path [coImplementationFiles] {
        set text [coSource $path]
        foreach pattern {StopIteration CoroutineExhausted COROUTINE-EXHAUSTED yieldto coroutine::fork
                         coroutine#fork coroutine::clone coroutine#clone coroutine::next coroutine#next
                         coroutine::iter coroutine#iter ResumableError {resumable error} {resumable exception}} {
            if {[string first $pattern $text] >= 0} {
                lappend hits "$path: $pattern"
            }
        }
    }
    set hits
} -cleanup {unset -nocomplain hits path text pattern} -result {}

test co-source-operations {the coroutine operations are exactly create, start, resume (at most one message), yield, done? and release, in the Tcl runtime and in NIR: no copy, fork or move operation exists at run time} -body {
    set runtime [coSource core/coroutines.tcl]
    set registered [lmap {- name} [regexp -all -inline {core::native::register (coroutine\S+)} $runtime] {set name}]
    set nir [coSource native/src/nir.rs]
    set ops [lmap {- name} [regexp -all -inline {"(co[a-z0-9]+)" => Co} $nir] {set name}]
    list $registered [core::coroutines::natives] $ops [regexp {\[llength \$args\] > 1} $runtime]
} -cleanup {unset -nocomplain runtime registered nir ops} -result {{coroutine#create coroutine#start coroutine#resume coroutine#yield coroutine::done? coroutine#release} {coroutine#create coroutine#start coroutine#resume coroutine#yield coroutine::done? coroutine#release} {cocreate costart coresume coresume0 coyield codone corelease} 1}

test co-source-state-machine {the runtime states are exactly fresh, running, suspended, completed, failed and released (the handle is dead): there is no moved sentinel (ownership is static), and a coroutine object is never cloned} -body {
    set runtime [coSource core/coroutines.tcl]
    set states [lsort -unique [concat \
        [lmap {- s} [regexp -all -inline {dict set store \$id state ([a-z]+)} $runtime] {set s}] \
        [lmap {- s} [regexp -all -inline {dict create state ([a-z]+)} $runtime] {set s}]]]
    set native [coSource native/src/runtime/coroutine.rs]
    set constants [lmap {- c} [regexp -all -inline {pub const (CO_[A-Z]+): u8} $native] {set c}]
    set object [string range $native [string first "pub struct CoroutineObj" $native] end]
    set before [string range $native [expr {[string first "pub struct CoroutineObj" $native] - 200}] [string first "pub struct CoroutineObj" $native]]
    list $states $constants [regexp -nocase {moved} "$runtime$native"] \
        [regexp {Clone} $before] [regexp {impl Clone for CoroutineObj} $native]
} -cleanup {unset -nocomplain runtime states native constants object before} -result {{completed failed fresh released running suspended} {CO_FRESH CO_RUNNING CO_SUSPENDED CO_COMPLETED CO_FAILED CO_RELEASED} 0 0 0}

test co-source-no-context-dispatch {suspension adds no trait or context machinery: neither coroutine runtime refers to contexts or traits} -body {
    set hits {}
    foreach path {core/coroutines.tcl native/src/runtime/coroutine.rs} {
        set text [coSource $path]
        foreach pattern {core::contexts context# hir::traits trait_ ContextArea context_area} {
            if {[string first $pattern $text] >= 0} {
                lappend hits "$path: $pattern"
            }
        }
    }
    set hits
} -cleanup {unset -nocomplain hits path text pattern} -result {}

# ---------------------------------------------------------------------------
# The fuzzer (item 61)

test co-fuzz-bounded {a bounded run of the coroutine fuzzer (audit/coroutines/tools/fuzz.tcl): every backend agrees with the independent oracle on every accepted program, and every rejected one has the predicted diagnostic} -constraints linuxX86_64 -body {
    set here [pwd]
    cd [temporaryDirectory]
    try {
        set output [exec [info nameofexecutable] [file join $::projectRoot audit coroutines tools fuzz.tcl] -n 12 -seed 101 2>@1]
    } finally {
        cd $here
    }
    lindex [split [string trim $output] \n] end
} -cleanup {unset -nocomplain here output} -result {programs 12 disagreements 0}

cleanupTests
