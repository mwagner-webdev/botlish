# ---------------------------------------------------------------------------
# Contexts and traits (items 37, 38, 60)

set contextProgram {error WriteFailed
type Small = Int in 0..1000

context trait Out:
    fn emit(n: int) -> int errors WriteFailed

context struct A:
    k: Small

fn emit(n: int, context c: A) -> int errors WriteFailed:
    n + c.k

struct Ev:
    n: int

fn deep(n: int, context out: Out) -> int errors WriteFailed:
    x = out.emit(n)
    yield Ev {n: x}
    out.emit(x)

fn worker(n: int) -> Ev errors WriteFailed:
    y = deep(n)
    return Ev {n: y}

with context A {k: 5}
coroutine {step, first} = worker(10):
    on WriteFailed:
        Ev {n: -1}
second = step():
    on WriteFailed:
        Ev {n: -2}
[first.n, second.n]
}

test co-context-trait {a deep context-trait operation inside a coroutine: the provider is selected statically at construction and the same implementation runs after a resume} -body {
    coAgree $contextProgram
} -result {value {[15, 20]}}

# A context trait Out in its own module with a yielding consumer, and two
# concrete contexts A (adds its k) and B (multiplies by its k), each in its
# own owner module.
set coContextLib {
co/out.bot {error WriteFailed

struct Ev:
    n: int

context trait Out:
    fn emit(n: int) -> int errors WriteFailed

fn deep(n: int, context out: Out) -> int errors WriteFailed:
    x = out.emit(n)
    yield Ev {n: x}
    out.emit(x)

fn worker(n: int) -> Ev errors WriteFailed:
    y = deep(n)
    return Ev {n: y}
}
co/a.bot {import co::out
type Small = Int in 0..1000

context struct A:
    k: Small

fn create() -> A:
    A {k: 1}

fn emit(n: int, context c: A) -> int errors WriteFailed:
    n + c.k
}
co/b.bot {import co::out
type Small = Int in 0..1000

context struct B:
    k: Small

fn create() -> B:
    B {k: 100}

fn emit(n: int, context c: B) -> int errors WriteFailed:
    n * c.k
}
}

test co-context-fixed-at-construction {the provider is the one selected at construction: a context implementing the same trait installed before a resume changes nothing (no re-selection per resume), while a new construction there is ambiguous} -body {
    set program "import co::out\nimport co::a\nimport co::b\nwith context co::a::create()\ncoroutine {step, first} = co::out::worker(10):\n    on WriteFailed:\n        co::out::Ev {n: -1}\nwith context co::b::create()\nsecond = step():\n    on WriteFailed:\n        co::out::Ev {n: -2}\n"
    coWithModules $::coContextLib {
        list [coAgree "${program}\[first.n, second.n\]\n"] \
            [lindex [coCode "${program}coroutine {step: again} = co::out::worker(1):\n    on WriteFailed:\n        co::out::Ev {n: -3}\n1\n"] end]
    }
} -cleanup {unset -nocomplain program} -result {{value {[11, 12]}} AMBIGUOUS-CONTEXT-IMPLEMENTATION}

# A substitute environment for the portable io::IO trait (lib/io.bot): writes
# succeed up to the context's limit and fail with WriteFailed beyond it.
set coLimitedLib {
limited.bot {import io
import str
type Limit = Int in 0..1000

context struct Limited:
    max: Limit

fn create(max: Limit) -> Limited:
    Limited {max: max}

fn write_text(text: str, context c: Limited) -> unit errors WriteFailed:
    if str::length(text) > c.max:
        fail WriteFailed
    unit

fn write_error_text(text: str, context c: Limited) -> unit errors WriteFailed:
    fail WriteFailed
}
}

test co-context-portable-io {io::print_line deep inside a coroutine, through the real io::IO context trait and a substitute context: each segment writes through the provider selected at construction, and a write failure after a resume crosses that resume and stays the coroutine's terminal error} -body {
    set program "import io\nimport limited\nstruct Ev:\n    n: int\nfn say(text: str) -> int errors WriteFailed:\n    io::print_line(text)\n    yield Ev {n: 10}\n    1\nfn worker() -> Ev errors WriteFailed:\n    a = say(\"hi\")\n    b = say(\"a much longer line\")\n    return Ev {n: a + b}\n"
    set driver "coroutine {step, first} = worker():\n    on WriteFailed:\n        Ev {n: -1}\nsecond = step():\n    on WriteFailed:\n        Ev {n: -2}\nthird = step():\n    on WriteFailed:\n        Ev {n: -3}\n\[first.n, second.n, third.n\]\n"
    coWithModules $::coLimitedLib {
        lmap max {100 5} {
            coAgree "${program}with context limited::create($max)\n$driver"
        }
    }
} -cleanup {unset -nocomplain program driver} -result {{value {[10, 10, 2]}} {value {[10, -2, -3]}}}

test co-executable-linux-io {a standalone executable printing through io::print_line and linux::io::LinuxIO before and after a yield: descriptor 1 receives both lines in segment order, then the result; the same under GC stress} -constraints linuxX86_64 -body {
    set exe [file join [temporaryDirectory] co-io-[pid]]
    native::executable [surface::compile "import str\nimport io\nimport linux::io\nstruct Ev:\n    n: int\nfn report(label: str) -> unit errors WriteFailed:\n    io::print_line(str::concat(\"report \", label))\nfn worker(n: int) -> Ev errors WriteFailed:\n    report(\"before\")\n    yield Ev {n: n}\n    report(\"after\")\n    return Ev {n: n + 2}\nwith context linux::io::create()\ncoroutine {step, first} = worker(1):\n    on WriteFailed:\n        Ev {n: -1}\nlast = step():\n    on WriteFailed:\n        Ev {n: -2}\n\[first.n, last.n\]\n" -warnings off] $exe
    set plain [exec $exe]
    set ::env(BOTLISH_NATIVE_GC_STRESS) 1
    try {
        set stressed [exec $exe]
    } finally {
        unset ::env(BOTLISH_NATIVE_GC_STRESS)
        file delete $exe
    }
    list $plain [expr {$stressed eq $plain}]
} -cleanup {unset -nocomplain exe plain stressed} -result {{report before
report after
[1, 3]} 1}

test co-context-trait-native {native evidence: the yielding clone of deep takes no context argument and calls the selected implementation directly; the thunk calls the clone of worker} -constraints linuxX86_64 -body {
    set nir [coNir $contextProgram]
    set deep [lsearch -inline -regexp [split $nir \n] {^func [0-9]+ "deep<}]
    list [regexp {params=1 } $deep] [regexp {op coyield} $nir] [expr {[regexp -all {op cocreate} $nir] == 1}] \
        [regexp {callvalue} $nir]
} -cleanup {unset -nocomplain nir deep} -result {1 1 1 0}

test co-trait-polymorphic {a trait-polymorphic yielding function is monomorphized into an ordinary yielding clone} -body {
    coAgree {import str

trait Named:
    fn name(value: Named) -> str

struct Person:
    first: str

fn name(p: Person) -> str:
    p.first

struct Ev:
    text: str

fn greet(x: Named) -> Ev:
    yield Ev {text: str::concat("hello ", x.name())}
    return Ev {text: str::concat("bye ", x.name())}

coroutine {step, first} = greet(Person {first: "Ada"})
last = step()
[first.text, last.text]
}
} -result {value {["hello Ada", "bye Ada"]}}

