# higher-order-completions.test -- completion analysis through untyped
# callables degrades conservatively (STATIC-COMPLETION-PROOFS.md,
# "Precision and the erased-callable contract"; hir/completions.tcl).
#
# A callable that declares errors may reach an untyped parameter through a
# semantic instance (`call(raise, k)` with `fn call(f, x): f(x)`), and from
# there an untyped call `f(x)` whose generic body says nothing about its
# errors. Failure to prove an error absent never becomes proof that it is
# absent:
#
# * an argument of exact callable type is recovered: `f(x)` is analyzed as a
#   call of `raise` (its effective errors, under the facts at hand);
# * a parameter or capture of the body being checked is charged at the call
#   that passed it;
# * any other untyped callee is charged the erased-callable contract (every
#   error of every callable the program passes into an untyped parameter),
#   and the walk becomes incomplete: its summary falls back to the callee's
#   declared contract at the function-instance boundary.
#
# A fallback is a may-set: it never proves a known failure (KNOWN-ERROR) and
# never hides one. A program that erases no error-bearing callable is
# analyzed exactly as before.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]

testConstraint linuxX86_64 [expr {$::tcl_platform(os) eq "Linux"
    && $::tcl_platform(machine) in {x86_64 amd64}}]

# Three errors: a payload-free one and two payload-bearing twins (the same
# fields), raised by one function per selector.
set hocDecls {error E1

error E2:
    code: int

error E3:
    code: int

fn raise(x) -> int errors E1, E2, E3:
    if x == 1:
        fail E1
    if x == 2:
        fail E2 {code: 20}
    if x == 3:
        fail E3 {code: 30}
    0

fn call(f, x):
    f(x)

fn generic(x: int) -> int errors E1, E2, E3:
    call(raise, x)

fn g1(x: int) -> int errors E1, E2, E3:
    generic(x)

fn g2(x: int) -> int errors E1, E2, E3:
    g1(x)

fn partial(x: int) -> int errors E1, E3:
    call(raise, x):
        on E2 {code}:
            code + 1

fn outer(f, x):
    fn inner(y):
        f(y)
    inner(x)

fn make(f):
    fn inner(y):
        f(y)
    inner

fn use(kf: Fn{args: [int], return: any, errors: []}, x: int):
    kf(x)

fn rec(f, n: int, x):
    if n < 1:
        f(x)
    else:
        rec(f, n - 1, x)

}

# The paths of the corpus: NAME -> {PREAMBLE CALL}: the handled call is CALL
# (with `k` the selector), after PREAMBLE's statements in the same function.
set hocPaths {
    direct      {{} {call(raise, k)}}
    declaring   {{} {generic(k)}}
    layers      {{} {g2(k)}}
    capture     {{} {outer(raise, k)}}
    returned    {{h = make(raise)} {h(k)}}
    structural  {{} {use(make(raise), k)}}
    recursion   {{} {rec(raise, 2, k)}}
}

# The observing function of PATH: the handled call with a handler for each
# error of HANDLED (each answering its tag and what it received), its value
# otherwise; then the driver over the selectors 0..3.
proc hocProgram {path handled} {
    lassign [dict get $::hocPaths $path] preamble call
    set text $::hocDecls
    append text "fn observe(k: int):\n"
    if {$preamble ne ""} {
        append text "    $preamble\n"
    }
    append text "    r = $call:\n"
    foreach e $handled {
        switch -- $e {
            E1 { append text "        on E1:\n            return \[\"E1\"\]\n" }
            E2 { append text "        on E2 {code}:\n            return \[\"E2\", code\]\n" }
            E3 { append text "        on E3 d:\n            return \[\"E3\", d.code\]\n" }
        }
    }
    append text "    \[r\]\n\n"
    append text "\[observe(0), observe(1), observe(2), observe(3)\]\n"
    return $text
}

# The sorted diagnostic kinds of TEXT compiled with -strict 0 ("" if none).
proc hocKinds {text} {
    set hir [surface::compile $text -strict 0 -warnings off]
    return [lsort -unique [lmap d [hir::diagnostics $hir] {dict get $d kind}]]
}

# The diagnostics of TEXT (-strict 0) as sorted {KIND FUNCTION MESSAGE}
# triples: FUNCTION the function whose body the diagnosed expression is in
# ("top" for the program's own), a message naming a declared error reduced to
# that error.
proc hocDiagnostics {text} {
    set hir [surface::compile $text -strict 0 -warnings off]
    return [lsort -unique [lmap d [hir::diagnostics $hir] {
        set e [dict get $d expr]
        set block [dict get $hir scopes [hir::get $hir $e scope] invocation]
        set where [expr {$block eq "" ? "top" : [hir::signatures::Name $hir $block]}]
        set message [dict get $d message]
        if {[regexp {declared error "([^"]+)"} $message -> name]} {
            set message $name
        }
        list [dict get $d kind] $where $message
    }]]
}

# The effective errors the completion analysis stamped on every `handle` node
# of TEXT's function NAME, in pre-order.
proc hocHandleErrors {text name} {
    set hir [surface::compile $text -warnings off]
    set block [hocBlock $hir $name]
    set region [hir::semantic::Region $hir $block]
    return [lmap e [hirFind $hir handle] {
        if {$e ni $region} continue
        hir::completions::effectiveErrorsOf $hir $e
    }]
}

# The ExprId of the block of the function bound to NAME in HIR.
proc hocBlock {hir name} {
    foreach e [hirFind $hir bind] {
        set b [hir::get $hir $e binding]
        if {[dict get $hir bindings $b name] eq $name} {
            return [hir::get $hir $e value]
        }
    }
    error "no function $name"
}

# ---------------------------------------------------------------------------
# A8: the original reproducer, payload-free and payload-bearing.

set hocOriginal {error E1
error E2

fn raise(x) -> int errors E1, E2:
    if x == 1:
        fail E1
    if x == 2:
        fail E2
    0

fn call(f, x):
    f(x)

fn generic(x) -> int errors E1, E2:
    call(raise, x)

fn bad(x):
    generic(x):
        on E2:
            -1

}

test hoc-original-payload-free {the brief's reproducer: E1 escapes generic through call, so a handler for E2 alone is UNHANDLED-ERROR} -body {
    hocDiagnostics "${hocOriginal}0\n"
} -result {{UNHANDLED-ERROR bad E1}}

test hoc-original-payload-free-both-handled {handling both errors is accepted and runs on every backend} -body {
    sourceAgree [string map {"        on E2:" "        on E1:\n            -2\n        on E2:"} "${hocOriginal}\[bad(0), bad(1), bad(2)\]\n"]
} -result {value {[0, -2, -1]}}

set hocOriginalPayload [string map {
    "error E1\nerror E2\n" "error E1:\n    origin: str\n\nerror E2:\n    origin: str\n\n"
    "fail E1\n" "fail E1 {origin: \"one\"}\n"
    "fail E2\n" "fail E2 {origin: \"two\"}\n"
    "on E2:" "on E2 {origin}:"
    "            -1" "            -1 + 0 * str::length(origin)"
} $hocOriginal]

test hoc-original-payload {the payload-bearing reproducer: the same UNHANDLED-ERROR for E1} -body {
    hocDiagnostics "import str\n${hocOriginalPayload}0\n"
} -result {{UNHANDLED-ERROR bad E1}}

test hoc-original-payload-both-handled {the payload-bearing reproducer with both errors handled runs on every backend} -body {
    sourceAgree [string map {"        on E2 {origin}:" "        on E1 {origin}:\n            -2 + 0 * str::length(origin)\n        on E2 {origin}:"} \
        "import str\n${hocOriginalPayload}\[bad(0), bad(1), bad(2)\]\n"]
} -result {value {[0, -2, -1]}}

# ---------------------------------------------------------------------------
# A9: the wrong handler, along every path.

foreach path [dict keys $hocPaths] {
    test hoc-wrong-handler-$path "$path: the raised E1 with handlers for E2 and E3 only is UNHANDLED-ERROR" -body {
        hocKinds [hocProgram $path {E2 E3}]
    } -result UNHANDLED-ERROR
    test hoc-wrong-twin-$path "$path: the payload-bearing E3 with a handler for its same-shaped twin E2 only is UNHANDLED-ERROR" -body {
        hocKinds [hocProgram $path {E1 E2}]
    } -result UNHANDLED-ERROR
    test hoc-wrong-twin-reverse-$path "$path: E2 with a handler for its twin E3 only is UNHANDLED-ERROR" -body {
        hocKinds [hocProgram $path {E1 E3}]
    } -result UNHANDLED-ERROR
    test hoc-all-handled-$path "$path: every error handled: accepted, and every backend agrees on the model" -body {
        sourceAgree [hocProgram $path {E3 E1 E2}]
    } -result {value {[[0], ["E1"], ["E2", 20], ["E3", 30]]}}
}

test hoc-wrong-handler-specialized {the generic path on Cranelift with and without specialization: a wrong handler is never accepted, the right ones run identically} -body {
    list [hocKinds [hocProgram declaring {E2 E3}]] \
        [sourceAgree [hocProgram declaring {E1 E2 E3}] {cranelift cranelift-generic}]
} -result {UNHANDLED-ERROR {value {[[0], ["E1"], ["E2", 20], ["E3", 30]]}}}

test hoc-nested-handled {a handled call inside another handled call: partial handles E2 itself, the caller must still handle E1 and E3} -body {
    set ok "${hocDecls}fn observe(k: int):\n    r = partial(k):\n        on E1:\n            return \[\"E1\"\]\n        on E3 d:\n            return \[\"E3\", d.code\]\n    \[r\]\n\n\[observe(0), observe(1), observe(2), observe(3)\]\n"
    set bad [string map {"        on E1:\n            return \[\"E1\"\]\n" ""} $ok]
    list [hocKinds $bad] [sourceAgree $ok]
} -result {UNHANDLED-ERROR {value {[[0], ["E1"], [21], ["E3", 30]]}}}

test hoc-undeclared-through-helper {a declaring function that lets an undeclared error through an untyped helper is diagnosed at its own body} -body {
    hocDiagnostics "${hocDecls}fn narrow(x: int) -> int errors E2:\n    call(raise, x)\n\nfn top(k: int):\n    narrow(k):\n        on E2 {code}:\n            code\n\ntop(0)\n"
} -result {{UNHANDLED-ERROR narrow E1} {UNHANDLED-ERROR narrow E3} {UNHANDLED-ERROR top E1} {UNHANDLED-ERROR top E3}}

test hoc-top-level {an unhandled error through an untyped helper at the top level is UNHANDLED-ERROR (it used to escape at run time)} -body {
    hocDiagnostics "${hocDecls}call(raise, 1)\n"
} -result {{UNHANDLED-ERROR top E1} {UNHANDLED-ERROR top E2} {UNHANDLED-ERROR top E3}}

test hoc-mutable-array-factory {a factory closure that calls an erased callable: mutable_array::generate charges what it may raise} -body {
    set text "import mutable_array\n${hocDecls}fn gen(f, k):\n    fn factory(i):\n        f(k)\n    mutable_array::capacity(mutable_array::generate(1, factory))\n\n"
    list [hocKinds "${text}gen(raise, 1)\n"] \
        [sourceAgree "${text}fn top(k: int):\n    gen(raise, k):\n        on E1:\n            -1\n        on E2 d:\n            -2\n        on E3 d:\n            -3\n\n\[top(0), top(1), top(3)\]\n"]
} -result {UNHANDLED-ERROR {value {[1, -1, -3]}}}

# ---------------------------------------------------------------------------
# A11: what the analysis says covers what every backend observes.

foreach path [dict keys $hocPaths] {
    test hoc-differential-$path "$path: every error identity observed on every backend is in the handled call's effective errors" -body {
        set text [hocProgram $path {E1 E2 E3}]
        set static [lindex [hocHandleErrors $text observe] 0]
        lassign [sourceAgree $text {interp compile cranelift-generic cranelift}] kind value
        set observed [lsort -unique [regexp -all -inline {E[123]} $value]]
        list $observed [expr {[llength [lmap e $observed {expr {$e in $static ? [continue] : $e}}]] == 0}]
    } -result {{E1 E2 E3} 1}
}

# ---------------------------------------------------------------------------
# A7: KNOWN-ERROR stays sound.

set hocAlways {error E1

fn always(x: int) -> int errors E1:
    fail E1

fn call(f, x):
    f(x)

}

test hoc-known-error-direct {a statically known failure of an exact call is still KNOWN-ERROR, handled or not} -body {
    hocKinds "${hocAlways}fn top(k: int):\n    always(k):\n        on E1:\n            -1\n\ntop(0)\n"
} -result KNOWN-ERROR

test hoc-known-error-not-through-helper {through an untyped helper the failure is a may-fact: no KNOWN-ERROR is invented, the handler runs} -body {
    sourceAgree "${hocAlways}fn top(k: int):\n    call(always, k):\n        on E1:\n            -1\n\n\[top(0), top(5)\]\n"
} -result {value {[-1, -1]}}

test hoc-known-error-fallback-not-definite {an incomplete summary (a returned closure) falls back to may-errors: never KNOWN-ERROR, and the success path still runs} -body {
    sourceAgree [hocProgram returned {E1 E2 E3}]
} -result {value {[[0], ["E1"], ["E2", 20], ["E3", 30]]}}

# ---------------------------------------------------------------------------
# A6/A10: exact analysis keeps its precision where it has it.

# MAYBE fails E1 when its first argument is negative and E2 when its second
# is: with the second argument 1, only E1 is possible, and so is success.
set hocMaybe {error E1

error E2:
    code: int

fn maybe(x: int, y: int) -> int errors E1, E2:
    if x < 0:
        fail E1
    if y < 0:
        fail E2 {code: 1}
    x

fn call2(f, x, y):
    f(x, y)

fn use0(k: int):
    maybe(k, 1):
        on E1:
            -1

}

test hoc-precise-without-erasure {exact narrowing: maybe(k, 1) can only fail E1, so a handler for E1 alone is enough (no erasure in the program)} -body {
    set text "${hocMaybe}\[use0(-1), use0(5)\]\n"
    list [hir::completions::erasedErrorsOf [surface::compile $text -warnings off]] [hocHandleErrors $text use0] [sourceAgree $text]
} -result {{} E1 {value {[-1, 5]}}}

test hoc-precise-with-erasure {the same narrowing in a program that also erases maybe into an untyped parameter elsewhere: unchanged} -body {
    set text "${hocMaybe}fn other(k: int):\n    call2(maybe, k, -1):\n        on E1:\n            -1\n        on E2 d:\n            d.code\n\n\[use0(-1), use0(5), other(1)\]\n"
    list [hir::completions::erasedErrorsOf [surface::compile $text -warnings off]] [hocHandleErrors $text use0] [sourceAgree $text]
} -result {{E1 E2} E1 {value {[-1, 5, 1]}}}

test hoc-precise-recovery {an exact callable argument is recovered: call2(maybe, k, 1) is analyzed as maybe(k, 1), so E1 alone is enough} -body {
    set text "${hocMaybe}fn via(k: int):\n    call2(maybe, k, 1):\n        on E1:\n            -1\n\n\[via(-1), via(5)\]\n"
    list [hocHandleErrors $text via] [sourceAgree $text]
} -result {E1 {value {[-1, 5]}}}

test hoc-precise-recovery-wrong-handler {recovery keeps the identity: call2(maybe, 1, k) can only fail E2, so a handler for E1 alone is UNHANDLED-ERROR} -body {
    hocDiagnostics "${hocMaybe}fn via(k: int):\n    call2(maybe, 1, k):\n        on E1:\n            -1\n\n0\n"
} -result {{UNHANDLED-ERROR via E2}}

# The declared-contract fallback: WRAPPER declares E1 and E3; under k = 5
# its own `fail E1` (for a negative k) is unreachable, but it also calls a closure that calls
# an erased callable (incomplete), so its summary keeps every declared error.
set hocWrapper {error E1

error E3:
    code: int

fn raise3(x) -> int errors E3:
    if x == 3:
        fail E3 {code: 30}
    5

fn make(f):
    fn inner(y):
        f(y)
    inner

h = make(raise3)

fn wrapper(k: int) -> int errors E1, E3:
    if k < 0:
        fail E1
    h(k)

fn wrapper2(k: int) -> int errors E1, E3:
    if k < 0:
        fail E1
    h(k):
        on E3 d:
            fail E3 {code: d.code}

}

test hoc-fallback-declared-contract {an incomplete summary keeps the callee's whole declared contract: under k = 5 E1 is no longer proven absent} -body {
    list [hocKinds "${hocWrapper}fn use():\n    wrapper(5):\n        on E3 d:\n            d.code\n\nuse()\n"] \
        [sourceAgree "${hocWrapper}fn use():\n    wrapper(5):\n        on E1:\n            -1\n        on E3 d:\n            d.code\n\nuse()\n"]
} -result {UNHANDLED-ERROR {value 5}}

test hoc-fallback-declared-contract-handled {the same through a handled call in the callee (EvalHandle propagates incompleteness too)} -body {
    hocKinds "${hocWrapper}fn use():\n    wrapper2(5):\n        on E3 d:\n            d.code\n\nuse()\n"
} -result UNHANDLED-ERROR

test hoc-fallback-not-without-loss {without the lost call, exact narrowing applies: wrapper3(5) needs no handler for E1} -body {
    sourceAgree "${hocWrapper}fn wrapper3(k: int) -> int errors E1, E3:\n    if k < 0:\n        fail E1\n    raise3(k)\n\nfn use():\n    wrapper3(5):\n        on E3 d:\n            d.code\n\nuse()\n"
} -result {value 5}

# ---------------------------------------------------------------------------
# The completion summary itself (hir::completions::analyzeBlock).

test hoc-summary-exact-recovered {call's summary under an exact raise argument: complete, exactly raise's errors} -body {
    set hir [surface::compile "${hocDecls}0\n" -warnings off]
    hir::completions::resetCache
    set raise [hocBlock $hir raise]
    set sub [hir::completions::analyzeBlock $hir [hocBlock $hir call] \
        [list [hir::range::unknown] [hir::range::unknown]] {} {} [list [list block $raise] clean] {}]
    list [dict get $sub normal] [dict get $sub errors] [dict get $sub incomplete]
} -result {1 {E1 E2 E3} 0}

test hoc-summary-exact-narrowed {under an exact maybe argument and y = 1 the recovered call raises E1 only} -body {
    set hir [surface::compile "${hocMaybe}fn other(k: int):\n    call2(maybe, k, -1):\n        on E1:\n            -1\n        on E2 d:\n            d.code\n\n0\n" -warnings off]
    hir::completions::resetCache
    set maybe [hocBlock $hir maybe]
    set sub [hir::completions::analyzeBlock $hir [hocBlock $hir call2] \
        [list [hir::range::unknown] [hir::range::unknown] [hir::range::point 1]] {} {} \
        [list [list block $maybe] clean clean] {}]
    list [dict get $sub errors] [dict get $sub incomplete]
} -result {E1 0}

test hoc-summary-unknown {call's summary under an unknown callable: incomplete, charged the erased-callable contract -- never empty} -body {
    set hir [surface::compile "${hocDecls}0\n" -warnings off]
    hir::completions::resetCache
    set sub [hir::completions::analyzeBlock $hir [hocBlock $hir call] \
        [list [hir::range::unknown] [hir::range::unknown]] {} {} {unknown clean} {}]
    list [hir::completions::erasedErrorsOf $hir] [dict get $sub normal] [dict get $sub errors] [dict get $sub incomplete]
} -result {{E1 E2 E3} 1 {E1 E2 E3} 1}

test hoc-summary-clean {a clean callable (a parameter of the body being checked) is charged where it was passed: nothing here, complete} -body {
    set hir [surface::compile "${hocDecls}0\n" -warnings off]
    hir::completions::resetCache
    set sub [hir::completions::analyzeBlock $hir [hocBlock $hir call] \
        [list [hir::range::unknown] [hir::range::unknown]] {} {} {clean clean} {}]
    list [dict get $sub errors] [dict get $sub incomplete]
} -result {{} 0}

test hoc-erased-contract {the erased-callable contract: the errors of the callables passed into untyped parameters, through closures and structure} -body {
    list [hir::completions::erasedErrorsOf [surface::compile "${hocDecls}0\n" -warnings off]] \
        [hir::completions::erasedErrorsOf [surface::compile "${hocAlways}0\n" -warnings off]] \
        [hir::completions::erasedErrorsOf [surface::compile "${hocAlways}fn twice(f, x):\n    \[f\]\n\ntwice(always, 1)\n" -strict 0 -warnings off]]
} -result {{E1 E2 E3} {} E1}

# ---------------------------------------------------------------------------
# Affine values on the error edge of a call an erased callable may raise
# through (hir/affine.tcl's error edges): released, never leaked.

proc hocLiveCoroutines {} {
    return [core::value::int [llength [info commands {::core::coroutines::co[0-9]*}]]]
}
if {"test_hoc_live" ni [core::native::names]} {
    core::registerNative test_hoc_live -arity 0 -impl hocLiveCoroutines
}

set hocCoroutine {import coroutine

struct Message:
    value: int

struct Event:
    value: int

error E1

fn raise(x) -> int errors E1:
    if x == 1:
        fail E1
    0

fn worker(base: int, resume Message) -> Event:
    message = yield Event {value: base}
    Event {value: message.value}

fn call(f, x):
    f(x)

fn probe(x) -> int errors E1:
    coroutine {step, first} = worker(10)
    r = call(raise, x)
    e = step(Message {value: r + first.value})
    e.value

fn top(x):
    probe(x):
        on E1:
            -1

[top(0), top(1), test_hoc_live()]
}

test hoc-affine-error-edge {a coroutine live across a call an erased callable fails through is released on the error edge: none alive on the Tcl backends} -body {
    sourceAgree $hocCoroutine {interp compile}
} -result {value {[10, -1, 0]}}

test hoc-affine-error-edge-native {natively: every coroutine released, none swept} -constraints {
    linuxX86_64
} -body {
    set text [string map {test_hoc_live() 0} $hocCoroutine]
    list [sourceAgree $text] [dict get [native::allocationReport [surface::compile $text -warnings off] summary] coroutines]
} -result {{value {[10, -1, 0]}} {stacksMapped 1 stacksReused 1 released 2 releasedSuspended 1 sweptSuspended 0}}

cleanupTests
