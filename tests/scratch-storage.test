} -result {same 1 {stale 0 protocol 0}}

test ss-run-inner-region {a String of an outer loop's region, read and kept in every iteration of an inner loop with a region of its own: each inner reset releases only the inner iteration's Strings, the outer String stays intact, poisoned and under GC stress} -constraints ssNative -body {
    set hir [surface::compile {import std::int
import std::str
import std::mutable_vector

fn run(n: int) -> int:
    fold i from 0 to n with intermediate acc 0:
        a = std::int::to_string(i).concat("-a")
        v = std::mutable_vector::from_list([""])
        inner = fold j from 0 to 3 with intermediate b 0:
            t = std::int::to_string(j * 5).concat("+")
            v.push(a)
            b + std::str::length(t) + std::str::length(a)
        joined = fold k from 0 to std::mutable_vector::length(v) with intermediate out "":
            item = std::mutable_vector::at(v, k):
                on IndexNotFound:
