test ss-run-stress-variety {a long GC-stress run of mixed work: short Strings and Strings over the object limit alternating (every other one falls back to the heap), empty Strings, heap Strings kept across the loop between placed ones, nested calls, a failure handled every fifth call, chunks small enough to grow: the outcome is interp's at N = 60 and N = 240, and the storage reserved and in use is the same at both} -constraints ssNative -body {
    set text {import std::int
import std::str
import std::mutable_vector

error Odd:
    n: int

fn check(i: int) -> int errors Odd:
    s = std::int::to_string(i).concat("?")
    if i.mod(5) == 1:
        fail Odd {n: std::str::length(s)}
    std::str::length(s)

fn step(i: int) -> int:
    short = std::int::to_string(i)
    big = std::str::substring("abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz", 0, 2 + i.mod(2) * 40):
        on LowerUnderrun:
            "?"
        on UpperOverrun:
            "?"
    empty = std::str::substring(short, 0, 0):
        on LowerUnderrun:
            "?"
        on UpperOverrun:
            "?"
    c = check(i):
        on Odd details:
            details.n
    std::str::length(short) + std::str::length(big) + std::str::length(empty) + c

fn run(n: int) -> str:
    kept = std::mutable_vector::from_list([""])
    total = fold i from 0 to n with intermediate acc 0:
        kept.push(std::int::to_string(i).concat(","))
        acc + step(i)
    joined = fold k from 0 to std::mutable_vector::length(kept) with intermediate out "":
        item = std::mutable_vector::at(kept, k):
            on IndexNotFound:
                "?"
        out.concat(item)
    std::int::to_string(total).concat(":").concat(joined)

std::str::length(run(@N@)) * 1000 + std::str::length(std::int::to_string(@N@))
}
    set limits {BOTLISH_NATIVE_SCRATCH_CHUNK 64 BOTLISH_NATIVE_SCRATCH_MAX_OBJECT 32 BOTLISH_NATIVE_GC_STRESS 1}
    set result {}
    set shape {}
    foreach n {60 240} {
        set hir [surface::compile [string map [list @N@ $n] $text] -warnings off]
        set value [withEnvironment $limits {outcomeUnderHir cranelift $hir}]
        set s [ssScratch [withEnvironment $limits {ssAlloc $hir}]]
        lappend result [expr {$value eq [outcomeUnderHir interp $hir]}] [expr {[dict get $s fallbackLarge] >= $n / 2}] \
            [dict get $s staleRoots] [dict get $s protocolErrors]
        lappend shape [list [dict get $s reservations] [dict get $s peakReserved] [dict get $s peakOccupancy]]
    }
    lappend result [expr {[lindex $shape 0] eq [lindex $shape 1]}]
} -result {1 1 0 0 1 1 0 0 1}

test ss-run-exits {a loop region left by break, continue, an early return and a handled and a propagated failure: every outcome unchanged, poisoned and under GC stress, and the storage released (no occupancy left over the run's peak)} -constraints ssNative -body {
    set hir [surface::compile {import std::int
import std::str

error Odd:
    n: int

fn check(i: int) -> int errors Odd:
    s = std::int::to_string(i).concat("?")
    if i.mod(5) == 1:
        fail Odd {n: std::str::length(s)}
    std::str::length(s)

fn scan(n: int) -> int:
    fold i from 0 to n with intermediate acc 0:
        t = std::int::to_string(i).concat("!")
        if i.mod(7) == 3:
            continue
        if i == n - 2:
            break
        v = check(i):
            on Odd {n}:
                n + std::str::length(t)
        acc + v + std::str::length(t)

fn early(n: int) -> int:
    loop i from 0 to n:
        u = std::int::to_string(i).concat("#")
        if i == 13:
            return std::str::length(u)
    0

fn propagate(i: int) -> int errors Odd:
    w = std::int::to_string(i).concat("~")
    std::str::length(w) + check(i)

fold k from 0 to 40 with intermediate total 0:
    p = propagate(k):
        on Odd {n}:
            n * 100
    total + scan(k) + early(k) + p
} -warnings off]
    set agree [ssAgree $hir]
    set poisoned [withEnvironment {BOTLISH_NATIVE_SCRATCH_POISON 1} {outcomeUnderHir cranelift $hir}]
    set stressed [withEnvironment {BOTLISH_NATIVE_GC_STRESS 1} {outcomeUnderHir cranelift $hir}]
    set report [ssAlloc $hir]
    list [lindex $agree 0] [expr {$poisoned eq [lindex $agree 1]}] [expr {$stressed eq [lindex $agree 1]}] \
        [dict get $report total allocations] [ssClean $report]
} -result {same 1 1 0 {stale 0 protocol 0}}

test ss-run-nested {an outer String lives across calls of functions with their own regions, a destination chain, a recursion (which gets no region: its Strings are the heap's) and a recursion through a function value (unseen by the direct call graph: its regions nest level by level): each callee releases only its own storage, the outer String is intact, poisoned and under GC stress} -constraints ssNative -body {
    set hir [surface::compile {import std::int
import std::str

fn inner(i: int) -> int:
    x = std::int::to_string(i * 3).concat("inner")
    std::str::length(x)

fn piece(i: int) -> str:
    std::int::to_string(i).concat("/")

fn pieces(i: int) -> str:
    piece(i).concat(piece(i + 1))

fn depth(n: int) -> int:
    d = std::int::to_string(n).concat("d")
    if n == 0:
        std::str::length(d)
    else:
        depth(n - 1) + std::str::length(d)

struct Box:
    f: Fn{args: [int], return: int}

fn via(f: Fn{args: [int], return: int}, n: int) -> int:
    v = std::int::to_string(n).concat("v")
    f(n) + std::str::length(v)

fn hidden(n: int) -> int:
    h = std::int::to_string(n * 7).concat("h")
    if n == 0:
        std::str::length(h)
    else:
        b = Box{f: hidden}
        via(b.f, n - 1) + std::str::length(h)

fn outer(i: int) -> int:
    kept = std::int::to_string(i).concat("-kept-")
    a = inner(i)
    p = pieces(i)
    b = depth(i.mod(6))
    c = hidden(i.mod(5))
    q = std::str::length(p)
    a + b + c + q + std::str::length(kept.concat(p))

fold i from 0 to 300 with intermediate acc 0:
    acc + outer(i)
} -warnings off]
    set agree [ssAgree $hir]
    set poisoned [withEnvironment {BOTLISH_NATIVE_SCRATCH_POISON 1} {outcomeUnderHir cranelift $hir}]
    set stressed [withEnvironment {BOTLISH_NATIVE_GC_STRESS 1} {outcomeUnderHir cranelift $hir}]
    set plan [ssPlan $hir]
    set report [ssAlloc $hir]
    list [lindex $agree 0] [expr {$poisoned eq [lindex $agree 1]}] [expr {$stressed eq [lindex $agree 1]}] \
        [dict get [ssUnit $plan piece*] capable] [dict get [ssUnit $plan pieces*] capable] [dict get [ssUnit $plan depth*] recursive] \
        [dict get [ssUnit $plan depth*] frame] [dict get [ssUnit $plan hidden*] frame] [dict get [ssUnit $plan via*] frame] \
        [dict get $report byKind String allocations] [ssClean $report]
} -result {same 1 1 1 1 1 0 1 1 2100 {stale 0 protocol 0}}

