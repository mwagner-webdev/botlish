} -result {same 1 0 {stale 0 protocol 0}}

test ss-run-dest-stale {a destination is the one call's: after a call that passed one, a direct call of the same instance whose result escapes passes none, and the callee builds that result on the heap; a call through a function value reaches an instance with no frame; the values kept past every region stay intact} -constraints ssNative -body {
    set hir [surface::compile {import std::int
import std::str
import std::mutable_vector

fn piece(i: int) -> str:
    std::int::to_string(i).concat("/")

fn other(i: int) -> str:
    std::int::to_string(i * 2).concat("\\")

fn used(i: int) -> int:
    std::str::length(piece(i))

fn through(f: Fn{args: [int], return: str}, i: int) -> str:
    f(i)

fn run(n: int) -> str:
    kept = std::mutable_vector::from_list(["k"])
    loop i from 0 to n:
        t = std::int::to_string(i).concat("t")
        u = used(i) + std::str::length(t)
        chosen = if i.mod(2) == 0:
            piece
        else:
            other
        kept.push(through(chosen, u))
        kept.push(piece(u + 1))
    fold k from 0 to std::mutable_vector::length(kept) with intermediate out "":
        item = std::mutable_vector::at(kept, k):
            on IndexNotFound:
                "?"
        out.concat(item)

run(30)
} -warnings off]
    set agree [ssAgree $hir]
    set stressed [withEnvironment {BOTLISH_NATIVE_GC_STRESS 1} {outcomeUnderHir cranelift $hir}]
    set plan [ssPlan $hir]
    list [lindex $agree 0] [expr {$stressed eq [lindex $agree 1]}] [dict get [ssUnit $plan piece*] capable] [ssClean [ssAlloc $hir]]
} -result {same 1 1 {stale 0 protocol 0}}

test ss-run-closures {Strings inside a closure called directly, a closure passed as a callback and a closure that escapes: each closure's own regions are its own; nothing it keeps is in scratch storage} -constraints ssNative -body {
    set hir [surface::compile {import std::int
import std::str

fn apply(f: Fn{args: [int], return: int}, n: int) -> int:
    fold i from 0 to n with intermediate acc 0:
        acc + f(i)

fn maker(i: int) -> Fn{args: [], return: str}:
    s = std::int::to_string(i).concat("@")
    fn made() -> str:
        s.concat("!")
    made

fn run(n: int) -> int:
    fn local(i: int) -> int:
        std::str::length(std::int::to_string(i).concat("local"))
    kept = maker(n)
    apply(local, n) + std::str::length(kept()) + std::str::length(kept())

fold i from 0 to 50 with intermediate acc 0:
    acc + run(i)
} -warnings off]
    set agree [ssAgree $hir]
    set stressed [withEnvironment {BOTLISH_NATIVE_GC_STRESS 1 BOTLISH_NATIVE_SCRATCH_POISON 1} {outcomeUnderHir cranelift $hir}]
