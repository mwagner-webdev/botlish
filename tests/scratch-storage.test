test ss-run-context-escape {a String a callee both returns and stores into a context: it escapes through the context, so the callee takes no destination for it and its caller's region never holds it, though the caller confines the result} -constraints ssNative -body {
    set hir [surface::compile {import std::int
import std::str
import std::mutable_vector

context struct Journal:
    entries: MutableVector[str]

fn note(i: int, context j: Journal) -> str:
    s = std::int::to_string(i * 7).concat("#")
    j.entries.push(s)
    s

fn count(i: int) -> int:
    std::str::length(note(i))

fn dump(context j: Journal) -> str:
    fold k from 0 to std::mutable_vector::length(j.entries) with intermediate out "":
        item = std::mutable_vector::at(j.entries, k):
            on IndexNotFound:
                "?"
        out.concat(item)

with context Journal {entries: std::mutable_vector::from_list(["start"])}
total = fold i from 0 to 30 with intermediate acc 0:
    t = std::int::to_string(i).concat(".")
    acc + count(i) + std::str::length(t)
dump().concat(std::int::to_string(total))
} -warnings off]
    set agree [ssAgree $hir]
