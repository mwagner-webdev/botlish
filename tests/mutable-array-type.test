# mutable-array-type.test -- the parameterized MutableArray[T] type
# (PARAMETERIZED-MUTABLEARRAY.md).
#
# MutableArray[T] is a *static* contract: every slot value is a T and every
# store preserves that. The runtime representation is unchanged by it (no
# element type in the object). Since MUTABLE-ARRAY.md an array is a value:
# a copy is a logical copy (copy-on-write), never an alias, so -- like
# MutableVector[T] -- MutableArray[T] is covariant (an array of a subtype is
# one of the supertype), the raw kind `mutarray` is MutableArray[any], and
# a typed array may be erased into `any`, the raw kind or an untyped
# aggregate: a write through the erased copy can never reach the typed
# original. (Before, MutableArray had reference semantics, was invariant,
# and every such erasure was rejected: an erased alias could have stored a
# value the original's contract excluded. The tests below that pinned those
# rejections now pin that the same programs are accepted and leave the
# original intact -- MUTABLE-ARRAY.md, "Compatibility".) A typed parameter
# still admits exactly its contract, like List[T] and MutableVector[T].
#
# Sections: surface/canonical type, construction (from_list, create), typed
# get/set/freeze/capacity/copy, variance, erasure, refinement,
# specialization and propagation, exact-value separation, no-generics and
# no-cast fences, runtime semantics on every backend (also under GC stress).

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]

interp recursionlimit {} 100000

set parityBackends {interp compile cranelift-generic cranelift}

# The HIR of SRC.
proc maCompile {src {strict 1}} {
    set path [makeFile $src ma-program.bot]
    try {
        surface::readProgramFile $path -strict $strict
    } finally {
        removeFile ma-program.bot
    }
}

# {ERRORCODE MATCHED} for a program rejected at compile time, else "accepted".
proc maRejects {src pattern} {
    if {![catch {maCompile $src} message options]} {
        return "accepted"
    }
    set code [lrange [dict get $options -errorcode] 0 2]
    if {[lindex $code 0] eq "SURFACE"} {
        # A syntax error's third element is a located detail dict.
        set code [lrange $code 0 1]
    }
    list $code [string match $pattern $message]
}

# The whole diagnostic of a rejected program ("accepted" if it compiles).
proc maMessage {src} {
    if {![catch {maCompile $src} message]} {
        return "accepted"
    }
    return $message
}

# The semantic type of the last top-level expression of SRC.
proc maLast {src} {
    set hir [maCompile $src]
    hir::types::show [hir::typeOf $hir [lindex [hir::roots $hir] end]]
}

proc maBlock {hir name} {
    dict for {b binding} [dict get $hir bindings] {
        if {[dict get $binding name] ne $name || [dict get $binding declaredBy] eq ""} continue
        set value [hir::get $hir [dict get $binding declaredBy] value]
        if {[hir::kind $hir $value] eq "block"} { return $value }
    }
    error "no function named $name"
}

# The inferred result type of function NAME of SRC.
proc maResult {src name} {
    set hir [maCompile $src]
    set type [hir::typeOf $hir [maBlock $hir $name]]
    string trim [lindex [split [hir::types::show $type] >] end]
}

# "same" if every backend agrees on the outcome of source SRC; otherwise every
# outcome, backend by backend.
proc maParity {src} {
    set exprs [hir::lower [maCompile $src 0]]
    set outcomes [lmap backend $::parityBackends {outcomeUnder $backend $exprs}]
    if {[llength [lsort -unique $outcomes]] == 1} {
        return same
    }
    return [join [lmap backend $::parityBackends outcome $outcomes {list $backend $outcome}] " / "]
}

# The shown value of SRC under the reference interpreter.
proc maValue {src} {
    set exprs [hir::lower [maCompile $src 0]]
    lindex [outcomeUnder interp $exprs] 1
}

# The error code SRC raises on every backend (compiled with diagnostics
# recovered), one code per backend.
proc maErrors {src} {
    set exprs [hir::lower [maCompile $src 0]]
    lmap backend $::parityBackends {lindex [outcomeUnder $backend $exprs] 1}
}

# The first line of a diagnostic that mentions PATTERN, for message pins.
proc maHas {src pattern} {
    string match $pattern [maMessage $src]
}

# ---------------------------------------------------------------------------
# Surface syntax and canonical type (spec items 3, 32, 74)

test mat-syn-1 {MutableArray[T] is legal wherever a type is legal: parameter, result, List element, Fn} -body {
    list \
        [maLast "import mutable_array\nfn f(xs: MutableArray\[str\]) -> int:\n    mutable_array::capacity(xs)\nf(mutable_array::create(1, \"a\"))"] \
        [maLast "import list\nimport mutable_array\nfn f(xs: List\[MutableArray\[int\]\]) -> int:\n    list::length(xs)\nf(\[mutable_array::create(1, 0)\])"] \
        [maLast "import mutable_array\nfn f(xs: MutableArray\[int\]) -> MutableArray\[int\]:\n    xs\nf(mutable_array::create(1, 0))"] \
        [maLast "import mutable_array\nfn f(g: Fn{args: \[MutableArray\[str\]\], return: MutableArray\[str\], errors: \[\]}, m: MutableArray\[str\]) -> MutableArray\[str\]:\n    g(m)\nfn id(x: MutableArray\[str\]) -> MutableArray\[str\]:\n    x\nf(id, mutable_array::create(1, \"a\"))"]
} -result {int int {MutableArray[int]} {MutableArray[str]}}

test mat-syn-2 {nested applied types work in every position} -body {
    list \
        [maLast "import mutable_array\nfn f(xs: MutableArray\[List\[str\]\]) -> int:\n    mutable_array::capacity(xs)\nf(mutable_array::create(1, \[\"a\"\]))"] \
        [maLast "import mutable_array\nfn f(xs: MutableArray\[MutableArray\[int\]\]) -> int:\n    mutable_array::capacity(xs)\nf(mutable_array::create(1, mutable_array::create(1, 0)))"] \
        [maLast "import list\nimport mutable_array\nfn f(xs: List\[MutableArray\[List\[int\]\]\]) -> int:\n    list::length(xs)\nf(\[mutable_array::create(1, \[1\])\])"] \
        [maLast "import immutable_set\nimport mutable_array\nfn f(xs: MutableArray\[ImmutableSet\[int\]\]) -> int:\n    mutable_array::capacity(xs)\nf(mutable_array::create(1, immutable_set::from_list(\[1\])))"]
} -result {int int int int}

test mat-syn-3 {canonical rendering is source-legible and stable} -body {
    list \
        [maLast "import mutable_array\nmutable_array::create(1, 0)"] \
        [maLast "import mutable_array\nmutable_array::create(1, \[\"a\"\])"] \
        [maLast "import mutable_array\n\[mutable_array::create(1, 0)\]"] \
        [maLast "import mutable_array\nmutable_array::from_list(\[mutable_array::create(1, \"a\")\])"] \
        [maLast "fn f(g: Fn{args: \[MutableArray\[str\]\], return: List\[int\], errors: \[\]}):\n    g\nfn h(m: MutableArray\[str\]) -> List\[int\]:\n    \[1\]\nf(h)"] \
        [maLast "fn f(g: Fn{args: \[MutableArray\[str\]\], return: List\[int\], errors: \[\]}) -> Fn{args: \[MutableArray\[str\]\], return: List\[int\], errors: \[\]}:\n    g\nfn h(m: MutableArray\[str\]) -> List\[int\]:\n    \[1\]\nf(h)"]
} -result {{MutableArray[int]} {MutableArray[List[str]]} {List[MutableArray[int]]} {MutableArray[MutableArray[str]]} {block(e5)/1 -> List[int]} {Fn{args: [MutableArray[str]], return: List[int], errors: []}}}

test mat-syn-4 {the type is a real constructor: arity errors, unknown constructors, hyphenated spellings} -body {
    lmap src {
        "fn f(m: MutableArray):\n    0\nf(1)"
        "fn f(m: MutableArray\[int, str\]):\n    0\nf(1)"
        "fn f(m: mutable-array\[int\]):\n    0\nf(1)"
        "fn f(m: Array\[int\]):\n    0\nf(1)"
    } {lindex [maRejects $src *] 0}
} -result {{CORE SEMANTIC TYPE} {SURFACE SYNTAX} {SURFACE SYNTAX} {CORE SEMANTIC TYPE}}

test mat-syn-5 {no source-level type variables or generic syntax were added} -body {
    lmap src {
        "fn f\[T\](x: T) -> T:\n    x\nf(1)"
        "fn f(x: T):\n    x\nf(1)"
        "fn f(x) where T:\n    x\nf(1)"
    } {lindex [maRejects $src *] 0}
} -result {{SURFACE SYNTAX} {CORE SEMANTIC TYPE} {SURFACE SYNTAX}}

test mat-syn-6 {equivalent spellings are one canonical type: a declared type equals the constructed one} -body {
    maLast "import mutable_array\nfn f(m: MutableArray\[str\]) -> MutableArray\[str\]:\n    m\nf(mutable_array::create(2, \"x\"))"
} -result {MutableArray[str]}

test mat-syn-7 {the runtime kind of a typed and a raw array is the same} -body {
    lmap src {"import mutable_array\nmutable_array::create(1, 0)" "import mutable_array\nmutable_array::allocate(1)" "import mutable_array\nmutable_array::from_list(\[\"a\"\])"} {
        set hir [maCompile $src]
        hir::types::kindOf [hir::typeOf $hir [lindex [hir::roots $hir] end]]
    }
} -result {mutarray mutarray mutarray}

# ---------------------------------------------------------------------------
# Type algebra (spec items 33-35)

test mat-alg-1 {covariance: an array of a subtype is an array of the supertype (MUTABLE-ARRAY.md: a value, like MutableVector); never the other way} -body {
    list \
        [hir::types::subtype {mutarray int} {mutarray int}] \
        [hir::types::subtype {mutarray int} {mutarray str}] \
        [hir::types::subtype {mutarray str} {mutarray any}] \
        [hir::types::subtype {mutarray any} {mutarray str}] \
        [hir::types::subtype {mutarray {list int}} {mutarray {list int}}] \
        [hir::types::subtype {mutvec str} {mutvec any}]
} -result {1 0 1 0 1 1}

test mat-alg-2 {every typed array is a subtype of the raw kind (MutableArray[any]); the raw kind only of MutableArray[any]} -body {
    list \
        [hir::types::subtype {mutarray str} mutarray] \
        [hir::types::subtype {mutarray any} mutarray] \
        [hir::types::subtype mutarray {mutarray str}] \
        [hir::types::subtype mutarray {mutarray any}]
} -result {1 1 0 1}

test mat-alg-3 {lub of equal contracts is that contract; different contracts join elementwise, as a MutableVector's do; with the raw kind, the raw kind} -body {
    list \
        [hir::types::show [hir::types::lub {mutarray int} {mutarray int}]] \
        [hir::types::show [hir::types::lub {mutarray int} {mutarray str}]] \
        [hir::types::show [hir::types::lub {mutarray int} mutarray]] \
        [hir::types::show [hir::types::lub {mutarray int} any]] \
        [hir::types::show [hir::types::lub {mutarray int} int]] \
        [hir::types::show [hir::types::lub {mutarray any} mutarray]] \
        [hir::types::show [hir::types::lub {mutvec int} {mutvec str}]]
} -result {{MutableArray[int]} {MutableArray[any]} mutarray any any mutarray {MutableVector[any]}}

test mat-alg-4 {glb (requirement meet): the same contract; a kind requirement adopts it; conflicts have no meet} -body {
    list \
        [hir::signatures::Meet {mutarray int} {mutarray int}] \
        [hir::signatures::Meet {mutarray int} mutarray] \
        [hir::signatures::Meet mutarray {mutarray int}] \
        [hir::signatures::Meet {mutarray int} {mutarray str}] \
        [hir::types::glb {mutarray int} {mutarray str}]
} -result {{mutarray int} {mutarray int} {mutarray int} {} {}}

test mat-alg-5 {narrow: a kind test keeps a typed contract; a declared contract is adopted by a raw/unknown value} -body {
    list \
        [hir::types::narrow {mutarray str} mutarray] \
        [hir::types::narrow any mutarray] \
        [hir::types::narrow mutarray {mutarray str}] \
        [hir::types::narrow any {mutarray str}] \
        [hir::types::narrow {mutarray str} {mutarray str}]
} -result {{mutarray str} mutarray {mutarray str} {mutarray str} {mutarray str}}

test mat-alg-6 {MutableArray[any] folds neither into the raw kind nor into List's any-collapse} -body {
    list [hir::types::show [hir::types::resolveApplication MutableArray any]] \
        [hir::types::show [hir::types::resolveApplication List any]]
} -result {{MutableArray[any]} list}

test mat-alg-7 {show/parse round trip through the HIR text reader's type notation} -body {
    lmap text {
        {MutableArray[int]}
        {MutableArray[List[str]]}
        {List[MutableArray[int]]}
        {MutableArray[MutableArray[str]]}
        {MutableArray[any]}
        {Fn{args: [MutableArray[str]], return: List[int], errors: []}}
    } {
        set type [hir::read::ParseType $text 1]
        expr {[hir::types::show $type] eq $text && [hir::types::canonical $type] eq $type}
    }
} -result {1 1 1 1 1 1}

# ---------------------------------------------------------------------------
# Raw allocation stays raw (spec items 4, 18, 19, 60, 61, 77)

test mat-raw-1 {mutable_array::allocate still returns the bare mutarray kind} -body {
    list [maLast "import mutable_array\nmutable_array::allocate(3)"] \
        [lindex [dict get [core::native::metadata mutable_array::allocate] resultType] 0]
} -result {mutarray mutarray}

test mat-raw-2 {raw arrays stay heterogeneous and dynamically writable} -body {
    set src "import mutable_array\nm = mutable_array::allocate(2)\nmutable_array::set(m, 0, \"x\")\nmutable_array::set(m, 1, 123)\nm"
    list [maLast $src] [maRejects $src *]
} -result {mutarray accepted}

test mat-raw-3 {raw get is any, raw freeze is list, raw capacity is int} -body {
    list \
        [maLast "import mutable_array\nm = mutable_array::allocate(2)\nmutable_array::at(m, 0)"] \
        [maLast "import mutable_array\nm = mutable_array::allocate(2)\nmutable_array::freeze(m, 2)"] \
        [maLast "import mutable_array\nm = mutable_array::allocate(2)\nmutable_array::capacity(m)"]
} -result {any list int}

test mat-raw-4 {an allocate + fill pattern is never promoted to a typed array} -body {
    list \
        [maLast "import mutable_array\nm = mutable_array::allocate(2)\nmutable_array::set(m, 0, 1)\nmutable_array::set(m, 1, 2)\nm"] \
        [maLast "import mutable_array\nfn build(n: int):\n    m = mutable_array::allocate(n)\n    loop i from 0 to n:\n        mutable_array::set(m, i, i)\n    m\nbuild(3)"] \
        [maLast "import mutable_array\nm = mutable_array::allocate(1)\nmutable_array::set(m, 0, \"s\")\nmutable_array::at(m, 0)"]
} -result {mutarray mutarray any}

test mat-raw-5 {no runtime element-type predicate or descriptor exists} -body {
    list \
        [lmap n {MutableArrayOf? mutarray_element_type mutable_array_element_type} {expr {$n in [core::native::names]}}] \
        [lindex [maRejects "import mutable_array\nMutableArrayOf?(mutable_array::allocate(1))" *] 0]
} -result {{0 0 0} {CORE SEMANTIC UNBOUND}}

test mat-raw-6 {native registry: get/freeze only gain result *shapes*; their declared metadata is unchanged} -body {
    lmap n {mutable_array::allocate mutable_array::capacity mutable_array::at mutable_array::set mutable_array::copy mutable_array::freeze} {
        set m [core::native::metadata $n]
        list $n [dict get $m paramTypes] [dict get $m resultType] [dict get $m resultShape]
    }
} -result {{mutable_array::allocate int mutarray {}} {mutable_array::capacity mutarray int {}} {mutable_array::at {mutarray int} any {mutarray-element 0}} {mutable_array::set {mutarray int any} unit {}} {mutable_array::copy {mutarray int mutarray int int} unit {}} {mutable_array::freeze {mutarray int} list {mutarray-freeze 0}}}

# ---------------------------------------------------------------------------
# from_list (spec items 6, 51-54)

test mat-fl-1 {from_list(List[T]) is MutableArray[T]} -body {
    list \
        [maLast "import mutable_array\nmutable_array::from_list(\[1, 2, 3\])"] \
        [maLast "import mutable_array\nmutable_array::from_list(\[\"a\", \"b\"\])"] \
        [maLast "import mutable_array\nmutable_array::from_list(\[\[1\], \[2\]\])"] \
        [maLast "import mutable_array\nmutable_array::from_list(\[true, false\])"]
} -result {{MutableArray[int]} {MutableArray[str]} {MutableArray[List[int]]} {MutableArray[bool]}}

test mat-fl-2 {a broad list, List[any], a heterogeneous literal and the empty list give MutableArray[any]; a call of a wrapper whose declared parameter is that broad type gets the narrower element type its argument actually has (semantic instance: the declared contract stays broad, the instance knows more)} -body {
    list \
        [maLast "import mutable_array\nfn f(xs: list):\n    mutable_array::from_list(xs)\nf(\[1\])"] \
        [maResult "import mutable_array\nfn f(xs: list):\n    mutable_array::from_list(xs)\nf(\[1\])" f] \
        [maLast "import mutable_array\nmutable_array::from_list(\[\"x\", 1, true\])"] \
        [maLast "import mutable_array\nmutable_array::from_list(\[\])"] \
        [maLast "import mutable_array\nfn f(xs: List\[any\]):\n    mutable_array::from_list(xs)\nf(\[1\])"]
} -result {{MutableArray[int]} {MutableArray[any]} {MutableArray[any]} {MutableArray[any]} {MutableArray[int]}}

test mat-fl-3 {from_list of List[MutableArray[int]] nests without erasure} -body {
    list \
        [maLast "import mutable_array\na = mutable_array::from_list(\[1, 2\])\nb = mutable_array::from_list(\[a\])\nb"] \
        [maLast "import mutable_array\na = mutable_array::from_list(\[1, 2\])\nb = mutable_array::from_list(\[a\])\nmutable_array::at(b, 0)"] \
        [maLast "import mutable_array\na = mutable_array::from_list(\[1, 2\])\nb = mutable_array::from_list(\[a\])\na"]
} -result {{MutableArray[MutableArray[int]]} {MutableArray[int]} {MutableArray[int]}}

test mat-fl-4 {get(i) : T and freeze(n) : List[T] for a dynamic index/count} -body {
    list \
        [maLast "import mutable_array\nfn f(i: int) errors IndexNotFound:\n    m = mutable_array::from_list(\[1, 2, 3\])\n    mutable_array::at(m, i)\nf(1)"] \
        [maLast "import mutable_array\nfn f(n: int) errors LowerUnderrun, UpperOverrun:\n    m = mutable_array::from_list(\[1, 2, 3\])\n    mutable_array::freeze(m, n)\nf(2)"] \
        [maLast "import mutable_array\nfn f(n: int) errors LowerUnderrun, UpperOverrun:\n    m = mutable_array::from_list(\[\"a\"\])\n    mutable_array::freeze(m, n)\nf(1)"]
} -result {int {List[int]} {List[str]}}

test mat-fl-5 {from_list of an exact literal does not put exact-value facts into the type} -body {
    list [maLast "import mutable_array\nm = mutable_array::from_list(\[1, 2, 3\])\nm"] \
        [maLast "import mutable_array\nxs = \[1, 2, 3\]\nmutable_array::from_list(xs)"]
} -result {{MutableArray[int]} {MutableArray[int]}}

test mat-fl-6 {the argument contract is unchanged: a non-List is rejected, never coerced -- at run time, like every intrinsic's (from_list is a registered native since MUTABLE-ARRAY.md)} -body {
    list [maErrors "import mutable_array\nmutable_array::from_list(123)"] [maErrors "import mutable_array\nmutable_array::from_list(\"abc\")"]
} -result {{{CORE SEMANTIC TYPE} {CORE SEMANTIC TYPE} {CORE SEMANTIC TYPE} {CORE SEMANTIC TYPE}} {{CORE SEMANTIC TYPE} {CORE SEMANTIC TYPE} {CORE SEMANTIC TYPE} {CORE SEMANTIC TYPE}}}

# ---------------------------------------------------------------------------
# create (spec items 7, 8, 50, 65, 66)

test mat-cr-1 {create(n, default : T) is MutableArray[T] for the static type of default (also through an untyped wrapper: its semantic instance sees the argument's type)} -body {
    list \
        [maLast "import mutable_array\nmutable_array::create(10, 0)"] \
        [maLast "import mutable_array\nmutable_array::create(10, \"x\")"] \
        [maLast "import mutable_array\nmutable_array::create(10, true)"] \
        [maLast "import mutable_array\nmutable_array::create(10, \[1, 2\])"] \
        [maLast "import mutable_array\nfn f(d):\n    mutable_array::create(10, d)\nf(1)"] \
        [maLast "import mutable_array\nmutable_array::create(2, mutable_array::create(1, 0))"]
} -result {{MutableArray[int]} {MutableArray[str]} {MutableArray[bool]} {MutableArray[List[int]]} {MutableArray[int]} {MutableArray[MutableArray[int]]}}

test mat-cr-2 {a refined default gives that domain (Byte), never an exact-value element} -body {
    set prelude "import mutable_array\ntype Byte = Int in 0..255\nfn mk(b: Byte):\n    mutable_array::create(2, b)\n"
    list [maLast "${prelude}mk(3)"] [maLast "import mutable_array\nmutable_array::create(2, 200)"]
} -result {{MutableArray[int[Byte]]} {MutableArray[int]}}

test mat-cr-3 {capacity 0 still establishes T from the default} -body {
    list [maLast "import mutable_array\nmutable_array::create(0, \"x\")"] [maLast "import mutable_array\nmutable_array::create(0, \[1\])"]
} -result {{MutableArray[str]} {MutableArray[List[int]]}}

test mat-cr-4 {create's capacity parameter is an Int: a non-Int is the TYPE error of every intrinsic, at run time (create is a registered native since MUTABLE-ARRAY.md)} -body {
    list [maErrors "import mutable_array\nmutable_array::create(\"a\", 1)"] [lindex [maRejects "mutable_array::create(1.5, 1)" *] 0] \
        [lindex [maRejects "import mutable_array\nfn f(n):\n    mutable_array::create(n, 1)\nf(2)" "*"] 0]
} -result {{{CORE SEMANTIC TYPE} {CORE SEMANTIC TYPE} {CORE SEMANTIC TYPE} {CORE SEMANTIC TYPE}} {SURFACE SYNTAX} accepted}

test mat-cr-5 {positive control: create, capacity, get and a legal set} -body {
    set src "import mutable_array\nm = mutable_array::create(3, \"x\")\nmutable_array::set(m, 1, \"y\")\n\[mutable_array::capacity(m), mutable_array::at(m, 0), mutable_array::at(m, 1), mutable_array::at(m, 2)\]"
    list [maRejects $src *] [maLast "import mutable_array\nm = mutable_array::create(3, \"x\")\nmutable_array::at(m, 2)"]
} -result {accepted str}

test mat-cr-6 {create's registered result is the raw kind; the typed relation belongs to the call (its -result-shape)} -body {
    set meta [core::native::metadata mutable_array::create]
    list [dict get $meta resultType] [dict get $meta resultShape] [maLast "import mutable_array\nmutable_array::create(1, 0)"]
} -result {mutarray {mutarray-create 1} {MutableArray[int]}}

# ---------------------------------------------------------------------------
# Typed set: a proof, never a widening (spec items 21, 22, 64, 73)

test mat-set-1 {a store of an admissible value is legal; an inadmissible one is a static TYPE error} -body {
    list \
        [maRejects "import mutable_array\nm = mutable_array::create(2, \"x\")\nmutable_array::set(m, 1, \"y\")" *] \
        [maRejects "import mutable_array\nm = mutable_array::create(2, \"x\")\nmutable_array::set(m, 1, 123)" *] \
        [maRejects "import mutable_array\nm = mutable_array::create(2, 0)\nmutable_array::set(m, 0, \"hello\")" *]
} -result {accepted {{CORE SEMANTIC TYPE} 1} {{CORE SEMANTIC TYPE} 1}}

test mat-set-2 {the diagnostic names the value type, the element type and the array type} -body {
    maMessage "import mutable_array\nm = mutable_array::create(2, \"x\")\nmutable_array::set(m, 1, 123)"
} -match glob -result {*value of type int is not admissible to element type str of MutableArray\[str\]*}

test mat-set-3 {a store never widens T: the array keeps its type after a rejected store} -body {
    list [maResult "import mutable_array\nfn f() errors IndexNotFound:\n    m = mutable_array::create(2, 0)\n    m\nf()" f] \
        [lindex [maRejects "import mutable_array\nfn f() errors IndexNotFound:\n    m = mutable_array::create(2, 0)\n    mutable_array::set(m, 0, \"s\")\n    m\nf()" *] 0]
} -result {{MutableArray[int]} {CORE SEMANTIC TYPE}}

test mat-set-4 {an unproven value (any) is rejected, not guarded at run time} -body {
    lindex [maRejects "import mutable_array\nfn f(v):\n    m = mutable_array::create(2, 0)\n    mutable_array::set(m, 0, v)\nf(1)" *] 0
} -result {CORE SEMANTIC TYPE}

test mat-set-5 {integer-domain stores use the ordinary range proof} -body {
    set prelude "import mutable_array\ntype Byte = Int in 0..255\nfn mk(b: Byte):\n    mutable_array::create(2, b)\nm = mk(3)\n"
    set store "w = mutable_array::set(m, 0, %s):\n    on IndexNotFound:\n        unit\nw"
    list [maRejects "${prelude}[format $store 200]" *] [maRejects "${prelude}[format $store 300]" *] \
        [maRejects "${prelude}fn put(x: int):\n    w = mutable_array::set(m, 0, x):\n        on IndexNotFound:\n            unit\n    w\nput(1)" *]
} -result {accepted {{CORE SEMANTIC TYPE} 1} {{CORE SEMANTIC TYPE} 1}}

test mat-set-6 {a store into MutableArray[any] and into a raw array accepts anything} -body {
    list \
        [maRejects "import mutable_array\nm = mutable_array::from_list(\[1, \"a\"\])\nmutable_array::set(m, 0, true)" *] \
        [maRejects "import mutable_array\nm = mutable_array::allocate(1)\nmutable_array::set(m, 0, true)" *]
} -result {accepted accepted}

test mat-set-7 {nested arrays: the inner value must be the inner contract, not a raw or differently typed array} -body {
    set prelude "import mutable_array\ninner = mutable_array::from_list(\[\"a\"\])\nouter = mutable_array::create(2, inner)\n"
    list \
        [maRejects "${prelude}mutable_array::set(outer, 1, mutable_array::from_list(\[\"b\"\]))" *] \
        [maRejects "${prelude}mutable_array::set(outer, 1, mutable_array::from_list(\[1\]))" *] \
        [maRejects "${prelude}mutable_array::set(outer, 1, mutable_array::allocate(1))" *]
} -result {accepted {{CORE SEMANTIC TYPE} 1} {{CORE SEMANTIC TYPE} 1}}

test mat-set-8 {a typed store is a compile-time error only: no runtime guard, bounds behavior unchanged (an index past the capacity is IndexNotFound; the program's handler sees it on every backend)} -body {
    set src "import mutable_array\nimport str\nfn f(i: int) errors IndexNotFound:\n    m = mutable_array::create(2, 0)\n    mutable_array::set(m, i, 1)\n    m\nfn outcome(i: int):\n    m = f(i):\n        on IndexNotFound:\n            return \"IndexNotFound\"\n    mutable_array::freeze(m, mutable_array::capacity(m))\noutcome(str::length(str::concat(\"hel\", \"lo\")))"
    list [maRejects $src *] [maParity $src] [maValue $src]
} -result {accepted same {"IndexNotFound"}}

# ---------------------------------------------------------------------------
# get / freeze / capacity (spec items 20, 23, 24, 62)

test mat-get-1 {get(MutableArray[T]) is T; get(mutarray) stays any} -body {
    list \
        [maLast "import mutable_array\nmutable_array::at(mutable_array::create(2, \"s\"), 0)"] \
        [maLast "import mutable_array\nmutable_array::at(mutable_array::create(2, \[1\]), 0)"] \
        [maLast "import mutable_array\nmutable_array::at(mutable_array::allocate(2), 0)"] \
        [maLast "import mutable_array\nmutable_array::at(mutable_array::from_list(\[1, \"a\"\]), 0)"]
} -result {str {List[int]} any any}

test mat-get-2 {the typed result feeds ordinary typing: a typed int read is an int; a raw read is any} -body {
    list [maLast "import mutable_array\nm = mutable_array::create(2, 0)\nmutable_array::at(m, 0) + 1"] \
        [maLast "import mutable_array\nm = mutable_array::allocate(2)\nmutable_array::at(m, 0) + 1"]
} -result {int int}

test mat-get-3 {get returns the element contract of a nested array (the inner contract survives)} -body {
    maLast "import mutable_array\nouter = mutable_array::create(1, mutable_array::create(1, \"s\"))\nv = mutable_array::at(mutable_array::at(outer, 0), 0):\n    on IndexNotFound:\n        \"z\"\nv"
} -result str

test mat-frz-1 {freeze(MutableArray[T], n) is List[T] for a dynamic n; raw freeze stays list} -body {
    list \
        [maLast "import mutable_array\nfn f(n: int) errors LowerUnderrun, UpperOverrun:\n    mutable_array::freeze(mutable_array::create(3, \"s\"), n)\nf(2)"] \
        [maLast "import mutable_array\nmutable_array::freeze(mutable_array::allocate(3), 3)"] \
        [maLast "import mutable_array\nmutable_array::freeze(mutable_array::from_list(\[1, \"a\"\]), 2)"]
} -result {{List[str]} list list}

test mat-frz-2 {freeze of nested arrays keeps the inner contract} -body {
    maLast "import mutable_array\nmutable_array::freeze(mutable_array::from_list(\[mutable_array::create(1, 0)\]), 1)"
} -result {List[MutableArray[int]]}

test mat-cap-1 {capacity is int for both, independent of the element type} -body {
    list \
        [maLast "import mutable_array\nmutable_array::capacity(mutable_array::create(3, \"s\"))"] \
        [maLast "import mutable_array\nmutable_array::capacity(mutable_array::allocate(3))"] \
        [maLast "import mutable_array\nfn f(m: MutableArray\[List\[str\]\]) -> int:\n    mutable_array::capacity(m)\nf(mutable_array::create(1, \[\"a\"\]))"]
} -result {int int int}

# ---------------------------------------------------------------------------
# copy (spec item 25)

test mat-cp-1 {same-contract copy works; a destination of an equivalent contract too} -body {
    list \
        [maRejects "import mutable_array\na = mutable_array::from_list(\[\"a\", \"b\"\])\nb = mutable_array::create(2, \"z\")\nmutable_array::copy(b, 0, a, 0, 2)" *] \
        [maRejects "import mutable_array\na = mutable_array::create(1, 0)\nb = mutable_array::create(1, 9)\nmutable_array::copy(b, 0, a, 0, 1)" *]
} -result {accepted accepted}

test mat-cp-2 {a source element type that is not admissible to the destination is rejected} -body {
    list \
        [maRejects "import mutable_array\na = mutable_array::from_list(\[1, 2\])\nb = mutable_array::create(2, \"z\")\nmutable_array::copy(b, 0, a, 0, 2)" *] \
        [maRejects "import mutable_array\na = mutable_array::from_list(\[\"a\", 1\])\nb = mutable_array::create(2, \"z\")\nmutable_array::copy(b, 0, a, 0, 2)" *]
} -result {{{CORE SEMANTIC TYPE} 1} {{CORE SEMANTIC TYPE} 1}}

test mat-cp-3 {a raw or unknown source into a typed destination is never accepted} -body {
    list \
        [maRejects "import mutable_array\na = mutable_array::allocate(2)\nb = mutable_array::create(2, \"z\")\nmutable_array::copy(b, 0, a, 0, 2)" *] \
        [maRejects "import mutable_array\nfn f(a):\n    b = mutable_array::create(2, \"z\")\n    mutable_array::copy(b, 0, a, 0, 2)\nf(mutable_array::allocate(2))" *]
} -result {{{CORE SEMANTIC TYPE} 1} {{CORE SEMANTIC TYPE} 1}}

test mat-cp-4 {raw <-> raw and typed -> raw (non-bearing elements) keep the legacy behavior} -body {
    list \
        [maRejects "import mutable_array\na = mutable_array::allocate(2)\nb = mutable_array::allocate(2)\nmutable_array::copy(b, 0, a, 0, 2)" *] \
        [maRejects "import mutable_array\na = mutable_array::from_list(\[\"a\"\])\nb = mutable_array::allocate(2)\nmutable_array::copy(b, 0, a, 0, 1)" *]
} -result {accepted accepted}

test mat-cp-5 {copying typed arrays into untyped storage is accepted (each copied element is a logical copy: no write through the untyped slot reaches the original); copying elements that carry a callable contract of their own would still lose it} -body {
    list \
        [maRejects "import mutable_array\na = mutable_array::from_list(\[mutable_array::from_list(\[\"a\"\])\])\nb = mutable_array::allocate(2)\nmutable_array::copy(b, 0, a, 0, 1)" *] \
        [maRejects "import mutable_array\na = mutable_array::from_list(\[mutable_array::from_list(\[\"a\"\])\])\nb = mutable_array::create(2, mutable_array::from_list(\[\"z\"\]))\nmutable_array::copy(b, 0, a, 0, 1)" *] \
        [maRejects "import mutable_array\nerror E\nfn g(x: int) -> int errors E:\n    fail E\na = mutable_array::from_list(\[g\])\nb = mutable_array::allocate(2)\nmutable_array::copy(b, 0, a, 0, 1)" "*cannot erase element contract of MutableArray\\\[Fn*"]
} -result {accepted accepted {{CORE SEMANTIC TYPE} 1}}

test mat-cp-6 {a narrower source domain may be copied into a wider destination, never the reverse} -body {
    set prelude "import mutable_array\ntype Byte = Int in 0..255\nfn mkb(b: Byte):\n    mutable_array::create(2, b)\nfn mki(i: int):\n    mutable_array::create(2, i)\nx = mkb(3)\ny = mki(3)\n"
    set copy "w = mutable_array::copy(%s, 0, %s, 0, 2):\n    on LowerUnderrun:\n        unit\n    on UpperOverrun:\n        unit\nw"
    list [maRejects "${prelude}[format $copy y x]" *] [maRejects "${prelude}[format $copy x y]" *]
} -result {accepted {{CORE SEMANTIC TYPE} 1}}

# ---------------------------------------------------------------------------
# Variance (spec items 10, 19, 20, 33, 56, 68, 72). A typed parameter admits
# exactly its contract, as List[T] and MutableVector[T] parameters do
# (hir::range::AggregateAdmits); the subtype relation is covariant
# (MUTABLE-ARRAY.md), which function types and results see.

test mat-inv-1 {a MutableArray[int] parameter does not admit a MutableArray[Byte], even though every Byte is an int (exact admission, as for List[int])} -body {
    set prelude "import mutable_array\ntype Byte = Int in 0..255\nfn mk(b: Byte):\n    mutable_array::create(2, b)\nfn take(xs: MutableArray\[int\]) -> int:\n    mutable_array::capacity(xs)\n"
    list [maRejects "${prelude}take(mk(3))" *] [maRejects "${prelude}take(mutable_array::create(2, 1))" *]
} -result {{{CORE SEMANTIC TYPE} 1} accepted}

test mat-inv-2 {a MutableArray[any] parameter does not admit a MutableArray[str], nor a MutableArray[str] parameter a MutableArray[any] (exact admission)} -body {
    list \
        [maRejects "import mutable_array\nfn f(xs: MutableArray\[any\]) -> int:\n    mutable_array::capacity(xs)\nf(mutable_array::create(1, \"a\"))" *] \
        [maRejects "import mutable_array\nfn f(xs: MutableArray\[str\]) -> int:\n    mutable_array::capacity(xs)\nf(mutable_array::from_list(\[\"a\", 1\]))" *]
} -result {{{CORE SEMANTIC TYPE} 1} {{CORE SEMANTIC TYPE} 1}}

test mat-inv-3 {admission is exact at depth: a List[MutableArray[any]] parameter does not admit a List[MutableArray[str]]} -body {
    list \
        [maRejects "import list\nimport mutable_array\nfn f(xs: List\[MutableArray\[any\]\]) -> int:\n    list::length(xs)\nf(\[mutable_array::create(1, \"a\")\])" *] \
        [maRejects "import mutable_array\nfn f(xs: MutableArray\[MutableArray\[any\]\]) -> int:\n    mutable_array::capacity(xs)\nf(mutable_array::create(1, mutable_array::create(1, \"a\")))" *]
} -result {{{CORE SEMANTIC TYPE} 1} {{CORE SEMANTIC TYPE} 1}}

test mat-inv-4 {a typed parameter admits exactly its contract; the raw and the wrong array are rejected} -body {
    set decl "import mutable_array\nfn first(xs: MutableArray\[str\]) -> str errors IndexNotFound:\n    mutable_array::at(xs, 0)\n"
    list \
        [maRejects "${decl}v = first(mutable_array::create(2, \"a\")):\n    on IndexNotFound:\n        \"z\"\nv" *] \
        [maRejects "${decl}v = first(mutable_array::create(2, 1)):\n    on IndexNotFound:\n        \"z\"\nv" *] \
        [maRejects "${decl}v = first(mutable_array::allocate(2)):\n    on IndexNotFound:\n        \"z\"\nv" *] \
        [maRejects "${decl}v = first(mutable_array::from_list(\[\"a\", 1\])):\n    on IndexNotFound:\n        \"z\"\nv" *]
} -result {accepted {{CORE SEMANTIC TYPE} 1} {{CORE SEMANTIC TYPE} 1} {{CORE SEMANTIC TYPE} 1}}

test mat-inv-5 {structural Fn: a parameter admits exactly its contract (a MutableArray[any] parameter is not a MutableArray[str] one), while the raw kind admits every array} -body {
    set cap "import mutable_array\nfn cap_str(m: MutableArray\[str\]) -> int:\n    mutable_array::capacity(m)\nfn cap_any(m: MutableArray\[any\]) -> int:\n    mutable_array::capacity(m)\nfn cap_raw(m: mutarray) -> int:\n    mutable_array::capacity(m)\n"
    set useStr "fn use(f: Fn{args: \[MutableArray\[str\]\], return: int, errors: \[\]}) -> int:\n    f(mutable_array::create(1, \"a\"))\n"
    list \
        [maRejects "${cap}${useStr}use(cap_str)" *] \
        [maRejects "${cap}${useStr}use(cap_any)" *] \
        [maRejects "${cap}${useStr}use(cap_raw)" *]
} -result {accepted {{CORE SEMANTIC TYPE} 1} accepted}

test mat-inv-6 {structural Fn: a MutableArray result is covariant, as a MutableVector's is (the caller gets a value, never an alias of the callee's)} -body {
    set defs "import mutable_array\nfn make() -> MutableArray\[str\]:\n    mutable_array::create(1, \"a\")\n"
    list \
        [maRejects "${defs}fn use(f: Fn{args: \[\], return: MutableArray\[str\], errors: \[\]}):\n    f()\nuse(make)" *] \
        [maRejects "${defs}fn use(f: Fn{args: \[\], return: MutableArray\[any\], errors: \[\]}):\n    f()\nuse(make)" *] \
        [maRejects "${defs}fn use(f: Fn{args: \[\], return: mutarray, errors: \[\]}):\n    f()\nuse(make)" *]
} -result {accepted accepted accepted}

test mat-inv-7 {aliases keep the type; a store through any alias is checked against it} -body {
    set src "import mutable_array\na = mutable_array::create(2, \"x\")\nb = a\n"
    list [maLast "${src}b"] [maRejects "${src}mutable_array::set(b, 0, 1)" *] [maRejects "${src}mutable_array::set(b, 0, \"q\")" *]
} -result {{MutableArray[str]} {{CORE SEMANTIC TYPE} 1} accepted}

test mat-inv-8 {no program views one array as two element types: the second view is rejected} -body {
    set decl "import mutable_array\nfn as_int(xs: MutableArray\[int\]) -> int:\n    mutable_array::capacity(xs)\nfn as_str(xs: MutableArray\[str\]) -> int:\n    mutable_array::capacity(xs)\nm = mutable_array::create(1, \"a\")\n"
    list [maRejects "${decl}as_str(m)" *] [maRejects "${decl}as_int(m)" *]
} -result {accepted {{CORE SEMANTIC TYPE} 1}}

# ---------------------------------------------------------------------------
# Erasure (spec items 11-14, 36-39, 57-59, 71). Under the reference semantics
# MutableArray had before MUTABLE-ARRAY.md, each of these was an attack -- an
# erased alias that could write a value the typed original excluded -- and was
# rejected at compile time. An array is a value now: each erasure holds a
# logical copy, so the same programs are accepted and the original is never
# changed by what is done to the copy. What still holds: a write is checked
# against the static type of the place written (a semantic instance analyzes
# an untyped parameter at its argument's type), and callable contracts are
# still never erased.

test mat-atk-1 {passing MutableArray[str] to a raw mutarray parameter that writes: the callee writes its own copy, the caller's array is unchanged, on every backend} -body {
    set src "import mutable_array\nfn smash(x: mutarray) -> mutarray errors IndexNotFound:\n    mutable_array::set(x, 0, 123)\n    x\nfn f() -> list errors IndexNotFound:\n    m = mutable_array::from_list(\[\"hello\"\])\n    s = smash(m)\n    \[mutable_array::at(m, 0), mutable_array::at(s, 0)\]\nr = f():\n    on IndexNotFound:\n        \[\]\nr"
    list [maRejects $src *] [maParity $src] [maValue $src]
} -result {accepted same {["hello", 123]}}

test mat-atk-2 {an untyped parameter is analyzed at its argument's type (a semantic instance), so a write of another element type into it is still rejected, kind test or not} -body {
    set src "import mutable_array\nfn f(x):\n    if mutarray?(x):\n        mutable_array::set(x, 0, 123)\n    else:\n        unit\nm = mutable_array::from_list(\[\"a\"\])\nf(m)\nmutable_array::at(m, 0)"
    list [maRejects $src *] [maHas $src "*call to f with x : MutableArray\\\[str\\\] is invalid: value of type int is not admissible to element type str*"]
} -result {{{CORE SEMANTIC TYPE} 1} 1}

test mat-atk-3 {an explicit any parameter accepts a typed array (a logical copy)} -body {
    maRejects "import mutable_array\nfn f(x: any):\n    x\nf(mutable_array::create(1, \"a\"))" *
} -result accepted

test mat-atk-4 {a declared any (or raw) result may hold a typed array} -body {
    list [maRejects "import mutable_array\nfn f() -> any:\n    mutable_array::create(1, \"a\")\nf()" *] \
        [maRejects "import mutable_array\nfn f() -> mutarray:\n    mutable_array::create(1, \"a\")\nf()" *]
} -result {accepted accepted}

test mat-atk-5 {a join of different contracts is the joined contract (MutableArray[int] and MutableArray[str] join in MutableArray[any]; with a raw array, the raw kind)} -body {
    list \
        [maResult "import mutable_array\nfn f(c: bool):\n    if c:\n        mutable_array::from_list(\[1\])\n    else:\n        mutable_array::from_list(\[\"a\"\])\nf(true)" f] \
        [maResult "import mutable_array\nfn f(c: bool):\n    if c:\n        mutable_array::from_list(\[1\])\n    else:\n        mutable_array::allocate(1)\nf(true)" f]
} -result {{MutableArray[any]} mutarray}

test mat-atk-6 {a join of equal contracts is fine} -body {
    maResult "import mutable_array\nfn f(c: bool):\n    if c:\n        mutable_array::from_list(\[1\])\n    else:\n        mutable_array::from_list(\[2\])\nf(true)" f
} -result {MutableArray[int]}

test mat-atk-7 {a List of arrays of different contracts is a List of their join} -body {
    list [maLast "import mutable_array\n\[mutable_array::from_list(\[1\]), mutable_array::from_list(\[\"a\"\])\]"] \
        [maLast "import mutable_array\n\[mutable_array::from_list(\[1\]), 5\]"] \
        [maLast "import mutable_array\n\[mutable_array::from_list(\[1\]), mutable_array::from_list(\[2\])\]"]
} -result {{List[MutableArray[any]]} list {List[MutableArray[int]]}}

test mat-atk-8 {aggregate erasure is a copy: List[MutableArray[str]] into an untyped, list or any parameter, and list::append of anything, are accepted} -body {
    set xs "xs = \[mutable_array::from_list(\[\"a\"\])\]\n"
    set ma "import mutable_array\n"
    set ml "import list\nimport mutable_array\n"
    list \
        [maRejects "${ma}fn f(x):\n    x\n${xs}f(xs)" *] \
        [maRejects "${ml}fn f(x: list):\n    list::length(x)\n${xs}f(xs)" *] \
        [maRejects "${ma}fn f(x: any):\n    x\n${xs}f(xs)" *] \
        [maRejects "${ml}${xs}list::append(xs, 5)" *] \
        [maRejects "${ml}${xs}list::append(xs, mutable_array::from_list(\[1\]))" *] \
        [maRejects "${ml}${xs}list::append(xs, mutable_array::from_list(\[\"b\"\]))" *]
} -result {accepted accepted accepted accepted accepted accepted}

test mat-atk-9 {nested arrays: an untyped or raw parameter takes them (a copy); a MutableArray[any] parameter admits exactly its contract} -body {
    set nest "b = mutable_array::from_list(\[mutable_array::from_list(\[mutable_array::from_list(\[\"a\"\])\])\])\n"
    list \
        [maRejects "import mutable_array\nfn f(x):\n    x\n${nest}f(b)" *] \
        [maRejects "import mutable_array\nfn f(x: mutarray):\n    x\n${nest}f(b)" *] \
        [maRejects "import mutable_array\nfn f(x: MutableArray\[any\]):\n    x\n${nest}f(b)" *]
} -result {accepted accepted {{CORE SEMANTIC TYPE} 1}}

test mat-atk-10 {storing a typed array into a raw array (or a MutableArray[any]) stores a logical copy: writing the stored copy leaves the original unchanged, on every backend} -body {
    set inner "import mutable_array\ninner = mutable_array::from_list(\[\"a\"\])\n"
    set src "import mutable_array\nfn f() -> list errors IndexNotFound:\n    inner = mutable_array::from_list(\[\"a\"\])\n    raw = mutable_array::allocate(1)\n    mutable_array::set(raw, 0, inner)\n    copy = mutable_array::at(raw, 0)\n    mutable_array::set(copy, 0, 7)\n    \[mutable_array::at(inner, 0), mutable_array::at(copy, 0)\]\nr = f():\n    on IndexNotFound:\n        \[\]\nr"
    list \
        [maRejects "${inner}raw = mutable_array::allocate(1)\nmutable_array::set(raw, 0, inner)" *] \
        [maRejects "${inner}holder = mutable_array::from_list(\[1, \"x\"\])\nmutable_array::set(holder, 0, inner)" *] \
        [maRejects "${inner}holder = mutable_array::create(1, inner)\nmutable_array::set(holder, 0, inner)" *] \
        [maParity $src] [maValue $src]
} -result {accepted accepted accepted same {["a", 7]}}

test mat-atk-11 {a callable value or a stored callable may take the array, known exactly or not: what it receives is a copy} -body {
    list \
        [maRejects "import mutable_array\nfn apply(f, x):\n    f(x)\napply(mutable_array::capacity, mutable_array::create(1, \"a\"))" *] \
        [maRejects "import list\nimport mutable_array\nfn keep(x):\n    x\nfs = \[keep\]\nlist::at(fs, 0)(mutable_array::create(1, \"a\"))" *] \
        [maRejects "import list\nimport mutable_array\nfn keep(x):\n    x\nfn keep2(x):\n    unit\nfn pick(fs, i) errors IndexNotFound:\n    list::at(fs, i)\nfs = \[keep, keep2\]\ng = pick(fs, 0):\n    on IndexNotFound:\n        keep\ng(mutable_array::create(1, \"a\"))" *] \
        [maRejects "import list\nimport mutable_array\nfn apply(f, x):\n    f(x)\nfn keep(x):\n    x\nfn keep2(x):\n    unit\nfn pick(fs, i) errors IndexNotFound:\n    list::at(fs, i)\nfs = \[keep, keep2\]\ng = pick(fs, 0):\n    on IndexNotFound:\n        keep\napply(g, mutable_array::create(1, \"a\"))" *]
} -result {accepted accepted accepted accepted}

test mat-atk-12 {the untyped function boundary is crossed by semantic instances (OPPORTUNISTIC-SEMANTIC-INSTANCES.md): an identity, a read-only wrapper and a function storing the array into a raw one all accept it} -body {
    list \
        [maRejects "import mutable_array\nfn identity(x):\n    x\nidentity(mutable_array::create(1, \"a\"))" *] \
        [maRejects "import mutable_array\nfn cap(m):\n    mutable_array::capacity(m)\ncap(mutable_array::create(1, \"a\"))" *] \
        [maRejects "import mutable_array\nfn erase(x) errors IndexNotFound:\n    raw = mutable_array::allocate(1)\n    mutable_array::set(raw, 0, x)\n    raw\nr = erase(mutable_array::create(1, \"a\")):\n    on IndexNotFound:\n        mutable_array::allocate(0)\nr" *]
} -result {accepted accepted accepted}

test mat-atk-13 {a vacuous MutableArray[any] and raw arrays are freely interchangeable (no contract to lose)} -body {
    list \
        [maRejects "import mutable_array\nfn f(x: mutarray) -> int:\n    mutable_array::capacity(x)\nf(mutable_array::from_list(\[1, \"a\"\]))" *] \
        [maRejects "import mutable_array\nfn f(x: MutableArray\[any\]) -> int:\n    mutable_array::capacity(x)\nf(mutable_array::allocate(1))" *] \
        [maRejects "import mutable_array\nfn f(x):\n    x\nf(mutable_array::from_list(\[1, \"a\"\]))" *]
} -result {accepted accepted accepted}

test mat-atk-14 {a kind test proves the kind only: it cannot satisfy a typed parameter} -body {
    set src "import mutable_array\nfn first(xs: MutableArray\[str\]) -> str errors IndexNotFound:\n    mutable_array::at(xs, 0)\nfn g(x) errors IndexNotFound:\n    if mutarray?(x):\n        first(x)\n    else:\n        \"\"\ng(1)"
    list [maRejects $src *] [maHas $src "*a kind test proves the kind, never the element type*"]
} -result {{{CORE SEMANTIC TYPE} 1} 1}

test mat-atk-15 {a raw array passed to a typed parameter is not scanned or converted} -body {
    lindex [maRejects "import mutable_array\nfn first(xs: MutableArray\[str\]) -> str errors IndexNotFound:\n    mutable_array::at(xs, 0)\nm = mutable_array::allocate(1)\nmutable_array::set(m, 0, \"s\")\nfirst(m)" *] 0
} -result {CORE SEMANTIC TYPE}

test mat-atk-16 {freeze/get results are safe uses; the typed array is never lost by using its API} -body {
    list \
        [maRejects "import list\nimport mutable_array\nfn first(xs) errors IndexNotFound:\n    mutable_array::at(list::at(xs, 0), 0)\nm = mutable_array::from_list(\[mutable_array::create(1, \"a\")\])\nxs = mutable_array::freeze(m, 1)\nv = first(xs):\n    on IndexNotFound:\n        \"z\"\nv" *] \
        [maRejects "import list\nimport mutable_array\nxs = \[mutable_array::create(1, \"a\")\]\n\[list::length(xs), list?(xs), mutarray?(list::at(xs, 0))\]" *]
} -result {accepted accepted}

test mat-atk-17 {forward references cannot launder the array: there is no forward reference (a closure cannot read a binding bound later), so the erased-alias hole cannot be written at all} -body {
    set hole "import mutable_array\nfn peek():\n    m\nm = mutable_array::create(1, \"a\")\nx = peek()\nif mutarray?(x):\n    mutable_array::set(x, 0, 5)\nelse:\n    unit"
    set poke "import mutable_array\nfn poke():\n    mutable_array::set(m, 0, 5)\nm = mutable_array::create(1, \"a\")\npoke()"
    list [maRejects $hole *] [maRejects $poke *] [maHas $hole "*unbound name*declared later*"] \
        [maRejects "import mutable_array\nfn peek():\n    xs\nxs = \[mutable_array::create(1, \"a\")\]\npeek()" *] \
        [maRejects "import mutable_array\nfn peek():\n    r\nr = mutable_array::allocate(1)\npeek()" *]
} -result {{{CORE SEMANTIC UNBOUND} 1} {{CORE SEMANTIC UNBOUND} 1} 1 {{CORE SEMANTIC UNBOUND} 1} {{CORE SEMANTIC UNBOUND} 1}}

test mat-atk-18 {a function cannot mutate an array it captures (MUTABLE-PLACE-RECEIVER: a captured binding is not its place), a store is checked against the element type first; a typed parameter is the callee's own place} -body {
    list \
        [maRejects "import mutable_array\nm = mutable_array::create(1, \"a\")\nfn poke():\n    mutable_array::set(m, 0, \"q\")\npoke()" *] \
        [maRejects "import mutable_array\nm = mutable_array::create(1, \"a\")\nfn poke():\n    mutable_array::set(m, 0, 5)\npoke()" *] \
        [maRejects "import mutable_array\nfn poke(m: MutableArray\[str\]):\n    if mutable_array::capacity(m) > 0:\n        mutable_array::set(m, 0, \"q\")\nm = mutable_array::create(1, \"a\")\npoke(m)" *]
} -result {{{CORE SEMANTIC MUTABLE-PLACE-RECEIVER} 1} {{CORE SEMANTIC TYPE} 1} accepted}

test mat-atk-19 {a function returning a typed array cannot be reached through a forward reference at all; called after its definition it keeps its contract} -body {
    list \
        [maRejects "import mutable_array\nfn caller():\n    later()\nfn later():\n    mutable_array::create(1, \"a\")\ncaller()" *] \
        [maRejects "import mutable_array\nfn apply(f):\n    f()\nfn go():\n    apply(later)\nfn later():\n    mutable_array::create(1, \"a\")\ngo()" *] \
        [maRejects "import mutable_array\nfn later():\n    mutable_array::create(1, \"a\")\nfn caller():\n    later()\ncaller()" *] \
        [maRejects "fn caller():\n    later()\nfn later():\n    5\ncaller()" *]
} -result {{{CORE SEMANTIC UNBOUND} 1} {{CORE SEMANTIC UNBOUND} 1} accepted {{CORE SEMANTIC UNBOUND} 1}}

test mat-atk-20 {passing a function that returns a typed array to an untyped parameter is accepted (its results are values)} -body {
    maRejects "import mutable_array\nfn make():\n    mutable_array::create(1, \"a\")\nfn apply(f):\n    f()\napply(make)" *
} -result accepted

test mat-atk-21 {the erasure attack matrix: every flow of a typed array through a sink and then a write of the wrong value is rejected} -body {
    set c [open [file join $::projectRoot audit parameterized-mutablearray tools probes-attack-matrix.txt]]
    fconfigure $c -encoding utf-8
    set text [read $c]
    close $c
    set accepted {}
    set count 0
    set parts [regexp -all -inline -indices {(?n)^### (.*)$} $text]
    set starts {}
    foreach {whole name} $parts { lappend starts [list [string range $text {*}$name] [lindex $whole 1]] }
    for {set i 0} {$i < [llength $starts]} {incr i} {
        lassign [lindex $starts $i] name begin
        set end [expr {$i + 1 < [llength $starts] ? [lindex [regexp -all -inline -indices {(?n)^### (.*)$} $text] [expr {2 * ($i + 1)}] 0] - 1 : [string length $text]}]
        set src [string range $text [expr {$begin + 2}] $end]
        incr count
        if {[maRejects $src *] eq "accepted"} { lappend accepted $name }
    }
    list $count $accepted
} -result {19 {}}

