# ---------------------------------------------------------------------------
# Runtime semantics: identical on every backend (spec items 8, 9, 12, 13, 63-66, 83, 84)

test mat-run-1 {create fills every slot: capacities 0, 1 and larger} -body {
    set src "import mutable_array\nfn slots(m, n) errors IndexNotFound:\n    loop i from 0 to n:\n        mutable_array::at(m, i)\nfn f() errors IndexNotFound:\n    \[mutable_array::capacity(mutable_array::create(0, 7)), mutable_array::freeze(mutable_array::create(1, 7), 1), mutable_array::freeze(mutable_array::create(5, \"s\"), 5), mutable_array::capacity(mutable_array::create(1000, 0))\]\nf()"
    list [maParity $src] [maValue $src]
} -result {same {[0, [7], ["s", "s", "s", "s", "s"], 1000]}}

test mat-run-2 {create with capacity 0: no slot is written, any index is IndexNotFound (mutable_array::at's declared error, uncaught here) as for a raw array} -body {
    set src "import mutable_array\nfn f() errors IndexNotFound:\n    m = mutable_array::create(0, \"x\")\n    mutable_array::at(m, 0)\nf()"
    maErrors $src
} -result {{CORE SEMANTIC UNCAUGHT-ERROR} {CORE SEMANTIC UNCAUGHT-ERROR} {CORE SEMANTIC UNCAUGHT-ERROR} {CORE SEMANTIC UNCAUGHT-ERROR}}

test mat-run-3 {a negative capacity is not clamped: RANGE, exactly like a raw allocation} -body {
    set typed "import mutable_array\nfn f(n: int):\n    mutable_array::create(n, 0)\nf(0 - 1)"
    set raw "import mutable_array\nfn f(n: int):\n    mutable_array::allocate(n)\nf(0 - 1)"
    list [maErrors $typed] [maErrors $raw]
} -result {{{CORE SEMANTIC RANGE} {CORE SEMANTIC RANGE} {CORE SEMANTIC RANGE} {CORE SEMANTIC RANGE}} {{CORE SEMANTIC RANGE} {CORE SEMANTIC RANGE} {CORE SEMANTIC RANGE} {CORE SEMANTIC RANGE}}}

test mat-run-4 {a repeated value is copied logically, never aliased: mutating the source afterwards changes no slot} -body {
    set src "import mutable_array\nfn f() errors IndexNotFound:\n    shared = mutable_array::create(2, \"inner\")\n    outer = mutable_array::create(3, shared)\n    mutable_array::set(shared, 0, \"changed\")\n    \[mutable_array::at(mutable_array::at(outer, 0), 0), mutable_array::at(mutable_array::at(outer, 2), 0), mutable_array::freeze(mutable_array::at(outer, 1), 2), mutable_array::freeze(shared, 2)\]\nf()"
    list [maParity $src] [maValue $src]
} -result {same {["inner", "inner", ["inner", "inner"], ["changed", "inner"]]}}

test mat-run-5 {nested Lists as default: one shared immutable List} -body {
    set src "import mutable_array\nfn f() errors IndexNotFound:\n    m = mutable_array::create(3, \[\[1\], \[2, 3\]\])\n    \[mutable_array::at(m, 0), mutable_array::at(m, 2) == mutable_array::at(m, 1)\]\nf()"
    list [maParity $src] [maValue $src]
} -result {same {[[[1], [2, 3]], true]}}

test mat-run-6 {typed get / set / freeze / copy behave as the raw operations at run time; a copy (b = a) is independent} -body {
    set src "import mutable_array\nfn f() errors IndexNotFound:\n    a = mutable_array::create(4, 0)\n    b = a\n    mutable_array::set(b, 1, 10)\n    mutable_array::set(a, 2, 20)\n    c = mutable_array::from_list(\[7, 8, 9\])\n    mutable_array::copy(a, 0, c, 0, 2)\n    \[mutable_array::freeze(a, 4), mutable_array::freeze(b, 4), mutable_array::capacity(c)\]\nf()"
    list [maParity $src] [maValue $src]
} -result {same {[[7, 8, 20, 0], [0, 10, 0, 0], 3]}}

test mat-run-7 {bounds behavior: a negative or out-of-range at or set is IndexNotFound; a freeze or copy past either end of the array is LowerUnderrun or UpperOverrun (STDLIB-NAMESPACES.md), handled by name on every backend} -body {
    lmap {body errors} {
        "mutable_array::at(m, i + 3)" IndexNotFound
        "mutable_array::at(m, i - 1)" IndexNotFound
        "mutable_array::set(m, i + 3, 1)" IndexNotFound
        "mutable_array::freeze(m, i + 4)" {LowerUnderrun UpperOverrun}
        "mutable_array::freeze(m, i - 1)" {LowerUnderrun UpperOverrun}
        "mutable_array::copy(m, i + 2, m, 0, 2)" {LowerUnderrun UpperOverrun}
    } {
        set handlers [join [lmap e $errors {format "        on %s:\n            return \"%s\"" $e $e}] \n]
        set src "import mutable_array\nfn f(i: int) -> str:\n    m = mutable_array::create(3, 0)\n    r = ${body}:\n${handlers}\n    \"completed\"\nf(0)"
        list [maParity $src] [maValue $src]
    }
} -result {{same {"IndexNotFound"}} {same {"IndexNotFound"}} {same {"IndexNotFound"}} {same {"UpperOverrun"}} {same {"LowerUnderrun"}} {same {"UpperOverrun"}}}

test mat-run-8 {from_list of nested typed arrays holds copies: the inner array stays writable through its own type, and writing it changes no copy} -body {
    set src "import list\nimport mutable_array\nfn f() errors IndexNotFound:\n    inner = mutable_array::from_list(\[\"a\"\])\n    outer = mutable_array::from_list(\[inner\])\n    mutable_array::set(inner, 0, \"z\")\n    \[mutable_array::at(mutable_array::at(outer, 0), 0), mutable_array::at(inner, 0), list::length(mutable_array::freeze(outer, 1))\]\nf()"
    list [maParity $src] [maValue $src]
} -result {same {["a", "z", 1]}}

test mat-run-9 {List[MutableArray[T]] read back with a dynamic index} -body {
    set src "import list\nimport mutable_array\nfn pick(rows, i) errors IndexNotFound:\n    list::at(rows, i)\nfn f(i: int) errors IndexNotFound:\n    a = mutable_array::create(2, 0)\n    b = mutable_array::create(3, 1)\n    m = list::at(\[a, b\], i)\n    mutable_array::capacity(m)\n\[f(0), f(1)\]"
    list [maParity $src] [maValue $src]
} -result {same {[2, 3]}}

test mat-run-10 {a typed program and the same program over raw arrays agree on every backend} -body {
    set typed "import mutable_array\nfn f() errors IndexNotFound:\n    m = mutable_array::create(3, 0)\n    loop i from 0 to 3:\n        mutable_array::set(m, i, i * i)\n    mutable_array::freeze(m, 3)\nf()"
    set raw "import mutable_array\nfn f() errors IndexNotFound:\n    m = mutable_array::allocate(3)\n    loop i from 0 to 3:\n        mutable_array::set(m, i, 0)\n    loop i from 0 to 3:\n        mutable_array::set(m, i, i * i)\n    mutable_array::freeze(m, 3)\nf()"
    list [maParity $typed] [maValue $typed] [maValue $typed] [maValue $raw]
} -result {same {[0, 1, 4]} {[0, 1, 4]} {[0, 1, 4]}}

testConstraint executableAot [expr {$::tcl_platform(os) eq "Linux" &&
    $::tcl_platform(machine) in {x86_64 amd64}}]

# The value of program TEXT under every in-process backend and as a standalone
# AOT executable (also under GC stress); errors unless they all agree.
proc maAotParity {text} {
    set dir [makeDirectory {mutablearray type aot}]
    set path [file join $dir program.bot]
    set channel [open $path w]
    fconfigure $channel -encoding utf-8 -translation lf
    puts $channel $text
    close $channel
    try {
        set hir [surface::readProgramFile $path]
        set expected {}
        foreach backend {interp compile cranelift-generic cranelift} {
            set outcome [outcomeUnderHir $backend $hir]
            if {[lindex $outcome 0] ne "value"} { error "$backend: $outcome" }
            lappend expected [lindex $outcome 1]
        }
        exec [info nameofexecutable] [file join $::projectRoot main.tcl] -emit-native-executable $path
        lappend expected [exec env PATH= [file rootname $path]]
        lappend expected [exec env PATH= BOTLISH_NATIVE_GC_STRESS=1 [file rootname $path]]
        if {[llength [lsort -unique $expected]] != 1} { error "values disagree: $expected" }
        return [lindex $expected 0]
    } finally {
        removeDirectory {mutablearray type aot}
    }
}

test mat-gc-1 {managed defaults, nested typed arrays, List[MutableArray[T]], copies, freeze and copy: standalone AOT under GC stress agrees with every backend} -constraints executableAot -body {
    maAotParity "import list\nimport mutable_array\nfn f() errors IndexNotFound, LowerUnderrun, UpperOverrun:\n    shared = mutable_array::create(3, \[\"managed\", \"list\"\])\n    inner = mutable_array::from_list(\[\"a\", \"b\"\])\n    outer = mutable_array::create(2, inner)\n    alias = outer\n    rows = \[mutable_array::create(2, \"r\"), mutable_array::create(1, \"s\")\]\n    mutable_array::set(inner, 1, \"z\")\n    dst = mutable_array::create(2, \"d\")\n    mutable_array::copy(dst, 0, list::at(rows, 0), 0, 2)\n    slot = mutable_array::at(alias, 1)\n    mutable_array::set(slot, 0, \"y\")\n    mutable_array::set(alias, 1, slot)\n    \[mutable_array::freeze(shared, 3), mutable_array::freeze(mutable_array::at(outer, 1), 2), mutable_array::freeze(mutable_array::at(alias, 1), 2), mutable_array::freeze(inner, 2), mutable_array::freeze(dst, 2), mutable_array::capacity(list::at(rows, 1)), mutable_array::capacity(mutable_array::create(0, inner))\]\nr = f():\n    on IndexNotFound:\n        \[\]\n    on LowerUnderrun:\n        \[\]\n    on UpperOverrun:\n        \[\]\nr"
} -result {[[["managed", "list"], ["managed", "list"], ["managed", "list"]], ["a", "b"], ["y", "b"], ["a", "z"], ["r", "r"], 1, 0]}

# ---------------------------------------------------------------------------
# Source fence (spec items 48, 49, 82)

# TYPED-MUTARRAY-BUILDER-REFACTOR.md reopened this fence for exactly one
# region: the geometric mutable builder in examples/stdlib/csv_geometric.bot
# and csv_records.bot (its two duplicated implementations) now uses
# mutable_array::create. Nothing else may use the new API; tests/typed-mutarray-
# builder.test pins the narrower new fence inside those two files.
test mat-fence-1 {no canonical program or stdlib module other than the two geometric-builder corpus programs and the HashTable (a struct of typed arrays since MUTABLE-ARRAY.md) uses the typed API} -body {
    set hits {}
    foreach pattern {bench/*.bot examples/surface/*.bot examples/stdlib/*.bot lib/*.bot} {
        foreach file [glob -nocomplain -directory $::projectRoot {*}[list $pattern]] {
            set c [open $file]
            fconfigure $c -encoding utf-8
            set text [read $c]
            close $c
            # Prose in comments (hashtable.bot's layout notes) is not use.
            set code [join [lmap line [split $text \n] {
                if {[string match "#*" [string trim $line]]} continue
                set line
            }] \n]
            if {[file tail $file] ni {mutarray.bot csv_geometric.bot csv_records.bot hashtable.bot}
                    && ([string first mutable_array::create $code] >= 0 || [string first "MutableArray\[" $code] >= 0)} {
                lappend hits [file tail $file]
            }
        }
    }
    set hits
} -result {}

# ---------------------------------------------------------------------------
# Boundaries the milestone deliberately leaves (documented limitations)

test mat-bd-1 {an untyped forwarder to a typed function infers the typed contract: a sound closed instance keeps it} -body {
    set defs "import mutable_array\nfn first(xs: MutableArray\[str\]) -> str errors IndexNotFound:\n    mutable_array::at(xs, 0)\nfn fwd(xs) errors IndexNotFound:\n    first(xs)\n"
    set handled ":\n    on IndexNotFound:\n        \"\"\nr"
    list [maLast "${defs}r = fwd(mutable_array::create(1, \"a\"))$handled"] \
        [maRejects "${defs}r = fwd(mutable_array::create(1, 5))$handled" *] \
        [maRejects "${defs}r = fwd(mutable_array::allocate(1))$handled" *]
} -result {str {{CORE SEMANTIC TYPE} 1} {{CORE SEMANTIC TYPE} 1}}

test mat-bd-2 {struct boundary: a typed array may ride in a positional pair (a logical copy); typed storage plus a separate length works} -body {
    set defs "import mutable_array\nfn push(storage: MutableArray\[int\], length: int, v: int) -> MutableArray\[int\]:\n    if length >= 0 and length < mutable_array::capacity(storage):\n        mutable_array::set(storage, length, v)\n    storage\n"
    list \
        [lindex [maRejects "${defs}pair = \[push(mutable_array::create(2, 0), 0, 7), 1\]\npair" *] 0] \
        [maLast "${defs}s = push(mutable_array::create(2, 0), 0, 7)\nmutable_array::freeze(s, mutable_array::capacity(s))"]
} -result {accepted {List[int]}}

test mat-bd-3 {nesting is bounded by the aggregate depth (3): a deeper stack's innermost contract is the raw kind (an erasure, which a value permits), never a widened lie} -body {
    set base "import mutable_array\nx1 = mutable_array::create(1, 0)\nx2 = mutable_array::create(1, x1)\nx3 = mutable_array::create(1, x2)\n"
    list [maLast "${base}x3"] [maLast "${base}x4 = mutable_array::create(1, x3)\nx4"]
} -result {{MutableArray[MutableArray[MutableArray[int]]]} {MutableArray[MutableArray[MutableArray[mutarray]]]}}

test mat-bd-4 {mutual recursion is rejected at resolution; direct recursion keeps the typed result} -body {
    set src "import mutable_array\nfn a(n: int):\n    if n == 0:\n        return mutable_array::create(1, 0)\n    b(n - 1)\nfn b(n: int):\n    a(n)\na(2)"
    list [maRejects $src *] [maLast "import mutable_array\nfn make(n: int):\n    if n == 0:\n        return mutable_array::create(1, \"a\")\n    make(n - 1)\nmake(3)"]
} -result {{{CORE SEMANTIC UNBOUND} 1} {MutableArray[str]}}

test mat-bd-5 {an inferred raw-mutarray contract (untyped wrapper that writes or reads) no longer rejects typed arrays outright: the call's semantic instance separates the read-only wrapper (valid) from the writer (rejected only when its write is invalid for the element type)} -body {
    list \
        [maRejects "import mutable_array\nfn cap(m):\n    mutable_array::capacity(m)\ncap(mutable_array::create(1, \"a\"))" *] \
        [maRejects "import mutable_array\nfn cap(m):\n    mutable_array::capacity(m)\ncap(mutable_array::allocate(1))" *] \
        [maRejects "import mutable_array\nfn put(m):\n    if mutable_array::capacity(m) > 0:\n        mutable_array::set(m, 0, 1)\nput(mutable_array::create(1, \"a\"))" *] \
        [maRejects "import mutable_array\nfn put(m):\n    if mutable_array::capacity(m) > 0:\n        mutable_array::set(m, 0, \"b\")\nput(mutable_array::create(1, \"a\"))" *]
} -result {accepted accepted {{CORE SEMANTIC TYPE} 1} accepted}

