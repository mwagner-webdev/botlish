        [maLast "import mutable_array\nfn from_list(xs):\n    mutable_array::allocate(1)\nfrom_list(\[1, 2\])"] \
        [maLast "import mutable_array\nfn create(n: int, d):\n    mutable_array::allocate(n)\ncreate(2, \"x\")"]
} -result {mutarray mutarray}

test mat-id-2 {the rule follows the exact function through an alias} -body {
    list \
        [maLast "import mutable_array\nf = mutable_array::create\nf(2, \"x\")"] \
        [maLast "import mutable_array\nf = mutable_array::from_list\ng = f\ng(\[1, 2\])"]
} -result {{MutableArray[str]} {MutableArray[int]}}

test mat-id-3 {viewed through a structural Fn (target unknown) the relation is lost: the result is the raw kind, never a typed lie; where the target is known exactly the semantic instance keeps the relation, and a declared raw result holds it as a copy} -body {
    set fnType "Fn{args: \[int, any\], return: mutarray, errors: \[\]}"
    set imp "import list\nimport mutable_array\n"
    set pick "fn other(n: int, d) -> mutarray:\n    mutable_array::allocate(n)\nfn pick(fs, i) errors IndexNotFound:\n    list::at(fs, i)\ng = pick(\[mutable_array::create, other\], 1):\n    on IndexNotFound:\n        other\n"
    list \
        [maLast "${imp}fn apply(f: $fnType) -> mutarray:\n    f(2, \"x\")\n${pick}apply(g)"] \
        [maRejects "${imp}fn apply(f: $fnType) -> mutarray:\n    f(2, \"x\")\n${pick}m = apply(g)\nw = mutable_array::set(m, 0, 5):\n    on IndexNotFound:\n        unit\nw" *] \
        [maLast "import mutable_array\nfn apply(f: $fnType):\n    f(2, \"x\")\napply(mutable_array::create)"] \
        [maRejects "import mutable_array\nfn apply(f: $fnType) -> mutarray:\n    f(2, \"x\")\napply(mutable_array::create)" "*the declared result type mutarray would erase*"]
} -result {mutarray accepted {MutableArray[str]} accepted}

test mat-id-4 {only the registered names carry rules; passes stay free of name-keyed special cases} -body {
    set hits {}
    foreach dir {hir compiler surface} {
        foreach file [glob -nocomplain -directory [file join $::projectRoot $dir] *.tcl] {
            set c [open $file]
            fconfigure $c -encoding utf-8
            set text [read $c]
            close $c
            foreach needle {mutable_array::create mutable_array::from_list "\"mutable_array::set\"" "mutable_array::set " mutable_array::copy} {
                if {[string first $needle $text] >= 0} {
                    lappend hits [file join $dir [file tail $file]]
                    break
                }
            }
        }
    }
    lsort -unique $hits
} -result hir/containers.tcl

