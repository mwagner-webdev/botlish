test mat-sp-6 {creating many differently built arrays multiplies no instances of a typed helper} -body {
    set src "import mutable_array\nfn cap(xs: MutableArray\[int\]) -> int:\n    mutable_array::capacity(xs)\nfn go():\n    \[cap(mutable_array::create(1, 0)), cap(mutable_array::from_list(\[1, 2\])), cap(mutable_array::create(3, 7))\]\ngo()"
    set hir [maCompile $src]
