    regexp {; u0:([0-9]+) = botlish_fn_[0-9]+ \(web::uri_query_value\?\)} $clif -> query
    set check [lindex [regexp -inline {; function [0-9]+ "check":[^\n]*\n(.*?)\n\}} $clif] 1]
    set refs [dict create]
