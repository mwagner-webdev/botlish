test refinement-repeatable-explain {what makes a predicate repeatable, and what does not} -body {
    set hir [surface::compile {import list
import mutable_array
import str

refined type M = str

fn pure?(s: str) -> bool proves s: M:
    str::length(s) > 2 and list::length([s]) == 1

fn reads?(s: str, a: MutableArray[int]) -> bool proves s: M:
    n = mutable_array::at(a, 0):
        on IndexNotFound:
            return false
    n > 0

fn writes?(s: str, a: MutableArray[int]) -> bool proves s: M:
    mutable_array::set(a, 0, 1):
        on IndexNotFound:
            return false
    true

fn calls_unknown?(s: str, f) -> bool proves s: M:
    f(s)

fn via_helper?(s: str) -> bool proves s: M:
    fn check(p: Fn{args: [str], return: bool}) -> bool:
        p(s)
    check(str::is_tcl_alpha)

1
} -warnings off]
    lmap name {pure? reads? writes? calls_unknown? via_helper?} {
        set block [hir::get $hir [lindex [hirFind $hir bind $name] 0] value]
        set why [hir::repeatable::explain $hir $block]
        regsub {^line [0-9]+:[0-9]+: } $why {}
    }
} -result {{} {native "mutable_array::at" is not classified as a repeatable value operation} {native "mutable_array::set" is not classified as a repeatable value operation} {a call whose target is not statically known} {}}

test refinement-effectful-not-folded {a proof predicate that reads or writes mutable state still proves, but a repeat is never decided} -body {
