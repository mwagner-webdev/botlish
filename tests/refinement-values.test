refined type M = str

fn bump?(s: str, a: MutableArray[int]) -> bool proves s: M:
    n = mutable_array::at(a, 0):
        on IndexNotFound:
            return false
    mutable_array::set(a, 0, n + 1):
        on IndexNotFound:
            return false
    n == 0

fn take(m: M) -> str:
    m

fn f(s: str) -> List[str]:
    a = mutable_array::create(1, 0)
    if bump?(s, a):
        if bump?(s, a):
            [take(s), "again"]
        else:
            [take(s), "changed"]
    else:
        []

f("x")
}
    set hir [surface::compile $source -warnings off]
    list [knownOf $hir bump?] [sourceAgree $source]
} -result {{{} {}} {value {["x", "changed"]}}}

