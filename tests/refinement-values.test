# refinement-values.test -- source-defined refinement types and proof-producing
# functions (REFINEMENT-VALUES.md):
#
#   refined type Emailish = str
#   fn emailish?(v: str) -> bool proves v: Emailish:
#
# A refinement is a nominal fact attached to an existing value: a proof may
# strengthen the static view, forgetting weakens it, and neither changes the
# value itself. This file pins the language feature generically, with its own
# small refinements (Mail, Query, Encoded, ...), and the lib/web.bot corpus
# (web::Emailish, web::UriQueryValue) where the corpus is the point.
#
# Every behavioral case runs on interp, compile, cranelift-generic and
# cranelift (sourceAgree): proof availability, acceptance and rejection,
# forgetting, joins, return checking and predicate behavior are the front
# end's (one HIR), and every backend must compute the same value from it.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]

# The kind and location-free message of the first compile rejection of
# SOURCE, or "accepted".
proc rejection {source} {
    if {[catch {surface::compile $source -warnings off} message options]} {
        set code [dict get $options -errorcode]
        set kind [expr {[lindex $code 1] eq "SYNTAX" ? "SYNTAX" : [lindex $code end]}]
        return [list $kind [regsub {^[^ ]*:[0-9]+:[0-9]+: } $message {}]]
    }
    return accepted
}

proc rejectionKind {source} {
    return [lindex [rejection $source] 0]
}

# The shown static type of the binding NAME (its bind expression) in HIR.
proc boundTypeOf {hir name} {
    set binds [hirFind $hir bind $name]
    return [hir::types::show [hir::typeOf $hir [lindex $binds end]]]
}

# The `known` field of every call of the function spelled NAME in HIR, in
# pre-order.
proc knownOf {hir name} {
    return [lmap e [hirFind $hir call] {
        set callee [hir::get $hir $e callee]
        if {[hir::kind $hir $callee] ne "ref" || [hir::get $hir $callee name] ne $name} continue
        hir::get $hir $e known
    }]
}

# The body lines of NIR function NAME in NIR text, with register numbers,
# expression origins and function ids normalized away.
proc nirBody {nir name} {
    set lines {}
    set inside 0
    foreach line [split $nir \n] {
        if {[string match "func *" $line]} {
            set inside [string match "func * \"$name\" *" $line]
            continue
        }
        if {$line eq "end"} {
            set inside 0
            continue
        }
        if {$inside} {
            lappend lines [regsub -all {@e[0-9]+} [string trim $line] ""]
        }
    }
    return $lines
}

# The common declarations most cases below use: two sibling refinements of
# str, a refinement of a refinement, their proof-producing predicates (a
# second predicate of Mail, and a predicate proving Encoded from a Query).
set prelude {import list
import str

refined type Mail = str
refined type Query = str
refined type Encoded = Query

fn mail?(s: str) -> bool proves s: Mail:
    str::length(s) > 3

fn other_mail?(s: str) -> bool proves s: Mail:
    str::length(s) > 4

fn query?(s: str) -> bool proves s: Query:
    str::length(s) > 0

fn encoded?(q: Query) -> bool proves q: Encoded:
    str::length(q) > 1

fn send(m: Mail) -> int:
    str::length(m)

fn show(s: str) -> str:
    s

}

# ===========================================================================
# 1-3. Declaration syntax, namespace and identity

test refinement-decl-parses {"refined type NAME = CARRIER" is a declaration with its own AST form} -body {
    surface::formatAst [surface::parse "refined type Mail = str\nrefined type Encoded = Query\n"]
} -match glob -result {*refined type Mail = str*refined type Encoded = Query*}

test refinement-refined-is-contextual {"refined" is an ordinary name everywhere but before "type"} -body {
    sourceAgree {fn refined(x):
    x + 1

refined_value = refined(41)
[refined_value]
}
} -result {value {[42]}}

test refinement-proves-is-contextual {"proves" is an ordinary name everywhere but after a result type} -body {
    sourceAgree {fn f(proves):
    proves + 1

proves = 2
[f(proves), proves]
}
} -result {value {[3, 2]}}

test refinement-proves-in-ast {the proof clause is part of the function node} -body {
    surface::formatAst [surface::parse "fn mail?(s: str) -> bool proves s: Mail:\n    true\n"]
} -match glob -result {*fn mail? (s:str) proves s: Mail*}

test refinement-one-carrier {a refinement has exactly one carrier: no intersections, unions or extra carriers} -body {
    list [rejectionKind "refined type A = str, int\n1\n"] \
         [rejectionKind "refined type A = str in 0..1\n1\n"] \
         [rejectionKind "refined type A\n1\n"]
} -result {SYNTAX SYNTAX SYNTAX}

test refinement-type-without-refined {a "type NAME = T" without a domain points at "refined type"} -body {
    rejection "type Mail = str\n1\n"
} -match glob -result {SYNTAX {*refinement of another type is declared "refined type Mail = CARRIER"*}}

test refinement-nested-declaration {a refinement is declared only at the top level} -body {
    rejectionKind "fn f():\n    refined type A = str\n    1\nf()\n"
} -result SYNTAX

test refinement-stray-modifier {"refined" modifies only a type declaration} -body {
    list [rejection "refined struct A:\n    x: int\n1\n"] [rejectionKind "refined fn f():\n    1\nf()\n"]
} -match glob -result {{SYNTAX {*"refined" only modifies a type declaration*}} SYNTAX}

test refinement-nominal-identity {a refinement is a new nominal type, not an alias: Mail, Query and str are three types} -body {
    list [rejectionKind "$prelude\nfn f(s: str) -> int:\n    if query?(s):\n        send(s)\n    else:\n        0\nf(\"abcd\")\n"] \
         [rejectionKind "$prelude\nsend(\"abcd\")\n"] \
         [rejectionKind "$prelude\nfn f(s: str) -> int:\n    if mail?(s):\n        send(s)\n    else:\n        0\nf(\"abcd\")\n"]
} -result {TYPE TYPE accepted}

test refinement-registry-metadata {the registry keeps canonical identity, carrier, owner and declaration span} -body {
    set hir [surface::compile "$prelude\n1\n" -warnings off]
    set meta [core::type::refinementOf Encoded]
    list [core::type::isRefinement Mail] [dict get $meta carrier] [dict get $meta owner] \
         [dict get $meta span line] [lsearch -inline -index 1 [lmap e [hir::sourceTypes $hir] {list [dict get $e kind] [dict get $e name]}] Encoded]
} -result {1 {refined str Query} {} 6 {refined Encoded}}

# ===========================================================================
# 3, 17, 81. Modules: namespace identity, import type, minting authority

proc withRefinementModules {script} {
    set saved $::core::libraryDir
    set dir [tcltest::makeDirectory refinement-values-lib-[pid]-[incr ::refinementLibCounter]]
    set ::core::libraryDir $dir
    try {
        file mkdir [file join $dir validation]
        foreach {name text} {
            validation {import str

refined type Mail = str

fn mail?(s: str) -> bool proves s: Mail:
    str::length(s) > 3

fn send(m: Mail) -> int:
    str::length(m)
}
            validation/sub {import validation

fn noop():
    1
}
            consumer {import validation
import type validation::Mail

fn deliver(m: Mail) -> int:
    validation::send(m)
}
        } {
            set channel [open [file join $dir {*}[split $name /]].bot w]
            fconfigure $channel -encoding utf-8
            puts -nonewline $channel $text
            close $channel
        }
        uplevel 1 $script
    } finally {
        set ::core::libraryDir $saved
        tcltest::removeDirectory [file tail $dir]
    }
}
set ::refinementLibCounter 0

test refinement-module-identity {a module's refinement has its path-derived identity, usable qualified and through import type} -body {
    withRefinementModules {
        sourceAgree {import validation
import consumer
import type validation::Mail

fn ok(s: str) -> int:
    if validation::mail?(s):
        consumer::deliver(s) + validation::send(s)
    else:
        0

fn short(m: Mail) -> Mail:
    m

[ok("abcd"), ok("ab")]
} {interp compile cranelift}
    }
} -result {value {[8, 0]}}

test refinement-import-grants-no-authority {an importing module or program cannot mint another module's refinement} -body {
    withRefinementModules {
        list [rejection {import type validation::Mail

fn fake?(s: str) -> bool proves s: Mail:
    true

1
}] [rejectionKind {import validation

fn fake?(s: str) -> bool proves s: validation::Mail:
    true

1
}]
    }
} -match glob -result {{REFINEMENT-MINT-AUTHORITY {*the entry program cannot declare a proof of refinement validation::Mail: only its owning module "validation" may mint it*}} REFINEMENT-MINT-AUTHORITY}

test refinement-child-namespace-grants-no-authority {a child namespace of the owner cannot mint it either} -body {
    withRefinementModules {
        set channel [open [file join $::core::libraryDir validation sub.bot] w]
        puts -nonewline $channel "import type validation::Mail\n\nfn fake?(s: str) -> bool proves s: Mail:\n    true\n"
        close $channel
        rejection "import validation::sub\n1\n"
    }
} -match glob -result {REFINEMENT-MINT-AUTHORITY {*module "validation::sub" cannot declare a proof of refinement validation::Mail*}}

test refinement-two-importers-cannot-mint {two modules importing the same refinement: neither may mint it, and the cached declaration keeps its owner} -body {
    withRefinementModules {
        foreach name {first second} {
            set channel [open [file join $::core::libraryDir $name.bot] w]
            puts -nonewline $channel "import type validation::Mail\n\nfn fake?(s: str) -> bool proves s: Mail:\n    true\n"
            close $channel
        }
        list [rejectionKind "import first\n1\n"] [rejectionKind "import second\n1\n"] \
             [rejectionKind "import validation\nimport first\nimport second\n1\n"] \
             [dict get [core::type::refinementOf validation::Mail] owner]
    }
} -result {REFINEMENT-MINT-AUTHORITY REFINEMENT-MINT-AUTHORITY REFINEMENT-MINT-AUTHORITY validation}

test refinement-owner-entry-program {the entry program owns its own refinements} -body {
    sourceAgree "$prelude\nfn f(s: str) -> int:\n    if mail?(s):\n        send(s)\n    else:\n        0\n\[f(\"abcd\"), f(\"ab\")\]\n"
} -result {value {[4, 0]}}

# ===========================================================================
# 5. Chains and cycles

test refinement-chain-forgets-transitively {Encoded forgets to Query and to str; no strengthening back} -body {
    list [sourceAgree "$prelude
fn as_query(q: Query) -> str:
    q

fn f(s: str) -> str:
    if query?(s):
        if encoded?(s):
            str::concat(as_query(s), show(s))
        else:
            \"no\"
    else:
        \"no\"

\[f(\"ab\"), f(\"a\")\]
"] [rejectionKind "$prelude
fn need(e: Encoded) -> int:
    1

fn f(s: str) -> int:
    if query?(s):
        need(s)
    else:
        0

f(\"ab\")
"]
} -result {{value {["abab", "no"]}} TYPE}

test refinement-cycle {a cyclic carrier chain is CYCLIC-REFINEMENT} -body {
    list [rejection "refined type A = B\nrefined type B = A\n1\n"] \
         [rejectionKind "refined type A = A\n1\n"] \
         [rejectionKind "refined type A = B\nrefined type B = C\nrefined type C = A\n1\n"]
} -match glob -result {{CYCLIC-REFINEMENT {cyclic refinement: "*" is its own carrier through *}} CYCLIC-REFINEMENT CYCLIC-REFINEMENT}

test refinement-chain-order-independent {a carrier may be declared later in the same file} -body {
    sourceAgree "refined type Late = Early\nrefined type Early = str\n1\n"
} -result {value 1}

# ===========================================================================
# 6, 85. Carrier eligibility: a semantic rule, not spelling

test refinement-carrier-eligible {scalar value carriers, integer domains and refinements are eligible} -body {
    sourceAgree {import type byte::Byte

refined type Flag = bool
refined type Letter = UnicodeChar
refined type Even = int
refined type EvenByte = Byte
refined type Text = str
refined type Short = Text

fn even?(n: int) -> bool proves n: Even:
    mod(n, 2) == 0

fn half(n: Even) -> int:
    mod(n, 7)

fn f(n: int) -> int:
    if even?(n):
        half(n)
    else:
        -1

[f(10), f(3)]
}
} -result {value {[3, -1]}}

test refinement-carrier-mutable-array {a MutableArray carrier is rejected for its reference semantics} -body {
    rejection "refined type Buffer = MutableArray\[int\]\n1\n"
} -result {REFINEMENT-CARRIER {invalid refinement carrier MutableArray[int] for "Buffer": MutableArray[int] has reference semantics (a MutableArray's slots change in place), so a proof about one value would not stay true; a refinement needs a carrier whose values never change}}

test refinement-carrier-reaching-mutable {a carrier is judged by what it reaches, not by its name} -body {
    lmap source [list "refined type Rows = List\[MutableArray\[int\]\]\n1\n" "refined type Words = List\[str\]\n1\n"] {
        lassign [rejection $source] kind message
        list $kind [regexp -inline {(has an element type|is a stable value type)[^;(]*} $message]
    }
} -result {{REFINEMENT-CARRIER {{has an element type, MutableArray[int], that has reference semantics } {has an element type}}} {REFINEMENT-CARRIER {{is a stable value type, but refinements of aggregate, struct or callable values are not supported yet } {is a stable value type}}}}

test refinement-carrier-struct {a struct carrier is not supported yet, whatever its name says} -body {
    list [rejection "struct MutableThing:\n    x: int\nrefined type Good = MutableThing\n1\n"] \
         [rejectionKind "import abi::bytes\nrefined type B = abi::bytes::Bytes\n1\n"] \
         [rejectionKind "import abi::bytes\nrefined type B = abi::bytes::MutableBytes\n1\n"]
} -match glob -result {{REFINEMENT-CARRIER {*MutableThing is a struct type, and refinements of struct values are not supported yet*}} REFINEMENT-CARRIER REFINEMENT-CARRIER}

test refinement-carrier-unknown {an unknown carrier is a TYPE error naming it} -body {
    rejection "refined type A = Nope\n1\n"
} -match glob -result {TYPE {unknown carrier type Nope for refinement "A": *}}

test refinement-carrier-any-callable {any and callables are not refinement carriers} -body {
    list [rejectionKind "refined type A = any\n1\n"] \
         [rejectionKind "refined type F = Fn{args: \[int\], return: int}\n1\n"]
} -result {REFINEMENT-CARRIER REFINEMENT-CARRIER}

test refinement-name-collisions {a refinement name may not collide with a built-in or another declaration} -body {
    list [rejectionKind "refined type str = str\n1\n"] \
         [rejectionKind "refined type List = str\n1\n"] \
         [rejectionKind "refined type A = str\nrefined type A = str\n1\n"] \
         [rejectionKind "refined type A = str\nstruct A:\n    x: int\n1\n"]
} -result {TYPE TYPE TYPE TYPE}

# ===========================================================================
# 13-16. Proof clauses and their validation

test refinement-proof-target-missing {a proof clause must name an ordinary parameter} -body {
    list [rejection "refined type M = str\nfn p(s: str) -> bool proves t: M:\n    true\n1\n"] \
         [rejection "refined type M = str\nfn p(s: str, flags :x) -> bool proves x: M:\n    true\n1\n"]
} -match glob -result {{PROOF-CLAUSE {*must name one of the function's ordinary parameters: the function has no parameter "t" (its parameters: s)}} {PROOF-CLAUSE {*"x" is a flag, not an ordinary parameter}}}

test refinement-proof-target-not-refinement {the proven type must be a refinement} -body {
    list [rejection "fn p(s: str) -> bool proves s: str:\n    true\n1\n"] \
         [rejectionKind "import type byte::Byte\nfn p(n: int) -> bool proves n: Byte:\n    true\n1\n"] \
         [rejectionKind "fn p(s: str) -> bool proves s: Nope:\n    true\n1\n"]
} -match glob -result {{PROOF-CLAUSE {*is str, which is not a refinement type*}} PROOF-CLAUSE PROOF-CLAUSE}

test refinement-proof-returns-bool {a proof-producing function declares -> bool} -body {
    list [rejection "refined type M = str\nfn p(s: str) -> int proves s: M:\n    1\n1\n"] \
         [rejection "refined type M = str\nfn p(s: str) proves s: M:\n    true\n1\n"]
} -match glob -result {{PROOF-CLAUSE {*must declare "-> bool"*declared -> int}} {PROOF-CLAUSE {*with no declared result type}}}

test refinement-proof-carrier-mismatch {the proven parameter must already be of the carrier} -body {
    list [rejection "refined type M = str\nfn p(n: int) -> bool proves n: M:\n    true\n1\n"] \
         [rejection "refined type M = str\nfn p(s) -> bool proves s: M:\n    true\n1\n"] \
         [rejection "refined type Q = str\nrefined type E = Q\nfn p(s: str) -> bool proves s: E:\n    true\n1\n"]
} -result {{PROOF-CLAUSE {proof carrier mismatch: parameter "n" is declared int, but M refines str, and a int value does not forget to a str (a proof can only strengthen what the parameter already is)}} {PROOF-CLAUSE {the proven parameter "s" must declare its type: "proves s: M" refines a str value, so write "s: str" (or a refinement that forgets to it)}} {PROOF-CLAUSE {proof carrier mismatch: parameter "s" is declared str, but E refines str[Q], and a str value does not forget to a str[Q] (a proof can only strengthen what the parameter already is)}}}

test refinement-proof-one-clause {one proof clause, for one parameter} -body {
    list [rejectionKind "refined type M = str\nfn p(s: str, t: str) -> bool proves s: M, t: M:\n    true\n1\n"] \
         [rejectionKind "refined type M = str\nfn p(s: str, t: str) -> bool proves s: M proves t: M:\n    true\n1\n"]
} -result {SYNTAX SYNTAX}

test refinement-proof-arity-abi {a proof clause changes neither arity nor the call: the predicate is an ordinary bool function} -body {
    sourceAgree "$prelude\nok = mail?(\"abcd\")\nf = mail?\n\[ok, not ok, f(\"ab\")\]\n"
} -result {value {[true, false, false]}}

test refinement-proof-with-errors {a proof clause sits between the result type and an errors clause} -body {
    sourceAgree {import str

refined type M = str
error Weird

fn p(s: str) -> bool proves s: M errors Weird:
    if s == "?":
        fail Weird
    str::length(s) > 1

fn take(m: M) -> int:
    str::length(m)

fn f(s: str) -> int:
    ok = p(s):
        on Weird:
            return -1
    if ok:
        take(s)
    else:
        0

[f("abc"), f("a"), f("?")]
}
} -result {value {[3, 0, -1]}}

# ===========================================================================
# 9-12, 19, 28. Forgetting, no strengthening, true-edge propagation

test refinement-forgetting {a refined value is usable wherever its carrier is, with no conversion} -body {
    sourceAgree "$prelude
fn f(s: str) -> List\[str\]:
    if mail?(s):
        \[show(s), str::concat(s, \"!\"), str::lowercase(s)\]
    else:
        \[\]

f(\"abcd\")
"
} -result {value {["abcd", "abcd!", "abcd"]}}

test refinement-no-implicit-strengthening {a carrier value is never a refinement without a proof} -body {
    rejection "$prelude\nfn bad(s: str) -> int:\n    send(s)\nbad(\"abcd\")\n"
} -result {TYPE {argument for parameter "m" cannot be proven to satisfy str[Mail] (argument type: str); expected Mail but found str: a refinement proof is required (a str value becomes Mail only where one of its owner's proof-producing functions has returned true for it; there is no implicit conversion)}}

test refinement-false-edge-no-proof {the false edge proves nothing about the argument} -body {
    rejectionKind "$prelude\nfn f(s: str) -> int:\n    if mail?(s):\n        0\n    else:\n        send(s)\nf(\"ab\")\n"
} -result TYPE

test refinement-param-is-proven {inside a function, a refinement parameter is proven} -body {
    sourceAgree "$prelude\nfn relay(m: Mail) -> int:\n    send(m) + str::length(m)\nfn f(s: str) -> int:\n    if mail?(s):\n        relay(s)\n    else:\n        0\nf(\"abcde\")\n"
} -result {value 10}

# ===========================================================================
# 21-25. Value identity: boolean bindings, copies, joins, rebinding

test refinement-boolean-binding {the proof belongs to the Boolean value: ok = p(s) then if ok} -body {
    sourceAgree "$prelude
fn f(s: str) -> int:
    ok = mail?(s)
    copy = ok
    if copy:
        send(s)
    else:
        0

\[f(\"abcd\"), f(\"ab\")\]
"
} -result {value {[4, 0]}}

test refinement-not-and-or {not, and, or: facts true on every path to an outcome} -body {
    sourceAgree "$prelude
fn neg(s: str) -> int:
    if not mail?(s):
        return 0
    send(s)

fn both(s: str, t: str) -> int:
    if mail?(s) and mail?(t):
        send(s) + send(t)
    else:
        0

fn either(s: str) -> int:
    if mail?(s) or other_mail?(s):
        send(s)
    else:
        0

\[neg(\"abcd\"), neg(\"a\"), both(\"abcd\", \"efgh\"), both(\"abcd\", \"e\"), either(\"abcd\"), either(\"a\")\]
"
} -result {value {[4, 0, 8, 0, 4, 0]}}

test refinement-or-needs-both {an or of a proof and an unrelated test proves nothing} -body {
    rejectionKind "$prelude\nfn f(s: str, c: bool) -> int:\n    if mail?(s) or c:\n        send(s)\n    else:\n        0\nf(\"abcd\", true)\n"
} -result TYPE

test refinement-copy-of-proven-value {a local copy of a proven value is the same value} -body {
    sourceAgree "$prelude\nfn f(s: str) -> int:\n    if mail?(s):\n        x = s\n        send(x)\n    else:\n        0\nf(\"abcd\")\n"
} -result {value 4}

test refinement-proof-through-alias {proving an alias proves the value it aliases} -body {
    sourceAgree "$prelude\nfn f(s: str) -> int:\n    x = s\n    if mail?(x):\n        send(s)\n    else:\n        0\nf(\"abcd\")\n"
} -result {value 4}

test refinement-join-all-paths {a fact survives a join when every path that reaches it proves it} -body {
    sourceAgree "$prelude
error Bad

fn guard(s: str) -> int errors Bad:
    if mail?(s):
        unit
    else:
        fail Bad
    send(s)

fn both_branches(s: str) -> int:
    if str::length(s) > 10:
        if not mail?(s):
            return -1
    else:
        if not other_mail?(s):
            return -2
    send(s)

fn g(s: str) -> int:
    v = guard(s):
        on Bad:
            -9
    v

\[g(\"abcd\"), g(\"a\"), both_branches(\"abcde\"), both_branches(\"abc\")\]
"
} -result {value {[4, -9, 5, -2]}}

test refinement-join-one-path {a fact proven on only one path does not survive the join} -body {
    rejectionKind "$prelude\nfn f(s: str) -> int:\n    if str::length(s) > 2:\n        if mail?(s):\n            1\n        else:\n            2\n    else:\n        3\n    send(s)\nf(\"abcd\")\n"
} -result TYPE

test refinement-rebinding {facts belong to values, not spellings: a shadowing binding is not proven} -body {
    rejectionKind "$prelude\nfn f(s: str) -> int:\n    if mail?(s):\n        fn inner(s: str) -> int:\n            send(s)\n        inner(\"x\")\n    else:\n        0\nf(\"abcd\")\n"
} -result TYPE

# ===========================================================================
# 26-29. Returns, fields, parameters

test refinement-return {a function may return a refinement it has proven, with no constructor} -body {
    sourceAgree "$prelude
error Invalid

fn parse(s: str) -> Mail errors Invalid:
    if mail?(s):
        s
    else:
        fail Invalid

fn f(s: str) -> int:
    m = parse(s):
        on Invalid:
            return -1
    send(m)

\[f(\"abcd\"), f(\"x\")\]
"
} -result {value {[4, -1]}}

test refinement-return-unproven {returning an unproven carrier value is rejected} -body {
    rejection "$prelude\nfn parse(s: str) -> Mail:\n    s\nparse(\"abcd\")\n"
} -result {TYPE {function result does not prove declared type str[Mail]; expected Mail but found str: a refinement proof is required (a str value becomes Mail only where one of its owner's proof-producing functions has returned true for it; there is no implicit conversion)}}

test refinement-field {a struct field of refinement type accepts only a proven value; the field is a refined value} -body {
    list [sourceAgree "$prelude
struct Recipient:
    email: Mail

fn make(s: str) -> int:
    if mail?(s):
        r = Recipient {email: s}
        send(r.email) + str::length(r.email)
    else:
        0

\[make(\"abcd\"), make(\"a\")\]
"] [rejection "$prelude\nstruct Recipient:\n    email: Mail\nRecipient {email: \"abcd\"}\n"]
} -result {{value {[8, 0]}} {TYPE {field "email" of struct Recipient cannot be proven to satisfy its declared type str[Mail] (value type: str); expected Mail but found str: a refinement proof is required (a str value becomes Mail only where one of its owner's proof-producing functions has returned true for it; there is no implicit conversion)}}}

