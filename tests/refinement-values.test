# ===========================================================================
# 56-57, 79, 90. Auditability, and nothing of the old mechanism left

# HIR text round trips programs without modules (a module section has no
# HIR text form), so these use a self-contained program.
set hirTextProgram {refined type Positive = int
refined type Big = Positive

fn positive?(n: int) -> bool proves n: Positive:
    n > 0

fn big?(n: Positive) -> bool proves n: Big:
    n > 100

fn need(p: Positive) -> int:
    p

fn f(n: int) -> int:
    if positive?(n):
        if positive?(n):
            need(n)
        else:
            -1
    else:
        0

[f(5), f(-3)]
}

test refinement-hir-text {HIR text shows the refinement declarations and proof contracts, and reads back} -body {
    set text [hir::format [surface::compile $hirTextProgram -warnings off]]
    set back [hir::format [hir::parse $text]]
    list [regexp -all -line {^refined type (Positive carrier int|Big carrier int\[Positive\]) owner -$} $text] \
         [regexp {block s[0-9]+ \(b[0-9]+ n:int\) [^\n]*declares bool proves b[0-9]+ n: int\[Positive\]} $text] \
         [regexp {then s[0-9]+ refines b[0-9]+ n : int\[Positive\]} $text] \
         [expr {$text eq $back}]
} -result {2 1 1 1}

test refinement-hir-round-trip-runs {a program read back from HIR text keeps its proofs and runs the same on every backend} -body {
    set hir [hir::parse [hir::format [surface::compile $hirTextProgram -warnings off]]]
    list [knownOf $hir positive?] [lmap b {interp compile cranelift} {lrange [outcomeUnderHir $b $hir] 0 1}]
} -result {{{} 1} {{value {[5, 0]}} {value {[5, 0]}} {value {[5, 0]}}}}

test refinement-no-compiler-domain-knowledge {no compiler or runtime code names the corpus refinements or their predicates} -body {
    set hits {}
    foreach dir {core hir surface native compiler} {
        foreach path [lsort [glob -nocomplain -directory [file join $::projectRoot $dir] *.tcl *.rs]] {
            set number 0
            foreach line [split [core::ReadFile $path] \n] {
                incr number
                set code [string trim $line]
                if {[string match "#*" $code] || [string match "//*" $code]} continue
                if {[regexp {Emailish|UriQueryValue|emailish\?|uri_query_value\?} $code]} {
                    lappend hits "[file tail $path]:$number"
                }
            }
        }
        foreach path [lsort [glob -nocomplain -directory [file join $::projectRoot native src] -- */*.rs *.rs]] {
            set number 0
            foreach line [split [core::ReadFile $path] \n] {
                incr number
                if {[string match "//*" [string trim $line]]} continue
                if {[regexp {Emailish|UriQueryValue|emailish\?|uri_query_value\?} $line]} {
                    lappend hits "[file tail $path]:$number"
                }
            }
        }
    }
    lappend hits {*}[glob -nocomplain -directory [file join $::projectRoot lib] *.tcl]
    set hits
} -result {}

test refinement-old-mechanism-gone {no runtime evidence, opaque named types, native aliases or native implementation bridges remain} -body {
    list [info commands core::value::withEvidence] [info commands core::value::evidence] \
         [info commands core::native::alias] [info commands hir::types::BridgedNative] \
         [info commands hir::ResolveModuleNativeTargets] [info commands native::AttachNatives] \
         [catch {core::type::register gone_test::T -base str -opaque 1}] \
         [catch {core::native::register gone-test -arity 1 -impl list -module-fn {web x}}] \
         [catch {core::native::register gone-test2 -arity 1 -impl list -native-body {block {v} {ref v}}}] \
         [lsearch -inline [set ::core::native::runtimeTags] evidence]
} -result {{} {} {} {} {} {} 1 1 1 {}}

# Mutation of the source declarations (item 57): the facts come from them.
proc withWebVariant {transform script} {
    set saved $::core::libraryDir
    set dir [tcltest::makeDirectory refinement-values-web-[pid]-[incr ::refinementLibCounter]]
    try {
        foreach path [glob -directory $saved *.bot] {
            file copy $path $dir
        }
        foreach sub {abi linux} {
            file copy [file join $saved $sub] [file join $dir $sub]
        }
        set web [file join $dir web.bot]
        set text [core::ReadFile $web]
        set channel [open $web w]
        fconfigure $channel -encoding utf-8
        puts -nonewline $channel [{*}$transform $text]
        close $channel
        set ::core::libraryDir $dir
        uplevel 1 $script
    } finally {
        set ::core::libraryDir $saved
        tcltest::removeDirectory [file tail $dir]
    }
}

set redundantWeb {import web

fn consume(e: web::Emailish) -> int:
    1

fn f(s: str) -> int:
    if web::emailish?(s):
        if web::emailish?(s):
            consume(s)
        else:
            2
    else:
        3

f("a@b.co")
}

test refinement-mutant-no-proof-clause {without the proof clause, nothing proves Emailish and nothing decides the repeat} -body {
    withWebVariant {apply {{text} {string map {"-> bool proves v: Emailish:" "-> bool:"} $text}}} {
        list [rejectionKind $redundantWeb] \
             [knownOf [surface::compile [string map {"consume(s)" "1"} $redundantWeb] -warnings off] web::emailish?]
    }
} -result {TYPE {{} {}}}

test refinement-mutant-no-declaration {without the refinement declaration, the proof clause names no type} -body {
    withWebVariant {apply {{text} {string map {"refined type Emailish = str\n" ""} $text}}} {
        rejection "import web\nweb::emailish?(\"a@b.co\")\n"
    }
} -match glob -result {PROOF-CLAUSE {unknown proven type Emailish in "proves v: Emailish": *}}

test refinement-mutant-unrepeatable-predicate {an emailish? that reads mutable state proves, but is not decided} -body {
    withWebVariant {apply {{text} {string map {"    n = str::length(v)\n" "    n = str::length(v)\n    probe = mutable_array::at(mutable_array::create(1, 0), 0)\n" "import list\n" "import list\nimport mutable_array\n"} $text}}} {
        knownOf [surface::compile $redundantWeb -warnings off] web::emailish?
    }
} -result {{} {}}

::tcltest::cleanupTests
