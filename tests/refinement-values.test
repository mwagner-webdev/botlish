    regexp {func ([0-9]+) "web::emailish\?"} $nir -> emailish
    regexp {func ([0-9]+) "web::uri_query_value\?"} $nir -> query
    set body [nirBody $nir check]
    list [llength [lsearch -all -regexp $body "= call\[a-z\]* $emailish "]] \
         [llength [lsearch -all -regexp $body "= call\[a-z\]* $query "]] \
         [llength [lsearch -all -regexp $body {= bool true}]] \
         [knownOf $hir web::emailish?]
} -result {1 1 1 {{} 1}}

test refinement-corpus-refined-checks-machine-code {the Cranelift IR of check makes one call of web::emailish? (and one of web::uri_query_value?)} -body {
