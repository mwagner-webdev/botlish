# ===========================================================================
# 7, 41-44, 67-68, 70-71, 74-76. Representation: the carrier's, exactly

# The NIR of SOURCE (cranelift, specialized).
proc nirOf {source args} {
    return [native::nir [surface::compile $source -warnings off] {*}$args]
}

test refinement-nir-proof-passes-register {after a proof, the original carrier register is passed directly: no wrapper, tag, helper or re-check} -body {
    set nir [nirOf "$prelude
fn consume(m: Mail) -> int:
    str::length(m)

fn example(s: str) -> int:
    if mail?(s):
        consume(s)
    else:
        0

example(\"abcd\")
"]
    set body [nirBody $nir example]
    list [llength [lsearch -all -regexp $body {= call(env)? }]] \
         [lsearch -all -inline -regexp $body {closure|refine|wrap|tag|alloc|new }] \
         [regexp {= call[a-z]* [0-9]+ %0\s*$} [lindex [lsearch -all -inline -regexp $body {= call}] end]]
} -result {2 {} 1}

test refinement-nir-forgetting-is-free {forgetting through an ordinary call: a refined parameter passes on unchanged} -body {
    set nir [nirOf "$prelude
fn consume_string(x: str) -> int:
    str::length(x)

fn consume_email(x: Mail) -> int:
    consume_string(x)

fn f(s: str) -> int:
    if mail?(s):
        consume_email(s)
    else:
        0

f(\"abcd\")
" -tiny-leaf-inline-opt 0]
    nirBody $nir consume_email
} -match regexp -result {^\{%[0-9]+ = call [0-9]+ %0 ?\} \{ret %[0-9]+\}$}

test refinement-abi-identical {a function over the refinement and the same function over its carrier compile to identical NIR and the same machine-code size} -body {
    set common "$prelude
fn over_refined(x: Mail) -> Mail:
    if str::length(x) > 100:
        x
    else:
        x

fn over_carrier(x: str) -> str:
    if str::length(x) > 100:
        x
    else:
        x

fn f(s: str) -> int:
    if mail?(s):
        str::length(over_refined(s)) + str::length(over_carrier(s))
    else:
        0

f(\"abcd\")
"
    set hir [surface::compile $common -warnings off]
    set nir [native::nir $hir -tiny-leaf-inline-opt 0]
    set sizes [native::codeSize $hir -tiny-leaf-inline-opt 0]
    set lowered [native::lowered $hir -tiny-leaf-inline-opt 0]
    set ids [dict create]
    set index 0
    foreach info [dict get $lowered functions] {
        dict set ids [dict get $info name] $index
        incr index
    }
    set sizeList [lindex $sizes 1]
    list [expr {[nirBody $nir over_refined] eq [nirBody $nir over_carrier]}] \
         [expr {[lindex $sizeList [dict get $ids over_refined]] == [lindex $sizeList [dict get $ids over_carrier]]}] \
         [regexp {func [0-9]+ "over_refined" params=1 env=0 [^\n]*instance="str"} $nir]
} -result {1 1 1}

test refinement-struct-layout-identical {a struct with a refinement field lowers exactly like the same struct with the carrier field} -body {
    set nirOfField [lmap fieldType {Mail str} {
        set nir [nirOf "$prelude
struct Holder:
    value: $fieldType

fn build(s: str) -> int:
    if mail?(s):
        h = Holder {value: s}
        str::length(h.value)
    else:
        0

build(\"abcd\")
" -tiny-leaf-inline-opt 0]
        nirBody $nir build
    }]
    expr {[lindex $nirOfField 0] eq [lindex $nirOfField 1]}
} -result 1

# Both programs allocate the same 50 objects -- one `asciitostr` per
# iteration, the packed-ASCII constant "abcd" materialized as a String for a
# String parameter: the carrier representation's own work, identical in
# both -- and the refinement adds none.
test refinement-allocation-free {proving, passing, forgetting, returning and storing a refinement allocates nothing: the refined program allocates exactly what the carrier program does} -body {
    set reports [lmap variant {refined carrier} {
        set check [expr {$variant eq "refined" ? "mail?(s)" : "str::length(s) > 3"}]
        set type [expr {$variant eq "refined" ? "Mail" : "str"}]
        set hir [surface::compile "$prelude
struct Holder:
    value: $type

fn ident(x: $type) -> $type:
    x

fn total(x: str) -> int:
    str::length(x)

fn run(s: str, n: int, acc: int) -> int:
    if n == 0:
        return acc
    v = if $check:
        h = Holder {value: ident(s)}
        total(h.value)
    else:
        0
    run(s, n - 1, acc + v)

run(\"abcd\", 50, 0)
" -warnings off]
        set report [native::allocationReport $hir summary]
        list [dict get $report total allocations] [dict get $report total allocatedBytes]
    }]
    list [expr {[lindex $reports 0] eq [lindex $reports 1]}] [lindex $reports 0 0]
} -result {1 50}

test refinement-rendering-native-runtime {the native runtime renders a refined value as its carrier: no kind, tag or wrapper exists to render} -body {
    native::evalHir [surface::compile "$prelude\nfn f(s: str) -> List\[Mail\]:\n    if mail?(s):\n        \[s\]\n    else:\n        \[\]\nf(\"abcd\")\n" -warnings off]
} -result {list {{str abcd}}}

