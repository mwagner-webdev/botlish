# native.test -- the Cranelift backend (native/): native lowering, generated
# Cranelift IR, and semantic parity with the interpreter and the Tcl
# compiler.
#
# Semantic checks are differential: a program must produce the same outcome
# (value with evidence, or error code and message) on interp, compile,
# cranelift-generic (no function specialization) and cranelift. Structural
# checks look at NIR and CLIF for the property that matters (a back edge, a
# direct call, a missing guard), not at incidental instruction order.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]

interp recursionlimit {} 100000

proc sourceHir {text} {
    return [surface::compile $text t.bot -strict 0]
}

proc sourceIR {text} {
    return [hir::lower [sourceHir $text]]
}

set parityBackends {interp compile cranelift-generic cranelift}

# "same" if every backend agrees on the program given as source TEXT;
# otherwise every outcome.
proc parity {text} {
    set exprs [sourceIR $text]
    set outcomes [lmap backend $::parityBackends {outcomeUnder $backend $exprs}]
    if {[llength [lsort -unique $outcomes]] == 1} {
        return same
    }
    return [join [lmap backend $::parityBackends outcome $outcomes {list $backend $outcome}] " / "]
}

# The outcome of source TEXT on cranelift: {value V} or {error CODE MESSAGE}.
proc native {text} {
    lrange [outcomeUnder cranelift [sourceIR $text]] 0 end-1
}

# The NIR of source TEXT, specialized unless ARGS say -specialize 0 (whatever
# BOTLISH_NATIVE_SPECIALIZE says).
proc nirOf {text args} {
    native::nir [sourceHir $text] -specialize 1 {*}$args
}

# The NIR functions of NIR program text: a list of {ID NAME INSTANCE BODY}.
proc nirFunctions {nir} {
    set result {}
    set current ""
    foreach line [split $nir \n] {
        if {$current eq ""} {
            if {[regexp {^func ([0-9]+) "((?:[^"\\]|\\.)*)"} $line -> id name]} {
                set instance ""
                regexp {instance="([^"]*)"} $line -> instance
                set current [list $id $name $instance]
                set body {}
            }
        } elseif {$line eq "end"} {
            lappend result [concat $current [list [join $body \n]]]
            set current ""
        } else {
            lappend body $line
        }
    }
    return $result
}

# The NIR of function NAME in NIR program text: its first instance, or the
# instance whose key is INSTANCE (generic, or its key types, e.g. "int, str").
proc nirFunction {nir name {instance ""}} {
    foreach f [nirFunctions $nir] {
        lassign $f id fname key body
        if {$fname eq $name && ($instance eq "" || $key eq $instance)} {
            return $body
        }
    }
    return ""
}

# The id of function NAME's instance INSTANCE in NIR program text ("" if none).
proc nirFunctionId {nir name instance} {
    foreach f [nirFunctions $nir] {
        lassign $f id fname key
        if {$fname eq $name && $key eq $instance} {
            return $id
        }
    }
    return ""
}

# The instance keys of function NAME in NIR program text, in id order.
proc nirInstances {nir name} {
    lmap f [nirFunctions $nir] {
        if {[lindex $f 1] ne $name} continue
        lindex $f 2
    }
}

proc clifOf {text args} {
    native::clif [sourceHir $text] -specialize 1 {*}$args
}

# The CLIF of NIR function number ID (botlish_fn_ID).
proc clifFunction {clif id} {
    regexp "; function $id \[^\n\]*\n(.*?)\n\}" $clif -> body
    return $body
}

set countdown "fn count(n, acc):\n    if n == 0:\n        return acc\n    count(n - 1, acc + 1)\n\n"

# ---------------------------------------------------------------------------
# Basic execution (phase 1)

test native-basic-1 {constants, Booleans and unit} -body {
    list [parity "42"] [parity "true"] [parity "unit"] [parity "\"text\""] [native "\[1, true, \"a\", unit\]"]
} -result {same same same same {value {[1, true, "a", unit]}}}

test native-basic-2 {a function and a direct call} -body {
    list [parity "fn seven():\n    7\n\nseven()"] [parity "fn add(a, b):\n    a + b\n\nadd(40, 2)"]
} -result {same same}

test native-basic-3 {branches: statement and value forms} -body {
    parity "fn sign(n):\n    s = if n < 0:\n        \"negative\"\n    else:\n        if n == 0:\n            \"zero\"\n        else:\n            \"positive\"\n    s\n\n\[sign(-5), sign(0), sign(9)\]"
} -result same

test native-basic-4 {loops with break values and continue} -body {
    parity "fn f():\n    loop:\n        break 42\n\nfn g(n):\n    loop:\n        if n > 0:\n            break n\n        continue\n\n\[f(), g(3)\]"
} -result same

test native-basic-5 {return from inside a loop and branches} -body {
    parity "fn find(xs, i, target):\n    loop:\n        if i == list_length(xs):\n            return -1\n        if list_get(xs, i) == target:\n            return i\n        return find(xs, i + 1, target)\n\n\[find(\[5, 6, 7\], 0, 7), find(\[5\], 0, 9)\]"
} -result same

# ---------------------------------------------------------------------------
# Ints (arbitrary precision)

test native-int-1 {arithmetic and comparisons} -body {
    parity "\[1 + 2, 10 - 20, 6 * 7, 3 < 4, 4 <= 4, 5 > 6, 7 >= 8, 3 == 3, 3 == 4, -(5)\]"
} -result same

test native-int-2 {values beyond 64 bits stay exact} -body {
    list [parity "\[9223372036854775807 + 1, -9223372036854775808 - 1, 9223372036854775807 * 9223372036854775807, 100000000000000000000 - 100000000000000000000, 4611686018427387904 + 4611686018427387904\]"] \
         [native "4611686018427387903 + 1"] [native "-4611686018427387904 - 1"] \
         [native "123456789012345678901234567890 == 123456789012345678901234567890"] \
         [native "fn big():\n    170141183460469231731687303715884105727\n\nbig() > 170141183460469231731687303715884105726"]
} -result {same {value 4611686018427387904} {value -4611686018427387905} {value true} {value true}}

test native-int-3 {small-range boundaries of the tagged representation} -body {
    set cases {}
    foreach {a op b} {
        4611686018427387903 + 1   -4611686018427387904 - 1   -4611686018427387904 + -1
        2147483648 * 2147483648   -2147483648 * 2147483648   3037000499 * 3037000499
        4611686018427387904 - 1   -4611686018427387905 + 1   4611686018427387903 < 4611686018427387904
        -4611686018427387905 < -4611686018427387904   4611686018427387904 == 4611686018427387904
    } {
        lappend cases "$a $op $b"
    }
    parity "\[[join $cases {, }]\]"
} -result same

test native-int-4 {factorial of 30 through non-tail recursion} -body {
    list [parity "fn fact(n):\n    if n <= 1:\n        return 1\n    n * fact(n - 1)\n\nfact(30)"] \
         [native "fn fact(n):\n    if n <= 1:\n        return 1\n    n * fact(n - 1)\n\nfact(30)"]
} -result {same {value 265252859812191058636308480000000}}

# ---------------------------------------------------------------------------
# Guards and errors

test native-guard-1 {a known operation on an unknown kind is guarded, not dispatched} -body {
    # x + 1 with x proven a small Int (called only with the literal 1: see
    # hir/range.tcl) lowers to raw arithmetic (op riadd), not op iadd.
    set body [nirFunction [nirOf "fn inc(x):\n    x + 1\n\ninc(1)" -specialize 0] inc]
    list [regexp {guard int %0 "\+"} $body] [regexp {op r?iadd} $body] [regexp {callvalue} $body]
} -result {1 1 0}

test native-guard-2 {no guard where HIR proves the kind} -body {
    set body [nirFunction [nirOf "fn f(s):\n    n = length(s)\n    concat(s, s)\n\nf(\"a\")" -specialize 0] f]
    list [regexp -all {guard str %0} $body] [regexp {op strcat %0 %0} $body]
} -result {1 1}

test native-guard-3 {guard failures raise the reference TYPE errors} -body {
    list [parity "fn inc(x):\n    x + 1\n\ninc(\"a\")"] [native "fn inc(x):\n    x + 1\n\ninc(\"a\")"] \
         [parity "fn f(s):\n    length(s)\n\nf(\[1\])"] [parity "concat(\"a\", 1)"] \
         [parity "fn g(l):\n    list_get(l, \"0\")\n\ng(\[1\])"]
} -result {same {error {CORE SEMANTIC TYPE} {+: expected int, got "a"}} same same same}

test native-guard-4 {a non-Boolean condition} -body {
    list [parity "fn f(c):\n    if c:\n        1\n    else:\n        2\n\nf(0)"] [native "fn f(c):\n    if c:\n        1\n    else:\n        2\n\nf(\[\])"]
} -result {same {error {CORE SEMANTIC NOT-BOOLEAN} {if condition must be a Boolean, got []}}}

test native-error-1 {ARITY of blocks and natives, NOT-CALLABLE, EQUALITY} -body {
    list [parity "fn f(a, b):\n    a\n\nf(1)"] [parity "length(\"a\", \"b\")"] \
         [parity "fn call(g, x):\n    g(x)\n\ncall(5, 1)"] \
         [parity "fn call(g, x):\n    g(x)\n\nfn two(a, b):\n    a\n\ncall(two, 1)"] \
         [parity "fn f():\n    1\n\nfn eq(a, b):\n    a == b\n\neq(f, f)"] \
         [native "fn call(g, x):\n    g(x)\n\ncall(5, 1)"]
} -result {same same same same same {error {CORE SEMANTIC NOT-CALLABLE} {cannot call non-callable value 5}}}

test native-error-2 {UNBOUND and DUPLICATE are raised at run time, in order} -body {
    list [parity "x = 1\nx = 2\nx"] [parity "fn f():\n    y\n\nf()"] \
         [parity "fn early():\n    late()\n\nv = early()\n\nfn late():\n    1\n\nv"] \
         [native "fn early():\n    late()\n\nv = early()\n\nfn late():\n    1\n\nv"]
} -result {same same same {error {CORE SEMANTIC UNBOUND} {name "late" used before its binding}}}

test native-error-3 {RANGE errors of list_get and substring, including big indices} -body {
    list [parity "list_get(\[1, 2\], 2)"] [parity "list_get(\[\], 0)"] [parity "list_get(\[1\], -1)"] \
         [parity "list_get(\[1\], 100000000000000000000)"] [parity "substring(\"abc\", 2, 1)"] \
         [parity "substring(\"abc\", 0, 4)"] [parity "substring(\"abc\", -1, 2)"] \
         [native "list_get(\[1, 2\], 2)"]
} -result {same same same same same same same {error {CORE SEMANTIC RANGE} {list_get: index 2 is outside 0..1}}}

test native-error-4 {errors inside looped tail calls and deep frames propagate} -body {
    list [parity "fn f(n, acc):\n    if n == 0:\n        return acc\n    f(n - 1, concat(acc, n))\n\nf(3, \"x\")"] \
         [parity "fn g(n):\n    if n == 0:\n        return 1 + \"x\"\n    1 + g(n - 1)\n\ng(50)"]
} -result {same same}

test native-error-5 {unbounded non-tail recursion is a resource error, not a crash} -body {
    native "fn down(n):\n    1 + down(n + 1)\n\ndown(0)"
} -result {error {NATIVE LIMIT STACK} {native stack exhausted: too many nested calls}}

# ---------------------------------------------------------------------------
# Strings, lists, Results, equality

test native-string-1 {string primitives, non-ASCII characters and escapes} -body {
    list [parity "\[length(\"h\u00e9llo\"), substring(\"h\u00e9llo\", 1, 3), concat(\"\u00e4\", \"\u20ac\"), lowercase(\"ABC\u00c4\"), \"a\\\"b\\n\\\\c\\t\"\]"] \
         [parity "\[\"x\" == \"x\", \"x\" == \"y\", \"\" == \"\", substring(\"abc\", 3, 3)\]"]
} -result {same same}

# A supplementary-plane character (outside the Basic Multilingual Plane) is
# one Unicode scalar value: length, indexing (substring) and equality all
# agree with that across every backend. Tcl 9's strings are scalar-value
# sequences, matching Botlish's own String semantics (core/core.tcl requires
# Tcl 9 for exactly this reason).
test native-string-astral-1 {a supplementary-plane character is one scalar value, not a surrogate pair} -body {
    list [parity "\[length(\"\U0001F642\"), length(\"a\U0001F642b\"), substring(\"a\U0001F642b\", 1, 2), \"\U0001F642\" == \"\U0001F642\", \"\U0001F642\" == \"\U0001F643\"\]"] \
         [native "\[length(\"\U0001F642\"), length(\"a\U0001F642b\"), substring(\"a\U0001F642b\", 1, 2), \"\U0001F642\" == \"\U0001F642\", \"\U0001F642\" == \"\U0001F643\"\]"]
} -result "same {value {\[1, 3, \"\U0001F642\", true, false\]}}"

test native-list-1 {list primitives and structural equality} -body {
    list [parity "xs = \[1, \[2, 3\], \"four\"\]\n\[list_length(xs), list_get(xs, 1), list_append(xs, 5), xs\]"] \
         [parity "\[\[1, \[2\]\] == \[1, \[2\]\], \[1\] == \[1, 2\], \[1\] == \[\"1\"\], \[\] == \[\]\]"]
} -result {same same}

test native-result-1 {Results, their predicates and payloads} -body {
    set exprs {
        {bind r {ok {const 5}}}
        {bind e {error-value {const str bad}}}
        {call {ref list} {call {ref ok?} {ref r}} {call {ref error?} {ref r}} {call {ref result-value} {ref r}}
            {call {ref result-error} {ref e}} {call {ref ==} {ref r} {ok {const 5}}} {ref e}}
    }
    list [differentialAll $exprs] [differentialAll {{call {ref result-value} {error-value {const 1}}}}] \
         [differentialAll {{call {ref integer?} {const 1}} } ] [differentialAll {{bind f {block {x} {call {ref string?} {ref x}}}} {call {ref f} {const 1}}}]
} -setup {
    proc differentialAll {exprs} {
        set outcomes [lmap backend {interp compile cranelift} {outcomeUnder $backend $exprs}]
        expr {[llength [lsort -unique $outcomes]] == 1 ? "same" : $outcomes}
    }
} -result {same same same same}

# ---------------------------------------------------------------------------
# Calls: direct, envless, tail, generic

test native-call-1 {resolved Botlish calls are direct calls, not dispatch} -body {
    set nir [nirOf "${countdown}fn start(n):\n    count(n, 0)\n\nstart(4)"]
    set clif [clifOf "${countdown}fn start(n):\n    count(n, 0)\n\nstart(4)"]
    list [regexp {call 1 %0 %1} [nirFunction $nir start]] [regexp {callvalue} $nir] \
         [regexp {; u0:[0-9]+ = botlish_fn_1 \(count\)} $clif] [regexp {rt_call_value} [clifFunction $clif 2]]
} -result {1 0 1 0}

test native-call-2 {a self tail call becomes a back edge, not a recursive call} -body {
    set clif [clifOf "${countdown}count(100000, 0)"]
    set nir [nirOf "${countdown}count(100000, 0)"]
    set body [clifFunction $clif 1]
    # botlish_fn_1's own module id, as CLIF names it
    regexp {; u0:([0-9]+) = botlish_fn_1 } $clif -> self
    list [regexp {tail %[0-9]+ %[0-9]+} [nirFunction $nir count]] \
         [regexp "fn\[0-9\]+ = u0:$self " $body] \
         [regexp {jump block0\(} $body] [parity "${countdown}count(5000, 0)"]
} -result {1 0 1 same}

test native-call-3 {tail recursion runs in constant native stack} -body {
    native "${countdown}count(3000000, 0)"
} -result {value 3000000}

test native-call-4 {calls that are not in tail position stay calls} -body {
    set nir [nirOf "fn fib(n):\n    if n <= 1:\n        return n\n    fib(n - 1) + fib(n - 2)\n\nfib(15)"]
    list [regexp {tail} $nir] [regexp -all {= call 1 } [nirFunction $nir fib]] [parity "fn fib(n):\n    if n <= 1:\n        return n\n    fib(n - 1) + fib(n - 2)\n\nfib(15)"]
} -result {0 2 same}

test native-call-5 {known natives use no generic dispatch} -body {
    set clif [clifOf "fn f(s):\n    concat(substring(s, 0, 1), s)\n\nf(\"ab\")"]
    set body [clifFunction $clif 1]
    regexp {; u0:([0-9]+) = rt_call_value} $clif -> dispatch
    list [regexp "= u0:$dispatch " $body] [regexp {; u0:[0-9]+ = rt_substr} $clif]
} -result {0 1}

test native-call-6 {environment-free functions take no environment} -body {
    set nir [nirOf "${countdown}fn start(n):\n    count(n, 0)\n\nk = 7\nfn addk(n):\n    n + k\n\n\[start(4), addk(1)\]"]
    set used [nirOf "fn twice(f, x):\n    f(f(x))\n\nfn inc(n):\n    n + 1\n\nfn unused():\n    0\n\ntwice(inc, 1)"]
    # Functions only called directly are never materialized as values; a
    # function passed as a value is its generic instance's constant closure.
    list [regexp {"count" params=2 env=0} $nir] [regexp {"start" params=1 env=0} $nir] \
         [regexp {"addk" params=1 env=1} $nir] [regexp {fnvalue} $nir] \
         [regexp "fnvalue [nirFunctionId $used inc generic]" $used] [regexp {"unused"} $used]
} -result {1 1 1 0 1 0}

test native-call-7 {calls chosen at run time: closures and natives as values} -body {
    list [parity "fn apply(f, x):\n    f(x)\n\nfn inc(n):\n    n + 1\n\n\[apply(inc, 1), apply(length, \"abc\")\]"] \
         [regexp {callvalue} [nirFunction [nirOf "fn apply(f, x):\n    f(x)\n\napply(length, \"a\")"] apply]] \
         [parity "fn apply(f, x):\n    f(x)\n\napply(substring, \"abc\")"] \
         [parity "fn apply2(f, x, y):\n    f(x, y)\n\n\[apply2(list_get, \[1, 2\], 1), apply2(list_get, \[1\], 5)\]"]
} -result {same 1 same same}

test native-call-8 {mutual recursion through a forward reference} -body {
    list [parity [core::ReadFile [file join $::projectRoot examples surface 09-mutual-recursion.bot]]] \
         [native "fn even(n):\n    if n == 0:\n        return true\n    odd(n - 1)\n\nfn odd(n):\n    if n == 0:\n        return false\n    even(n - 1)\n\n\[even(10000), odd(7)\]"] \
         [regexp {cellcheck} [nirFunction [nirOf "fn even(n):\n    if n == 0:\n        return true\n    odd(n - 1)\n\nfn odd(n):\n    if n == 0:\n        return false\n    even(n - 1)\n\neven(2)"] even]]
} -result {same {value {[true, true]}} 1}

# ---------------------------------------------------------------------------
# Function specialization (hir/specialize.tcl): instances whose argument
# kinds are known, next to the generic functions

set pick "fn pick(flag):\n    if flag:\n        return 1\n    \"one\"\n\n"

test native-spec-1 {a parameter's kind guard is removed in the specialization, kept in the generic function} -body {
    set text "fn inc(x):\n    x + 1\n\ninc(1)"
    set specialized [nirOf $text]
    set generic [nirOf $text -specialize 0]
    list [nirInstances $specialized inc] [regexp {guard} [nirFunction $specialized inc int]] \
         [regexp {op r?iadd} [nirFunction $specialized inc int]] \
         [nirInstances $generic inc] [regexp {guard int %0} [nirFunction $generic inc generic]] \
         [parity $text]
} -result {int 0 1 generic 1 same}

test native-spec-2 {one function, several instances: Int, String and the generic fallback} -body {
    set text "${pick}fn same(x, y):\n    x == y\n\n\[same(1, 1), same(\"a\", \"b\"), same(pick(true), pick(false)), same(pick(false), \"one\")\]"
    set nir [nirOf $text]
    # pick returns an Int or a String: same(pick(...), ...) runs the generic
    # function (structural equality); the known calls compare words or strings.
    list [nirInstances $nir same] \
         [regexp {op r?ieq} [nirFunction $nir same {int, int}]] \
         [regexp {op streq %0 %1} [nirFunction $nir same {str, str}]] \
         [regexp {op veq %0 %1} [nirFunction $nir same generic]] \
         [regexp {op veq %0 %1} [nirFunction $nir same {any, str}]] \
         [parity $text] [native $text]
} -result {{{int, int} {str, str} generic {any, str}} 1 1 1 1 same {value {[true, false, false, true]}}}

test native-spec-2b {a type test's refinement removes the guard on its path, generic or specialized} -body {
    set program {
        {bind f {block {x} {if {call {ref integer?} {ref x}} {block {} {call {ref +} {ref x} {const 1}}} {block {} {const 0}}}}}
        {bind pick {block {c} {if {ref c} {block {} {const 1}} {block {} {const str a}}}}}
        {call {ref list} {call {ref f} {const 41}} {call {ref f} {call {ref pick} {ref false}}}}
    }
    set nir [native::nir [hir::build $program] -specialize 1]
    set outcomes [lmap backend $::parityBackends {outcomeUnder $backend $program}]
    list [nirInstances $nir f] [regexp {guard} [nirFunction $nir f generic]] \
         [regexp {op isint %0} [nirFunction $nir f generic]] [regexp {op isint} [nirFunction $nir f int]] \
         [llength [lsort -unique $outcomes]] [lindex $outcomes 0 1]
} -result {{int generic} 0 1 0 1 {[42, 0]}}

test native-spec-3 {calls with the same argument kinds reuse one instance} -body {
    set nir [nirOf "fn inc(x):\n    x + 1\n\nfn twice(y):\n    inc(inc(y))\n\n\[inc(1), inc(2), twice(3), inc(4 * 5)\]"]
    set id [nirFunctionId $nir inc int]
    list [nirInstances $nir inc] [nirInstances $nir twice] \
         [regexp -all "call $id " [nirFunction $nir <program>]] [regexp -all "call $id " [nirFunction $nir twice int]]
} -result {int int 3 2}

test native-spec-4 {a specialized self tail call stays a CFG back edge} -body {
    set text "${countdown}count(3000000, 0)"
    set nir [nirOf $text]
    set clif [clifOf $text]
    set id [nirFunctionId $nir count {int, int}]
    regexp "; u0:(\[0-9\]+) = botlish_fn_$id " $clif -> self
    set body [clifFunction $clif $id]
    list [nirInstances $nir count] [regexp {tail %[0-9]+ %[0-9]+} [nirFunction $nir count {int, int}]] \
         [regexp {guard} [nirFunction $nir count {int, int}]] \
         [regexp "fn\[0-9\]+ = u0:$self " $body] [regexp {jump block0\(} $body] [native $text]
} -result {{{int, int}} 1 0 0 1 {value 3000000}}

test native-spec-5 {a self tail call with other kinds widens to an instance that loops} -body {
    set text "fn swap(a, b, n):\n    if n == 0:\n        return \[a, b\]\n    swap(b, a, n - 1)\n\nswap(1, \"x\", 1001)"
    set nir [nirOf $text]
    # swap<int, str, int> calls swap<any, any, int> (the lub of both key
    # lists), which tail-calls itself.
    list [nirInstances $nir swap] [regexp {tail } [nirFunction $nir swap {any, any, int}]] \
         [regexp {= call } [nirFunction $nir swap {int, str, int}]] [parity $text]
} -result {{{int, str, int} {any, any, int}} 1 1 same}

test native-spec-6 {mutually recursive specializations call each other directly} -body {
    set text "fn even(n):\n    if n == 0:\n        return true\n    odd(n - 1)\n\nfn odd(n):\n    if n == 0:\n        return false\n    even(n - 1)\n\n\[even(1000), odd(7)\]"
    set nir [nirOf $text]
    set odd [nirFunctionId $nir odd int]
    set even [nirFunctionId $nir even int]
    # The forward reference to odd makes both closures over a cell: their
    # generic instances are the closures' entry points, while the calls run
    # the specializations.
    list [nirInstances $nir even] [nirInstances $nir odd] \
         [regexp "callenv $odd " [nirFunction $nir even int]] [regexp "callenv $even " [nirFunction $nir odd int]] \
         [regexp {guard} [nirFunction $nir even int]] [regexp {guard} [nirFunction $nir odd int]] [parity $text]
} -result {{int generic} {int generic} 1 1 0 0 same}

test native-spec-7 {a callee's specialized result kind reaches its caller} -body {
    set text "fn id(x):\n    x\n\nfn next(y):\n    id(y) + 1\n\nnext(41)"
    set specialized [nirFunction [nirOf $text] next int]
    set generic [nirFunction [nirOf $text -specialize 0] next generic]
    # Generically id returns any, so + checks its result; id<int> returns int.
    list [regexp -all {guard} $specialized] [regexp {guard int %[0-9]+ "\+"} $generic] [parity $text]
} -result {0 1 same}

test native-spec-8 {List[Int] -> list_get -> Int: no kind guard, the range check stays} -body {
    set text "fn first_plus(xs, n):\n    list_get(xs, 0) + n\n\nfirst_plus(\[1, 2\], 3)"
    set nir [nirOf $text]
    set body [nirFunction $nir first_plus {list<int>, int}]
    list [nirInstances $nir first_plus] [regexp {guard} $body] [regexp {op listget %0 %[0-9]+} $body] \
         [regexp -all {guard} [nirFunction [nirOf $text -specialize 0] first_plus]] \
         [parity $text] [parity "fn first_plus(xs, n):\n    list_get(xs, 0) + n\n\nfirst_plus(\[\], 3)"] \
         [native "fn at(xs, i):\n    list_get(xs, i) + 1\n\nat(\[1, 2\], 2)"]
} -result {{{list<int>, int}} 0 1 3 same same {error {CORE SEMANTIC RANGE} {list_get: index 2 is outside 0..1}}}

test native-spec-9 {nested lists: the matrix's rows and entries are known} -body {
    set text "fn cell(m, r, c):\n    list_get(list_get(m, r), c) * 2\n\ncell(\[\[1, 2\], \[3, 4\]\], 1, 0)"
    set body [nirFunction [nirOf $text] cell {list<list<int>>, int, int}]
    list [regexp {guard} $body] [parity $text] [native $text]
} -result {0 same {value 6}}

test native-spec-10 {heterogeneous lists and appends do not claim an element kind} -body {
    set appended "fn bump(xs, i):\n    list_get(xs, i) + 1\n\nbump(list_append(\[1\], \"a\"), 1)"
    set mixed "fn bump(xs, i):\n    list_get(xs, i) + 1\n\nbump(\[1, \"a\"\], 0)"
    list [regexp {guard int} [nirFunction [nirOf $appended] bump]] [parity $appended] \
         [nirInstances [nirOf $mixed] bump] [regexp {guard int} [nirFunction [nirOf $mixed] bump]] [parity $mixed] \
         [native $appended]
} -result {1 same {{list[int, str], int}} 1 same {error {CORE SEMANTIC TYPE} {+: expected int, got "a"}}}

test native-spec-11 {errors and big Ints keep their semantics in specializations} -body {
    list [parity "fn double(x):\n    x * 2\n\n\[double(4611686018427387903), double(-4611686018427387904)\]"] \
         [parity "fn cut(s, n):\n    substring(s, 0, n)\n\ncut(\"abc\", 5)"] \
         [parity "fn add(a, b):\n    a + b\n\nadd(1, \"b\")"] \
         [parity "fn head(xs):\n    list_get(xs, 0) + 1\n\nhead(\[\])"] \
         [parity "fn size(s):\n    length(s)\n\nsize(\[1\])"] \
         [parity "fn f(c, x):\n    if c:\n        x\n    else:\n        0\n\nf(1, 2)"]
} -result {same same same same same same}

test native-spec-12 {specializations are implementation artifacts: Block values are generic} -body {
    set text "fn inc(x):\n    x + 1\n\nfn apply(f, v):\n    f(v)\n\nfn same(g):\n    g == inc\n\n\[inc(1), apply(inc, 2), same(inc)\]"
    set nir [nirOf $text]
    list [nirInstances $nir inc] [regexp "fnvalue [nirFunctionId $nir inc generic]" [nirFunction $nir <program>]] \
         [parity $text]
} -result {{int generic} 1 same}

test native-spec-13 {-specialize 0 and 1 run the same programs to the same outcomes} -body {
    set hir [surface::readProgramFile [corpus::path csv]]
    list [expr {[native::nir $hir -specialize 0] ne [native::nir $hir -specialize 1]}] \
         [expr {[native::evalHir $hir -specialize 0] eq [native::evalHir $hir -specialize 1]}]
} -setup {
    source [file join $::projectRoot examples stdlib corpus.tcl]
} -result {1 1}

test native-spec-14 {guard accounting: blockers and emitted guards agree} -body {
    source [file join $::projectRoot examples stdlib corpus.tcl]
    lmap name [corpus::names] {
        set report [native::report [surface::readProgramFile [corpus::path $name]]]
        list $name [dict get $report genericBlockers] \
            [dict get $report generic guards] [dict get $report specialized guards] \
            [dict get $report nirGuards]
    }
# csv/csv_chunked/csv_geometric/csv_records's "generic guards" each grew by
# a fixed +2 with the String-region milestone (native/lower.tcl's "String
# regions" section): peek's generic instance needs 2 representation guards
# (`text` proven str, the `>=` comparison's operands proven Int) and is now
# lowered into two NIR functions, its ordinary one and its region companion
# (hir::stringregion.tcl recognizes peek as region-producing, since every
# scan_unquoted/scan_field call site consumes it only via `==`) -- ordinary
# guard accounting (blockers == guards, checked by native::report itself)
# counts the same region's guards once per NIR function it is lowered into,
# exactly as it always has for hir::escape's own List companions.
} -result {{ai_text_clean 6 6 0 0} {csv 17 19 0 0} {csv_chunked 29 31 1 1} {csv_geometric 24 26 0 0} {csv_records 84 86 29 29} {hashtable 63 55 25 25} {matmul 17 17 0 0} {string_replace 12 12 0 0} {string_reverse 4 4 0 0}}

# ---------------------------------------------------------------------------
# Closures

test native-closure-1 {a capturing closure escapes its creator} -body {
    list [parity [core::ReadFile [file join $::projectRoot examples surface 03-closure.bot]]] \
         [regexp {closure 2 %0} [nirFunction [nirOf "fn make_adder(x):\n    fn add(y):\n        x + y\n    add\n\nmake_adder(1)(2)"] make_adder]]
} -result {same 1}

test native-closure-2 {separate closure instances keep separate environments} -body {
    parity "fn make(step):\n    fn walk(n, acc):\n        if n == 0:\n            return acc\n        walk(n - 1, acc + step)\n    walk\n\na = make(2)\nb = make(10)\n\[a(5, 0), b(5, 0), a(3, 1)\]"
} -result same

test native-closure-3 {closures in loops, nested closures, and captured cells} -body {
    list [parity "fn outer(k):\n    fn even(n):\n        if n == 0:\n            return k\n        odd(n - 1)\n    fn odd(n):\n        if n == 0:\n            return 0 - k\n        even(n - 1)\n    \[even(6), even(3)\]\n\nouter(5)"] \
         [parity "fn a(x):\n    fn b(y):\n        fn c(z):\n            x + y + z\n        c\n    b\n\na(1)(2)(3)"] \
         [parity "fn make():\n    loop:\n        k = 7\n        fn get():\n            k\n        break get\n\nmake()()"] \
         [parity "fn make(n):\n    fn get():\n        n\n    get\n\nfn collect(i, acc):\n    if i == 4:\n        return acc\n    collect(i + 1, list_append(acc, make(i)))\n\nfs = collect(0, \[\])\n\[list_get(fs, 0)(), list_get(fs, 3)()\]"]
} -result {same same same same}

test native-closure-4 {a Block cannot be returned to the host} -body {
    native "fn f(x):\n    x\n\nf"
} -result {error {NATIVE UNSUPPORTED value} {the native backend cannot return a Block to the host: <block (x)>}}

# ---------------------------------------------------------------------------
# The corpus, runtime memory, AOT, diagnostics

test native-corpus-1 {every corpus program's sample runs natively to its expect: value} -body {
    lmap path [lsort [glob -directory [file join $::projectRoot examples stdlib] *.bot]] {
        regexp -line {^#\s*expect:\s*(.*)$} [core::ReadFile $path] -> expected
        set value [native::evalHir [surface::readProgramFile $path]]
        expr {[core::value::show $value 1] eq $expected}
    }
} -result {1 1 1 1 1 1 1 1 1}

test native-gc-1 {collecting before every allocation changes nothing} -body {
    set text "[core::ReadFile [file join $::projectRoot examples stdlib csv.bot]]\ncsv_parse(\"a,\\\"b\\\"\\\"c\\\",d\\ne,f\\n\")"
    set hir [sourceHir $text]
    set normal [native::measure $hir 2]
    set ::env(BOTLISH_NATIVE_GC_STRESS) 1
    try {
        set stressed [native::measure $hir 2]
    } finally {
        unset ::env(BOTLISH_NATIVE_GC_STRESS)
    }
    list [expr {[lindex $normal end] eq [lindex $stressed end]}] [expr {[lindex $stressed 3] > 10}] \
         [core::value::show [lindex $stressed end]]
} -result {1 1 {[["a", "b\"c", "d"], ["e", "f"]]}}

test native-gc-2 {repeated runs reclaim garbage} -body {
    set hir [corpus::program string_reverse "reverse_chars(\"[string repeat abcdefghij 300]\")"]
    lassign [native::measure $hir 5] - - - collections value
    list [string length [core::value::strOf $value]] [expr {$collections >= 4}]
} -setup {
    source [file join $::projectRoot examples stdlib corpus.tcl]
} -result {3000 1}

test native-aot-1 {the same lowering emits an object file} -body {
    set path [file join [temporaryDirectory] botlish-aot-test.obj]
    file delete $path
    set result [native::object [sourceHir "${countdown}count(5, 0)"] $path]
    set size [file size $path]
    set channel [open $path rb]
    set bytes [read $channel]
    close $channel
    file delete $path
    list [lindex $result 0] [expr {$size > 200}] [string match *botlish_fn_1* $bytes] [string match *rt_int_add* $bytes]
} -result {object 1 1 1}

test native-diagnostic-1 {an unsupported construct reports location, HIR node and operation} -body {
    set hir [surface::compile "fn f(x):\n    test_log(x)\n\nf(1)" t.bot -strict 0]
    list [catch {native::nir $hir} message options] [dict get $options -errorcode] $message
} -setup {
    if {"test_log" ni [core::native::names]} {
        core::registerNative test_log -arity 1 -impl testLogImpl
    }
} -match glob -result {1 {NATIVE UNSUPPORTED {native test_log}} {t.bot:2:5: e*: native lowering does not support native test_log: *}}

test native-diagnostic-2 {sequence mode is reported as unsupported} -body {
    set saved [core::useBackend]
    core::useBackend cranelift
    try {
        list [catch {core::evalIn {const 1} [core::childEnv [core::rootEnv]]} message options] [dict get $options -errorcode]
    } finally {
        core::useBackend $saved
    }
} -result {1 {NATIVE UNSUPPORTED sequence-mode}}

test native-diagnostic-3 {invalid NIR is rejected by the driver, not executed} -body {
    catch {native::Outcome [native::Driver run "nir 1\n\nfunc 0 \"<program>\" params=0 env=0 regs=1 pnames=\"\" captures=0\n    ret %5\nend\n"]} message options
    list [dict get $options -errorcode] $message
} -result {{NATIVE INVALID-NIR} {invalid NIR at line 0: function 0 (<program>): register %5 out of range}}

# ---------------------------------------------------------------------------
# Representation: local unboxing of proven-small Int arithmetic (hir/range.tcl,
# the "Representation" section of native/lower.tcl)

test native-repr-1 {a parameter proven small by its only (literal) callers gets raw arithmetic; a BigInt literal does not} -body {
    set small [nirFunction [nirOf "fn add1(x):\n    x + 1\n\n\[add1(5), add1(9)\]"] add1]
    set big [nirFunction [nirOf "fn add1(x):\n    x + 1\n\nadd1(100000000000000000000)"] add1]
    list [regexp {op runbox} $small] [regexp {op riadd} $small] [regexp {op rbox} $small] \
         [regexp {op iadd} $small] \
         [regexp {op runbox} $big] [regexp {op iadd} $big]
} -result {1 1 1 0 0 1}

test native-repr-2 {arithmetic whose result could leave the small range stays tagged, and still overflows to BigInt correctly} -body {
    set text "fn add1(x):\n    x + 1\n\nadd1($::hir::range::smallMax)"
    set body [nirFunction [nirOf $text] add1]
    list [regexp {op iadd} $body] [regexp {op riadd} $body] [parity $text] [native $text]
} -result {1 0 same {value 4611686018427387904}}

test native-repr-3 {comparisons between two proven-small Ints compile as a direct raw comparison} -body {
    set body [nirFunction [nirOf "fn small(x):\n    x < 100\n\n\[small(1), small(2)\]"] small]
    list [regexp {op rilt} $body] [regexp {op ilt} $body]
} -result {1 0}

test native-repr-4 {reading the same proven-small local twice unboxes it once (boxing elimination)} -body {
    set body [nirFunction [nirOf "fn f(x):\n    \[x + 1, x + 2\]\n\n\[f(3), f(4)\]"] f]
    list [regexp -all {op runbox} $body] [regexp -all {op riadd} $body] [regexp -all {op rbox} $body]
} -result {1 2 2}

test native-repr-5 {a branch join is conservative: one small literal and one that is not stays tagged, and both values are correct} -body {
    set text "fn pick(c):\n    y = if c:\n        1\n    else:\n        100000000000000000000\n    y + 1\n\n\[pick(true), pick(false)\]"
    set body [nirFunction [nirOf $text] pick]
    list [regexp {op iadd} $body] [regexp {op riadd} $body] [parity $text] \
         [native::evalHir [sourceHir $text]]
} -result {1 0 same {list {{int 2} {int 100000000000000000001}}}}

test native-repr-6 {a proven-small local crossing an ABI boundary (return, generic call, list) is boxed exactly once} -body {
    set text "fn f(x):\n    x + 1\n\n\[f(1), f(2)\]"
    set body [nirFunction [nirOf $text] f]
    list [regexp {ret %[0-9]+} $body] [regexp -all {op rbox} $body] [parity $text]
} -result {1 1 same}

test native-repr-7 {-repr-opt 0 (and BOTLISH_NATIVE_REPR_OPT=0) disables local unboxing without changing values} -body {
    set text "fn add1(x):\n    x + 1\n\n\[add1(5), add1(9)\]"
    set on [nirFunction [nirOf $text] add1]
    set off [nirFunction [nirOf $text -repr-opt 0] add1]
    set ::env(BOTLISH_NATIVE_REPR_OPT) 0
    set envOff [nirFunction [nirOf $text] add1]
    unset ::env(BOTLISH_NATIVE_REPR_OPT)
    list [regexp {op riadd} $on] [regexp {op iadd} $off] [regexp {op riadd} $off] \
         [regexp {op iadd} $envOff] \
         [native::evalHir [sourceHir $text] -repr-opt 0] [native::evalHir [sourceHir $text]]
} -result {1 1 0 1 {list {{int 6} {int 10}}} {list {{int 6} {int 10}}}}

test native-repr-8 {differential: interp, compile, cranelift-generic and cranelift (repr-opt on and off) all agree} -body {
    foreach text [list \
        "fn add1(x):\n    x + 1\n\n\[add1(5), add1($::hir::range::smallMax)\]" \
        "fn f(x):\n    if x < 10:\n        x + 1\n    else:\n        x - 1\n\n\[f(1), f(20)\]" \
        "${countdown}\[count(5, 0), count(0, 0)\]" \
    ] {
        lappend got [parity $text]
        set hir [sourceHir $text]
        lappend got [expr {[native::evalHir $hir] eq [native::evalHir $hir -repr-opt 0]}]
    }
    set got
} -result {same 1 same 1 same 1}

test native-repr-9 {representation statistics: emitted raw ops are counted, and drop to zero with -repr-opt 0} -body {
    set hir [sourceHir "fn add1(x):\n    x + 1\n\n\[add1(5), add1(9)\]"]
    set on [dict get [native::lower::program $hir] statistics]
    set off [dict get [native::lower::program $hir -repr-opt 0] statistics]
    list [expr {[dict get $on rawUnboxes] > 0}] [expr {[dict get $on rawBoxes] > 0}] \
         [expr {[dict get $on rawArith] > 0}] [dict get $off rawUnboxes] [dict get $off rawBoxes] [dict get $off rawArith]
} -result {1 1 1 0 0 0}

test native-repr-10 {the small-Int boundary native/lower.tcl reads matches the runtime's actual boundary} -body {
    list [native "fn add1(x):\n    x + 1\n\nadd1($::hir::range::smallMax)"] \
         [native "fn add1(x):\n    x + 1\n\nadd1([expr {$::hir::range::smallMax - 1}])"]
} -result {{value 4611686018427387904} {value 4611686018427387903}}

test native-repr-11 {collecting before every allocation changes nothing, with raw arithmetic in play} -body {
    set hir [sourceHir "fn add1(x):\n    x + 1\n\nfn go(n, acc):\n    if n == 0:\n        return acc\n    go(n - 1, add1(acc))\n\ngo(2000, 0)"]
    set normal [native::evalHir $hir]
    set ::env(BOTLISH_NATIVE_GC_STRESS) 1
    try {
        set stressed [native::evalHir $hir]
    } finally {
        unset ::env(BOTLISH_NATIVE_GC_STRESS)
    }
    list [expr {$normal eq $stressed}] $normal
} -result {1 {int 2000}}

# ---------------------------------------------------------------------------
# Representation: raw values across CFG joins and self-tail backedges
# (hir/induction.tcl, hir/range.tcl's branch-derived narrowing, the
# "Representation" section of native/lower.tcl, native/src/nir.rs's
# declared rawregs, native/src/codegen/clif.rs's per-parameter prologue
# unboxing)

test native-repr-12 {a self-tail loop's proven-small parameter is declared raw for the whole function (rawregs=) and stays raw across the backedge: comparison and decrement are raw, while an unbounded accumulator in the same function stays tagged} -body {
    set nir [nirOf "${countdown}count(100000, 0)"]
    set body [nirFunction $nir count]
    list [regexp {func [0-9]+ "count"[^\n]*rawregs="(?:\d+ )*0(?: \d+)*"} $nir] \
         [regexp {op rieq %0} $body] [regexp {op risub %0} $body] \
         [regexp {tail %[0-9]+ %[0-9]+} $body] \
         [regexp {op iadd %1 } $body] [regexp {op riadd %1 } $body]
} -result {1 1 1 1 1 0}

test native-repr-13 {a loop-carried index bounded by an immutable collection length (string_reverse's shape) stays raw across the self-tail backedge} -body {
    set text "fn reverse_from(text, index, reversed):\n    if index == length(text):\n        return reversed\n    character = substring(text, index, index + 1)\n    reverse_from(text, index + 1, concat(character, reversed))\n\nreverse_from(\"hello\", 0, \"\")"
    set nir [nirOf $text]
    set body [nirFunction $nir reverse_from]
    list [regexp {func [0-9]+ "reverse_from"[^\n]*rawregs="(?:\d+ )*1(?: \d+)*"} $nir] \
         [regexp {op rieq} $body] [regexp {op riadd} $body] \
         [regexp {tail %[0-9]+ %[0-9]+ %[0-9]+} $body] \
         [parity $text] [native $text]
} -result {1 1 1 1 same {value {"olleh"}}}

test native-repr-14 {a parameter seeded, at every external call site, only by a length/list_length-shaped argument (matmul's "count") is itself proven small with no relational reasoning, so an == guard against it stays raw too} -body {
    set text "fn dot(a_row, b, column, k, count, total):\n    if k == count:\n        return total\n    term = list_get(a_row, k) * list_get(list_get(b, k), column)\n    dot(a_row, b, column, k + 1, count, total + term)\n\ndot(\[1, 2\], \[\[1, 2\], \[3, 4\]\], 0, 0, list_length(\[1, 2\]), 0)"
    set body [nirFunction [nirOf $text] dot]
    list [regexp {op rieq} $body] [regexp {op riadd} $body] [regexp {op imul} $body] \
         [regexp {op iadd} $body] [parity $text] [native $text]
} -result {1 1 1 1 same {value 7}}

test native-repr-15 {an equality-terminated loop whose step is +-2 is not (unsoundly) proven small -- it could skip the terminator -- so it safely falls back to tagged and still computes the right answer} -body {
    set text "fn count2(n, acc):\n    if n == 0:\n        return acc\n    count2(n - 2, acc + 1)\n\ncount2(100000, 0)"
    set body [nirFunction [nirOf $text] count2]
    list [regexp {op risub} $body] [regexp {op rieq} $body] [regexp {op isub} $body] [native $text]
} -result {0 0 1 {value 50000}}

test native-repr-16 {a self-recursive counter with no recognizable step (an opaque, call-derived next value, csv's scan_records shape) safely falls back to tagged: analysis terminates, and execution is still correct} -body {
    set text "fn next_index(i):\n    i + 1\n\nfn scan(text, index, count):\n    if index >= length(text):\n        return count\n    scan(text, next_index(index), count + 1)\n\nscan(\"abcde\", 0, 0)"
    set body [nirFunction [nirOf $text] scan]
    list [regexp {op riadd} $body] [regexp {op rige} $body] [native $text]
} -result {0 0 {value 5}}

test native-repr-17 {raw block parameters and raw backedge values are never scanned as GC roots: stress-collecting on every allocation still gives the right answer for a loop that stays raw the whole time} -body {
    set text "${countdown}count(200000, 0)"
    set normal [native $text]
    set ::env(BOTLISH_NATIVE_GC_STRESS) 1
    try {
        set stressed [native $text]
    } finally {
        unset ::env(BOTLISH_NATIVE_GC_STRESS)
    }
    list [expr {$normal eq $stressed}] $normal
} -result {1 {value 200000}}

test native-repr-18 {a raw loop index that also escapes as an ordinary return value is boxed exactly once, lazily, right at that boundary: the comparison and the self-tail backedge never touch a tagged form of it at all} -body {
    set text "fn f(n):\n    if n == 0:\n        return n\n    f(n - 1)\n\nf(5)"
    set body [nirFunction [nirOf $text] f]
    list [regexp {ret %[0-9]+} $body] [regexp -all {op rbox} $body] \
         [regexp {op rieq %0} $body] [regexp {op risub %0} $body] [native $text]
} -result {1 1 1 1 {value 0}}

# ---------------------------------------------------------------------------
# Representation: demand-driven expression lowering (a consumer requests raw
# or tagged directly, instead of Expr always producing tagged and a later
# consumer unboxing it back -- see the "Demand-driven lowering" note in
# native/lower.tcl's Representation section)

test native-repr-19 {a self-tail loop whose raw parameter never crosses a tagged boundary emits no representation transition at all: the milestone's canonical dead "rbox immediately unboxed back" pattern does not appear because nothing ever asks for tagged in the first place} -body {
    set text "fn f(n):\n    if n == 0:\n        return unit\n    f(n - 1)\n\nf(5)"
    set body [nirFunction [nirOf $text] f]
    list [regexp {op rieq %0} $body] [regexp {op risub %0} $body] [regexp {tail %[0-9]+} $body] \
         [regexp {op rbox} $body] [regexp {op runbox} $body] [native $text]
} -result {1 1 1 0 0 {value unit}}

test native-repr-20 {a raw-safe arithmetic chain nested inside another raw-eligible operation stays fully raw with zero intermediate boxes, boxing only once, at the function's own tagged-return boundary} -body {
    set text "fn f(x):\n    ((x + 1) * 2 - 3) + 10\n\n\[f(1), f(100)\]"
    set body [nirFunction [nirOf $text] f]
    list [regexp -all {op riadd} $body] [regexp {op rimul} $body] [regexp {op risub} $body] \
         [regexp -all {op rbox} $body] [regexp -all {op runbox} $body] [parity $text]
} -result {2 1 1 1 1 same}

test native-repr-21 {a raw-provable value passed to an ordinary (non-self-tail) call still boxes exactly once: this cleanup removes only boxes nothing needed, never a genuine ABI boundary} -body {
    set text "fn helper(x):\n    x\n\nfn f(n):\n    if n == 0:\n        return helper(n)\n    f(n - 1)\n\nf(5)"
    set body [nirFunction [nirOf $text] f]
    list [regexp {op rbox} $body] [regexp {call [0-9]+ %[0-9]+} $body] [native $text]
} -result {1 1 {value 0}}

test native-repr-22 {a bound value read raw, then tagged, then raw again is computed once, with at most one conversion in each direction (RawOf/TaggedOf's shared caches): Botlish has no side-effecting natives, so "not duplicated" is checked structurally -- one defining riadd, one runbox, reused} -body {
    set text "fn f(x):\n    a = x + 1\n    \[a + 2, a, a + 3\]\n\nf(5)"
    set body [nirFunction [nirOf $text] f]
    list [regexp -all {op riadd} $body] [regexp -all {op runbox} $body] [regexp -all {op rbox} $body] [native $text]
} -result {3 1 3 {value {[8, 6, 9]}}}

cleanupTests
