# package-workloads.test -- the package manager's acceptance workloads
# (PACKAGE-MANAGER-MILESTONE-1.md, "Workload results"): real packages of
# this repository, packed into a local repository and installed by the
# ordinary commands into applications made fresh in the temporary
# directory, compiled by the unchanged compiler and, where the host has the
# native libraries, run.
#
#   A  a pure-Botlish package: the 2048 engine (examples/games/2048), packed
#      as `game2048` -- no native file, no toolchain on either side;
#   B  nested packages: sdlkit, which locks sdl3 -- one release holding the
#      generated SDL3 bindings, thunk archives and native libraries of
#      linux-x86_64 and linux-aarch64 (PACKAGE-MANAGER-MILESTONE-2.md) --
#      installed in sdlkit's own .bot_modules, compiled from target views;
#   D  SDL3: sdlkit's frame through the libSDL3 the package bundles
#      (headless), with no -L or LD_LIBRARY_PATH; deployed and relocated;
#      the system's SDL3 chosen and honestly refused; a thunk;
#   E  Raven: the wrapper with its generated bindings, bridge archives and
#      libraven of both targets, built on the author's side, installed with
#      no build on the consumer's;
#   F  the Linux event loop's driver: archives of both targets and its
#      public header.
#
# (C, two versions of one package on separate branches, is
# tests/package-manager.test's pm-two-versions-two-branches.) The packages
# are packed by tools/package-repository.tcl, the author's side; everything
# on the consumer's side is `main.tcl add`/`install`/`verify`.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]
source [file join $::projectRoot pm pm.tcl]
source [file join $::projectRoot tests cffi sdl3.tcl]
source [file join $::projectRoot tests cffi raven.tcl]
source [file join $::projectRoot tools raven-package.tcl]

interp recursionlimit {} 100000

set mainScript [file join $::projectRoot main.tcl]
set repositoryTool [file join $::projectRoot tools package-repository.tcl]
set ::counter 0

testConstraint nativeBuilt [expr {![catch {native::binary}]}]
set linuxHost [expr {$::tcl_platform(os) eq "Linux" && $::tcl_platform(machine) in {x86_64 amd64 aarch64}}]
testConstraint linuxHost $linuxHost
testConstraint cToolchain [expr {[auto_execok cc] ne "" && [auto_execok ar] ne ""}]
# Raven's package is assembled where its binding exists for the host and the
# pinned headers are fetched (the bridge is compiled against them).
proc ravenAssemblable {} {
    if {!$::linuxHost || [auto_execok cc] eq "" || [catch {ravenPackage::hostTarget} target]} { return 0 }
    set headers [expr {[info exists ::env(BOTLISH_C_HEADER_SOURCES)] && $::env(BOTLISH_C_HEADER_SOURCES) ne ""
        ? $::env(BOTLISH_C_HEADER_SOURCES) : [file join [cffi::RavenCacheDir] c-header-src]}]
    return [expr {[file isdirectory [file join $::projectRoot generated c raven $target raven]]
        && [file exists [file join $headers raven include Raven.h]]}]
}
# The release bundles Raven's desktop build (RAVEN-CLEANROOM-DESKTOP-
# MILESTONE-1.md) for both Linux targets: the host's from tests/cffi/raven.tcl
# desktop, AArch64's cross-built by the tool against the pinned arm64 libX11
# packages, which it fetches once (dpkg-deb unpacks them).
testConstraint ravenPackage [expr {[ravenAssemblable] && [cffi::ravenDesktopDir] ne "" && [core::cabi::hostTarget] eq "linux-x86_64"
    && [auto_execok aarch64-linux-gnu-gcc] ne "" && [auto_execok cmake] ne "" && [auto_execok ninja] ne ""
    && [auto_execok dpkg-deb] ne ""}]
testConstraint ravenRun [expr {[testConstraint ravenPackage] && [testConstraint nativeCCalls] && [testConstraint cLinker]}]
testConstraint crossAarch64 [expr {[auto_execok aarch64-linux-gnu-gcc] ne "" && [auto_execok clang] ne ""}]
# The repository's target-aware packages are one release for every target
# their botlish.json names (linux-x86_64 and linux-aarch64): packing one
# needs both targets' toolchains (tools/package-repository.tcl).
testConstraint sdl3Package [expr {[core::cabi::hostTarget] eq "linux-x86_64" && [testConstraint crossAarch64]
    && [testConstraint cToolchain] && [cffi::sdl3Dir] ne ""}]
testConstraint sdl3Run [expr {[testConstraint sdl3Package] && [testConstraint nativeCCalls] && [testConstraint cLinker]}]
testConstraint eventLoopPackage [expr {$linuxHost && [testConstraint cToolchain] && [testConstraint crossAarch64]
    && [core::cabi::hostTarget] eq "linux-x86_64"}]
testConstraint eventLoopRun [expr {[testConstraint eventLoopPackage] && [testConstraint nativeCCalls] && [testConstraint cLinker]}]

proc fresh {tag} {
    return [makeDirectory pw-[pid]-$tag-[incr ::counter]]
}

proc cleanup {} {
    foreach dir [glob -nocomplain -directory [temporaryDirectory] pw-[pid]-*] {
        file delete -force $dir
    }
}

proc writeText {path text} {
    file mkdir [file dirname $path]
    set channel [open $path w]
    fconfigure $channel -encoding utf-8 -translation lf
    puts -nonewline $channel $text
    close $channel
}

# main.tcl ARGS in a child process: {status out err}; ENVIRONMENT pairs set
# for it.
proc pm {args} {
    set environment {}
    if {[lindex $args 0] eq "-env"} {
        set environment [lindex $args 1]
        set args [lrange $args 2 end]
    }
    set status 0
    withEnvironment $environment {
        if {[catch {exec [info nameofexecutable] $::mainScript {*}$args 2>@1} out options]} {
            set status [lindex [dict get $options -errorcode] end]
        }
    }
    return [dict create status $status out $out]
}

# A repository of the packages NAMES this checkout packs for the host
# (tools/package-repository.tcl), made once per name set.
proc repository {names} {
    set key [join $names +]
    if {[info exists ::repositories($key)]} {
        return $::repositories($key)
    }
    set repo [makeDirectory pw-repo-[pid]-[incr ::counter]]
    # (A build the tool makes writes its progress on standard error.)
    exec [info nameofexecutable] $::repositoryTool $repo {*}$names 2>@1
    set ::repositories($key) $repo
    return $repo
}

proc treeState {dir} {
    set entries {}
    foreach path [lsort [exec find $dir]] {
        set type [file type $path]
        set crc ""
        if {$type eq "file"} {
            set channel [open $path rb]
            set crc [zlib crc32 [read $channel]]
            close $channel
        }
        lappend entries [list [string range $path [string length $dir] end] $type $crc]
    }
    return $entries
}

proc kindOf {out} {
    if {[regexp {\(PM ([A-Z]+)\)} $out -> kind]} { return $kind }
    return ""
}

proc hirOf {path args} {
    return [surface::readProgramFile $path -warnings off -cache "" {*}$args]
}

proc valueOf {path backend args} {
    lassign [outcomeUnderHir $backend [hirOf $path {*}$args]] tag value
    if {$tag eq "value"} { return $value }
    return "$tag: $value"
}

# ---------------------------------------------------------------------------
# A. A pure-Botlish package: the 2048 engine

set gameDir [file join $::projectRoot examples games 2048]

# The 2048 engine as a package directory: game2048.bot, as it is, with a
# descriptor and nothing else.
proc enginePackage {} {
    set dir [file join [fresh src] game2048]
    file mkdir $dir
    file copy [file join $::gameDir game2048.bot] $dir
    writeText [file join $dir botlish.json] "{\"schema\": 1, \"name\": \"game2048\", \"version\": \"1.0.0\"}\n"
    return $dir
}

# bench.bot making MOVES moves, written into DIR.
proc benchInto {dir moves} {
    regsub -line {^benchmark\(\d+, (.*)\)$} [core::ReadFile [file join $::gameDir bench.bot]] "benchmark($moves, \\1)" text
    writeText [file join $dir bench.bot] $text
    return [file join $dir bench.bot]
}

test pw-pure-botlish-package {the 2048 engine, packed as the package game2048 and installed from a repository into an application of its own, computes the benchmark's checksum the engine computes as the example's application module, on every backend here; packing and installing ran with no C compiler, linker or Rust on PATH} -body {
    set repo [fresh repo]
    set empty [fresh empty-path]
    set noTools [list PATH $empty]
    set packed [pm -env $noTools package pack [enginePackage] -out $repo]
    set app [fresh app]
    set bench [benchInto $app 60]
    set added [pm -env $noTools add game2048 -project $app -repository $repo]
    set reference [benchInto [fresh ref] 60]
    file copy [file join $::gameDir game2048.bot] [file dirname $reference]
    set backends {interp compile}
    if {[testConstraint nativeBuilt]} { lappend backends cranelift }
    set artifact [pm::archive::read [file join $repo game2048-1.0.0.botpkg]]
    list [dict get $packed status] [dict get $added status] [dict keys [dict get $artifact files]] \
        [expr {[lmap b $backends {valueOf $bench $b}] eq [lmap b $backends {valueOf $reference $b}]}] \
        [lsort [glob -tails -directory [file join $app .bot_modules game2048] *]]
} -cleanup cleanup -result {0 0 {botlish.json game2048.bot} 1 {botlish.json game2048.bot}}

test pw-pure-botlish-same-hir {an installed package's program compiles to the HIR of the same program with the package's module as an application module, except for where the module was read from: the package manager adds nothing the compiler sees} -body {
    set repo [fresh repo]
    pm package pack [enginePackage] -out $repo
    set app [fresh app]
    pm add game2048 -project $app -repository $repo
    set bench [benchInto $app 5]
    set reference [benchInto [fresh ref] 5]
    file copy [file join $::gameDir game2048.bot] [file dirname $reference]
    set a [string map [list [file join $app .bot_modules game2048] ROOT [file dirname $bench] ROOT] [hir::format [hirOf $bench]]]
    set b [string map [list [file dirname $reference] ROOT] [hir::format [hirOf $reference]]]
    expr {$a eq $b}
} -cleanup cleanup -result 1

# ---------------------------------------------------------------------------
# B. Nested packages: sdlkit and its SDL3 binding, one release for two targets

set sdlkitMain "import sdlkit\n\nwith context sdlkit::open()\n\nshown = sdlkit::frame()\nsame = sdlkit::version_matches()\nsdlkit::close()\n\[shown, same\]\n"
set hostView {.bot_modules .targets linux-x86_64}

test pw-sdlkit-installs-its-binding {sdlkit and the SDL3 package -- one release holding the generated bindings, thunk archives and native libraries of linux-x86_64 and linux-aarch64 -- install with one add: sdlkit in the application's .bot_modules, sdl3 in sdlkit's own; the host's target view holds the host's binding at its module paths; the compiler reads it as the instances sdlkit and sdlkit/sdl3, the binding ordinary and sdlkit contextualized, and the application cannot import the binding} -constraints {sdl3Package} -body {
    set repo [repository {sdlkit sdl3}]
    set app [fresh app]
    writeText [file join $app main.bot] $::sdlkitMain
    set r [pm add sdlkit -project $app -repository $repo]
    set hir [hirOf [file join $app main.bot] -target linux-x86_64]
    set statuses [dict create]
    dict for {ns unit} [dict get $hir direct units] {
        if {[string match sdlkit* $ns]} { dict set statuses $ns [dict get $unit status] }
    }
    set sneaky [fresh app]
    writeText [file join $sneaky main.bot] "import sdl3::init\n\n1\n"
    file copy -force [file join $app botlish.json] $sneaky
    pm install -project $sneaky -repository $repo
    set view [file join $app {*}$::hostView sdlkit .bot_modules sdl3]
    list [dict get $r status] [lrange [split [dict get $r out] \n] 0 2] \
        [file isfile [file join $view sdl3 video.bot]] [file isdirectory [file join $view targets]] \
        [file isfile [file join $app .bot_modules sdlkit .bot_modules sdl3 targets linux-aarch64 sdl3 video.bot]] \
        [dict get $statuses sdlkit] [lsort -unique [lmap {ns status} $statuses {expr {[string match sdlkit/sdl3::* $ns] ? $status : [continue]}}]] \
        [catch {hirOf [file join $sneaky main.bot] -target linux-x86_64} m o] [lindex [dict get $o -errorcode] end]
} -cleanup cleanup -match glob -result {0 {{sdlkit 0.2.1 (sha256 *): installed} {  sdl3 0.2.1 (sha256 *): installed} {view linux-x86_64: derived (* files, 2 native libraries)}} 1 0 1 contextualized ordinary 1 UNKNOWN-NAMESPACE}

test pw-sdl3-two-targets {the same sdl3 0.2.1 artifact serves linux-aarch64: preparing it derives a second view from the installed release (nothing reinstalled, the host's view untouched), the front end compiles sdlkit's program for linux-aarch64 from the AArch64 binding, its HIR is that target's, and the plan reports AArch64's system SDL3 unverified here} -constraints {sdl3Package} -body {
    set repo [repository {sdlkit sdl3}]
    set app [fresh app]
    writeText [file join $app main.bot] $::sdlkitMain
    pm add sdlkit -project $app -repository $repo
    set before [treeState [file join $app {*}$::hostView]]
    set r [pm install -project $app -repository $repo -target linux-aarch64]
    set hir [hirOf [file join $app main.bot] -target linux-aarch64]
    set files [lmap {id file} [dict get $hir files] {
        if {![string match *sdl3/video.bot [dict get $file path]]} continue
        string map [list $app APP] [dict get $file path]
    }]
    set plan [pm native plan -project $app -target linux-aarch64]
    list [dict get $r status] [lrange [split [dict get $r out] \n] 0 3] [expr {[treeState [file join $app {*}$::hostView]] eq $before}] \
        [dict get $hir target] $files [hir::foreign::links $hir] \
        [lsearch -inline [split [dict get $plan out] \n] {    unverified*}]
} -cleanup cleanup -match glob -result {0 {{sdlkit 0.2.1: unchanged} {view linux-aarch64: derived (* files, 2 native libraries)} {note: linux-aarch64: SDL3: a system library of linux-aarch64, not verified (this host is linux-x86_64): the target system must provide it (3)} {view linux-x86_64: unchanged}} 1 linux-aarch64 APP/.bot_modules/.targets/linux-aarch64/sdlkit/.bot_modules/sdl3/sdl3/video.bot SDL3 {    unverified on this host: linux-aarch64's system must provide it}}

test pw-sdlkit-verify-and-reinstall {verify checks both instances against their artifacts and the host's view, its native libraries verified again; a fresh copy of the application reinstalls the same tree and view from botlish.json and the repository} -constraints {sdl3Package} -body {
    set repo [repository {sdlkit sdl3}]
    set app [fresh app]
    writeText [file join $app main.bot] $::sdlkitMain
    pm add sdlkit -project $app -repository $repo
    set v [pm verify -project $app -repository $repo -target linux-x86_64]
    set clone [fresh clone]
    file copy [file join $app botlish.json] [file join $app main.bot] $clone
    set i [pm install -project $clone -repository $repo]
    set same [expr {[treeState [file join $app {*}$::hostView]] eq [treeState [file join $clone {*}$::hostView]]}]
    list [dict get $v status] [lindex [split [dict get $v out] \n] end-1] [dict get $i status] $same \
        [llength [lsearch -all [split [dict get $v out] \n] {note: linux-x86_64: * bundled *}]]
} -cleanup cleanup -match glob -result {0 {verify: 2 package instance(s) in *: as installed} 0 1 2}

# ---------------------------------------------------------------------------
# D. SDL3 running and deployed through the installed packages

test pw-sdlkit-runs {the application over the installed sdlkit runs natively, headless, against the SDL3 the package bundles: no -L and no LD_LIBRARY_PATH (the view's .lib is linked and searched), every step of the frame and the version check true} -constraints {sdl3Run} -body {
    set repo [repository {sdlkit sdl3}]
    set app [fresh app]
    writeText [file join $app main.bot] $::sdlkitMain
    pm add sdlkit -project $app -repository $repo
    set hir [hirOf [file join $app main.bot]]
    withEnvironment [list SDL_VIDEO_DRIVER dummy LD_LIBRARY_PATH {}] {
        lmap backend {cranelift cranelift-generic} {lindex [outcomeUnderHir $backend $hir] 1}
    }
} -cleanup cleanup -result {{[[true, true, true, true, true, true], true]} {[[true, true, true, true, true, true], true]}}

test pw-sdlkit-deploy-relocates {native deploy places the bundled libSDL3.so.0 in DIR/lib; the executable linked with -runtime-path '$ORIGIN/lib' records that RUNPATH, and runs after DIR is moved and the application's packages are deleted, with no LD_LIBRARY_PATH} -constraints {sdl3Run} -body {
    set repo [repository {sdlkit sdl3}]
    set app [fresh app]
    writeText [file join $app main.bot] $::sdlkitMain
    pm add sdlkit -project $app -repository $repo
    set dist [file join [fresh dist] out]
    set d [pm native deploy -project $app -target linux-x86_64 -out $dist]
    set e [pm -emit-native-executable -runtime-path {$ORIGIN/lib} [file join $app main.bot]]
    file rename [file join $app main] [file join $dist main]
    set moved [file join [fresh moved] game]
    file rename $dist $moved
    file delete -force [file join $app .bot_modules]
    set runpath [lsearch -inline [split [exec readelf -d [file join $moved main]] \n] *RUNPATH*]
    set run [withEnvironment [list SDL_VIDEO_DRIVER dummy LD_LIBRARY_PATH {}] {exec [file join $moved main]}]
    list [dict get $d status] [dict get $e status] [string match {*\[$ORIGIN/lib\]*} $runpath] $run [lsort [glob -tails -directory [file join $moved lib] *]]
} -cleanup cleanup -result {0 0 1 {[[true, true, true, true, true, true], true]} libSDL3.so.0}

test pw-sdl3-system-origin {a consumer chooses the system's SDL3 with botlish.json's origins: the package manager then verifies a system-managed SDL3 and, finding none on this host (no distribution package, no system pkg-config record), refuses -- never taking the bundled one or a stray file instead -- and changes nothing} -constraints {sdl3Package} -body {
    set repo [repository {sdlkit sdl3}]
    set app [fresh app]
    writeText [file join $app main.bot] $::sdlkitMain
    pm add sdlkit -project $app -repository $repo
    set descriptor [pm::descriptor::read [file join $app botlish.json] project]
    dict set descriptor schema 2
    dict set descriptor targets {}
    dict set descriptor origins {SDL3 system}
    writeText [file join $app botlish.json] [encoding convertfrom utf-8 [pm::descriptor::encode $descriptor]]
    set before [treeState [file join $app .bot_modules]]
    set r [pm install -project $app -repository $repo]
    list [dict get $r status] [regexp {system library SDL3 \(libSDL3\.so\.0 or libSDL3\.so\) is not installed|no system metadata} [dict get $r out]] \
        [expr {[treeState [file join $app .bot_modules]] eq $before}]
} -cleanup cleanup -result {1 1 1}

test pw-sdl3-thunk-archive {a program calling one of the binding's thunks (an SDL static inline function) links the package's prebuilt thunk archive from the view's .lib: no C compiler on the consumer's side, no -L} -constraints {sdl3Run} -body {
    set repo [repository {sdlkit sdl3}]
    set app [fresh app]
    writeText [file join $app main.bot] "import sdl3::thunks::bits\n\nsdl3::thunks::bits::SDL_MostSignificantBitIndex32(8)\n"
    pm add sdl3 -project $app -repository $repo
    withEnvironment [list LD_LIBRARY_PATH {}] {lindex [outcomeUnderHir cranelift [hirOf [file join $app main.bot]]] 1}
} -cleanup cleanup -result 3

# ---------------------------------------------------------------------------
# E. Raven

test pw-raven-installs-without-a-compiler {the Raven package installs with no C compiler or linker on PATH; its host view is file for file the tree tools/raven-package.tcl installs, plus its botlish.json, the bundled libraven and the license notices it carries: the bridge archive and the library were built on the author's side} -constraints {ravenPackage} -body {
    set repo [repository {raven}]
    set app [fresh app]
    set empty [fresh empty-path]
    set r [pm -env [list PATH $empty] add raven -project $app -repository $repo]
    set helper [fresh helper]
    ravenPackage::install $helper
    set files {}
    foreach root [list [file join $app {*}$::hostView raven] [file join $helper .bot_modules raven]] {
        set list {}
        foreach path [lsort [exec find $root -type f]] {
            lappend list [string range $path [string length $root/] end]
        }
        lappend files $list
    }
    lassign $files managed helped
    set managed [lsearch -all -inline -not -regexp $managed {^(botlish\.json|native/libraven\.so\.0|licenses/raven/.*)$}]
    list [dict get $r status] [expr {$managed eq $helped}] [file isfile [file join $app {*}$::hostView .lib libraven.so.0]]
} -cleanup cleanup -result {0 1 1}

test pw-raven-runs {examples/raven's headless program over the installed raven package runs natively against the libraven the package bundles, with no -L and no LD_LIBRARY_PATH: three clicks counted, Quit honored} -constraints {ravenRun} -body {
    set repo [repository {raven}]
    set app [fresh app]
    foreach file {headless.bot counter.bot} {
        file copy [file join $::projectRoot examples raven $file] $app
    }
    pm add raven -project $app -repository $repo
    set hir [hirOf [file join $app headless.bot]]
    withEnvironment [list LD_LIBRARY_PATH {}] {lindex [outcomeUnderHir cranelift $hir] 1}
} -cleanup cleanup -result {["3", "3 clicks", "false", "0"]}

test pw-raven-targets {Raven's release holds linux-x86_64 and linux-aarch64 (its AArch64 bridge archive and libraven inspected as AArch64 ELF); macos-aarch64 and windows-x86_64 it does not support, and preparing them is UNSUPPORTED, never an implied port} -constraints {ravenPackage} -body {
    set repo [repository {raven}]
    set app [fresh app]
    pm add raven -project $app -repository $repo
    set arm [pm install -project $app -repository $repo -target linux-aarch64]
    set plan [pm native plan -project $app -target linux-aarch64]
    set mac [pm install -project $app -repository $repo -target macos-aarch64]
    set win [pm install -project $app -repository $repo -target windows-x86_64]
    list [dict get $arm status] [llength [lsearch -all [split [dict get $plan out] \n] {*ELF AArch64*}]] \
        [dict get $mac status] [kindOf [dict get $mac out]] [kindOf [dict get $win out]]
} -cleanup cleanup -result {0 2 1 UNSUPPORTED UNSUPPORTED}

# The release's file list, every target's native files' facts (read from
# their bytes), from the store of an application that installed it.
proc ravenStoreFacts {app target} {
    set store [file join $app .bot_modules raven targets $target native]
    lmap name {libraven.so.0 libraven_bridge.a} {
        set path [file join $store $name]
        set facts [pm::binary::inspect [pm::ReadBytes $path] $path]
        if {[dict get $facts kind] eq "elf"} {
            list $name [dict get $facts machine] [expr {"libX11.so.6" in [dict get $facts needed]}] \
                [expr {"Rvulkan_get_instance" in [dict get $facts symbols]}] [dict get $facts soname]
        } else {
            list $name [dict get $facts kind]
        }
    }
}

test pw-raven-desktop-release {the release is raven 0.3.2, one artifact for linux-x86_64 and linux-aarch64, and on both it bundles Raven's desktop build -- a shared object of the target that loads libX11.so.6 (the X11 platform) and exports the Vulkan renderer's API -- beside the bridge's archive; libX11 is declared a system library, verified here by the system's own metadata, and the plan names no -L} -constraints {ravenPackage} -body {
    set repo [repository {raven}]
    set app [fresh app]
    set added [pm add raven -project $app -repository $repo]
    set plan [dict get [pm native plan -project $app] out]
    list [lsort [glob -tails -directory $repo *.botpkg]] [dict get $added status] \
        [ravenStoreFacts $app linux-x86_64] [ravenStoreFacts $app linux-aarch64] \
        [regexp {library X11: system shared \(instance raven\)\n    ELF x86-64 shared object; (pkg-config|dpkg package)} $plan] \
        [string match "*needs libm.so.6, libX11.so.6, libc.so.6, ld-linux-x86-64.so.2*" $plan] [string match "*no -L is needed*" $plan]
} -cleanup cleanup -result {raven-0.3.2.botpkg 0 {{libraven.so.0 62 1 1 libraven.so.0} {libraven_bridge.a archive}} {{libraven.so.0 183 1 1 libraven.so.0} {libraven_bridge.a archive}} 1 1 1}

test pw-raven-artifact-contents {the artifact holds the package and nothing to run: its common files -- the module, the two guides, the example, the bridge's source, Raven's license and the notices its terms require -- and per target the generated binding, the bridge's archive and libraven; no script, no build file, no header but the binding's own modules} -constraints {ravenPackage} -body {
    set repo [repository {raven}]
    set files [dict keys [dict get [pm::archive::read [file join $repo raven-0.3.2.botpkg]] files]]
    set common [lsort [lsearch -all -inline -not -glob $files targets/*]]
    set kinds {}
    foreach target {linux-aarch64 linux-x86_64} {
        set own [lsearch -all -inline -glob $files targets/$target/*]
        set bindings [llength [lsearch -all -inline -regexp $own "^targets/$target/raven/\[a-z_\]+\\.bot\$"]]
        set native [lsort [lsearch -all -inline -glob $own targets/$target/native/*]]
        lappend kinds $target [expr {$bindings == [llength $own] - 2}] $native
    }
    list $common $kinds
} -cleanup cleanup -result {{GUIDE.md README.md botlish.json examples/clicks/clicks.bot examples/clicks/main.bot examples/clicks/test.bot licenses/raven/LICENSE licenses/raven/NOTICE licenses/raven/THIRD_PARTY.md licenses/raven/third_party/roboto-mono/LICENSE licenses/raven/third_party/roboto/LICENSE licenses/raven/third_party/stb/LICENSE native/raven_bridge.c raven.bot} {linux-aarch64 1 {targets/linux-aarch64/native/libraven.so.0 targets/linux-aarch64/native/libraven_bridge.a} linux-x86_64 1 {targets/linux-x86_64/native/libraven.so.0 targets/linux-x86_64/native/libraven_bridge.a}}}

test pw-raven-release-immutable {the author's one operation (tools/package-repository.tcl OUT raven) prints the release's identity -- name, version, SHA-256, targets -- and run again reproduces the same bytes from its cached builds (unchanged); a different file already holding raven 0.3.2 in OUT is refused (EXISTS) and left as it was, unless -force says to overwrite that local file} -constraints {ravenPackage} -body {
    set out [fresh repo]
    set first [exec [info nameofexecutable] $::repositoryTool $out raven 2>@1]
    regexp {sha256 ([0-9a-f]{64})} $first -> digest
    set again [exec [info nameofexecutable] $::repositoryTool $out raven 2>@1]
    set artifact [file join $out raven-0.3.2.botpkg]
    writeText $artifact "not this release"
    set refused [catch {exec [info nameofexecutable] $::repositoryTool $out raven 2>@1} refusal]
    set kept [expr {[pm::ReadBytes $artifact] eq "not this release"}]
    set forced [exec [info nameofexecutable] $::repositoryTool -force $out raven 2>@1]
    list [regexp {packed raven 0\.3\.2: \S+raven-0\.3\.2\.botpkg\n} $first] [string match "*targets linux-aarch64, linux-x86_64*" $first] \
        [string match "*(unchanged)*sha256 $digest*" $again] $refused [string match "*already holds a different raven 0.3.2*" $refusal] $kept \
        [string match "*sha256 $digest*" $forced] [expr {[pm::sha256::hex [pm::ReadBytes $artifact]] eq $digest}]
} -cleanup cleanup -result {1 1 1 1 1 1 1 1}

test pw-raven-metadata-checked {the release's native metadata is checked against its files when it is packed: without its X11 declaration the bundled libraven's need of libX11.so.6 resolves to nothing; with the headless library where the desktop one is declared, its loader dependencies and the declared Vulkan symbol are refused -- so the desktop release cannot be packed from the wrong build or with a dependency left out} -constraints {ravenPackage} -body {
    set repo [repository {raven}]
    set app [fresh app]
    pm add raven -project $app -repository $repo
    set store [file join $app .bot_modules raven]
    # Without X11.
    set noX11 [file join [fresh pkg] raven]
    file copy $store $noX11
    set descriptor [pm::descriptor::read [file join $noX11 botlish.json] pack]
    foreach target [dict keys [dict get $descriptor targets]] {
        set libraries [lsearch -all -inline -not -glob [dict get $descriptor targets $target libraries] "*name X11*"]
        dict set descriptor targets $target libraries $libraries
    }
    file delete [file join $noX11 botlish.json]
    pm::WriteNew [file join $noX11 botlish.json] [pm::descriptor::encode $descriptor]
    set a [pm package pack $noX11 -out [fresh out]]
    # The headless library in the desktop release's place.
    set headless [file join [fresh pkg] raven]
    file copy $store $headless
    set target [file join $headless targets linux-x86_64 native libraven.so.0]
    file delete $target
    exec strip --strip-unneeded -o $target [file join [cffi::ravenDir] libraven.so.0]
    set b [pm package pack $headless -out [fresh out]]
    list [dict get $a status] [string match "*linux-x86_64: library raven needs libX11.so.6, which is neither linux-x86_64's platform nor a library this package declares*" [dict get $a out]] \
        [dict get $b status] [regexp {loader dependencies|needs|Rvulkan_get_instance} [dict get $b out]]
} -cleanup cleanup -result {1 1 1 1}

test pw-raven-deploy-relocates {the release's example test as a native executable: native deploy places the bundled libraven.so.0 in DIR/lib, the executable linked with -runtime-path '$ORIGIN/lib' runs after DIR is moved and the package is removed from the application (botlish remove), with no LD_LIBRARY_PATH and no display, and the loader resolves the deployed library} -constraints {ravenRun} -body {
    set repo [repository {raven}]
    set app [fresh app]
    pm add raven -project $app -repository $repo
    foreach file [glob -directory [file join $app .bot_modules raven examples clicks] *.bot] {
        file copy $file $app
    }
    set dist [file join [fresh dist] out]
    set d [pm native deploy -project $app -target linux-x86_64 -out $dist]
    set e [pm -emit-native-executable -runtime-path {$ORIGIN/lib} [file join $app test.bot]]
    file rename [file join $app test] [file join $dist test]
    set moved [file join [fresh moved] app]
    file rename $dist $moved
    set removed [pm remove raven -project $app]
    set run [withEnvironment [list LD_LIBRARY_PATH {} DISPLAY {}] {exec [file join $moved test]}]
    set resolved [lsearch -inline [split [withEnvironment [list LD_LIBRARY_PATH {}] {exec ldd [file join $moved test]}] \n] *libraven*]
    list [dict get $d status] [dict get $e status] [dict get $removed status] [file exists [file join $app .bot_modules raven]] \
        $run [string match "*=> $moved/lib/libraven.so.0 *" $resolved]
} -cleanup cleanup -result {0 0 0 0 {["2", "2 clicks", "0", "0 clicks"]} 1}

# PM-3: the releases are made by the generic authoring workflow.

test pw-native-metadata-derived {the repository's native packages state no native metadata of their own (packages/NAME/botlish.json: name, version, dependencies); every fact of a release's metadata was written by native add, native require and package stage from the built files and the recipe's statements} -constraints {ravenPackage} -body {
    set repo [repository {raven}]
    set source [pm::descriptor::read [file join $::projectRoot packages raven botlish.json] project]
    set release [pm::descriptor::fromBytes [dict get [pm::archive::read [file join $repo raven-0.3.2.botpkg]] descriptor] artifact X]
    set x64 [dict get $release targets linux-x86_64]
    set raven [lsearch -inline -index 1 [dict get $x64 libraries] raven]
    list [dict get $source schema] [dict exists $source targets] [dict get $release schema] \
        [lmap library [dict get $x64 libraries] {list [dict get $library name] [dict get $library origin]}] \
        [dict get [dict create {*}$raven] needs] [lmap d [dict get $x64 runtime] {list [dict get $d name] [dict get $d requirement] [dict get $d capability]}]
} -cleanup cleanup -result {1 0 3 {{raven_bridge bundled} {raven bundled} {X11 system}} {libm.so.6 libX11.so.6 libc.so.6 ld-linux-x86-64.so.2} {{vulkan capability desktop} {vulkan-driver capability desktop} {x11-display capability desktop} {x11-xcb optional {}} {dbus capability accessibility}}}

test pw-raven-runtime-dependencies {the Vulkan loader is a run-time dependency of the desktop capability, never a loader dependency: no bundled library needs it, the plan lists it apart from the link (with this host's candidate, and the driver as a facility no file names), and the plan is complete without it} -constraints {ravenPackage} -body {
    set repo [repository {raven}]
    set app [fresh app]
    set added [pm add raven -project $app -repository $repo]
    set plan [dict get [pm native plan -project $app] out]
    list [dict get $added status] [string match "*needs libm.so.6, libX11.so.6, libc.so.6, ld-linux-x86-64.so.2*" $plan] \
        [regexp {library vulkan \(libvulkan\.so\.1\): needed for "desktop" \(instance raven, opened by raven\)} $plan] \
        [string match "*facility vulkan-driver: needed for \"desktop\"*not a file: the package manager cannot verify it*" $plan] \
        [regexp {library dbus \(libdbus-1\.so\.3\): needed for "accessibility"} $plan] [string match "*problem:*" $plan]
} -cleanup cleanup -result {0 1 1 1 1 0}

test pw-raven-provenance {the release's provenance record describes exactly its artifact (package inspect -provenance), confirmed its two sources' Git trees from their files, names every native file's build, and holds no path of the machine that built it} -constraints {ravenPackage} -body {
    set repo [repository {raven}]
    set record [file join $repo raven-0.3.2.provenance.json]
    set r [pm package inspect [file join $repo raven-0.3.2.botpkg] -provenance $record]
    set text [pm::ReadBytes $record]
    list [dict get $r status] [string match "*describes this artifact*" [dict get $r out]] \
        [llength [regexp -all -inline {git-tree: confirmed} [dict get $r out]]] \
        [llength [regexp -all -inline {build raven desktop linux-[a-z0-9_]+ output targets/linux-[a-z0-9_]+/native/libraven.so.0: confirmed} [dict get $r out]]] \
        [regexp {"/(home|root|tmp)/} $text] [string match "*\$HOME*" $text]
} -cleanup cleanup -result {0 1 2 2 0 0}

test pw-raven-aarch64-runtime-search-path {the AArch64 libraven carries no run-time search path: raven 0.3.1's held the author machine's cache directory and an empty entry (the current directory), which made the release differ between machines; the native audit now refuses such a library} -constraints {ravenPackage} -body {
    set repo [repository {raven}]
    set files [dict get [pm::archive::read [file join $repo raven-0.3.2.botpkg]] files]
    lmap target {linux-aarch64 linux-x86_64} {
        set facts [pm::binary::inspect [dict get $files targets/$target/native/libraven.so.0]]
        list $target [dict get $facts runpath] [dict get $facts rpath]
    }
} -cleanup cleanup -result {{linux-aarch64 {} {}} {linux-x86_64 {} {}}}

# ---------------------------------------------------------------------------
# F. The Linux event loop's driver

test pw-event-loop-runs {examples/event-loop/native over the installed event_loop_linux package: the driver's archive came in the artifact, the application builds only its own ticker -- against the header whose directory native plan -include names -- and the program's five ticks are handled} -constraints {eventLoopRun} -body {
    set repo [repository {event_loop_linux}]
    set app [fresh app]
    foreach file {main.bot ticker.bot ticks.bot ticker.c} {
        file copy [file join $::projectRoot examples event-loop native $file] $app
    }
    set r [pm add event_loop_linux -project $app -repository $repo]
    set include [string trim [dict get [pm native plan -project $app -include] out]]
    exec cc -O2 -Wall -Wextra -Werror -fPIC -pthread $include -c [file join $app ticker.c] -o [file join $app ticker.o]
    exec ar rcs [file join $app libticker.a] [file join $app ticker.o]
    set value [lindex [outcomeUnderHir cranelift [hirOf [file join $app main.bot]]] 1]
    list [dict get $r status] [string map [list $app APP] $include] \
        [file isfile [file join $app {*}$::hostView event_loop_linux native libevent_loop_linux.a]] $value
} -cleanup cleanup -result {0 -IAPP/.bot_modules/.targets/linux-x86_64/event_loop_linux/include 1 {["t=1: tick 1", "t=2: tick 2", "t=3: tick 3", "t=4: tick 4", "t=5: tick 5", "t=5: handled 5 ticks, sum 15"]}}

test pw-release-ledger {one version, one artifact: packages/RELEASES.tsv records each release once (name, version, SHA-256); the author's tool says whether a build is the recorded release, and a build of a recorded version whose bytes differ is a CANDIDATE -- reported, and with -release refused, its file renamed so nothing takes it for the release} -constraints {eventLoopPackage} -body {
    set lines [lsearch -all -inline -not -regexp [split [pm::ReadBytes [file join $::projectRoot packages RELEASES.tsv]] \n] {^(#|$)}]
    set keys [lmap line $lines {lrange [split $line \t] 0 1}]
    set wellFormed [expr {[llength [lsort -unique $keys]] == [llength $keys]
        && [llength [lsearch -all -not -regexp $lines {^[a-z][a-z0-9_]*\t[0-9]+\.[0-9]+\.[0-9]+\t[0-9a-f]{64}$}]] == 0}]
    set out [fresh repo]
    set first [exec [info nameofexecutable] $::repositoryTool $out event_loop_linux 2>@1]
    regexp {sha256 ([0-9a-f]{64})} $first -> digest
    set ledger [file join [fresh ledger] RELEASES.tsv]
    writeText $ledger "event_loop_linux\t0.3.0\t$digest\n"
    set same [withEnvironment [list BOTLISH_RELEASE_LEDGER $ledger] {exec [info nameofexecutable] $::repositoryTool -release $out event_loop_linux 2>@1}]
    writeText $ledger "event_loop_linux\t0.3.0\t[string repeat 0 64]\n"
    set noted [withEnvironment [list BOTLISH_RELEASE_LEDGER $ledger] {exec [info nameofexecutable] $::repositoryTool $out event_loop_linux 2>@1}]
    set refused [withEnvironment [list BOTLISH_RELEASE_LEDGER $ledger] {catch {exec [info nameofexecutable] $::repositoryTool -release $out event_loop_linux 2>@1} message}]
    list $wellFormed [string match "*release: the recorded release of event_loop_linux 0.3.0*" $same] \
        [string match "*CANDIDATE: the recorded release of event_loop_linux 0.3.0 is sha256 0000*" $noted] \
        $refused [file exists [file join $out event_loop_linux-0.3.0.botpkg]] \
        [llength [glob -nocomplain -directory $out event_loop_linux-0.3.0.candidate-*.botpkg]]
} -cleanup cleanup -result {1 1 1 1 0 1}

test pw-event-loop-linux-only {the event loop's driver is Linux's (x86-64 and AArch64 archives in one release): preparing a Windows or macOS view is UNSUPPORTED} -constraints {eventLoopPackage} -body {
    set repo [repository {event_loop_linux}]
    set app [fresh app]
    pm add event_loop_linux -project $app -repository $repo
    lmap target {windows-x86_64 macos-aarch64 linux-aarch64} {
        set r [pm install -project $app -repository $repo -target $target]
        list $target [dict get $r status] [kindOf [dict get $r out]]
    }
} -cleanup cleanup -result {{windows-x86_64 1 UNSUPPORTED} {macos-aarch64 1 UNSUPPORTED} {linux-aarch64 0 {}}}

foreach dir [glob -nocomplain -directory [temporaryDirectory] pw-repo-[pid]-*] {
    file delete -force $dir
}
cleanupTests
