test mv-cow-evidence {items 61, 87, 93: natively a logical copy shares the backing (no element is copied: O(1)); the first write through a shared header detaches it once (O(N)); later writes through the now-unique header never copy again (amortized O(1) pushes). A vector a function builds in its own place and returns enters the caller's place without a copy (the function's result moves its header out)} -constraints nativeCoroutines -body {
    set copy "import mutable_vector\nfn ints() -> MutableVector\[int\]:\n    mutable_vector::from_list(\[\])\nfn fill(n: int) -> MutableVector\[int\]:\n    v = ints()\n    loop i from 0 to n:\n        v.push(i)\n    v\nfn f() -> int:\n    a = fill(1000)\n    b = a\n    a.push(1)\n    a.push(2)\n    a.push(3)\n    a.length() + b.length()\nf()\n"
    set unique "import mutable_vector\nfn ints() -> MutableVector\[int\]:\n    mutable_vector::from_list(\[\])\nfn f() -> int:\n    v = ints()\n    loop i from 0 to 1000:\n        v.push(i)\n    v.length()\nf()\n"
    set c [lindex [mvNative $copy] 1]
    set u [lindex [mvNative $unique] 1]
    list [mvAgree $copy] [dict get $c shares] [dict get $c detaches] [dict get $c detachElements] \
        [dict get $u shares] [dict get $u detaches] [dict get $u detachElements] [expr {[dict get $u growths] < 20}]
} -cleanup {unset -nocomplain copy unique c u} -result {{value 2003} 1 1 1000 0 0 0 1}

test mv-cow-fresh-results {item 39: a function's result moves its own place's header out (a mutated local or parameter dies with the call), so a call of a function whose every result is fresh enters the caller's place without a copy; a function that may return a vector some other place holds (an unmutated parameter, on one path) is copied, and the caller's vector never changes -- unless the caller passes the vector's last use, which moves it (MUTABLE-ARRAY.md, "Last uses and consumed parameters": the last `pick(true, a)` copies nothing)} -constraints nativeCoroutines -body {
    set pre "import mutable_vector\nfn ints() -> MutableVector\[int\]:\n    mutable_vector::from_list(\[\])\nfn build(n: int) -> MutableVector\[int\]:\n    v = ints()\n    loop i from 0 to n:\n        v.push(i)\n    v\nfn id(v: MutableVector\[int\]) -> MutableVector\[int\]:\n    v\nfn keep(v: MutableVector\[int\]) -> MutableVector\[int\]:\n    v.push(1)\n    v\nfn pick(c: bool, v: MutableVector\[int\]) -> MutableVector\[int\]:\n    w = build(2)\n    if c:\n        return w\n    v\n"
    lmap body {
        "w = build(5)\nw.push(9)\nw.length()\n"
        "a = build(3)\nw = id(a)\nw.push(9)\n\[a.length(), w.length()\]\n"
        "a = build(3)\nw = keep(a)\nw.push(9)\n\[a.length(), w.length()\]\n"
        "a = build(3)\nw = pick(false, a)\nw.push(9)\nx = pick(true, a)\nx.push(1)\n\[a.length(), w.length(), x.length()\]\n"
    } {
        set text "$pre[subst -nocommands -novariables $body]"
        set mv [lindex [mvNative $text] 1]
        list [mvAgree $text] [dict get $mv shares] [dict get $mv detaches] [dict get $mv detachElements]
    }
} -cleanup {unset -nocomplain pre text mv} -result {{{value 6} 0 0 0} {{value {[3, 4]}} 1 1 3} {{value {[3, 5]}} 1 1 3} {{value {[3, 4, 3]}} 2 1 3}}

test mv-cow-generic-results {item 39: a generic function's own body is typed imprecisely (its parameter is any-like), so returning its argument -- bare, or in an anonymous struct -- may return a vector some other place holds: its result is never fresh, and the caller's place copies it on entry; the argument never changes} -body {
    set pre "import mutable_vector\nfn v3() -> MutableVector\[int\]:\n    mutable_vector::from_list(\[1, 2, 3\])\nfn same(x):\n    x\nfn wrap(x):\n    {data: x}\n"
