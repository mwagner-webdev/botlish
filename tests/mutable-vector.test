# MUTABLE-ARRAY.md, "Last uses and consumed parameters": a directly called
# function's parameter is copied by its caller (or moved, at a last use), so
# the callee's own entry copy, the fresh-result rule and the affine check of
# a share now only matter for a function that is also used as a value and
# called indirectly -- which this test does for each.
test mv-cow-indirect-callee {items 39, 41: a function also passed as a value (so its caller cannot copy for it) copies its mutated parameter on entry, a result it may return unmutated is copied by the caller, and an affine vector entering it moves -- the caller's vector never changes, and no affine vector is ever shared or detached} -constraints nativeCoroutines -body {
    set pre "${mvDecls}fn v3() -> MutableVector\[int\]:\n    mutable_vector::from_list(\[1, 2, 3\])\n"
    set q "MutableVector\[Coroutine{args: \[Command\], return: Event}\]"
    set grow "${pre}fn grow(xs: MutableVector\[int\]) -> int:\n    xs.push(9)\n    xs.length()\nfn apply(g: Fn{args: \[MutableVector\[int\]\], return: int}, v: MutableVector\[int\]) -> int:\n    g(v)\nfn f() -> List\[int\]:\n    a = v3()\n    n = apply(grow, a)\n    m = grow(a)\n    \[a.length(), n, m\]\nf()\n"
    set pick "${pre}fn pick(c: bool, x: MutableVector\[int\]) -> MutableVector\[int\]:\n    if c:\n        return v3()\n    x\nfn via(g: Fn{args: \[bool, MutableVector\[int\]\], return: MutableVector\[int\]}, v: MutableVector\[int\]) -> int:\n    g(true, v).length()\nfn f() -> List\[int\]:\n    a = v3()\n    b = pick(false, a)\n    b.push(7)\n    n = via(pick, a)\n    \[a.length(), b.length(), n\]\nf()\n"
    set hire "${pre}fn hire(q: $q) -> $q:\n    q.push(make(5))\n    q\nfn via(g: Fn{args: \[$q\], return: $q}, q: $q) -> $q:\n    g(q)\nfn f() -> int:\n    q = mutable_vector::from_list(\[make(1), make(2)\])\n    r = via(hire, q)\n    r.length()\nf()\n"
    set mv [lindex [mvNative $hire] 1]
