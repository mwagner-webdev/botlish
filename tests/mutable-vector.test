# HIR evidence (items 53, 54, 75)

test mv-hir-evidence {item 75: HIR text distinguishes an observation, a mutation of a place (its root binding and field path), an affine element moved in (`move`), moved out (`move-out`), a consuming loop, a logical copy (mutable_vector#share), and the drops (`release=`); it reads back to the same text} -body {
    set text "${mvPlainDecls}struct State:\n    queue: MutableVector\[Coroutine{args: \[Command\], return: Event}\]\nfn f() -> int errors IndexNotFound:\n    s = State {queue: empty_queue()}\n    s.queue.push(make(1))\n    q = mutable_vector::from_list(\[make(2)\])\n    coroutine {step} = worker(3)\n    q.push(step)\n    a = q.pop()\n    n = q.length()\n    xs = loop t in q:\n        1\n    v = mutable_vector::from_list(\[1\])\n    w = v\n    w.push(2)\n    n + v.length() - 1\nr = f():\n    on IndexNotFound:\n        0\nr\n"
    set hir [surface::compile $text -warnings off]
    set formatted [hir::format $hir]
    set flags {}
    foreach line [split $formatted \n] {
        foreach pattern {{call native\(mutable_vector::[a-z?_]+\)} {call native\(mutable_vector#[a-z_]+\)} {vector=[a-z]+} {place=[b0-9.a-z]+} {move-out} {listloop s[0-9]+ \([^)]*\) : \S+ consuming} {const str h\M}} {
            if {[regexp $pattern $line match]} {
                lappend flags [regsub -all {b[0-9]+} [regsub {s[0-9]+} $match {S}] B]
            }
        }
    }
    list [lsort -unique $flags] [expr {[hir::format [hir::parse $formatted]] eq $formatted}]
} -cleanup {unset -nocomplain text hir formatted flags line pattern match} -result {{{call native(mutable_vector#share)} {call native(mutable_vector::from_list)} {call native(mutable_vector::length)} {call native(mutable_vector::pop)} {call native(mutable_vector::push)} {const str h} {listloop S (B t) : List[int] consuming} move-out place=B place=B.queue vector=mutate vector=observe} 1}

test mv-hir-type-roundtrip {item 74: the MutableVector type and the elaborated operations read back from HIR text unchanged} -body {
    set hir [surface::compile "import mutable_vector\nfn f(v: MutableVector\[MutableVector\[str\]\]) -> int:\n    v.push(mutable_vector::from_list(\[\"a0\"\]))\n    v.length()\nf(mutable_vector::from_list(\[\]))\n" -warnings off]
