} -cleanup {unset -nocomplain pre q grow pick hire mv} -result {{value {[3, 4, 4]}} {value {[3, 4, 3]}} {value 3} 0 0}

# An argument the elaboration hands over uncopied because its callee only
# reads it (an observed parameter, a native's observing role, a collection
# operation's receiver) is read when the call runs -- after the call's later
# arguments. hir/mutvec.tcl's ByReference: a later argument that would move
# the same header into a mutating callee copies instead (NoLaterUse counts
# the earlier argument as a later use), and one that mutates the same place
# (or, for a context member, calls anything) makes the earlier argument a
# copy (WrittenLater). A place receiver is never copied; later arguments
# that only read cost no copy.
set mvByRefDecls {import mutable_vector

context struct Counts:
    values: MutableVector[int]

fn grow1(a: MutableVector[int], x: int) -> int:
    a.push(x)
    a.length()

fn obs2(a: MutableVector[int], n: int) -> int:
    a.length() * 10 + n

fn pop1(v: MutableVector[int]) -> int errors IndexNotFound:
    v.pop()

fn items(v: MutableVector[int]) -> List[int]:
    loop x in v:
        x

fn bump(context c: Counts) -> int:
    c.values.push(1)
    1

}

# The number of logical copies (mutable_vector#share calls) the elaboration
# wrote into TEXT's HIR.
proc mvShares {text} {
    set hir [surface::compile $text -warnings off]
    set n 0
    dict for {e node} [dict get $hir exprs] {
        if {[dict get $node kind] eq "call" && [hir::affine::NativeName $hir $e] eq "mutable_vector#share"} {
            incr n
        }
    }
    return $n
}

test mv-cow-by-reference-arguments {an argument handed over uncopied for a callee that only reads it sees the value it had when it was evaluated, whatever a later argument of the same call does: moves the same vector into a mutating function (observed parameter, receiver), pops it in place (observed parameter, receiver), or -- a context member -- calls a function that mutates the member; a mutating receiver stays the place (its update is kept); later arguments that only read copy nothing} -body {
    lmap case {
        {fn f() -> int:
    v = mutable_vector::from_list([1, 2])
    obs2(v, grow1(v, 5))
f()
}
        {fn f() -> int errors IndexNotFound:
    v = mutable_vector::from_list([7, 8, 9])
    v.at(pop1(v) - 7)
r = f():
    on IndexNotFound:
        -1
r
}
        {fn f() -> int errors IndexNotFound:
    v = mutable_vector::from_list([1, 2])
    obs2(v, v.pop())
r = f():
    on IndexNotFound:
        -1
r
}
        {fn f() -> int errors IndexNotFound:
    v = mutable_vector::from_list([7, 8, 9])
    v.at(v.pop() - 7)
r = f():
    on IndexNotFound:
        -1
r
}
        {fn f() -> List[int] errors IndexNotFound:
    v = mutable_vector::from_list([1, 2])
    v.push(v.pop() + 10)
    items(v)
r = f():
    on IndexNotFound:
        []
r
}
        {fn f(context c: Counts) -> int errors IndexNotFound:
    mutable_vector::at(c.values, bump())
with context Counts {values: mutable_vector::from_list([5])}
r = f():
    on IndexNotFound:
        -1
r
}
        {fn f() -> List[int] errors IndexNotFound:
    v = mutable_vector::from_list([1, 2, 3])
    x = v.at(v.length() - 1)
    v.push(obs2(v, v.length()))
    v.push(x)
    items(v)
r = f():
    on IndexNotFound:
        []
r
}
    } {
        set text "${::mvByRefDecls}${case}"
        list [mvAgree $text] [mvShares $text]
    }
} -cleanup {unset -nocomplain case text} -result {{{value 23} 1} {{value 9} 1} {{value 22} 1} {{value 9} 1} {{value {[1, 12]}} 0} {{value -1} 2} {{value {[1, 2, 3, 33, 3]}} 0}}

# A yield in a later argument suspends the coroutine, and its resumer runs
# until it resumes it: it may mutate the installed context in place, as a
# called function may (hir/mutvec.tcl's MayRunCode).
set mvYieldDecls {import mutable_vector

struct Ev:
    n: int

struct Msg:
    i: int

context struct Counts:
    values: MutableVector[int]

fn replace(x: int, context c: Counts) -> int:
    old = c.values.pop():
        on IndexNotFound:
            -1
    c.values.push(x)
    old

fn id(x: int) -> int:
    x

}

test mv-cow-by-reference-yield {a context member handed over by reference to a native is read as it was when evaluated although a later argument yields and the resumer replaces the member meanwhile -- the yield bare or inside a call; a local vector, which no resumer can reach, is still handed over uncopied -- on every backend, with the copies the elaboration wrote} -constraints nativeCoroutines -body {
    lmap case {
        {fn w(context c: Counts, resume Msg) -> Ev:
    x = mutable_vector::at(c.values, (yield Ev {n: c.values.length()}).i):
        on IndexNotFound:
            -1
    Ev {n: x}
with context Counts {values: mutable_vector::from_list([5])}
coroutine {step, first} = w()
old = replace(9)
r = step(Msg {i: 0})
[first.n, old, r.n]
}
        {fn w(context c: Counts, resume Msg) -> Ev:
    x = mutable_vector::at(c.values, id((yield Ev {n: c.values.length()}).i)):
        on IndexNotFound:
            -1
    Ev {n: x}
with context Counts {values: mutable_vector::from_list([5])}
coroutine {step, first} = w()
old = replace(9)
r = step(Msg {i: 0})
[first.n, old, r.n]
}
        {fn w(resume Msg) -> Ev:
    v = mutable_vector::from_list([5])
    x = mutable_vector::at(v, (yield Ev {n: v.length()}).i):
        on IndexNotFound:
            -1
    Ev {n: x}
coroutine {step, first} = w()
r = step(Msg {i: 0})
[first.n, r.n]
}
    } {
        set text "${::mvYieldDecls}${case}"
        list [mvAgree $text] [mvShares $text]
    }
} -cleanup {unset -nocomplain case text} -result {{{value {[1, 5, 5]}} 2} {{value {[1, 5, 5]}} 2} {{value {[1, 5]}} 0}}

# A handler's payload binding (`on E details:`) is a parameter of the
# handler's branch: a place root among them is entered by a logical copy
# of the payload (hir/mutvec.tcl's EntryRename), like a function's
# parameter -- the payload may hold a header its raiser's caller still owns.
set mvPayloadDecls {import mutable_vector

error Full:
    items: MutableVector[int]

fn g(v: MutableVector[int], n: int) -> int errors Full:
    if n > 0:
        fail Full {items: v}
    0

}

test mv-payload-entry-copy {a handler that mutates its payload binding's vector mutates its own copy: the vector the raiser put in the payload, still its caller's, never changes -- named (`on Full details:`) as destructured (`on Full {items}:`), also when the caller's vector is a place itself; a handler that only reads its payload copies nothing; the HIR text with the entry reads back -- on every backend} -body {
    set cases {
        {fn f():
    p = mutable_vector::from_list([1])
    r = g(p, p.length()):
        on Full details:
            details.items.push(9)
            details.items.length()
    q = mutable_vector::from_list([1])
    s = g(q, q.length()):
        on Full {items}:
            items.push(9)
            items.length()
    [r, p.length(), s, q.length()]
}
        {fn f():
    p = mutable_vector::from_list([1])
    p.push(5)
    r = g(p, p.length()):
        on Full details:
            details.items.push(9)
            details.items.push(10)
            details.items.length()
    [r, p.length()]
}
        {fn f():
    p = mutable_vector::from_list([1])
    r = g(p, p.length()):
        on Full details:
            details.items.length()
    [r, p.length()]
}
    }
    set results [lmap case $cases {
        set text "${::mvPayloadDecls}${case}f()\n"
        list [mvAgree $text] [mvShares $text]
    }]
    set formatted [hir::format [surface::compile "${mvPayloadDecls}[lindex $cases 0]f()\n" -warnings off]]
    lappend results [expr {[hir::format [hir::parse $formatted]] eq $formatted}]
} -cleanup {unset -nocomplain cases case text results formatted} -result {{{value {[2, 1, 2, 1]}} 2} {{value {[4, 2]}} 2} {{value {[1, 1]}} 0} 1}

# Last uses per path (hir/mutvec.tcl's NoLaterUse and ReadsPath): a read-out
# of a place path moves its header on when no later use may read a header
# at that path -- the path itself, a prefix of it (the binding, an
# enclosing struct field) or an extension of it holding one -- in any later
# statement, later operand (arguments left to right, struct literal fields
# in written order), branch after a condition, handler after a handled call
# or later iteration of a loop the binding is not bound inside. A use of a
# disjoint path (a sibling field) or of an extension holding no header (an
# Int field) does not count; a context parameter's path never moves.
set mvPathDecls {import mutable_vector

error Boom

struct T:
    keys: MutableVector[int]
    vals: MutableVector[int]
    count: int

struct N:
    inner: T
    tag: int

struct Two:
    a: MutableVector[int]
    t: T

struct Put:
    old: int
    table: T

fn table() -> T:
    T {keys: mutable_vector::from_list([1]), vals: mutable_vector::from_list([2]), count: 0}

fn spend(a: MutableVector[int], x: int) -> int errors Boom:
    a.push(x)
    if x > 50:
        fail Boom
    a.length()

fn grow1(a: MutableVector[int], x: int) -> int:
    a.push(x)
    a.length()

fn pair(a: MutableVector[int], b: MutableVector[int]) -> int:
    a.push(3)
    b.push(4)
    b.push(4)
    a.length() * 10 + b.length()

fn bump_all(t: T, c: int) -> T:
    t.keys.push(50)
    t.vals.push(60)
    T {keys: t.keys, vals: t.vals, count: c}

}

test mv-path-last-use-semantics {a read-out of a place path is copied while a later use may read its header -- the binding itself, the same path, a vector-bearing extension, in a later statement, a later argument or struct literal field, a branch, a handler or the next iteration of a loop -- so the copy stays independent; it moves (no copy) when only disjoint or Int paths are read after it; a context member never moves. On every backend, with the copies the elaboration wrote} -body {
    lmap case {
        {fn f():
    t = table()
    t.vals.push(5)
    u = T {keys: t.keys, vals: t.vals, count: 0}
    u.keys.push(9)
    u.vals.push(9)
    w = t
    [w.keys.length(), w.vals.length(), u.keys.length(), u.vals.length()]
}
        {fn f():
    t = table()
    t.vals.push(5)
    u = T {keys: t.keys, vals: t.vals, count: 0}
    u.keys.push(9)
    u.vals.push(9)
    [t.keys.length(), u.keys.length(), u.vals.length()]
}
        {fn f():
    n = N {inner: table(), tag: 4}
    n.inner.vals.push(5)
    u = n.inner
    u.keys.push(9)
    [n.inner.keys.length(), u.keys.length(), n.inner.count, n.tag]
}
        {fn f():
    n = N {inner: table(), tag: 4}
    n.inner.vals.push(5)
    u = n.inner
    u.keys.push(9)
    [u.keys.length(), u.vals.length(), n.inner.count, n.tag]
}
        {fn g(x: int) -> int:
    t = table()
    t.vals.push(x)
    r = spend(t.keys, x):
        on Boom:
            t.keys.length()
    r
