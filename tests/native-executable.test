# Standalone AOT executables: CLI, parity, relocation, runtime roots and errors.
source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]

proc aotParity {text {options {}}} {
    regsub -all -line {^        } $text {} text
    set text [string map [list @NUL@ \x00] $text]
    set dir [makeDirectory {aot executable test}]
    set path [file join $dir {program with spaces.bot}]
    set channel [open $path w]
    fconfigure $channel -encoding utf-8 -translation lf
    puts $channel $text
    close $channel
    try {
        set hir [surface::readProgramFile $path]
        set expected {}
        foreach backend {interp compile cranelift-generic cranelift} {
            set outcome [outcomeUnderHir $backend $hir]
            if {[lindex $outcome 0] ne "value"} { error "$backend: $outcome" }
            lappend expected [lindex $outcome 1]
        }
        if {$options eq ""} {
            exec [info nameofexecutable] [file join $::projectRoot main.tcl] -emit-native-executable $path
        } else {
            native::executable $hir [file rootname $path] {*}$options
        }
        set header [binaryHeader [native::executableFile [file rootname $path]]]
        if {$header ne [hostBinaryHeader executable]} { error "output is $header, not [hostBinaryHeader executable]" }
        # Moving the executable and removing the input leaves a runnable
        # binary. Empty PATH also excludes compiler/interpreter launchers.
        set relocated [file join $dir relocated]
        file rename [native::executableFile [file rootname $path]] [native::executableFile $relocated]
        file delete $path
        lappend expected [runStandalone $relocated]
        lappend expected [runStandalone $relocated BOTLISH_NATIVE_GC_STRESS 1]
        if {[llength [lsort -unique $expected]] != 1} { error "values disagree: $expected" }
        return [lindex $expected 0]
    } finally {
        removeDirectory {aot executable test}
    }
}

test native-executable-values {constants, Unicode, native values, nested aggregates and big integers match every mode} -constraints executableAot -body {
    aotParity {
        import immutable_set
        import str
        big = 9223372036854775808
        [big * big, "a@NUL@é🙂\n\t\\\"", '🙂', true, unit, [1, [2, 3]],
         immutable_set::from_list([3, 2, 3]), str::length]
    }
} -match glob -result {\[85070591730234615865843651857942052864, *\]}

test native-executable-empty-shape {a shape with no fields (the empty anonymous struct) gets a typed field list in the startup code (its untyped empty vec! did not compile)} -constraints executableAot -body {
    aotParity {
        e = {}
        [e, {a: 1}, e == {}]
    }
} -result {[{}, {a: 1}, true]}

test native-executable-roots {relocated stack maps keep allocating ancestor frames alive under GC stress} -constraints executableAot -body {
    aotParity {
        import str
        fn build(n):
            if n < 1:
                return ""
            prefix = str::concat("x", "y")
            str::concat(prefix, build(n - 1))
        build(100)
    }
} -result "\"[string repeat xy 100]\""

test native-executable-closure {escaping closures initialize generic function addresses and capture values} -constraints executableAot -body {
    aotParity {
        fn make_adder(x: int):
            fn add(y: int):
                x + y
            add
        add10 = make_adder(10)
        add10(32)
    }
} -result 42

test native-executable-modules {module statics, sets, strings and specialized companion entries survive GC} -constraints executableAot -body {
    aotParity {
        import web
        import type byte::Byte
        fn check(b: Byte) -> bool:
            web::is_unreserved(b)
        [check(45), check(32), web::uri_escape_text("a b/é🙂")]
    }
} -result {[true, false, "a%20b%2F%C3%A9%F0%9F%99%82"]}

# The callable is chosen at run time: with a statically exact target
# (EXACT-CALLABLE-CLOSED-CALLER.md) the call through `f` is direct and never
# enters a generic trampoline, which is what this test exists to cover.
test native-executable-generic-entry {known callable kinds can call through generic trampolines under GC} -constraints executableAot -body {
    aotParity {
        import str
        fn build():
            str::concat("x", "y")
        fn other():
            str::concat("z", "w")
        fn pick(flag: bool):
            if flag:
                build
            else:
                other
        fn apply(f):
            prefix = str::concat("a", "b")
            [prefix, f()]
        [apply(pick(true)), apply(pick(false))]
    } {-block-escape-opt 0 -tiny-leaf-inline-opt 0}
} -result {[["ab", "xy"], ["ab", "zw"]]}

test native-executable-source-refinements {source refinements and their proof-producing predicates share existing modules and preserve declared contracts in an executable} -constraints executableAot -body {
    aotParity {
        import byte
        import str
        import web
        q = web::uri_escape_text("a b")
        fn check(s: str) -> bool:
            web::emailish?(s)
        [web::uri_query_value?(q), str::length(q), check("a@b.co"), byte::high_nibble(171)]
    }
} -result {[true, 5, true, 160]}

test native-executable-native-shadow {native preparation respects local binding identity} -constraints executableAot -body {
    set dir [makeDirectory {aot shadow test}]
    try {
        set hir [surface::compile "import str\nfn integer?(s):\n    str::length(s)\ninteger?(\"abc\")" shadow.bot]
        set prepared [native::prepareHir $hir]
        set binary [native::executable $hir [file join $dir program]]
        list [expr {$hir eq $prepared}] [exec $binary]
    } finally {
        removeDirectory {aot shadow test}
    }
} -result {1 3}

test native-executable-output-kinds {standalone rendering supports blocks, mutable arrays and Result values without a Tcl host} -constraints executableAot -body {
    set dir [makeDirectory {aot output test}]
    try {
        set hir [hir::build {
            {call {ref list} {ok {const 5}} {error-value {const str bad}}
                {block {x} {ref x}} {call {ref mutable_array::allocate} {const 2}}}
        }]
        set binary [native::executable $hir [file join $dir program]]
        runStandalone $binary BOTLISH_NATIVE_GC_STRESS 1
    } finally {
        removeDirectory {aot output test}
    }
} -result {[ok(5), error("bad"), <block (x)>, <mutable-array [unit, unit]>]}

test native-executable-link-failure {a failed linker invocation preserves the old file and removes temporary artifacts} -constraints {executableAot rustcLinker} -body {
    set dir [makeDirectory {aot link failure test}]
    set saved [expr {[info exists ::env(RUSTC)] ? [list $::env(RUSTC)] : {}}]
    set channel [open [native::executableFile [file join $dir program]] w]; puts -nonewline $channel previous; close $channel
    try {
        set ::env(RUSTC) /no/such/rustc
        set failed [catch {native::executable [surface::compile 42 t.bot] [file join $dir program]} message options]
        set channel [open [native::executableFile [file join $dir program]] r]; set old [read $channel]; close $channel
        list $failed [dict get $options -errorcode] $old [glob -nocomplain -directory $dir .botlish-aot-*]
    } finally {
        unset ::env(RUSTC)
        if {$saved ne {}} { set ::env(RUSTC) [lindex $saved 0] }
        removeDirectory {aot link failure test}
    }
} -result {1 {NATIVE AOT} previous {}}

test native-executable-reject {guarded and open workloads fail before writing an executable} -constraints executableAot -body {
    set dir [makeDirectory {aot reject test}]
    set output [file join $dir program]
    set ch [open [native::executableFile $output] w]; puts -nonewline $ch previous; close $ch
    try {
        set results {}
        foreach input {examples/surface/03-closure.bot lib/mathish.bot} {
            set hir [surface::readProgramFile [file join $::projectRoot $input]]
            lappend results [catch {native::executable $hir $output} message options]
            lappend results [dict get $options -errorcode]
        }
        set ch [open [native::executableFile $output] r]; lappend results [read $ch]; close $ch
        set results
    } finally {
        removeDirectory {aot reject test}
    }
} -result {1 {NATIVE AOT NOT-READY} 1 {NATIVE AOT NOT-READY} previous}

test native-executable-no-evaluation {compilation terminates even when running the program would loop forever} -constraints executableAot -body {
    set dir [makeDirectory {aot loop test}]
    try {
        set hir [surface::compile "loop:\n    continue" loop.bot]
        file executable [native::executable $hir [file join $dir program]]
    } finally {
        removeDirectory {aot loop test}
    }
} -result 1

# (A slice past the end is no longer a run-time RANGE: it is the declared
# UpperOverrun, which a program must handle and a literal one is a
# compile-time KNOWN-ERROR. An impossible allocation is still RANGE.)
test native-executable-runtime-error {runtime errors exit unsuccessfully and go to stderr} -constraints executableAot -body {
    set dir [makeDirectory {aot error test}]
    try {
        set hir [surface::compile {import mutable_array
mutable_array::allocate(0 - 1)} error.bot]
        set binary [native::executable $hir [file join $dir program]]
        set failed [catch {exec $binary 2> [file join $dir stderr]} stdout options]
        set ch [open [file join $dir stderr] r]; set stderr [read $ch]; close $ch
        list $failed [lindex [dict get $options -errorcode] 2] [string match {*CORE SEMANTIC RANGE*} $stderr]
    } finally {
        removeDirectory {aot error test}
    }
} -result {1 1 1}

# {STATUS STDOUT STDERR} of running the command ARGS, its standard output
# and error captured apart in DIR; STATUS is the exit status, or "signal
# NAME" for a process a signal killed.
proc processOutcome {dir args} {
    set out [file join $dir stdout]
    set err [file join $dir stderr]
    set code [catch {exec {*}$args > $out 2> $err} message options]
    set texts {}
    foreach path [list $out $err] {
        set channel [open $path r]
        lappend texts [read $channel]
        close $channel
    }
    if {$code == 0} {
        return [list 0 {*}$texts]
    }
    set errorCode [dict get $options -errorcode]
    switch -- [lindex $errorCode 0] {
        CHILDSTATUS { return [list [lindex $errorCode 2] {*}$texts] }
        CHILDKILLED { return [list "signal [lindex $errorCode 2]" {*}$texts] }
        default { return [list "cannot run: $message" {*}$texts] }
    }
}

# Exhausting a stack in a standalone executable -- the thread's (the NIR
# fixture's tiny frames on a 4 MiB stack, a source recursion on 16 MiB and on
# the default 1 GiB) or a coroutine's -- ends the process with exit status 1
# and exactly the guard's NATIVE LIMIT STACK line on standard error, nothing
# on standard output and no signal (NATIVE-STACK-OVERFLOW.md,
# MACOS-AARCH64-MILESTONE-4.md); a deep recursion that fits returns its
# value. On a host with the guard and native coroutines only (on Windows
# there is neither yet: tests/platform/aot-facts.tcl records what a Windows
# executable's exhausted stack does).
test native-executable-stack-overflow {standalone stack exhaustion, of the thread's stack or a coroutine's, is the NATIVE LIMIT STACK line on standard error and exit status 1, never a signal; a deep finite recursion returns its value} -constraints {executableAot nativeStackGuard nativeCoroutines} -body {
    set dir [makeDirectory {aot stack test}]
    try {
        set binary [file join $dir program]
        native::Driver executable [core::ReadFile [file join $::projectRoot native tests fixtures stack_overflow.ir]] $binary
        set results [list [processOutcome $dir env BOTLISH_NATIVE_STACK_BYTES=4194304 $binary]]
        set down "fn down(n: int) -> int:\n    if n == 0:\n        return 0\n\n    1 + down(n - 1)\n\n"
        native::executable [surface::compile "${down}down(100000000)" down.bot] [file join $dir down]
        lappend results [processOutcome $dir env BOTLISH_NATIVE_STACK_BYTES=16777216 [file join $dir down]]
        lappend results [processOutcome $dir [file join $dir down]]
        native::executable [surface::compile "${down}struct Event:\n    value: int\n\nfn worker(depth: int) -> Event:\n    yield Event {value: 0}\n    return Event {value: down(depth)}\n\ncoroutine {step, first} = worker(100000000)\nstep().value\n" co.bot] [file join $dir co]
        lappend results [processOutcome $dir [file join $dir co]]
        native::executable [surface::compile "${down}down(100000)" finite.bot] [file join $dir finite]
        lappend results [processOutcome $dir [file join $dir finite]]
        join $results \n
    } finally {
        removeDirectory {aot stack test}
    }
} -result [join [list {*}[lrepeat 4 [list 1 {} "error {NATIVE LIMIT STACK} {native stack exhausted: too many nested calls}\n"]] [list 0 "100000\n" {}]] \n]

# The format, architecture and kind of a program object and of an executable
# are the host target's (ELF on Linux, Mach-O on macOS, COFF and PE on
# Windows), read from their headers; tests/platform/aot-facts.tcl checks the
# same files with the host's own tools. The executable is the file
# native::executable returns (program.exe on Windows).
test native-executable-format {a program object and a standalone executable are the host target's object format and architecture} -constraints executableAot -body {
    set dir [makeDirectory {aot format test}]
    try {
        set hir [surface::compile "fn twice(n: int) -> int:\n    n * 2\n\ntwice(21)" format.bot]
        native::object $hir [file join $dir program.o]
        set binary [native::executable $hir [file join $dir program]]
        list [expr {[binaryHeader [file join $dir program.o]] eq [hostBinaryHeader object]}] \
            [expr {[binaryHeader $binary] eq [hostBinaryHeader executable]}] \
            [file executable $binary] [exec $binary] [expr {$binary eq [native::executableFile [file join $dir program]]}]
    } finally {
        removeDirectory {aot format test}
    }
} -result {1 1 1 42 1}

# Coroutines in a standalone executable: a yield three calls deep resumed
# with a message, a String made before the first yield and used after the
# last, a coroutine whose body drives another, a declared error crossing the
# resume that ran the failing segment, and many short coroutines each
# holding a fresh String across its yield -- the values every in-process
# backend computes, under GC stress too (aotParity).
test native-executable-coroutines {coroutines -- nested suspension, messages, values held across yields, a coroutine driving another, an error out of a resume, many short ones -- run in an executable as in every in-process backend, under GC stress too} -constraints {executableAot nativeCoroutines} -body {
    aotParity {
        import list
        import str
        struct Message:
            value: int
        struct Event:
            text: str
            value: int
        error Boom
        fn deepest(resume Message) -> int:
            m = yield Event {text: "deep", value: 1}
            m.value * 2
        fn middle() -> int:
            deepest() + 1
        fn worker(prefix: str) -> Event:
            held = prefix.concat("-held")
            x = middle()
            m = yield Event {text: held, value: x}
            return Event {text: held.concat("!"), value: m.value}
        fn inner(n: int) -> Event:
            yield Event {text: "inner", value: n}
            return Event {text: "inner-done", value: n + 1}
        fn outer() -> Event:
            coroutine {step, first} = inner(5)
            yield first
            return step()
        fn failing() -> Event errors Boom:
            yield Event {text: "before", value: 0}
            fail Boom
        fn counter(n: int) -> Event:
            s = "c".concat("x")
            yield Event {text: s, value: n}
            return Event {text: s.concat("y"), value: n + 1}
        fn churn(n: int) -> int:
            coroutine {step, first} = counter(n)
            last = step()
            first.value + last.text.length()
        coroutine {step, first} = worker("p")
        second = step(Message {value: 20})
        third = step(Message {value: 7})
        coroutine {step: o, first: of} = outer()
        ol = o()
        fn run_failing() -> List[str] errors Boom:
            coroutine {step: f, first: ff} = failing()
            caught = f():
                on Boom:
                    Event {text: "caught", value: -1}
            [ff.text, caught.text]
        failed = run_failing():
            on Boom:
                ["construction", "failed"]
        churned = loop i from 0 to 300:
            churn(i)
        [first.text, first.value, second.text, second.value, third.text, third.value,
         of.text, ol.text, ol.value, failed, list::length(churned), churned.get(299, 0)]
    }
} -result {["deep", 1, "p-held", 41, "p-held!", 7, "inner", "inner-done", 6, ["before", "caught"], 300, 302]}

# main.tcl -emit-native-executable as a person types it: the input named by
# a relative path from another directory or by an absolute one, directories
# with spaces, the host's default target or the host's own named with
# -target (one HIR records it: it imports ffi::c), either native backend's
# command line (one executable: closed and specialized either way). The
# executable is the input's path without its extension; another operating
# system's target of the host's architecture is refused (NATIVE TARGET)
# before anything is written.
test native-executable-cli-paths {main.tcl writes the executable beside its input from a relative or an absolute path, for the default and the explicit host target, and refuses another target without writing anything} -constraints executableAot -body {
    set dir [makeDirectory {aot cli test}]
    try {
        set app [file join $dir {app dir}]
        set elsewhere [file join $dir {else where}]
        file mkdir $app $elsewhere
        set source "import ffi::c\n\nfn twice(x: ffi::c::Int) -> int:\n    x * 2\n\ntwice(21)\n"
        foreach name {relative absolute explicit generic other} {
            set channel [open [file join $app $name.bot] w]
            puts -nonewline $channel $source
            close $channel
        }
        set host [core::cabi::hostTarget]
        set other [expr {[string match linux-* $host] ? "macos" : "linux"}]-[core::cabi::hostArchitecture]
        set main [list [info nameofexecutable] [file join $::projectRoot main.tcl] -warnings off]
        # ARGS run in the directory CWD (this process's own, restored: no
        # shell, so on any host).
        set in {apply {{cwd args} {
            set here [pwd]
            cd $cwd
            try { exec {*}$args 2>@1 } finally { cd $here }
        }}}
        set results {}
        lappend results [{*}$in $elsewhere {*}$main -emit-native-executable "../app dir/relative.bot"]
        lappend results [{*}$in $elsewhere {*}$main -emit-native-executable [file join $app absolute.bot]]
        lappend results [{*}$in $elsewhere {*}$main -target $host -emit-native-executable [file join $app explicit.bot]]
        lappend results [{*}$in $elsewhere {*}$main -backend cranelift-generic -emit-native-executable [file join $app generic.bot]]
        foreach name {relative absolute explicit generic} {
            set binary [native::executableFile [file join $app $name]]
            lappend results [file executable $binary] [expr {[binaryHeader $binary] eq [hostBinaryHeader executable]}] [exec $binary]
        }
        set refused [catch {{*}$in $elsewhere {*}$main -target $other -emit-native-executable [file join $app other.bot]} message]
        lappend results $refused [string match "*(NATIVE TARGET)*" $message] [file exists [native::executableFile [file join $app other]]]
        string map [list $app APP] [join $results \n]
    } finally {
        removeDirectory {aot cli test}
    }
} -result "executable: [native::executableFile {../app dir/relative}]
executable: [native::executableFile APP/absolute]
executable: [native::executableFile APP/explicit]
executable: [native::executableFile APP/generic]
1
1
42
1
1
42
1
1
42
1
1
42
1
1
0"

# A link the platform linker rejects (rustc made to pass it an object file
# that does not exist) fails with the linker's own words -- a line naming the
# missing file that is not rustc's echo of the command line -- keeps the
# previous executable and leaves no temporary directory. The wrapper is a
# shell script (unixShell); the Windows linker's words are the driver's unit
# test's (codegen/aot.rs, ffi_linker_diagnostics_keep_the_linkers_words).
test native-executable-linker-diagnostics {a link the platform linker rejects reports the linker's own words, keeps the previous file and removes the temporary directory} -constraints {executableAot rustcLinker unixShell} -body {
    set dir [makeDirectory {aot linker test}]
    set saved [expr {[info exists ::env(RUSTC)] ? [list $::env(RUSTC)] : {}}]
    set wrapper [file join $dir rustc-wrapper]
    set channel [open $wrapper w]
    puts $channel "#!/bin/sh\nexec \"\$REAL_RUSTC\" -C \"link-arg=$dir/missing object.o\" \"\$@\""
    close $channel
    file attributes $wrapper -permissions 0755
    set channel [open [file join $dir program] w]; puts -nonewline $channel previous; close $channel
    try {
        set ::env(REAL_RUSTC) [expr {$saved ne {} ? [lindex $saved 0] : "rustc"}]
        set ::env(RUSTC) $wrapper
        set failed [catch {native::executable [surface::compile 42 t.bot] [file join $dir program]} message options]
        set channel [open [file join $dir program] r]; set old [read $channel]; close $channel
        set linkerLines [lmap line [split $message \n] {
            expr {[string match "*missing object.o*" $line] && ![string match {*"cc"*} $line] ? $line : [continue]}
        }]
        list $failed [dict get $options -errorcode] [string match "executable link failed (*" $message] \
            [expr {[llength $linkerLines] > 0}] $old [glob -nocomplain -directory $dir .botlish-aot-*]
    } finally {
        unset ::env(RUSTC) ::env(REAL_RUSTC)
        if {$saved ne {}} { set ::env(RUSTC) [lindex $saved 0] }
        removeDirectory {aot linker test}
    }
} -result {1 {NATIVE AOT} 1 1 previous {}}

cleanupTests
