# native-block-escape.test -- conservative escape analysis and
# virtualization of locally-bound, non-escaping Block (closure) values
# (hir/blockescape.tcl, native/lower.tcl's "Block virtualization" section):
# capture-explicit internal variants, materialization boundaries, recursion
# and mixed-use fallback, effect ordering, GC rooting, and the sum-refined
# benchmark's own dominant-allocation target (NATIVE-AUDIT.md's F1).
#
# -block-escape-opt 0 (or BOTLISH_NATIVE_BLOCK_ESCAPE_OPT=0) disables the
# analysis outright: most tests here differentially compare it against the
# default (on), the same way native-escape.test's escape-off-* checks do.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]

interp recursionlimit {} 1000000

proc sourceHir {text} {
    return [surface::compile $text t.bot -strict 0]
}

# The Block allocation count of TEXT under BLOCK-ESCAPE-OPT (1 or 0).
proc blockAllocs {text blockEscapeOpt} {
    return [dict get [native::allocationReport [sourceHir $text] summary 1 -block-escape-opt $blockEscapeOpt] byKind Block allocations]
}

# Asserts optimized (block-escape-opt 1) and baseline (block-escape-opt 0)
# agree on TEXT's value (the milestone's #50 differential-testing
# requirement).
proc assertParity {text} {
    set hir [sourceHir $text]
    set on [native::evalHir $hir -block-escape-opt 1]
    set off [native::evalHir $hir -block-escape-opt 0]
    if {$on ne $off} {
        error "block-escape-opt 1 vs 0 mismatch: $on vs $off"
    }
    return $on
}

# ---------------------------------------------------------------------------
# One capture, one call (#40; the sum-refined shape itself, in miniature)

test blockescape-single-1 {a closure over one captured local, called once directly, allocates no Block} -body {
    set text "fn f(n):\n    fn step(x):\n        x + n\n    step(5)\n\nf(10)"
    list [assertParity $text] [blockAllocs $text 1] [blockAllocs $text 0]
} -result {{int 15} 0 1}

test blockescape-single-2 {the NIR of a virtualized closure has no closure/callenv, and a direct call} -body {
    set text "fn f(n):\n    fn step(x):\n        x + n\n    step(5)\n\nf(10)"
    set nirText [dict get [native::lower::program [sourceHir $text]] text]
    list [regexp {closure |callenv} $nirText] [regexp {step" params=2 env=0} $nirText]
} -result {0 1}

# ---------------------------------------------------------------------------
# Multiple captures (#41, #16 -- do not hardcode the one-capture shape)

test blockescape-multi-capture-1 {three captures, correct order and values, no Block allocation} -body {
    set text "fn f(x, y, z):\n    fn g(a):\n        a + x + y + z\n    g(1)\n\nf(10, 100, 1000)"
    list [assertParity $text] [blockAllocs $text 1]
} -result {{int 1111} 0}

test blockescape-multi-capture-2 {the internal variant's params include every capture, in order} -body {
    set text "fn f(x, y, z):\n    fn g(a):\n        a + x + y + z\n    g(1)\n\nf(10, 100, 1000)"
    set nirText [dict get [native::lower::program [sourceHir $text]] text]
    regexp {"g" params=4 env=0 regs=\d+ pnames="a x y z"} $nirText
} -result 1

# ---------------------------------------------------------------------------
# Multiple direct calls (#42, #12 -- not "used exactly once")

test blockescape-multi-call-1 {a closure called twice directly still allocates no Block} -body {
    # step is bound once (one closure, if materialized) and called twice
    # through that same binding: the canonical baseline allocates once, not
    # once per call -- the optimized path allocates zero either way.
    set text "fn f(n):\n    fn step(x):\n        x + n\n    step(1) + step(2)\n\nf(100)"
    list [assertParity $text] [blockAllocs $text 1] [blockAllocs $text 0]
} -result {{int 203} 0 1}

# ---------------------------------------------------------------------------
# Conditional direct call (#43, #13)

test blockescape-conditional-1 {a closure called only on one conditional branch still allocates no Block} -body {
    set text "fn f(n, cond):\n    fn step(x):\n        x + n\n    if cond:\n        step(1)\n    else:\n        0\n\n\[f(10, true), f(10, false)\]"
    list [assertParity $text] [blockAllocs $text 1]
} -result {{list {{int 11} {int 0}}} 0}

# ---------------------------------------------------------------------------
# Zero-capture Block (#17): already optimal via the existing envless/fnvalue
# path -- this analysis adds nothing here, and should not need to.

test blockescape-zero-capture-1 {a zero-capture local closure already allocates no Block either way} -body {
    set text "fn f():\n    fn g():\n        5\n    g()\n\nf()"
    list [assertParity $text] [blockAllocs $text 1] [blockAllocs $text 0]
} -result {{int 5} 0 0}

# ---------------------------------------------------------------------------
# Nested lexical capture and shadowing (#15, #47)

test blockescape-shadow-1 {an inner closure captures the shadowed (inner), not the outer, binding} -body {
    set text "x = \"outer\"\n\nfn f():\n    x = \"inner\"\n    fn g():\n        x\n    g()\n\nf()"
    list [assertParity $text] [blockAllocs $text 1]
} -result {{str inner} 0}

test blockescape-nested-1 {a closure over an outer function's own parameter, one level removed} -body {
    set text "fn outer(n):\n    fn middle():\n        fn inner(x):\n            x + n\n        inner(1)\n    middle()\n\nouter(41)"
    list [assertParity $text] [blockAllocs $text 1]
} -result {{int 42} 0}

# ---------------------------------------------------------------------------
# Escaping return (#43/#48): the canonical heap closure is still built and
# still works when the Block value genuinely escapes.

test blockescape-escaping-return-1 {a returned closure still allocates and behaves as an ordinary Block} -body {
    set text "fn make(x):\n    fn f():\n        x\n    f\n\nadd10 = make(42)\nadd10()"
    list [assertParity $text] [blockAllocs $text 1] [blockAllocs $text 0]
} -result {{int 42} 1 1}

# ---------------------------------------------------------------------------
# Stored in an aggregate (#44): mixed direct-call + escaping use declines
# virtualization entirely (#33-34), exactly like the first StringRegion
# mixed-use policy.

test blockescape-stored-1 {a closure also stored in a List is never virtualized, even where it is called directly} -body {
    # A bare Block value cannot cross the native/host boundary (there is no
    # Tcl representation for it), so the escaping use is observed here
    # through list_length rather than by returning the List itself.
    set text "fn f(n):\n    fn step(x):\n        x + n\n    box = \[step, 0\]\n    step(1) + list_length(box)\n\nf(10)"
    set on [blockAllocs $text 1]
    set off [blockAllocs $text 0]
    list [assertParity $text] $on [expr {$on == $off}]
} -result {{int 13} 1 1}

# ---------------------------------------------------------------------------
# Passed to unknown/open code (#45): a Block argument to another function is
# never virtualized (only a statically known direct call qualifies).

test blockescape-open-call-1 {a closure passed as an ordinary argument still allocates and dispatches correctly} -body {
    set text "fn apply(g, y):\n    g(y)\n\nfn f(n):\n    fn step(x):\n        x + n\n    apply(step, 5)\n\nf(10)"
    list [assertParity $text] [blockAllocs $text 1] [blockAllocs $text 0]
} -result {{int 15} 1 1}

# ---------------------------------------------------------------------------
# Recursive Block (#30): a self-referencing local closure is conservatively
# declined (NeedsSelf), not attempted -- documented limitation, not a
# semantic requirement.

test blockescape-recursive-1 {a self-recursive local closure that also captures an outer value still allocates (declined, not a semantic requirement)} -body {
    # step must capture something real (n) as well as itself, or it is
    # simply an ordinary envless self-recursive function (no closure of any
    # kind is ever built for it, optimized or not) and this test would
    # exercise nothing.
    set text "fn f(n):\n    fn step(x):\n        if x == 0:\n            n\n        else:\n            step(x - 1)\n    step(5)\n\nf(100)"
    list [assertParity $text] [expr {[blockAllocs $text 1] > 0}]
} -result {{int 100} 1}

# ---------------------------------------------------------------------------
# GC stress (#28-29, #46): a captured managed (String) value stays correctly
# rooted as an ordinary parameter register across a call that can allocate.

test blockescape-gc-stress-1 {a captured String stays live under BOTLISH_NATIVE_GC_STRESS=1} -body {
    set ::env(BOTLISH_NATIVE_GC_STRESS) 1
    set text "fn f(n, s):\n    fn step(x):\n        concat(x, s)\n    if n == 0:\n        return step(\"go\")\n    f(n - 1, s)\n\nf(2000, \"!\")"
    set result [catch {native::evalHir [sourceHir $text]} value]
    unset ::env(BOTLISH_NATIVE_GC_STRESS)
    list $result $value
} -result {0 {str go!}}

# ---------------------------------------------------------------------------
# Effectful captures: evaluated exactly once, at bind time, never re-run per
# call (#14: captures are already-resolved values, not re-evaluated
# expressions).

test blockescape-effects-1 {a captured value's producing expression runs exactly once, not once per call} -body {
    set text "fn side(n):\n    concat(\"x\", n)\n\nfn f():\n    v = side(\"1\")\n    fn step(x):\n        concat(x, v)\n    concat(step(\"a\"), step(\"b\"))\n\nf()"
    list [assertParity $text] [blockAllocs $text 1]
} -result {{str ax1bx1} 0}

# ---------------------------------------------------------------------------
# Anti-overfitting (#2, #58): a synthetic, non-benchmark closure shape (none
# of the above are named sum/step/acc/n) is optimized -- the mechanism above
# already proves this generally, independent of any benchmark's own names.

# ---------------------------------------------------------------------------
# Optimizer disabled (#49): the -block-escape-opt 0 flag/
# BOTLISH_NATIVE_BLOCK_ESCAPE_OPT environment variable produce the guarded
# (canonical closure) baseline and nothing else changes.

test blockescape-off-1 {block-escape-opt 0 never builds an internal variant} -body {
    set text "fn f(n):\n    fn step(x):\n        x + n\n    step(5)\n\nf(10)"
    set nirText [dict get [native::lower::program [sourceHir $text] -block-escape-opt 0] text]
    list [regexp {closure } $nirText] [native::evalHir [sourceHir $text] -block-escape-opt 0]
} -result {1 {int 15}}

test blockescape-off-2 {BOTLISH_NATIVE_BLOCK_ESCAPE_OPT=0 has the same effect as -block-escape-opt 0} -body {
    set text "fn f(n):\n    fn step(x):\n        x + n\n    step(5)\n\nf(10)"
    set ::env(BOTLISH_NATIVE_BLOCK_ESCAPE_OPT) 0
    set nirText [dict get [native::lower::program [sourceHir $text]] text]
    unset ::env(BOTLISH_NATIVE_BLOCK_ESCAPE_OPT)
    regexp {closure } $nirText
} -result 1

# ---------------------------------------------------------------------------
# sum-refined itself (#1, #6-11): the motivating benchmark, unmodified.

test blockescape-sum-refined-1 {sum-refined performs zero Block allocations for step} -body {
    set hir [hir::build [core::loadProgramFile [file join $::projectRoot bench sum-refined.ir]] -strict 0]
    set on [native::allocationReport $hir summary 1]
    set off [native::allocationReport $hir summary 1 -block-escape-opt 0]
    list [native::evalHir $hir] [dict get $on byKind Block allocations] [dict get $off byKind Block allocations]
} -result {{int 80200} 0 400}

test blockescape-sum-refined-2 {sum-refined's NIR has no closure/callenv/rt_closure_new setup, and a direct call into step} -body {
    set hir [hir::build [core::loadProgramFile [file join $::projectRoot bench sum-refined.ir]] -strict 0]
    set nirText [dict get [native::lower::program $hir] text]
    list [regexp {closure |callenv} $nirText] [regexp {"step" params=2 env=0 regs=\d+ pnames="x n" captures=0} $nirText]
} -result {0 1}

cleanupTests
