# native-block-escape.test -- conservative escape analysis and
# virtualization of locally-bound, non-escaping Block (closure) values
# (hir/blockescape.tcl, native/lower.tcl's "Block virtualization" section):
# capture-explicit internal variants, materialization boundaries, recursion
# and mixed-use fallback, effect ordering, GC rooting, and the sum-refined
# benchmark's own dominant-allocation target (NATIVE-AUDIT.md's F1).
#
# -block-escape-opt 0 (or BOTLISH_NATIVE_BLOCK_ESCAPE_OPT=0) disables the
# analysis outright: most tests here differentially compare it against the
# default (on), the same way native-escape.test's escape-off-* checks do.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]
source [file join $::projectRoot examples stdlib corpus.tcl]

interp recursionlimit {} 1000000

proc sourceHir {text} {
    return [surface::compile $text t.bot -strict 0]
}

# The Block allocation count of TEXT under BLOCK-ESCAPE-OPT (1 or 0).
proc blockAllocs {text blockEscapeOpt} {
    return [dict get [native::allocationReport [sourceHir $text] summary 1 -block-escape-opt $blockEscapeOpt] byKind Block allocations]
}

# Asserts optimized (block-escape-opt 1) and baseline (block-escape-opt 0)
# agree on TEXT's value (the milestone's #50 differential-testing
# requirement).
proc assertParity {text} {
    set hir [sourceHir $text]
    set on [native::evalHir $hir -block-escape-opt 1]
    set off [native::evalHir $hir -block-escape-opt 0]
    if {$on ne $off} {
        error "block-escape-opt 1 vs 0 mismatch: $on vs $off"
    }
    return $on
}

# ---------------------------------------------------------------------------
# One capture, one call (#40; the sum-refined shape itself, in miniature)

test blockescape-single-1 {a closure over one captured local, called once directly, allocates no Block} -body {
    set text "fn f(n):\n    fn step(x):\n        x + n\n    step(5)\n\nf(10)"
    list [assertParity $text] [blockAllocs $text 1] [blockAllocs $text 0]
} -result {{int 15} 0 1}

test blockescape-single-2 {the NIR of a virtualized closure has no closure/callenv, and a direct call} -body {
    set text "fn f(n):\n    fn step(x):\n        x + n\n    step(5)\n\nf(10)"
    set nirText [dict get [native::lower::program [sourceHir $text]] text]
    list [regexp {closure |callenv} $nirText] [regexp {step" params=2 env=0} $nirText]
} -result {0 1}

# ---------------------------------------------------------------------------
# Multiple captures (#41, #16 -- do not hardcode the one-capture shape)

test blockescape-multi-capture-1 {three captures, correct order and values, no Block allocation} -body {
    set text "fn f(x, y, z):\n    fn g(a):\n        a + x + y + z\n    g(1)\n\nf(10, 100, 1000)"
    list [assertParity $text] [blockAllocs $text 1]
} -result {{int 1111} 0}

test blockescape-multi-capture-2 {the internal variant's params include every capture, in order} -body {
    set text "fn f(x, y, z):\n    fn g(a):\n        a + x + y + z\n    g(1)\n\nf(10, 100, 1000)"
    set nirText [dict get [native::lower::program [sourceHir $text]] text]
    regexp {"g" params=4 env=0 regs=\d+ pnames="a x y z"} $nirText
} -result 1

# ---------------------------------------------------------------------------
# Multiple direct calls (#42, #12 -- not "used exactly once")

test blockescape-multi-call-1 {a closure called twice directly still allocates no Block} -body {
    # step is bound once (one closure, if materialized) and called twice
    # through that same binding: the canonical baseline allocates once, not
    # once per call -- the optimized path allocates zero either way.
    set text "fn f(n):\n    fn step(x):\n        x + n\n    step(1) + step(2)\n\nf(100)"
    list [assertParity $text] [blockAllocs $text 1] [blockAllocs $text 0]
} -result {{int 203} 0 1}

# ---------------------------------------------------------------------------
# Conditional direct call (#43, #13)

test blockescape-conditional-1 {a closure called only on one conditional branch still allocates no Block} -body {
    set text "fn f(n, cond):\n    fn step(x):\n        x + n\n    if cond:\n        step(1)\n    else:\n        0\n\n\[f(10, true), f(10, false)\]"
    list [assertParity $text] [blockAllocs $text 1]
} -result {{list {{int 11} {int 0}}} 0}

# ---------------------------------------------------------------------------
# Zero-capture Block (#17): already optimal via the existing envless/fnvalue
# path -- this analysis adds nothing here, and should not need to.

test blockescape-zero-capture-1 {a zero-capture local closure already allocates no Block either way} -body {
    set text "fn f():\n    fn g():\n        5\n    g()\n\nf()"
    list [assertParity $text] [blockAllocs $text 1] [blockAllocs $text 0]
} -result {{int 5} 0 0}

# ---------------------------------------------------------------------------
# Nested lexical capture and shadowing (#15, #47)

test blockescape-shadow-1 {an inner closure captures the shadowed (inner), not the outer, binding} -body {
    set text "x = \"outer\"\n\nfn f():\n    x = \"inner\"\n    fn g():\n        x\n    g()\n\nf()"
    list [assertParity $text] [blockAllocs $text 1]
} -result {{str inner} 0}

test blockescape-nested-1 {a closure over an outer function's own parameter, one level removed} -body {
    set text "fn outer(n):\n    fn middle():\n        fn inner(x):\n            x + n\n        inner(1)\n    middle()\n\nouter(41)"
    list [assertParity $text] [blockAllocs $text 1]
} -result {{int 42} 0}

# ---------------------------------------------------------------------------
# Escaping return (#43/#48): the canonical heap closure is still built and
# still works when the Block value genuinely escapes.

test blockescape-escaping-return-1 {a returned closure still allocates and behaves as an ordinary Block} -body {
    set text "fn make(x):\n    fn f():\n        x\n    f\n\nadd10 = make(42)\nadd10()"
    list [assertParity $text] [blockAllocs $text 1] [blockAllocs $text 0]
} -result {{int 42} 1 1}

# ---------------------------------------------------------------------------
# Stored in an aggregate (#44): mixed direct-call + escaping use declines
# virtualization entirely (#33-34), exactly like the first StringRegion
# mixed-use policy.

test blockescape-stored-1 {a closure also stored in a List is never virtualized, even where it is called directly} -body {
    # A bare Block value cannot cross the native/host boundary (there is no
    # Tcl representation for it), so the escaping use is observed here
    # through list_length rather than by returning the List itself.
    set text "fn f(n):\n    fn step(x):\n        x + n\n    box = \[step, 0\]\n    step(1) + list_length(box)\n\nf(10)"
    set on [blockAllocs $text 1]
    set off [blockAllocs $text 0]
    list [assertParity $text] $on [expr {$on == $off}]
} -result {{int 13} 1 1}

# ---------------------------------------------------------------------------
# Passed to unknown/open code (#45): a Block argument to another function is
# never virtualized (only a statically known direct call qualifies).

test blockescape-open-call-1 {a closure passed as an ordinary argument still allocates and dispatches correctly} -body {
    set text "fn apply(g, y):\n    g(y)\n\nfn f(n):\n    fn step(x):\n        x + n\n    apply(step, 5)\n\nf(10)"
    list [assertParity $text] [blockAllocs $text 1] [blockAllocs $text 0]
} -result {{int 15} 1 1}

# ---------------------------------------------------------------------------
# Recursive Block (de-closure conversion #21, #92): a self-referencing local
# closure whose only self-reference is its own exact recursive call no
# longer needs "self" (the running closure's own identity) as a value at
# all, so it virtualizes too -- captures become ordinary trailing loop-
# carried parameters, and a self-tail recursive call becomes a loop
# backedge exactly as it would for a materialized closure, with zero
# per-invocation Block allocation.

test blockescape-recursive-1 {a self-recursive local closure that also captures an outer value now virtualizes: zero Block allocation} -body {
    # step must capture something real (n) as well as itself, or it is
    # simply an ordinary envless self-recursive function (no closure of any
    # kind is ever built for it, optimized or not) and this test would
    # exercise nothing.
    set text "fn f(n):\n    fn step(x):\n        if x == 0:\n            n\n        else:\n            step(x - 1)\n    step(5)\n\nf(100)"
    list [assertParity $text] [blockAllocs $text 1] [blockAllocs $text 0]
} -result {{int 100} 0 1}

test blockescape-recursive-2 {the internal variant's recursive call is a `tail` loop backedge, with captures re-passed, never a closure or callenv} -body {
    set text "fn f(n):\n    fn step(x):\n        if x == 0:\n            n\n        else:\n            step(x - 1)\n    step(5)\n\nf(100)"
    set nirText [dict get [native::lower::program [sourceHir $text]] text]
    list [regexp {closure |callenv } $nirText] [regexp {tail %\d+ %\d+} $nirText]
} -result {0 1}

test blockescape-recursive-non-tail-1 {a non-tail self-recursive virtualized closure still computes correctly (an ordinary recursive call, not a loop)} -body {
    set text "fn f(n):\n    fn fact(x):\n        if x <= 1:\n            n\n        else:\n            x * fact(x - 1)\n    fact(5)\n\nf(1)"
    list [assertParity $text] [blockAllocs $text 1] [blockAllocs $text 0]
} -result {{int 120} 0 1}

# ---------------------------------------------------------------------------
# Closure captured by another closure (de-closure conversion #18-20, #33): a
# sibling Block that only ever calls another local Block exactly, with
# matching arity, does not force the callee to materialize either -- this
# is the refined-checks dominant shape (char_at called only from inside
# scan_local/scan_label/scan_alpha's own bodies) in miniature.

test blockescape-sibling-1 {a closure captured only by another closure's own exact call, transitively, allocates no Block for either} -body {
    set text "fn f(v):\n    fn inner(i):\n        v + i\n    fn outer(i):\n        inner(i) * 2\n    outer(3)\n\nf(10)"
    list [assertParity $text] [blockAllocs $text 1] [blockAllocs $text 0]
} -result {{int 26} 0 2}

test blockescape-sibling-2 {the outer closure's own internal variant receives the inner closure's captures directly (flattened), not the inner closure itself} -body {
    set text "fn f(v):\n    fn inner(i):\n        v + i\n    fn outer(i):\n        inner(i) * 2\n    outer(3)\n\nf(10)"
    set nirText [dict get [native::lower::program [sourceHir $text]] text]
    list [regexp {closure |callenv } $nirText] [regexp {"outer" params=2 env=0 regs=\d+ pnames="i v"} $nirText]
} -result {0 1}

test blockescape-sibling-chain-1 {a three-deep capture chain (A captures x, B captures A, C captures B) flattens transitively to zero Block allocation} -body {
    set text "fn f(v):\n    fn a(i):\n        v + i\n    fn b(i):\n        a(i) * 2\n    fn c(i):\n        b(i) + 1\n    c(3)\n\nf(10)"
    list [assertParity $text] [blockAllocs $text 1] [blockAllocs $text 0]
} -result {{int 27} 0 3}

test blockescape-sibling-escaping-1 {a closure captured by an escaping sibling still materializes both, conservatively} -body {
    # inner is captured only by outer's own body, but outer itself escapes
    # (returned), so outer's real environment must carry a real inner
    # value: neither virtualizes.
    set text "fn f(v):\n    fn inner(i):\n        v + i\n    fn outer(i):\n        inner(i) * 2\n    outer\n\ng = f(10)\ng(3)"
    set on [blockAllocs $text 1]
    set off [blockAllocs $text 0]
    list [assertParity $text] $on [expr {$on == $off}]
} -result {{int 26} 2 1}

# ---------------------------------------------------------------------------
# GC stress (#28-29, #46): a captured managed (String) value stays correctly
# rooted as an ordinary parameter register across a call that can allocate.

test blockescape-gc-stress-1 {a captured String stays live under BOTLISH_NATIVE_GC_STRESS=1} -body {
    set ::env(BOTLISH_NATIVE_GC_STRESS) 1
    set text "fn f(n, s):\n    fn step(x):\n        concat(x, s)\n    if n == 0:\n        return step(\"go\")\n    f(n - 1, s)\n\nf(2000, \"!\")"
    set result [catch {native::evalHir [sourceHir $text]} value]
    unset ::env(BOTLISH_NATIVE_GC_STRESS)
    list $result $value
} -result {0 {str go!}}

# de-closure conversion's own adversarial case (milestone #30-34): a managed
# (String) capture threaded transitively through a sibling capture chain
# AND a self-tail recursive loop, allocating (and so potentially
# collecting) after every use of the capture -- both the outer and the
# inner virtualized closure's own capture registers must stay correctly
# rooted across every one of those calls.

test blockescape-gc-stress-2 {a managed capture threaded through a de-closure-converted sibling+self-tail chain survives GC stress} -body {
    set ::env(BOTLISH_NATIVE_GC_STRESS) 1
    set text "fn f(n, s):\n    fn build(x):\n        concat(s, x)\n    fn scan(i):\n        if i >= n:\n            build(\"done\")\n        else:\n            concat(build(\"x\"), scan(i + 1))\n    scan(0)\n\nf(3, \"go-\")"
    set on [blockAllocs $text 1]
    set result [catch {native::evalHir [sourceHir $text]} value]
    unset ::env(BOTLISH_NATIVE_GC_STRESS)
    list $result $value $on
} -result {0 {str go-xgo-xgo-xgo-done} 0}

test blockescape-multi-managed-capture-1 {a virtualized closure with three captures (String, Int, Bool) passes all three correctly} -body {
    set text "fn f(s, n, flag):\n    fn combine(x):\n        if flag:\n            concat(concat(s, x), n)\n        else:\n            concat(x, s)\n    concat(combine(\"-\"), combine(\"+\"))\n\nf(\"hi\", \"7\", true)"
    list [assertParity $text] [blockAllocs $text 1] [blockAllocs $text 0]
} -result {{str hi-7hi+7} 0 1}

test blockescape-loop-creation-1 {a de-closure-converted closure created repeatedly by a recursive outer function allocates zero Blocks total, not once per outer invocation} -body {
    # The refined-checks dominant shape in miniature: driver recurses
    # NTIMES, each time invoking f(n), which creates (and, unoptimized,
    # would allocate) step exactly once per invocation.
    set text "fn f(n):\n    fn step(x):\n        x + n\n    step(n)\n\nfn driver(i):\n    if i <= 0:\n        0\n    else:\n        f(i) + driver(i - 1)\n\ndriver(50)"
    list [assertParity $text] [blockAllocs $text 1] [blockAllocs $text 0]
} -result {{int 2550} 0 50}

# ---------------------------------------------------------------------------
# Effectful captures: evaluated exactly once, at bind time, never re-run per
# call (#14: captures are already-resolved values, not re-evaluated
# expressions).

test blockescape-effects-1 {a captured value's producing expression runs exactly once, not once per call} -body {
    set text "fn side(n):\n    concat(\"x\", n)\n\nfn f():\n    v = side(\"1\")\n    fn step(x):\n        concat(x, v)\n    concat(step(\"a\"), step(\"b\"))\n\nf()"
    list [assertParity $text] [blockAllocs $text 1]
} -result {{str ax1bx1} 0}

# ---------------------------------------------------------------------------
# Anti-overfitting (#2, #58): a synthetic, non-benchmark closure shape (none
# of the above are named sum/step/acc/n) is optimized -- the mechanism above
# already proves this generally, independent of any benchmark's own names.

# ---------------------------------------------------------------------------
# Optimizer disabled (#49): the -block-escape-opt 0 flag/
# BOTLISH_NATIVE_BLOCK_ESCAPE_OPT environment variable produce the guarded
# (canonical closure) baseline and nothing else changes.

test blockescape-off-1 {block-escape-opt 0 never builds an internal variant} -body {
    set text "fn f(n):\n    fn step(x):\n        x + n\n    step(5)\n\nf(10)"
    set nirText [dict get [native::lower::program [sourceHir $text] -block-escape-opt 0] text]
    list [regexp {closure } $nirText] [native::evalHir [sourceHir $text] -block-escape-opt 0]
} -result {1 {int 15}}

test blockescape-off-2 {BOTLISH_NATIVE_BLOCK_ESCAPE_OPT=0 has the same effect as -block-escape-opt 0} -body {
    set text "fn f(n):\n    fn step(x):\n        x + n\n    step(5)\n\nf(10)"
    set ::env(BOTLISH_NATIVE_BLOCK_ESCAPE_OPT) 0
    set nirText [dict get [native::lower::program [sourceHir $text]] text]
    unset ::env(BOTLISH_NATIVE_BLOCK_ESCAPE_OPT)
    regexp {closure } $nirText
} -result 1

# ---------------------------------------------------------------------------
# sum-refined itself (#1, #6-11): the motivating benchmark, unmodified.

test blockescape-sum-refined-1 {sum-refined performs zero Block allocations for step} -body {
    set hir [hir::build [core::loadProgramFile [file join $::projectRoot bench sum-refined.ir]] -strict 0]
    set on [native::allocationReport $hir summary 1]
    set off [native::allocationReport $hir summary 1 -block-escape-opt 0]
    list [native::evalHir $hir] [dict get $on byKind Block allocations] [dict get $off byKind Block allocations]
} -result {{int 80200} 0 400}

test blockescape-sum-refined-2 {sum-refined's NIR has no closure/callenv/rt_closure_new setup, and a direct call into step} -body {
    set hir [hir::build [core::loadProgramFile [file join $::projectRoot bench sum-refined.ir]] -strict 0]
    set nirText [dict get [native::lower::program $hir] text]
    list [regexp {closure |callenv} $nirText] [regexp {"step" params=2 env=0 regs=\d+ pnames="x n" captures=0} $nirText]
} -result {0 1}

# ---------------------------------------------------------------------------
# Capture-explicit StringRegion companions (the "capture-explicit
# StringRegion" milestone): a blockescape-virtual Block whose result some
# caller wants in StringRegion form no longer forces materialization --
# native/lower.tcl's Call dispatches such a call to the callee's *internal
# region companion* instead of its ordinary internal variant, reusing the
# exact same flattened captures either way. char_at's own before/after shape
# is exercised directly on refined-checks.ir further below; the fixtures
# here are deliberately independent of Emailish?/web.tcl (#33/#34): the same
# composition, proven general.

# The Block allocation count of TEXT under BLOCK-ESCAPE-OPT/STRING-REGION-OPT
# (each 1 or 0).
proc blockAllocsOpt {text blockEscapeOpt stringRegionOpt} {
    return [dict get [native::allocationReport [sourceHir $text] summary 1 \
        -block-escape-opt $blockEscapeOpt -string-region-opt $stringRegionOpt] byKind Block allocations]
}

# ---------------------------------------------------------------------------
# Minimal independent fixture (#34, #75): a nonescaping `at` whose result is
# consumed only in region form by a nonescaping `scan` -- zero Block
# allocation, no source-specific recognition of any kind.

set ::atScanSrc {
fn outer(s):
    fn at(i):
        substring(s, i, i + 1)
    fn scan(i):
        if at(i) == "x":
            true
        else:
            false
    scan(1)

outer("axb")
}

test blockescape-region-companion-minimal-1 {a nonescaping char-accessor consumed only in region form allocates no Block} -body {
    # Baseline (block-escape-opt 0) materializes both at and scan (2
    # closures); the optimized path allocates neither.
    list [assertParity $::atScanSrc] [blockAllocs $::atScanSrc 1] [blockAllocs $::atScanSrc 0]
} -result {{bool true} 0 2}

test blockescape-region-companion-minimal-2 {at's NIR has no closure/callenvmulti, and env=0/results=3} -body {
    set nirText [dict get [native::lower::program [sourceHir $::atScanSrc]] text]
    list [regexp {closure |callenvmulti} $nirText] \
        [regexp {"at" params=2 env=0 regs=\d+ pnames="i s" captures=0 instance="generic" results=3} $nirText]
} -result {0 1}

test blockescape-region-companion-minimal-3 {scan's captures flatten through at to [s], never [at]} -body {
    set nirText [dict get [native::lower::program [sourceHir $::atScanSrc]] text]
    regexp {"scan" params=2 env=0 regs=\d+ pnames="i s" captures=0} $nirText
} -result 1

test blockescape-region-companion-minimal-4 {the region call is a direct callmulti, never callenvmulti} -body {
    set nirText [dict get [native::lower::program [sourceHir $::atScanSrc]] text]
    list [regexp {callmulti} $nirText] [regexp {callenvmulti} $nirText]
} -result {1 0}

# ---------------------------------------------------------------------------
# Mixed ordinary + region consumer (#35, #14): the same virtualized `at`
# serves an ordinary (materializing) String caller and a region caller,
# neither forcing the other's representation.

set ::atMixedSrc {
fn outer(s):
    fn at(i):
        substring(s, i, i + 1)
    fn use(i, j):
        x = at(i)
        if at(j) == ":":
            concat(x, "!")
        else:
            concat(x, "?")
    use(0, 1)

outer("a:b")
}

test blockescape-region-companion-mixed-1 {a virtualized at serves both an ordinary and a region caller correctly} -body {
    # Baseline (block-escape-opt 0) materializes both at and use (2
    # closures); the optimized path allocates neither (x still materializes
    # a String -- it genuinely escapes into concat -- but never a Block).
    list [assertParity $::atMixedSrc] [blockAllocs $::atMixedSrc 1] [blockAllocs $::atMixedSrc 0]
} -result {{str a!} 0 2}

test blockescape-region-companion-mixed-2 {at gets both an ordinary internal variant and an internal region companion} -body {
    set nirText [dict get [native::lower::program [sourceHir $::atMixedSrc]] text]
    set atLines [regexp -all -inline -line {^func \d+ "at" params=2 env=0.*$} $nirText]
    set withResults [llength [lsearch -all -inline -regexp $atLines {results=3}]]
    list [regexp {closure |callenvmulti} $nirText] [llength $atLines] $withResults
} -result {0 2 1}

# ---------------------------------------------------------------------------
# Escaping closure coexisting with a virtualized region-result closure in
# the same program (#16, #36): the canonical, closure-taking entry (and its
# canonical region companion, for a generic/dynamic caller) is retained for
# a Block that genuinely escapes, while a *different* nonescaping closure in
# the same program is virtualized and served through the new internal
# region companion -- neither representation forces the other. (A single
# binding cannot itself have both an escaping and a virtualizable use:
# hir/blockescape.tcl's RefsAsCalls declines virtualization the moment any
# reference is not an exact call, so this fixture demonstrates the
# coexistence at the whole-program level, which is what #15's "canonical
# entries remain available" and #16's "mixed materialized and virtual
# callers" actually require of lowering.)

set ::mixedProgramSrc {
fn makeAccessor(s):
    fn at(i):
        substring(s, i, i + 1)
    at

fn scanner(s2):
    fn at2(i):
        substring(s2, i, i + 1)
    fn scan(i):
        at2(i) == "z"
    scan(2)

acc = makeAccessor("hello")
[acc(1), scanner("zzzzz")]
}

test blockescape-region-companion-escaping-coexist-1 {an escaping closure and a virtualized region-result closure coexist correctly} -body {
    # Optimized: only the genuinely escaping `at` allocates (1 Block); `at2`
    # and `scan` never do. Baseline (block-escape-opt 0) also materializes
    # at2 and scan (3 Blocks total), confirming the optimized path is
    # strictly fewer, not merely different.
    set on [blockAllocs $::mixedProgramSrc 1]
    set off [blockAllocs $::mixedProgramSrc 0]
    list [assertParity $::mixedProgramSrc] $on $off
} -result {{list {{str e} {bool true}}} 1 3}

test blockescape-region-companion-escaping-coexist-2 {the escaping at still builds a canonical closure; at2 never does} -body {
    set nirText [dict get [native::lower::program [sourceHir $::mixedProgramSrc]] text]
    list [regexp {closure } $nirText] [regexp {callenvmulti} $nirText] \
        [regexp {"at2" params=2 env=0 regs=\d+ pnames="i s2" captures=0 instance="generic" results=3} $nirText]
} -result {1 0 1}

# ---------------------------------------------------------------------------
# GC stress adversarial case (#29, #43): the captured base String must stay
# correctly rooted across a self-tail loop that both calls the internal
# region companion (never allocates) and, on the same iteration, calls the
# ordinary internal variant (materializes, and can allocate/collect) before
# using the region-eligible capture again on the next iteration.

test blockescape-region-companion-gc-stress-1 {a captured base String survives a self-tail loop mixing region and ordinary char_at-shaped calls, under GC stress} -body {
    set text {
fn f(n, s):
    fn at(i):
        substring(s, i, i + 1)
    fn scan(i, acc):
        if i >= n:
            acc
        else:
            if at(i) == "x":
                scan(i + 1, concat(acc, at(i)))
            else:
                scan(i + 1, acc)
    scan(0, "")

f(6, "xoxoxo")
}
    set baseline [assertParity $text]
    set ::env(BOTLISH_NATIVE_GC_STRESS) 1
    set result [catch {native::evalHir [sourceHir $text]} value]
    unset ::env(BOTLISH_NATIVE_GC_STRESS)
    list $baseline $result $value [blockAllocs $text 1]
} -result {{str xxx} 0 {str xxx} 0}

# ---------------------------------------------------------------------------
# Error/Unicode parity (#69): a locally-bound (blockescape-eligible) char
# accessor's bounds and classification errors, and non-ASCII/astral
# behavior, exactly match the unoptimized baseline -- not just the
# top-level-function StringRegion consumer shapes native-string-view.test/
# native-string-region.test already cover (those never exercise this
# milestone's own new dispatch at all: a top-level `fn` is never a
# blockescape candidate in the first place, only a *locally bound* closure
# is).

# Asserts optimized (both opts 1) and baseline (both opts 0) raise the same
# semantic error, agreeing with the reference interpreter too. Returns
# {ERRORCODE MESSAGE}.
proc assertErrorParity {text} {
    set hir [sourceHir $text]
    set exprs [hir::lower $hir]
    foreach label {interp on off} {
        switch -- $label {
            interp { set code [catch {core::evalProgram $exprs} value options] }
            on     { set code [catch {native::evalHir $hir -block-escape-opt 1 -string-region-opt 1} value options] }
            off    { set code [catch {native::evalHir $hir -block-escape-opt 0 -string-region-opt 0} value options] }
        }
        if {!$code} {
            error "$label: expected an error, got [core::value::show $value 1]"
        }
        set outcomes($label) [list [dict get $options -errorcode] $value]
    }
    if {$outcomes(on) ne $outcomes(off) || [lindex $outcomes(on) 0] ne [lindex $outcomes(interp) 0]} {
        error "error mismatch: interp $outcomes(interp), on $outcomes(on), off $outcomes(off)"
    }
    return $outcomes(on)
}

test blockescape-region-companion-bounds-error-1 {a locally-bound char accessor's out-of-range region access raises the same RANGE error, optimized and baseline} -body {
    set text {
fn outer(s, i):
    fn at(j):
        substring(s, j, j + 1)
    fn scan(k):
        at(k) == "z"
    scan(i)

outer("ab", 5)
}
    assertErrorParity $text
} -result {{CORE SEMANTIC RANGE} {substring: range 5..6 is outside 0..2}}

test blockescape-region-companion-unicode-1 {a locally-bound char accessor over an astral-plane String classifies correctly, in region form, with zero Block allocation} -body {
    set emoji [encoding convertfrom utf-8 "\xf0\x9f\x98\x80"]
    set text "
fn outer(s):
    fn at(i):
        substring(s, i, i + 1)
    fn scan(i):
        is_tcl_alpha(at(i))
    \[scan(0), scan(1)\]

outer([corpus::literal "a$emoji"])
"
    list [assertParity $text] [blockAllocs $text 1]
} -result {{list {{bool true} {bool false}}} 0}

# ---------------------------------------------------------------------------
# Flag composition (#70-73): the four combinations of -block-escape-opt and
# -string-region-opt degrade conservatively, and neither optimization
# requires the other to be enabled.

test blockescape-region-companion-flags-both-on {both on: zero Block allocation, region form used} -body {
    list [dict get [native::allocationReport [sourceHir $::atScanSrc] summary 1 \
            -block-escape-opt 1 -string-region-opt 1] byKind Block allocations] \
        [native::evalHir [sourceHir $::atScanSrc] -block-escape-opt 1 -string-region-opt 1]
} -result {0 {bool true}}

test blockescape-region-companion-flags-blockescape-only {block-escape on, string-region off: at still virtualizes (ordinary internal variant), no dependency on StringRegion} -body {
    set nirText [dict get [native::lower::program [sourceHir $::atScanSrc] -string-region-opt 0] text]
    list [blockAllocsOpt $::atScanSrc 1 0] [regexp {closure |callenvmulti} $nirText] \
        [native::evalHir [sourceHir $::atScanSrc] -block-escape-opt 1 -string-region-opt 0]
} -result {0 0 {bool true}}

test blockescape-region-companion-flags-stringregion-only {string-region on, block-escape off: pre-milestone behavior -- a real at closure and its canonical region companion} -body {
    # Both at and scan materialize (2 closures) with block-escape off; at's
    # region use still reaches its canonical, closure-taking region
    # companion through callenvmulti, exactly the pre-milestone shape.
    set nirText [dict get [native::lower::program [sourceHir $::atScanSrc] -block-escape-opt 0] text]
    list [blockAllocsOpt $::atScanSrc 0 1] [regexp {closure } $nirText] [regexp {callenvmulti} $nirText] \
        [native::evalHir [sourceHir $::atScanSrc] -block-escape-opt 0 -string-region-opt 1]
} -result {2 1 1 {bool true}}

test blockescape-region-companion-flags-both-off {both off: the fully unoptimized baseline} -body {
    list [blockAllocsOpt $::atScanSrc 0 0] \
        [native::evalHir [sourceHir $::atScanSrc] -block-escape-opt 0 -string-region-opt 0]
} -result {2 {bool true}}

# ---------------------------------------------------------------------------
# refined-checks itself (the primary acceptance case, #2, #18-19, #47, #85):
# char_at's own two recurrent 800+400 Block allocation sites are gone, and
# the whole program's Block allocation count collapses to the module-
# startup closures (out of this milestone's scope, #48).
#
# ASCII-AND-URI-UNRESERVED.md moved is_unreserved out of uri_escape_text
# (it is now the top-level web::is_unreserved, its own module-startup
# closure) and gave web.bot its own retained additional_unreserved_chars
# = byte::set(['-', '.', '_', '~']). That raises this test's own startup
# totals, all still one-time module-init costs, never per-call: Block 1
# -> 2 (uri_escape_text's closure, as before, plus is_unreserved's own);
# List 5 -> 11 (hex_digits' list and byte::set's internal accumulator/
# listappend machinery, as before, plus the new four-char punctuation
# list byte::set consumes and its own accumulator/appends); ImmutableSet
# 0 -> 1 (additional_unreserved_chars itself, byte::set's terminal
# setfromlist); String unaffected (9); total 15 -> 23.
test blockescape-region-companion-refined-checks-1 {refined-checks.ir: Block allocations collapse from 1201 to 2 (module-startup uri_escape_text and is_unreserved closures only)} -body {
    core::loadLibrary web
    set hir [native::buildProgramHir [core::loadProgramFile [file join $::projectRoot bench refined-checks.ir]]]
    set on [native::allocationReport $hir summary 1]
    list [native::evalHir $hir] [dict get $on total allocations] [dict get $on byKind Block allocations] \
        [dict get $on byKind String allocations] [dict get $on byKind List allocations]
} -result {{list {{int 400} {int 0}}} 23 2 9 11}

test blockescape-region-companion-refined-checks-2 {refined-checks.ir: char_at's NIR has no closure/callenvmulti, and env=0/results=3} -body {
    core::loadLibrary web
    set hir [native::buildProgramHir [core::loadProgramFile [file join $::projectRoot bench refined-checks.ir]]]
    set nirText [dict get [native::lower::program $hir] text]
    list [regexp {"char_at" params=1} $nirText] \
        [llength [regexp -all -inline {"char_at" params=2 env=0 regs=\d+ pnames="i v" captures=0 instance="generic" results=3} $nirText]] \
        [regexp {callenvmulti} $nirText]
} -result {0 2 0}

test blockescape-region-companion-refined-checks-3 {refined-checks.ir: scanner helpers flatten captures from [n, char_at] to [n, v]} -body {
    core::loadLibrary web
    set hir [native::buildProgramHir [core::loadProgramFile [file join $::projectRoot bench refined-checks.ir]]]
    set nirText [dict get [native::lower::program $hir] text]
    set names {scan_local scan_label scan_alpha tld_ok domain_loop}
    set stale 0
    set flattened 0
    foreach name $names {
        if {[regexp "\"$name\" params=3 env=0 \[^\\n\]*pnames=\"i n char_at\"" $nirText]} {
            incr stale
        }
        if {[llength [regexp -all -inline "\"$name\" params=3 env=0 \[^\\n\]*pnames=\"i n v\"" $nirText]] == 2} {
            incr flattened
        }
    }
    list $stale $flattened [llength $names]
} -result {0 5 5}

test blockescape-region-companion-refined-checks-4 {refined-checks.ir under GC stress: unchanged value, on the composed representation} -body {
    core::loadLibrary web
    set hir [native::buildProgramHir [core::loadProgramFile [file join $::projectRoot bench refined-checks.ir]]]
    set ::env(BOTLISH_NATIVE_GC_STRESS) 1
    set result [catch {native::evalHir $hir} value]
    unset ::env(BOTLISH_NATIVE_GC_STRESS)
    list $result $value
} -result {0 {list {{int 400} {int 0}}}}

test blockescape-region-companion-refined-checks-5 {refined-checks.ir: self-tail scanner lowering is still a loop backedge (tail, never tailenv/a recursive call), and the loop-backedge count is unchanged from before this milestone} -body {
    core::loadLibrary web
    set hir [native::buildProgramHir [core::loadProgramFile [file join $::projectRoot bench refined-checks.ir]]]
    set nirText [dict get [native::lower::program $hir] text]
    list [regexp {tailenv} $nirText] [llength [regexp -all -inline -line {^\s+tail .*$} $nirText]]
} -result {0 11}

cleanupTests
