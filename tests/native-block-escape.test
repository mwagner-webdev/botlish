test blockescape-region-companion-flags-both-off {both off: the fully unoptimized baseline} -body {
    list [blockAllocsOpt $::atScanSrc 0 0] \
        [native::evalHir [sourceHir $::atScanSrc] -block-escape-opt 0 -string-region-opt 0]
} -result {2 {bool true}}

# ---------------------------------------------------------------------------
# refined-checks itself (the primary acceptance case, #2, #18-19, #47, #85):
# char_at's own two recurrent 800+400 Block allocation sites are gone, and
# the whole program's Block allocation count collapses to the module-
# startup closures (out of this milestone's scope, #48).
#
# ASCII-AND-URI-UNRESERVED.md moved is_unreserved out of uri_escape_text
# (it is now the top-level web::is_unreserved, its own module-startup
# closure) and gave web.bot its own retained additional_unreserved_chars
# = byte::set(['-', '.', '_', '~']). That raises this test's own startup
# totals, all still one-time module-init costs, never per-call: Block 1
# -> 2 (uri_escape_text's closure, as before, plus is_unreserved's own);
# List 5 -> 11 (hex_digits' list and byte::set's internal accumulator/
# listappend machinery, as before, plus the new four-char punctuation
# list byte::set consumes and its own accumulator/appends); ImmutableSet
# 0 -> 1 (additional_unreserved_chars itself, byte::set's terminal
# setfromlist); String unaffected (9); total 15 -> 23.
# M8.a (virtual construction, default on): String 9 -> 4 -- uri_escape_text
# ("a b")'s five intermediate strcats become two private StringPlans
# (hex_pair's result, esc_from's accumulator) plus one final
# materialization; the 3 substrings are unchanged -- so total 23 -> 20.
# Block allocations (this test's subject) are unchanged.
# R2.a (R2A-IDIOMATIC-EMAILISH-SOURCE.md) raised these counts to
# 11620/802/9204/811 (total/Block/String/List): its predicate-passing
# scan_while materializes each char_at result as a String (9200 substr),
# and, as a temporary workaround for a -module-fn bridge reachability
# defect, it built emailish?'s local-punctuation ImmutableSet
# (local_extra_chars) once per emailish? call -- 800 List + 800
# ImmutableSet per run of this benchmark's 800 real emailish? calls.
# R2.a.1 (R2A1-MODULE-FN-BRIDGE-REACHABILITY.md) fixes the bridge and
# retains local_extra_chars once at module scope again: List 811 -> 12 (11
# startup lists as before plus local_extra_chars' own literal list, once),
# ImmutableSet 801 -> 2 (additional_unreserved_chars and local_extra_chars,
# once each), total 11620 -> 10023. Block is 803: the 2 startup closures as
# before, web::emailish?'s own startup closure (it now captures the
# module set), and 800 local_char? closures -- one per emailish? call,
# because local_char? is nested in emailish? and captures the module
# binding web::local_extra_chars (module bindings are reached by capture;
# see the report).
#
# R2.a.3 (R2A3-COUNTED-LOOPS-FINAL-SOURCE.md) drops String 9204 -> 8004 (a
# genuine, measured source-induced payoff, not an optimizer change): the
# rewritten domain? reads char_at(j)/char_at(j-1) directly at each
# character position instead of the old domain_loop's own extra explicit
# char_at(label_end) re-check after each scan_while, so the domain scan
# now performs exactly one char_at call per domain character instead of
# (in the label case) two. total allocations falls by the same 1200 (10023
# -> 8823); Block/List/ImmutableSet are unchanged (the module-retained set
# and its own capturing closures are untouched by the loop rewrite).
#
# MODULE-STATIC-RETAINED-VALUES.md removes the Block 803 entirely: a module-
# retained immutable binding (web::local_extra_chars) is now a module-
# static reference, never a lexical capture, wherever it is reached from --
# so web::emailish? no longer captures it (no startup closure for emailish?
# either -- envless outright), and local_char? (nested inside emailish?,
# the one real per-call site) no longer captures anything at all, so it
# allocates no closure on any of the 800 real emailish? calls this
# benchmark makes. Block: 803 -> 0. total allocations falls by that same
# 803 (8823 -> 8020); String/List/ImmutableSet are unchanged (this
# milestone corrects storage/reachability representation only, never
# value construction, per spec items 28-29).
# EXACT-CALLABLE-CLOSED-CALLER.md: scan_while's TLD call site now has the
# exact predicate str::is_tcl_alpha in its key, so the TLD scan consumes
# char_at(i) as a StringRegion (no one-character String per TLD character):
# String 8004 -> 6804 (the 1,200 TLD characters of the 800 real emailish?
# calls' accepted inputs), total allocations 8020 -> 6820. The local-part
# scan's 6,800 one-character Strings remain (set membership is not a region
# consumer).
test blockescape-region-companion-refined-checks-1 {refined-checks.ir: local_extra_chars' List/ImmutableSet are module-init only (R2.a.1); Block drops from 803 (R2.a.1's own per-call local_char? closure, capturing the module set) to 0 -- local_char? is envless now, a module-static reference is never a capture (MODULE-STATIC-RETAINED-VALUES.md); the exact predicate str::is_tcl_alpha makes the TLD scan a StringRegion consumer, so String falls 8004 -> 6804 (the local part's set-membership characters remain)} -body {
    core::loadLibrary web
    set hir [nativeHirOfIR [core::loadProgramFile [file join $::projectRoot bench refined-checks.ir]]]
    # -short-string-opt 0: the pinned String count is the region analysis's
    # own effect; ShortString1 (SHORT-STRING.md) removes three more.
    set on [native::allocationReport $hir summary 1 -short-string-opt 0]
    list [native::evalHir $hir -short-string-opt 0] [dict get $on total allocations] [dict get $on byKind Block allocations] \
        [dict get $on byKind String allocations] [dict get $on byKind List allocations] \
        [dict get $on byKind ImmutableSet allocations]
} -result {{list {{int 400} {int 0}}} 6820 0 6804 12 2}

# (GENERIC-PREDICATE-PROOF-LOSS.md, loss point 1: char_at is only called with an Int,
# so its one emitted instance is keyed instance="int" rather than "generic".)
test blockescape-region-companion-refined-checks-2 {refined-checks.ir: char_at's NIR has no closure/callenvmulti, and env=0/results=3 -- R2 (R2-ORDINARY-EMAILISH-PREDICATE.md) collapses this to one shared instance, not two per-call-site copies} -body {
    core::loadLibrary web
    set hir [nativeHirOfIR [core::loadProgramFile [file join $::projectRoot bench refined-checks.ir]]]
    set nirText [dict get [native::lower::program $hir] text]
    list [regexp {"char_at" params=1} $nirText] \
        [llength [regexp -all -inline {"char_at" params=2 env=0 regs=\d+ pnames="i v" captures=0 instance="int" results=3} $nirText]] \
        [regexp {callenvmulti} $nirText]
} -result {0 1 0}

# R2.a (R2A-IDIOMATIC-EMAILISH-SOURCE.md) unified scan_local/scan_label/
# scan_alpha into one predicate-parameterized scan_while, flattened to
# capture [n, char_at] directly rather than through a closure. R2.a.3
# (R2A3-COUNTED-LOOPS-FINAL-SOURCE.md) goes further: scan_while's own
# induction parameter is renamed i -> start (i is now purely the counted
# loop's own internal induction binding, never a function parameter at
# all), and domain_loop is gone entirely -- replaced by the non-recursive
# domain? (counted-loop-only body, tld?'s own rename carried over
# unchanged in shape). Both scan_while and domain? remain flattened:
# still exactly one used generic instance each, still capturing n/v
# directly (never char_at) as ordinary flattened parameters, not a
# per-call-site copy.
test blockescape-region-companion-refined-checks-3 {refined-checks.ir: scan_while/tld?/domain? flatten captures to [n, v] (domain_loop is gone; scan_while's own induction param is renamed i -> start) -- tld? and domain? remain one shared instance each; scan_while has one instance per exact predicate target (local_char?, str::is_tcl_alpha), each flattened (EXACT-CALLABLE-CLOSED-CALLER.md: blockescape de-closes a literal with several instances), and no closure is built} -body {
    core::loadLibrary web
    set hir [nativeHirOfIR [core::loadProgramFile [file join $::projectRoot bench refined-checks.ir]]]
    set nirText [dict get [native::lower::program $hir] text]
    set noDomainLoop [expr {![regexp {"domain_loop"} $nirText]}]
    list $noDomainLoop \
        [llength [regexp -all -inline {"scan_while" params=4 env=0 [^\n]*pnames="start predicate n v"} $nirText]] \
        [llength [regexp -all -inline {"tld\?" params=3 env=0 [^\n]*pnames="i n v"} $nirText]] \
        [llength [regexp -all -inline {"domain\?" params=3 env=0 [^\n]*pnames="start n v"} $nirText]] \
        [regexp -all {= closure } $nirText] [regexp -all {callvalue} $nirText]
} -result {1 2 1 1 0 0}

test blockescape-region-companion-refined-checks-4 {refined-checks.ir under GC stress: unchanged value, on the composed representation} -body {
    core::loadLibrary web
    set hir [nativeHirOfIR [core::loadProgramFile [file join $::projectRoot bench refined-checks.ir]]]
    set ::env(BOTLISH_NATIVE_GC_STRESS) 1
    set result [catch {native::evalHir $hir} value]
    unset ::env(BOTLISH_NATIVE_GC_STRESS)
    list $result $value
} -result {0 {list {{int 400} {int 0}}}}

# R2.a dropped this test's own pinned backedge count from 7 to 5: unifying
# scan_local/scan_label/scan_alpha into one scan_while removed two of the
# five self-tail-recursive scanner-family functions R2 left behind (three
# scanners -> one), each of whose own tail backedge was otherwise identical
# in kind (still a plain "tail", never "tailenv"/a real recursive call) --
# domain_loop's own self-tail-call and scan_while's own self-tail-call
# each counted once per compiled instance, and neither was duplicated per
# call site.
#
# R2.a.3 (R2A3-COUNTED-LOOPS-FINAL-SOURCE.md) drops it again, from 5 to 3:
# scan_while's own self-tail recursion is gone (native/lower.tcl's
# CountLoop lowers "loop i from start to n:" to a genuine `jump`/`label`
# CFG backedge, never `tail`), and domain_loop -- self-tail-recursive by
# construction -- no longer exists at all, replaced by the non-recursive
# domain?. The 3 `tail` sites left in this whole benchmark file are none
# of emailish?'s own helpers any more: they belong to uri_escape_text's
# esc_bytes/esc_from (unrelated, untouched by this milestone) and check's
# own self-tail recursion (the benchmark's own driver loop).
test blockescape-region-companion-refined-checks-5 {refined-checks.ir: R2.a.3 drops the backedge count from 5 to 3 -- scan_while/domain? no longer self-tail-recurse at all (their own counted-loop bodies are plain jump/label CFG backedges); the 3 remaining `tail` sites are esc_bytes/esc_from/check, none of them emailish?'s own} -body {
    core::loadLibrary web
    set hir [nativeHirOfIR [core::loadProgramFile [file join $::projectRoot bench refined-checks.ir]]]
    set nirText [dict get [native::lower::program $hir] text]
    list [regexp {tailenv} $nirText] [llength [regexp -all -inline -line {^\s+tail .*$} $nirText]]
} -result {0 3}

# ---------------------------------------------------------------------------
# Enclosing-instance consistency: a de-closure-converted binding's region is
# analyzed once per used instance of the enclosing function, and every one of
# them must prove the binding's references are exact calls. An enclosing
# function called through `list::at` of a known List is a materialized Block
# value too, so its generic (Block-value entry) instance is used and calls
# the nested closure's GENERIC instance, while the exact-callable instance
# calls a specialized one: both must be wanted (or the binding declined),
# never a call left with no internal variant (it used to throw "call ... of a
# de-closure-converted binding has no wanted callee instance (NATIVE BUG)").

# TEXT's value under interp, compile, cranelift-generic and cranelift, which
# must all agree.
proc backendParity {text} {
    set hir [sourceHir $text]
    set values {}
    foreach backend {interp compile cranelift-generic cranelift} {
        set outcome [outcomeUnderHir $backend $hir]
        if {[lindex $outcome 0] ne "value"} {
            error "$backend: $outcome"
        }
        lappend values [lindex $outcome 1]
    }
    if {[llength [lsort -unique $values]] != 1} {
        error "backends disagree: $values"
    }
    return [lindex $values 0]
}

set blockescapeEnclosingRepro {
fn f(a):
    k = 5
    fn g(x):
        x + k
    g(a)

fs = [f]
list::at(fs, 0)(3)
}

test blockescape-enclosing-instances-1 {a closure capturing a local, called inside a function that is itself called through list::at of a known List: every backend agrees} -body {
    backendParity $blockescapeEnclosingRepro
} -result 8

test blockescape-enclosing-instances-2 {...and the closure is still de-closure-converted: both its specialized and its generic instance (called from the enclosing function's Block-value entry) get an internal variant, and no Block is allocated} -body {
    set hir [native::prepareHir [sourceHir $blockescapeEnclosingRepro]]
    set spec [hir::specialize::analyze $hir]
    set be [hir::blockescape::analyze $hir $spec]
    list [lmap pair [hir::blockescape::wantedInstances $hir $spec $be] {lindex $pair 1}] \
        [blockAllocs $blockescapeEnclosingRepro 1]
} -result {{g<int> g<generic>} 0}

test blockescape-enclosing-instances-3 {two exact list::at calls at different indexes, each callee with a nested closure capturing a local} -body {
    backendParity {
fn f(a):
    k = 5
    fn g(x):
        x + k
    g(a)

fn h(a):
    m = 7
    fn q(x):
        x * m
    q(a) + q(1)

fs = [f, h]
[list::at(fs, 0)(3), list::at(fs, 1)(3), list::at(fs, 0)(10)]
    }
} -result {[8, 28, 15]}

test blockescape-enclosing-instances-4 {a nested closure capturing both a local and a parameter of a function called through list::at, plus a second closure calling the first} -body {
    backendParity {
fn f(a):
    k = 5
    fn g(x):
        x + k + a
    fn r(y):
        g(y) * 2
    r(a) + g(1)

fs = [f]
[list::at(fs, 0)(3), f(4)]
    }
} -result {[31, 36]}

