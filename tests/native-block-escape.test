    set nirText [dict get [native::lower::program [sourceHir $::atScanSrc] -block-escape-opt 0] text]
    list [blockAllocsOpt $::atScanSrc 0 1] [regexp {closure } $nirText] [regexp {callenvmulti} $nirText] \
        [native::evalHir [sourceHir $::atScanSrc] -block-escape-opt 0 -string-region-opt 1]
