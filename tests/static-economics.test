# static-economics.test -- the decision economics of `static compile:`
# (STATIC-COMPILE.md, "Decision economics"; hir/static.tcl's schedulers,
# hir/staticdeps.tcl's dependency analysis).
#
# * the semantics are frozen: the batched scheduler decides exactly the
#   program the sequential reference decides (every site's outcome and
#   reified diagnostic, the program's diagnostics, the decided HIR), on a
#   corpus covering every channel the dependency analysis models, and no
#   build contradicts a prediction;
# * the economics are pinned: whole-program builds do not grow with the
#   number of independent blocks, nested or top level; genuine dependency
#   chains keep their builds; the erased-callable contract serializes only
#   its contributors and consumers; method-style call decisions are reused
#   across rounds exactly;
# * the compiler properties the analysis relies on, pinned where they live.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
set ::sdRoot [file dirname [file dirname [file normalize [info script]]]]
source [file join $::sdRoot audit static-decisions tools lib.tcl]

# ---------------------------------------------------------------------------
# Helpers

# The HIR of SOURCE (-strict 0, warnings off) under SCHEDULER, for a Linux
# target (linuxTarget: the host's own on Linux), where std::linux::io is
# importable; a program importing no platform namespace is every target's.
proc seHir {source {scheduler batched}} {
    set saved $hir::static::scheduler
    set hir::static::scheduler $scheduler
    try {
        return [surface::compile $source -strict 0 -warnings off -target [linuxTarget]]
    } finally {
        set hir::static::scheduler $saved
    }
}

# {ROUNDS BUILDS METHOD-TRIALS} of SOURCE under SCHEDULER.
proc seEcon {source {scheduler batched}} {
    set s [dict get [seHir $source $scheduler] staticStats]
    return [list [dict get $s rounds] [dict get $s builds] [dict get $s methodTrials]]
}

# "" if the batched scheduler decides SOURCE exactly as the sequential one
# (and, with LEGACY, as the legacy one up to its schedule's internal ids),
# else the first difference.
proc seSame {source {legacy 1}} {
    # (For a Linux target, as seHir.)
    set b [sdCompile batched $source <input> [linuxTarget]]
    if {[dict get $b error] ne ""} {
        # Two compilations that fail alike are no evidence of anything.
        return "does not compile: [string range [dict get $b error] 0 300]"
    }
    set diff [sdDiff $b [sdCompile sequential $source <input> [linuxTarget]]]
    if {$diff eq "" && $legacy} {
        set diff [sdDiff $b [sdCompile legacy $source <input> [linuxTarget]] 1]
    }
    return $diff
}

# The site outcomes of SOURCE (batched), in post-order: accepted or the
# rejection's kind.
proc seOutcomes {source} {
    return [lmap {key site} [hir::static::sites [seHir $source]] {
        expr {[dict get $site outcome] eq "rejected" ? [dict get $site diagnostic kind] : [dict get $site outcome]}
    }]
}

# The golden framework's K-case suite: every third case rejected with
# REJECTION (none, unbound, type), the bodies nested in the registration
# function (NESTED 1) or each at the top level.
proc seSuite {k rejection nested} {
    set lines {"import std::compiler" "import std::test" ""}
    set registrations {}
    set pad [expr {$nested ? "    " : ""}]
    if {$nested} {
        lappend lines "fn register_bench():"
    }
    for {set i 0} {$i < $k} {incr i} {
        lappend lines "${pad}fn body_${i}() errors std::compiler::CompilerError:" "${pad}    static compile:"
        if {$rejection ne "none" && $i % 3 == 2} {
            if {$rejection eq "unbound"} {
                lappend lines "${pad}        missing_$i + 7"
                set code Unbound
            } else {
                lappend lines "${pad}        fn want_${i}(x: int) -> int:" "${pad}            x" "${pad}        want_${i}(\"s\")"
                set code Type
            }
            set registration "std::test::rejects(\"t$i\", std::compiler::DiagnosticCode::$code, body_${i})"
        } else {
            lappend lines "${pad}        7 * $i + $i"
            set registration "std::test::value(\"t$i\", 7 * $i + $i, body_${i})"
        }
        if {$nested} {
            lappend lines "    $registration"
        } else {
            lappend registrations "    $registration"
        }
    }
    if {!$nested} {
        lappend lines "fn register_bench():" {*}$registrations
        if {$k == 0} { lappend lines "    return" }
    }
    lappend lines "" "with context std::test::suite()" "register_bench()" "std::test::report()" ""
    return [join $lines \n]
}

# The erased-callable reproducer of tests/static-compile.test (`call` cannot
# infer a contract for f, so what reaches it is erased): `generic` erases E1
# from the top level; a contributor block erases E2 as well; a consumer
# block handles E1 only around generic(0), which is charged everything the
# program erases.
set ::seErased {import std::compiler

error E1
error E2

fn raise1(x) -> int errors E1:
    if x == 1:
        fail E1
    0

fn raise2(x) -> int errors E2:
    if x == 2:
        fail E2
    0

fn call(f, x):
    f(x)

fn generic(x) -> int errors E1:
    call(raise1, x)

}
set ::seContributor {"fn gen2(x) -> int errors E2:" "    call(raise2, x)" "r = gen2(0):" "    on E2:" "        0" "r"}
set ::seConsumer {"r = generic(0):" "    on E1:" "        -1" "r"}

# A site function: name NAME, body lines BODY.
proc seSite {name body} {
    set lines [list "fn ${name}() -> int errors std::compiler::CompilerError:" "    static compile:"]
    foreach line $body {
        lappend lines "        $line"
    }
    return [join $lines \n]\n
}

proc seTypeFail {i} {
    return [list "fn want_${i}(x: int) -> int:" "    x" "want_${i}(\"s\")"]
}

# The ownership verdict (hir/staticdeps.tcl's C:verdict): release scopes,
# and so AFFINE-PATH-RELEASE-UNSUPPORTED, exist only while no code anywhere
# has an ownership diagnostic. A prelude of coroutine handles and a vector of
# them; site bodies with a whole-program ownership diagnostic (a vector
# used after its move, a collecting loop of handles) and one whose handle is
# moved on a counted loop's break path but still owned when the loop runs
# out (TAIL: its last line).
set ::seOwnership {import std::compiler
import std::mutable_vector

error Boom

struct Command:
    value: int

struct Event:
    value: int

fn worker(seed: int, resume Command) -> Event:
    command = yield Event {value: seed}
    return Event {value: command.value + seed}

fn make(seed: int) -> Coroutine{args: [Command], return: Event}:
    coroutine {step} = worker(seed)
    step

fn empty_queue() -> MutableVector[Coroutine{args: [Command], return: Event}]:
    std::mutable_vector::from_list([])

fn boom() -> int errors Boom:
    fail Boom

}
set ::seMovedVector {"fn f() -> int:" "    q = empty_queue()" "    w = q" "    std::mutable_vector::length(q)" "f()"}
set ::seCollectHandles {"fn f() -> int:" "    xs = loop i from 0 to 2:" "        make(i)" "    1" "f()"}
set ::seMovedHandle {"fn f() -> int:" "    s = make(1)" "    t = s" "    e = s(Command {value: 1})" "    e.value" "f()"}
proc sePathRelease {{tail 1}} {
    return [list "fn f() -> int:" "    v = empty_queue()" "    s = make(1)" "    loop i from 0 to 3:" \
        "        if i == 1:" "            v.push(s)" "            break" "    $tail" "f()"]
}

# The ownership prelude with sites NAME BODY ..., each called under a handler
# (NAME -text: BODY is written as it is, and not called).
proc seOwnershipProgram {args} {
    set text $::seOwnership
    set calls ""
    foreach {name body} $args {
        if {$name eq "-text"} {
            append text $body
            continue
        }
        append text [seSite $name $body]
        append calls "r_$name = ${name}():\n    on std::compiler::CompilerError:\n        -1\n"
    }
    return "$text${calls}0\n"
}

# The gate of the trait monomorphization's plan (hir/staticdeps.tcl's
# C:plan): sites NAME ..., each `a`/`b`/`tN` a TYPE failure and `nested` a
# generic function declared inside another one given a coroutine handle
# (AFFINE-GENERIC-NESTED-UNSUPPORTED, which only the plan reports), each
# called under a handler.
proc sePlanAffine {names} {
    set text "import std::compiler\n\nstruct Message:\n    value: int\n\nstruct Event:\n    value: int\n\nfn worker(seed: int, resume Message) -> Event:\n    m = yield Event \{value: seed\}\n    return Event \{value: m.value + seed\}\n\nfn make(seed: int) -> Coroutine\{args: \[Message\], return: Event\}:\n    coroutine \{step\} = worker(seed)\n    step\n\nfn want(x: int) -> int:\n    x\n\n"
    set calls ""
    foreach name $names {
        if {$name eq "nested"} {
            append text [seSite $name {"fn outer() -> int:" "    fn inner(c):" "        c(Message {value: 1})" "    e = inner(make(1))" "    e.value" "outer()"}]
        } else {
            append text [seSite $name [list "want(\"$name\")"]]
        }
        append calls "r_$name = ${name}():\n    on std::compiler::CompilerError:\n        -1\n"
    }
    return "$text${calls}0\n"
}

# Two sites holding TRAIT-IMPL-ORDER (the plan's last stage): the
# implementation of `name` is declared after the top-level call that needs
# `first`'s specialization, which needs `second`'s.
proc sePlanTraits {} {
    return "import std::compiler\n\ntrait Named:\n    fn name(value: Named) -> str\n\nstruct Person:\n    v: str\n\nfn second(v: Named) -> str errors std::compiler::CompilerError:\n    static compile:\n        v.name()\n\nfn first(v: Named) -> str errors std::compiler::CompilerError:\n    static compile:\n        a = v.name()\n        second(v)\n\nr0 = first(Person \{v: \"a\"\}):\n    on std::compiler::CompilerError:\n        \"rejected\"\n\nfn name(p: Person) -> str:\n    p.v\n\nr1 = second(Person \{v: \"b\"\}):\n    on std::compiler::CompilerError:\n        \"rejected\"\n\[r0, r1\]\n"
}

# Two trait-polymorphic functions whose bodies are sites holding a trait
# operation, each first needed (its specialization placed) before its
# implementation is declared: TRAIT-IMPL-ORDER at both, the plan's, and
# nothing else links them. The first one's caller is called at the top level
# without a handler, so its rejection makes that call an UNHANDLED-ERROR --
# a diagnostic in no site, which closes the gate again.
set ::sePlanReclosed {import std::compiler

trait LateNamed:
    fn late_name(value: LateNamed) -> str

struct LatePerson:
    v: str

fn late_named(v: LateNamed) -> str errors std::compiler::CompilerError:
    static compile:
        v.late_name()

fn early() -> str errors std::compiler::CompilerError:
    late_named(LatePerson {v: "a"})

fn late_name(p: LatePerson) -> str:
    p.v

trait OtherNamed:
    fn other_name(value: OtherNamed) -> str

struct OtherPerson:
    v: str

fn other_named(v: OtherNamed) -> str errors std::compiler::CompilerError:
    static compile:
        v.other_name()

fn early_other() -> str errors std::compiler::CompilerError:
    other_named(OtherPerson {v: "b"})

fn other_name(p: OtherPerson) -> str:
    p.v

a = early()
b = early_other():
    on std::compiler::CompilerError:
        "rejected"
0
}

# A generic top-level function whose body is a site giving its untyped
# parameter to a nested generic function: specialized for a coroutine handle
# (a clone, AFFINE-VALUES.md) only once its caller's argument is one -- here
# when a rejection makes the other branch of the `if` producing it `never`.
# In the clone's view the nested call is AFFINE-GENERIC-NESTED-UNSUPPORTED,
# the plan's, though nothing of the site's own changed.
set ::sePlanClone {import std::compiler

struct Command:
    value: int

struct Event:
    value: int

fn worker(seed: int, resume Command) -> Event:
    command = yield Event {value: seed}
    return Event {value: command.value + seed}

fn make(seed: int) -> Coroutine{args: [Command], return: Event}:
    coroutine {step} = worker(seed)
    step

fn want_int(x: int) -> int:
    x

fn first() -> int errors std::compiler::CompilerError:
    static compile:
        want_int("a")

fn keep(h) -> int errors std::compiler::CompilerError:
    static compile:
        fn inner(c) -> int:
            1
        inner(h)

fn pick() errors std::compiler::CompilerError:
    static compile:
        want_int("b")

fn caller(flag: bool) -> int errors std::compiler::CompilerError:
    x = if flag:
        make(1)
    else:
        pick()
    keep(x)

r1 = first():
    on std::compiler::CompilerError:
        -1
r2 = caller(true):
    on std::compiler::CompilerError:
        -1
0
}

# A site calling a trait-polymorphic function that has its instance (`d`),
# beside two checker failures, one in that function's own site (`f_poly`):
# the call is no consumer of the plan's gate -- the plan reports at a call of
# such a function only where a context it walks has no instance for it
# (TRAIT-INSTANCE-BUDGET) -- so `w`, the gate's witness, does not join its
# component.
set ::sePlanInstances {import std::compiler

trait Shape:
    fn area(shape: Shape) -> int

struct Square:
    side: int

fn area(s: Square) -> int:
    s.side

fn want_int(x: int) -> int:
    x

fn f_poly(s: Shape) -> int errors std::compiler::CompilerError:
    static compile:
        s.area() + want_int("f")

fn p_poly(s: Shape) -> int errors std::compiler::CompilerError:
    static compile:
        s.area()

fn d() -> int errors std::compiler::CompilerError:
    static compile:
        f_poly(Square {side: 2})

fn w() -> int errors std::compiler::CompilerError:
    static compile:
        want_int("w")

r_p = p_poly(Square {side: 3}):
    on std::compiler::CompilerError:
        -1
r_d = d():
    on std::compiler::CompilerError:
        -1
r_w = w():
    on std::compiler::CompilerError:
        -1
0
}

# A call of a trait-polymorphic function that has no instance (`use`): its
# argument, mk(), is `never` once mk's site is rejected (a dead call is
# never requested). The plan once reported TRAIT-INSTANCE-BUDGET there,
# though the call never runs (COMPILER-BOTTLENECKS.md, 4.2); it now keeps the
# arguments and calls the placeholder of never-executed code instead, and
# reports nothing. The gate still counts the site as its consumer (Unplanned
# asks only whether an instance exists), which costs it nothing here. (A
# nesting decline is the other way to lack an instance, and needs a chain of
# instances deeper than a test can build: past the per-block budget a
# trait-polymorphic request is granted however deep.) Two checker failures
# that wait for mk's rejection, x1 and x2, keep the gate closed in the build
# that first finds `use` dead.
set ::sePlanUnplanned {import std::compiler

trait Shape:
    fn area(s: Shape) -> int

struct Square:
    side: int

fn area(s: Square) -> int:
    s.side

fn measure(s: Shape) -> int:
    s.area()

fn want(x: int) -> int:
    x

fn mk() errors std::compiler::CompilerError:
    static compile:
        Square {side: want("mk")}

fn x1() -> int errors std::compiler::CompilerError:
    static compile:
        a = mk()
        want("x1")

fn x2() -> int errors std::compiler::CompilerError:
    static compile:
        a = mk()
        want("x2")

fn use() -> int errors std::compiler::CompilerError:
    static compile:
        measure(mk())

r1 = x1():
    on std::compiler::CompilerError:
        -1
r2 = x2():
    on std::compiler::CompilerError:
        -1
r3 = use():
    on std::compiler::CompilerError:
        -1
0
}

# A chain c1 .. cN of untyped functions, N one past the semantic layer's
# nesting limit (hir::semantic's maxDepth): `late`'s call c1(1) requests cN's
# int instance that deep, a cache hit while `early`'s body requests it
# directly first, declined for nesting once `early` is rejected -- then
# c1(1) keeps its generic result, `any`, a TYPE failure at want(...).
# `other` is a second, independent failure.
proc seDeepFirstRequest {} {
    set n [expr {$hir::semantic::maxDepth + 1}]
    set text "import std::compiler\n\nfn want(x: int) -> int:\n    x\n\nfn c$n\(x):\n    x\n\n"
    for {set i [expr {$n - 1}]} {$i >= 1} {incr i -1} {
        append text "fn c$i\(x):\n    c[expr {$i + 1}](x)\n\n"
    }
    append text [seSite early [list "c$n\(1) + want(\"early\")"]]
    append text [seSite late {"want(c1(1))"}]
    append text [seSite other {{want("other")}}]
    foreach name {other early late} {
        append text "r_$name = ${name}():\n    on std::compiler::CompilerError:\n        -1\n"
    }
    return "${text}0\n"
}

# K sibling functions, each with a checker-rejected site, nested in one
# enclosing site (the golden framework's registration function, written as
# a static block), or (NESTED 0) in a plain function.
proc seSiblings {k {nested 1}} {
    set text "import std::compiler\n\nfn want(x: int) -> int:\n    x\n\nfn outer() -> int errors std::compiler::CompilerError:\n"
    set pad [expr {$nested ? "        " : "    "}]
    if {$nested} {
        append text "    static compile:\n"
    }
    for {set i 0} {$i < $k} {incr i} {
        append text "${pad}fn t$i\() -> int errors std::compiler::CompilerError:\n$pad    static compile:\n$pad        want(\"s$i\")\n"
    }
    append text "${pad}0\nr = outer():\n    on std::compiler::CompilerError:\n        -1\nr\n"
    return $text
}

# K sites, each passing a function that raises nothing (or, with ERRORS,
# declares an error) to the untyped std::list::any? -- each an erasure site of
# the erased-callable contract and a caller of its consumer -- and each
# rejected for its function's representation access (OPAQUE-REPRESENTATION).
proc seErasingSites {k {errors 0}} {
    set text "import std::abi::bytes\nimport std::compiler\nimport std::list\n\nerror Boom\n\nfn run(body) -> int:\n    v = body():\n        on std::compiler::CompilerError:\n            return 1\n    0\n\n"
    set calls {}
    for {set i 0} {$i < $k} {incr i} {
        set peek [expr {$errors ? "fn peek(x) -> bool errors Boom:" : "fn peek(x):"}]
        append text "fn b$i\() errors std::compiler::CompilerError, Boom:\n    static compile:\n        b = std::abi::bytes::from_list(\[\])\n        $peek\n            x.storage\n        std::list::any?(\[b\], peek)\n\n"
        lappend calls "run(b$i)"
    }
    return "$text\[[join $calls {, }]\]\n"
}

# K sites each passing raise (declaring E1, E2) through make's untyped
# parameter into a structural Fn (use's): the contract-boundary check at
# each reads what make's parameter may hold -- raise, from every site -- and
# each handles E2 only (UNHANDLED-ERROR).
proc seSubsumeSites {k} {
    set text "import std::compiler\n\nerror E1\nerror E2\n\nfn raise(x) -> int errors E1, E2:\n    if x == 1:\n        fail E1\n    if x == 2:\n        fail E2\n    0\n\nfn make(f):\n    fn inner(y):\n        f(y)\n    inner\n\nfn use(kf: Fn\{args: \[int\], return: any, errors: \[E1, E2\]\}, x: int) errors E1, E2:\n    kf(x)\n\n"
    set calls {}
    for {set i 0} {$i < $k} {incr i} {
        append text [seSite t$i [list "r = use(make(raise), $i):" "    on E2:" "        -2" "1"]]
        append text "r_t$i = t$i\():\n    on std::compiler::CompilerError:\n        -1\n"
    }
    return "${text}0\n"
}

# The contract-boundary checks (hir::completions::Subsume) and the edges a
# site's diagnostics take from them (hir/staticdeps.tcl, Z:site): a
# contributor block that erases raise_e (E) through the untyped `call` and is
# rejected by the checker, which leaves the program erasing nothing; a
# coroutine whose root calls a callable passed to its construction (worker),
# one that calls none (counter), and a function taking a handle whose
# contract admits no error (drive). std::mutable_array::generate calls its second
# argument: given a Fn type leaving that argument uncontracted, it may raise
# whatever the program erases (hir::completions::ArgumentFact) -- the one
# report no erased consumer's region leads to.
set ::seBoundary {import std::compiler
import std::mutable_array

error E

struct M:
    value: int

struct Ev:
    value: int

fn raise_e(x) -> int errors E:
    fail E

fn call(f, x):
    f(x)

fn want_int(x: int) -> int:
    x

fn worker(f, resume M) -> Ev:
    m = yield Ev {value: 0}
    x = f(m)
    Ev {value: 1}

fn counter(resume M) -> Ev:
    m = yield Ev {value: 0}
    Ev {value: m.value}

fn drive(c: Coroutine{args: [M], return: Ev, errors: []}) -> int:
    e = c(M {value: 1})
    e.value

}
set ::seBoundaryContributor {"r = call(raise_e, 0):" "    on E:" "        0" "want_int(\"s\")"}

# The boundary prelude with sites NAME BODY ..., each called under a
# handler.
proc seBoundaryProgram {args} {
    set text $::seBoundary
    set calls ""
    foreach {name body} $args {
        append text [seSite $name $body]
        append calls "r_$name = ${name}():\n    on std::compiler::CompilerError:\n        -1\n"
    }
    return "$text${calls}0\n"
}

# ---------------------------------------------------------------------------
# The semantics are frozen

test se-equal-independent {independent failures at every stage, nested in one function and at the top level: the batched decisions are the sequential ones} -body {
    set nested "import std::compiler\n\nfn needs_int(v: int) -> int:\n    v\n\nfn run() -> int:\n"
    set top "import std::compiler\n\nfn needs_int(v: int) -> int:\n    v\n\n"
    set calls {}
    for {set i 0} {$i < 9} {incr i} {
        switch [expr {$i % 3}] {
            0 { set body [list "$i + 1"] }
            1 { set body [list "missing_$i"] }
            2 { set body [list "needs_int(\"s$i\")"] }
        }
        append top [seSite t$i $body]\n
        foreach line [split [seSite t$i $body] \n] {
            if {$line ne ""} { append nested "    $line\n" }
        }
        lappend calls "r$i = t${i}():\n    on std::compiler::CompilerError:\n        -1\n"
    }
    append nested "    0\n\nrun()\n"
    append top [join $calls ""] "0\n"
    list [seSame $nested] [seSame $top] [seOutcomes $nested] [seEcon $nested] [seEcon $top]
} -result {{} {} {accepted UNBOUND TYPE accepted UNBOUND TYPE accepted UNBOUND TYPE} {3 3 0} {3 3 0}}

test se-equal-sequence {sites in one function's statement sequence are judged one after another: an earlier rejection makes the code after it unreachable, where completion diagnostics are not reported -- the later site is accepted, as in the sequential order} -body {
    set text "import std::compiler\n\nerror Boom\n\nfn boom() errors Boom:\n    fail Boom\n\nfn run() -> int errors std::compiler::CompilerError:\n    static compile:\n        missing_name\n    static compile:\n        boom()\n    0\n\nr = run():\n    on std::compiler::CompilerError:\n        0\nr\n"
    list [seSame $text] [seOutcomes $text]
} -result {{} {UNBOUND accepted}}

test se-equal-ownership-siblings {sibling blocks with ownership effects: a rejected block's move of a coroutine handle is gone with it (the block after it in the same function is accepted), beside an independent USE-AFTER-MOVE and an accepted block whose handle lives across an error edge -- the batched decisions are the sequential ones} -body {
    set text "import std::compiler\n\nerror Boom\n\nfn boom(x: int) -> int errors Boom:\n    if x > 5:\n        fail Boom\n    x\n\nfn needs_int(v: int) -> int:\n    v\n\nfn producer():\n    yield 1\n    2\n\n"
    append text "fn run() -> int errors std::compiler::CompilerError:\n    coroutine \{step\} = producer()\n    static compile:\n        other = step\n        needs_int(\"s\")\n    static compile:\n        step()\n    0\n\n"
    append text [seSite moved [list "coroutine {step: s1} = producer()" "other = s1" "s1()" "0"]]
    append text [seSite edge [list "coroutine {step: s2} = producer()" "r = boom(3):" "    on Boom:" "        0" "s2()" "r"]]
    append text "r0 = run():\n    on std::compiler::CompilerError:\n        -1\nr1 = moved():\n    on std::compiler::CompilerError:\n        -1\nr2 = edge():\n    on std::compiler::CompilerError:\n        -1\n\[r0, r1, r2\]\n"
    list [seSame $text] [seOutcomes $text]
} -result {{} {TYPE accepted USE-AFTER-MOVE accepted}}

test se-equal-nested-chain {a nested block whose rejection rejects the block around it: the outer one is judged only after the inner one, one build per level} -body {
    set text "import std::compiler\n\nfn outer() -> int errors std::compiler::CompilerError:\n    static compile:\n        fn level_0() -> int:\n            static compile:\n                fn level_1() -> int:\n                    static compile:\n                        missing\n                level_1()\n        level_0()\n\nr = outer():\n    on std::compiler::CompilerError:\n        0\nr\n"
    list [seSame $text] [seOutcomes $text] [lindex [seEcon $text] 0]
} -result {{} {UNBOUND UNHANDLED-ERROR UNHANDLED-ERROR} 4}

test se-equal-nested-checked {a nested block rejected by the checker: the block around it is judged again once it is -- its first diagnostic is then the inner block's unadmitted CompilerError, not its own type error} -body {
    set text "import std::compiler\n\nfn want_int(x: int) -> int:\n    x\n\nfn outer() -> int errors std::compiler::CompilerError:\n    static compile:\n        fn level_0() -> int:\n            static compile:\n                want_int(\"s\")\n        want_int(\"t\")\n        level_0()\n\nr = outer():\n    on std::compiler::CompilerError:\n        0\nr\n"
    list [seSame $text] [seOutcomes $text] [lindex [seEcon $text] 0]
} -result {{} {TYPE UNHANDLED-ERROR} 3}

test se-equal-internal-ids {a rejection whose message names internal ids (the numbering of the build it came from) carries the sequential order's message: it is decided in the sequential order's own build} -body {
    # Each block's message names its own struct's exact callable type,
    # `block(eN)`, numbered after every earlier block.
    set text "import std::compiler\n\nfn cb(s, x: int) -> int:\n    x\n\n"
    for {set i 0} {$i < 4} {incr i} {
        append text [seSite t$i [list "fn f_$i\(x: int) -> int:" "    x" "s = \{cb: f_$i, v: $i\}" "s.cb(1)"]]\n
        append text "r$i = t${i}():\n    on std::compiler::CompilerError:\n        -1\n"
    }
    append text "0\n"
    set outcomes [seOutcomes $text]
    set messages [lmap {key site} [hir::static::sites [seHir $text]] {
        expr {[regexp {block\(e[0-9]+\)} [dict get $site diagnostic message]]}
    }]
    list [seSame $text 0] [lsort -unique $outcomes] $messages
} -result {{} AMBIGUOUS-METHOD-CALL {1 1 1 1}}

test se-equal-erased {the erased-callable contract: a consumer judged against what the program erases, independent failures beside it -- the batched decisions are the sequential ones} -body {
    set text $::seErased
    append text [seSite contributor $::seContributor]
    append text [seSite consumer $::seConsumer]
    for {set i 0} {$i < 4} {incr i} {
        append text [seSite t$i [seTypeFail $i]]
    }
    foreach name {contributor consumer t0 t1 t2 t3} {
        append text "r_$name = ${name}():\n    on std::compiler::CompilerError:\n        -1\n"
    }
    append text "0\n"
    list [seSame $text] [seOutcomes $text]
} -result {{} {accepted accepted TYPE TYPE TYPE TYPE}}

test se-equal-erased-consumer {a genuine consumer of the erased-callable contract: a callable read from a List[any] has neither identity nor contract, so its call is charged what the program erases -- E2 while the contributor's body erases raise2 (UNHANDLED-ERROR), nothing once that body is rejected (accepted)} -body {
    set text "import std::compiler\nimport std::list\n\nerror E1\nerror E2\n\nfn harmless() -> int:\n    1\n\nfn raise2() -> int errors E2:\n    fail E2\n\nfn store(f) -> int:\n    1\n\n"
    append text [seSite contributor [concat {"r = store(raise2)"} [seTypeFail 0]]]
    append text [seSite consumer {"fn run(fs: List\[any\]) errors IndexNotFound:" "    f = std::list::at(fs, 0)" "    f()" "r = run(\[harmless\]):" "    on IndexNotFound:" "        -2" "1"}]
    append text "r1 = contributor():\n    on std::compiler::CompilerError:\n        -1\nr2 = consumer():\n    on std::compiler::CompilerError:\n        -1\nr1 + r2\n"
    set hir::static::trace 1
    try {
        set hir [seHir $text]
    } finally {
        set hir::static::trace 0
    }
    list [seSame $text] [seOutcomes $text] [dict get $hir staticStats rounds] \
        [llength [dict get [lindex [dict get $hir staticStats trace] 0] deferred]]
} -result {{} {TYPE accepted} 2 1}

# The consumer and contributor of se-equal-erased-consumer as two
# functions, the consumer's written first when CONSUMERFIRST.
proc seConsumerContributor {consumerFirst} {
    set text "import std::compiler\nimport std::list\n\nerror E2\n\nfn raise_e2() -> int errors E2:\n    fail E2\n\nfn store(f) -> int:\n    1\n\nfn harmless() -> int:\n    1\n\n"
    set consumer [seSite consumer {"fn run(fs: List\[any\]) errors IndexNotFound:" "    f = std::list::at(fs, 0)" "    f()" "r = run(\[harmless\]):" "    on IndexNotFound:" "        -2" "1"}]
    set eraser [seSite eraser [concat {"r = store(raise_e2)"} [seTypeFail 0]]]
    append text [expr {$consumerFirst ? "$consumer$eraser" : "$eraser$consumer"}]
    append text "a = consumer():\n    on std::compiler::CompilerError:\n        -1\nb = eraser():\n    on std::compiler::CompilerError:\n        -1\n\[a, b\]\n"
    return $text
}

test se-equal-consumer-waits {the waiting rule: a consumer of the erased-callable contract is judged only once no failing contributor remains, so its verdict does not depend on where it is written -- written first, it waits for the contributor's rejection and is accepted, as when written second; batched, sequential and legacy decide alike, in the same rounds} -body {
    set results {}
    foreach consumerFirst {1 0} {
        set text [seConsumerContributor $consumerFirst]
        lappend results [seSame $text] [seOutcomes $text] [lindex [seEcon $text] 0]
    }
    set hir::static::trace 1
    try {
        set stats [dict get [seHir [seConsumerContributor 1] sequential] staticStats]
    } finally {
        set hir::static::trace 0
    }
    set deferred [dict get [lindex [dict get $stats trace] 0] deferred]
    lappend results [llength $deferred] \
        [regexp {^waits for f[0-9]+:[0-9]+, a failing contributor to the erased-callable contract it consumes$} \
            [lindex $deferred 0 1]]
} -result {{} {accepted TYPE} 2 {} {TYPE accepted} 2 1 1}

test se-equal-consumer-waits-residual {the residual case of the waiting rule (STATIC-COMPILE.md): a contributor whose own verdict another block decides -- the erasing block is ok until the block nested in a function in its body is rejected (TYPE), whose CompilerError that function does not admit; then it is rejected too and the program erases nothing. The contributors are the blocks holding a contribution, not closed under what they read (that closure made ordinary failures wait for each other, one build each), so a consumer written first does not wait for the nested block and is rejected (UNHANDLED-ERROR); written second it is judged once the eraser is gone and accepted. Batched, sequential and legacy decide alike} -body {
    set results {}
    foreach consumerFirst {1 0} {
        set text "import std::compiler\nimport std::list\n\nerror E2\n\nfn raise_e2() -> int errors E2:\n    fail E2\n\nfn store(f) -> int:\n    1\n\nfn harmless() -> int:\n    1\n\n"
        set consumer [seSite consumer {"fn run(fs: List\[any\]) errors IndexNotFound:" "    f = std::list::at(fs, 0)" "    f()" "r = run(\[harmless\]):" "    on IndexNotFound:" "        -2" "1"}]
        set eraser [seSite eraser [concat {"r = store(raise_e2)" "fn g() -> int:" "    static compile:"} \
            [lmap line [seTypeFail 0] {string cat "        " $line}] {"    1" "g()"}]]
        append text [expr {$consumerFirst ? "$consumer$eraser" : "$eraser$consumer"}]
        append text "a = consumer():\n    on std::compiler::CompilerError:\n        -1\nb = eraser():\n    on std::compiler::CompilerError:\n        -1\n\[a, b\]\n"
        lappend results [seSame $text] [seOutcomes $text]
    }
    set results
} -result {{} {UNHANDLED-ERROR TYPE UNHANDLED-ERROR} {} {TYPE UNHANDLED-ERROR accepted}}

test se-builds-erasing-consumers {blocks that each erase and each call through an uncontracted value, failing for a reason of their own the completion walk reports (KNOWN-ERROR: always() never completes normally): each consumes what the others contribute, so they wait on each other -- a cycle, decided in post-order in one build (2 rounds at 4 and 8 blocks), as before the waiting rule: the contributors are every block holding a contribution, not only the witness, which would make each wait on the last of them, one build each (mutant erasure-contributors-witnesses-only)} -body {
    set results {}
    foreach n {4 8} {
        set text "import std::compiler\nimport std::list\n\nerror E\nerror Boom\n\nfn raise_e() -> int errors E:\n    fail E\n\nfn always() -> int errors Boom:\n    fail Boom\n\nfn store(f) -> int:\n    1\n\nfn harmless() -> int:\n    1\n\n"
        set calls {}
        for {set i 0} {$i < $n} {incr i} {
            append text [seSite s$i {"s = store(raise_e)" "fn run(fs: List\[any\]) errors IndexNotFound, E:" "    f = std::list::at(fs, 0)" \
                "    f()" "r = run(\[harmless\]):" "    on IndexNotFound:" "        -2" "    on E:" "        -3" "always()"}]
            append calls "r$i = s${i}():\n    on std::compiler::CompilerError:\n        -1\n"
        }
        append text $calls "0\n"
        lappend results [seSame $text 0] [lsort -unique [seOutcomes $text]] [lindex [seEcon $text] 0]
    }
    set results
} -result {{} KNOWN-ERROR 2 {} KNOWN-ERROR 2}

test se-builds-early-consumer {a block that calls through an uncontracted value but fails with a diagnostic reported before the completion walk (TYPE) does not wait for the erased contract's failing contributor: no erasure can cause or precede that diagnostic (only the ownership analysis's exit releases read the contract before the walk, and they report nothing), so both blocks are rejected in the first build -- 2 rounds, not 3 (mutant early-consumes-erased)} -body {
    set text "import std::compiler\nimport std::list\n\nerror E\n\nfn raise_e() -> int errors E:\n    fail E\n\nfn store(f) -> int:\n    1\n\nfn harmless() -> int:\n    1\n\nfn want(x: int) -> int:\n    x\n\n"
    append text [seSite y {"fn run(fs: List\[any\]) errors IndexNotFound:" "    f = std::list::at(fs, 0)" "    f()" "r = run(\[harmless\]):" "    on IndexNotFound:" "        -2" {want("y")}}]
    append text [seSite z {"s = store(raise_e)" {want("z")}}]
    append text "ry = y():\n    on std::compiler::CompilerError:\n        -1\nrz = z():\n    on std::compiler::CompilerError:\n        -1\n0\n"
    list [seSame $text] [seOutcomes $text] [lindex [seEcon $text] 0]
} -result {{} {TYPE TYPE} 2}

# Block NAME erasing raise_E (store's untyped parameter) and calling through
# an `any` element under a handler of IndexNotFound and E only, then failing
# with KNOWN-ERROR when BAD (always() never completes normally: a diagnostic
# of the completion walk, so the block still consumes what the program
# erases).
proc seErasingConsumer {name e bad} {
    set E [string toupper $e]
    set body [list "s = store(raise_$e)" "fn run_${name}(fs: List\[any\]) errors IndexNotFound, $E:" \
        "    f = std::list::at(fs, 0)" "    f()" "r = run_${name}(\[harmless\]):" "    on IndexNotFound:" "        -2" \
        "    on $E:" "        -3"]
    return [seSite $name [concat $body [expr {$bad ? {always()} : {1}}]]]
}

test se-equal-channel-cycle {a cycle through the erased-callable contract: each block erases what the other's call through an uncontracted value does not admit, and fails for a reason the completion walk reports (b: KNOWN-ERROR), so each waits on the other and the first in post-order is rejected -- for the other's erasure (UNHANDLED-ERROR), whichever it is: one of the places the waiting rule leaves a verdict to layout (STATIC-COMPILE.md, "The waiting rule"); batched, sequential and legacy decide alike} -body {
    set results {}
    foreach order {{a b} {b a}} {
        set text "import std::compiler\nimport std::list\n\nerror E1\nerror E2\nerror Boom\n\nfn raise_e1() -> int errors E1:\n    fail E1\n\nfn raise_e2() -> int errors E2:\n    fail E2\n\nfn always() -> int errors Boom:\n    fail Boom\n\nfn store(f) -> int:\n    1\n\nfn harmless() -> int:\n    1\n\n"
        foreach name $order {
            append text [seErasingConsumer $name [expr {$name eq "a" ? "e1" : "e2"}] [expr {$name eq "b"}]]
        }
        append text "ra = a():\n    on std::compiler::CompilerError:\n        -1\nrb = b():\n    on std::compiler::CompilerError:\n        -1\n\[ra, rb\]\n"
        lappend results [seSame $text] [seOutcomes $text]
    }
    set results
} -result {{} {UNHANDLED-ERROR KNOWN-ERROR} {} {UNHANDLED-ERROR accepted}}

test se-equal-multiple-contributors {several contributors, rejected by the checker and by resolution: the consumer is judged against the contract their final forms leave} -body {
    set text $::seErased
    append text [seSite c1 [concat $::seContributor [seTypeFail 9]]]
    append text [seSite c2 [concat $::seContributor {missing_name}]]
    append text [seSite consumer $::seConsumer]
    foreach name {c1 c2 consumer} {
        append text "r_$name = ${name}():\n    on std::compiler::CompilerError:\n        -1\n"
    }
    append text "0\n"
    list [seSame $text] [seOutcomes $text]
} -result {{} {TYPE UNBOUND accepted}}

test se-equal-untyped-capture {two blocks capturing an untyped parameter of the function around them: its contract is inferred from every use, so one block's use can fail the other -- which is judged again once the first is rejected} -body {
    set text "import std::compiler\nimport std::str\n\nfn want_int(x: int) -> int:\n    x\n\nfn register(n) -> int:\n    fn a() -> int errors std::compiler::CompilerError:\n        static compile:\n            q = std::str::length(n)\n            want_int(\"s\")\n    fn b() -> int errors std::compiler::CompilerError:\n        static compile:\n            want_int(n)\n    ra = a():\n        on std::compiler::CompilerError:\n            -1\n    rb = b():\n        on std::compiler::CompilerError:\n            -1\n    ra + rb\n\nregister(1)\n"
    list [seSame $text] [seOutcomes $text] [lindex [seEcon $text] 0]
} -result {{} {TYPE accepted} 2}

test se-equal-outer-constant {a block reading a constant bound outside its function (a capture) reads its exact value (hir::range::BindingRange), so its verdict depends on the constant's own block: rejected (UNBOUND), the constant is a failure, not 4, and the reader is TYPE; accepted through an alias (size = base * 2), the reader is accepted; 5 rejects the reader. The dependency is the existing one -- the reader's function mentions the binding, the binding's definition holds the site -- and the batched decisions are the sequential ones} -body {
    set text {import std::compiler

type Coordinate = Int in 0..3

fn coord(n: Coordinate) -> Coordinate:
    n

fn rejected() -> int errors std::compiler::CompilerError:
    size = static compile:
        y = no_such_name
        4
    fn last() -> int errors std::compiler::CompilerError:
        static compile:
            coord(size - 1)
    last()

fn accepted() -> int errors std::compiler::CompilerError:
    base = static compile:
        2
    size = base * 2
    fn last() -> int errors std::compiler::CompilerError:
        static compile:
            coord(size - 1)
    last()

fn wide() -> int errors std::compiler::CompilerError:
    size = static compile:
        5
    fn last() -> int errors std::compiler::CompilerError:
        static compile:
            coord(size - 1)
    last()

r0 = rejected():
    on std::compiler::CompilerError:
        -1
r1 = accepted():
    on std::compiler::CompilerError:
        -1
r2 = wide():
    on std::compiler::CompilerError:
        -1
[r0, r1, r2]
}
    list [seSame $text] [seOutcomes $text] [lindex [seEcon $text] 0] [lindex [seEcon $text sequential] 0]
} -result {{} {UNBOUND TYPE accepted accepted accepted TYPE} 3 4}

test se-equal-corpus {contexts, opaque structs, traits, coroutines and ownership, method sugar, namespaced errors: batched equals sequential (every program compiles: seSame refuses two failures alike)} -body {
    set results {}
    foreach text [list \
        "import std::compiler\nimport std::linux::io\n\n[seSite a {{with context std::linux::io::create()} {1}}][seSite b {missing}]ra = a():\n    on std::compiler::CompilerError:\n        0\nrb = b():\n    on std::compiler::CompilerError:\n        0\nra + rb\n" \
        "import std::compiler\nimport std::abi\nimport std::abi::bytes\n\n[seSite a [list "b = std::abi::bytes::Bytes {storage: 1}" "0"]][seSite b [list "d = std::abi::bytes::from_list(\[\])" "std::abi::bytes::length(d).value"]][seSite c [list "d = std::abi::bytes::from_list(\[\])" "d.storage"]][seSite e {missing}]ra = a():\n    on std::compiler::CompilerError:\n        0\nrb = b():\n    on std::compiler::CompilerError:\n        0\nrc = c():\n    on std::compiler::CompilerError:\n        0\nre = e():\n    on std::compiler::CompilerError:\n        0\nra + rb + rc + re\n" \
        "import std::compiler\n\ntrait Shape:\n    fn area(shape: Shape) -> int\n\nstruct Square:\n    side: int\n\nfn area(s: Square) -> int:\n    s.side\n\nstruct Thing:\n    v: int\n\nfn measure(s: Shape) -> int:\n    s.area()\n\n[seSite a [list "measure(Square {side: 2})"]][seSite b [list "measure(Thing {v: 1})"]][seSite c [list "fn w(x: int) -> int:" "    x" "w(\"s\")"]]ra = a():\n    on std::compiler::CompilerError:\n        0\nrb = b():\n    on std::compiler::CompilerError:\n        0\nrc = c():\n    on std::compiler::CompilerError:\n        0\nra + rb + rc\n" \
        "import std::compiler\n\nfn producer():\n    yield 1\n    2\n\n[seSite a [list "coroutine {step} = producer()" "other = step" "step()" "0"]][seSite b [list "coroutine {step} = producer()" "step()" "0"]][seSite c {missing}]ra = a():\n    on std::compiler::CompilerError:\n        0\nrb = b():\n    on std::compiler::CompilerError:\n        0\nrc = c():\n    on std::compiler::CompilerError:\n        0\nra + rb + rc\n" \
        "import std::compiler\nimport std::list\nimport std::str\n\n[seSite a [list "xs = \[1, 2\]" "xs.length()"]][seSite b [list "s = \"ab\"" "fn w(x: int) -> int:" "    x" "w(s.length() == 2)"]][seSite c [list "xs = \[1\]" "s = \"x\"" "xs.length() + s.length()"]]ra = a():\n    on std::compiler::CompilerError:\n        0\nrb = b():\n    on std::compiler::CompilerError:\n        0\nrc = c():\n    on std::compiler::CompilerError:\n        0\nra + rb + rc\n" \
        "import std::compiler\nimport std::list\n\nfn positive(x: int) -> bool:\n    x > 0\n\n[seSite a [list "r = std::list::find(\[1, 2\], positive):" "    on std::list::NotFound:" "        0" "r"]][seSite b [list "r = std::list::find(\[1, 2\], positive):" "    on NotFound:" "        0" "r"]][seSite c [list "std::list::find(\[1\], positive)"]]ra = a():\n    on std::compiler::CompilerError:\n        0\nrb = b():\n    on std::compiler::CompilerError:\n        0\nrc = c():\n    on std::compiler::CompilerError:\n        0\nra + rb + rc\n"] {
        lappend results [seSame $text]
    }
    set results
} -result {{} {} {} {} {} {}}

test se-equal-ownership-verdict {a site whose handle is moved on a break path is AFFINE-PATH-RELEASE-UNSUPPORTED only once no other site has an ownership diagnostic: judged after two such sites, its first diagnostic is that one, not the KNOWN-ERROR after it (the dependency analysis once missed the channel and committed KNOWN-ERROR); judged while a later one is still present, it is the KNOWN-ERROR -- even when the diagnostic the analysis watches vanishes with an earlier rejection -- the batched decisions are the sequential ones} -body {
    set text [seOwnershipProgram moved $::seMovedVector collect $::seCollectHandles path [sePathRelease boom()]]
    set after [list [seSame $text 0] [seOutcomes $text]]
    # The last site's erasure (a handle into an `if` of type any) is the
    # verdict's witness; rejecting the block in helper, before the path site,
    # makes helper's result `never` and the erasure vanishes, while the
    # collecting site after the path site keeps the verdict: it must be held
    # back with the path site, not committed beside it.
    set helper "fn helper() errors std::compiler::CompilerError:\n    static compile:\n        fn want(x: int) -> int:\n            x\n        want(\"s\")\n\n"
    set erased {"fn f(c: bool) -> int errors std::compiler::CompilerError:" "    x = if c:" "        make(1)" "    else:" "        helper()" "    1" "f(true)"}
    set text [seOwnershipProgram -text $helper path [sePathRelease boom()] collect $::seCollectHandles erased $erased]
    list {*}$after [seSame $text 0] [seOutcomes $text]
} -result {{} {USE-AFTER-MOVE AFFINE-LIST-OPERATION-UNSUPPORTED AFFINE-PATH-RELEASE-UNSUPPORTED} {} {TYPE KNOWN-ERROR AFFINE-LIST-OPERATION-UNSUPPORTED accepted}}

test se-equal-every-mention {every mention of a binding is an edge of the analysis, not only its last: a nested function's capture of a vector is MUTABLE-PLACE-CAPTURE while a block before it mutates the vector, and is accepted once that block is rejected (the mutation is gone with its body) -- the analysis once kept only the last mention of each binding (a flat `dict lappend`), so the capture did not depend on the mutating block: it was rejected beside it, another program than the sequential order's, or, with a site between them, predicted and contradicted by the next build} -body {
    set prelude "import std::compiler\nimport std::mutable_vector\n\nfn want_int(x: int) -> int:\n    x\n\nfn f() -> int errors std::compiler::CompilerError:\n    v = std::mutable_vector::from_list(\[1\])\n    static compile:\n        v.push(2)\n        want_int(\"s\")\n"
    set capture "    fn g() -> int errors std::compiler::CompilerError:\n        static compile:\n            v.length()\n    r = g():\n        on std::compiler::CompilerError:\n            -1\n"
    set tail "r = f():\n    on std::compiler::CompilerError:\n        0\nr\n"
    set results {}
    foreach text [list "$prelude$capture    r + v.length()\n\n$tail" \
            "$prelude    w = static compile:\n        1\n$capture    r + w + v.length()\n\n$tail"] {
        set hir [seHir $text]
        lappend results [seSame $text] [seOutcomes $text] [dict get $hir staticStats mispredicted] \
            [dict get $hir staticStats rounds]
    }
    set results
} -result {{} {TYPE accepted} {} 2 {} {TYPE accepted accepted} {} 2}

test se-equal-vector-context-callee {a bounds proof over a context's vector reads its callees' bodies: a call between two loops over the member is a site only when the callee may reach the installed context (hir::cardinality::ContextSite, over exact call edges), so f's block depends on the block in g's body that calls add -- accepted once that block is rejected (g no longer pushes to the member), UNHANDLED-ERROR while g's block holds the call; the batched decisions are the sequential ones, with no build contradicting a prediction} -body {
    set text "import std::compiler\nimport std::mutable_vector\nimport std::list\n\ncontext struct Log:\n    items: MutableVector\[int\]\n\nfn add(x: int, context log: Log):\n    log.items.push(x)\n\nfn g(x: int) -> int errors std::compiler::CompilerError:\n    if x > 100:\n        static compile:\n            add(x)\n            %s\n    x\n\nfn f(h: int, context log: Log) -> int errors std::compiler::CompilerError:\n    ys = loop x in log.items:\n        x * 10\n    k = g(h)\n    static compile:\n        zs = loop x in log.items:\n            x\n        ys.at(k.mod(std::list::length(zs)))\n\nwith context Log {items: std::mutable_vector::from_list(\[1, 2\])}\nr = f(3):\n    on std::compiler::CompilerError {code, primary, message}:\n        -1\nr\n"
    set results {}
    foreach body {bogus_name(1) {x + 0}} {
        set source [format $text $body]
        set hir [seHir $source]
        lappend results [seSame $source] [seOutcomes $source] [dict get $hir staticStats mispredicted]
    }
    set results
} -result {{} {UNBOUND accepted} {} {} {accepted UNHANDLED-ERROR} {}}

test se-equal-implementation-yield {a construction's verdict reads the yield effect of the implementation the program selects for its root's trait operation (TRAIT-IMPLEMENTATION-YIELD-INFERENCE-MILESTONE-1.md): start's block is accepted while the block in D's wait -- the selected implementation of Driver's wait -- yields, and COROUTINE-RHS-NOT-YIELDING once that block is rejected; so start's block depends on it (hir/staticdeps.tcl reads the implementation as the operation's call target), an independent failure beside them -- the batched decisions are the sequential ones, with no build contradicting a prediction} -body {
    set text "import std::compiler\n\ncontext trait Driver:\n    fn wait(deadline: int) -> int errors std::compiler::CompilerError\n\ntype Base = Int in 0..100\n\nopaque context struct D:\n    base: Base\n\nfn want(x: int) -> int:\n    x\n\nfn create() -> D:\n    D {base: 1}\n\nfn wait(deadline: int, context d: D) -> int errors std::compiler::CompilerError:\n    if deadline > 100:\n        static compile:\n            yield deadline\n            %s\n    deadline + d.base\n\nfn run(context dr: Driver) -> int errors std::compiler::CompilerError:\n    dr.wait(5)\n\nfn start(context dr: Driver) -> int errors std::compiler::CompilerError:\n    static compile:\n        coroutine {step, first} = run()\n        first\n\nfn other() -> int errors std::compiler::CompilerError:\n    static compile:\n        want(\"t\")\n\nwith context create()\nr = start():\n    on std::compiler::CompilerError {code, primary, message}:\n        -1\nr + other()\n"
    set results {}
    foreach body {{want("s")} {deadline + 0}} {
        set source [format $text $body]
        set hir [seHir $source]
        lappend results [seSame $source] [seOutcomes $source] [dict get $hir staticStats mispredicted]
    }
    set results
} -result {{} {TYPE COROUTINE-RHS-NOT-YIELDING TYPE} {} {} {accepted accepted TYPE} {}}

# Writes the module files FILES ({PATH TEXT ...}, PATH relative to the
# library) into the current (private) library: each a standard namespace.
proc seWriteModules {files} {
    foreach {path text} $files {
        set f [open [file join $::core::libraryDir $path] w]
        fconfigure $f -encoding utf-8
        puts -nonewline $f $text
        close $f
    }
}

test se-equal-implementation-context {a function's context requirement reads the requirement of the implementation the program selects for a trait operation of a specialization it calls (TRAIT-IMPLEMENTATION-CONTEXT-REQUIREMENTS-MILESTONE-1.md): f calls twice(A) -- twice<A>'s operation binds std::ay's show (a module the program does not import: no visible function of the operation's name stands the call in with it), whose block calls note, which needs Log -- so g's block, which makes f a value, is CONTEXT-FUNCTION-VALUE while show's block is accepted, and accepted once show's block is rejected; so g's block depends on show's (hir/staticdeps.tcl reads the implementation as the operation's call target), an independent failure beside them -- the batched decisions are the sequential ones, with no build contradicting a prediction} -body {
    set module "import std::compiler\n\ntype Small = Int in 0..1000\n\ncontext struct Log:\n    n: Small\n\nfn note(context log: Log) -> int:\n    log.n\n\nfn want(x: int) -> int:\n    x\n\nstruct A:\n    v: int\n\nfn show(t: A) -> int errors std::compiler::CompilerError:\n    static compile:\n        n = note()\n        %s\n    t.v\n"
    set text "import std::compiler\nimport std::mk\n\ntrait Thing:\n    fn show(t: Thing) -> int errors std::compiler::CompilerError\n\nfn want(x: int) -> int:\n    x\n\nfn twice(t: Thing) -> int errors std::compiler::CompilerError:\n    t.show() + t.show()\n\nfn f() -> int errors std::compiler::CompilerError:\n    twice(std::mk::make(1))\n\nfn g() -> int errors std::compiler::CompilerError:\n    static compile:\n        h = \[f\]\n        1\n\nfn other() -> int errors std::compiler::CompilerError:\n    static compile:\n        want(\"t\")\n\nwith context std::mk::log(3)\nr = g():\n    on std::compiler::CompilerError {code, primary, message}:\n        -1\nr + other()\n"
    set results {}
    foreach body {{want("s")} {n + 0}} {
        withPrivateLibrary {
            seWriteModules [list ay.bot [format $module $body] \
                mk.bot "import std::ay\n\nfn make(v: int) -> std::ay::A:\n    std::ay::A {v: v}\n\nfn log(n: std::ay::Small) -> std::ay::Log:\n    std::ay::Log {n: n}\n"]
            set hir [seHir $text]
            lappend results [seSame $text] [seOutcomes $text] [dict get $hir staticStats mispredicted]
        }
    }
    set results
} -result {{} {TYPE accepted TYPE} {} {} {accepted CONTEXT-FUNCTION-VALUE TYPE} {}}

test se-equal-plan-gate {the trait monomorphization's plan runs only on a program with no diagnostic at all, so a site whose diagnostic only the plan reports fails only once every other site's diagnostic is gone (hir/staticdeps.tcl's C:plan): judged beside two checker failures it is unknown, not predicted ok (the dependency analysis once missed the gate, and the next build contradicted its prediction); two plan diagnostics in one build are decided one per build, as the sequential order does (the plan is one computation over the whole program) -- the batched decisions are the sequential ones} -body {
    set results {}
    foreach text [list [sePlanAffine {a nested b}] [sePlanTraits]] {
        set hir [seHir $text]
        lappend results [seSame $text] [seOutcomes $text] [dict get $hir staticStats mispredicted]
    }
    set results
} -result {{} {TYPE AFFINE-GENERIC-NESTED-UNSUPPORTED TYPE} {} {} {TRAIT-IMPL-ORDER TRAIT-IMPL-ORDER} {}}

test se-equal-plan-reclosed {while every diagnostic of a build may be the plan's (the gate is open), a rejection can close the gate again: rejecting the first of two independent TRAIT-IMPL-ORDER sites makes a top-level call of its function an UNHANDLED-ERROR, in no site, and the sequential order then accepts the second -- so the plan's diagnostics are decided one per build, never beside each other} -body {
    # (Not against the legacy scheduler: it knows no gate, and rejects both.)
    set hir [seHir $::sePlanReclosed]
    list [seSame $::sePlanReclosed 0] [seOutcomes $::sePlanReclosed] \
        [lmap d [dict get $hir diagnostics] {dict get $d kind}] [dict get $hir staticStats mispredicted]
} -result {{} {TRAIT-IMPL-ORDER accepted} UNHANDLED-ERROR {}}

test se-equal-plan-clone {a site the plan diagnoses only in a clone's view: a generic function's site giving its parameter to a nested generic function is specialized for a coroutine handle once a rejection narrows its caller's argument (an `any`) to one -- the site is the gate's consumer though nothing of its own changes, and no build contradicts a prediction} -body {
    set hir [seHir $::sePlanClone]
    list [seSame $::sePlanClone 0] [seOutcomes $::sePlanClone] [dict get $hir staticStats mispredicted] \
        [dict get $hir staticStats rounds]
} -result {{} {TYPE AFFINE-GENERIC-NESTED-UNSUPPORTED TYPE} {} 3}

test se-equal-plan-unplanned {a dead call of a trait-polymorphic function (no instance: its argument mk() is `never` once mk's site is rejected, beside x1's and x2's checker failures) is no plan diagnostic: the plan keeps its argument, which raises mk's reified CompilerError, and `use` is accepted (it was once rejected with TRAIT-INSTANCE-BUDGET, a budget that was never involved) -- the batched decisions are the sequential ones, with no build contradicting a prediction} -body {
    set hir [seHir $::sePlanUnplanned]
    list [seSame $::sePlanUnplanned 0] [seOutcomes $::sePlanUnplanned] [dict get $hir staticStats mispredicted]
} -result {{} {TYPE TYPE TYPE accepted} {}}

test se-equal-deep-first-request {the semantic layer declines a request for nesting only when it is the first for its instance (a cache hit never is), so rejecting the site that made the first request can make a deep one the first, and declined: `late`'s deep request is a hit until `early` is rejected, then declined, and `late` fails (TYPE: the call keeps its generic result). Every request at half the nesting limits or deeper is recorded (hir::semantic's `deep`) and puts the instance budget under pressure (C:budget), so `late` waits for `early` -- it was once predicted ok beside the two rejections, and the next build contradicted it} -body {
    set text [seDeepFirstRequest]
    set hir [seHir $text]
    list [seSame $text 0] [seOutcomes $text] [dict get $hir staticStats mispredicted]
} -result {{} {TYPE TYPE TYPE} {}}

test se-equal-internal-ids-exact {only a message naming an internal id the way the compiler prints one (`block(e12)`) waits for the sequential order's own build: a USE-AFTER-MOVE naming the binding `s1` after an earlier rejection is committed beside it (it was once held back as if `s1` were a scope id)} -body {
    set text "import std::compiler\n\nfn needs_int(v: int) -> int:\n    v\n\nfn producer():\n    yield 1\n    2\n\n"
    append text [seSite t [list {needs_int("s")}]]
    append text [seSite moved [list "coroutine {step: s1} = producer()" "other = s1" "s1()" "0"]]
    append text "r0 = t():\n    on std::compiler::CompilerError:\n        -1\nr1 = moved():\n    on std::compiler::CompilerError:\n        -1\n\[r0, r1\]\n"
    set hir [seHir $text]
    list [seSame $text] [seOutcomes $text] [dict get $hir staticStats rounds] \
        [hir::static::InternalIds "`s1` was used after its coroutine value was moved; other = s1 (f:1:2) t2 e3 b4 y5"] \
        [hir::static::InternalIds "the callee block(e12)/1 -> int and native(std::str::length) and block(e7)/0 -> str, f : function e9/1 -> int"] \
        [dict get [hir::static::PredictionOf {kind TYPE message "s1 is block(e12)/1 -> int, function e9/0 -> int"}] message]
} -result {{} {TYPE USE-AFTER-MOVE} 2 {} {e12 e7 e9} {s1 is block(#)/1 -> int, function #/0 -> int}}

test se-equal-hygiene-names {a diagnostic names a binding hygiene renamed (hir/hygiene.tcl's NAME#N: here a parameter `list` shadowing the root `list` a list literal calls) by its source spelling: the number counts that name's renames across the whole program, another site's among them -- the batched run, committing b's rejection beside a's, once printed `list#2` where the sequential order, judging b after a's rejection, prints `list#1`} -body {
    set text "import std::compiler\n\nfn want(v: int) -> int:\n    v\n\n"
    append text [seSite a {"fn f(list: int) -> int:" "    x = \[1\]" "    list" {want("s")}}]
    append text [seSite b {"fn g(list: int) -> int:" "    y = \[2\]" "    list" {g("s")}}]
    append text "ra = a():\n    on std::compiler::CompilerError:\n        -1\nrb = b():\n    on std::compiler::CompilerError:\n        -1\nra + rb\n"
    set messages [lmap {key site} [hir::static::sites [seHir $text]] {dict get $site diagnostic message}]
    list [seSame $text] [seOutcomes $text] [lindex $messages 1]
} -result {{} {TYPE TYPE} {argument for parameter "list" cannot be proven to satisfy int (argument type: str)}}

# Sites a and b (the body lines A and B) after `import std::compiler` and PRELUDE,
# each called under a handler, as in se-equal-hygiene-names.
proc seTwoSites {prelude a b} {
    set text "import std::compiler\n\n$prelude"
    append text [seSite a $a] [seSite b $b]
    append text "ra = a():\n    on std::compiler::CompilerError:\n        -1\nrb = b():\n    on std::compiler::CompilerError:\n        -1\nra + rb\n"
    return $text
}

# {DIFFERENCE OUTCOMES MESSAGE} of SOURCE: seSame, its sites' outcomes
# (seOutcomes) and the message of its last rejected site.
proc seHygiene {source} {
    set sites [hir::static::sites [seHir $source]]
    set outcomes [lmap {key site} $sites {
        expr {[dict get $site outcome] eq "rejected" ? [dict get $site diagnostic kind] : [dict get $site outcome]}
    }]
    set messages [lmap {key site} $sites {
        expr {[dict get $site outcome] eq "rejected" ? [dict get $site diagnostic message] : [continue]}
    }]
    return [list [seSame $source] $outcomes [lindex $messages end]]
}

# The reproducers below are se-equal-hygiene-names for every other message
# that names a binding, a reference or a function: each site renames a
# binding `list` (a list literal beside it calls the root `list`), and b's
# message names its own. Before they printed hir::semantic::SourceName
# (RefName for a reference, CallableName for a function), the batched run
# committed b's message with `list#2` beside a's rejection, where the
# sequential order, judging b in the build after it, printed `list#1`.
set ::seProducer "fn producer():\n    yield 1\n    2\n\n"

test se-equal-hygiene-use-after-move {USE-AFTER-MOVE names the used reference and the move by their source spelling (hir/affine.tcl's Use and MoveText)} -body {
    seHygiene [seTwoSites $::seProducer \
        {"coroutine {step: list} = producer()" "x = [1]" "other = list" "list()" "0"} \
        {"coroutine {step: list} = producer()" "y = [2]" "other = list" "list()" "0"}]
} -result {{} {USE-AFTER-MOVE USE-AFTER-MOVE} {`list` was used after its coroutine value was moved

moved here:
    other = list  (<input>:18:9)

used here:
    <input>:19:9}}

test se-equal-hygiene-affine-erasure {an ownership message names the affine value by its source spelling (hir/affine.tcl's Named)} -body {
    seHygiene [seTwoSites "${::seProducer}fn keep(v: any) -> int:\n    1\n\n" \
        {"coroutine {step: list} = producer()" "x = [1]" "keep(list)"} \
        {"coroutine {step: list} = producer()" "y = [2]" "keep(list)"}]
} -result {{} {AFFINE-ERASURE-UNSUPPORTED AFFINE-ERASURE-UNSUPPORTED} {`list` is an affine Coroutine{args: [], return: int, errors: []}, which cannot become the argument of parameter "v", declared any: that position does not carry ownership, so the value would be duplicated or lost (keep it in a binding, a parameter, a result, a struct field or a List of an affine type)}}

test se-equal-hygiene-affine-parameter {an erasure into a declared parameter names the parameter by its source spelling (hir/affine.tcl's CallConsumer)} -body {
    seHygiene [seTwoSites $::seProducer \
        {"fn keep(list: any) -> int:" "    x = [1]" "    1" "coroutine {step: h} = producer()" "keep(h)"} \
        {"fn keep(list: any) -> int:" "    y = [2]" "    1" "coroutine {step: h} = producer()" "keep(h)"}]
} -result {{} {AFFINE-ERASURE-UNSUPPORTED AFFINE-ERASURE-UNSUPPORTED} {`h` is an affine Coroutine{args: [], return: int, errors: []}, which cannot become the argument of parameter "list", declared any: that position does not carry ownership, so the value would be duplicated or lost (keep it in a binding, a parameter, a result, a struct field or a List of an affine type)}}

test se-equal-hygiene-affine-capture {AFFINE-CAPTURE-UNSUPPORTED names the captured reference by its source spelling} -body {
    seHygiene [seTwoSites $::seProducer \
        {"coroutine {step: list} = producer()" "x = [1]" "fn g() -> int:" "    list()" "    0" "g()"} \
        {"coroutine {step: list} = producer()" "y = [2]" "fn g() -> int:" "    list()" "    0" "g()"}]
} -result {{} {AFFINE-CAPTURE-UNSUPPORTED AFFINE-CAPTURE-UNSUPPORTED} {`list` is an affine Coroutine{args: [], return: int, errors: []}, which cannot be captured by a closure (a nested function): a closure may be called any number of times and copied freely, so capturing would alias the one owner (pass it as an argument, or construct it inside the nested function)}}

test se-equal-hygiene-field-move {AFFINE-FIELD-MOVE-REQUIRES-DESTRUCTURE names the struct and spells the destructuring it suggests by the source spelling} -body {
    set prelude "[string range $::seOwnership [string length "import std::compiler\n"] end]struct Holder:\n    h: Coroutine{args: \[Command\], return: Event}\n\n"
    seHygiene [seTwoSites $prelude \
        {"list = Holder {h: make(1)}" "x = [1]" "s = list.h" "0"} \
        {"list = Holder {h: make(2)}" "y = [2]" "s = list.h" "0"}]
} -result {{} {AFFINE-FIELD-MOVE-REQUIRES-DESTRUCTURE AFFINE-FIELD-MOVE-REQUIRES-DESTRUCTURE} {field "h" of `list` is affine (Coroutine{args: [Command], return: Event, errors: []}): reading it would make a second owner of what `list` owns, and a field cannot be moved out of a struct that stays usable (consume the struct with a destructuring instead: "{h} = list")}}

test se-equal-hygiene-path-release {AFFINE-PATH-RELEASE-UNSUPPORTED names the binding by its source spelling (hir/affine.tcl's PathPoint)} -body {
    set body {"fn f() -> int:" "    v = empty_queue()" "    list = make(1)" "    x = [1]" "    loop i from 0 to 3:"
        "        if i == 1:" "            v.push(list)" "            break" "    1" "f()"}
    seHygiene [seTwoSites [string range $::seOwnership [string length "import std::compiler\n"] end] $body $body]
} -result {{} {AFFINE-PATH-RELEASE-UNSUPPORTED AFFINE-PATH-RELEASE-UNSUPPORTED} {`list` is moved on a path that breaks out of this loop but still owned when the loop runs to its end: no statement ends that path to release it there (move it on every path, or on none -- e.g. use an infinite `loop:` whose every exit is a `break`)}}

test se-equal-hygiene-coroutine-not-function {COROUTINE-NOT-FUNCTION names the handle by its source spelling} -body {
    seHygiene [seTwoSites "${::seProducer}fn call(f: Fn{args: \[\], return: any}) -> int:\n    f()\n    1\n\n" \
        {"coroutine {step: list} = producer()" "x = [1]" "call(list)"} \
        {"coroutine {step: list} = producer()" "y = [2]" "call(list)"}]
} -result {{} {COROUTINE-NOT-FUNCTION COROUTINE-NOT-FUNCTION} {"list" is a coroutine handle, not a function value: it carries the evolving state of one coroutine and cannot be passed where a function value of type Fn{args: [], return: any, errors: []} is expected (Fn and Coroutine are distinct callable kinds, even with the same contract; declare the parameter Coroutine{args: [], return: any, errors: []}, or leave it untyped)}}

test se-equal-hygiene-resume-arity {COROUTINE-RESUME-ARITY spells the resume it asks for with the handle's source spelling} -body {
    seHygiene [seTwoSites $::seProducer \
        {"coroutine {step: list} = producer()" "x = [1]" "list(1, 2)" "0"} \
        {"coroutine {step: list} = producer()" "y = [2]" "list(1, 2)" "0"}]
} -result {{} {COROUTINE-RESUME-ARITY COROUTINE-RESUME-ARITY} {this coroutine has the zero-message protocol: resume it with no argument, "list()", got 2 argument(s)}}

test se-equal-hygiene-inferred-contract {why a parameter has its inferred contract names the callee by its source spelling (hir::signatures::Name)} -body {
    seHygiene [seTwoSites "" \
        {"fn list(v: int) -> int:" "    v" "fn g(x) -> int:" "    list(x)" "y = [1]" {g("s")}} \
        {"fn list(v: int) -> int:" "    v" "fn g(x) -> int:" "    list(x)" "y = [2]" {g("t")}}]
} -result {{} {TYPE TYPE} {argument for parameter "x" cannot be proven to satisfy int, the parameter type inferred from the function body (argument type: str); inferred from the function body: argument 1 of list (declared int) requires int (at 16:18)}}

test se-equal-hygiene-parameter-conflict {a parameter no type satisfies is named by its source spelling (hir::signatures::Diagnose)} -body {
    seHygiene [seTwoSites "fn want_i(v: int) -> int:\n    v\n\nfn want_s(v: str) -> int:\n    1\n\n" \
        {"fn h(list) -> int:" "    y = [1]" "    want_i(list) + want_s(list)" "h(1)"} \
        {"fn h(list) -> int:" "    y = [2]" "    want_i(list) + want_s(list)" "h(2)"}]
} -result {{} {TYPE TYPE} {cannot infer a sound type for parameter "list" of h: argument 1 of want_i (declared int) requires int (at 19:20), but argument 1 of want_s (declared str) requires str (at 19:35), and no type satisfies both}}

test se-equal-hygiene-erased-requirements {a typed callable whose requirements would be erased is named by its source spelling (hir::callables::Name)} -body {
    seHygiene [seTwoSites "" \
        {"fn list(k: int) -> int:" "    k + 1" "fn erase(x, c):" "    if c:" "        x" "    else:" "        0" "y = [1]" "erase(list, true)" "0"} \
        {"fn list(k: int) -> int:" "    k + 1" "fn erase(x, c):" "    if c:" "        x" "    else:" "        0" "y = [2]" "erase(list, true)" "0"}]
} -result {{} {TYPE TYPE} {call to erase with x : list/1 -> int, c : bool is invalid: "list" has typed parameter requirements that cannot be preserved in an "if" branch whose joined type differs from the other branch: its declared parameter contract would be erased and could no longer be checked at every future call (in the body of erase, at 21:17)}}

test se-equal-hygiene-lockstep {a lockstep loop's iteration counts name their bindings by their source spelling (hir::cardinality::show)} -body {
    seHygiene [seTwoSites "" \
        {"fn f(list, ys):" "    y = [1]" "    loop x in list and z in ys:" "        x" "f([1], [2])" "0"} \
        {"fn f(list, ys):" "    y = [2]" "    loop x in list and z in ys:" "        x" "f([1], [2])" "0"}]
} -result {{} {LOCKSTEP-UNPROVEN LOCKSTEP-UNPROVEN} {lockstep loop requires equal iteration counts; could not prove length(list) == length(ys) (clause 1 vs clause 2)}}

test se-equal-hygiene-mutable-receiver {MUTABLE-PLACE-RECEIVER names the receiver's binding by its source spelling} -body {
    seHygiene [seTwoSites "import std::mutable_vector\n\n" \
        {"list = std::mutable_vector::from_list([1])" "fn g() -> int:" "    std::mutable_vector::push(list, 2)" "    0" "g()"} \
        {"list = std::mutable_vector::from_list([2])" "fn g() -> int:" "    std::mutable_vector::push(list, 3)" "    0" "g()"}]
} -result {{} {MUTABLE-PLACE-RECEIVER MUTABLE-PLACE-RECEIVER} {the receiver of std::mutable_vector::push is `list`, a binding of an enclosing function: a nested function cannot mutate a vector it captured (a vector is a value; pass it in and return the result)}}

test se-equal-hygiene-mutable-capture {MUTABLE-PLACE-CAPTURE names the captured place by its source spelling} -body {
    seHygiene [seTwoSites "import std::mutable_vector\n\n" \
        {"list = std::mutable_vector::from_list([1])" "std::mutable_vector::push(list, 2)" "fn g() -> int:" "    std::mutable_vector::length(list)" "g()"} \
        {"list = std::mutable_vector::from_list([2])" "std::mutable_vector::push(list, 3)" "fn g() -> int:" "    std::mutable_vector::length(list)" "g()"}]
} -result {{} {MUTABLE-PLACE-CAPTURE MUTABLE-PLACE-CAPTURE} {`list` is a MutableVector place (its function mutates it in place), which a nested function cannot capture: the nested function would observe a binding that changes, and a vector is a value, not a shared reference (pass it as an argument: the callee gets its own logical copy)}}

test se-equal-hygiene-context-trait-binding {CONTEXT-TRAIT-MISUSE names the context-trait binding by its source spelling} -body {
    set prelude "error WriteFailed\ntype Small = Int in 0..1000\n\ncontext trait Out:\n    fn emit(n: int) -> int errors WriteFailed\n\ncontext struct A:\n    k: Small\n\nfn emit(n: int, context c: A) -> int errors WriteFailed:\n    n + c.k\n\n"
    seHygiene [seTwoSites $prelude \
        {"fn f(context list: Out) -> int:" "    y = [1]" "    z = list" "    1" "1"} \
        {"fn f(context list: Out) -> int:" "    y = [2]" "    z = list" "    1" "1"}]
} -result {{} {CONTEXT-TRAIT-MISUSE CONTEXT-TRAIT-MISUSE} {"list" is a context-trait binding (Out): it is not a value -- the only use of a context-trait binding is calling one of Out's operations on it (list.emit(...)); it cannot be passed, stored, returned, compared, projected or tested, and the installed context that provides it is never recovered}}

test se-equal-hygiene-module-function {a module's own function hygiene renamed before qualifying it (hir/hygiene.tcl's qualifyModules: NS::NAME#N) is named NS::NAME (hir::semantic::SourceName): here hm's `fn list`, renamed by site a's list literal after a's local `list`} -body {
    withPrivateLibrary {
        set f [open [file join $::core::libraryDir hm.bot] w]
        fconfigure $f -encoding utf-8
        puts -nonewline $f "import std::compiler\n\nfn want(v: int) -> int:\n    v\n\n[seSite a {"list = 5" "x = [1]" {want("s")}}]\nfn list(v: int) -> int:\n    v\n\n[seSite b {"fn g(x) -> int:" "    list(x)" "y = [2]" {g("s")}}]"
        close $f
        seHygiene "import std::hm\n0\n"
    }
} -result {{} {TYPE TYPE} {argument for parameter "x" cannot be proven to satisfy int, the parameter type inferred from the function body (argument type: str); inferred from the function body: argument 1 of std::hm::list (declared int) requires int (at 18:18)}}

# A trait-polymorphic function is declared at the top level only
# (TRAIT-NESTED-POLYMORPHIC): its rename counts the renames of the sites
# before it, here a's local `list`.
set ::seNamed "trait Named:\n    fn name(value: Named) -> str\n\nstruct Person:\n    value: str\n\nfn name(value: Person) -> str:\n    value.value\n\nfn want(v: int) -> int:\n    v\n\n"

test se-equal-hygiene-trait-function-value {TRAIT-POLYMORPHIC-FUNCTION-VALUE names the function by its source spelling (hir::signatures::Name)} -body {
    seHygiene [seTwoSites "${::seNamed}fn list(value: Named) -> str:\n    value.name()\n\n" \
        {"list = 5" "x = [1]" {want("s")}} \
        {"fs = [list]" "0"}]
} -result {{} {TYPE TRAIT-POLYMORPHIC-FUNCTION-VALUE} {list is a trait-polymorphic function (a parameter or its result is a trait): it can be called directly or through an immutable alias, but not used as a general function value, which has no place for the compile-time witnesses its calls need (there is no runtime trait dispatch)}}

test se-equal-hygiene-trait-function-alias {the binding statement a body ends with, whose value denotes a trait-polymorphic function, is named by its source spelling} -body {
    set text "import std::compiler\n\n$::seNamed[seSite a {"list = 5" "x = [1]" {want("s")}}]"
    append text "fn describe(value: Named) -> str:\n    value.name()\n\n"
    append text "fn b() errors std::compiler::CompilerError:\n    static compile:\n        y = \[2\]\n        list = describe\n\n"
    append text "ra = a():\n    on std::compiler::CompilerError:\n        -1\nb():\n    on std::compiler::CompilerError:\n        unit\nra\n"
    seHygiene $text
} -result {{} {TYPE TRAIT-POLYMORPHIC-FUNCTION-VALUE} {"list" is the value of this body, but it denotes the trait-polymorphic function describe, which is not a general callable value (its calls need compile-time witnesses; there is no runtime trait dispatch): call it directly}}

test se-equal-hygiene-trait-witness {a trait view's parameter witness is named by the parameter's source spelling (hir::traits::ShowWitness): a site inside a trait-polymorphic function, whose parameter `list` the site's list literal renames} -body {
    set text "import std::compiler\n\n$::seNamed[seSite a {"list = 5" "x = [1]" {want("s")}}]"
    append text "fn pick(list: Named, b: Named, flag: bool) -> Named errors std::compiler::CompilerError:\n    static compile:\n        y = \[2\]\n        if flag:\n            list\n        else:\n            b\n\n0\n"
    seHygiene $text
} -result {{} {TYPE TRAIT-WITNESS-JOIN} {expression has trait type Named but may contain either the witness of parameter "list" of pick or the witness of parameter "b" of pick; heterogeneous trait values are not supported (there is no erased trait representation to hold a run-time choice between witnesses)}}

test se-equal-erased-witness {the erased-callable contract is a set of errors, which loses one only once every contribution erasing it is gone: it depends on one witness per error (the contribution last in post-order): here the witness, in w(), erases mk()'s result, which never exists once the block in mk() is rejected, and the other contributor of E2, l(), fails as well. The consumer waits for both (the waiting rule) and is accepted: the final program erases nothing. Before the rule it was judged while l()'s erasure was still in the program and rejected (UNHANDLED-ERROR) -- the batched decisions are the sequential ones either way. store() escapes (`keep`), so what its parameter may hold is no input of the contract boundary (P:input), whose own witness link would hold l() back as well} -body {
    set text "import std::compiler\nimport std::list\n\nerror E1\nerror E2\n\nfn harmless() -> int:\n    1\n\nfn raise2() -> int errors E2:\n    fail E2\n\nfn raise2b() -> int errors E2:\n    fail E2\n\nfn store(f) -> int:\n    1\n\nfn want(x: int) -> int:\n    x\n\nfn mk() errors std::compiler::CompilerError:\n    static compile:\n        want(\"z\")\n        raise2b\n\n"
    append text [seSite y {"fn run(fs: List\[any\]) errors IndexNotFound:" "    f = std::list::at(fs, 0)" "    f()" "r = run(\[harmless\]):" "    on IndexNotFound:" "        -2" "1"}]
    append text [seSite l {"s = store(raise2)" {want("l")}}]
    append text [seSite w {"store(mk())"}]
    append text "keep = \[store\]\nr1 = y():\n    on std::compiler::CompilerError:\n        -1\nr2 = l():\n    on std::compiler::CompilerError:\n        -1\nr3 = w():\n    on std::compiler::CompilerError:\n        -1\nr1 + r2 + r3\n"
    list [seSame $text] [seOutcomes $text]
} -result {{} {TYPE accepted TYPE accepted}}

test se-equal-subsume-gate {a block whose first diagnostic is a contract-boundary report depends on what the program erases: std::mutable_array::generate given Fn{args: [int, any], ...}, and a coroutine handle leaving its construction in make (a function used as a value, whose parameter stands for whatever the program erases), are TYPE while the contributor erases raise_e and accepted once it is rejected -- judged after that rejection, as in the sequential order (a block whose first diagnostic came before the completion walk has no such edge: se-builds-subsume-gate)} -body {
    set results {}
    foreach body [list {"fn adopt(f: Fn{args: [int, any], return: any, errors: []}) -> int:" "    1" "adopt(std::mutable_array::generate)"} \
            {"fn make(f) -> int:" "    coroutine {step, first} = worker(f)" "    drive(step)" "keep = make" "0"}] {
        set text [seBoundaryProgram contributor $::seBoundaryContributor site $body]
        set open [seBoundaryProgram contributor [lrange $::seBoundaryContributor 0 2] site $body]
        lappend results [seSame $text] [seOutcomes $text] [seOutcomes $open]
    }
    set results
} -result {{} {TYPE accepted} {accepted TYPE} {} {TYPE accepted} {accepted TYPE}}

test se-equal-method-trial {a method-style call's trial builds judge the contract-boundary check of each argument at that candidate's parameter type: std::mutable_array::generate (it calls its second argument) given apply's Fn type, which leaves that argument uncontracted, may raise whatever the program erases -- so only std::pick::apply fits while the contributor erases raise_e, and both fit (AMBIGUOUS-METHOD-CALL) once it is rejected. The call's region depends on what the program erases (method-trial) and its decision is not reused across that rejection; the analysis once followed only the chosen candidate's parameter types, at a block's own positions, and the batched run accepted the block} -body {
    withPrivateLibrary {
        set f [open [file join $::core::libraryDir pick.bot] w]
        fconfigure $f -encoding utf-8
        puts -nonewline $f "fn apply(n: int, f) -> int:\n    n\n"
        close $f
        set lexical "fn apply(n: int, f: Fn\{args: \[int, any\], return: any, errors: \[\]\}) -> int:\n    n\n\nfn call(f, x):\n"
        set texts {}
        foreach contributor [list $::seBoundaryContributor [lrange $::seBoundaryContributor 0 2]] {
            lappend texts [string map [list "import std::mutable_array\n" "import std::mutable_array\nimport std::pick\n" \
                "fn call(f, x):\n" $lexical] \
                [seBoundaryProgram contributor $contributor trial {"n = 3" "n.apply(std::mutable_array::generate)"}]]
        }
        list [seSame [lindex $texts 0]] [seOutcomes [lindex $texts 0]] [seOutcomes [lindex $texts 1]]
    }
} -result {{} {TYPE AMBIGUOUS-METHOD-CALL} {accepted accepted}}

test se-no-misprediction {the golden framework's suites of 30 cases: no build contradicts a prediction of the batched run} -body {
    lmap rejection {none unbound type} {
        dict get [seHir [seSuite 30 $rejection 1]] staticStats mispredicted
    }
} -result {{} {} {}}

# ---------------------------------------------------------------------------
# The economics are pinned (whole-program builds: hir::BuildOnce)

test se-builds-type-nested {100 golden cases with 33 checker (TYPE) rejections, nested in one registration function: a constant number of builds -- the same as with every body at the top level} -body {
    lassign [seEcon [seSuite 100 type 1]] rounds builds
    lassign [seEcon [seSuite 100 type 0]] topRounds topBuilds
    list [expr {$builds <= 4}] [expr {$rounds == $topRounds && $builds == $topBuilds}] $rounds
} -result {1 1 2}

test se-builds-unbound {independent UNBOUND rejections: the same builds at 10, 50 and 100 cases} -body {
    lmap k {10 50 100} {
        lrange [seEcon [seSuite $k unbound 1]] 0 1
    }
} -result {{2 2} {2 2} {2 2}}

test se-builds-accepted {every block accepted: one build, whatever the number} -body {
    lmap k {10 100} {
        lrange [seEcon [seSuite $k none 1]] 0 1
    }
} -result {{1 1} {1 1}}

test se-builds-legacy-pathology {the legacy scheduler on the nested TYPE suite: one build per rejection (the pathology this milestone removes)} -body {
    lassign [seEcon [seSuite 30 type 1] legacy] rounds
    lassign [seEcon [seSuite 30 type 1] batched] batched
    list [expr {$rounds >= 10}] $batched
} -result {1 2}

test se-builds-erased {the erased-callable contract: a contributor and a consumer do not serialize 20 independent failures} -body {
    set text $::seErased
    append text [seSite contributor $::seContributor]
    append text [seSite consumer $::seConsumer]
    set names {contributor consumer}
    for {set i 0} {$i < 20} {incr i} {
        append text [seSite t$i [seTypeFail $i]]
        lappend names t$i
    }
    foreach name $names {
        append text "r_$name = ${name}():\n    on std::compiler::CompilerError:\n        -1\n"
    }
    append text "0\n"
    list [lindex [seEcon $text] 0] [lindex [seEcon $text legacy] 0]
} -result {2 21}

test se-builds-contract {verified structural contracts are not consumers of the erased-callable contract: through Fn parameters, struct fields and vector elements, 12 failures beside an erasing body are decided together} -body {
    set text "import std::compiler\nimport std::list\n\nerror E1\n\nfn raise1(x) -> int errors E1:\n    if x == 1:\n        fail E1\n    0\n\nfn call(f, x):\n    f(x)\n\nstruct Handler:\n    run: Fn{args: \[int\], return: int, errors: \[\]}\n\nfn apply(f: Fn{args: \[int\], return: int, errors: \[\]}, x: int) -> int:\n    f(x)\n\nfn dispatch(h: Handler, x: int) -> int:\n    (h.run)(x)\n\n"
    append text [seSite eraser {"fn gen(x) -> int errors E1:" "    call(raise1, x)" "r = gen(0):" "    on E1:" "        0" "r"}]
    set names eraser
    for {set i 0} {$i < 12} {incr i} {
        switch [expr {$i % 3}] {
            0 { set body [list "fn add(x: int) -> int:" "    x + 1" "apply(add, $i)" "missing_$i"] }
            1 { set body [list "fn add(x: int) -> int:" "    x + 1" "dispatch(Handler \{run: add\}, 1)" "missing_$i"] }
            2 { set body [list "fn add(x: int) -> int:" "    x + 1" "apply(add, 1)" {*}[seTypeFail $i]] }
        }
        append text [seSite t$i $body]
        lappend names t$i
    }
    foreach name $names {
        append text "r_$name = ${name}():\n    on std::compiler::CompilerError:\n        -1\n"
    }
    append text "0\n"
    list [seSame $text] [lindex [seEcon $text] 0]
} -result {{} 3}

test se-builds-contributor-early {a contributor rejected by resolution leaves no erasure: the consumer is decided in the first checked build} -body {
    set text $::seErased
    append text [seSite contributor [concat $::seContributor {missing_name}]]
    append text [seSite consumer $::seConsumer]
    append text "r1 = contributor():\n    on std::compiler::CompilerError:\n        -1\nr2 = consumer():\n    on std::compiler::CompilerError:\n        -1\n0\n"
    list [seSame $text] [seOutcomes $text] [lindex [seEcon $text] 0]
} -result {{} {UNBOUND accepted} 2}

test se-builds-contributor-checked {a contributor rejected by the checker beside 10 independent failures that consume nothing: all are rejected in the first build (2 rounds) -- independent blocks do not depend on what the program erases} -body {
    set text $::seErased
    append text [seSite contributor [concat $::seContributor [seTypeFail 99]]]
    set names contributor
    for {set i 0} {$i < 10} {incr i} {
        append text [seSite t$i [seTypeFail $i]]
        lappend names t$i
    }
    foreach name $names {
        append text "r_$name = ${name}():\n    on std::compiler::CompilerError:\n        -1\n"
    }
    append text "0\n"
    list [seSame $text] [lsort -unique [seOutcomes $text]] [lindex [seEcon $text] 0]
} -result {{} TYPE 2}

test se-builds-ownership-verdict {the ownership verdict: a site whose path-release diagnostic it withholds waits for the sites holding its diagnostics -- no build contradicts a prediction (the golden mutable-vector suite's did) -- yet one such site ahead of six of them takes no build per rejection, and beside independent failures in a program the analysis accepts it waits for nothing} -body {
    # The reproducer: two sites with ownership diagnostics around the one
    # whose diagnostic they withhold.
    set hir [seHir [seOwnershipProgram moved $::seMovedVector path [sePathRelease] collect $::seCollectHandles]]
    set first [list [dict get $hir staticStats mispredicted] [dict get $hir staticStats rounds] \
        [seSame [seOwnershipProgram moved $::seMovedVector path [sePathRelease] collect $::seCollectHandles] 0]]
    # The site first, six after it.
    set sites [list path [sePathRelease]]
    for {set i 0} {$i < 6} {incr i} {
        lappend sites w$i [expr {$i % 2 ? $::seCollectHandles : $::seMovedHandle}]
    }
    set text [seOwnershipProgram {*}$sites]
    set hir [seHir $text]
    set ahead [list [dict get $hir staticStats mispredicted] [dict get $hir staticStats rounds] \
        [lindex [seEcon $text sequential] 0] [lsort -unique [seOutcomes $text]]]
    # Accepted: the site beside four TYPE failures.
    set sites [list path [sePathRelease]]
    for {set i 0} {$i < 4} {incr i} {
        lappend sites t$i [seTypeFail $i]
    }
    set text [seOwnershipProgram {*}$sites]
    set hir [seHir $text]
    set accepted [list [dict get $hir staticStats mispredicted] [dict get $hir staticStats rounds] [seOutcomes $text]]
    list $first $ahead $accepted
} -result {{{} 3 {}} {{} 3 8 {AFFINE-LIST-OPERATION-UNSUPPORTED AFFINE-PATH-RELEASE-UNSUPPORTED USE-AFTER-MOVE}} {{} 2 {AFFINE-PATH-RELEASE-UNSUPPORTED TYPE TYPE TYPE TYPE}}}

test se-builds-nested-siblings {checker failures in sibling functions nested in one enclosing site: the enclosing site depends on each (their forms are part of its body), the siblings on none of each other -- they are decided together, whatever their number, as in a plain function (a nested site once reached the enclosing site's form, and through it every sibling: one rejection per build)} -body {
    set results {}
    foreach k {3 6} {
        set text [seSiblings $k]
        lappend results [seEcon $text] [lindex [seEcon [seSiblings $k 0]] 0] [seSame $text]
    }
    lappend results [lsort -unique [seOutcomes [seSiblings 6]]]
} -result {{2 2 0} 2 {} {2 2 0} 2 {} {TYPE accepted}}

test se-builds-plan-gate {a site whose diagnostic only the plan reports, ahead of four checker failures: it waits for the last of them, not one build per rejection} -body {
    set text [sePlanAffine {nested t0 t1 t2 t3}]
    set hir [seHir $text]
    list [dict get $hir staticStats rounds] [dict get $hir staticStats mispredicted] [lindex [seEcon $text sequential] 0] [seSame $text 0]
} -result {3 {} 6 {}}

test se-builds-plan-instances {a call of a trait-polymorphic function that has its instance in every context the plan walks is no consumer of the plan's gate (its one diagnostic, TRAIT-INSTANCE-BUDGET, is reported only where a context has none): the site holding it does not join the gate's witness's component, so both checker failures are rejected in one round (every such call was once a consumer: the witness waited a round for the site)} -body {
    set hir [seHir $::sePlanInstances]
    list [dict get $hir staticStats rounds] [dict get $hir staticStats builds] [dict get $hir staticStats mispredicted] \
        [lrange [seEcon $::sePlanInstances sequential] 0 1] [seSame $::sePlanInstances 0] [seOutcomes $::sePlanInstances]
} -result {2 3 {} {3 4} {} {TYPE accepted accepted TYPE}}

test se-builds-erased-empty {sites that each pass a function to the untyped std::list::any? -- erasure sites of the erased-callable contract and callers of its consumer -- are decided together: rejecting one removes nothing from the contract when its function raises nothing (it erased nothing), or when another site still erases the same error (the contract is a set of errors), so no other is judged again; nor does a function passed to an untyped parameter (run(bN)) put its body into the contract (what it carries is its declared errors)} -body {
    set results {}
    foreach k {3 6} {
        foreach errors {0 1} {
            set text [seErasingSites $k $errors]
            lappend results [lrange [seEcon $text] 0 1] [seSame $text]
        }
    }
    set results
} -result {{2 2} {} {2 2} {} {2 2} {} {2 2} {}}

test se-builds-possible-witness {sites that each pass the same error-declaring function through an untyped parameter into a structural Fn -- each a contract-boundary check reading what that parameter may hold, and a value of it -- are decided together: what it holds is a set of errors, which another site's same value keeps whole} -body {
    set results {}
    foreach k {3 6} {
        set text [seSubsumeSites $k]
        lappend results [lrange [seEcon $text] 0 1] [seSame $text 0] [lsort -unique [seOutcomes $text]]
    }
    set results
} -result {{2 2} {} UNHANDLED-ERROR {2 2} {} UNHANDLED-ERROR}

test se-builds-coroutine-construction {a coroutine construction whose thunk captures nothing of an uncontracted type -- here only the function it calls -- does not wait for a rejected contributor of the erased-callable contract: its boundary check reads the contract only through what its callee's region reads (the static-decision fuzzer's seed 29, program 13: one build fewer nested, as in its split layout)} -body {
    set producer "fn producer():\n    yield 1\n    2\n\n"
    set move [list "coroutine {step} = producer()" "other = step" "step()" "0"]
    set text $::seErased$producer
    append text [seSite contributor [concat $::seContributor [seTypeFail 99]]]
    append text [seSite moved $move]
    append text "r1 = contributor():\n    on std::compiler::CompilerError:\n        -1\nr2 = moved():\n    on std::compiler::CompilerError:\n        -1\n0\n"
    list [seSame $text] [seOutcomes $text] [lindex [seEcon $text] 0]
} -result {{} {TYPE USE-AFTER-MOVE} 2}

test se-builds-subsume-gate {a block whose first diagnostic was reported before the completion walk keeps it whatever the program erases (every contract-boundary report is appended after it): three blocks failing first with a checker TYPE, each also holding a check that reads what the program erases (std::mutable_array::generate given Fn{args: [int, any], ...}), are rejected in the build that rejects the contributor -- 2 rounds, where waiting for it took 3 (the sequential order 5)} -body {
    set early {"fn adopt(f: Fn{args: [int, any], return: any, errors: []}) -> int:" "    1" "a = adopt(std::mutable_array::generate)" "want_int(\"s\")"}
    set text [seBoundaryProgram contributor $::seBoundaryContributor g1 $early g2 $early g3 $early]
    list [seSame $text 0] [seOutcomes $text] [lindex [seEcon $text] 0]
} -result {{} {TYPE TYPE TYPE TYPE} 2}

test se-builds-coroutine-checks {a coroutine handle's check reads what the program erases only through an uncontracted capture of a thunk constructed in the body: an accepted block passing on a handle it receives as a parameter (no construction: no check) and one whose thunk captures nothing does not wait for the contributor's rejection, nor does the failing block after it in the same function -- 2 rounds, where an edge for every handle took 3 (se-builds-coroutine-construction's block fails first before the completion walk, which the gate already covers)} -body {
    set ok {"fn relay(c: Coroutine{args: [M], return: Ev, errors: []}) -> int:" "    drive(c)" "fn local() -> int:" "    coroutine {step: s} = counter()" "    drive(s)" "local()"}
    set host "fn host() -> int errors std::compiler::CompilerError:\n    a = static compile:\n"
    foreach line $ok {
        append host "        $line\n"
    }
    append host "    b = static compile:\n        want_int(\"s\")\n    a + b\n\n"
    set text "$::seBoundary[seSite contributor $::seBoundaryContributor]$host"
    foreach name {contributor host} {
        append text "r_$name = ${name}():\n    on std::compiler::CompilerError:\n        -1\n"
    }
    append text "0\n"
    list [seSame $text 0] [seOutcomes $text] [lindex [seEcon $text] 0]
} -result {{} {TYPE accepted TYPE} 2}

test se-method-reuse {method-style call decisions are reused across rounds: fewer trial builds than deciding afresh, and the audit (every seeded round built again unseeded) finds the same program} -body {
    set text "import std::compiler\nimport std::list\nimport std::str\n\n"
    set names {}
    for {set i 0} {$i < 6} {incr i} {
        lappend names t$i
        if {$i % 2} {
            append text [seSite t$i [list "xs = \[1, $i\]" "s = \"ab\"" "xs.length() + s.length()"]]
        } else {
            append text [seSite t$i [list "xs = \[1, $i\]" {*}[seTypeFail $i] "xs.length()"]]
        }
    }
    append text [seSite late [list "fn w(x: int) -> int:" "    x" "w(\"s\")"]]
    lappend names late
    foreach name $names {
        append text "r_$name = ${name}():\n    on std::compiler::CompilerError:\n        -1\n"
    }
    append text "0\n"
    set reuse [seEcon $text]
    set hir::static::methodReuse 0
    try {
        set fresh [seEcon $text]
    } finally {
        set hir::static::methodReuse 1
    }
    set hir::static::methodAudit 1
    try {
        set audited [seEcon $text]
    } finally {
        set hir::static::methodAudit 0
    }
    list [expr {[lindex $reuse 2] < [lindex $fresh 2]}] [seSame $text 0] [expr {[lindex $audited 0] == [lindex $reuse 0]}]
} -result {1 {} 1}

test se-method-invalidated {a call whose receiver a rejected block changes is decided again, never reused: mk() is a List until its block is rejected, then never -- and xs.length() becomes ambiguous} -body {
    set text "import std::compiler\nimport std::list\nimport std::str\n\nfn mk() errors std::compiler::CompilerError:\n    static compile:\n[join [lmap l [seTypeFail 0] {string cat "        " $l}] \n]\n        \[1, 2\]\n\nfn outside() -> int errors std::compiler::CompilerError:\n    xs = mk()\n    xs.length()\n\n[seSite other [seTypeFail 1]]r = outside():\n    on std::compiler::CompilerError:\n        -1\nr2 = other():\n    on std::compiler::CompilerError:\n        -1\nr + r2\n"
    set a [sdCompile batched $text]
    set hir::static::methodReuse 0
    try {
        set b [sdCompile batched $text]
    } finally {
        set hir::static::methodReuse 1
    }
    list [sdDiff $a $b] [seSame $text 0] [lsort -unique [lmap d [dict get $a diagnostics] {lindex $d 0}]]
} -result {{} {} AMBIGUOUS-METHOD-CALL}

test se-build-reuse-identical {a method-call decision build that would repeat the build it started from is not made again (hir::methods::Config) -- with or without static blocks, the program is the one building it again gives} -body {
    set programs [list \
        [seSuite 10 type 1] \
        "$::seErased[seSite a $::seContributor][seSite b $::seConsumer][seSite c [seTypeFail 0]]0\n" \
        "import std::list\nimport std::str\n\nfn f(xs: List\[int\]) -> int:\n    xs.length()\n\nfn g(xs) -> int:\n    xs.length()\n\nxs = \[1, 2\]\ns = \"ab\"\nxs.length() + s.length() + f(\[3\])\n" \
        "import std::list\nimport std::str\n\nxs = \[1, 2\]\ns = \"ab\"\nxs.length() + s.length()\n" \
        "trait Shape:\n    fn area(shape: Shape) -> int\n\nstruct Square:\n    side: int\n\nfn area(s: Square) -> int:\n    s.side * s.side\n\nfn measure(s: Shape) -> int:\n    s.area()\n\nmeasure(Square \{side: 3\})\n" \
        "fn producer():\n    yield 1\n    2\n\ncoroutine \{step\} = producer()\nstep()\n"]
    set results {}
    foreach text $programs {
        set reused [sdCompile batched $text]
        set hir::methodBuildReuse 0
        try {
            set rebuilt [sdCompile batched $text]
        } finally {
            set hir::methodBuildReuse 1
        }
        lappend results [expr {[dict get $reused error] ne "" ? "does not compile" : [sdDiff $reused $rebuilt]}]
    }
    set results
} -result {{} {} {} {} {} {}}

# A chain of method-style calls on one receiver: each `arr.at(i)` narrows
# `arr` for the statements after it. Under the reference rule (no kind
# proof) the kind wave still chooses the stand-ins, a trial round tries every
# call at its other candidates, and certification judges each by its single
# deviations; a deviation whose configuration an earlier build had is read
# from its record (hir::methods::Config). And a chain whose links choose
# different candidates (swap's first, at's second).
set ::seMethodChain "import std::list\nimport std::mutable_array\nimport std::mutable_vector\n\nfn f() -> List\[int\] errors IndexNotFound:\n    arr = std::mutable_array::create(3, 0)\n    x = arr.at(0)\n    y = arr.at(1)\n    z = arr.at(2)\n    \[x, y, z\]\n\nr = f():\n    on IndexNotFound:\n        \[\]\nr\n"
set ::seMethodMixed "import std::list\nimport std::mutable_array\nimport std::mutable_vector\n\nfn f() -> List\[int\] errors IndexNotFound:\n    arr = std::mutable_array::create(3, 0)\n    old = arr.swap(0, 5)\n    x = arr.at(0)\n    y = arr.at(1)\n    \[old, x, y\]\n\nr = f():\n    on IndexNotFound:\n        \[\]\nr\n"
# Two candidates that both fit a String receiver, a lexical `length` and
# std::str::length: the trial round builds the call at the second, and the
# certification's single deviation is that configuration again (a build
# other than the one the decision started from, read from its record).
set ::seMethodTwo "import std::str\n\nfn length(s: str) -> int:\n    1\n\nfn m(s: str) -> int:\n    s.length()\n\nm(\"ab\")\n"

test se-method-memo {a method-call decision builds no configuration twice: a build whose configuration an earlier build of the decision had is read from what was recorded of that build (hir::methods::Config, hir::methods::Record) -- the build the decision started from and any later one (a trial round's configuration that a single deviation needs again) -- the decided program is the one building every build again gives, and the audit (every reused build made again) finds the same} -body {
    set results {}
    foreach text [list $::seMethodChain $::seMethodMixed $::seMethodTwo] {
        set counts {}
        set records {}
        foreach {reuse audit} {1 0 0 0 1 1} {
            # (The reference rule: every candidate judged by its own build,
            # no kind proof -- with kind proofs the chain is settled by the
            # kind waves, tests/method-filter.test.)
            set saved [list $hir::methodBuildReuse $hir::methodBuildAudit $hir::methodKindProofs]
            set hir::methodBuildReuse $reuse
            set hir::methodBuildAudit $audit
            set hir::methodKindProofs 0
            try {
                set before [hir::BuildStats]
                lappend records [sdCompile batched $text]
                set after [hir::BuildStats]
            } finally {
                lassign $saved hir::methodBuildReuse hir::methodBuildAudit hir::methodKindProofs
            }
            lappend counts [expr {[dict get $after methodTrials] - [dict get $before methodTrials]}]
        }
        lappend results $counts [sdDiff [lindex $records 0] [lindex $records 1]] \
            [sdDiff [lindex $records 0] [lindex $records 2]] [dict get [lindex $records 0] diagnostics]
    }
    set results
} -result {{8 9 8} {} {} {} {7 8 7} {} {} {} {1 2 1} {} {} {{AMBIGUOUS-METHOD-CALL {method-style call "length" is ambiguous: more than one visible function accepts the call (length, std::str::length); there is no precedence between them (none by namespace, result type, how the result is used, or which one's context requirements are met): call the one you mean explicitly, e.g. length(receiver, ...)}}}}

# The batched run itself (hir::static::Simulate), on a synthetic dependency
# relation: sites a, u, f in post-order; u depends on a and on f, f on
# nothing. Rejecting a makes u unknown; f comes after u in u's component, and
# the sequential order judges u (with f's body) before it rejects f -- so f
# waits for the build, although nothing f depends on changed.
proc seSyntheticSite {key parent} {
    dict create key $key origin {file f1 start 0 end 0} bodyOrigin {file f1 start 0 end 0} \
        operation compile parent $parent deferred {}
}
proc seSyntheticDiagnostic {kind} {
    dict create kind $kind message "a $kind" origin {file f1 start 0 end 0 line 1 column 1} related {}
}

test se-simulate-component-waits {a component whose first non-ok site is unknown waits for a build: a later failing site of it is not committed, even one that depends on nothing changed} -body {
    set sites [list [seSyntheticSite a ""] [seSyntheticSite u ""] [seSyntheticSite f ""] [seSyntheticSite z ""]]
    set own [dict create a [list [seSyntheticDiagnostic TYPE]] u [list [seSyntheticDiagnostic TYPE]] \
        f [list [seSyntheticDiagnostic TYPE]] z [list [seSyntheticDiagnostic UNBOUND]]]
    set deps [dict create sites [dict create a {} u {a f} f {} z {}]]
    set result [hir::static::Simulate $sites {} $own $deps]
    list [dict get $result committed] [dict keys [dict get $result predicted]]
} -result {{a z} f}

test se-simulate-independent {independent failing sites are all committed in one run, in post-order, and their dependents become unknown} -body {
    set sites [list [seSyntheticSite a ""] [seSyntheticSite b ""] [seSyntheticSite c ""] [seSyntheticSite d ""]]
    set own [dict create a [list [seSyntheticDiagnostic TYPE]] c [list [seSyntheticDiagnostic TYPE]] \
        d [list [seSyntheticDiagnostic UNBOUND] [seSyntheticDiagnostic TYPE]]]
    set deps [dict create sites [dict create a {} b {c} c {} d {}]]
    set result [hir::static::Simulate $sites {} $own $deps]
    list [dict get $result committed] [dict get $result predicted] \
        [dict get [lindex [dict get $result decisions d] 1] kind]
} -result {{a c d} {} UNBOUND}

test se-simulate-consumer-waits {a failing consumer of a channel waits while a failing contributor to it remains: the contributor written after it is committed first, and the consumer, which depends on it, is left for a build} -body {
    set sites [list [seSyntheticSite y ""] [seSyntheticSite z ""]]
    set own [dict create y [list [seSyntheticDiagnostic UNHANDLED-ERROR]] z [list [seSyntheticDiagnostic TYPE]]]
    set deps [dict create sites [dict create y {z} z {}] consumes [dict create y C:erased z {}] \
        contributors [dict create C:erased {z}]]
    set result [hir::static::Simulate $sites {} $own $deps]
    list [dict get $result committed] [dict get $result predicted] [lindex [hir::static::Next $sites {} $own $deps] 0]
} -result {z {} z}

test se-simulate-cycle {failing sites that wait on each other (each consumes a channel the other contributes to): the first one in post-order is rejected, by the batched run as by the sequential order} -body {
    set sites [list [seSyntheticSite y ""] [seSyntheticSite z ""]]
    set own [dict create y [list [seSyntheticDiagnostic UNHANDLED-ERROR]] z [list [seSyntheticDiagnostic TYPE]]]
    set deps [dict create sites [dict create y {z} z {y}] consumes [dict create y C:erased z C:erased] \
        contributors [dict create C:erased {y z}]]
    set result [hir::static::Simulate $sites {} $own $deps]
    list [dict get $result committed] [dict get $result predicted] [lindex [hir::static::Next $sites {} $own $deps] 0]
} -result {y {} y}

# ---------------------------------------------------------------------------
# Scheduling diagnostics

test se-trace {the trace names every round's rejections and why a failing block waits: here, on the block whose use of a captured untyped parameter fails it} -body {
    set text "import std::compiler\nimport std::str\n\nfn want_int(x: int) -> int:\n    x\n\nfn register(n) -> int:\n    fn a() -> int errors std::compiler::CompilerError:\n        static compile:\n            q = std::str::length(n)\n            want_int(\"s\")\n    fn b() -> int errors std::compiler::CompilerError:\n        static compile:\n            want_int(n)\n    ra = a():\n        on std::compiler::CompilerError:\n            -1\n    rb = b():\n        on std::compiler::CompilerError:\n            -1\n    ra + rb\n\nregister(1)\n"
    set hir::static::trace 1
    try {
        set text [hir::static::FormatTrace [dict get [seHir $text] staticStats]]
    } finally {
        set hir::static::trace 0
    }
    list [regexp {round 1 \(checked\)} $text] [regexp {reject f[0-9]+:[0-9]+ TYPE} $text] \
        [regexp {defer f[0-9]+:[0-9]+: depends on f[0-9]+:[0-9]+: .*untyped-parameter} $text] \
        [regexp {round 2 \(checked\).*\n    accept 1} $text]
} -result {1 1 1 1}

test se-deterministic {the same program compiled three times in one process: the same decisions and the same economics, and nothing kept between compilations} -body {
    set text [seSuite 12 type 1]
    set before [lsort [info vars ::hir::static::*]]
    set runs [lmap i {1 2 3} {
        set hir [seHir $text]
        list [hir::static::sites $hir] [dict get $hir staticStats rounds] [dict get $hir staticStats builds]
    }]
    list [llength [lsort -unique $runs]] [expr {[lsort [info vars ::hir::static::*]] eq $before}]
} -result {1 1}

# ---------------------------------------------------------------------------
# The compiler properties the dependency analysis relies on
# (hir/staticdeps.tcl's header): if one of these changes, the analysis must.

test se-property-nested-entry {a nested function is analyzed from its own entry: where it is defined after a failure (its definition unreachable), its own completion and ownership diagnostics are still reported -- so a function does not depend on the reachability of the code that defines it} -body {
    set text "error Boom\nerror Bang\n\nfn bang() errors Bang:\n    fail Bang\n\nfn gen():\n    yield 1\n    2\n\nfn f() errors Boom:\n    fail Boom\n    fn g():\n        coroutine \{step\} = gen()\n        step()\n        other = step\n        step()\n        bang()\n    0\n\nr = f():\n    on Boom:\n        1\nr\n"
    lsort -unique [lmap d [dict get [surface::compile $text -strict 0 -warnings off] diagnostics] {
        dict get $d kind
    }]
} -result {KNOWN-ERROR USE-AFTER-MOVE}

test se-property-capture-narrowing {a captured binding is seen with the facts its mentions before the definition establish (a condition, a native's parameter types), and with no others -- what the capture edges of the analysis follow} -body {
    set text "import std::list\n\nfn want(x: int) -> int:\n    x\n\nfn f(things: List\[any\]) -> int errors IndexNotFound:\n    v = std::list::at(things, 0)\n    if integer?(v):\n        fn g() -> int:\n            want(v)\n        g()\n    else:\n        0\n\nfn h(things: List\[any\]) -> int errors IndexNotFound:\n    w = std::list::at(things, 0)\n    w + 1\n    fn k() -> int:\n        want(w)\n    k()\n\nfn m(things: List\[any\]) -> int errors IndexNotFound:\n    u = std::list::at(things, 0)\n    fn q() -> int:\n        want(u)\n    q()\n\nfn all() -> int errors IndexNotFound:\n    f(\[1\]) + h(\[2\]) + m(\[3\])\n\nr = all():\n    on IndexNotFound:\n        0\nr\n"
    lmap d [dict get [surface::compile $text -strict 0 -warnings off] diagnostics] {
        list [dict get $d kind] [dict get [hir::static::PrimaryOrigin [surface::compile $text -strict 0 -warnings off] $d] line]
    }
} -result {{TYPE 25}}

test se-property-subsume-local {the contract-boundary check of what an uncontracted input may hold (hir::completions::Subsume, Possible) runs only in a body's own diagnosing walk and only while the program erases something: what makes it a site-local channel} -body {
    set body [info body hir::completions::Subsume]
    regexp {if \{!\$diagnose \|\| \$value eq "" \|\| \[ErasedErrors \$hir\] eq \{\}\} \{\s*return} $body
} -result 1

test se-property-subsume-positions {what the contract-boundary edges rely on (hir/staticdeps.tcl, Z:site): the check skips exactly the coroutine operations the analysis lists, checks a handle only when its construction is in the body, and reports only in the completion walk -- before which hir::CheckOnce records the diagnostics so far (beforeCompletions), shifted past the method-style call rejections hir::methods::Report prepends} -body {
    set skipped [lsort [regexp -all -inline {core::coroutines::[a-z]+Native} [info body hir::completions::SubsumeCall]]]
    set listed [lsort [regexp -all -inline {core::coroutines::[a-z]+Native} [info body hir::staticdeps::CoroutineOperations]]]
    set reporters {}
    set walkers {}
    foreach file [lsort [glob -directory [file join $::sdRoot hir] *.tcl]] {
        set f [open $file]
        set text [read $f]
        close $f
        if {[regexp {ReportOutside hir\M} $text]} {
            lappend reporters [file tail $file]
        }
        if {[regexp {completions::checkBlock hir\M} $text]} {
            lappend walkers [file tail $file]
        }
    }
    list [expr {$skipped eq $listed && [llength $skipped] == 5}] \
        [regexp {set thunk \[hir::coroutines::thunkOfHandle \$hir \$value\]\s*if \{\$thunk eq ""\} \{\s*return} [info body hir::completions::SubsumeHandle]] \
        $reporters $walkers \
        [regexp {dict set hir beforeCompletions \[list 0 \[llength \[dict get \$hir diagnostics\]\]\]\s*hir::errorsets::verify hir\n} [info body hir::CheckOnce]] \
        [regexp {dict set final diagnostics \[concat \$added \[dict get \$final diagnostics\]\]\s*if \{\[dict exists \$final beforeCompletions\]\}} [info body hir::methods::Report]]
} -result {1 1 completions.tcl errorsets.tcl 1 1}

test se-property-ownership-verdict {release scopes, and so AFFINE-PATH-RELEASE-UNSUPPORTED, are computed only for a program the ownership analysis accepts as a whole, whose diagnostics are exactly the kinds hir/staticdeps.tcl's C:verdict lists; a semantic instance's carried to its call reads "call to" -- the facts the verdict's edges rely on} -body {
    set f [open [file join $::sdRoot hir affine.tcl]]
    set text [read $f]
    close $f
    set kinds [lsort -unique [lmap {- kind} [regexp -all -inline {\[list (?:reject )?(AFFINE-[A-Z-]+|USE-AFTER-MOVE)\M} $text] {set kind}]]
    list [regexp {if \{!\$accepted \|\| [^\n]*\} \{\n\s*set scopes \{\}} [info body hir::affine::verify]] \
        [expr {$kinds eq [lsort $hir::staticdeps::ownershipKinds]}] \
        [regexp {format \{call to %s } [info body hir::semantic::Derived]]
} -result {1 1 1}

test se-property-plan-gate {the trait monomorphization's plan runs only on a checked program with no diagnostic, and its diagnostics are exactly the kinds hir/staticdeps.tcl's C:plan lists -- the facts the plan's edges rely on} -body {
    set f [open [file join $::sdRoot hir traits.tcl]]
    set text [read $f]
    close $f
    # (The plan is PlanCalls, its call resolution, and Plan, which places
    # the clones: TRAIT-IMPLEMENTATION-YIELD-INFERENCE-MILESTONE-1.md.)
    set body ""
    foreach name {PlanCalls Plan} {
        set start [string first "proc hir::traits::$name " $text]
        set end [string first "\nproc " $text [expr {$start + 1}]]
        append body [string range $text $start $end]
    }
    set kinds [lsort -unique [lmap {- kind} [regexp -all -inline {\[list ([A-Z][A-Z-]+) (?:\[|")} $body] {set kind}]]
    list [regexp {&& \$checked && \[dict get \$hir diagnostics\] eq ""\} \{\s*#[^\n]*\n\s*#[^\n]*\n\s*set hir \[hir::traits::monomorphize} [info body hir::BuildFull]] \
        [expr {$kinds eq [lsort $hir::staticdeps::planKinds]}] $kinds
} -result {1 1 {AFFINE-GENERIC-NESTED-UNSUPPORTED AFFINE-INSTANCE-BUDGET TRAIT-IMPL-ORDER TRAIT-INSTANCE-BUDGET TRAIT-INTERNAL TRAIT-NOT-SATISFIED TRAIT-POLYMORPHIC-RECURSION}}

test se-property-demotion-keeps-diagnostics {a demoted trusted contract changes no diagnostic: hir::check keeps the diagnostics of the check before the demotion (each of its checks is hir::CheckWith's) -- why demotion is not a channel} -body {
    list [regexp {set diagnostics \[dict get \$hir diagnostics\].*CheckOnce hir \$demote.*dict set hir diagnostics \$diagnostics} [info body hir::CheckWith]] \
        [regexp {CheckWith hir} [info body hir::check]]
} -result {1 1}

# Programs whose check demotes a trusted inferred contract (hir::check), by
# the shape of the signature fixpoint (hir::signatures::infer): the demoted
# parameter seeded in the first check's second round (one forwarder; two,
# one of them kept, over three rounds) or only in its third (a callable
# contract its body's seeded types make inferable), a coroutine, and a
# static block whose build demotes.
set ::seDemoting [dict create \
    forward "import std::mutable_array\nfn first(xs: MutableArray\[str\]) -> str errors IndexNotFound:\n    std::mutable_array::at(xs, 0)\nfn fwd(xs) errors IndexNotFound:\n    first(xs)\nr = fwd(std::mutable_array::create(1, 5)):\n    on IndexNotFound:\n        \"\"\nr\n" \
    kept "fn take_int(b: int) -> int:\n    b\nfn f(p, g):\n    take_int(p)\n    g(p)\nfn keep(y):\n    take_int(y)\nfn h(n):\n    n + 1\nkeep(3) + f(\"a\", h)\n" \
    later "import std::str\nfn take_int(b: int) -> int:\n    b\nfn f(p, g):\n    take_int(p)\n    g(p)\nfn h(s: str) -> int:\n    std::str::length(s)\nf(5, h)\n" \
    coroutine "fn take_int(b: int) -> int:\n    b\nfn fwd(x):\n    take_int(x)\nfn producer(v):\n    yield fwd(v)\n    2\ncoroutine \{step\} = producer(\"a\")\nstep()\n" \
    static "import std::compiler\nimport std::mutable_array\nfn wrong() errors std::compiler::CompilerError:\n    static compile:\n        fn first(xs: MutableArray\[str\]) -> str errors IndexNotFound:\n            std::mutable_array::at(xs, 0)\n        fn fwd(xs) errors IndexNotFound:\n            first(xs)\n        r = fwd(std::mutable_array::create(1, 5)):\n            on IndexNotFound:\n                \"\"\n        r\nfn right() errors std::compiler::CompilerError:\n    static compile:\n        1 + 1\nright()\n"]

# SOURCE's HIR (-strict 0, warnings off) and, per hir::check it ran that
# demoted, {COROUTINE-ANALYSES TYPINGS DEMOTED}; the decisions' timing zeroed.
proc seDemotionCheck {source} {
    set ::seChecks {}
    set counting {
        hir::coroutines::analyze {apply {{args} {incr ::seAnalyses}}}
        hir::types::infer {apply {{args} {incr ::seTypings}}}
    }
    set enter {apply {{args} {set ::seAnalyses 0; set ::seTypings 0}}}
    set leave {apply {{command code result op} {
        upvar 1 [lindex $command 1] h
        if {[dict exists $h demotedContracts]} {
            lappend ::seChecks [list $::seAnalyses $::seTypings [llength [dict get $h demotedContracts]]]
        }
    }}}
    dict for {command script} $counting { trace add execution $command enter $script }
    trace add execution hir::check enter $enter
    trace add execution hir::check leave $leave
    try {
        set hir [surface::compile $source -strict 0 -warnings off]
    } finally {
        dict for {command script} $counting { trace remove execution $command enter $script }
        trace remove execution hir::check enter $enter
        trace remove execution hir::check leave $leave
    }
    if {[dict exists $hir staticStats depMs]} {
        dict set hir staticStats depMs 0
    }
    return [list $hir $::seChecks]
}

test se-demotion-recheck-identical {the check after a demotion reuses the first check's coroutine protocols and every signature round whose seeds it reaches again (COMPILER-BOTTLENECKS.md 3.9), and its HIR is the one redoing it from the start gives -- whether it reuses the first round only, the first two, or the first and then types a round of its own} -body {
    set results {}
    dict for {name text} $::seDemoting {
        lassign [seDemotionCheck $text] shared sharedChecks
        set hir::recheckReuse 0
        try {
            lassign [seDemotionCheck $text] full fullChecks
        } finally {
            set hir::recheckReuse 1
        }
        lappend results $name [expr {$shared eq $full}] [expr {$sharedChecks ne {}}]
    }
    set results
} -result {forward 1 1 kept 1 1 later 1 1 coroutine 1 1 static 1 1}

test se-demotion-recheck-economics {per demoting check {coroutine analyses, typings, demoted}: the coroutine protocols once, and the second check types only the rounds whose seeds the first never reached -- none when every round it needs was the first's (forward: the unseeded round converges; later: it reaches the first's second round), one when a kept contract seeds a round of its own (kept); redone from the start, twice and every round again} -body {
    set results {}
    dict for {name text} $::seDemoting {
        set shared [lindex [seDemotionCheck $text] 1]
        set hir::recheckReuse 0
        try {
            set full [lindex [seDemotionCheck $text] 1]
        } finally {
            set hir::recheckReuse 1
        }
        lappend results $name $shared $full
    }
    set results
} -result {forward {{1 2 1}} {{2 3 1}} kept {{1 4 1}} {{2 5 1}} later {{1 3 1}} {{2 5 1}} coroutine {{1 3 1}} {{2 4 1}} static {{1 2 1}} {{2 3 1}}}

test se-demotion-recheck-audit {the audit switch redoes every demoting check from the start beside the reusing one and fails on any difference: it compares one check per demoting build, and a reuse that changed the result would raise} -body {
    set hir::recheckAudit 1
    set before $hir::recheckAudits
    try {
        dict for {name text} $::seDemoting {
            seDemotionCheck $text
        }
    } finally {
        set hir::recheckAudit 0
    }
    set audited [expr {$hir::recheckAudits - $before}]
    set caught [catch {hir::AuditRecheck {exprs {e1 {kind const}} types {}} {exprs {e1 {kind ref}} types {}}} message]
    list $audited $caught $message
} -result {5 1 {hir::check: the demotion re-check that reuses the first check differs from the one made from the start in: exprs e1}}

cleanupTests
