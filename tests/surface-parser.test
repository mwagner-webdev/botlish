# surface-parser.test -- Botlish source to surface AST (surface/parser.tcl).

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]

proc ast {source args} {
    return [surface::formatAst [surface::parse $source t.bot] {*}$args]
}

# "LINE:COLUMN MESSAGE" of the syntax error SOURCE raises.
proc parseError {source} {
    if {![catch {surface::parse $source t.bot} message options]} {
        return "no error"
    }
    lassign [dict get $options -errorcode] a b diagnostic
    if {"$a $b" ne "SURFACE SYNTAX"} {
        return "unexpected error: $message"
    }
    return "[dict get $diagnostic line]:[dict get $diagnostic column] [dict get $diagnostic message]"
}

# ---------------------------------------------------------------------------
# Expressions

test parse-literals {literals and names} -body {
    ast "42\n\"a\\\"b\"\ntrue\nfalse\nunit\nx"
} -result {(int 42)
(str "a\"b")
(bool true)
(bool false)
(unit)
(name x)}

test parse-precedence {* binds tighter than + and -, which bind tighter than comparisons} -body {
    ast "1 + 2 * 3\n1 * 2 + 3\na + b < c * d"
} -result {(binary + (int 1) (binary * (int 2) (int 3)))
(binary + (binary * (int 1) (int 2)) (int 3))
(binary < (binary + (name a) (name b)) (binary * (name c) (name d)))}

test parse-left-associative {arithmetic is left-associative} -body {
    ast "a - b - c\na + b - c\na * b * c"
} -result {(binary - (binary - (name a) (name b)) (name c))
(binary - (binary + (name a) (name b)) (name c))
(binary * (binary * (name a) (name b)) (name c))}

test parse-parentheses {parentheses group} -body {
    ast "(1 + 2) * 3\n((x))"
} -result {(binary * (binary + (int 1) (int 2)) (int 3))
(name x)}

test parse-unary {unary minus binds tighter than * and nests} -body {
    ast "-x * y\n- -x\na - -b\n-f(x)"
} -result {(binary * (unary - (name x)) (name y))
(unary - (unary - (name x)))
(binary - (name a) (unary - (name b)))
(unary - (call (name f) (name x)))}

test parse-comparisons {every comparison operator} -body {
    ast "a == b\na < b\na <= b\na > b\na >= b"
} -result {(binary == (name a) (name b))
(binary < (name a) (name b))
(binary <= (name a) (name b))
(binary > (name a) (name b))
(binary >= (name a) (name b))}

test parse-comparison-chain {comparisons do not chain} -body {
    list [parseError "a < b < c"] [parseError "a == b == c"] [parseError "(a < b) < c"]
} -result {{1:7 comparison chaining is not supported} {1:8 comparison chaining is not supported} {no error}}

test parse-calls {calls, arguments and repeated calls} -body {
    ast "f()\nf(a, g(b), 3)\nf(1)(2)\nf(1,)"
} -result {(call (name f))
(call (name f) (name a) (call (name g) (name b)) (int 3))
(call (call (name f) (int 1)) (int 2))
(call (name f) (int 1))}

test parse-lists {list literals} -body {
    ast "\[\]\n\[1, 2, 3\]\n\[a, f(x), 3,\]\n\[\[1\], \[\]\]"
} -result {(list)
(list (int 1) (int 2) (int 3))
(list (name a) (call (name f) (name x)) (int 3))
(list (list (int 1)) (list))}

test parse-multiline-arguments {arguments and list items across lines} -body {
    ast "values = \[\n    1,\n    2,\n\]\nf(\n  a,\n  b\n)"
} -result {(bind values (list (int 1) (int 2)))
(call (name f) (name a) (name b))}

# ---------------------------------------------------------------------------
# Statements

test parse-bindings {bindings} -body {
    ast "x = 10\ny = x + 1"
} -result {(bind x (int 10))
(bind y (binary + (name x) (int 1)))}

test parse-function {function declarations, trailing commas, multi-line parameters} -body {
    ast "fn add(a, b):\n    a + b\n\nfn f():\n    unit\n\nfn g(\n    a,\n    b,\n):\n    a"
} -result {fn add (a b)
    (binary + (name a) (name b))
fn f ()
    (unit)
fn g (a b)
    (name a)}

test parse-nested-functions {nested functions} -body {
    ast "fn make_adder(x):\n    fn add(y):\n        x + y\n\n    add"
} -result {fn make_adder (x)
    fn add (y)
        (binary + (name x) (name y))
    (name add)}

test parse-if-else {if with else} -body {
    ast "if x < 0:\n    0 - x\nelse:\n    x"
} -result {if (binary < (name x) (int 0))
    (binary - (int 0) (name x))
else
    (name x)}

test parse-if-without-else {else is optional} -body {
    ast "if flag:\n    x = 1\n    x\ny"
} -result {if (name flag)
    (bind x (int 1))
    (name x)
(name y)}

test parse-nested-if {if inside else} -body {
    ast "if a:\n    1\nelse:\n    if b:\n        2\n    else:\n        3"
} -result {if (name a)
    (int 1)
else
    if (name b)
        (int 2)
    else
        (int 3)}

test parse-loop {loop with break, continue and return} -body {
    ast "fn f(n):\n    loop:\n        if n:\n            continue\n        break\n    return\n\nloop:\n    break 42\nfn g():\n    return 1 + 2"
} -result {fn f (n)
    loop
        if (name n)
            (continue)
        (break)
    (return)
loop
    (break (int 42))
fn g ()
    (return (binary + (int 1) (int 2)))}

test parse-blank-lines-in-suites {blank and comment lines inside suites} -body {
    ast "fn f():\n    x = 1\n\n    # comment\n\n    x\n"
} -result {fn f ()
    (bind x (int 1))
    (name x)}

test parse-spans {nodes carry spans} -body {
    ast "fn add(a, b):\n    a + b\nadd(1, 2)" -spans 1
} -result {fn add (a b) @1:1-2:10
    (binary + (name a) @2:5-2:6 (name b) @2:9-2:10) @2:5-2:10
(call (name add) @3:1-3:4 (int 1) @3:5-3:6 (int 2) @3:8-3:9) @3:1-3:10}

test parse-function-spans {name, parameter and literal spans of a function} -body {
    set fn [lindex [dict get [surface::parse "fn add(a, b):\n    a + b" t.bot] body] 0]
    set show {apply {{s} {return "[dict get $s line]:[dict get $s column]-[dict get $s endLine]:[dict get $s endColumn]"}}}
    list [{*}$show [dict get $fn nameSpan]] \
         [lmap param [dict get $fn params] {{*}$show [lindex $param 1]}] \
         [{*}$show [dict get $fn paramsSpan]] \
         [{*}$show [dict get $fn body span]]
} -result {1:4-1:7 {1:8-1:9 1:11-1:12} 1:7-2:10 2:5-2:10}

test parse-ast-is-syntax-only {the AST holds no semantic facts} -body {
    # A duplicate binding and an unbound name parse without complaint.
    ast "x = 1\nx = nope"
} -result {(bind x (int 1))
(bind x (name nope))}

# ---------------------------------------------------------------------------
# Syntax errors

foreach {name source expected} {
    missing-expression       "x = "                    {1:5 expected an expression, found end of line}
    missing-colon            "if x\n    1"             {1:5 expected ":" after the "if" condition, found end of line}
    inline-suite             "if x: 1"                 {1:7 expected a new line and an indented block after ":", found integer 1}
    missing-block            "fn f():\nx"              {2:1 expected an indented block, found name "x"}
    missing-block-eof        "loop:\n"                 {2:1 expected an indented block, found end of file}
    unexpected-indent        "x\n    y"                {2:5 unexpected indentation}
    unexpected-indent-suite  "if a:\n    b\n        c" {3:9 unexpected indentation}
    else-without-if          "else:\n    1"            {1:1 "else" without a matching "if"}
    elif                     "if a:\n    1\nelse if b:\n    2" {3:6 expected ":" after "else", found "if"}
    trailing-token           "x y"                     {1:3 expected end of line, found name "y"}
    bind-to-expression       "f(x) = 1"                {1:6 only a name can be bound with "="}
    keyword-as-name          "if = 1"                  {1:4 expected an expression, found "="}
    keyword-in-expression    "x = return"              {1:5 expected an expression, found "return"}
    fn-without-name          "fn (a):\n    a"          {1:4 expected a function name after "fn", found "("}
    bad-parameter            "fn f(1):\n    1"         {1:6 expected a parameter name, found integer 1}
    parameter-separator      "fn f(a b):\n    a"       {1:8 expected "," or ")" in the parameter list, found name "b"}
    argument-separator       "f(a b)"                  {1:5 expected "," or ")" in the argument list, found name "b"}
    list-separator           "\[1 2\]"                 {1:4 expected "," or "]" in the list, found integer 2}
    empty-parens             "()"                      {1:2 expected an expression, found ")"}
    leading-comma            "f(,)"                    {1:3 expected an expression, found ","}
    double-colon             "a::b"                    {1:2 expected end of line, found ":"}
    lambda-like              "fn(x):\n    x"           {1:3 expected a function name after "fn", found "("}
    inconsistent-dedent      "if a:\n    b\n  c"       {3:3 inconsistent dedent: indentation does not match any enclosing level}
    unterminated-string      "f(\"abc)"                {1:3 unterminated string}
} {
    test parse-error-$name "syntax error: $name" -body {
        parseError $source
    } -result $expected
}

test parse-error-message {syntax error messages name file, line and column} -body {
    catch {surface::parse "fn f():\n    x = \n" src/demo.bot} message options
    list $message [lrange [dict get $options -errorcode] 0 1]
} -result {{src/demo.bot:2:9: expected an expression, found end of line} {SURFACE SYNTAX}}

# ---------------------------------------------------------------------------
# Boolean operators

test parse-boolean-precedence {or < and < not < comparisons} -body {
    ast "a or b and c\nnot a == b\na and not b or c\nnot not a\na != b + 1"
} -result {(logical or (name a) (logical and (name b) (name c)))
(not (binary == (name a) (name b)))
(logical or (logical and (name a) (not (name b))) (name c))
(not (not (name a)))
(binary != (name a) (binary + (name b) (int 1)))}

test parse-boolean-associativity {and and or are left-associative} -body {
    ast "a and b and c\na or b or c"
} -result {(logical and (logical and (name a) (name b)) (name c))
(logical or (logical or (name a) (name b)) (name c))}

test parse-boolean-errors {not is not an operand of arithmetic; != does not chain} -body {
    list [parseError "1 + not x"] [parseError "a != b != c"] [parseError "a and"]
} -result {{1:5 expected an expression, found "not"} {1:8 comparison chaining is not supported} {1:6 expected an expression, found end of line}}

# ---------------------------------------------------------------------------
# if as a value

test parse-if-values {an if as the value of a binding, return or break} -body {
    ast "x = if a:\n    1\nelse:\n    2\nfn f():\n    return if b:\n        3\nloop:\n    break if c:\n        4\n    else:\n        5\ny = x"
} -result {bind x = if (name a)
    (int 1)
else
    (int 2)
fn f ()
    return if (name b)
        (int 3)
loop
    break if (name c)
        (int 4)
    else
        (int 5)
(bind y (name x))}

test parse-if-value-errors {an if is not an operand} -body {
    list [parseError "x = 1 + if a:\n    1"] [parseError "f(if a:\n    1)"] [parseError "x = if a: 1 else: 2"]
} -result {{1:9 an "if" value must be the whole right side of "=", "return" or "break"} {1:3 an "if" value must be the whole right side of "=", "return" or "break"} {1:11 expected a new line and an indented block after ":", found integer 1}}

# ---------------------------------------------------------------------------
# Recovery

proc recoveredAst {source} {
    return [surface::formatAst [surface::parse $source t.bot -recover 1]]
}

test parse-recover-statements {each bad statement becomes an error node; parsing continues} -body {
    recoveredAst "x = 1 +\ny = 2\nf(a b)\nz = 3"
} -result {(error)
(bind y (int 2))
(error)
(bind z (int 3))
! 1:8 expected an expression, found end of line
! 3:5 expected "," or ")" in the argument list, found name "b"}

test parse-recover-blocks {a bad header skips its block; errors inside a block stay inside} -body {
    recoveredAst "if x\n    1\n    2\nfn f():\n    a = \n    b\nc"
} -result {(error)
fn f ()
    (error)
    (name b)
(name c)
! 1:5 expected ":" after the "if" condition, found end of line
! 5:9 expected an expression, found end of line}

test parse-recover-lexical {lexical and syntax errors together, in source order} -body {
    # "2 ! 3": the lexer skips "!", then the parser finds a stray 3.
    recoveredAst "a = \"open\nb = f(1\nc = 2 ! 3\nd = 007"
} -result {(bind a (str "open"))
(bind b (call (name f) (int 1)))
(error)
(bind d (int 7))
! 1:5 unterminated string
! 2:6 "(" is never closed
! 3:7 unexpected character "!"
! 3:9 expected end of line, found integer 3
! 4:5 invalid integer literal "007": leading zeros are not allowed}

test parse-recover-indentation {unexpected indentation is skipped as a block} -body {
    recoveredAst "a\n    b\n    c\nd"
} -result {(name a)
(error)
(name d)
! 2:5 unexpected indentation}

test parse-recover-clean {a clean recovering parse equals a normal parse} -body {
    set source [core::ReadFile [file join $::projectRoot examples surface 08-return.bot]]
    set normal [surface::parse $source t.bot]
    set recovered [surface::parse $source t.bot -recover 1]
    list [expr {$normal eq $recovered}] [dict get $recovered diagnostics]
} -result {1 {}}

test parse-recover-lowering {an AST with syntax errors is not lowered} -body {
    set ast [surface::parse "x = \ny = 1" t.bot -recover 1]
    catch {surface::lowerToHir $ast} message options
    list [lrange [dict get $options -errorcode] 0 1] $message
} -result {{SURFACE SYNTAX} {t.bot:1:5: expected an expression, found end of line}}

test parse-recover-always-terminates {recovery makes progress on hostile input} -body {
    set results {}
    foreach source [list ")))" "\]\]\]" "else:\n  else:\n else" ":\n:\n:" "fn\nfn\nfn" "if if if" "= = =" "\n\n    \n  x\n y\nz" "loop:\n" "fn f(\n" "\"\n\"\n\""] {
        set ast [surface::parse $source t.bot -recover 1]
        lappend results [expr {[dict get $ast kind] eq "program"}]
    }
    lsort -unique $results
} -result 1

# ---------------------------------------------------------------------------
# Node ids

proc ids {source} {
    set lines {}
    foreach line [split [surface::formatAst [surface::parse $source t.bot] -ids 1] \n] {
        lappend lines [string trim $line]
    }
    return [join $lines \n]
}

test parse-ids {ids name nodes by structure} -body {
    ids "fn make_adder(x):\n    fn add(y):\n        x + y\n    add\nx = 1\nx = 2\nif x:\n    loop:\n        break\nmake_adder(1)(2)"
} -result {fn make_adder (x) <make_adder()>
fn add (y) <make_adder()/add()>
(binary + (name x) <make_adder()/add()/binary/left> (name y) <make_adder()/add()/binary/right>) <make_adder()/add()/binary>
(name add) <make_adder()/name>
(bind x (int 1) <x=/value>) <x=>
(bind x (int 2) <x=#2/value>) <x=#2>
if (name x) <if/cond> <if>
loop <if/then/loop>
(break) <if/then/loop/break>
(call (call (name make_adder) <call/callee/callee> (int 1) <call/callee/arg1>) <call/callee> (int 2) <call/arg1>) <call>}

# Ids of every node of the AST of SOURCE, by kind and span text.
proc idsByText {source} {
    set ast [surface::parse $source t.bot]
    set result [dict create]
    set stack [list $ast]
    while {$stack ne ""} {
        set node [lindex $stack end]
        set stack [lrange $stack 0 end-1]
        set span [dict get $node span]
        dict set result "[dict get $node kind] [string range $source [dict get $span start] [dict get $span end]-1]" [dict get $node id]
        lappend stack {*}[surface::ast::Children $node]
    }
    return $result
}

test parse-ids-stable {editing one function or adding statements keeps unrelated ids} -body {
    set before "fn fib(n):\n    if n <= 1:\n        return n\n    fib(n - 1) + fib(n - 2)\n\nfn main():\n    x = fib(10)\n    x\n"
    set after  "# a comment\nlimit = 2\n\nfn fib(n):\n    if n < limit:\n        return n\n    total = fib(n - 1) + fib(n - 2)\n    total\n\nfn main():\n    x = fib(10)\n    x\n"
    set a [idsByText $before]
    set b [idsByText $after]
    list [dict get $a "function fn main():\n    x = fib(10)\n    x"] [dict get $b "function fn main():\n    x = fib(10)\n    x"] \
         [dict get $a "call fib(10)"] [dict get $b "call fib(10)"] \
         [dict get $a "return return n"] [dict get $b "return return n"]
} -result {main() main() main()/x=/value main()/x=/value fib()/if/then/return fib()/if/then/return}

test parse-find-node {surface::findNode finds a node by id} -body {
    set ast [surface::parse "fn f(a):\n    a + 1\nf(2)" t.bot]
    list [dict get [surface::findNode $ast f()/binary/right] text] [surface::findNode $ast nope]
} -result {1 {}}

cleanupTests
