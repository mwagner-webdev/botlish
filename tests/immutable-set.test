        set ::core::libraryDir $saved
        tcltest::removeDirectory [file tail $dir]
    }
} -result {1 1 {[true, true]}}

# ---------------------------------------------------------------------------
# Source-type isolation across repeated/sequential compilation (spec 84)

test set-repeated-compilation {compiling the same ImmutableSet[T]-over-a-source-type program twice in one process succeeds both times} -body {
    set src [format {%sfn consume(s: ImmutableSet[Small]) -> bool:
    immutable_set_contains(s, one())
consume(immutable_set_from_list([one(), two()]))} $::smallDecl]
    set h1 [surface::compile $src rep1.bot]
    set h2 [surface::compile $src rep2.bot]
    list [core::formatValue [core::evalProgram [hir::lower $h1]]] \
         [core::formatValue [core::evalProgram [hir::lower $h2]]]
} -result {true true}

# ---------------------------------------------------------------------------
# Backend parity (spec 66)

test set-parity-construction-and-membership {construction, dedup and membership agree across interp/compile/cranelift-generic/cranelift} -body {
    parity {[immutable_set_contains(immutable_set_from_list([1, 1, 2, 3]), 2),
             immutable_set_contains(immutable_set_from_list([1, 1, 2, 3]), 4),
             immutable_set_from_list([1, 2]) == immutable_set_from_list([2, 1])]}
} -result same

test set-parity-unicodechar {UnicodeChar-element sets agree across every backend} -body {
    parity {chars = ['-', '.', '_', '~']
[immutable_set_contains(immutable_set_from_list(chars), '-'),
 immutable_set_contains(immutable_set_from_list(chars), 'A'),
 immutable_set_contains(immutable_set_from_list(chars), 45)]}
} -result same

test set-parity-wrong-first-argument {the dynamic TYPE error on a non-set first argument agrees across every backend} -body {
    parity {immutable_set_contains(123, 1)}
} -result same

test set-parity-show {display text agrees across interp/compile (first-occurrence order is a deterministic implementation detail of both)} -body {
    core::value::show [core::evalProgram [sourceIR {immutable_set_from_list([3, 1, 2, 1])}]]
} -result {{3, 1, 2}}

# ---------------------------------------------------------------------------
# Allocation baseline (spec 67-69)

test set-allocation-baseline {construction allocates one ImmutableSet object in addition to the source List; no construction fusion, no constant folding} -body {
    set report [native::allocationReport [sourceHir {chars = ['-', '.', '_', '~']
immutable_set_from_list(chars)}] summary]
    list [dict get $report byKind ImmutableSet allocations] \
        [expr {[dict get $report byKind List allocations] >= 1}]
} -result {1 1}

# ---------------------------------------------------------------------------
# GC: native (Cranelift) pointer-member tracing and stress (spec 32-33, 82-83)

test set-native-pointer-members-basic {a native ImmutableSet of String members constructs, and membership observes them correctly} -body {
    set text {s = immutable_set_from_list([concat("a", "b"), concat("c", "d"), concat("a", "b")])
[immutable_set_contains(s, concat("a", "b")), immutable_set_contains(s, "zz")]}
    native::evalHir [sourceHir $text]
} -result {list {{bool true} {bool false}}}

test set-native-gc-stress-pointer-members {construction and membership of a set of heap-valued (String/List) members survive under BOTLISH_NATIVE_GC_STRESS=1, repeated many times} -body {
    set ::env(BOTLISH_NATIVE_GC_STRESS) 1
    set text {fn build(n):
    if n == 0:
        immutable_set_from_list(["a", "b", "c", "a"])
    else:
        s = immutable_set_from_list([concat("x", "y"), [1, 2], [3, 4]])
        build(n - 1)
fn probe():
    s = build(300)
    [immutable_set_contains(s, "a"), immutable_set_contains(s, "z"), s == immutable_set_from_list(["c", "b", "a", "a"])]
probe()}
    set result [catch {native::evalHir [sourceHir $text]} value]
    unset ::env(BOTLISH_NATIVE_GC_STRESS)
    list $result $value
} -result {0 {list {{bool true} {bool false} {bool true}}}}

test set-native-pointer-member-liveness {a set retains heap-valued members correctly even after the originating bindings that built them are no longer referenced, across an intervening allocation (GC stress)} -body {
    set ::env(BOTLISH_NATIVE_GC_STRESS) 1
    set text {fn make():
    a = concat("live-", "member")
    immutable_set_from_list([a])
fn probe():
    s = make()
    padding = [concat("junk", "1"), concat("junk", "2"), concat("junk", "3")]
    immutable_set_contains(s, concat("live-", "member"))
probe()}
    set result [catch {native::evalHir [sourceHir $text]} value]
    unset ::env(BOTLISH_NATIVE_GC_STRESS)
    list $result $value
} -result {0 {bool true}}

cleanupTests
