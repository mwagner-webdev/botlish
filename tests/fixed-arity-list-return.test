# fixed-arity-list-return.test -- the FIXED-ARITY-LIST-RETURN compiler warning
# (WARNINGS-FIXED-ARITY-LIST-RETURN.md, MULTI-VALUE-RESULTS.md) on the warning
# framework WARNINGS-SAME-RETURN.md built (hir/warnings.tcl).
#
# The shape theorem: a function is reported exactly when it has at least one
# literal exit, and every reachable value exit is a written list literal of
# arity N (N >= 2), a read of a binding whose initializer is a written list
# literal of N elements, or a direct self-call -- all with the same N.
#
# Any single mismatch silences, so most cases here pin where it must NOT
# fire. Three exit treatments deliberately differ from SAME-RETURN-VALUE's
# and are pinned as such: a unit exit is a mismatch (not a skip), `fail` does
# not block, and a self-call exit counts and inherits N.
#
# Like warnings.test and method-eligible.test, every compile here passes its
# policy and channel explicitly (`-warnings MODE`, `-warning-channel ""` to
# collect without printing), so this file exercises default, off and error
# whatever the harness's process default is.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]

testConstraint executableAot [expr {$::tcl_platform(os) eq "Linux" &&
    $::tcl_platform(machine) in {x86_64 amd64}}]

set ::allBackends {interp compile cranelift-generic cranelift}
set ::faCode FIXED-ARITY-LIST-RETURN

# The HIR of SOURCE under policy MODE (default off error), collecting
# warnings without printing them.
proc compileWith {source {mode default}} {
    return [surface::compile $source t.bot -warnings $mode -warning-channel ""]
}

# "LINE:COL" of ORIGIN in HIR, without the file name when it is t.bot.
proc loc {hir origin} {
    return [regsub {^t\.bot:} [hir::originLocation $hir $origin] {}]
}

# The FIXED-ARITY-LIST-RETURN warnings of HIR.
proc fixedOf {hir} {
    return [lmap w [hir::warnings::of $hir] {
        if {[dict get $w code] ne $::faCode} continue
        set w
    }]
}

# Each FIXED-ARITY-LIST-RETURN warning of SOURCE as
# {PRIMARY ARITY EXITS {SECONDARY...}}, locations as LINE:COL.
proc fixed {source} {
    set hir [compileWith $source]
    return [lmap w [fixedOf $hir] {
        list [loc $hir [dict get $w primary]] [dict get $w data arity] [dict get $w data exits] \
            [lmap o [dict get $w secondary] {loc $hir $o}]
    }]
}

# "MESSAGE @ PRIMARY SECONDARY..." for each FIXED-ARITY-LIST-RETURN warning.
proc shown {source} {
    set hir [compileWith $source]
    return [lmap w [fixedOf $hir] {
        string cat [dict get $w message] " @ " \
            [join [lmap o [list [dict get $w primary] {*}[dict get $w secondary]] {loc $hir $o}] { }]
    }]
}

# 1 if SOURCE compiles with no FIXED-ARITY-LIST-RETURN warning.
proc silent {source} {
    return [expr {[fixedOf [compileWith $source]] eq ""}]
}

# Every warning of SOURCE (all codes) as {CODE PRIMARY}.
proc allWarnings {source} {
    set hir [compileWith $source]
    return [lmap w [hir::warnings::of $hir] {list [dict get $w code] [loc $hir [dict get $w primary]]}]
}

# The rejection of SOURCE under MODE: {errorcode message}, or "compiled".
proc rejection {source mode} {
    if {[catch {compileWith $source $mode} message options]} {
        return [list [dict get $options -errorcode] $message]
    }
    return compiled
}

# SCRIPT evaluated with ::core::libraryDir a scratch directory holding the
# modules FILES ({NAME.bot TEXT ...}), restored afterwards.
proc withModules {files script} {
    set saved $::core::libraryDir
    set dir [makeDirectory fa-scratch-[pid]]
    set ::core::libraryDir $dir
    try {
        foreach {name text} $files {
            set channel [open [file join $dir $name] w]
            puts -nonewline $channel $text
            close $channel
        }
        uplevel 1 $script
    } finally {
        set ::core::libraryDir $saved
        removeDirectory fa-scratch-[pid]
    }
}

# A helper the scanner examples call (the corpus's own `peek`): five lines,
# so the function after it starts on line 6.
set ::peek {import str
fn peek(text, index) errors LowerUnderrun:
    if index >= str::length(text):
        return ""
    str::substring(text, index, index + 1)
}

# ---------------------------------------------------------------------------
# The motivating shapes

test fa-scan-quoted {scan_quoted: one 2-element literal and two self-calls; anchored at the first exit, the recursive return} -body {
    shown "${::peek}fn scan_quoted(text, index, field) errors LowerUnderrun:
    character = peek(text, index)
    if character == \"\\\"\":
        if peek(text, index + 1) == \"\\\"\":
            return scan_quoted(text, index + 2, str::concat(field, \"\\\"\"))

        return \[field, index + 1\]

    scan_quoted(text, index + 1, str::concat(field, character))"
} -result {{a 2-element list is returned from all 3 value exits; a struct value names the parts @ 10:13 12:9 14:5}}

test fa-scan-quoted-rendered {the rendered diagnostic: one warning line and one note per other exit} -body {
    set hir [compileWith "${::peek}fn scan_quoted(text, index, field) errors LowerUnderrun:
    character = peek(text, index)
    if character == \"\\\"\":
        if peek(text, index + 1) == \"\\\"\":
            return scan_quoted(text, index + 2, str::concat(field, \"\\\"\"))

        return \[field, index + 1\]

    scan_quoted(text, index + 1, str::concat(field, character))"]
    hir::warnings::render $hir [lindex [fixedOf $hir] 0]
} -result {t.bot:10:13: warning: a 2-element list is returned from all 3 value exits; a struct value names the parts (FIXED-ARITY-LIST-RETURN)
t.bot:12:9: note: also returned here
t.bot:14:5: note: also returned here}

test fa-scan-record-rest {scan_record_rest's shape: one self-call and two 2-element literals} -body {
    fixed "${::peek}fn scan_record_rest(text, stop, count) errors LowerUnderrun:
    delimiter = peek(text, stop)
    if delimiter == \",\":
        return scan_record_rest(text, stop + 1, count + 1)

    if delimiter == \"\\n\":
        return \[count, stop + 1\]

    \[count, stop\]"
} -result {{9:9 2 3 {12:9 14:5}}}

test fa-chunked-builder {a builder state returned as a 3-element list from two exits (csv_chunked's shape)} -body {
    fixed {fn chunked_append(builder, value, completed, current, filled):
    if filled == 64:
        return [completed, value, 1]
    [completed, current, filled + 1]}
} -result {{3:9 3 2 4:5}}

test fa-fully-literal-uniform {every exit a written 2-element literal, no recursion} -body {
    fixed {fn split_at(xs, i):
    if i == 0:
        return [[], xs]
    if i == 1:
        return [xs, []]
    [xs, xs]}
} -result {{3:9 2 3 {5:9 6:5}}}

# ---------------------------------------------------------------------------
# Shape and arity (items 7, 8, 14)

test fa-two-elements-warn {a uniform 2-element function warns} -body {
    fixed {fn f(x, a, b):
    if x:
        return [a, b]
    [b, a]}
} -result {{3:9 2 2 4:5}}

test fa-three-elements-warn {a uniform 3-element function warns} -body {
    fixed {fn f(x, a, b):
    if x:
        return [a, b, a]
    [b, a, b]}
} -result {{3:9 3 2 4:5}}

test fa-arity-boundary {arity 1: silent; 2: warns; 3: warns; 0: silent} -body {
    fixed {fn f0(x):
    if x:
        return []
    []
fn f1(x, a):
    if x:
        return [a]
    [a]
fn f2(x, a):
    if x:
        return [a, a]
    [a, a]
fn f3(x, a):
    if x:
        return [a, a, a]
    [a, a, a]}
} -result {{11:9 2 2 12:5} {15:9 3 2 16:5}}

test fa-empty-list-exit-mismatches {a `[]` exit beside 2-element literals is a mismatch} -body {
    silent {fn f(x, a, b):
    if x:
        return []
    [a, b]}
} -result 1

test fa-one-element-exit-mismatches {a 1-element exit beside 2-element literals is a mismatch} -body {
    silent {fn f(x, a, b):
    if x:
        return [a]
    [a, b]}
} -result 1

test fa-single-exit-warns {single-exit functions warn (unlike SAME-RETURN-VALUE's two-exit threshold)} -body {
    shown {fn pair(a, b):
    [a, b]}
} -result {{a 2-element list is returned from the only value exit; a struct value names the parts @ 2:5}}

test fa-single-exit-one-element-silent {a single-exit 1-element function is silent} -body {
    silent {fn wrap(a):
    [a]}
} -result 1

test fa-mixed-arity-silent {mixed arity silences} -body {
    silent {fn f(x, a, b):
    if x:
        return [a, b, a]
    [a, b]}
} -result 1

test fa-element-types-irrelevant {element types are never consulted: unknown, mixed and uniform elements all count} -body {
    fixed {fn date(y, m, d):
    [y, m, d]
fn table(t, i):
    [t, i]
fn mixed(x, s):
    if x:
        return [1, s]
    ["one", [s]]}
} -result {{2:5 3 1 {}} {4:5 2 1 {}} {7:9 2 2 8:5}}

test fa-computed-elements-count {elements that are calls or operators do not matter: the exit is still a written 2-element literal} -body {
    fixed {fn compute(x):
    x
fn f(x, y):
    return [compute(x), y + 1]}
} -result {{4:5 2 1 {}}}

test fa-nested-list-elements-outer-arity {a literal of literals has its outer arity} -body {
    fixed {fn f(a, b):
    [[a, b, a], [b]]}
} -result {{2:5 2 1 {}}}

# ---------------------------------------------------------------------------
# Literal-shaped, not text-matched (item 9): only `written {form list}` counts

test fa-computed-list-append-silent {an exit built by list::append is not literal-shaped} -body {
    silent {import list
fn f(x, a, b):
    if x:
        return [a, b]
    list::append([a], b)}
} -result 1

test fa-computed-concat-silent {an exit built by str::concat (or any other function) is not literal-shaped} -body {
    silent {import str
fn f(x, a, b):
    if x:
        return [a, b]
    str::concat(a, b)}
} -result 1

test fa-method-sugar-construction-silent {a list built with method sugar is not literal-shaped} -body {
    silent {import list
fn f(x, xs, b):
    if x:
        return [b, b]
    xs.append(b)}
} -result 1

test fa-computed-list-alone-silent {a function whose only exit is a computed 2-element list is silent} -body {
    silent {import list
fn f(a, b):
    list::append([a], b)}
} -result 1

test fa-operator-exit-silent {an operator exit is not a literal} -body {
    silent {fn f(x, a, b):
    if x:
        return [a, b]
    a + b}
} -result 1

test fa-function-value-call-exit-silent {a call through a function value (a parameter) is a mismatch} -body {
    silent {fn f(x, k, a, b):
    if x:
        return [a, b]
    k(a, b)}
} -result 1

test fa-call-of-list-returning-helper-silent {a call to another list-returning function is an ordinary call of unknown shape} -body {
    fixed {fn pair(a, b):
    [a, b]
fn f(x, a, b):
    if x:
        return [a, b]
    pair(b, a)}
} -result {{2:5 2 1 {}}}

test fa-if-valued-return-silent {`return if ...` is one exit whose value is an `if`, not a written literal (conservative)} -body {
    silent {fn f(x, a, b):
    return if x:
        [a, b]
    else:
        [b, a]}
} -result 1

test fa-if-valued-binding-silent {a binding initialized by an `if` value is not a literal initializer (conservative)} -body {
    silent {fn f(x, a, b):
    r = if x:
        [a, b]
    else:
        [b, a]
    r}
} -result 1

test fa-collecting-loop-exit-silent {a final collecting loop is a computed list (bench/source-checks.bot's shape)} -body {
    silent {fn classify(name, checks):
    if name == "":
        return [false, false]
    loop check in checks:
        check(name)}
} -result 1

test fa-handled-value-exit-silent {a handled call's value is not a literal} -body {
    silent {import list
fn f(xs, a, b):
    if a == b:
        return [a, b]
    return list::at(xs, 0):
        on IndexNotFound:
            [b, a]}
} -result 1

test fa-core-ir-input-silent {HIR built from core IR carries no written provenance: never a literal} -body {
    set hir [hir::build {{bind f {block {a b} {call {ref list} {ref a} {ref b}}}} {call {ref f} {const 1} {const 2}}}]
    hir::warnings::collect $hir
} -result {}

test fa-hir-text-input-silent {HIR read back from hir::format text carries no provenance: the source HIR warns, the parsed one never} -body {
    set hir [compileWith {fn f(a, b):
    [a, b]
f(1, 2)}]
    set parsed [hir::parse [hir::format $hir]]
    list [llength [fixedOf $hir]] [lmap w [hir::warnings::collect $parsed] {dict get $w code}]
} -result {1 {}}

# ---------------------------------------------------------------------------
# Computed and mutable values; structs and mixed shapes (items 10, 13)

test fa-mutable-value-silent {a mutable value exit (a MutableArray) is a mismatch} -body {
    silent {import mutable_array
fn f(x, a, b):
    if x:
        return [a, b]
    mutable_array::allocate(2)}
} -result 1

test fa-parameter-exit-silent {a parameter exit is a mismatch} -body {
    silent {fn f(x, p, a, b):
    if x:
        return [a, b]
    p}
} -result 1

test fa-struct-exit-silent {a struct-value exit is not a list} -body {
    silent {fn f(a, b):
    {first: a, second: b}}
} -result 1

test fa-mixed-struct-list-silent {mixed struct and list exits are silent: a half-converted function does not nag} -body {
    silent {fn f(x, a, b):
    if x:
        return {first: a, second: b}
    [a, b]}
} -result 1

test fa-converted-scan-quoted-silent {the converted form (struct literal) of scan_quoted is silent} -body {
    silent "${::peek}fn scan_quoted(text, index, field) errors LowerUnderrun:
    character = peek(text, index)
    if character == \"\\\"\":
        if peek(text, index + 1) == \"\\\"\":
            return scan_quoted(text, index + 2, str::concat(field, \"\\\"\"))

        return {field: field, index: index + 1}

    scan_quoted(text, index + 1, str::concat(field, character))"
} -result 1

# ---------------------------------------------------------------------------
# Unit exits are a MISMATCH (item 5): the documented deviation from
# SAME-RETURN-VALUE, which skips unit exits

test fa-unit-elseless-if-optional {fn f(x): if x: [a, b] -- "list or nothing" is an optional, not a fixed-arity result: silent} -body {
    silent {fn f(x, a, b):
    if x:
        [a, b]}
} -result 1

test fa-unit-elseless-if-control {the same function with an else warns: the silence above is the fall-through's doing} -body {
    fixed {fn f(x, a, b):
    if x:
        [a, b]
    else:
        [b, a]}
} -result {{3:9 2 2 5:9}}

test fa-unit-bare-return {a bare `return` beside a list final is a unit exit: silent} -body {
    silent {fn f(x, a, b):
    if x:
        return
    [a, b]}
} -result 1

test fa-unit-return-unit {`return unit` is a unit exit: silent} -body {
    silent {fn f(x, a, b):
    if x:
        return unit
    [a, b]}
} -result 1

test fa-unit-final-unit {a final `unit` is a unit exit: silent} -body {
    silent {fn f(x, a, b):
    if x:
        return [a, b]
    unit}
} -result 1

test fa-unit-destructuring-final {a destructuring statement as the last statement completes with unit: silent} -body {
    silent {fn f(x, a, b):
    if x:
        return [a, b]
    {p} = {p: a}}
} -result 1

test fa-unit-final-binding-of-alias {a final `s = r` statement completes with unit, not with r's list: silent} -body {
    silent {fn f(a, b):
    r = [a, b]
    s = r}
} -result 1

test fa-unit-elseless-if-with-return {an else-less final `if` whose branch returns still falls through with unit} -body {
    silent {fn f(x, a, b):
    if x:
        return [a, b]}
} -result 1

test fa-unit-elif-without-else {an elif chain without else falls through: silent; with an else it warns} -body {
    list [silent {fn f(x, a, b):
    if x == 1:
        [a, b]
    elif x == 2:
        [b, a]}] [fixed {fn f(x, a, b):
    if x == 1:
        [a, b]
    elif x == 2:
        [b, a]
    else:
        [a, a]}]
} -result {1 {{3:9 2 3 {5:9 7:9}}}}

test fa-unit-fallthrough-decided-away {a fall-through HIR decides away (`if true:`) is not an exit} -body {
    fixed {fn f(a, b):
    if true:
        [a, b]}
} -result {{3:9 2 1 {}}}

test fa-unit-milestone1-policy-differs {the same unit-bearing function: SAME-RETURN-VALUE skips the unit exits, this warning is silenced by them} -body {
    set hir [compileWith {fn f(x, a, b):
    if x == 1:
        return
    if x == 2:
        return
    [a, b]}]
    list [lmap w [hir::warnings::of $hir] {dict get $w code}]
} -result {{}}

test fa-unit-non-final-elseless-if-is-no-exit {an else-less `if` that is not the last statement falls through to the next statement, not out of the function} -body {
    fixed {fn f(x, a, b):
    if x:
        a
    [a, b]}
} -result {{4:5 2 1 {}}}

# ---------------------------------------------------------------------------
# `fail` does not block (item 6)

test fa-fail-guard-warns {the procedural guard pattern warns: fail is not a value exit} -body {
    shown {import list
error Empty
fn f(xs) errors Empty:
    if xs == []:
        fail Empty
    [xs, list::length(xs)]}
} -result {{a 2-element list is returned from the only value exit; a struct value names the parts @ 6:5}}

test fa-fail-final-contributes-no-exit {a body ending in fail contributes no exit} -body {
    fixed {error Bad
fn f(x, a, b) errors Bad:
    if x:
        return [a, b]
    fail Bad}
} -result {{4:9 2 1 {}}}

test fa-fail-all-silent {a function whose every completion is fail has no value exit: silent} -body {
    silent {error Bad
fn f(x) errors Bad:
    if x:
        fail Bad
    fail Bad}
} -result 1

test fa-fail-in-branch-beside-literals {fail in one branch of a final if, literals in the others} -body {
    fixed {error Bad
fn f(x, a, b) errors Bad:
    if x == 1:
        [a, b]
    elif x == 2:
        fail Bad
    else:
        [b, a]}
} -result {{4:9 2 2 8:9}}

test fa-never-completing-exit-is-no-value-exit {an exit whose value can never complete is not a value exit} -body {
    fixed {fn spin():
    loop:
        unit
fn f(x, a, b):
    if x:
        return [a, spin()]
    [a, b]}
} -result {{7:5 2 1 {}}}

# ---------------------------------------------------------------------------
# Alias-of-literal exits (item 11). Soundness precondition, verified:
# bindings are immutable and a second binding of a name in the same scope is
# a DUPLICATE error, so every binding has exactly one initializer; a branch's
# binding of the same name is a new (shadowing) binding.

test fa-alias-initializer-literal {r = [a, b]; return r -- the initializer decides} -body {
    fixed {fn f(x, a, b):
    r = [a, b]
    if x:
        return r
    [b, a]}
} -result {{4:9 2 2 5:5}}

test fa-alias-chain-to-root {an alias chain resolves to the root binding, whose initializer decides} -body {
    fixed {fn f(a, b):
    r = [a, b]
    s = r
    t = s
    t}
} -result {{5:5 2 1 {}}}

test fa-alias-beside-literal-same-arity {an alias-of-literal exit beside a literal of the same arity} -body {
    fixed {fn f(x, a, b):
    r = [a, b, a]
    if x:
        return r
    [b, a, b]}
} -result {{4:9 3 2 5:5}}

test fa-alias-beside-literal-other-arity {an alias of a 3-element literal beside a 2-element literal mismatches} -body {
    silent {fn f(x, a, b):
    r = [a, b, a]
    if x:
        return r
    [b, a]}
} -result 1

test fa-alias-of-computed-silent {an alias of a computed list is not literal-shaped} -body {
    silent {import list
fn f(x, a, b):
    r = list::append([a], b)
    if x:
        return r
    [b, a]}
} -result 1

test fa-alias-of-parameter-silent {an alias of a parameter is a parameter} -body {
    silent {fn f(x, p, a, b):
    r = p
    if x:
        return r
    [a, b]}
} -result 1

test fa-alias-of-mutable-silent {an alias of a mutable value is a mismatch} -body {
    silent {import mutable_array
fn f(x, a, b):
    r = mutable_array::allocate(2)
    if x:
        return r
    [a, b]}
} -result 1

test fa-alias-module-level-binding {a top-level binding initialized by a literal counts like a local one} -body {
    fixed {pair = [1, 2]
fn f(x, a):
    if x:
        return pair
    [a, a]}
} -result {{4:9 2 2 5:5}}

test fa-rebinding-same-scope-is-an-error {a same-scope rebinding is DUPLICATE: the program is rejected and never warned about} -body {
    set source {fn f(a, b):
    r = [a, b]
    r = [a, b, a]
    r}
    set hir [surface::compile $source t.bot -strict 0 -warnings default -warning-channel ""]
    list [lindex [rejection $source default] 0] [lmap d [hir::diagnostics $hir] {dict get $d kind}] [hir::warnings::of $hir]
} -result {{CORE SEMANTIC DUPLICATE} DUPLICATE {}}

test fa-rebinding-in-branch-is-a-shadow {a branch's `r = ...` is a new binding with its own initializer: 3 and 2 elements mismatch} -body {
    silent {fn f(x, a, b):
    r = [a, b]
    if x:
        r = [a, b, a]
        return r
    r}
} -result 1

test fa-rebinding-in-branch-same-arity {the shadowing binding and the outer one, both 2-element literals: two alias exits} -body {
    fixed {fn f(x, a, b):
    r = [a, b]
    if x:
        r = [b, a]
        return r
    r}
} -result {{5:9 2 2 6:5}}

test fa-alias-is-not-a-final-value-copy {the binding statement itself is never an exit: only a read of the binding is} -body {
    fixed {fn f(a, b):
    r = [a, b]
    r}
} -result {{3:5 2 1 {}}}

# ---------------------------------------------------------------------------
# Self-recursion (item 12)

test fa-self-call-and-literal {one self-call and one literal: the self-call is counted and inherits N} -body {
    set hir [compileWith {fn f(n, a, b):
    if n == 0:
        return [a, b]
    f(n - 1, a, b)}]
    set w [lindex [fixedOf $hir] 0]
    list [dict get $w data exits] [llength [dict get $w data selfCalls]] [dict get $w data arity] \
        [lmap s [dict get $w data selfCalls] {dict get $hir exprs $s kind}]
} -result {2 1 2 call}

test fa-all-self-calls-silent {a function whose exits are all self-calls has no N: silent} -body {
    silent {fn f(n, a, b):
    if n == 0:
        return f(n, a, b)
    f(n - 1, a, b)}
} -result 1

test fa-aliased-self-call {a self-call through an alias (g = f inside f) counts as a self-call} -body {
    set hir [compileWith {fn f(n, a, b):
    g = f
    if n == 0:
        return [a, b]
    g(n - 1, a, b)}]
    set w [lindex [fixedOf $hir] 0]
    list [dict get $w data exits] [llength [dict get $w data selfCalls]]
} -result {2 1}

test fa-method-sugar-self-call {a self-call written with method sugar is a self-call} -body {
    fixed {fn f(n, a, b):
    if n == 0:
        return [a, b]
    (n - 1).f(a, b)}
} -result {{3:9 2 2 4:6}}

test fa-indirect-recursion-silent {indirect recursion through a nested helper is an ordinary call of unknown shape: silent} -body {
    silent {fn f(n, a, b):
    fn h(m):
        f(m, a, b)
