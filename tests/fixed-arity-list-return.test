# ---------------------------------------------------------------------------
# Interleaving with the two existing codes, ordering, the policy matrix

set ::threeSource {fn dup(x):
    if x < 0:
        return 0
    if x > 100:
        return 0
    return 1
fn two(a, b):
    a
fn pair(a, b):
    [a, b]
fn t(x):
    return two(x, 1)}

