    set a [compileWith $source off]
    set b [compileWith $source default]
    set c [catch {compileWith $source error}]
    set d [compileWith $source off]
    set e [compileWith $source default]
    list [llength [fixedOf $a]] [llength [fixedOf $b]] $c [llength [fixedOf $d]] [llength [fixedOf $e]]
} -result {0 1 1 0 1}

test fa-warnings-attached-structurally {hir::warnings::of equals collect} -body {
    set hir [compileWith $::threeSource default]
    list [expr {[hir::warnings::of $hir] eq [hir::warnings::collect $hir]}] [llength [hir::warnings::collect $hir]]
} -result {1 3}

test fa-error-stops-before-backend {error mode rejects before any backend lowers anything (traces on all four entry points)} -body {
    set source {fn pair(a, b):
    [a, b]
pair(1, 2)}
    set ::lowerCalls 0
    foreach command {native::evalHir native::prepareHir hir::lower core::compiler::evalHir} {
        trace add execution $command enter {apply {{args} {incr ::lowerCalls}}}
    }
    try {
        set rejected [catch {compileWith $source error}]
    } finally {
        foreach command {native::evalHir native::prepareHir hir::lower core::compiler::evalHir} {
            trace remove execution $command enter {apply {{args} {incr ::lowerCalls}}}
        }
    }
    list $rejected $::lowerCalls
} -result {1 0}

# ---------------------------------------------------------------------------
# No semantics change (item 24)

set ::runSource {fn pair(a, b):
    if a == 0:
        return [b, a]
    [a, b]
p = pair(3, 4)
p}

test fa-hir-identical-across-modes {HIR (minus the side table), hir::format and hir::lower are identical under off and default} -body {
    set off [compileWith $::runSource off]
    set on [compileWith $::runSource default]
    list [llength [fixedOf $on]] [expr {$off eq [dict remove $on warnings]}] [expr {[hir::format $off] eq [hir::format $on]}] \
        [expr {[hir::lower $off] eq [hir::lower $on]}] [dict exists $off warnings]
} -result {1 1 1 1 0}

test fa-nir-identical-across-modes {native IR (specialized and generic) is identical with warnings off and on} -body {
    set off [compileWith $::runSource off]
    set on [compileWith $::runSource default]
    list [expr {[native::nir $off] eq [native::nir $on]}] [expr {[native::nir $off -specialize 0] eq [native::nir $on -specialize 0]}]
} -result {1 1}

test fa-machine-readable-outputs-clean {native::report, NIR and CLIF are identical with and without the warnings side table} -body {
    set on [compileWith $::runSource default]
    set bare [dict remove $on warnings]
    expr {[llength [fixedOf $on]] == 1 && [native::report $on] eq [native::report $bare]
        && [native::nir $on] eq [native::nir $bare] && [native::clif $on] eq [native::clif $bare]}
} -result 1

test fa-no-warning-text-in-machine-readable-outputs {neither NIR, CLIF, the report nor HIR text mention the warning} -body {
    set hir [compileWith $::runSource default]
    set seen 0
    foreach text [list [native::nir $hir] [native::clif $hir] [native::report $hir] [hir::format $hir]] {
        foreach word {FIXED-ARITY warning "struct value" "names the parts"} {
            if {[string first $word $text] >= 0} {
                incr seen
            }
        }
    }
    set seen
} -result 0

test fa-annotation-changes-nothing-else {annotated and unannotated twins: same core IR shape and value; the annotation is a type declaration, not a warning switch} -body {
    set annotated [compileWith {fn pair(a: int, b: int) -> List[int]:
    [a, b]
pair(3, 4)} off]
    set plain [compileWith {fn pair(a: int, b: int):
    [a, b]
pair(3, 4)} off]
    list [core::formatValue [core::evalProgram [hir::lower $annotated]]] \
        [core::formatValue [core::evalProgram [hir::lower $plain]]] \
        [expr {[hir::lower $annotated] eq [hir::lower $plain]}]
} -result {{[3, 4]} {[3, 4]} 1}

# ---------------------------------------------------------------------------
# Backend independence

test fa-backend-independent {every backend runs the program identically; the one warning set is the HIR's} -body {
    set hir [compileWith $::runSource default]
    set outcomes [lmap backend $::allBackends {outcomeUnderHir $backend $hir}]
    list [llength [lsort -unique [lmap o $outcomes {lindex $o 1}]]] [lindex $outcomes 0 1] [llength [fixedOf $hir]]
} -result {1 {[3, 4]} 1}

test fa-backend-independent-off {the same program runs identically on every backend with warnings off} -body {
    set hir [compileWith $::runSource off]
    lsort -unique [lmap backend $::allBackends {lindex [outcomeUnderHir $backend $hir] 1}]
} -result {{[3, 4]}}

# ---------------------------------------------------------------------------
# The conversion's checker, as it actually is (WARNINGS-FIXED-ARITY-LIST-
# RETURN.md, "The honest gap"): converted call sites that read fields are
# type-checked; a leftover positional read is caught statically only where it
# reaches a source function's inferred list parameter, at run time where it
# reaches a native directly, and not at all by `==` against a list.

set ::converted {import list
fn pair(a, b):
    {p0: a, p1: b}
}

test fa-conversion-field-reads-checked {a field read that does not exist on the converted result is a compile-time UNKNOWN-FIELD} -body {
    lindex [rejection "${::converted}fn use(x):
    r = pair(x, 1)
    r.p2
use(1)" default] 0
} -result {CORE SEMANTIC UNKNOWN-FIELD}

test fa-conversion-field-reads-compile {the converted reads compile and run} -body {
    set hir [compileWith "${::converted}fn use(x):
    r = pair(x, 1)
    \[r.p1, r.p0\]
use(5)" off]
    core::formatValue [core::evalProgram [hir::lower $hir]]
} -result {[1, 5]}

test fa-conversion-leftover-through-source-function {a leftover positional read through a source function (list::get) is a compile-time TYPE error} -body {
    lindex [rejection "${::converted}list::get(pair(1, 2), 0, 7)" default] 0
} -result {CORE SEMANTIC TYPE}

test fa-conversion-leftover-native-read-is-a-run-time-error {GAP: a leftover direct native read (list::at) compiles and fails at run time with a kind error} -body {
    set hir [compileWith "${::converted}v = list::at(pair(1, 2), 0):
    on IndexNotFound:
        0
v" off]
    list [catch {core::evalProgram [hir::lower $hir]} message] [string match "*expected list*" $message]
} -result {1 1}

test fa-conversion-leftover-equality-is-silent {GAP: a leftover `==` against a list literal compiles and is silently false} -body {
    set hir [compileWith "${::converted}pair(1, 2) == \[1, 2\]" off]
    core::formatValue [core::evalProgram [hir::lower $hir]]
} -result false

# ---------------------------------------------------------------------------
# The command line

test fa-cli-modes {main.tcl: default prints the warning and its notes on stderr and runs; off is silent; error rejects before running} -constraints executableAot -body {
    set main [file join $::projectRoot main.tcl]
    set path [makeFile $::runSource fa-cli-[pid].bot]
    set results {}
    foreach mode {default off error} {
        set status [catch {exec [info nameofexecutable] $main -warnings $mode $path 2>@1} out]
        lappend results [list $mode $status \
            [regexp {warning: a 2-element list is returned from all 2 value exits; a struct value names the parts \(FIXED-ARITY-LIST-RETURN\)} $out] \
            [regexp {note: also returned here} $out] \
            [regexp {value: \[3, 4\]} $out] \
            [regexp {CORE SEMANTIC FIXED-ARITY-LIST-RETURN} $out]]
    }
    removeFile fa-cli-[pid].bot
    set results
} -result {{default 0 1 1 1 0} {off 0 0 0 1 0} {error 1 0 0 0 1}}

test fa-cli-no-wno-option {-Wno-fixed-arity-list-return is an unknown option, not a file name} -constraints executableAot -body {
    set main [file join $::projectRoot main.tcl]
    set path [makeFile $::runSource fa-cli-wno-[pid].bot]
    catch {exec [info nameofexecutable] $main -Wno-fixed-arity-list-return $path 2>@1} out
    removeFile fa-cli-wno-[pid].bot
    list [string match "*unknown option*-Wno-fixed-arity-list-return*" $out] [string match "*value:*" $out]
} -result {1 0}

test fa-cli-unknown-mode {main.tcl rejects an unknown mode} -constraints executableAot -body {
    set main [file join $::projectRoot main.tcl]
    set path [makeFile $::runSource fa-cli-mode-[pid].bot]
    set status [catch {exec [info nameofexecutable] $main -warnings tuples $path 2>@1} out]
    removeFile fa-cli-mode-[pid].bot
    list $status [string match "*unknown warnings mode*" $out]
} -result {1 1}

test fa-cli-stdout-clean {the warning goes to stderr: program stdout carries no warning text} -constraints executableAot -body {
    set main [file join $::projectRoot main.tcl]
    set path [makeFile $::runSource fa-cli-stdout-[pid].bot]
    set stderrPath [makeFile {} fa-cli-stderr-[pid].txt]
    set out [exec [info nameofexecutable] $main -warnings default $path 2> $stderrPath]
    set err [viewFile fa-cli-stderr-[pid].txt]
    removeFile fa-cli-stdout-[pid].bot
    removeFile fa-cli-stderr-[pid].txt
    list [string match *warning* $out] [string match *FIXED-ARITY-LIST-RETURN* $err] [string match {*value: \[3, 4\]*} $out]
} -result {0 1 1}

test fa-error-cli-stops-before-backend {main.tcl -backend cranelift -warnings error rejects without lowering or running anything} -constraints executableAot -body {
    set main [file join $::projectRoot main.tcl]
    set path [makeFile $::runSource fa-cli-error-[pid].bot]
    catch {exec [info nameofexecutable] $main -backend cranelift -warnings error $path 2>@1} out
    removeFile fa-cli-error-[pid].bot
    list [string match "*value:*" $out] [regexp {\(CORE SEMANTIC FIXED-ARITY-LIST-RETURN\)} $out]
} -result {0 1}

test fa-cli-backend-independent-stdlib {main.tcl prints the same FIXED-ARITY-LIST-RETURN text on every backend over the whole stdlib corpus} -constraints executableAot -body {
    set main [file join $::projectRoot main.tcl]
    set programs [lsort [glob -directory [file join $::projectRoot examples stdlib] *.bot]]
    set mismatches {}
    set total 0
    foreach path $programs {
        set texts {}
        foreach backend $::allBackends {
            set err [makeFile {} fa-cli-err-[pid].txt]
            catch {exec [info nameofexecutable] $main -backend $backend -warnings default $path 2> $err}
            set lines [split [viewFile fa-cli-err-[pid].txt] \n]
            set block {}
            set inside 0
            foreach line $lines {
                if {[string match *FIXED-ARITY-LIST-RETURN* $line]} {
                    set inside 1
                    lappend block $line
                } elseif {$inside && [string match "*: note: *" $line]} {
                    lappend block $line
                } else {
                    set inside 0
                }
            }
            lappend texts $block
            removeFile fa-cli-err-[pid].txt
        }
        incr total [llength [lsearch -all [lindex $texts 0] *FIXED-ARITY-LIST-RETURN*]]
        if {[llength [lsort -unique $texts]] != 1} {
            lappend mismatches [file tail $path]
        }
    }
    list $mismatches [expr {$total > 0}]
} -result {{} 1}

# ---------------------------------------------------------------------------
# Fuzzing: constructed programs, an independent oracle, all three modes, and
# the conversion law

test fa-fuzz-smoke {60 generated programs: predicted warnings (anchor and notes) and only them, off silent, error iff warned, every conversion holds} -constraints executableAot -body {
    set fuzz [file join $::projectRoot audit fixed-arity-list-return tools fuzz.tcl]
    exec [info nameofexecutable] $fuzz 60 1
} -result {seeds 60 (from 1): * with warnings, * without; failures 0; extra warnings 0; conversions * of *; excluded runs 0} -match glob

cleanupTests
