test actor-values-snapshot {a message holding a MutableVector, a MutableArray and a MutableMap is a logical copy: the sender's later mutation does not reach the receiver, nor the receiver's the sender} -body {
    acTrace values
} -result {{sender changed its own after sending: parcel nums.length=4 grid[0]=70 table[k]=2} {receiver got: parcel nums.length=3 grid[0]=7 table[k]=1} {receiver changed its copy: parcel nums.length=4 grid[0]=1000 table[k]=1000} {sender got the reply: parcel nums.length=4 grid[0]=1000 table[k]=1000} {sender's own is unchanged by the receiver: parcel nums.length=4 grid[0]=70 table[k]=2}}

# --------------------------------------------------------------------------
# Lifecycle (lifecycle.bot)

test actor-lifecycle-failure-reaped {an actor that fails (TaskFailed 7, or its own IndexNotFound) is reaped by its host at once: its outcome is Failed with its code, its queued messages are counted undelivered, a sender waiting for room wakes with Closed, later sends are Closed -- and a plain task beside it is unaffected} -body {
    set t [acTrace lifecycle]
    list [acLines $t {outcome task [0-3] }] [acLines $t {log: (fragile|waiter)}] [acLines $t {after the run}]
} -result {{{t=4: main: outcome task 1 Failed 7} {t=4: main: outcome task 0 Returned 0} {t=4: main: outcome task 2 IndexNotFound 0} {t=4: main: outcome task 3 Returned 42}} {{t=4: log: fragile: failing with 7} {t=4: log: waiter: deliver answered Closed}} {{t=2: main: after the run, a send to fragile answers Closed: 1}}}

test actor-lifecycle-stop {an actor stops itself on a Stop message (what follows it is undelivered); two actors stopped together by the administration closing their mailboxes see Closed after what was queued} -body {
    acLines [acTrace lifecycle] {log: s[123]|closed s[12]}
} -result {{t=2: main: closed s1, undelivered 0} {t=2: main: closed s2, undelivered 0} {t=4: log: s3: stop message after messages 1} {t=4: log: s1: mailbox closed after messages 1} {t=4: log: s2: mailbox closed after messages 0}}

test actor-lifecycle-construction {a failure in an actor's first segment reaches its constructor (eager construction); its mailbox is closed by address (its one message undelivered); a failed construction started anyway is a Failed task, never Returned; the slot's reuse makes the old address Stale and the new mailbox gets nothing} -body {
    set t [acTrace lifecycle]
    list [acLines $t {construction|failed construction|after reuse|got nothing|then a send}] [acLines $t {outcome task 7 }]
} -result {{{t=3: main: the construction failed; closed its mailbox by address, undelivered 1} {t=3: main: then a send answers Closed: 1} {t=3: main: started the failed construction anyway as task 7} {t=3: main: the old address after reuse is Stale: 1} {t=3: main: the new mailbox got nothing: 0}} {{t=4: main: outcome task 7 Failed 3}}}

test actor-lifecycle-accounting {every message is received or counted undelivered (15 = 11 + 4); 7 actors started, 4 ended, 3 failed, none left running} -body {
    set t [acTrace lifecycle]
    lmap n {delivered received undelivered started ended failed running} {acStat $t $n}
} -result {15 11 4 7 4 3 0}

