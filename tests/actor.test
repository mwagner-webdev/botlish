# Coexistence (coexist.bot)

test actor-coexist-timeliness {beside 60 turns of actor ping-pong, the ordinary tasks are served on time: the 10 us ticker's ticks, the driver source's records at t=12 and t=27, the quiet task's event in the next turn} -body {
    acLines [acTrace coexist] {ticker:|reader:|quiet:|consumer:}
} -result {{t=2: quiet: posts in turn 2} {t=3: consumer: took the event in turn 3} {t=10: ticker: tick at time 10} {t=12: reader: record at time 12} {t=20: ticker: tick at time 20} {t=27: reader: record at time 27} {t=30: ticker: tick at time 30} {t=40: ticker: tick at time 40} {t=50: ticker: tick at time 50}}

test actor-coexist-outcomes {take_outcomes reports every task, actors and ordinary tasks alike, both failures included: std::actor consumes no outcome} -body {
    set t [acTrace coexist]
    list [lsort [acLines $t {outcome task}]] [acStat $t {actors failed}] [acStat $t {open mailboxes}]
} -result {{{t=60: main: outcome task 0 Returned 30} {t=60: main: outcome task 1 Returned 30} {t=60: main: outcome task 2 Failed 4} {t=60: main: outcome task 3 Returned 5} {t=60: main: outcome task 4 Returned 300} {t=60: main: outcome task 5 Returned 7} {t=60: main: outcome task 6 Returned 0} {t=60: main: outcome task 7 Failed 9}} 1 0}

# --------------------------------------------------------------------------
# Identity (identity.bot)

test actor-identity {three senders on one address: each one's messages arrive in its order; a copy of a Receiver receives nothing in another actor (Closed) while its owner gets every message; listening to a closed mailbox is Closed; after a slot's reuse the old address is Stale and the replacement gets only its own message} -body {
    acLines [acTrace identity] {log:|Stale|differs}
} -result {{t=11: main: Y's address differs from X's: 1} {t=11: main: a send to X's old address is Stale (Y reused its slot): 1} {t=12: log: thief: try_receive through a copied Receiver: Closed} {t=12: log: thief: receive through a copied Receiver: Closed} {t=12: log: owner got 10 and 20} {t=12: log: collector got sa1 sb1 sc1 sa2 sb2 sc2 sa3 sb3 sc3 } {t=12: log: latecomer: listen to a closed mailbox: Closed} {t=12: log: collector got xx1 } {t=12: log: collector got yy1 }}

test actor-replay {a mailbox is bound once: an actor started with another's first request (its listen, replayed) binds that mailbox, the rightful actor's listen is refused (Closed) while the impostor still holds it, the impostor receives nothing through its own Receiver (Closed), and the mailbox closes with the impostor -- nobody reads another's messages} -body {
    acTrace replay
} -result {{t=2: xx: listen answered Closed} {t=2: yy: receive answered Closed} {t=2: queued for X: 0} {t=2: queued for Y: 1}}

# --------------------------------------------------------------------------
# What the compiler must reject

proc acKinds {path} {
    if {[catch {surface::readProgramFile $path -warnings off} message options]} {
        if {[dict exists $options -diagnostics]} {
            return [lsort -unique [lmap d [dict get $options -diagnostics] {lindex [dict get $d errorcode] end}]]
        }
        return [lindex [dict get $options -errorcode] end]
    }
    return ok
}

foreach {name kind} {
    wrong-type          TYPE
    forge-address       OPAQUE-CONSTRUCTION
    forge-inbox         OPAQUE-CONSTRUCTION
    forge-request       OPAQUE-CONSTRUCTION
    forge-receiver      OPAQUE-CONSTRUCTION
    read-address        OPAQUE-REPRESENTATION
    copy-inbox          AFFINE-NOT-DEFINITELY-LIVE
    listen-twice        USE-AFTER-MOVE
    drain-twice         USE-AFTER-MOVE
    resume-started      USE-AFTER-MOVE
    inbox-from-address  IMPRINT
    affine-message      IMPRINT
    recover-internal    INTERNAL-NAMESPACE
    loop-yield          {COROUTINE-RESULT-MISMATCH COROUTINE-RESUME-CONFLICT}
    top-level-receive   UNWRAPPED-YIELD
} {
    test actor-static-$name "tests/actor/reject-$name.bot is rejected with $kind (its header says why)" -body {
        acKinds [file join $::acDir reject-$name.bot]
    } -result $kind
}

# --------------------------------------------------------------------------
# The library's own invariants, read from its source

test actor-source-recover {the recovery intrinsic is internal, is the identity on every backend, and has one caller: std::actor's recovered, after checking that the answer carries the receiving Receiver's own mailbox identity (slot and generation)} -body {
    set text [core::ReadFile [file join $::projectRoot stdlib actor.bot]]
    set calls [regexp -all -- {std::actor::recover\[} $text]
    set guarded [regexp -- {private nomethod fn recovered\(rx: Receiver\[M\], a: Answer\) -> M errors Closed:\n    if a\.status != a_message or a\.slot != rx\.slot or a\.gen != rx\.gen:\n        fail Closed\n    std::actor::recover\[M\]\(a\.payload\)\n} $text]
    list $calls $guarded [core::native::isInternalMember std::actor::recover] \
        [dict get $::native::lower::natives std::actor::recover] [core::actor::recover {probe value}]
} -result {1 1 1 same {probe value}}

test actor-source-ordinary {std::actor is ordinary Botlish over std::event_loop: its one intrinsic is recover; no native runtime file, NIR operation or Tcl runtime of the compiler names actors, mailboxes or the library} -body {
    set natives [lmap n [core::native::names] {expr {[string match std::actor::* $n] ? $n : [continue]}}]
    set mentions {}
    foreach path [concat [glob -directory [file join $::projectRoot native src] -types f *.rs] \
            [glob -directory [file join $::projectRoot native src runtime] -types f *.rs] \
            [glob -directory [file join $::projectRoot native src codegen] -types f *.rs]] {
        if {[regexp -nocase -- {std::actor|mailbox|postbox} [core::ReadFile $path]]} {
            lappend mentions [file tail $path]
        }
    }
    foreach dir {hir compiler surface} {
        foreach path [glob -directory [file join $::projectRoot $dir] -types f *.tcl] {
            if {[regexp -- {std::actor} [core::ReadFile $path]]} {
                lappend mentions $dir/[file tail $path]
            }
        }
    }
    list $natives $mentions
} -result {std::actor::recover {}}

