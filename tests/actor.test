# actor.test -- std::actor: same-thread actors over std::event_loop, with
# explicitly restricted authority (SAME-THREAD-ACTORS-MILESTONE-1.md).
#
# The scenario programs are tests/actor/*.bot (an application root). Each is
# compiled once with -warnings error and run on this pass's backends, which
# must agree on its whole outcome (the loop's trace, "t=TURN: TEXT" lines);
# the claims are then checked on the trace. Also here: what the compiler
# must reject (the authority each actor lacks although the application has
# installed it, ownership, identity, opacity), and the library's own
# invariants read from its source.
#
# Backends, as tests/event-loop.test's: the outer pass's own (CORE_BACKEND
# interp or compile) plus cranelift in the interp pass and
# cranelift-generic in the compile pass; all four when run directly.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]

interp recursionlimit {} 100000

if {![info exists ::env(CORE_BACKEND)]} {
    set acBackends {interp compile cranelift-generic cranelift}
} elseif {$::env(CORE_BACKEND) eq "interp"} {
    set acBackends {interp cranelift}
} elseif {$::env(CORE_BACKEND) eq "compile"} {
    set acBackends {compile cranelift-generic}
} else {
    set acBackends [list $::env(CORE_BACKEND)]
}

set acDir [file join $::projectRoot tests actor]

# The strings of a Botlish List[str] as core::value::show prints it.
proc acStrings {shown} {
    set out {}
    foreach {- s} [regexp -all -inline {"((?:[^"\\]|\\.)*)"} $shown] {
        lappend out [subst -nocommands -novariables $s]
    }
    return $out
}

# Scenario NAME: compiled once (-warnings error), run on every backend of
# the pass. Returns {agree TRACE}: whether every backend gave one outcome,
# and the trace (empty on any failure).
proc acRun {name} {
    if {[info exists ::acRuns($name)]} {
        return $::acRuns($name)
    }
    set hir [surface::readProgramFile [file join $::acDir $name.bot] -warnings error]
    set outcomes [lsort -unique [lmap b $::acBackends {lrange [outcomeUnderHir $b $hir] 0 1}]]
    set agree [expr {[llength $outcomes] == 1 && [lindex $outcomes 0 0] eq "value"}]
    set trace [expr {$agree ? [acStrings [lindex $outcomes 0 1]] : {}}]
    if {!$agree} {
        puts stderr "$name: [string range $outcomes 0 3000]"
    }
    set ::acRuns($name) [list $agree $trace]
    return $::acRuns($name)
}

proc acTrace {name} {
    lindex [acRun $name] 1
}

# The lines of TRACE matching RE, without their "t=TURN: " prefix.
proc acLines {trace re} {
    set out {}
    foreach line $trace {
        if {[regexp -- $re $line]} {
            lappend out $line
        }
    }
    return $out
}

# The number NAME the trace's "main: NAME N" line states.
proc acStat {trace name} {
    foreach line $trace {
        if {[regexp "^t=\\d+: main: $name (-?\\d+)$" $line -> n]} {
            return $n
        }
    }
    return ""
}

# --------------------------------------------------------------------------
# Every scenario: one outcome on every backend.

foreach name {actors authority values lifecycle room shutdown coexist identity replay} {
    test actor-agree-$name "scenario $name compiles under -warnings error and gives one outcome on every backend of the pass (its trace)" -body {
        lindex [acRun $name] 0
    } -result 1
}

# --------------------------------------------------------------------------
# Probe A on std::actor (actors.bot)

test actor-probe-a-identity {a closed mailbox's address is Closed; once its slot is reused the old address is Stale and never reaches the replacement, which has nothing queued} -body {
    acLines [acTrace actors] {main: (send to|same slot|queued in)}
} -result {{t=0: main: send to a closed mailbox: Closed 0} {t=0: main: same slot reused: new generation 0} {t=0: main: send to the old address: Stale 0} {t=0: main: queued in the replacement 0}}

test actor-probe-a-request-reply {two clients share one counter; each gets only its own reply (correlation id checked); the counter's private state ends at 1009 after 8 messages; the Add sent after Stop is undelivered and counted} -body {
    set t [acTrace actors]
    list [acLines $t {reply for my request|WRONG}] [acLines $t {c1 done}] [acStat $t undelivered]
} -result {{{t=47: clientB: reply for my request, value 1009} {t=48: clientA: reply for my request, value 1009}} {{t=52: logger: c1 done total 1009 handled 8 #3}} 1}

test actor-probe-a-suspended-handler {a handler that suspends (a 500 us sleep) suspends only its actor: ping and pong exchange their 40 messages and the quiet actor is served while c1's slow add is pending} -body {
    set t [acTrace actors]
    list [acLines $t {slow add (begins|ends)}] [acLines $t {exchanged|quiet:}]
} -result {{{t=1: c1: slow add begins, total 0} {t=2: c2: slow add begins, total 0} {t=41: c1: slow add ends, total 1000} {t=42: c2: slow add ends, total 100}} {{t=4: quiet: handled its message in turn 4} {t=39: pong: exchanged 20} {t=40: ping: exchanged 20}}}

test actor-probe-a-fairness {the quiet actor's message, sent in turn 3 beside a continuous ping-pong, is handled in the next turn} -body {
    acLines [acTrace actors] {quiet(-sender)?:}
} -result {{t=3: quiet-sender: sends in turn 3} {t=4: quiet: handled its message in turn 4}}

test actor-probe-a-backpressure {a full mailbox answers Full and nothing is dropped; deliver waits for room and is woken when a place frees -- no polling: the only timers that fire are the two slow adds' (Probe A polled every 50 us)} -body {
    set t [acTrace actors]
    list [acLines $t {flooder}] [acLines $t {c2 done}] [acStat $t {timers fired}] [acStat $t {room waits}] [acStat $t {room wakes}]
} -result {{{t=1: flooder: Full at message 3} {t=3: flooder: waited for room, then Delivered at turn 3} {t=3: flooder: Full at message 4} {t=43: flooder: waited for room, then Delivered at turn 43} {t=43: flooder: Full at message 5} {t=44: flooder: waited for room, then Delivered at turn 44}} {{t=49: logger: c2 done total 115 handled 6 #1}} 2 8 8}

test actor-probe-a-accounting {every message is received or counted undelivered (64 delivered = 63 received + 1 undelivered); every actor ended Returned, with its value, under the task id start returned; shutdown abandons no actor (reap reaps none) and reap closes the one mailbox no actor listened to, whose channels the shutdown revoked: nothing is left open} -body {
    set t [acTrace actors]
    list [acStat $t delivered] [acStat $t received] [acStat $t undelivered] \
        [llength [acLines $t {outcome task \d+ Returned}]] [acLines $t {outcome task 1 }] [acStat $t {c1 is task}] \
        [acStat $t abandoned] [acStat $t reaped] [acStat $t {open mailboxes}] [acStat $t {running actors}]
} -result {64 63 1 10 {{t=53: outcome task 1 Returned 1009}} 1 0 0 0 0}

# --------------------------------------------------------------------------
# Restricted authority (authority.bot): the principal acceptance

test actor-authority-run {a privileged supervisor, a Storage-only archivist and a contextless calculator share one thread, VM, heap, event loop and installed contexts: the calculator answers its Square and Fib(20) itself and has its Upload transmitted by the supervisor through the request address it was delegated; the archivist stores; every actor ends and every mailbox closes} -body {
    acTrace authority
} -result {{t=0: main: started the supervisor, task 0} {t=1: supervisor: started the calculator, task 1} {t=1: supervisor: started the archivist, task 2} {t=5: supervisor: transmitted for calculation 3 at clock 101} {t=6: supervisor: result 1 by calculator = 49} {t=7: supervisor: result 4 by archivist = 1} {t=8: supervisor: result 2 by calculator = 6765} {t=9: supervisor: result 3 by supervisor = 1} {t=9: supervisor: closed the archivist's mailbox, undelivered 0} {t=10: main: task 0 ended with 1} {t=10: main: task 1 ended with 3} {t=10: main: task 2 ended with 1} {t=10: main: the network carried 42} {t=10: main: storage holds 5} {t=10: main: actors started 3} {t=10: main: actors ended 3} {t=10: main: actors running 0} {t=10: main: open mailboxes 0}}

# The context requirements the compiler's own analysis computes
# (hir::contexts::required, which MISSING-CONTEXT and CONTEXT-NOT-INJECTED
# read) for the named functions of authority.bot.
proc acRequirements {functions} {
    set hir [surface::readProgramFile [file join $::acDir authority.bot] -warnings off]
    hir::activate $hir
    set out {}
    foreach b [dict get $hir contexts blocks] {
        set fn [hir::contexts::BlockName $hir $b]
        if {$fn in $functions && ![dict exists $out $fn]} {
            dict set out $fn [lsort [hir::contexts::required $hir $b]]
        }
    }
    return [lsort -stride 2 $out]
}

test actor-authority-requirements {the compiler's context analysis: the calculator requires no context at all -- receiving, replying and asking for a privileged operation included -- the archivist only Storage, and the actor operations themselves none; the supervisor everything it uses} -body {
    acRequirements {calculator archivist supervisor std::actor::listen std::actor::receive std::actor::try_receive std::actor::send std::actor::deliver std::actor::pause std::actor::exit std::actor::spawned}
} -result {archivist Storage calculator {} std::actor::deliver {} std::actor::exit {} std::actor::listen {} std::actor::pause {} std::actor::receive {} std::actor::send {} std::actor::spawned {} std::actor::try_receive {} supervisor {Clock Network Storage std::actor::Actors std::event_loop::Loop}}

# authority.bot with FROM replaced by TO (each exactly once): the
# diagnostics' {kind SOURCE-LINE} pairs (the diagnosed line's text), or
# "ok".
proc acVariant {pairs} {
    set text [core::ReadFile [file join $::acDir authority.bot]]
    foreach {from to} $pairs {
        if {[string first $from $text] < 0} {
            return "NO SUCH TEXT: $from"
        }
        set text [string map [list $from $to] $text]
    }
    set dir [makeDirectory ac-variant]
    set path [file join $dir authority.bot]
    set f [open $path w]
    puts -nonewline $f $text
    close $f
    if {[catch {surface::readProgramFile $path -warnings off} message options]} {
        if {[dict exists $options -diagnostics]} {
            set lines [split $text \n]
            return [lsort -unique [lmap d [dict get $options -diagnostics] {
                set line [dict getdef [dict getdef $d location {}] line 0]
                list [lindex [dict get $d errorcode] end] [string trim [lindex $lines [expr {$line - 1}]]]
            }]]
        }
        return [lindex [dict get $options -errorcode] end]
    }
    return ok
}

set acCalcProbe "fn calc_probe() -> int errors IndexNotFound, std::event_loop::SchedulerFault:\n    0"
set acStorageProbe "fn storage_probe() -> int errors IndexNotFound, std::event_loop::SchedulerFault:\n    0"

# Each forbidden operation, put in the calculator's probe: the calculation
# actor is constructed inside `inject no context:` in a supervisor that has
# every context, and every context is installed.
foreach {name body} {
    network        {transmit(1)}
    storage        {store(1)}
    clock          {read_clock()}
    loop-time      {std::event_loop::now()}
    loop-register  {std::event_loop::channel(std::event_loop::Delivery::Reliable, 1).revoke()\n    0}
    loop-revoke    {std::event_loop::revoke(std::event_loop::after(5))\n    0}
    loop-admin     {std::event_loop::stop()\n    0}
    loop-outcomes  {std::event_loop::take_outcomes()\n    0}
    loop-log       {std::event_loop::log("x")\n    0}
    actor-sleep    {std::actor::sleep(1)\n    0}
    actor-admin    {std::actor::stats().started}
    actor-open     {std::actor::open[Result](1)\n    0}
} {
    test actor-authority-calc-$name "the contextless calculation actor cannot $name, although the application installed every context: CONTEXT-NOT-INJECTED at its construction inside the inject block" -body {
        acVariant [list $::acCalcProbe "fn calc_probe() -> int errors IndexNotFound, std::event_loop::SchedulerFault:\n    [subst -nocommands -novariables $body]"]
    } -cleanup {
        removeDirectory ac-variant
    } -result {{CONTEXT-NOT-INJECTED {coroutine {step, first} = calculator(calc_in)}}}
}

foreach {name body} {
    network {transmit(1)}
    clock   {read_clock()}
    loop    {std::event_loop::now()}
    actors  {std::actor::stats().started}
} {
    test actor-authority-storage-$name "the Storage-only actor cannot reach $name: CONTEXT-NOT-INJECTED at its construction inside `inject context Storage:`" -body {
        acVariant [list $::acStorageProbe "fn storage_probe() -> int errors IndexNotFound, std::event_loop::SchedulerFault:\n    [subst -nocommands -novariables $body]"]
    } -cleanup {
        removeDirectory ac-variant
    } -result {{CONTEXT-NOT-INJECTED {coroutine {step, first} = archivist(arch_in)}}}
}

test actor-authority-storage-own {the Storage-only actor's own Storage use is accepted (the unchanged program compiles)} -body {
    acVariant {}
} -cleanup {
    removeDirectory ac-variant
} -result ok

test actor-authority-creator-parameter {code in the calculator's inject block cannot read the supervisor's context parameter: the creator's authority is not the block's} -body {
    acVariant {{        marker = 0} {        marker = net.sent.length()}}
} -cleanup {
    removeDirectory ac-variant
} -result {{CONTEXT-NOT-INJECTED {marker = net.sent.length()}}}

test actor-authority-laundering {a privileged coroutine (it transmits) constructed by the supervisor and handed to an actor constructed inside `inject no context:` cannot be resumed by it: CONTEXT-RETAINED-AUTHORITY} -body {
    acVariant {{        coroutine {step, first} = calculator(calc_in)} {        coroutine {step, first} = courier(calc_in, up)}
               {    c = inject no context:} "    coroutine {step: up} = uploader(3)\n    c = inject no context:"}
} -cleanup {
    removeDirectory ac-variant
} -result {{CONTEXT-RETAINED-AUTHORITY {coroutine {step, first} = courier(calc_in, up)}}}

