# native-tcl-unicode.test -- core/tclcompat.tcl's std::str::is_tcl_alpha/std::str::is_tcl_alnum
# (the temporary Tcl-compatibility Unicode character-class primitives) and
# std::web::emailish? (stdlib/web.bot), the ordinary Botlish predicate that uses them
# to express the e-mail grammar. See NATIVE-TCL-UNICODE.md for the primitives
# and this milestone's own corpus.
#
# Direct primitive coverage (spec: "prove the new primitives independently
# of Emailish?") comes first, exercising the exact edge-case corpus
# NATIVE-TCL-UNICODE.md characterizes against Tcl 9.0.1 itself: a letter in
# several General_Category subcategories (Lu/Ll/Lm/Lo), a Unicode decimal
# digit (Nd) outside ASCII, two "looks numeric but is not Nd" categories
# (No, Nl) that must distinguish Tcl's alnum from Python's/Rust's broader
# numeric predicates, a combining mark (Mn), and ordinary punctuation --
# each labeled with why it is in the corpus, not just what it is.
#
# std::web::emailish? parity then reuses the same 16-string corpus this
# milestone's report cross-checks against the Python and Rust benchmark
# equivalents (bench/equivalents/{python,rust}/refined_checks.py|rs) and
# against the reference regular expression the grammar was first written as
# (emailRegex below, formerly stdlib/web.tcl's validator, which interp and
# compile used to run instead of the Botlish predicate): every backend now
# runs the one Botlish predicate, so the regex is checked here directly, and
# a predicate defect that agrees with itself on all four backends but
# disagrees with the grammar is still caught.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]

set parityBackends {interp compile cranelift-generic cranelift}

# The reference grammar (core/regex.tcl): local part of letters, digits and
# a few symbols, then "@", one or more labels each followed by ".", and a
# top-level domain of at least two letters.
set emailRegex [core::regex::create {
    seq
    {repeat {set {class alnum} {char .} {char _} {char %} {char +} {char -}} 1 inf}
    {lit @}
    {repeat {seq {repeat {set {class alnum} {char -}} 1 inf} {lit .}} 1 inf}
    {repeat {class alpha} 2 inf}
}]

proc classifyProgram {native c} {
    return [list [list call [list ref $native] [list const str $c]]]
}

# std::web::emailish?(S) as a Botlish program.
proc emailishSource {s} {
    return "import std::web\nstd::web::emailish?(\"[string map {\\ \\\\ \" \\\"} $s]\")\n"
}

# The value std::web::emailish?(S) has on every backend (a Tcl error if they
# disagree), and whether it agrees with the reference regex.
proc emailish {s} {
    set outcome [sourceAgree [emailishSource $s]]
    if {[lindex $outcome 0] ne "value"} {
        error "std::web::emailish? raised: $outcome"
    }
    set regex [expr {[core::regex::matches $::emailRegex [core::value::str $s]] ? "true" : "false"}]
    if {[lindex $outcome 1] ne $regex} {
        error "std::web::emailish? says [lindex $outcome 1], the reference regex says $regex"
    }
    return [lindex $outcome 1]
}

proc errorCodeOfUnder {backend exprs} {
    set saved [core::useBackend]
    core::useBackend $backend
    try {
        if {[catch {core::evalProgram $exprs} message options]} {
            return [dict get $options -errorcode]
        }
        return "no error; value [core::formatValue $message]"
    } finally {
        core::useBackend $saved
    }
}

proc fourWay {exprs} {
    set shown [lmap b $::parityBackends {lindex [outcomeUnder $b $exprs] 1}]
    if {[llength [lsort -unique $shown]] != 1} {
        error "mismatch across $::parityBackends: $shown"
    }
    return [lindex $shown 0]
}

# ---------------------------------------------------------------------------
# std::str::is_tcl_alpha / std::str::is_tcl_alnum: direct, four-way parity, edge-case corpus.
#
# label                          char        General_Category   alpha alnum
set classCorpus {
    ascii-letter                    A           true  true
    ascii-digit                     9           false true
    latin-e-acute-Ll                é      true  true
    cjk-ri-Lo                       日      true  true
    titlecase-Dz-Lt                 ǅ      true  true
    modifier-letter-Lm              ʰ      true  true
    arabic-indic-digit-Nd           ٠      false true
    vulgar-fraction-3-4-No          ¾      false false
    circled-digit-one-No            ①      false false
    roman-numeral-one-Nl            Ⅰ      false false
    combining-acute-accent-Mn       ́      false false
    underscore-Pc                   _           false false
    full-stop-Po                    .           false false
    deseret-long-i-astral-Lu        𐐀      true  true
    math-bold-digit-zero-astral-Nd  𝟎      false true
    grinning-face-astral-So         😀      false false
}
foreach {label char alpha alnum} $classCorpus {
    test native-tcl-unicode-alpha-$label "std::str::is_tcl_alpha($label) agrees across interp/compile/cranelift-generic/cranelift" -body {
        fourWay [classifyProgram std::str::is_tcl_alpha $char]
    } -result $alpha
    test native-tcl-unicode-alnum-$label "std::str::is_tcl_alnum($label) agrees across interp/compile/cranelift-generic/cranelift" -body {
        fourWay [classifyProgram std::str::is_tcl_alnum $char]
    } -result $alnum
}

# ---------------------------------------------------------------------------
# Contract: exactly one Unicode scalar, or RANGE -- the empty string and a
# multi-scalar string are both out of domain, on every backend, with the
# same error text (spec: "reject malformed primitive inputs consistently").

foreach native {std::str::is_tcl_alpha std::str::is_tcl_alnum} {
    test native-tcl-unicode-$native-range-empty "${native}('') is a RANGE error on every backend, with the same message" -body {
        set msgs [lmap b $::parityBackends {lindex [outcomeUnder $b [classifyProgram $native {}]] 2}]
        if {[llength [lsort -unique $msgs]] != 1} {
            error "message mismatch across $::parityBackends: $msgs"
        }
        list [lindex [outcomeUnder interp [classifyProgram $native {}]] 0] [lindex $msgs 0]
    } -result [list error "$native: expects a single Unicode scalar, got a string of length 0"]

    test native-tcl-unicode-$native-range-multi "${native}('ab') is a RANGE error on every backend" -body {
        lmap b $::parityBackends {lindex [outcomeUnder $b [classifyProgram $native ab]] 0}
    } -result [lrepeat 4 error]
}

# ---------------------------------------------------------------------------
# Native metadata: pure, nonallocating primitives -- no allocation-related
# -runtime tag (string-alloc, list-alloc, result-alloc, mutarray-alloc,
# mutarray-mutate), consistent with native/src/runtime/ops.rs's
# tcl_alpha_char/tcl_alnum_char never allocating and being excluded from
# op_may_allocate (spec: "should not have allocation/safepoint metadata
# they do not need").

foreach native {std::str::is_tcl_alpha std::str::is_tcl_alnum} {
    test native-tcl-unicode-$native-metadata-nonallocating "$native declares no allocation -runtime tag" -body {
        set tags [dict get [core::native::metadata $native] runtime]
        lsearch -inline $tags {string-alloc list-alloc result-alloc mutarray-alloc mutarray-mutate}
    } -result {}
}

# ---------------------------------------------------------------------------
# std::char::is_tcl_alpha / std::char::is_tcl_alnum (UNICODECHAR-CLASSIFIERS.md):
# the same classes of a UnicodeChar, total and allocation-free. The corpus
# above, each character a Core IR UnicodeChar constant (not folded: the NIR
# keeps the native op), four-way: the same answer as the str form's.

proc classifyCharProgram {native c} {
    scan $c %c cp
    return [list [list call [list ref $native] [list const UnicodeChar $cp]]]
}

foreach {label char alpha alnum} $classCorpus {
    test native-tcl-unicode-char-alpha-$label "std::char::is_tcl_alpha($label) agrees across interp/compile/cranelift-generic/cranelift" -body {
        fourWay [classifyCharProgram std::char::is_tcl_alpha $char]
    } -result $alpha
    test native-tcl-unicode-char-alnum-$label "std::char::is_tcl_alnum($label) agrees across interp/compile/cranelift-generic/cranelift" -body {
        fourWay [classifyCharProgram std::char::is_tcl_alnum $char]
    } -result $alnum
}

# The corpus's characters read from a String at run time
# (std::str::char_at): on the native backends a non-ASCII character goes to
# the runtime helper, the ASCII ones (A, 9, _, .) are classified inline.
set classText [join [lmap {label char alpha alnum} $classCorpus {set char}] ""]
test native-tcl-unicode-char-corpus-read-at-run-time {the corpus as one String, each character read with std::str::char_at and classified, on interp/compile/cranelift-generic/cranelift} -body {
    sourceAgree "import std::char\nimport std::str\n\ntext = \"$classText\"\nalpha = loop i from 0 to std::str::length(text):\n    std::char::is_tcl_alpha(text.char_at(i))\nalnum = loop i from 0 to std::str::length(text):\n    std::char::is_tcl_alnum(text.char_at(i))\n\[alpha, alnum\]\n"
} -result [list value "\[\[[join [lmap {l c a n} $classCorpus {set a}] {, }]\], \[[join [lmap {l c a n} $classCorpus {set n}] {, }]\]\]"]

# Every ASCII scalar, the control characters included (built at run time
# from its bytes: no source escape writes them), against Tcl's own classes:
# the native backends' inline ASCII rule (codegen::clif's CharIsTclAlpha)
# on every one of them.
set asciiAlpha {}
set asciiAlnum {}
for {set cp 0} {$cp < 128} {incr cp} {
    if {[string is alpha -strict [format %c $cp]]} { lappend asciiAlpha $cp }
    if {[string is alnum -strict [format %c $cp]]} { lappend asciiAlnum $cp }
}
test native-tcl-unicode-char-every-ascii-scalar {every ASCII scalar's std::char::is_tcl_alpha and is_tcl_alnum agree with Tcl's [:alpha:] and [:alnum:] on interp/compile/cranelift-generic/cranelift} -body {
    sourceAgree {import std::abi::bytes
import std::byte
import std::char
import std::str

fn ascii() -> str errors InvalidUtf8:
    codes = loop b from 0 to 128:
        std::byte::from_int(b)
    std::abi::bytes::decode_utf8(std::abi::bytes::from_list(codes))

text = ascii():
    on InvalidUtf8:
        ""
alpha = loop i from 0 to std::str::length(text):
    c = text.char_at(i)
    if not std::char::is_tcl_alpha(c):
        continue
    std::char::scalar_value(c)
alnum = loop i from 0 to std::str::length(text):
    c = text.char_at(i)
    if not std::char::is_tcl_alnum(c):
        continue
    std::char::scalar_value(c)
[std::str::length(text), alpha, alnum]
}
} -result [list value "\[128, \[[join $asciiAlpha {, }]\], \[[join $asciiAlnum {, }]\]\]"]

# Every scalar: the char forms decide exactly the str forms' class (the
# implementation interp and compile run; native/src/runtime/ops.rs's
# helpers are checked the same way by its Rust test
# char_classifiers_agree_with_string_classifiers_on_every_scalar, and its
# inline ASCII rule by inline_ascii_rule_is_the_general_category_rule).
test native-tcl-unicode-char-forms-agree-every-scalar {core/tclcompat.tcl's std::char forms agree with its std::str forms on every Unicode scalar} -body {
    set bad {}
    for {set cp 0} {$cp <= 0x10FFFF} {incr cp} {
        if {$cp == 0xD800} { set cp [expr {0xE000}] }
        set c [core::value::char $cp]
        set s [core::value::str [format %c $cp]]
        if {[core::tclcompat::charIsTclAlpha $c] ne [core::tclcompat::isTclAlpha $s]
                || [core::tclcompat::charIsTclAlnum $c] ne [core::tclcompat::isTclAlnum $s]} {
            lappend bad [format U+%04X $cp]
            if {[llength $bad] >= 10} break
        }
    }
    set bad
} -result {}

# Contract: a UnicodeChar parameter. A String is the TYPE error, at run
# time for a direct call of the native (like every native's parameter:
# core/native.tcl), statically for an untyped parameter that forwards it
# (INTRINSIC-FUNCTION-CONTRACT-INFERENCE.md).
foreach native {std::char::is_tcl_alpha std::char::is_tcl_alnum} {
    test native-tcl-unicode-$native-rejects-string "${native}(\"a\") is the TYPE error on every backend, with the same message" -body {
        set program [list [list call [list ref $native] [list const str a]]]
        set outcomes [lmap b $::parityBackends {lrange [outcomeUnder $b $program] 0 2}]
        if {[llength [lsort -unique $outcomes]] != 1} {
            error "outcome mismatch across $::parityBackends: $outcomes"
        }
        lindex $outcomes 0
    } -result [list error {CORE SEMANTIC TYPE} "$native: expected UnicodeChar, got \"a\""]

    test native-tcl-unicode-$native-forwarded-string-static "a String forwarded to $native through an untyped parameter is rejected statically" -body {
        catch {surface::compile "import std::char\n\nfn f(c):\n    ${native}(c)\n\nf(\"a\")\n" -warnings off} message options
        list [dict get $options -errorcode] [regexp {statically incompatible with UnicodeChar} $message]
    } -result {{CORE SEMANTIC TYPE} 1}
}

# Native metadata: total, pure and allocation-free -- no -runtime tag at all
# (no string indexing, no RANGE check, no allocation), a UnicodeChar
# parameter, a bool result, context-free (a function calling it can be
# repeatable: emailish?'s decided re-check).
foreach native {std::char::is_tcl_alpha std::char::is_tcl_alnum} {
    test native-tcl-unicode-$native-metadata "$native: UnicodeChar -> bool, context-free, no -runtime tag" -body {
        set m [core::native::metadata $native]
        list [dict get $m paramTypes] [dict get $m resultType] [dict get $m runtime] [dict get $m contextFree]
    } -result {UnicodeChar bool {} 1}
}

# Method syntax: with both std::char and std::str imported, the receiver's
# type chooses between the two forms; an untyped receiver accepts both, so
# its method-style call is AMBIGUOUS-METHOD-CALL (METHOD-SUGAR.md: no
# precedence), as xs.length() is with std::list and std::str.
test native-tcl-unicode-char-method-typed-receivers {c.is_tcl_alnum() and t.is_tcl_alnum() resolve by the receiver's type with both std::char and std::str imported} -body {
    sourceAgree "import std::char\nimport std::str\n\nfn of_text(t: str) -> bool:\n    t.is_tcl_alnum()\n\nfn of_char(c: UnicodeChar) -> bool:\n    c.is_tcl_alnum()\n\n\[of_text(\"é\"), of_char('é'), of_char('-')\]\n"
} -result {value {[true, true, false]}}

test native-tcl-unicode-char-method-untyped-receiver-ambiguous {x.is_tcl_alpha() with an untyped x and both std::char and std::str imported is AMBIGUOUS-METHOD-CALL naming both} -body {
    catch {surface::compile "import std::char\nimport std::str\n\nfn f(x):\n    x.is_tcl_alpha()\n\nf(\"x\")\n" -warnings off} message options
    list [dict get $options -errorcode] [regexp {std::char::is_tcl_alpha, std::str::is_tcl_alpha} $message]
} -result {{CORE SEMANTIC AMBIGUOUS-METHOD-CALL} 1}

# The native lowering: one op per call, no allocation. std::web::emailish?
# classifies UnicodeChars since UNICODECHAR-CLASSIFIERS.md: on the Unicode
# address its run makes no String at all (it made one per character read
# before), and its NIR has no substring left.
test native-tcl-unicode-char-nir-ops {std::char::is_tcl_alpha/alnum lower to one chartclalpha/chartclalnum op each} -body {
    set text [native::nir [surface::compile "import std::char\n\nfn f(c: UnicodeChar) -> List\[bool\]:\n    \[std::char::is_tcl_alpha(c), std::char::is_tcl_alnum(c)\]\n\nf('é')\n" -warnings off]]
    list [regexp -all {op chartclalpha } $text] [regexp -all {op chartclalnum } $text]
} -result {1 1}

test native-tcl-unicode-emailish-makes-no-string {std::web::emailish? on a Unicode address allocates no String natively, and its NIR slices nothing} -body {
    set hir [surface::compile [emailishSource {café@例え.テスト}] -warnings off]
    set report [native::allocationReport $hir summary 1]
    set strings [expr {[dict exists $report byKind String] ? [dict get $report byKind String allocations] : 0}]
    set text [native::nir $hir]
    list $strings [regexp -all {op substr} $text] [expr {[regexp -all {op chartclal(?:pha|num) } $text] > 0}]
} -result {0 0 1}

# ---------------------------------------------------------------------------
# std::web::emailish?: four-way parity and the reference regex, the corpus
# NATIVE-TCL-UNICODE.md's report cross-checks against Python/Rust too. Each
# case documents which grammar position it forces Unicode classification
# in, or which negative case it pins.

foreach {label s expect} {
    ascii-valid                       someone@example.com              true
    ascii-invalid                     not-an-email                     false
    short-tld-ok                      a@b.co                           true
    tld-too-short                     a@b.c                            false
    local-part-symbols                a.b_c%d+e-f@sub.example.com      true
    digit-in-local-part               user7@example.com                true
    hyphen-in-domain-label            a@my-host.example.com            true
    missing-local-part                @example.com                     false
    missing-domain                    a@                               false
    empty-first-label                 a@.com                           false
    empty-middle-label                a@b..com                         false
    trailing-dot                      a@b.com.                         false
    tld-with-digit                    a@b.c1                           false
    unicode-alpha-local-part          café@example.com                 true
    unicode-domain-label-and-tld      user@例え.テスト                  true
    unicode-alpha-in-tld              user@example.co日                true
    mixed-case-ascii-tld              a@b.cD                           true
    empty-string                      {}                                false
} {
    test native-tcl-unicode-emailish-$label "std::web::emailish?($label) agrees across interp/compile/cranelift-generic/cranelift and with the reference regex" -body {
        emailish $s
    } -result $expect
}

# A domain label containing a Unicode decimal digit (Nd) is valid alnum
# (matches the "Unicode decimal digit in a position where alnum is
# accepted" corpus requirement); the same position with a numeric-but-not-Nd
# character (a Roman numeral, general category Nl) must be rejected --
# distinguishing Tcl's alnum from Python's/Rust's broader is_alnum()/
# is_alphabetic() the way NATIVE-TCL-UNICODE.md's report requires.
test native-tcl-unicode-emailish-unicode-digit-in-label "std::web::emailish?(a Unicode Nd digit in a domain label) is accepted" -body {
    emailish "a@b٠.com"
} -result true

test native-tcl-unicode-emailish-numeric-non-Nd-rejected "std::web::emailish?(a numeric-but-not-Nd character where the TLD must be 2+ alpha) is rejected" -body {
    emailish "a@例え.Ⅰ"
} -result false

# ---------------------------------------------------------------------------
# GC stress: the validator's own String traversal (length and char_at
# calls) and the classification primitives themselves must survive a
# collection forced before every allocation.

test native-tcl-unicode-emailish-gc-stress {std::web::emailish? survives a collection forced before every allocation} -body {
    set ::env(BOTLISH_NATIVE_GC_STRESS) 1
    try {
        lindex [outcomeUnderHir cranelift [surface::compile [emailishSource {café@例え.テスト}] -warnings off]] 1
    } finally {
        unset ::env(BOTLISH_NATIVE_GC_STRESS)
    }
} -result true

# ---------------------------------------------------------------------------
# One shared, compiled validator: an outer `if std::web::emailish?(s)` whose
# then-branch re-checks `std::web::emailish?(s)` compiles to exactly one copy of
# the validator and one call to it -- the redundant re-check is decided by
# the outer call's exact result (REFINEMENT-VALUES.md), needing no call. See
# tests/emailish-predicate.test for the focused refinement regressions.
test native-tcl-unicode-emailish-known-result-nir-shape {a redundant std::web::emailish? check inside its own true branch compiles to exactly one call to the shared validator, not two independent copies} -body {
    set source {import std::web

fn f(s: str) -> str:
    if std::web::emailish?(s):
        if std::web::emailish?(s):
            "yes"
        else:
            "no"
    else:
        "no"

f("someone@example.com")
}
    set hir [surface::compile $source -warnings off]
    set text [native::nir $hir]
    # Exactly one compiled copy of the validator and its scanner helpers
    # (never two, one per call site).
    set isEmailishDefs [regexp -all {func \d+ "std::web::emailish\?"} $text]
    set domainLoopDefs [regexp -all {func \d+ "domain\?"} $text]
    regexp {func (\d+) "std::web::emailish\?"} $text -> isEmailishId
    set calls [regexp -all "= call(?:env)? $isEmailishId %" $text]
    list $isEmailishDefs $domainLoopDefs $calls [sourceAgree $source]
} -result {1 1 1 {value {"yes"}}}

# ---------------------------------------------------------------------------
# lowercase: the Unicode 16 simple (one-to-one, UnicodeData.txt) lowercase
# mapping on every backend (README.md, "Strings"). Pinned cases first, each
# labeled with why it is in the corpus; the full mapping (SpecialCasing.txt)
# and Unicode 17 are deliberately out of scope.

foreach {label s expect} {
    ascii-and-latin      ABCÄ      abcä
    capital-sharp-s      ẞ         ß
    sigma-never-final    ΟΣ   οσ
    dotted-capital-I     İ         i
    dotted-I-in-context  AİB       aib
    a-with-stroke        Ⱥ         ⱥ
    t-with-diag-stroke   Ⱦ         ⱦ
    kelvin-sign          K         k
    already-lowercase    éⱥ   éⱥ
    astral-deseret       \U00010400     \U00010428
    astral-no-mapping    \U0001f600     \U0001f600
    unicode17-A7CE       ꟎         ꟎
    unicode17-A7D2       ꟒         ꟒
    unicode17-A7D4       ꟔         ꟔
    unicode17-beria-erfe \U00016ea0     \U00016ea0
} {
    test native-tcl-unicode-lowercase-$label "std::str::lowercase($label) is the Unicode 16 simple mapping on interp/compile/cranelift-generic/cranelift" -body {
        fourWay [list [list call {ref std::str::lowercase} [list const str $s]]]
    } -result \"$expect\"
}

# Every scalar, one plane per program: each backend's lowercase of the plane
# must equal the reference core::strings::lowercase (Tcl's `string tolower`
# plus its two U+023A/U+023E patches). The mapping is one-to-one, so this is
# a scalar-by-scalar comparison, and it is what pins native's Rust tables to
# Unicode 16: a Tcl or Rust upgrade that changes a mapping fails here and
# names the backend and plane.
test native-tcl-unicode-lowercase-all-scalars "every scalar's lowercase agrees with the reference on interp/compile/cranelift-generic/cranelift" -body {
    set bad {}
    for {set plane 0} {$plane <= 16} {incr plane} {
        set text {}
        for {set cp [expr {$plane << 16}]} {$cp <= ($plane << 16) + 0xFFFF} {incr cp} {
            if {$cp >= 0xD800 && $cp <= 0xDFFF} continue
            append text [format %c $cp]
        }
        set expected [core::value::strOf [core::strings::lowercase [core::value::str $text]]]
        set prog [list [list call {ref ==} \
            [list call {ref std::str::lowercase} [list const str $text]] \
            [list const str $expected]]]
        foreach b $::parityBackends {
            set outcome [outcomeUnder $b $prog]
            if {[lindex $outcome 0] ne "value" || [lindex $outcome 1] ne "true"} {
                lappend bad $b:plane$plane
            }
        }
    }
    set bad
} -result {}

::tcltest::cleanupTests
