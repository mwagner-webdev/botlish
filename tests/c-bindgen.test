    set rows [::cbind::generate::readTsv [dict get $result files report.tsv]]
    list [lrange [dict get $rows "function bgf_printf"] 2 5] [lrange [dict get $rows "function bgf_vother"] 2 4] \
        [regexp {extern c fn bgf_printf} [dict get $result files bgf/bgf.bot]] \
