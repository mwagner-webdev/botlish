        set hir [stagedHir $dir main.bot $target error]
        set units [dict get $hir direct units]
        list $target {*}[lmap unit {bgf::bgf bgf::thunks::bgf bgf::types bgf::ctypes bgf::records bgf::layouts} {dict get $units $unit status}]
    }
} -cleanup removeScratch -result {{linux-x86_64 ordinary ordinary ordinary ordinary ordinary ordinary} {linux-aarch64 ordinary ordinary ordinary ordinary ordinary ordinary} {macos-aarch64 ordinary ordinary ordinary ordinary ordinary ordinary} {windows-x86_64-gnu ordinary ordinary ordinary ordinary ordinary ordinary}}

test cb-fixture-run {the generated binding links and runs: demo.bot (a Botlish caller) and caller.c (a C caller of the header's own API) compute the same values -- direct calls, aliases, link names, a stub-table thunk, inline and macro thunks, a declared function its macro shadows, typed constants, C _Bool, opaque handles, byte borrowing and write-back -- on both native backends} -constraints {nativeRun fixtureHostBinding} -body {
    set dir [staged $::fixture $::hostTarget [file join $::fixtureDir demo demo.bot]]
    set shim [shimOf $::fixture $::hostTarget [file join $dir .shim]]
    set values [stagedValues $dir demo.bot {cranelift cranelift-generic} [list [bgfLib] $shim]]
    set c [cCaller $::fixture [file join $::fixtureDir demo caller.c] [list [file join [bgfLib] libbgf.a]]]
    list [expr {[lindex $values 0] eq $c}] [expr {[lindex $values 1] eq $c}] $c
} -cleanup removeScratch -result [list 1 1 $::demoValues]

test cb-fixture-only-reached-externs {a program's foreign table holds only the C functions it calls, and its link plan each library once, however many modules declare it: importing a generated module adds its libraries, never its unreached symbols} -constraints {nativeRun fixtureHostBinding} -body {
    set dir [staged $::fixture $::hostTarget [file join $::fixtureDir demo demo.bot]]
    writeText [file join $dir one.bot] "import bgf::bgf\nimport bgf::thunks::bgf\n\nbgf::bgf::bgf_count()\n"
    set nir [native::nir [stagedHir $dir one.bot]]
    lsearch -all -inline -regexp [split $nir \n] {^(foreign|link) }
} -cleanup removeScratch -match glob -result {{link "bgf"} {link "botlish_shim_bgf_*"} {foreign 0 "bgf_count" params="" result=i32 name="bgf::bgf::bgf_count"}}

test cb-fixture-no-c-at-compile-time {compiling a program over a generated binding needs no header, no preprocessor and no C compiler: a child process with no compiler on its PATH and no header sources compiles it, with every foreign declaration of the host target's binding (bgf_arm_only is declared on AArch64 only)} -constraints {clang fixtureHostBinding} -body {
    set dir [scratch]
    ::cbind::generate::stage $::fixture $::hostTarget [file join $::fixtureDir demo demo.bot] $dir [generatedDir $::fixture $::hostTarget]
    set script [file join $dir compile.tcl]
    writeText $script "source [list [file join $::projectRoot surface surface.tcl]]\nset hir \[surface::readProgramFile [list [file join $dir demo.bot]] -warnings error -cache {}\]\nputs \[llength \[dict keys \[hir::foreign::declarations \$hir\]\]\]\n"
    set savedEnv [array get ::env]
    try {
        set ::env(PATH) [file join $dir no-such-bin]
        set ::env(BOTLISH_C_HEADER_SOURCES) [file join $dir no-such-sources]
        catch {unset ::env(BOTLISH_C_CC)}
        exec [info nameofexecutable] $script
    } finally {
        array unset ::env
        array set ::env $savedEnv
    }
} -cleanup removeScratch -result [dict getdef {linux-x86_64 43 linux-aarch64 44 macos-aarch64 44} $::hostTarget {}]

test cb-fixture-interchange {a program over a generated binding written as HIR interchange and run in a fresh process, with no header, generator input or binding module left, behaves identically} -constraints {nativeRun fixtureHostBinding} -body {
    set dir [staged $::fixture $::hostTarget [file join $::fixtureDir demo demo.bot]]
    set shim [shimOf $::fixture $::hostTarget [file join [scratch] shim]]
    exec [info nameofexecutable] [file join $::projectRoot main.tcl] -emit-hir-interchange [file join $dir demo.bot] 2>@1
    set hirx [file join [scratch] demo.hirx]
    file rename [file join $dir demo.hirx] $hirx
    file delete -force $dir
    set out [exec [info nameofexecutable] [file join $::projectRoot main.tcl] -backend cranelift -L [bgfLib] -L $shim $hirx 2>@1]
    lindex [split [string trim $out] \n] end
} -cleanup removeScratch -result "   value: $::demoValues"

test cb-fixture-isolation {two generated bindings with the same Botlish declaration names but other link symbols, compiled one after the other: each HIR keeps its own foreign declarations (the registry is compilation-local)} -constraints {clang fixtureHostBinding} -body {
    set a [scratch]
    ::cbind::generate::stage $::fixture $::hostTarget "" $a [generatedDir $::fixture $::hostTarget]
    writeText [file join $a main.bot] "import bgf::bgf\n\n1.bgf_add(2)\n"
    set b [scratch]
    ::cbind::generate::stage $::fixture $::hostTarget "" $b [generatedDir $::fixture $::hostTarget]
    set path [file join $b bgf bgf.bot]
    set text [::chdr::readFile $path]
    writeText $path [string map {"extern c fn bgf_add(" "extern c fn bgf_add named \"other_add\"("} $text]
    writeText [file join $b main.bot] "import bgf::bgf\n\n1.bgf_add(2)\n"
    set hirA [stagedHir $a main.bot]
    set hirB [stagedHir $b main.bot]
    hir::activate $hirA
    set nirA [native::nir $hirA]
    list [dict get [hir::foreign::declarations $hirA] bgf::bgf::bgf_add symbol] \
        [dict get [hir::foreign::declarations $hirB] bgf::bgf::bgf_add symbol] \
        [lindex [regexp -inline {foreign 0 "[^"]*"} $nirA] 0]
} -cleanup removeScratch -result {bgf_add other_add {foreign 0 "bgf_add"}}

test cb-fixture-static-compile {a static compile: block over a generated extern is decided like any block: a wrong arity is std::compiler::DiagnosticCode::Arity, an argument out of its C type's range Type, an accepted block the ordinary call (NATIVE-ONLY on the Tcl backends)} -constraints {clang fixtureHostBinding} -body {
    lmap {body code} {
        "bgf::bgf::bgf_add(1)" Arity
        "bgf::bgf::bgf_add(x, 2)" Type
        "bgf::bgf::bgf_add(1, 2)" Arity
    } {
        set dir [scratch]
        ::cbind::generate::stage $::fixture $::hostTarget "" $dir [generatedDir $::fixture $::hostTarget]
        writeText [file join $dir main.bot] "import std::compiler\nimport bgf::bgf\n\nfn probe(x: int) -> int errors std::compiler::CompilerError:\n    static compile:\n        $body\n        0\n\nr = probe(5):\n    on std::compiler::CompilerError {code}:\n        if code == std::compiler::DiagnosticCode::$code:\n            1\n        else:\n            2\nr\n"
        lassign [outcomeUnderHir interp [stagedHir $dir main.bot "" off]] tag value
        expr {$tag eq "value" ? $value : [lindex $value end]}
    }
} -cleanup removeScratch -result {1 1 NATIVE-ONLY}

test cb-fixture-why {`report -why NAME` names why a declaration was or was not generated: every blocker of an unsupported one, the module and signature of a generated one} -constraints clang -match glob -body {
    set out {}
    foreach name {bgf_long_scale bgf_add BGF_HALF no_such_name} {
        lappend out [exec [info nameofexecutable] [file join $::projectRoot tools c-bindgen.tcl] report fixture -target linux-x86_64 -why $name]
    }
    set out
} -result {{function bgf_long_scale: not generated (unsupported): long-double
  parameter 1 (x): long double: its representation is the target's (binary64, x87 extended precision or binary128), and neither the FFI nor Botlish has a type of it
  result: long double: its representation is the target's (binary64, x87 extended precision or binary128), and neither the FFI nor Botlish has a type of it} {function bgf_add: generated (direct in bgf::bgf): direct; symbol bgf_add; (std::ffi::c::Int, std::ffi::c::Int) -> std::ffi::c::Int} {macro BGF_HALF: not generated (unsupported): floating-constant
  a double constant: the generator binds integer constants only} {no_such_name: not a public name of bgf on linux-x86_64 (no row in */tools/c-bindgen/fixture/expected/linux-x86_64/report.tsv)}}

# ---------------------------------------------------------------------------
# Policy: explicit, checked, never a guess

test cb-policy-stale {a policy that matches nothing is an error, never a silent no-op: a contract naming a function the headers do not declare, a parameter it does not have, a group naming a missing function, a thunk signature of no macro or of a declared function; a contract on a declared function the target cannot bind (bgf_long_ptr: a pointer to long double) is checked against its declaration and kept, listed unused in the manifest} -constraints clang -body {
    set out [lmap changes [list \
        [dict create contracts {bgf_gone {p noescape}}] \
        [dict create contracts {bgf_open {nosuch {read noescape}}}] \
        [dict create groups {{name g functions {bgf_close bgf_gone} facts {handle noescape}}}] \
        [dict create thunks {BGF_NOT_A_MACRO {int BGF_NOT_A_MACRO(int x)}}] \
        [dict create thunks {bgf_get {int bgf_get(int x)}}] \
        [dict create contracts {bgf_long_ptr {nosuch noescape}}]] {
        catch {::cbind::generate::run [fixtureWith $changes] linux-x86_64} message
        string trim [lindex [split $message \n] end]
    }]
    set unbindable [::cbind::generate::run [fixtureWith [dict create contracts [dict merge [dict get $::fixture contracts] {bgf_long_ptr {x noescape}}]]] linux-x86_64]
    lappend out [regexp -all -inline -line {^contract-unused .*$} [dict get $unbindable files manifest.txt]] \
        [lindex [dict get [::cbind::generate::readTsv [dict get $unbindable files report.tsv]] "function bgf_long_ptr"] 2]
} -result {{contract bgf_gone names bgf_gone, which this target's headers do not declare as a function} {contract bgf_open: bgf_open has no parameter "nosuch" (its parameters: name, flags)} {group g names bgf_gone, which this target's headers do not declare as a function} {c-bindgen: the profile's thunk signature of "BGF_NOT_A_MACRO" names no public macro of this target's headers (a stale policy)} {c-bindgen: the profile's thunk signature of "bgf_get" names a declared function, which is bound by its own declaration: remove the policy} {contract bgf_long_ptr: bgf_long_ptr has no parameter "nosuch" (its parameters: x)} {{contract-unused bgf_long_ptr {{contract bgf_long_ptr}} (not bound on this target)}} unsupported}

test cb-representations {a profile's representation rule writes the C float and double positions it names raw -- std::ffi::c::RawFloat, std::ffi::c::RawDouble -- in exactly the functions it lists, with the declaration's C ABI unchanged (the ABI classes of the compiled binding are the finite ones' register classes, marked raw), and the manifest lists each choice with its rule; a rule naming a function the headers do not declare, a parameter a function does not have, a position that is no C float or double, a position another rule chose, or an unknown key is the profile's error (RAW-C-FLOAT-FFI-MILESTONE-1.md)} -constraints clang -body {
    set rules {{name scaled functions {bgf_scale} raw {result y}} {functions {bgf_apply_float} raw {result}}}
    set result [::cbind::generate::run [fixtureWith [dict create representations $rules]] linux-x86_64]
    set module [dict get $result files bgf/bgf.bot]
    set decls [lmap name {bgf_scale bgf_apply_float bgf_dot} {
        regexp "extern c fn ${name}\\((\[^)\]*)\\) -> (\[A-Za-z:\]+)" $module -> written returns
        list [regexp -all -inline {std::ffi::c::Raw[A-Za-z]+} $written] $returns
    }]
    set hir [surface::compile "import std::ffi::c\nextern c fn s named \"bgf_scale\"(x: std::ffi::c::Double, y: std::ffi::c::RawFloat) -> std::ffi::c::RawDouble\nextern c fn f named \"bgf_scale\"(x: std::ffi::c::Double, y: std::ffi::c::Float) -> std::ffi::c::Double\n0\n" t.bot -warnings off]
    hir::activate $hir
    set classes [lmap n {s f} {list [dict get [core::native::metadata extern#$n] extern abi params] [dict get [core::native::metadata extern#$n] extern abi result]}]
    set errors [lmap rules [list \
        {{functions {bgf_gone} raw {result}}} \
        {{functions {bgf_scale} raw {nosuch}}} \
        {{functions {bgf_dot} raw {n}}} \
        {{functions {bgf_scale} raw {y}} {name again functions {bgf_scale} raw {y}}}] {
        catch {::cbind::generate::run [fixtureWith [dict create representations $rules]] linux-x86_64} message
        string trim [lindex [split $message \n] end]
    }]
    catch {fixtureWith [dict create representations {{functions {bgf_scale} finite {result}}}]} unknown
    list $decls \
        [regexp -all -inline -line {^representation .*$} [dict get $result files manifest.txt]] $classes $errors $unknown
} -result {{{std::ffi::c::RawFloat std::ffi::c::RawDouble} {{} std::ffi::c::RawFloat} {{} std::ffi::c::Double}} {{representation bgf_scale result raw {representation scaled}} {representation bgf_scale y raw {representation scaled}} {representation bgf_apply_float result raw {representation 2}}} {{{f64 rf32} rf64} {{f64 f32} f64}} {{representation 1 names bgf_gone, which this target's headers do not declare as a function} {representation 1: bgf_scale has no parameter "nosuch" (its parameters: x, y)} {representation 1: bgf_dot's "n" is size_t (std::ffi::c::ULong), no C float or double: only a C floating position has a raw representation} {representation again: bgf_scale's "y" is already chosen by representation 1}} {c-bindgen: profile bgf: a representation rule has an unknown key "finite" (known: name, functions, raw)}}

test cb-policy-conflict {two positive sources that disagree are a conflict, never a silent choice: the profile's write where the compiler proves readonly, the profile's captures where it proves nocapture} -constraints clang -body {
    lmap facts {{p {write noescape}} {p captures}} {
        catch {::cbind::generate::run [fixtureWith [dict create contracts [dict merge [dict get $::fixture contracts] [list bgf_point_x $facts]]]] linux-x86_64} message
        lrange [split $message \n] 0 1
    }
} -result {{{c-bindgen: contract conflict for bgf_point_x:} {  parameter p: the profile says write, the compiler proves read (nocapture readonly)}} {{c-bindgen: contract conflict for bgf_point_x:} {  parameter p: the profile says captures, the compiler proves nocapture}}}

test cb-policy-facts {a fact a declaration cannot carry is the profile's error: a contract on a non-pointer, a provenance on a parameter} -constraints clang -body {
    lmap contracts {{bgf_add {a {read noescape}}} {bgf_open {name independent}}} {
        catch {::cbind::generate::run [fixtureWith [dict create contracts $contracts]] linux-x86_64} message
        set message
    }
} -result {{c-bindgen: contract bgf_add: bgf_add's parameter "a" is no pointer (int): it carries no contract} {c-bindgen: contract bgf_open: "independent"/"alias" are facts of bgf_open's result, not of its parameter "name"}}

test cb-version-drift {a changed header is a generated diff the check reports with its coverage change: a new representable function, a removed one, a changed signature (and an alias of it), a new unsupported type, a changed macro; the shim, whose thunks did not change, is unchanged} -constraints clang -body {
    set copy [scratch]
    file copy [file join $::fixtureDir include] [file join $copy include]
    set h [file join $copy include bgf bgf.h]
    set text [::chdr::readFile $h]
    set text [string map [list \
        "extern BGF_EXPORT int bgf_count(void);" "extern BGF_EXPORT int bgf_count(void);\nextern BGF_EXPORT int bgf_added(int x);\nextern BGF_EXPORT long double bgf_floaty(void);" \
        "extern BGF_EXPORT char bgf_plain_char(char c);\n" "" \
        "extern BGF_EXPORT int bgf_add(int a, int b);" "extern BGF_EXPORT long bgf_add(long a, long b);" \
        "#define BGF_VERSION_MAJOR 3" "#define BGF_VERSION_MAJOR 4"] $text]
    writeText $h $text
    set profile [fixtureWith [dict create headers [dict merge [dict get $::fixture headers] [dict create source [list local $copy]]]]]
    set result [::cbind::generate::run $profile linux-x86_64]
    set dir [::cbind::profile::outputDir $::fixture linux-x86_64]
    list [lsort [lmap d [::cbind::generate::compare [dict get $result files] $dir bgf] {lindex $d 0}]] \
        [lsort [::cbind::generate::coverageChange $dir $result]]
} -cleanup removeScratch -result {{bgf/bgf.bot bgf/layouts.bot layouts.tsv manifest.txt report.tsv report.txt} {{+ function bgf_added: direct direct} {+ function bgf_floaty: unsupported long-double} {- function bgf_plain_char: was direct direct} {~ function bgf_add: direct direct -> direct direct} {~ macro BGF_VERSION_MAJOR: constant std::ffi::c::Int -> constant std::ffi::c::Int} {~ macro bgf_call_add: alias alias of bgf_add -> alias alias of bgf_add}}}

# ---------------------------------------------------------------------------
# Records and layouts (C-BINDGEN-LAYOUTS.md)

# The record of KEY ("struct bgf_point") in PROFILE/TARGET's generation.
proc record {profile target key} {
    return [dict get [generation $profile $target] model layouts $key]
}

# The layouts generation RESULT declares: name -> {size align fields}.
proc layoutsOf {result ns} {
    set out [dict create]
    foreach l [::cbind::verify::ParseLayouts [dict get $result files $ns/layouts.bot]] {
        dict set out [lindex $l 0] [lrange $l 1 end]
    }
    return $out
}

# Layout NAME of PROFILE/TARGET as {size align {{field type offset} ...}}.
proc layout {profile target name} {
    return [dict get [layoutsOf [generation $profile $target] [dict get $profile name]] $name]
}

# The runtime oracle (tools/c-bindgen/oracle.tcl) over layouts NAMES ("all":
# every emitted one) of PROFILE's generation for the host, on both native
# backends: {CHECKS FAILURES-ON-CRANELIFT FAILURES-ON-CRANELIFT-GENERIC}.
proc layoutOracle {profile names {seed 1}} {
    set target $::hostTarget
    set dir [generatedDir $profile $target]
    set ns [dict get $profile name]
    set r [::cbind::oracle::build $ns $dir $names $seed]
    set app [scratch]
    file copy [file join $dir $ns] [file join $app $ns]
    set hprofile [::cbind::profile::headersFor $profile $target]
    set tool [::cbind::generate::ToolProfile $hprofile [::cbind::profile::sourceRoot $profile 0 $target]]
    set lib [::cbind::oracle::install $r $app [::chdr::toolchain::configFor $target] $tool [file join $app .oracle]]
    set hir [stagedHir $app main.bot "" off]
    set out [list [llength [concat {*}[dict get $r expected]]]]
    native::withLinkDirs [list $lib] {
        foreach backend {cranelift cranelift-generic} {
            lassign [outcomeUnderHir $backend $hir] tag value message
            lappend out [expr {$tag eq "value" ? [::cbind::oracle::failures $r $value] : [list $tag $value $message]}]
        }
    }
    return $out
}

# Compiles the C text SOURCE with the command COMPILER (a word list) and the
# include directory INCLUDE: "" when it compiles, else the diagnostics.
proc compileWith {compiler source include {flags {}}} {
    set dir [scratch]
    set path [file join $dir check.c]
    writeText $path $source
    if {[catch {exec {*}$compiler {*}$flags -w -I$include -c $path -o [file join $dir check.o] 2>@1} out]} {
        return $out
    }
    return ""
}

test cb-layout-records {every complete C record is classified: layout-direct when every field is a C integer scalar (typedefs and enums resolved), a pointer, a fixed array or a record emitted by value -- a union too, a union layout since LAYOUT-UNIONS.md --, layout-blocked with its blockers otherwise, opaque-only when incomplete; an anonymous struct member of a struct is promoted into its record, not a record of its own (bgf_promoted's, bgf_deep's)} -constraints clang -body {
    set recs [dict get [generation $::fixture linux-x86_64] model layouts]
    set out {}
    foreach key {{struct bgf_scalars} {struct bgf_typed} {struct bgf_node} {struct bgf_rect} {struct bgf_frame} {struct bgf_promoted} {struct bgf_chars} {union bgf_value} {struct bgf_tagged} {struct bgf_secret} {struct bgf_handle}} {
        set r [dict get $recs $key]
        lappend out [list $key [dict get $r status] [expr {[dict get $r status] eq "layout-direct" ? [dict get $r layoutName] : "-"}]]
    }
    set promoted [lmap {k r} $recs {expr {[dict get $r status] eq "promoted" ? $k : [continue]}}]
    list $out [llength $promoted] [lmap f [dict get $recs {struct bgf_promoted} fields] {dict get $f name}]
} -result {{{{struct bgf_scalars} layout-direct bgf_scalars} {{struct bgf_typed} layout-direct bgf_typed} {{struct bgf_node} layout-direct bgf_node} {{struct bgf_rect} layout-direct bgf_rect} {{struct bgf_frame} layout-direct bgf_frame} {{struct bgf_promoted} layout-direct bgf_promoted} {{struct bgf_chars} layout-direct bgf_chars} {{union bgf_value} layout-direct bgf_value} {{struct bgf_tagged} layout-direct bgf_tagged} {{struct bgf_secret} opaque-only -} {{struct bgf_handle} opaque-only -}} 2 {kind left right tail}}

test cb-layout-packing {packing and alignment need no C layout rule: #pragma pack(1) and (2), the packed attribute, an aligned record, an aligned member, a packed record nested in an unpacked one and an unpacked one in a packed one are layouts of exactly the sizes, alignments and offsets the compiler gives} -constraints clang -body {
    lmap name {bgf_packed1 bgf_packed2 bgf_packed_attr bgf_aligned bgf_aligned_field bgf_nested_packed bgf_packed_outer} {
        lassign [layout $::fixture linux-x86_64 $name] size align fields
        list $name $size $align [lmap f $fields {lindex $f 2}]
    }
} -result {{bgf_packed1 7 1 {0 1 5}} {bgf_packed2 14 2 {0 2 6}} {bgf_packed_attr 11 1 {0 1 9}} {bgf_aligned 16 16 0} {bgf_aligned_field 32 16 {0 8 16}} {bgf_nested_packed 12 4 {0 1 8}} {bgf_packed_outer 11 1 {0 1 9}}}

test cb-layout-llp64 {the target compiler decides where long lives: on LP64 (Linux x86-64 and AArch64, macOS AArch64) long is 8 bytes and bgf_longs 56 bytes, on Windows x86-64 with MinGW-w64's GNU ABI (LLP64) long is 4 bytes and bgf_longs 48 -- no data model rule in the generator; the layouts' scalars are each target's own (the verifier holds their widths to the compiler's)} -constraints clang -body {
    lmap target [dict get $::fixture targets] {
        lassign [layout $::fixture $target bgf_longs] size align fields
        lassign [layout $::fixture $target bgf_long_pair] psize palign pfields
        list $target $size [lmap f $fields {lindex $f 2}] $psize [lmap f $pfields {lindex $f 2}] \
            [dict get [core::cabi::scalarInfo Long $target] bits]
    }
} -result {{linux-x86_64 56 {0 8 16 24 32 40 48} 72 {0 8 64} 64} {linux-aarch64 56 {0 8 16 24 32 40 48} 72 {0 8 64} 64} {macos-aarch64 56 {0 8 16 24 32 40 48} 72 {0 8 64} 64} {windows-x86_64-gnu 48 {0 4 8 16 24 32 40} 64 {0 8 56} 32}}

