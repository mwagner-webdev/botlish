        [::cbind::model::Signature {fn {int int} {} variadic} {} "" direct]
} -result {{direct bgf::bgf direct {symbol bgf_printf; (std::ffi::c::Ptr[std::ffi::c::Char], variadic) -> std::ffi::c::Int}} {unsupported {} va-list} {unsupported {} variadic {a variadic function (...) reached through a C thunk, which cannot forward its trailing arguments}} {{# C: int bgf_printf(const char *format, ...)
extern c fn bgf_printf(
