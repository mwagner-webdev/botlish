    set probed [::cbind::probe::prototypes [::chdr::toolchain::configFor linux-x86_64] $tool [list \
        {bgf_printf {int (const char *format, ...)}} \
        {bgf_vprintf {int (const char *format, ...)}} \
        {bgf_vshadow {int (int n)}} \
        {bgf_add {int (int a, int b, ...)}}]]
    dict map {name outcome} $probed {lindex $outcome 0}
} -result {bgf_printf ok bgf_vprintf error bgf_vshadow error bgf_add error}

test cb-variadic-contradicted-and-callbacks {a parsed variadic prototype the C compiler contradicts is no binding: generation with the prototype probe answering an error for bgf_printf reports it unsupported (prototype-mismatch) and declares no extern of it; a variadic callback type is no std::ffi::c::FnPtr (a C function pointer's type carries no per-call trailing types)} -constraints clang -body {
