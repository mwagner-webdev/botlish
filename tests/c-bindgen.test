test cb-fixture-cross-headers {a Linux target that is not the host is preprocessed with its own C library headers or not at all: when clang searches no directory of the target's (no GCC cross installation it finds, no sysroot), generation that uses the system headers stops with the remedy instead of reading the host's /usr/include as the target's; a freestanding profile (-nostdlibinc) needs none} -constraints {clang linuxNative} -body {
    set other [expr {$::hostTarget eq "linux-aarch64" ? "linux-x86_64" : "linux-aarch64"}]
    set savedEnv [array get ::env]
    try {
        set ::env(BOTLISH_C_CC) "clang --gcc-toolchain=[file join [temporaryDirectory] no-such-gcc]"
        set system [fixtureWith [dict create headers [dict merge [dict get $::fixture headers] {flags {-ffreestanding}}]]]
        catch {::cbind::generate::run $system $other} message
        set freestanding [dict size [dict get [::cbind::generate::run $::fixture $other] files]]
    } finally {
        array unset ::env
        array set ::env $savedEnv
    }
    list [string match "c-bindgen: $other is not this host's target: clang --target=* searches no directory of $other's C library headers *, so it would read the host's as the target's. Install the target's cross C library where clang finds it (Debian and Ubuntu: gcc-*), or set BOTLISH_C_SYSROOT_[string map {- _} $other] (or BOTLISH_C_SYSROOT) to a sysroot" $message] $freestanding
} -result {1 12}

test cb-fixture-compiles {every target's generated modules are ordinary Botlish: they compile, warning-free (warnings error), with the ordinary front end for that target, and generated modules of declarations only are ordinary modules (unknown escapes designate nothing)} -constraints clang -body {
    lmap target [dict get $::fixture targets] {
        set dir [scratch]
        ::cbind::generate::stage $::fixture $target "" $dir [generatedDir $::fixture $target]
