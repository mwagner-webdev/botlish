test cb-raven-breadth {Raven 0.1.3 is generated from Raven.h by the normal rules: all 921 declared functions bound directly, the two function-like macros (Rerror_check, R_ID_INDEX) unsupported for want of a signature and nothing else; Rid an ABI alias of C unsigned int (no opaque pointer: handles), R_INVALID_ID a constant of its type; every const char * parameter (172) carrying the profile's read noescape (Raven copies every string it is given), every other pointer unknown; 74 bound functions take a callback no Botlish function can be; every complete record a layout} -constraints {ravenSources linuxNative} -body {
    set result [generation [::cbind::profile::load raven] $::linuxHost]
    set c [::cbind::report::counts [dict get $result model]]
    set rows [::cbind::generate::readTsv [dict get $result files report.tsv]]
    set unsupported {}
    dict for {key row} $rows {
        if {[lindex $row 2] eq "unsupported"} { lappend unsupported [list [lindex $row 1] [lindex $row 4]] }
    }
    set recs [dict get $result model layouts]
    set statuses [dict create]
    dict for {key rec} $recs { dict incr statuses [dict get $rec status] }
    list [dict get $c direct] [dict get $c alias] [dict get $c thunk] [lsort $unsupported] \
        [lrange [dict get $rows "typedef Rid"] 2 4] [lrange [dict get $rows "macro R_INVALID_ID"] 2 4] \
        [dict get $c manual] [dict get $c proven] [dict get $c callbacks] [dict get $statuses layout-direct] \
        [regexp {title: std::ffi::c::Ptr\[std::ffi::c::Char\] read noescape} [dict get $result files raven/window.bot]]
} -result {921 0 0 {{R_ID_INDEX macro-needs-signature} {Rerror_check macro-needs-signature}} {scalar {} std::ffi::c::UInt} {constant raven::core std::ffi::c::UInt} 172 0 74 27 1}

test cb-raven-symbols {every Raven function the binding links directly is one libraven.so exports -- in the headless build (no Vulkan backend) all but raven_vulkan.h's 14, which only a Vulkan build defines although Raven.h always declares them (a program calling one links only against a Vulkan build); in a build with the Vulkan backend every one} -constraints ravenLibrary -body {
    set profile [::cbind::profile::load raven]
    set rows [::cbind::generate::readTsv [dict get [generation $profile $::hostTarget] files report.tsv]]
    set defined [dict create]
    foreach line [split [exec nm -D --defined-only [file join [cffi::ravenDir] libraven.so]] \n] {
        if {[regexp {^[0-9a-f]+ [TDRBWi] ([^@ ]+)} $line -> sym]} { dict set defined $sym 1 }
    }
    set missing {}
    set modules {}
    set bound 0
    dict for {key row} $rows {
        lassign $row kind name status module reason detail
        if {$status ni {direct alias}} continue
        regexp {^symbol (\S+);} $detail -> sym
        incr bound
        if {![dict exists $defined $sym]} {
            lappend missing $sym
            lappend modules $module
        }
    }
    set expected [expr {"-DRAVEN_BACKEND_VULKAN=OFF" in [cffi::RavenFlags] ? {raven::vulkan 14} : {{} 0}}]
    list $bound [expr {[list [lsort -unique $modules] [llength $missing]] eq $expected}]
} -result {921 1}

test cb-raven-acceptance {one ordinary Botlish program over the generated Raven declarations and constants alone -- Rinit on the null renderer, a window, a panel, a label and a button, a frame, the label's text and the version (C pointers, not null), handles valid and then invalid after the window is destroyed, Rshutdown -- on both native backends; it is no direct module (handles, numbers and strings lent by the profile's read noescape) and only the functions it calls reach the foreign table} -constraints ravenLibrary -body {
    set profile [::cbind::profile::load raven]
    set dir [staged $profile $::hostTarget [file join $::projectRoot examples ffi bindgen raven demo.bot]]
    set foreign [llength [lsearch -all -regexp [split [native::nir [stagedHir $dir demo.bot]] \n] {^foreign }]]
    set values [stagedValues $dir demo.bot {cranelift cranelift-generic} [list [cffi::ravenDir]]]
    list $foreign $values
} -cleanup removeScratch -result {14 {{[true, true, true, true, true, true, true, true]} {[true, true, true, true, true, true, true, true]}}}

test cb-raven-layouts {every layout the Raven binding emits agrees with C at run time on both native backends (the runtime oracle): RInitDesc (a C float after five ints), REvent, RDropEvent, RTileItem (fixed arrays of floats), RFrameStats (doubles), the backend's draw records and vtable of function pointers, ...; RPainter, only declared, is an opaque pointee} -constraints {ravenSources nativeRun} -body {
    set profile [::cbind::profile::load raven]
    set recs [dict get [generation $profile $::hostTarget] model layouts]
    lassign [layoutOracle $profile all] checks a b
    list [expr {$checks > 200}] $a $b [lmap key {{struct RInitDesc} {struct REvent} {struct RTileItem} {struct RFrameStats} {struct RBackendVTable} {struct RPainter}} {
        list $key [dict get $recs $key status]
    }]
} -cleanup removeScratch -result {1 {} {} {{{struct RInitDesc} layout-direct} {{struct REvent} layout-direct} {{struct RTileItem} layout-direct} {{struct RFrameStats} layout-direct} {{struct RBackendVTable} layout-direct} {{struct RPainter} opaque-only}}}

# ---------------------------------------------------------------------------
# Win32: MinGW-w64's headers for Windows x86-64 with the GNU ABI, from Linux

# 1 when clang can preprocess for windows-x86_64-gnu with MinGW-w64's headers
# of the version the profile pins (its version macros). Headers of another
# version are not the profile's source, and generation refuses them
# (cb-win32-version-pinned), so the Win32 tests do not run with them; the
# c-bindgen workflow installs the pinned ones. A Windows runner's own
# MinGW-w64 headers are the pinned version too (13.0.0), with LLVM's own
# clang, so the Win32 tests run there, except cb-win32-current
# (win32Toolchain, below).
proc mingwReady {} {
    if {[auto_execok clang] eq ""} { return 0 }
    set profile [::cbind::profile::load win32]
    if {[catch {::cbind::profile::sourceRoot $profile 0 windows-x86_64-gnu} sourceRoot]} { return 0 }
    set source [dict get $profile headers source]
    set tool [::cbind::generate::ToolProfile [::cbind::profile::headersFor $profile windows-x86_64-gnu] $sourceRoot]
    set channel [file tempfile entry .c]
    puts $channel "#include <[dict get $source toolchain]>"
    close $channel
    try {
        lassign [::chdr::toolchain::macros [::chdr::toolchain::configFor windows-x86_64-gnu] $tool $entry] ok text
    } finally {
        file delete $entry
    }
    if {!$ok} { return 1 }
    dict for {macro value} [dict get $source version] {
        if {![regexp -line "^#define $macro (.*)\$" $text -> body] || [string trim $body] ne $value} { return 0 }
    }
    return 1
}
testConstraint mingw [mingwReady]
testConstraint mingwGcc [expr {[testConstraint mingw] && [auto_execok x86_64-w64-mingw32-gcc] ne ""}]
set ::win32 [::cbind::profile::load win32]
# 1 when this host's clang for windows-x86_64-gnu is the clang that generated
# the committed Win32 binding (its manifest's toolchain_version). The binding
# is byte for byte the generation of that clang only: a clang that knows
# another set of builtins gives another blocker to an unsupported name
# (PrefetchForWrite's _m_prefetchw is a builtin to clang 21, a missing
# import to clang 20), which changes the reports and the manifest, never a
# module. The c-bindgen workflow has that clang and allows no skip.
testConstraint win32Toolchain [expr {[testConstraint mingw]
    && [dict get [::chdr::toolchain::configFor windows-x86_64-gnu] version]
        eq [lindex [toolchainProvenance [::chdr::readFile [file join [::cbind::profile::outputDir $::win32 windows-x86_64-gnu] manifest.txt]]] 0]}]

test cb-win32-current {the committed Win32 binding (windows-x86_64-gnu) is what generation produces from the installed MinGW-w64 headers and import libraries, byte for byte} -constraints win32Toolchain -body {
    staleBindings {win32 windows-x86_64-gnu}
} -result {}

test cb-win32-identity {the Win32 binding is Windows x86-64 with MinGW-w64's GNU ABI and says so everywhere: its target is windows-x86_64-gnu (x86_64-pc-windows-gnu, never MSVC's windows-x86_64), its toolchain clang's x86_64-w64-mingw32 with MinGW-w64's own headers, every module's banner names the target; windows-x86_64's own toolchain is clang's MSVC target, another triple (ICY-TOWER-WINDOWS.md)} -constraints mingw -body {
    set files [dict get [generation $::win32 windows-x86_64-gnu] files]
    set manifest [dict get $files manifest.txt]
    set msvc [dict get [::chdr::toolchain::configFor windows-x86_64] target]
    list [regexp -all -inline -line {^(?:target|toolchain_target|revision|defines|source) .*$} $manifest] \
        [regexp -inline -line {^layout_abi \S+ clang x86_64-w64-mingw32 } $manifest] \
        [lindex [split [dict get $files win32/layouts.bot] \n] 0] \
        [dict get [core::cabi::target windows-x86_64-gnu] triple] \
        [expr {$msvc eq "x86_64-pc-windows-msvc"}]
} -result {{{target windows-x86_64-gnu} {source {toolchain windows.h version {__MINGW64_VERSION_MAJOR 13 __MINGW64_VERSION_MINOR 0 __MINGW64_VERSION_BUGFIX 0}}} {revision mingw-w64 __MINGW64_VERSION_MAJOR=13 __MINGW64_VERSION_MINOR=0 __MINGW64_VERSION_BUGFIX=0} {defines {WIN32_LEAN_AND_MEAN UNICODE _UNICODE _WIN32_WINNT=0x0A00 WINVER=0x0A00 NTDDI_VERSION=0x0A000000 STRICT NOMINMAX}} {toolchain_target x86_64-w64-mingw32}} {{layout_abi windows-x86_64-gnu clang x86_64-w64-mingw32 }} {# win32::layouts -- GENERATED by tools/c-bindgen.tcl (profile win32, target windows-x86_64-gnu):} x86_64-pc-windows-gnu 1}

# windows-x86_64 (MSVC's ABI) is generated only where clang's MSVC target
# finds MSVC's headers -- on Windows, with Visual Studio's C++ tools and the
# Windows SDK -- never from another C library's headers standing in for
# them (ICY-TOWER-WINDOWS.md).
test cb-msvc-headers-windows-only {off Windows, clang's MSVC target searches no Universal CRT headers, and generation for windows-x86_64 is refused with the reason, before anything is preprocessed} -constraints {clang unix} -body {
    set config [::chdr::toolchain::configFor windows-x86_64]
    set hprofile [dict create includeDirs {} defines {} undefines {} flags {}]
    catch {::cbind::generate::CheckCrossHeaders windows-x86_64 $config $hprofile $hprofile} message
    list [dict get $config target] [regexp {searches no directory of MSVC's C headers .*: windows-x86_64 is MSVC's ABI and toolchain, generated on Windows} $message]
} -result {x86_64-pc-windows-msvc 1}

test cb-win32-version-pinned {the Win32 profile pins MinGW-w64's headers by their version macros, as a fetched source is pinned by its commit: headers of another version, or a toolchain source without a version, are refused, never generated from} -constraints mingw -body {
    set other $::win32
    dict set other headers source version {__MINGW64_VERSION_MAJOR 12 __MINGW64_VERSION_MINOR 0 __MINGW64_VERSION_BUGFIX 1}
    catch {::cbind::generate::run $other windows-x86_64-gnu} wrong
    set none [dict get $::win32 headers]
    dict set none source {toolchain windows.h}
    catch {::cbind::profile::Validate [dict replace $::win32 headers $none]} unpinned
    list $wrong $unpinned
} -result {{c-bindgen: the toolchain's headers are another version: __MINGW64_VERSION_MAJOR is 13, the profile win32 pins 12} {c-bindgen: profile win32: a toolchain source pins its headers by version {MACRO VALUE ...}}}

test cb-win32-sentinels {the familiar Win32 records are the compiler's: POINT, RECT, FILETIME, SYSTEMTIME, SECURITY_ATTRIBUTES, PROCESS_INFORMATION, STARTUPINFOW, BY_HANDLE_FILE_INFORMATION and OVERLAPPED_ENTRY are layouts of MinGW-w64's sizes; WIN32_FIND_DATAW, its WCHAR arrays fixed arrays, is a layout of 592 bytes (FIXED-LAYOUT-ARRAYS.md); LARGE_INTEGER and ULARGE_INTEGER are union layouts and OVERLAPPED an ordinary layout holding a synthetic union (LAYOUT-UNIONS.md), whose C names the manifest maps to generated paths at MinGW-w64's offsets: Offset and OffsetHigh through the anonymous struct, Pointer an alternative of the anonymous union} -constraints mingw -body {
    set result [generation $::win32 windows-x86_64-gnu]
    set recs [dict get $result model layouts]
    set byTypedef [dict create]
    dict for {k r} $recs { foreach t [dict get $r typedefs] { dict set byTypedef $t $k } }
    set out [lmap name {POINT RECT FILETIME SYSTEMTIME SECURITY_ATTRIBUTES PROCESS_INFORMATION STARTUPINFOW BY_HANDLE_FILE_INFORMATION OVERLAPPED_ENTRY OVERLAPPED WIN32_FIND_DATAW LARGE_INTEGER ULARGE_INTEGER} {
        set r [dict get $recs [dict get $byTypedef $name]]
        list $name [dict get $r status] [dict get $r size] [dict get $r align] [::cbind::records::RootReasons $recs [dict get $byTypedef $name]]
    }]
    set promoted {}
    foreach line [split [dict get $result files layouts.tsv] \n] {
        set row [split $line \t]
        if {[lindex $row 0] eq "promoted" && [lindex $row 1] in {{struct _OVERLAPPED} {union _LARGE_INTEGER}}} {
            lappend promoted [list [lindex $row 8] [lindex $row 3] [lindex $row 5] [lindex $row 6]]
        }
    }
    list $out $promoted
} -result {{{POINT layout-direct 8 4 {}} {RECT layout-direct 16 4 {}} {FILETIME layout-direct 8 4 {}} {SYSTEMTIME layout-direct 16 2 {}} {SECURITY_ATTRIBUTES layout-direct 24 8 {}} {PROCESS_INFORMATION layout-direct 24 8 {}} {STARTUPINFOW layout-direct 104 8 {}} {BY_HANDLE_FILE_INFORMATION layout-direct 52 4 {}} {OVERLAPPED_ENTRY layout-direct 32 8 {}} {OVERLAPPED layout-direct 32 8 {}} {WIN32_FIND_DATAW layout-direct 592 4 {}} {LARGE_INTEGER layout-direct 8 8 {}} {ULARGE_INTEGER layout-direct 8 8 {}}} {{LowPart member1.LowPart 0 4} {HighPart member1.HighPart 4 4} {Pointer member3.Pointer 16 8} {Offset member3.member1.Offset 16 4} {OffsetHigh member3.member1.OffsetHigh 20 4}}}

test cb-win32-layouts-compile {the Win32 layouts are ordinary Botlish for windows-x86_64-gnu: a program over them compiles warning-free, its HIR records the GNU target, the native driver refuses to run it on this host (NATIVE TARGET), and the Tcl backends run it} -constraints mingw -body {
    set dir [scratch]
    ::cbind::generate::stage $::win32 windows-x86_64-gnu "" $dir [generatedDir $::win32 windows-x86_64-gnu]
    writeText [file join $dir main.bot] "import std::binary\nimport win32::layouts\n\n\[std::binary::layout_length(win32::layouts::SYSTEMTIME), std::binary::layout_length(win32::layouts::STARTUPINFOW), std::binary::layout_alignment(win32::layouts::SECURITY_ATTRIBUTES)\]\n"
    set hir [stagedHir $dir main.bot windows-x86_64-gnu]
    list [hir::cabi::targetOf $hir] [lindex [outcomeUnderHir interp $hir] 1] [lrange [lindex [outcomeUnderHir cranelift $hir] 1] end-1 end]
} -cleanup removeScratch -result {windows-x86_64-gnu {[16, 104, 8]} {NATIVE TARGET}}

test cb-win32-verified-gcc {MinGW-w64's GCC agrees with clang on every Win32 layout: layouts-check.c compiles with x86_64-w64-mingw32-gcc} -constraints mingwGcc -body {
    set files [dict get [generation $::win32 windows-x86_64-gnu] files]
    list [regexp -all -line {^BOTLISH_RECORD\(} [dict get $files layouts-check.c]] \
        [compileWith x86_64-w64-mingw32-gcc [dict get $files layouts-check.c] [::cbind::profile::sourceRoot $::win32 0 windows-x86_64-gnu]]
} -cleanup removeScratch -match glob -result {9* {}}

test cb-win32-libraries {each Win32 function's import library is the toolchain's answer -- the first of the profile's libraries whose MinGW-w64 import library defines its symbol: CreateFileW kernel32, MessageBoxW user32, RegOpenKeyExW advapi32, GetFileVersionInfoW version, wglCreateContext opengl32; a module declares the libraries of its functions; a symbol several define takes the first (Sleep: kernel32, also synchronization); WinMain, which no library defines, is unsupported} -constraints mingw -body {
    set result [generation $::win32 windows-x86_64-gnu]
    set rows [::cbind::generate::readTsv [dict get $result files report.tsv]]
    list [lmap name {CreateFileW MessageBoxW RegOpenKeyExW GetFileVersionInfoW wglCreateContext WinMain} {
            set row [dict get $rows "function $name"]
            list $name [lindex $row 2] [lindex [regexp -inline {library (\S+);} [lindex $row 5]] 1] [lindex $row 4]
        }] \
        [regexp -all -inline -line {^extern c library .*$} [dict get $result files win32/winbase.bot]] \
        [regexp -inline -line {^import_multiple Sleep .*$} [dict get $result files manifest.txt]]
} -result {{{CreateFileW direct kernel32 direct} {MessageBoxW direct user32 direct} {RegOpenKeyExW direct advapi32 direct} {GetFileVersionInfoW direct version direct} {wglCreateContext direct opengl32 direct} {WinMain unsupported {} no-import-library}} {{extern c library "kernel32"} {extern c library "advapi32"}} {{import_multiple Sleep kernel32 synchronization}}}

test cb-win32-unicode {the raw profile is UNICODE's: FooA and FooW are both bound as declared, the generic macro Foo is an alias of FooW's symbol, and a generic typedef (STARTUPINFO, WIN32_FIND_DATA) names the W record} -constraints mingw -body {
    set result [generation $::win32 windows-x86_64-gnu]
    set rows [::cbind::generate::readTsv [dict get $result files report.tsv]]
    set recs [dict get $result model layouts]
    list [lmap key {{function CreateFileA} {function CreateFileW} {macro CreateFile} {macro FindFirstFile} {macro GetModuleFileName}} {
            set row [dict get $rows $key]
            list $key [lindex $row 2] [lindex $row 4] [lindex [split [lindex $row 5] ";"] 0]
        }] \
        [dict get $recs {struct _STARTUPINFOW} typedefs] [dict get $recs {struct _WIN32_FIND_DATAW} typedefs]
} -result {{{{function CreateFileA} direct direct {symbol CreateFileA}} {{function CreateFileW} direct direct {symbol CreateFileW}} {{macro CreateFile} alias {alias of CreateFileW} {symbol CreateFileW}} {{macro FindFirstFile} alias {alias of FindFirstFileW} {symbol FindFirstFileW}} {{macro GetModuleFileName} alias {alias of GetModuleFileNameW} {symbol GetModuleFileNameW}}} {STARTUPINFOW STARTUPINFO} {WIN32_FIND_DATAW WIN32_FIND_DATA}}

test cb-win32-conventions {WINAPI and CALLBACK are __stdcall, which the compiler ignores on x86-64: no Win32 function is blocked by its convention, and the manifest counts the functions whose declared convention the compiler took as the default} -constraints mingw -body {
    set result [generation $::win32 windows-x86_64-gnu]
    set c [::cbind::report::counts [dict get $result model]]
    set stdcall [lindex [regexp -inline -line {^convention_default stdcall ([0-9]+)$} [dict get $result files manifest.txt]] 1]
    list [expr {[dict exists $c blockers unsupported-calling-convention] ? [dict get $c blockers unsupported-calling-convention] : 0}] [expr {$stdcall > 2500}]
} -result {0 1}

cleanupTests
