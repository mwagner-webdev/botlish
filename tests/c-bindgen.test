        [regexp -all -line {^opaque struct (bgf_chars|bgf_points4|bgf_node):$} $ctypes] \
        [regexp -inline -line {^# struct bgf_node .*$} $ctypes]
} -result {{{next {std::ffi::c::Ptr[bgf::ctypes::bgf_node]}} {handle {std::ffi::c::Ptr[bgf::ctypes::bgf_handle]}} {data {std::ffi::c::Ptr[std::ffi::c::Void]}} {name {std::ffi::c::Ptr[std::ffi::c::Char]}} {slot {std::ffi::c::Ptr[std::ffi::c::Ptr[bgf::ctypes::bgf_node]]}} {visit {std::ffi::c::FnPtr[Fn{args: [std::ffi::c::Ptr[std::ffi::c::Void], std::ffi::c::Ptr[bgf::ctypes::bgf_handle], std::ffi::c::Int], return: std::ffi::c::Int}]}} {compare {std::ffi::c::FnPtr[Fn{args: [std::ffi::c::Ptr[bgf::ctypes::bgf_node], std::ffi::c::Ptr[bgf::ctypes::bgf_node]], return: std::ffi::c::Int}]}} {label {std::ffi::c::Ptr[bgf::ctypes::bgf_chars]}} {id std::ffi::c::UInt}} layout-direct 3 {{# struct bgf_node (include/bgf/bgf_records.h), a complete C type: its layout is bgf::layouts::bgf_node}}}

test cb-layout-blockers {every representation the layout language lacks is a blocker, never approximated: flexible array members (a fixed array of representable elements is no blocker since FIXED-LAYOUT-ARRAYS.md: bgf_chars, bgf_wide_text, bgf_points4, bgf_ptrs3 and bgf_matrix are layouts; nor a union or an anonymous union member since LAYOUT-UNIONS.md: bgf_value, bgf_tagged, bgf_overlay and bgf_mixed are layouts), bitfields, long double (C float and double fields are layout fields since C-FLOAT-FFI-MILESTONE-1.md: bgf_real and bgf_float_ptr are layouts), C _Bool, volatile, a typedef an attribute widens, a callback with a long double, an explicit calling convention; a record holding a blocked one by value is nested-layout-blocked with the chain to its first direct blocker} -constraints clang -body {
    set recs [dict get [generation $::fixture linux-x86_64] model layouts]
    lmap key {{struct bgf_chars} {struct bgf_wide_text} {struct bgf_points4} {struct bgf_ptrs3} {struct bgf_matrix} {struct bgf_flex} {union bgf_value} {struct bgf_tagged} {struct bgf_overlay} {struct bgf_bits} {struct bgf_real} {struct bgf_ld} {struct bgf_flag} {struct bgf_vol} {struct bgf_wide_field} {struct bgf_float_ptr} {struct bgf_bad_callback} {struct bgf_ms_field} {struct bgf_outer_blocked} {struct bgf_chain2} {struct bgf_mixed} {struct bgf_flagged_rect}} {
        set r [dict get $recs $key]
        list $key [lsort -unique [lmap b [dict get $r direct] {lindex $b 0}]] [lmap b [dict get $r transitive] {lindex $b 1}] \
            [::cbind::records::RootReasons $recs $key]
    }
} -result {{{struct bgf_chars} {} {} {}} {{struct bgf_wide_text} {} {} {}} {{struct bgf_points4} {} {} {}} {{struct bgf_ptrs3} {} {} {}} {{struct bgf_matrix} {} {} {}} {{struct bgf_flex} flexible-array {} flexible-array} {{union bgf_value} {} {} {}} {{struct bgf_tagged} {} {} {}} {{struct bgf_overlay} {} {} {}} {{struct bgf_bits} bitfield {} bitfield} {{struct bgf_real} {} {} {}} {{struct bgf_ld} long-double {} long-double} {{struct bgf_flag} c-bool {} c-bool} {{struct bgf_vol} volatile {} volatile} {{struct bgf_wide_field} typedef-abi-mismatch {} typedef-abi-mismatch} {{struct bgf_float_ptr} {} {} {}} {{struct bgf_bad_callback} unsupported-pointer {} unsupported-pointer} {{struct bgf_ms_field} unsupported-calling-convention {} unsupported-calling-convention} {{struct bgf_outer_blocked} {} {} {}} {{struct bgf_chain2} {} {} {}} {{struct bgf_mixed} {} {} {}} {{struct bgf_flagged_rect} {} {{field flag (struct bgf_flag, field) -> c-bool}} c-bool}}

test cb-layout-floats {C float and C double fields are layout fields of their own C types (C-FLOAT-FFI-MILESTONE-1.md), at the compiler's offsets, never Float64 and never one another: beside other scalars (a float aligned to 4, a double to 8), through typedef chains the compiler confirms, as fixed array elements (a float array strides 4 bytes, a two-dimensional double array 8), as union alternatives and in an anonymous union} -constraints clang -body {
    set text [dict get [generation $::fixture linux-x86_64] files bgf/layouts.bot]
    lmap name {bgf_mixed_floats bgf_mixed_real bgf_samples bgf_fnum bgf_anon_fnum_member2} {
        lindex [regexp -line -inline "^(?:union )?layout $name:\n(?:    .*\n)*" $text] 0
    }
} -result {{layout bgf_mixed_floats:
    size 24
    align 8
    field tag: std::ffi::c::UChar at 0  # uint8_t tag
    field a: std::ffi::c::Float at 4    # float a
    field b: std::ffi::c::Double at 8   # double b
    field c: std::ffi::c::Float at 16   # float c
} {layout bgf_mixed_real:
    size 32
    align 8
    field x: std::ffi::c::Float at 0    # float x
    field y: std::ffi::c::Double at 8   # double y
    field z: std::ffi::c::Float at 16   # bgf_scalar32 z
    field w: std::ffi::c::Float at 20   # bgf_real32 w
    field v: std::ffi::c::Double at 24  # bgf_scalar64 v
} {layout bgf_samples:
    size 56
    align 8
    field xs: array 4 of std::ffi::c::Float at 0               # float xs[4]
    field ys: array 2 of array 2 of std::ffi::c::Double at 16  # double ys[2][2]
    field n: std::ffi::c::Int at 48                            # int n
} {union layout bgf_fnum:
    size 8
    align 8
    alternative i: std::ffi::c::Int     # int i
    alternative f: std::ffi::c::Float   # float f
    alternative d: std::ffi::c::Double  # double d
} {union layout bgf_anon_fnum_member2:
    size 4
    align 4
    alternative u: std::ffi::c::UInt   # unsigned int u
    alternative f: std::ffi::c::Float  # float f
}}

test cb-layout-arrays {an array field is recorded, never flattened: its element type and category, its bounds and the compiler's element count (a fixed array of representable elements is a layout field, FIXED-LAYOUT-ARRAYS.md; a flexible array member stays blocked); a bitfield its declared type and width} -constraints clang -body {
    set recs [dict get [generation $::fixture linux-x86_64] model layouts]
    set out {}
    foreach {key i} {{struct bgf_chars} 1 {struct bgf_wide_text} 1 {struct bgf_points4} 0 {struct bgf_ptrs3} 0 {struct bgf_matrix} 0 {struct bgf_flex} 1} {
        set f [lindex [dict get $recs $key fields] $i]
        lappend out [list $key [dict get $f array] [expr {[dict exists $f extent] ? [dict get $f extent] : "-"}] [dict get $f offset]]
    }
    set bits [lmap f [dict get $recs {struct bgf_bits} fields] {list [dict get $f cname] [::cir::BoundText [dict get $f bits]] [dict get $f offset]}]
    list $out $bits [regexp -all -line {^\s+field name} [dict get [generation $::fixture linux-x86_64] files bgf/layouts.bot]]
} -result {{{{struct bgf_chars} {category char element char bounds 16} 16 4} {{struct bgf_wide_text} {category wide-char element wchar_t bounds 8} 8 4} {{struct bgf_points4} {category record element bgf_point bounds 4} 4 0} {{struct bgf_ptrs3} {category pointer element {void *} bounds 3} 3 0} {{struct bgf_matrix} {category scalar element int bounds {2 3}} 2 0} {{struct bgf_flex} {category scalar element int bounds {{}}} - 8}} {{a 3 {}} {b 5 {}} {rest {} 4}} 3}

test cb-layout-array-of-blocked {an array of a record is a by-value dependency like the record itself (FIXED-LAYOUT-ARRAYS.md): an array -- one- or two-dimensional -- of a blocked record blocks its holder, nested-layout-blocked through an array element with the element's root reasons, and the holder is never emitted; an array of a record with a layout is a layout field naming that layout} -constraints clang -body {
    set copy [scratch]
    file copy [file join $::fixtureDir include] [file join $copy include]
    set h [file join $copy include bgf bgf_records.h]
    set text [::chdr::readFile $h]
    set end [string last "#endif" $text]
    writeText $h "[string range $text 0 [expr {$end - 1}]]typedef struct bgf_flags2 { bgf_flag flags\[2\]; int n; } bgf_flags2;\ntypedef struct bgf_flag_rows { int n; bgf_flag rows\[2\]\[3\]; } bgf_flag_rows;\ntypedef struct bgf_rects2 { bgf_rect rects\[2\]; } bgf_rects2;\n\n[string range $text $end end]"
    set profile [fixtureWith [dict create headers [dict merge [dict get $::fixture headers] [dict create source [list local $copy]]]]]
    set result [::cbind::generate::run $profile linux-x86_64]
    set recs [dict get $result model layouts]
    set layouts [dict get $result files bgf/layouts.bot]
    set out [lmap key {{struct bgf_flags2} {struct bgf_flag_rows} {struct bgf_rects2}} {
        set r [dict get $recs $key]
        list $key [dict get $r status] [lmap b [dict get $r transitive] {lindex $b 1}] [::cbind::records::RootReasons $recs $key] \
            [string match "*\nlayout [dict get $r layoutName]:\n*" $layouts]
    }]
    # (Every array field of either element: the blocked one has none.)
    list $out [regexp -all -inline -line {^\s+field \S+: (?:array \d+ of )+bgf_(?:flag|rect) .*$} $layouts]
} -cleanup removeScratch -result {{{{struct bgf_flags2} layout-blocked {{field flags (struct bgf_flag, array-element) -> c-bool}} c-bool 0} {{struct bgf_flag_rows} layout-blocked {{field rows (struct bgf_flag, array-element) -> c-bool}} c-bool 0} {{struct bgf_rects2} layout-direct {} {} 1}} {{    field rects: array 2 of bgf_rect at 0  # bgf_rect rects[2]}}}

test cb-layout-naming {layout names are stable and collision-safe, read from the records only: the first typedef naming a tag, else the tag; a typedef and a tag of one name are two records and two layouts (bgf_coll, bgf_coll_struct); C names Botlish reserves are renamed (loop_, List_; fields fn_, type_, loop_); several typedefs of one record are one layout listing them all; an anonymous record is named by its typedef or by its container's name and member, an anonymous member (a synthetic layout) by its container's name and its place (bgf_overlay_member2, bgf_deep_member3_member1_member3; bgf_overlapped_member3_union, since a tag holds bgf_overlapped_member3); reversing the header's declarations changes no name} -constraints clang -body {
    set recs [dict get [generation $::fixture linux-x86_64] model layouts]
    set names [lmap key {{struct bgf_coll_a} {struct bgf_coll} {struct bgf_kw} {struct List} {struct bgf_multi}} {
        list $key [dict get $recs $key layoutName] [dict get $recs $key typedefs]
    }]
    set anon [lsort [lmap {k r} $recs {expr {[dict get $r anonymous] && [dict get $r status] eq "layout-direct" && ![dict get $r unheld] ? [dict get $r layoutName] : [continue]}}]]
    set kw [lmap f [dict get $recs {struct bgf_kw} fields] {dict get $f name}]
    # The same records, declared in the reverse order of their groups.
    set copy [scratch]
    file copy [file join $::fixtureDir include] [file join $copy include]
    set h [file join $copy include bgf bgf_records.h]
    set text [::chdr::readFile $h]
    set a [string first "/* Names:" $text]
    set b [string first "/* Blocked records:" $text]
    writeText $h "[string range $text 0 [expr {$a - 1}]][string range $text $b end]\n[string range $text $a [expr {$b - 1}]]"
    set profile [fixtureWith [dict create headers [dict merge [dict get $::fixture headers] [dict create source [list local $copy]]]]]
    set moved [dict get [::cbind::generate::run $profile linux-x86_64] model layouts]
    # Anonymous records are keyed by their position (anon@FILE:LINE): they
    # are compared by name.
    set namesOf {recs {
        lsort [lmap {k r} $recs {expr {[dict get $r anonymous] ? [list - [dict get $r layoutName]] : [list $k [dict get $r layoutName]]}}]
    }}
    set same [expr {[apply $namesOf $recs] eq [apply $namesOf $moved]}]
    list $names $anon $kw $same
} -cleanup removeScratch -result {{{{struct bgf_coll_a} bgf_coll bgf_coll} {{struct bgf_coll} bgf_coll_struct {}} {{struct bgf_kw} loop_ loop} {{struct List} List_ {}} {{struct bgf_multi} bgf_multi {bgf_multi bgf_multi_alias bgf_multi2}}} {bgf_anon_fnum_member2 bgf_anon_point bgf_anon_tail_member2 bgf_deep_member2_member2 bgf_deep_member3 bgf_deep_member3_member1 bgf_deep_member3_member1_member3 bgf_large_member1 bgf_large_u bgf_member_anon_range bgf_overlapped_member3_member1 bgf_overlapped_member3_union bgf_overlay_member2 bgf_two_anon_member1 bgf_two_anon_member2} {fn_ type_ loop_} 1}

test cb-layout-verified {every emitted layout is the compiler's: layouts-check.c, read back from the generated Botlish text, compiles for every committed target, and a layout corrupted in any number -- a size, an alignment, an offset off by one, a field's scalar width or class -- fails it, naming the layout and the field} -constraints clang -body {
    set ok [lmap target [dict get $::fixture targets] {
        set result [generation $::fixture $target]
        set config [::chdr::toolchain::configFor $target]
        set tool [::cbind::generate::ToolProfile [::cbind::profile::headersFor $::fixture $target] $::fixtureDir]
        lindex [::chdr::toolchain::compile $config $tool [dict get $result files layouts-check.c] {-w}] 0
    }]
    set files [dict get [generation $::fixture linux-x86_64] files]
    set config [::chdr::toolchain::configFor linux-x86_64]
    set tool [::cbind::generate::ToolProfile [::cbind::profile::headersFor $::fixture linux-x86_64] $::fixtureDir]
    set caught {}
    foreach {old new} {
        "layout bgf_point:\n    size 8" "layout bgf_point:\n    size 12"
        "layout bgf_packed1:\n    size 7\n    align 1" "layout bgf_packed1:\n    size 7\n    align 4"
        "field length: std::ffi::c::UInt at 1" "field length: std::ffi::c::UInt at 2"
        "field l: std::ffi::c::Long at 8" "field l: std::ffi::c::Int at 8"
        "field next: std::ffi::c::Ptr\[bgf::ctypes::bgf_node\] at 0" "field next: std::ffi::c::ULong at 0"
    } {
        set bad [dict replace $files bgf/layouts.bot [string map [list $old $new] [dict get $files bgf/layouts.bot]]]
        set check [::cbind::verify::source $bad $::fixture linux-x86_64 {}]
        lassign [::chdr::toolchain::compile $config $tool $check {-w}] good stderr
        lappend caught [expr {$good ? "missed" : [lindex [regexp -inline {static assertion failed[^"]*"([^"]*)"} $stderr] 1]}]
    }
    list $ok $caught
} -result {{1 1 1 1} {bgf_point bgf_packed1 bgf_packed1.length bgf_longs.l bgf_node.next}}

test cb-layout-second-compiler {GCC agrees with clang on every emitted fixture layout: layouts-check.c compiles with the host's cc for the host target and, where installed, with the MinGW-w64 and AArch64 cross gcc for theirs} -constraints {clang linuxNative} -body {
    set out {}
    foreach {target cc} [list $::hostTarget cc windows-x86_64-gnu x86_64-w64-mingw32-gcc linux-aarch64 aarch64-linux-gnu-gcc linux-x86_64 x86_64-linux-gnu-gcc] {
        if {[auto_execok $cc] eq "" || $target ni [dict get $::fixture targets]} continue
        if {$target ne $::hostTarget && $cc eq "cc"} continue
        if {[dict exists $out $target]} continue
        dict set out $target [compileWith $cc [dict get [generation $::fixture $target] files layouts-check.c] [file join $::fixtureDir include] -ffreestanding]
    }
    dict map {t v} $out {expr {$v eq "" ? "agrees" : $v}}
} -match glob -result {*agrees*}

test cb-layout-oracle-fixture {every emitted fixture layout agrees with C at run time, on both native backends: C writes every field with its own typed stores and Botlish reads them through std::binary::native::view; Botlish writes every field through std::binary::native::edit and C reads them, the padding untouched; Botlish builds the record in MutableBytes with std::binary::write and std::binary::write_foreign and C reads that image, its padding zero; std::binary::parse reads it back; layout_length and layout_alignment are C's sizeof and _Alignof} -constraints {nativeRun fixtureHostBinding} -body {
    lassign [layoutOracle $::fixture all] checks a b
    list [expr {$checks > 250}] $a $b
} -cleanup removeScratch -result {1 {} {}}

test cb-layout-ordinary {a generated layout is an ordinary layout: a program over one (bytes in, a LayoutStruct out, bytes back) runs on all four backends, through HIR interchange in a fresh process, and through the front-end cache, with no C compiler at compile time} -constraints {clang fixtureHostBinding} -body {
    set dir [scratch]
    ::cbind::generate::stage $::fixture $::hostTarget "" $dir [generatedDir $::fixture $::hostTarget]
    writeText [file join $dir main.bot] "import std::abi\nimport std::abi::bytes\nimport std::binary\nimport bgf::layouts\n\nfn run() -> List\[int\] errors LayoutLengthMismatch:\n    d0 = std::abi::bytes::zeroed(std::abi::usize(std::binary::layout_length(bgf::layouts::bgf_packed_outer)))\n    d1 = std::binary::write(d0, bgf::layouts::bgf_packed_outer.inner.y, -9)\n    d2 = std::binary::write(d1, bgf::layouts::bgf_packed_outer.tail, 513)\n    v = std::binary::parse(bgf::layouts::bgf_packed_outer, std::abi::bytes::freeze(d2))\n    \[std::binary::layout_length(bgf::layouts::bgf_packed_outer), std::binary::layout_alignment(bgf::layouts::bgf_packed_outer), v.inner.y, v.tail, v.lead\]\n\nr = run():\n    on LayoutLengthMismatch:\n        \[\]\nr\n"
    set hir [stagedHir $dir main.bot]
    set values [lmap backend [backendsFor $::hostTarget] {lindex [outcomeUnderHir $backend $hir] 1}]
    set text [hir::interchange::encode $hir]
    set script [file join $dir fresh.tcl]
    writeText $script "source [list [file join $::projectRoot surface surface.tcl]]\nset hir \[hir::interchange::decode [list $text]\]\nputs \[core::value::show \[core::evalProgram \[hir::lower \$hir\]\] 1 1\]\n"
    set fresh [exec [info nameofexecutable] $script]
    set cache [scratch]
    set first [surface::readProgramFile [file join $dir main.bot] -warnings error -cache $cache]
    set second [surface::readProgramFile [file join $dir main.bot] -warnings error -cache $cache]
    list [lsort -unique $values] $fresh [expr {[hir::interchange::encode $first] eq [hir::interchange::encode $second]}]
} -cleanup removeScratch -result {{{[11, 1, -9, 513, 0]}} {[11, 1, -9, 513, 0]} 1}

test cb-layout-pressure {the report weighs every missing feature on the dependency graph, transitively: a record is recovered only when every direct blocker is lifted and everything it holds by value is recovered (unions and fixed arrays are no missing feature: neither are C float and double fields since C-FLOAT-FFI-MILESTONE-1.md: what remains are long double and the other floating fields, C _Bool, bitfields, flexible arrays and explicit calling conventions -- also inside unions: bgf_num waits for long double, bgf_holds_bitsu for bitfields); the API pressure counts bound functions pointing to records with layouts, blocked ones and opaque ones by pointer shape} -constraints clang -body {
    set text [dict get [generation $::fixture linux-x86_64] files report.txt]
    set a [string first "Layout pressure" $text]
    set b [string first "Macro APIs" $text]
    string trim [string range $text $a [expr {$b - 1}]]
} -result {Layout pressure (blocked records a missing feature would make layouts: directly + transitively)
  std::ffi::c::Bool fields                                                     3     3.3%  2 + 1
  long double fields                                                           5     5.5%  3 + 2
  other floating fields (_Float16, __float128, ...)                            0     0.0%  0 + 0
  bitfields                                                                    4     4.4%  2 + 2
  flexible array members                                                       1     1.1%  1 + 0
  explicit calling conventions                                                 1     1.1%  1 + 0
  all of the above                                                            14    15.4%  9 + 5

API pressure (bound APIs pointing to C records)
  bound APIs with a pointer to a C record (parameter or result)               16    26.2%
    to a record with an emitted layout                                         8    50.0%
    to a complete record whose layout is blocked                               0     0.0%
    only to incomplete records (or complete ones outside the headers)          8    50.0%
  pointers by shape and record (layout / blocked / incomplete / outside):
    param T *                2 / 0 / 6 / 0
    param const T *          5 / 0 / 0 / 0
    param T **               1 / 0 / 0 / 0
    result T *               1 / 0 / 3 / 0
    result T **              0 / 0 / 1 / 0
  records bound signatures point to                                           11
    complete                                                                   6    54.5%
      with an emitted layout                                                   6    54.5%
      whose layout is blocked                                                  0     0.0%
      outside the profile's records (a system header's)                        0     0.0%
    incomplete (opaque only)                                                   5    45.5%
  bound APIs a missing feature would give a layout of a record they point to:
      std::ffi::c::Bool fields                                                 0     0.0%  0 records
      long double fields                                                       0     0.0%  0 records
      other floating fields (_Float16, __float128, ...)                        0     0.0%  0 records
      bitfields                                                                0     0.0%  0 records
      flexible array members                                                   0     0.0%  0 records
      explicit calling conventions                                             0     0.0%  0 records
      all of the above                                                         0     0.0%  0 records}

test cb-layout-manifest {the layout manifest (layouts.tsv) holds every record and every member for later pressure analysis, with sizes, offsets, C types, categories, element counts and blockers; the manifest names the ABI identity of the layouts (target and toolchain) and counts them; report.tsv has a row per record and `report -why` explains one, by its key or by a typedef naming it} -constraints clang -body {
    set files [dict get [generation $::fixture linux-x86_64] files]
    set tsv [split [dict get $files layouts.tsv] \n]
    set rows [lmap line $tsv {expr {[string match "*\tstruct bgf_chars\t*" $line] ? [string map {\t " | "} $line] : [continue]}}]
    list [string match "# c-bindgen layout manifest: profile bgf, target linux-x86_64, toolchain clang x86_64-linux-gnu (*) (C-BINDGEN-LAYOUTS.md)" [lindex $tsv 0]] \
        [string map {\t " | "} [lindex $tsv 1]] $rows \
        [regsub -all {\{[^{}]*clang version[^{}]*\}} [regexp -all -inline -line {^layout_(?:abi|count emitted|count blocked) .*$} [dict get $files manifest.txt]] VERSION] \
        [exec [info nameofexecutable] [file join $::projectRoot tools c-bindgen.tcl] report fixture -target linux-x86_64 -why {struct bgf_chain2}] \
        [exec [info nameofexecutable] [file join $::projectRoot tools c-bindgen.tcl] report fixture -target linux-x86_64 -why bgf_rect]
} -result {1 {kind | record | index | name | status | offset | size | align | c | type | detail} {{record | struct bgf_chars | - | bgf_chars | layout-direct | - | 20 | 4 | struct bgf_chars | - | typedefs=bgf_chars; identity=bgf::ctypes::bgf_chars; header=include/bgf/bgf_records.h:181; pointed-by=1} {field | struct bgf_chars | 0 | len | scalar | 0 | 4 | - | int len | std::ffi::c::Int | c=len} {field | struct bgf_chars | 1 | name | array | 4 | 16 | - | char name[16] | array 16 of std::ffi::c::Char | c=name; element=char char; bounds=16; extent=16}} {{layout_abi linux-x86_64 clang x86_64-linux-gnu VERSION} {layout_count blocked 17} {layout_count emitted 73}} {tag struct bgf_chain2: not generated (unused): complete
  no bound signature points to it
record struct bgf_chain2: generated (layout-direct in bgf::layouts): bgf_chain2; sizeof 32, _Alignof 8, 2 fields} {typedef bgf_rect: generated (opaque in bgf::ctypes): identity bgf_rect; struct bgf_rect
record struct bgf_rect: generated (layout-direct in bgf::layouts): bgf_rect; sizeof 16, _Alignof 4, 2 fields}}

test cb-layout-conventions {an explicit calling convention is a blocker only where the compiler says the declared type is not the plain one (__builtin_types_compatible_p): __stdcall is ignored on every 64-bit target, so bgf_stdcall binds everywhere; ms_abi is Windows x86-64's default and another convention on Linux x86-64, for a function, a callback typedef and a record's field alike; the manifest counts the conventions taken as the default} -constraints clang -body {
    lmap target [dict get $::fixture targets] {
        set rows [::cbind::generate::readTsv [dict get [generation $::fixture $target] files report.tsv]]
        list $target [lmap name {bgf_stdcall bgf_ms bgf_take_ms} {
            expr {[dict exists $rows "function $name"] ? [lindex [dict get $rows "function $name"] 2] : "absent"}
        }] [dict get [record $::fixture $target {struct bgf_ms_field}] status] \
            [regexp -all -inline -line {^convention_default .*$} [dict get [generation $::fixture $target] files manifest.txt]]
    }
} -result {{linux-x86_64 {direct unsupported unsupported} layout-blocked {{convention_default stdcall 1}}} {linux-aarch64 {direct absent absent} layout-blocked {{convention_default stdcall 1}}} {macos-aarch64 {direct absent absent} layout-blocked {{convention_default stdcall 1}}} {windows-x86_64-gnu {direct direct direct} layout-direct {{convention_default ms_abi 1} {convention_default stdcall 1}}}}

# ---------------------------------------------------------------------------
# Unions and anonymous members (LAYOUT-UNIONS.md)

test cb-layout-unions {a C union is a union layout: its sizeof and _Alignof the compiler's -- tail padding (bgf_tail_u: 8 bytes for a 5-byte alternative) and an aligned union (bgf_aligned_u) included, never the widest member's --, every member an alternative of the type the binding model maps it to (a scalar, a pointer, an array, a record, a packed record; a keyword renamed); arrays of unions, one- and two-dimensional, and unions of arrays are ordinary layout fields} -constraints clang -body {
    lmap name {bgf_value bgf_word bgf_shape bgf_packed_u bgf_tail_u bgf_aligned_u bgf_kwu bgf_words3 bgf_word_grid} {
        list $name {*}[layout $::fixture linux-x86_64 $name]
    }
} -result {{bgf_value 8 8 {{i std::ffi::c::Int 0} {u std::ffi::c::UInt 0} {p {std::ffi::c::Ptr[std::ffi::c::Void]} 0}} 1} {bgf_word 4 4 {{whole std::ffi::c::UInt 0} {halves {array 2 of std::ffi::c::UShort} 0} {bytes {array 4 of std::ffi::c::UChar} 0}} 1} {bgf_shape 8 8 {{pt bgf_point 0} {bits std::ffi::c::LongLong 0} {raw {array 3 of std::ffi::c::UChar} 0}} 1} {bgf_packed_u 7 1 {{p bgf_packed1 0} {raw {array 7 of std::ffi::c::UChar} 0}} 1} {bgf_tail_u 8 4 {{c {array 5 of std::ffi::c::Char} 0} {i std::ffi::c::Int 0}} 1} {bgf_aligned_u 16 16 {{i std::ffi::c::Int 0} {c std::ffi::c::Char 0}} 1} {bgf_kwu 4 4 {{fn_ std::ffi::c::Int 0} {type_ std::ffi::c::UInt 0}} 1} {bgf_words3 16 4 {{n std::ffi::c::Int 0} {words {array 3 of bgf_word} 4}} 0} {bgf_word_grid 20 4 {{grid {array 2 of array 2 of bgf_word} 0} {tail std::ffi::c::Short 16}} 0}}

test cb-layout-anonymous-members {an anonymous member is represented truthfully, never flattened into overlapping fields: an anonymous union is a synthetic union layout held by a generated field at the compiler's offset (OVERLAPPED's shape: bgf_overlapped.member3 at 16), an anonymous struct in a union a synthetic struct layout, an alternative (member1, offset_high at 4 within it); an anonymous struct in a struct is still promoted (bgf_deep's a; its anonymous union is the field member2_member2); every deeper level keeps its own layout; a union's size is the compiler's (bgf_anon_tail_member2: 8); two anonymous unions on one line are told apart; the manifest maps every promoted C name to the generated path that reaches it, with its offset in the owner} -constraints clang -body {
    set out [lmap name {bgf_overlay bgf_overlay_member2 bgf_overlapped bgf_overlapped_member3_union bgf_overlapped_member3_member1 bgf_large bgf_large_member1 bgf_deep bgf_deep_member2_member2 bgf_deep_member3 bgf_deep_member3_member1 bgf_deep_member3_member1_member3 bgf_anon_tail bgf_anon_tail_member2 bgf_two_anon bgf_two_anon_member1 bgf_two_anon_member2} {
        list $name {*}[layout $::fixture linux-x86_64 $name]
    }]
    set promoted {}
    foreach line [split [dict get [generation $::fixture linux-x86_64] files layouts.tsv] \n] {
        set row [split $line \t]
        if {[lindex $row 0] eq "promoted" && [lindex $row 1] in {{struct bgf_overlapped} {struct bgf_deep}}} {
            lappend promoted [list [lindex $row 1] [lindex $row 8] [lindex $row 3] [lindex $row 5] [lindex $row 6]]
        }
    }
    list $out $promoted
} -result {{{bgf_overlay 16 8 {{kind std::ffi::c::Int 0} {member2 bgf_overlay_member2 8}} 0} {bgf_overlay_member2 8 8 {{i std::ffi::c::Int 0} {p {std::ffi::c::Ptr[std::ffi::c::Void]} 0}} 1} {bgf_overlapped 32 8 {{internal std::ffi::c::ULong 0} {internal_high std::ffi::c::ULong 8} {member3 bgf_overlapped_member3_union 16} {event {std::ffi::c::Ptr[std::ffi::c::Void]} 24}} 0} {bgf_overlapped_member3_union 8 8 {{member1 bgf_overlapped_member3_member1 0} {pointer {std::ffi::c::Ptr[std::ffi::c::Void]} 0}} 1} {bgf_overlapped_member3_member1 8 4 {{offset std::ffi::c::UInt 0} {offset_high std::ffi::c::UInt 4}} 0} {bgf_large 8 8 {{member1 bgf_large_member1 0} {u bgf_large_u 0} {quad std::ffi::c::LongLong 0}} 1} {bgf_large_member1 8 4 {{low std::ffi::c::UInt 0} {high std::ffi::c::Int 4}} 0} {bgf_deep 20 4 {{tag std::ffi::c::Char 0} {a std::ffi::c::Short 4} {member2_member2 bgf_deep_member2_member2 8} {member3 bgf_deep_member3 12}} 0} {bgf_deep_member2_member2 4 4 {{b std::ffi::c::Int 0} {c {array 3 of std::ffi::c::Char} 0}} 1} {bgf_deep_member3 8 4 {{member1 bgf_deep_member3_member1 0} {w bgf_word 0}} 1} {bgf_deep_member3_member1 6 2 {{x std::ffi::c::UShort 0} {y std::ffi::c::UShort 2} {member3 bgf_deep_member3_member1_member3 4}} 0} {bgf_deep_member3_member1_member3 2 2 {{z std::ffi::c::UChar 0} {zz std::ffi::c::UShort 0}} 1} {bgf_anon_tail 16 4 {{k std::ffi::c::Char 0} {member2 bgf_anon_tail_member2 4} {after std::ffi::c::Char 12}} 0} {bgf_anon_tail_member2 8 4 {{c {array 5 of std::ffi::c::Char} 0} {i std::ffi::c::Int 0}} 1} {bgf_two_anon 16 8 {{member1 bgf_two_anon_member1 0} {member2 bgf_two_anon_member2 8}} 0} {bgf_two_anon_member1 4 4 {{a std::ffi::c::Char 0} {b std::ffi::c::Int 0}} 1} {bgf_two_anon_member2 8 8 {{c std::ffi::c::Short 0} {d std::ffi::c::LongLong 0}} 1}} {{{struct bgf_overlapped} pointer member3.pointer 16 8} {{struct bgf_overlapped} offset member3.member1.offset 16 4} {{struct bgf_overlapped} offset_high member3.member1.offset_high 20 4} {{struct bgf_deep} b member2_member2.b 8 4} {{struct bgf_deep} c member2_member2.c 8 3} {{struct bgf_deep} w member3.w 12 4} {{struct bgf_deep} x member3.member1.x 12 2} {{struct bgf_deep} y member3.member1.y 14 2} {{struct bgf_deep} z member3.member1.member3.z 16 1} {{struct bgf_deep} zz member3.member1.member3.zz 16 2}}}

test cb-layout-union-blockers {a union is blocked only by what an alternative cannot represent, and that root reason is what the report and the pressure analysis see -- never "union" or "anonymous-overlay": a long double (bgf_num; a union of a C float and a C double, bgf_fnum, is a layout), a C _Bool (bgf_flagu), a bitfield record (bgf_bitsu, nested-layout-blocked through its alternative), held by a record (bgf_holds_bitsu), as an array element (bgf_nums2), as an anonymous member (bgf_anon_float, through its synthetic union, beside bgf_anon_fnum's representable one); a representable anonymous union held by a record a bitfield blocks (bgf_bits_overlay) is no layout either: nothing reaches it, nothing C checks verifies it (unheld)} -constraints clang -body {
    set recs [dict get [generation $::fixture linux-x86_64] model layouts]
    set anon [lmap {k r} $recs {expr {[dict exists $r owner] && [dict get $r owner] eq "struct bgf_anon_float" ? $k : [continue]}}]
    set out [lmap key [concat {{union bgf_num} {union bgf_flagu} {union bgf_bitsu} {struct bgf_holds_bitsu} {struct bgf_nums2} {struct bgf_anon_float}} $anon] {
        set r [dict get $recs $key]
        list $key [dict get $r status] [lsort -unique [lmap b [dict get $r direct] {lindex $b 0}]] \
            [lmap b [dict get $r transitive] {lindex $b 1}] [::cbind::records::RootReasons $recs $key]
    }]
    set stale [lmap {k r} $recs {
        set reasons [concat [lmap b [dict get $r direct] {lindex $b 0}] [dict get $r roots]]
        expr {"union" in $reasons || "anonymous-overlay" in $reasons ? $k : [continue]}
    }]
    set unheld [lmap {k r} $recs {expr {[dict exists $r owner] && [dict get $r owner] eq "struct bgf_bits_overlay" ? [list [dict get $r status] [dict get $r unheld] [dict get $r layoutName] [string match "*\nunion layout [dict get $r layoutName]:*" [dict get [generation $::fixture linux-x86_64] files bgf/layouts.bot]]] : [continue]}}]
    list $out $stale [dict get $recs {struct bgf_bits_overlay} status] $unheld
} -result {{{{union bgf_num} layout-blocked long-double {} long-double} {{union bgf_flagu} layout-blocked c-bool {} c-bool} {{union bgf_bitsu} layout-blocked {} {{field bits (struct bgf_bits, union-member) -> bitfield}} bitfield} {{struct bgf_holds_bitsu} layout-blocked {} {{field u (union bgf_bitsu, field) -> struct bgf_bits -> bitfield}} bitfield} {{struct bgf_nums2} layout-blocked {} {{field nums (union bgf_num, array-element) -> long-double}} long-double} {{struct bgf_anon_float} layout-blocked {} {{member2 (union anon@bgf_records.h:281, anonymous-member) -> long-double}} long-double} {{union anon@bgf_records.h:281} layout-blocked long-double {} long-double}} {} layout-blocked {{layout-direct 1 bgf_bits_overlay_member2 0}}}

test cb-layout-union-member-offset {a member is an alternative only where the compiler places it, at the union's start: the generator never assumes offset 0 -- were the compiler's offsetof of bgf_word's halves 2, bgf_word would be blocked (union-member-offset) and everything holding it with it, never moved or approximated} -constraints clang -body {
    rename ::cbind::probe::values ::cbind::probe::values.real
    proc ::cbind::probe::values {args} {
        set out [::cbind::probe::values.real {*}$args]
        if {[dict exists $out {fld:union bgf_word:1}]} {
            lassign [dict get $out {fld:union bgf_word:1}] st data
            dict set out {fld:union bgf_word:1} [list $st [lreplace $data 0 0 2]]
        }
        return $out
    }
    try {
        set recs [dict get [::cbind::generate::run $::fixture linux-x86_64] model layouts]
    } finally {
        rename ::cbind::probe::values {}
        rename ::cbind::probe::values.real ::cbind::probe::values
    }
    list [dict get $recs {union bgf_word} status] [dict get $recs {union bgf_word} direct] \
        [dict get $recs {struct bgf_words3} status] [::cbind::records::RootReasons $recs {struct bgf_words3}]
} -result {layout-blocked {{union-member-offset {field halves: the compiler places this member of a union at offset 2: a union layout's alternatives all begin at its start}}} layout-blocked union-member-offset}

test cb-layout-anonymous-unprobed {an anonymous member's own size, alignment and member offsets are clang's record layout's (no C expression asks them): without it -- a compiler that dumps none -- every anonymous member is blocked (anonymous-record) and its record with it (bgf_overlapped; bgf_large, whose anonymous struct is an alternative), never guessed; a union without one needs no dump (bgf_word)} -constraints clang -body {
    rename ::cbind::probe::anonymous ::cbind::probe::anonymous.real
    proc ::cbind::probe::anonymous {args} { return [list 0 {} "toolchain: a record layout dump needs a clang-family compiler (gcc is gcc)"] }
    try {
        set recs [dict get [::cbind::generate::run $::fixture linux-x86_64] model layouts]
    } finally {
        rename ::cbind::probe::anonymous {}
        rename ::cbind::probe::anonymous.real ::cbind::probe::anonymous
    }
    set anon [lmap {k r} $recs {expr {[dict exists $r owner] && [dict get $r owner] eq "struct bgf_overlapped" ? $k : [continue]}}]
    list [lsort -unique [lmap k $anon {dict get $recs $k status}]] [lsort -unique [concat {*}[lmap k $anon {lmap b [dict get $recs $k direct] {lindex $b 0}}]]] \
        [dict get $recs {struct bgf_overlapped} status] [::cbind::records::RootReasons $recs {struct bgf_overlapped}] \
        [dict get $recs {union bgf_word} status] [dict get $recs {union bgf_large} status]
} -result {layout-blocked anonymous-record layout-blocked anonymous-record layout-direct layout-blocked}

test cb-layout-union-verified {layouts-check.c holds every union layout to the compiler: its size and alignment, every alternative -- the last and the smallest as much as the first -- by offset, width, extent and class; a synthetic layout's members through the record holding it, at the offset the generated text gives them there; and a synthetic layout's own size and alignment, which no C expression asks, are compared with clang's record layouts after generation (verify.tcl's anonymous)} -constraints clang -body {
    set files [dict get [generation $::fixture linux-x86_64] files]
    set undefs [dict get [generation $::fixture linux-x86_64] model layoutUndefs]
    set config [::chdr::toolchain::configFor linux-x86_64]
    set tool [::cbind::generate::ToolProfile [::cbind::profile::headersFor $::fixture linux-x86_64] $::fixtureDir]
    set clean [list [lindex [::chdr::toolchain::compile $config $tool [dict get $files layouts-check.c] {-w}] 0] \
        [::cbind::verify::anonymous $files bgf $config $tool]]
    set caught {}
    foreach {old new} {
        "union layout bgf_tail_u:\n    size 8" "union layout bgf_tail_u:\n    size 5"
        "union layout bgf_aligned_u:\n    size 16\n    align 16" "union layout bgf_aligned_u:\n    size 16\n    align 8"
        "    alternative i: std::ffi::c::Int              # int i\n\n# union bgf_aligned_u" "    alternative i: std::ffi::c::Short            # int i\n\n# union bgf_aligned_u"
        "    alternative bytes: array 4 of std::ffi::c::UChar    # uint8_t bytes\[4\]" "    alternative bytes: array 3 of std::ffi::c::UChar    # uint8_t bytes\[4\]"
        "    field offset_high: std::ffi::c::UInt at 4" "    field offset_high: std::ffi::c::UInt at 8"
        "    field member3: bgf_overlapped_member3_union at 16" "    field member3: bgf_overlapped_member3_union at 8"
    } {
        set text [dict get $files bgf/layouts.bot]
        if {[string first $old $text] < 0} { lappend caught "no such text: $old"; continue }
        set bad [dict replace $files bgf/layouts.bot [string map [list $old $new] $text]]
        set check [::cbind::verify::source $bad $::fixture linux-x86_64 $undefs]
        lassign [::chdr::toolchain::compile $config $tool $check {-w}] good stderr
        lappend caught [expr {$good ? "missed" : [lindex [regexp -inline {static assertion failed[^"]*"([^"]*)"} $stderr] 1]}]
    }
    # The synthetic sizes C cannot name: the text against clang.
    set anonymous {}
    foreach {old new} {
        "union layout bgf_anon_tail_member2:\n    size 8" "union layout bgf_anon_tail_member2:\n    size 5"
        "union layout bgf_deep_member3:\n    size 8\n    align 4" "union layout bgf_deep_member3:\n    size 8\n    align 2"
    } {
        set bad [dict replace $files bgf/layouts.bot [string map [list $old $new] [dict get $files bgf/layouts.bot]]]
        set check [::cbind::verify::source $bad $::fixture linux-x86_64 $undefs]
        lappend anonymous [lindex [::chdr::toolchain::compile $config $tool $check {-w}] 0] \
            [::cbind::verify::anonymous [dict replace $bad layouts-check.c $check] bgf $config $tool]
    }
    list $clean $caught $anonymous
} -result {{1 {}} {bgf_tail_u bgf_aligned_u bgf_tail_u.i bgf_word.bytes bgf_overlapped_member3_member1.offset_high bgf_overlapped_member3_member1.offset} {1 {{bgf_anon_tail_member2: size 5, align 4; clang's record layout of the anonymous member at bgf_records.h:269:40: sizeof 8, align 4}} 1 {{bgf_deep_member3: size 8, align 2; clang's record layout of the anonymous member at bgf_records.h:260:5: sizeof 8, align 4}}}}

test cb-layout-union-program {a generated union layout is an ordinary one: a program writes bgf_large's two 32-bit halves through its anonymous struct and reads its 64-bit quad and its named struct's high half from the same bytes, writes bgf_overlapped's offset_high through its anonymous union and struct and reads it back, writes one interpretation of an element of an array of unions (bgf_words3) and reads two others, and reaches bgf_deep's deepest anonymous level through overlapping alternatives -- on all four backends} -constraints {clang fixtureHostBinding} -body {
    set dir [scratch]
    ::cbind::generate::stage $::fixture $::hostTarget "" $dir [generatedDir $::fixture $::hostTarget]
    writeText [file join $dir main.bot] [join {
        "import std::abi"
        "import std::abi::bytes"
        "import std::binary"
        "import bgf::layouts"
        ""
        "fn run() -> List\[int\] errors LayoutLengthMismatch:"
        "    l0 = std::abi::bytes::zeroed(std::abi::usize(std::binary::layout_length(bgf::layouts::bgf_large)))"
        "    l1 = std::binary::write(l0, bgf::layouts::bgf_large.member1.low, 1)"
        "    l2 = std::binary::write(l1, bgf::layouts::bgf_large.member1.high, -2)"
        "    lb = std::abi::bytes::freeze(l2)"
        "    o0 = std::abi::bytes::zeroed(std::abi::usize(std::binary::layout_length(bgf::layouts::bgf_overlapped)))"
        "    o1 = std::binary::write(o0, bgf::layouts::bgf_overlapped.member3.member1.offset_high, 7)"
        "    ob = std::abi::bytes::freeze(o1)"
        "    w0 = std::abi::bytes::zeroed(std::abi::usize(std::binary::layout_length(bgf::layouts::bgf_words3)))"
        "    w1 = std::binary::write(w0, bgf::layouts::bgf_words3.words\[1\].whole, 16909060)"
        "    wb = std::abi::bytes::freeze(w1)"
        "    d0 = std::abi::bytes::zeroed(std::abi::usize(std::binary::layout_length(bgf::layouts::bgf_deep)))"
        "    d1 = std::binary::write(d0, bgf::layouts::bgf_deep.member3.w.whole, 196610)"
        "    d2 = std::binary::write(d1, bgf::layouts::bgf_deep.member3.member1.member3.zz, 513)"
        "    db = std::abi::bytes::freeze(d2)"
        "    \[std::binary::read(lb, bgf::layouts::bgf_large.quad), std::binary::read(lb, bgf::layouts::bgf_large.u.high), std::binary::read(ob, bgf::layouts::bgf_overlapped.member3.member1.offset_high), std::binary::read(ob, bgf::layouts::bgf_overlapped.member3.member1.offset), std::binary::read(wb, bgf::layouts::bgf_words3.words\[1\].bytes\[0\]), std::binary::read(wb, bgf::layouts::bgf_words3.words\[1\].halves\[1\]), std::binary::read(wb, bgf::layouts::bgf_words3.words\[2\].whole), std::binary::read(db, bgf::layouts::bgf_deep.member3.member1.x), std::binary::read(db, bgf::layouts::bgf_deep.member3.member1.y), std::binary::read(db, bgf::layouts::bgf_deep.member3.member1.member3.z)\]"
        ""
        "r = run():"
        "    on LayoutLengthMismatch:"
        "        \[\]"
        "r"
        ""
    } \n]
    set hir [stagedHir $dir main.bot]
    lsort -unique [lmap backend [backendsFor $::hostTarget] {lindex [outcomeUnderHir $backend $hir] 1}]
} -cleanup removeScratch -result {{[-8589934591, -2, 7, 0, 4, 258, 0, 2, 3, 1]}}

test cb-policy-libraries {a library rule names its libraries by header or by symbol, never both; a symbol rule applies to every header; a library the target toolchain has no file for is the profile's error} -constraints clang -body {
    set out {}
    foreach rule {{names {bgf} symbols {bgf}} {headers * symbols {bgf}}} {
        catch {fixtureWith [dict create libraries [list $rule]]} message
        lappend out $message
    }
    catch {::cbind::generate::run [fixtureWith [dict create libraries {{symbols {botlish_no_such_library}}}]] linux-x86_64} message
    lappend out $message
} -result {{c-bindgen: profile bgf: a library rule names its libraries by header (names) or by symbol (symbols), one of the two} {c-bindgen: profile bgf: a symbol library rule applies to every header (no headers key)} {c-bindgen: the linux-x86_64 toolchain has no library file for -lbotlish_no_such_library (its -print-file-name=libbotlish_no_such_library.a): install the target's import libraries}}

# ---------------------------------------------------------------------------
# The acceptance corpora

test cb-tcl-current {the committed Tcl bindings of this host's target (direct-link profile and stubs profile) are what generation produces} -constraints {tclSources linuxNative} -body {
    set pairs [committedPairs {tcl tclstubs} 1]
    list [expr {[llength $pairs] > 0}] [staleBindings $pairs]
} -result {1 {}}

test cb-tcl-current-cross {the committed Tcl bindings of the other Linux target are what generation produces there, from that target's own C library headers} -constraints {tclSources crossLinux} -body {
    set pairs [committedPairs {tcl tclstubs} 0]
    list [expr {[llength $pairs] > 0}] [staleBindings $pairs]
} -result {1 {}}

test cb-tcl-inventory {the Tcl inventory is the header archaeology's (tcl-embed): 753 declared functions and 1 static inline; with the direct-link profile no API name is a stub-table redirection, with USE_TCL_STUBS (the archaeology's tcl-stubs) every redirected name is a thunk through the table and none is a direct symbol} -constraints {tclSources stubsTarget linuxNative} -body {
    set tcl [::cbind::report::counts [dict get [generation [::cbind::profile::load tcl] $::linuxHost] model]]
    set stubs [dict get [generation [::cbind::profile::load tclstubs] linux-x86_64] model]
    set direct {}
    foreach e [dict get $stubs apis] {
        if {[dict get $e kind] eq "direct" && [string match Tcl_* [dict get $e name]] && [dict get $e name] ni {Tcl_PkgInitStubsCheck Tcl_MacOSXOpenVersionedBundleResources Tcl_MacOSXNotifierAddRunLoopMode}} {
            lappend direct [dict get $e name]
        }
    }
    set s [::cbind::report::counts $stubs]
    list [dict get $tcl declared] [dict get $tcl inline] [dict get $tcl tablestubs] [dict get $s tablestubs] $direct
} -result {753 1 0 694 {}}

test cb-tcl-oracle {the generated Tcl declarations of the acceptance functions have the hand-written binding's ABI: the same link symbols, ABI classes and contracts (examples/ffi/tcl/tcl.bot, read as an oracle only; its pointee is named Interp, the generated one Tcl_Interp)} -constraints {tclSources linuxNative} -body {
    set gen [scratch]
    ::cbind::generate::stage [::cbind::profile::load tcl] $::linuxHost "" $gen [generatedDir [::cbind::profile::load tcl] $::linuxHost]
    writeText [file join $gen main.bot] "import tcl::decls\n\n1\n"
    set hand [scratch]
    file copy [file join $::projectRoot examples ffi tcl tcl.bot] [file join $hand tcl.bot]
    writeText [file join $hand main.bot] "import tcl\n\n1\n"
    set g [hir::foreign::declarations [stagedHir $gen main.bot $::linuxHost]]
    set h [hir::foreign::declarations [stagedHir $hand main.bot $::linuxHost off]]
    lmap name {Tcl_CreateInterp Tcl_EvalEx Tcl_DeleteInterp} {
        set a [dict get $g tcl::decls::$name]
        set b [dict get $h tcl::$name]
        list $name [expr {[dict get $a symbol] eq [dict get $b symbol]}] [expr {[dict get $a abi] eq [dict get $b abi]}] \
            [expr {[string map {Tcl_Interp Interp tcl::ctypes:: tcl::} [dict get $a contract]] eq [dict get $b contract]}]
    }
} -cleanup removeScratch -result {{Tcl_CreateInterp 1 1 1} {Tcl_EvalEx 1 1 1} {Tcl_DeleteInterp 1 1 1}}

test cb-tcl-acceptance {the generated Tcl binding runs the Tcl acceptance: create an interpreter, evaluate a valid script (TCL_OK, a generated constant; Tcl prints) and a failing one (through the generated thunk of the Tcl_Eval macro), delete it -- on both native backends} -constraints tclLibrary -body {
    set profile [::cbind::profile::load tcl]
    set dir [staged $profile $::hostTarget [file join $::projectRoot examples ffi bindgen tcl demo.bot]]
    set shim [shimOf $profile $::hostTarget [file join $dir .shim]]
    stagedValues $dir demo.bot {cranelift cranelift-generic} [list $shim]
} -cleanup removeScratch -result {{[true, true, true]} {[true, true, true]}}

test cb-tcl-thunk-behavior {a Tcl macro thunk behaves as the macro: Tcl_Eval through the generated thunk and Tcl_Eval in C give the same statuses} -constraints tclLibrary -body {
    set profile [::cbind::profile::load tcl]
    set dir [staged $profile $::hostTarget ""]
    writeText [file join $dir main.bot] "import std::abi\nimport std::abi::bytes\nimport std::byte\nimport std::list\nimport std::str\nimport tcl::decls\nimport tcl::thunks::decls\n\nfn nul() -> std::byte::Byte:\n    0\n\nfn script(text: str) -> std::abi::bytes::Bytes:\n    std::abi::bytes::from_list(std::str::encode_utf8(text).append(nul()))\n\ni = tcl::decls::Tcl_CreateInterp()\nr = \[i.Tcl_Eval(script(\"set a 1\")), i.Tcl_Eval(script(\"error x\")), i.Tcl_Eval(script(\"return -code break\")), i.Tcl_Eval(script(\"continue\"))\]\ntcl::decls::Tcl_DeleteInterp(i)\nr\n"
    set shim [shimOf $profile $::hostTarget [file join $dir .shim]]
    set botlish [lindex [stagedValues $dir main.bot {cranelift} [list $shim]] 0]
    set c [scratch]/caller.c
    writeText $c {#include <stdio.h>
#include <tcl.h>
int main(void) {
    Tcl_Interp *i = Tcl_CreateInterp();
    printf("[%d, %d, %d, %d]", Tcl_Eval(i, "set a 1"), Tcl_Eval(i, "error x"), Tcl_Eval(i, "return -code break"), Tcl_Eval(i, "continue"));
    Tcl_DeleteInterp(i);
    return 0;
}
}
    list $botlish [cCaller $profile $c -ltcl9.0]
} -cleanup removeScratch -result {{[0, 1, 1, 1]} {[0, 1, 1, 1]}}

test cb-tcl-variadic {a variadic Tcl API through the generated binding (VARIADICS-VERTICAL-SLICE-1.md): Tcl_AppendResult(interp, ..., NULL), a sentinel-terminated list of C strings Tcl owns, called with two and with three of them, appends what C's own calls of the same API append} -constraints tclLibrary -body {
    set profile [::cbind::profile::load tcl]
    set dir [staged $profile $::hostTarget ""]
    writeText [file join $dir main.bot] "direct module\n\nimport std::ffi::c\nimport tcl::decls\n\ni = tcl::decls::Tcl_CreateInterp()\na = tcl::decls::Tcl_NewWideIntObj(123)\nb = tcl::decls::Tcl_NewWideIntObj(45678)\nc = tcl::decls::Tcl_NewWideIntObj(-9)\nnolength = std::ffi::c::null\[std::ffi::c::Long\]()\npa = a.Tcl_GetStringFromObj(nolength)\npb = b.Tcl_GetStringFromObj(nolength)\npc = c.Tcl_GetStringFromObj(nolength)\nend = std::ffi::c::null\[std::ffi::c::Char\]()\ni.Tcl_AppendResult(pa, pb, end)\nr1 = i.Tcl_GetObjResult()\nfirst = r1.Tcl_GetCharLength()\ni.Tcl_AppendResult(pc, pa, pb, end)\nr2 = i.Tcl_GetObjResult()\nsecond = r2.Tcl_GetCharLength()\ntcl::decls::Tcl_DeleteInterp(i)\n\[first, second\]\n"
    set botlish [stagedValues $dir main.bot {cranelift cranelift-generic} {}]
    set c [scratch]/caller.c
    writeText $c {#include <stdio.h>
#include <tcl.h>
int main(void) {
    Tcl_Interp *i = Tcl_CreateInterp();
    const char *a = Tcl_GetString(Tcl_NewWideIntObj(123));
    const char *b = Tcl_GetString(Tcl_NewWideIntObj(45678));
    const char *c = Tcl_GetString(Tcl_NewWideIntObj(-9));
    Tcl_AppendResult(i, a, b, (char *)NULL);
    Tcl_Size first = Tcl_GetCharLength(Tcl_GetObjResult(i));
    Tcl_AppendResult(i, c, a, b, (char *)NULL);
    Tcl_Size second = Tcl_GetCharLength(Tcl_GetObjResult(i));
    printf("[%ld, %ld]", (long)first, (long)second);
    Tcl_DeleteInterp(i);
    return 0;
}
}
    list {*}$botlish [cCaller $profile $c -ltcl9.0]
} -cleanup removeScratch -result {{[8, 18]} {[8, 18]} {[8, 18]}}

