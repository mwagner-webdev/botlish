# c-bindgen.test -- the C binding generator (C-BINDGEN.md): ordinary Botlish
# bindings generated from C headers by tools/c-bindgen.tcl.
#
# The generator is a development tool: these tests run it in this process
# (tools/c-bindgen/lib.tcl) and then treat what it wrote as any application
# module -- compiled by the ordinary front end, lowered and linked by the
# ordinary C FFI. The synthetic fixture (tools/c-bindgen/fixture: a
# freestanding header, its C implementation, a Botlish caller and a C
# caller) needs only clang; the Tcl, BoringSSL, SDL3 and Raven acceptance
# needs their pinned sources (tools/c-bindgen.tcl fetch PROFILE) and
# libraries (the installed libtcl9.0, tests/cffi/boringssl.tcl,
# tests/cffi/sdl3.tcl, tests/cffi/raven.tcl) and is skipped without them.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]
source [file join $::projectRoot native native.tcl]
source [file join $::projectRoot tests cffi boringssl.tcl]
source [file join $::projectRoot tests cffi sdl3.tcl]
source [file join $::projectRoot tests cffi raven.tcl]
source [file join $::projectRoot tools c-bindgen lib.tcl]
source [file join $::projectRoot tools c-bindgen oracle.tcl]

testConstraint clang [expr {[auto_execok clang] ne ""}]
testConstraint nativeBuilt [expr {![catch {native::binary}]}]
testConstraint linuxNative [expr {$::tcl_platform(os) eq "Linux"
    && $::tcl_platform(machine) in {x86_64 amd64 aarch64 arm64}}]
set ::hostTarget [core::cabi::hostTarget]
testConstraint nativeRun [expr {[testConstraint clang] && [testConstraint nativeBuilt]
    && [testConstraint cLinker] && [testConstraint nativeCCalls] && $::hostTarget ne ""}]

set ::fixture [::cbind::profile::load fixture]
set ::fixtureDir [file join $::projectRoot tools c-bindgen fixture]
set ::appCounter 0

# 1 if PROFILE's pinned sources are fetched.
proc sourcesFetched {name} {
    set profile [::cbind::profile::load $name]
    return [expr {![catch {::cbind::profile::sourceRoot $profile 0}]}]
}
foreach name {tcl boringssl sdl3 raven} {
    testConstraint ${name}Sources [expr {[testConstraint clang] && [sourcesFetched $name]}]
}
# libtcl9.0 as the C FFI's Tcl acceptance links it.
proc tclLinkable {} {
    if {[auto_execok cc] eq ""} { return 0 }
    set dir [makeDirectory cb-tclprobe-[pid]]
    set src [file join $dir probe.c]
    set channel [open $src w]
    puts $channel "void *Tcl_CreateInterp(void);\nint main(void) { return Tcl_CreateInterp() == 0; }"
    close $channel
    set ok [expr {![catch {exec cc $src -o [file join $dir probe] -ltcl9.0}]}]
    file delete -force $dir
    return $ok
}
testConstraint tclLibrary [expr {[testConstraint nativeRun] && [testConstraint tclSources] && [tclLinkable]}]
testConstraint boringsslLibrary [expr {[testConstraint nativeRun] && [testConstraint boringsslSources] && [cffi::boringsslDir] ne ""}]
testConstraint sdl3Library [expr {[testConstraint nativeRun] && [testConstraint sdl3Sources] && [cffi::sdl3Dir] ne ""}]
# The SDL3 programs run headless (SDL's dummy video driver) and find the
# shared libSDL3.so by LD_LIBRARY_PATH (Botlish adds no rpath). Both are set
# before the native driver process starts: the linked programs it runs
# inherit its environment.
if {[testConstraint sdl3Library]} {
    set ::env(SDL_VIDEO_DRIVER) dummy
    set ::env(LD_LIBRARY_PATH) [join [concat [list [cffi::sdl3Dir]] [expr {[info exists ::env(LD_LIBRARY_PATH)] ? [list $::env(LD_LIBRARY_PATH)] : {}}]] :]
}
# Raven's acceptance runs on its null renderer and finds the shared
# libraven.so (the headless build of tests/cffi/raven.tcl) the same way.
testConstraint ravenLibrary [expr {[testConstraint nativeRun] && [testConstraint ravenSources] && [cffi::ravenDir] ne ""}]
if {[testConstraint ravenLibrary]} {
    set ::env(LD_LIBRARY_PATH) [join [concat [list [cffi::ravenDir]] [expr {[info exists ::env(LD_LIBRARY_PATH)] ? [list $::env(LD_LIBRARY_PATH)] : {}}]] :]
}

# What the fixture's demo (and its C caller) computes on the host: its last
# value is (char)200, -56 where plain char is signed.
set ::demoValues "\[5, 5, 95, 2, 66, 12345, 10, 3, true, true, 6, 10, 14, 14, 42, 49, 42, 30, 101, 3, 18446744073709551615, -1, -42, 120, 6, 6, false, true, true, false, 2, 40, [expr {$::hostTarget ne "" && [dict get [core::cabi::scalarInfo Char $::hostTarget] signed] ? -56 : 200}], 30, 15\]"

# The host's Linux target when the host is one, else linux-x86_64: the
# target the tests whose expectations hold on every Linux target generate.
set ::linuxHost [expr {$::hostTarget in {linux-x86_64 linux-aarch64} ? $::hostTarget : "linux-x86_64"}]
# The other Linux target, cross from this host.
set ::linuxOther [expr {$::linuxHost eq "linux-x86_64" ? "linux-aarch64" : "linux-x86_64"}]

# 1 if a binding that reads the system headers can be generated for TARGET
# here: the host's own target, or a cross target whose C library headers
# clang searches (the generator refuses one without them,
# ::cbind::generate::CheckCrossHeaders).
proc generatable {target} {
    if {[auto_execok clang] eq ""} { return 0 }
    if {$target eq $::hostTarget} { return 1 }
    if {![string match linux-* $target]} { return 0 }
    set config [::chdr::toolchain::configFor $target]
    lassign [::chdr::toolchain::searchDirs $config [dict create includeDirs {} defines {} undefines {} flags {}]] ok dirs
    return [expr {$ok && [lsearch -glob $dirs *[dict get $config target]*] >= 0}]
}
# The committed bindings of the other Linux target are checked where its
# cross C library is installed (the c-bindgen workflow installs it and
# requires that no test is skipped).
testConstraint crossLinux [expr {[testConstraint linuxNative] && [generatable $::linuxOther]}]
testConstraint stubsTarget [generatable linux-x86_64]
# The fixture is generated, and has a committed binding, for this host's
# target: none for windows-x86_64, MSVC's (the fixture's Windows target is
# windows-x86_64-gnu; an MSVC binding is the Windows SDK milestone's,
# WINDOWS-X86-64-MILESTONE-1.md). A test that generates or compiles the
# fixture for the host's target carries it.
testConstraint fixtureHostBinding [expr {$::hostTarget ne "" && [file isdirectory [file join $::projectRoot tools c-bindgen fixture expected $::hostTarget]]}]

# The files of the committed bindings of PAIRS ({PROFILE TARGET ...}) that
# generation does not reproduce: {PROFILE TARGET PATH STATUS ...}.
proc staleBindings {pairs} {
    set out {}
    foreach {name target} $pairs {
        set profile [::cbind::profile::load $name]
        foreach d [staleFiles [generation $profile $target] [::cbind::profile::outputDir $profile $target] $name] {
            lappend out $name $target {*}$d
        }
    }
    return $out
}

# The committed {PROFILE TARGET} pairs of PROFILES whose target is (HOST 1)
# or is not (HOST 0) this host's.
proc committedPairs {profiles host} {
    set out {}
    foreach name $profiles {
        set profile [::cbind::profile::load $name]
        foreach target [dict get $profile targets] {
            if {![file isdirectory [::cbind::profile::outputDir $profile $target]]} continue
            if {($target eq $::hostTarget) == $host} { lappend out $name $target }
        }
    }
    return $out
}

# A fresh directory of the tcltest temporary directory.
proc scratch {} {
    return [makeDirectory cb-scratch-[pid]-[incr ::appCounter]]
}

proc removeScratch {} {
    foreach dir [glob -nocomplain -directory [temporaryDirectory] cb-scratch-[pid]-*] {
        file delete -force $dir
    }
}

proc writeText {path text} {
    file mkdir [file dirname $path]
    set channel [open $path w]
    fconfigure $channel -encoding utf-8 -translation lf
    puts -nonewline $channel $text
    close $channel
}

# The fixture's C library libbgf.a for the host, built once.
set ::bgfLib ""
proc bgfLib {} {
    if {$::bgfLib eq ""} {
        set dir [makeDirectory cb-bgf-[pid]]
        set config [::chdr::toolchain::configFor $::hostTarget]
        set tool [dict create includeDirs [list [file join $::fixtureDir include]] defines {} undefines {} flags {}]
        lassign [::chdr::toolchain::object $config $tool [file join $::fixtureDir bgf.c] [file join $dir bgf.o] {-O2 -fPIC}] ok stderr
        if {!$ok} { error "libbgf: $stderr" }
        lassign [::chdr::toolchain::archive $config [list [file join $dir bgf.o]] [file join $dir libbgf.a]] ok stderr
        if {!$ok} { error "libbgf: $stderr" }
        set ::bgfLib $dir
    }
    return $::bgfLib
}

# A generation of PROFILE (a name or a dict) for TARGET, memoized.
set ::generations [dict create]
proc generation {profile target} {
    set key [list $profile $target]
    if {![dict exists $::generations $key]} {
        dict set ::generations $key [::cbind::generate::run $profile $target]
    }
    return [dict get $::generations $key]
}

# The files RESULT generated that differ from DIR's committed ones, but for
# the generating clang's provenance (asRecordedToolchain): byte for byte
# with the clang that generated them, every other byte with another clang
# (the arm64 runners' Ubuntu 24.04 clang, say).
proc staleFiles {result dir ns} {
    return [lmap d [::cbind::generate::compare [asRecordedToolchain [dict get $result files] $dir] $dir $ns] {lrange $d 0 1}]
}

# The value of manifest FIELD (the rest of its line, one Tcl word or more)
# in the manifest text TEXT, or "".
proc manifestField {text field} {
    if {[regexp -line "^$field (.*)\$" $text -> value]} {
        return $value
    }
    return ""
}

# The provenance a generation records of the clang that made it, beyond the
# target it was asked for: its version string and the count of tokens its
# preprocessing produced (clang's own builtin headers -- stdint.h, stddef.h
# -- are part of a freestanding translation unit, and differ by version).
# Nothing in the bindings, the shim, the reports or the layouts depends on
# them.
proc toolchainProvenance {manifest} {
    return [list [lindex [manifestField $manifest toolchain_version] 0] [manifestField $manifest preprocessed_tokens]]
}

# FILES (a generation's) with the generating clang's provenance replaced by
# what DIR's committed manifest records, when the two differ and the
# generation's toolchain is otherwise the recorded one (the same family and
# target): its version string wherever it is written (the manifest's
# toolchain_version, evidence and layout_abi lines, the header of
# layouts.tsv), the manifest's preprocessed_tokens, and the manifest's
# checksum of every file that held the version. With the recorded clang it
# returns FILES unchanged, so its comparison stays byte for byte; with
# another (Apple clang on macOS, another Ubuntu clang), every other byte of
# every file is still compared (cb-fixture-current), and the provenance it
# replaced is reported (cb-fixture-current-provenance).
proc asRecordedToolchain {files dir} {
    set committedPath [file join $dir manifest.txt]
    if {![file exists $committedPath] || ![dict exists $files manifest.txt]} {
        return $files
    }
    set committed [::chdr::readFile $committedPath]
    set generated [dict get $files manifest.txt]
    lassign [toolchainProvenance $committed] recordedVersion recordedTokens
    lassign [toolchainProvenance $generated] version tokens
    foreach field {toolchain_family toolchain_target} {
        if {[manifestField $committed $field] ne [manifestField $generated $field]} {
            return $files
        }
    }
    if {$version eq $recordedVersion || $version eq "" || $recordedVersion eq ""} {
        return $files
    }
    dict for {path text} $files {
        dict set files $path [string map [list $version $recordedVersion] $text]
    }
    set lines {}
    foreach line [split [dict get $files manifest.txt] \n] {
        if {[regexp {^file (\S+) (\d+) [0-9a-f]+$} $line -> path count] && [dict exists $files $path]
                && [string first $recordedVersion [dict get $files $path]] >= 0} {
            set line "file $path $count [::chdr::crc32 [dict get $files $path]]"
        } elseif {[string match "preprocessed_tokens *" $line]} {
            set line "preprocessed_tokens $recordedTokens"
        }
        lappend lines $line
    }
    dict set files manifest.txt [join $lines \n]
    return $files
}

# The directory holding PROFILE/TARGET's generation (`generation`) as files,
# written once. The tests that compile, link and run a binding use it, not
# the committed one, so that they test the generator; the *-current tests
# check that the committed binding is the generation, byte for byte.
set ::generatedDirs [dict create]
proc generatedDir {profile target} {
    set key [list $profile $target]
    if {![dict exists $::generatedDirs $key]} {
        set dir [makeDirectory cb-generated-[pid]-[dict size $::generatedDirs]]
        ::cbind::generate::write [dict get [generation $profile $target] files] $dir [dict get $profile name]
        dict set ::generatedDirs $key $dir
    }
    return [dict get $::generatedDirs $key]
}

# An application root holding PROGRAM's directory and PROFILE/TARGET's
# generated binding: its directory.
proc staged {profile target program} {
    set dir [scratch]
    ::cbind::generate::stage $profile $target $program $dir [generatedDir $profile $target]
    return $dir
}

# The shim library of PROFILE/TARGET's generated binding, built in OUT.
proc shimOf {profile target out} {
    return [::cbind::generate::buildShim $profile $target $out [generatedDir $profile $target]]
}

# The HIR of DIR/MAIN for TARGET.
proc stagedHir {dir main {target ""} {warnings error}} {
    set options [list -warnings $warnings -cache ""]
    if {$target ne ""} { lappend options -target $target }
    return [surface::readProgramFile [file join $dir $main] {*}$options]
}

# The value of DIR/MAIN on each of BACKENDS, linked with LINKDIRS: a list of
# values, or {CODE MESSAGE} for a failure.
proc stagedValues {dir main backends linkDirs} {
    set hir [stagedHir $dir $main]
    native::withLinkDirs $linkDirs {
        lmap backend $backends {
            lassign [outcomeUnderHir $backend $hir] tag value message
            expr {$tag eq "value" ? $value : [list [lrange $value end-1 end] $message]}
        }
    }
}

# The output of a C caller CALLER (a source file) of PROFILE's headers on
# the host, linked with LIBS: what it prints.
proc cCaller {profile caller {libs {}} {includes {}}} {
    set dir [scratch]
    set config [::chdr::toolchain::configFor $::hostTarget]
    set sourceRoot [::cbind::profile::sourceRoot $profile 0]
    set h [::cbind::profile::headersFor $profile $::hostTarget]
    set incs [lmap d [dict get $h includeDirs] {file join $sourceRoot $d}]
    set exe [file join $dir caller]
    exec {*}[dict get $config cc] --target=[dict get $config target] -w {*}[lmap d [concat $incs $includes] {string cat -I $d}] \
        {*}[lmap d [dict get $h defines] {string cat -D $d}] $caller {*}$libs -o $exe
    return [string trim [exec $exe]]
}

# The fixture profile with KEY set to VALUE (a dict merged in).
proc fixtureWith {changes} {
    return [::cbind::profile::Validate [dict merge $::fixture $changes]]
}

# ---------------------------------------------------------------------------
# The synthetic fixture: the generator's rules, pinned

test cb-fixture-current {the fixture's committed generated bindings, for every target of its profile, are exactly what generation produces (the check mode, byte for byte: modules, shim, manifest, report) -- with the clang that generated them, and with any other clang of the same family but for its recorded provenance (version string, preprocessed token count), whose every other byte is still compared} -constraints clang -body {
    lmap target [dict get $::fixture targets] {
        set dir [::cbind::profile::outputDir $::fixture $target]
        set files [asRecordedToolchain [dict get [generation $::fixture $target] files] $dir]
        lmap d [::cbind::generate::compare $files $dir bgf] {lrange $d 0 2}
    }
} -result {{} {} {} {}}

test cb-fixture-current-provenance {the generating clang's provenance, as each target's manifest records it and as this host's clang gives it: the same family and target triple everywhere (the toolchain is clang, for the target asked for); the version string and the token count are the clang's own (identical with the clang the commit was generated with)} -constraints clang -body {
    lmap target [dict get $::fixture targets] {
        set committed [::chdr::readFile [file join [::cbind::profile::outputDir $::fixture $target] manifest.txt]]
        set generated [dict get [generation $::fixture $target] files manifest.txt]
        set same [expr {[toolchainProvenance $committed] eq [toolchainProvenance $generated]}]
        if {!$same} {
            puts "cb-fixture-current-provenance: $target generated with [toolchainProvenance $generated], committed with [toolchainProvenance $committed]"
        }
        list $target [manifestField $generated toolchain_family] [expr {[manifestField $generated toolchain_target] eq [manifestField $committed toolchain_target]}]
    }
} -result {{linux-x86_64 clang 1} {linux-aarch64 clang 1} {macos-aarch64 clang 1} {windows-x86_64-gnu clang 1}}

test cb-fixture-deterministic {generation is byte-for-byte deterministic: two runs, another working directory, another time zone and locale give the same files; no time, temporary path or host path is in them} -constraints clang -body {
    set first [dict get [::cbind::generate::run $::fixture linux-x86_64] files]
    set saved [pwd]
    set savedEnv [array get ::env]
    try {
        cd [temporaryDirectory]
        set ::env(TZ) Pacific/Kiritimati
        set ::env(LANG) C
        set second [dict get [::cbind::generate::run $::fixture linux-x86_64] files]
    } finally {
        cd $saved
        array unset ::env
        array set ::env $savedEnv
    }
    set leaks {}
    dict for {path text} $first {
        if {[regexp {/tmp/|/home/|/root/|/usr/|[0-9]{4}-[0-9]{2}-[0-9]{2}} $text]} { lappend leaks $path }
    }
    list [expr {$first eq $second}] [lsort [dict keys $first]] $leaks
} -result {1 {bgf/bgf.bot bgf/ctypes.bot bgf/layouts.bot bgf/records.bot bgf/thunks/bgf.bot bgf/types.bot layouts-check.c layouts.tsv manifest.txt report.tsv report.txt shim.c} {}}

test cb-fixture-mapping {the declaration mapping: integer typedefs resolve to the target's C scalars (no nominal type per typedef), enums to the compiler's integer type, a pointer to an incomplete or complete tag to one opaque identity per C tag (never Ptr[Void]; two tags whose names collide stay two identities), callbacks to FnPtr, arrays and function types of parameters to pointers, C names that are Botlish keywords renamed, unnamed parameters numbered} -constraints clang -body {
    set text [dict get [generation $::fixture linux-x86_64] files bgf/bgf.bot]
    set get {name {
        upvar text text
        regexp "# C: \[^\n\]*\n(extern c fn $name\[ (\]\[^#\]*?)\n\n" $text -> decl
        string map {"\n    " " " "\n) " ") "} [string trim $decl]
    }}
    lmap name {bgf_mix bgf_next_color bgf_window_of bgf_handles bgf_point_sum bgf_walk bgf_set_free bgf_digest bgf_keywords bgf_unnamed bgf_is_even bgf_twins} {
        apply $get $name
    }
} -result {{extern c fn bgf_mix( a: std::ffi::c::UChar, b: std::ffi::c::Short, c: std::ffi::c::UInt, d: std::ffi::c::ULong, e: std::ffi::c::Long, f: std::ffi::c::ULongLong) -> std::ffi::c::UInt} {extern c fn bgf_next_color(c: std::ffi::c::UInt) -> std::ffi::c::UInt} {extern c fn bgf_window_of( handle: std::ffi::c::Ptr[bgf::ctypes::bgf_handle] noescape) -> std::ffi::c::Ptr[bgf::ctypes::bgf_window]} {extern c fn bgf_handles() -> std::ffi::c::Ptr[std::ffi::c::Ptr[bgf::ctypes::bgf_handle]]} {extern c fn bgf_point_sum(point: std::ffi::c::Ptr[bgf::ctypes::bgf_point]) -> std::ffi::c::Int} {extern c fn bgf_walk( handle: std::ffi::c::Ptr[bgf::ctypes::bgf_handle] noescape, visit: std::ffi::c::FnPtr[Fn{args: [std::ffi::c::Ptr[std::ffi::c::Void], std::ffi::c::Ptr[bgf::ctypes::bgf_handle], std::ffi::c::Int], return: std::ffi::c::Int}], userdata: std::ffi::c::Ptr[std::ffi::c::Void]) -> std::ffi::c::Int} {extern c fn bgf_set_free( free_fn: std::ffi::c::FnPtr[Fn{args: [std::ffi::c::Ptr[std::ffi::c::Void]], return: unit}]) -> unit} {extern c fn bgf_digest( data: std::ffi::c::Ptr[std::ffi::c::UChar] read noescape, len: std::ffi::c::ULong, out: std::ffi::c::Ptr[std::ffi::c::UChar] write noescape) -> std::ffi::c::Ptr[std::ffi::c::UChar] alias out} {extern c fn bgf_keywords( fn_: std::ffi::c::Int, type_: std::ffi::c::Int, in: std::ffi::c::Int, loop_: std::ffi::c::Int, str: std::ffi::c::Int) -> std::ffi::c::Int} {extern c fn bgf_unnamed( arg1: std::ffi::c::Int, arg2: std::ffi::c::Ptr[std::ffi::c::Char]) -> std::ffi::c::Int} {extern c fn bgf_is_even(n: std::ffi::c::Int) -> std::ffi::c::Bool} {extern c fn bgf_twins( a: std::ffi::c::Ptr[bgf::ctypes::bgf_twin], b: std::ffi::c::Ptr[bgf::ctypes::bgf_twin_struct]) -> std::ffi::c::Int}}

test cb-fixture-unsupported {every declaration outside the C ABI universe is reported with its precise blocker and never approximated: a long double (C float and double are bound since C-FLOAT-FFI-MILESTONE-1.md), a struct by value, a va_list, a callback with a long double, an explicit calling convention, a typedef an attribute widens to 128 bits, a declaration without prototype, a pointer to long double} -constraints clang -body {
    set rows [::cbind::generate::readTsv [dict get [generation $::fixture linux-x86_64] files report.tsv]]
    lmap name {bgf_long_scale bgf_swap bgf_vprintf bgf_set_measure bgf_ms bgf_wide_set bgf_noproto bgf_long_ptr} {
        lrange [dict get $rows "function $name"] 2 5
    }
} -result {{unsupported {} long-double {parameter 1 (x): long double: its representation is the target's (binary64, x87 extended precision or binary128), and neither the FFI nor Botlish has a type of it; result: long double: its representation is the target's (binary64, x87 extended precision or binary128), and neither the FFI nor Botlish has a type of it}} {unsupported {} by-value-aggregate {parameter 1 (p): struct bgf_pair by value; result: struct bgf_pair by value}} {unsupported {} va-list {parameter 2 (args): __builtin_va_list}} {unsupported {} unsupported-callback-signature {parameter 1 (measure): callback argument 1: long double: its representation is the target's (binary64, x87 extended precision or binary128), and neither the FFI nor Botlish has a type of it (long-double); parameter 1 (measure): callback result: long double: its representation is the target's (binary64, x87 extended precision or binary128), and neither the FFI nor Botlish has a type of it (long-double)}} {unsupported {} unsupported-calling-convention {an explicit calling convention: ms_abi}} {unsupported {} typedef-abi-mismatch {parameter 1 (w): typedef bgf_wide is unsigned long by its declaration, but the compiler gives it no C integer type of the table (16 bytes): an attribute or extension changes it}} {unsupported {} no-prototype {declared without a prototype: ()}} {unsupported {} long-double {parameter 1 (x): a pointer to long double: its representation is the target's (binary64, x87 extended precision or binary128), and neither the FFI nor Botlish has a type of it}}}

test cb-fixture-floats {C float and C double are bound as std::ffi::c::Float and std::ffi::c::Double (C-FLOAT-FFI-MILESTONE-1.md), never Float64 and never one another: parameters and results, a pointer to each, a function pointer of a float signature (a callback typedef), a record pointer, an inline function's thunk, and typedef chains the compiler confirms as the floating type they name; a floating macro constant is reported, not emitted (the generator binds integer constants only)} -constraints clang -body {
    set rows [::cbind::generate::readTsv [dict get [generation $::fixture linux-x86_64] files report.tsv]]
    list {*}[lmap key {{function bgf_scale} {function bgf_scale32} {function bgf_float_out} {function bgf_dot} {function bgf_apply_float} {function bgf_halver} {function bgf_half} {typedef bgf_scalar32} {typedef bgf_real32} {typedef bgf_scalar64} {typedef bgf_float_fn} {macro BGF_HALF}} {
        lrange [dict get $rows $key] 2 5
    }] [lindex [regexp -inline {extern c fn bgf_scale32\([^)]*\) -> [^\n]*} [dict get [generation $::fixture linux-x86_64] files bgf/bgf.bot]] 0]
} -result {{direct bgf::bgf direct {symbol bgf_scale; (std::ffi::c::Double, std::ffi::c::Float) -> std::ffi::c::Double}} {direct bgf::bgf direct {symbol bgf_scale32; (std::ffi::c::Float, std::ffi::c::Double) -> std::ffi::c::Float}} {direct bgf::bgf direct {symbol bgf_float_out; (std::ffi::c::Ptr[std::ffi::c::Float]) -> unit}} {direct bgf::bgf direct {symbol bgf_dot; (std::ffi::c::Ptr[std::ffi::c::Float], std::ffi::c::Ptr[std::ffi::c::Double], std::ffi::c::ULong) -> std::ffi::c::Double}} {direct bgf::bgf direct {symbol bgf_apply_float; (std::ffi::c::FnPtr[Fn{args: [std::ffi::c::Float], return: std::ffi::c::Float}], std::ffi::c::Float) -> std::ffi::c::Float}} {direct bgf::bgf direct {symbol bgf_halver; () -> std::ffi::c::FnPtr[Fn{args: [std::ffi::c::Float], return: std::ffi::c::Float}]}} {thunk bgf::thunks::bgf {thunk (inline)} {symbol botlish_bgf_bgf_half; (std::ffi::c::Double) -> std::ffi::c::Double}} {other {} std::ffi::c::Float float} {other {} std::ffi::c::Float float} {other {} std::ffi::c::Double double} {callback {} {std::ffi::c::FnPtr[Fn{args: [std::ffi::c::Float], return: std::ffi::c::Float}]} {float (*)(float x)}} {unsupported {} floating-constant {a double constant: the generator binds integer constants only}} {extern c fn bgf_scale32(
