    list [expr {$checks > 300}] $a $b [lmap key {{struct cbs_st} {struct ssl_quic_method_st} {struct cbb_st} {struct sha256_state_st} {struct sha_state_st} {struct GENERAL_NAME_st} {struct asn1_type_st} {struct env_md_ctx_st} {struct hmac_ctx_st} {struct evp_aead_ctx_st}} {
        list $key [dict get $recs $key status] [::cbind::records::RootReasons $recs $key]
    }]
} -cleanup removeScratch -result {1 {} {} {{{struct cbs_st} layout-direct {}} {{struct ssl_quic_method_st} layout-direct {}} {{struct cbb_st} layout-blocked bitfield} {{struct sha256_state_st} layout-direct {}} {{struct sha_state_st} layout-direct {}} {{struct GENERAL_NAME_st} layout-direct {}} {{struct asn1_type_st} layout-direct {}} {{struct env_md_ctx_st} layout-direct {}} {{struct hmac_ctx_st} layout-direct {}} {{struct evp_aead_ctx_st} layout-direct {}}}}

test cb-sdl3-layouts {every layout the SDL3 binding emits agrees with C at run time on both native backends (the runtime oracle): SDL_Rect, SDL_Point, SDL_Color, SDL_Surface, SDL_AudioSpec, the SDL_IOStreamInterface table, ...; SDL_FRect, of C floats, is a layout (C-FLOAT-FFI-MILESTONE-1.md); SDL_Event, a union whose alternatives hold Bool fields, waits for those alone (its arrays are layout fields: FIXED-LAYOUT-ARRAYS.md; unions are layouts: LAYOUT-UNIONS.md); SDL_HapticEffect, a union, and SDL_GamepadBinding, with two anonymous unions, are layouts} -constraints {sdl3Sources nativeRun} -body {
    set profile [::cbind::profile::load sdl3]
    set recs [dict get [generation $profile $::hostTarget] model layouts]
    lassign [layoutOracle $profile all] checks a b
    list [expr {$checks > 700}] $a $b [lmap key {{struct SDL_Rect} {struct SDL_Surface} {struct SDL_IOStreamInterface} {struct SDL_FRect} {union SDL_Event} {struct SDL_KeyboardEvent} {union SDL_HapticEffect} {struct SDL_GamepadBinding}} {
        list $key [dict get $recs $key status] [::cbind::records::RootReasons $recs $key]
    }]
} -cleanup removeScratch -result {1 {} {} {{{struct SDL_Rect} layout-direct {}} {{struct SDL_Surface} layout-direct {}} {{struct SDL_IOStreamInterface} layout-direct {}} {{struct SDL_FRect} layout-direct {}} {{union SDL_Event} layout-blocked c-bool} {{struct SDL_KeyboardEvent} layout-blocked c-bool} {{union SDL_HapticEffect} layout-direct {}} {{struct SDL_GamepadBinding} layout-direct {}}}}

test cb-layout-gcc-bindings {GCC agrees with clang on every layout of the Tcl, Tcl stubs, SDL3 and BoringSSL bindings for the host: each committed layouts-check.c compiles with the host's cc, the profile's include directories, defines and flags} -constraints {tclSources sdl3Sources boringsslSources linuxNative} -body {
    lmap p {tcl tclstubs sdl3 boringssl} {
        set profile [::cbind::profile::load $p]
        if {$::hostTarget ni [dict get $profile targets]} continue
        set tool [::cbind::generate::ToolProfile [::cbind::profile::headersFor $profile $::hostTarget] \
            [::cbind::profile::sourceRoot $profile 0 $::hostTarget]]
        set args {}
        foreach d [dict get $tool includeDirs] { lappend args -I$d }
        foreach d [dict get $tool defines] { lappend args -D$d }
        foreach f [dict get $tool flags] { if {$f ne "-nostdlibinc"} { lappend args $f } }
        set dir [scratch]
        set status [catch {exec cc -std=gnu11 -w {*}$args -c [file join [generatedDir $profile $::hostTarget] layouts-check.c] -o [file join $dir check.o] 2>@1} out]
        list $p [expr {$status ? $out : "ok"}]
    }
} -cleanup removeScratch -match glob -result {{tcl ok} * {sdl3 ok} {boringssl ok}}

