# refined.test -- core-IR programs using named type tests, on both backends.
#
# A validator type (core/type.tcl) is a structural, runtime-checked named
# type; its predicate NAME? is a native type test (-tests-type) that refines
# its argument in the true branch, and that compilers may decide from static
# types. The tests use the harness's NonEmpty (tests/helpers.tcl).
#
# Source-level refinement types (`refined type`, proof-producing functions)
# are a different mechanism -- nominal, proven, never tested at run time --
# and are tested in refinement-values.test (REFINEMENT-VALUES.md). This file
# used to test lib/web.tcl's Tcl-registered String refinements (Emailish,
# UriQueryValue), their runtime "evidence" and the uriEscape native; all of
# those are gone.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]

# Static type the compiler inferred for the binding NAME in EXPRS.
proc boundType {exprs name} {
    foreach entry [core::compiler::bindingTypes $exprs] {
        lassign $entry bound type
        if {$bound eq $name} {
            return $type
        }
    }
    return "(not bound)"
}

set nonEmptyProgram {
    {bind x {const str foo}}
    {if {call {ref NonEmpty?} {ref x}}
        {block {} {bind seen {ref x}} {ref seen}}
        {block {} {bind other {ref x}} {const str empty}}}
}

test refined-1 {NonEmpty? program evaluates in the then branch} -body {
    list [run {*}$nonEmptyProgram] [differential $nonEmptyProgram]
} -result {{"foo"} same}

test refined-2 {compiler sees x : NonEmpty in the then branch only} -body {
    list [boundType $nonEmptyProgram seen] [boundType $nonEmptyProgram other] [boundType $nonEmptyProgram x]
} -result {{refined str NonEmpty} str str}

test refined-3 {interpreter records the NonEmpty refinement for the branch} -body {
    set v [runValue {bind x {const str foo}} \
                    {if {call {ref NonEmpty?} {ref x}}
                        {block {} {block {} {ref x}}}
                        {block {} {const unreachable}}}]
    core::refinementsOf [core::blockEnv $v] x
} -result {{refined str NonEmpty}}

test refined-4 {a failing validator takes the else branch} -body {
    set p {{bind x {const str {}}}
           {if {call {ref NonEmpty?} {ref x}} {block {} {const yes}} {block {} {const no}}}}
    list [run {*}$p] [differential $p]
} -result {{"no"} same}

test refined-5 {NonEmpty? requires a string} -body {
    list [differential {{call {ref NonEmpty?} {const 5}}}] \
         [catch {core::eval {call {ref NonEmpty?} {const 5}}} m opts] $m [dict get $opts -errorcode]
} -result {same 1 {NonEmpty?: expected str, got 5} {CORE SEMANTIC TYPE}}

test refined-6 {string transformations discard refinements} -body {
    set p {
        {bind x {const str abc}}
        {if {call {ref NonEmpty?} {ref x}}
            {block {}
                {bind lower {call {ref str::lowercase} {ref x}}}
                {bind joined {call {ref str::concat} {ref x} {const str !}}}
                {call {ref list} {ref lower} {ref joined}}}
            {block {} {const none}}}
    }
    list [run {*}$p] [differential $p] [boundType $p lower] [boundType $p joined]
} -result {{["abc", "abc!"]} same str str}

test refined-13 {a native claiming a named result type must deliver it} -body {
    list [differential {{call {ref test-fake-nonempty} {const str {}}}}] \
         [catch {core::eval {call {ref test-fake-nonempty} {const str {}}}} m opts] $m \
         [dict get $opts -errorcode]
} -result {same 1 {test-fake-nonempty result: contract violation: expected str[NonEmpty], got ""} {CORE CONTRACT TYPE}}

test refined-14 {a native must enforce its declared parameter types} -body {
    list [differential {{call {ref test-lax-param} {const str {}}}}] \
         [catch {core::eval {call {ref test-lax-param} {const str {}}}} m opts] $m \
         [dict get $opts -errorcode]
} -result {same 1 {test-lax-param argument 0: contract violation: expected str[NonEmpty], got ""} {CORE CONTRACT TYPE}}

test refined-15 {refinement from a flow fact: a refined parameter proves its argument} -body {
    set p {
        {bind f {block {s} {call {ref test-lax-param} {ref s}} {bind after {ref s}} {ref after}}}
        {call {ref f} {const str abc}}
    }
    list [run {*}$p] [differential $p] [boundType $p after]
} -result {{"abc"} same {refined str NonEmpty}}

test refined-library-1 {lib/ has no Tcl-registered library left} -body {
    # The optional Tcl library mechanism (core::loadLibrary, `# requires:`)
    # remains, but its only library, lib/web.tcl, was replaced by source
    # declarations in lib/web.bot (REFINEMENT-VALUES.md).
    list [glob -nocomplain -directory [file join $::projectRoot lib] *.tcl] \
         [catch {core::loadLibrary web} m] $m
} -match glob -result {{} 1 {core::loadLibrary: no library "web" in *}}

# ---------------------------------------------------------------------------
# Type tests (-tests-type)

set typeTestCases {
    param-kind-error-not-folded {
        {call {ref NonEmpty?} {const 5}}
    }
    param-kind-error-through-unknown-type {
        {bind f {block {v} {call {ref NonEmpty?} {ref v}}}}
        {call {ref list} {call {ref f} {const str a}} {call {ref f} {const 5}}}
    }
    plain-string-is-not-proven {
        {call {ref list} {call {ref NonEmpty?} {const str {}}} {call {ref NonEmpty?} {const str a}}}
    }
    refinement-decides-nested-test {
        {bind f {block {s}
            {if {call {ref NonEmpty?} {ref s}}
                {block {} {call {ref list} {call {ref NonEmpty?} {ref s}} {call {ref string?} {ref s}}}}
                {block {} {call {ref list} {call {ref NonEmpty?} {ref s}}}}}}}
        {call {ref list} {call {ref f} {const str a}} {call {ref f} {const str {}}}}
    }
    result-tag-tests {
        {bind r {ok {const 1}}}
        {call {ref list} {call {ref ok?} {ref r}} {call {ref error?} {ref r}} {call {ref ok?} {const 1}}
                         {call {ref error?} {error-value {const x}}}}
    }
    kind-tests-on-unknown {
        {bind f {block {v} {call {ref list} {call {ref integer?} {ref v}} {call {ref string?} {ref v}} {call {ref list?} {ref v}}}}}
        {call {ref list} {call {ref f} {const 1}} {call {ref f} {const a}} {call {ref f} {call {ref list}}}}
    }
}

foreach {name exprs} $typeTestCases {
    test refined-type-test-$name "backends agree: $name" -body {
        differential $exprs
    } -result same
}

test refined-type-test-fold-2 {a test proven by an enclosing refinement is not repeated} -body {
    set code [core::compiler::generatedCode {
        {bind f {block {s}
            {if {call {ref NonEmpty?} {ref s}}
                {block {} {if {call {ref NonEmpty?} {ref s}} {block {} {const yes}} {block {} {const no}}}}
                {block {} {const no}}}}}
        {call {ref f} {const str a}}
    }]
    list [regexp -all {acceptsCanonical} $code] [regexp {str no\}\s*\n\s*\} else} $code]
} -result {1 0}

test refined-type-test-fold-3 {an undecided test is inline, not a native call} -body {
    set code [core::compiler::generatedCode {
        {bind f {block {s} {call {ref NonEmpty?} {ref s}}}}
        {call {ref f} {const str a}}
    }]
    list [regexp {callValue} $code] [regexp {core::value::expect str \$v[0-9]+ NonEmpty\?} $code] \
         [regexp {acceptsCanonical \{refined str NonEmpty\}} $code]
} -result {0 1 1}

test refined-type-test-register-1 {type test registration rules} -body {
    set impl {apply {{v} {core::value::true}}}
    lmap options [list \
        [list -arity 2 -tests-type int] \
        [list -arity 1 -param-types NonEmpty -tests-type NonEmpty] \
        [list -arity 1 -param-types int -tests-type NonEmpty] \
        [list -arity 1 -result-type int -tests-type int] \
    ] {
        list [catch {core::registerNative test-bad-type-test -impl $impl {*}$options} message] \
             [string match {core::native::register: *} $message]
    }
} -result [lrepeat 4 {1 1}]

test refined-type-test-register-2 {a type test gets bool result and its refinement} -body {
    set meta [core::native::metadata NonEmpty?]
    list [dict get $meta resultType] [dict get $meta paramTypes] [dict get $meta testsType] \
         [dict get $meta refinesTrue] [dict get [core::native::metadata integer?] testsType]
} -result {bool str {refined str NonEmpty} {0 {refined str NonEmpty}} int}

test refined-type-test-contract {the reference runtime verifies a type test's answers} -setup {
    if {"test-lying-int?" ni [core::native::names]} {
        core::registerNative test-lying-int? -arity 1 \
            -impl {apply {{v} {core::value::true}}} -tests-type int
    }
} -body {
    # Compiled code trusts the declaration (it never calls the implementation
    # when the type decides the test); the interpreter catches the lie.
    list [outcomeUnder interp {{call {ref test-lying-int?} {const str a}}}] \
         [outcomeUnder compile {{call {ref test-lying-int?} {const str a}}}]
} -result {{error {CORE CONTRACT TYPE} {test-lying-int?: contract violation: as a test of int it must return false for "a", returned true} {}} {value false {}}}

test refined-16 {substring range errors} -body {
    differential {{call {ref str::substring} {const str abc} {const 2} {const 5}}}
} -result same

cleanupTests
