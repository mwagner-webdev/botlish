test ns-get-values {std::list::get and std::mutable_array::get: the element when present, the default for every missing index} -body {
    agree {import std::list
import std::mutable_array
a = std::mutable_array::from_list(["x", "y"])
[std::list::get([10, 20, 30], 1, 0), std::list::get([10, 20, 30], 3, 0), std::list::get([10, 20, 30], -1, 0), std::list::get([], 0, "none"), std::list::get([1], 100000000000000000000, 7), std::mutable_array::get(a, 1, ""), std::mutable_array::get(a, 2, "?")]}
} -result {[20, 0, 0, "none", 7, "y", "?"]}

test ns-get-is-ordinary-botlish {std::list::get and std::mutable_array::get are library functions (no native, no special op): their bodies are an at call handled by an `on IndexNotFound` clause} -body {
    set hir [nsHir {import std::list
import std::mutable_array
[std::list::get([1], 0, 2), std::mutable_array::get(std::mutable_array::allocate(1), 0, 3)]}]
    set handles [lmap e [hir::walk $hir] {
        if {[hir::kind $hir $e] ne "handle"} continue
        list [targetOf $hir [hir::get $hir $e call]] [hir::get $hir $e handlerNames]
    }]
    list [core::native::isQualifiedNative std::list::get] [core::native::isQualifiedNative std::mutable_array::get] \
        [lindex [targetOf $hir [callNamed $hir std::list::get]] 0] [lsort $handles]
} -result {0 0 block {{{native std::list::at} IndexNotFound} {{native std::mutable_array::at} IndexNotFound}}}

