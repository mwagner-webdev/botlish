# ---------------------------------------------------------------------------
# Slices: std::str::substring, std::mutable_array::freeze, std::mutable_array::copy
# (core::native::checkSlice): START against 0..N first, then END against
# START..N; below its interval is LowerUnderrun, above it UpperOverrun.

set ::sliceFns {import std::mutable_array
import std::str
fn slice_of(s, a, b):
    v = std::str::substring(s, a, b):
        on LowerUnderrun:
            return "lower"
        on UpperOverrun:
            return "upper"
    v
fn freeze_of(xs, n):
    a = std::mutable_array::from_list(xs)
    v = std::mutable_array::freeze(a, n):
        on LowerUnderrun:
            return "lower"
        on UpperOverrun:
            return "upper"
    v
fn copy_within(xs, ds, ss, n):
    a = std::mutable_array::from_list(xs)
    done = std::mutable_array::copy(a, ds, a, ss, n):
        on LowerUnderrun:
            return "lower"
        on UpperOverrun:
            return "upper"
    std::mutable_array::freeze(a, std::mutable_array::capacity(a))
}

test ns-slice-rule-substring {every bound case of a substring of "abc", including BigInts and the check order, on every backend} -body {
    agree "$::sliceFns\[slice_of(\"abc\", -1, 2), slice_of(\"abc\", 4, 4), slice_of(\"abc\", 2, 1), slice_of(\"abc\", 1, 4), slice_of(\"abc\", -1, 9), slice_of(\"abc\", 4, 1), slice_of(\"abc\", 3, 3), slice_of(\"abc\", 0, 3), slice_of(\"abc\", 1, 100000000000000000000), slice_of(\"abc\", -100000000000000000000, 1), slice_of(\"ä😀b\", 1, 2)\]"
} -result {["lower", "upper", "lower", "upper", "lower", "upper", "", "abc", "upper", "lower", "😀"]}

test ns-slice-rule-freeze-and-copy {freeze is the slice 0..COUNT; copy checks its destination slice, then its source slice (memmove within one array)} -body {
    agree "$::sliceFns\[freeze_of(\[1, 2\], -1), freeze_of(\[1, 2\], 3), freeze_of(\[1, 2\], 1), copy_within(\[1, 2, 3\], -1, 9, 1), copy_within(\[1, 2, 3\], 0, 9, 1), copy_within(\[1, 2, 3\], 0, 0, -1), copy_within(\[1, 2, 3\], 1, 0, 3), copy_within(\[1, 2, 3\], 0, 2, 2), copy_within(\[1, 2, 3\], 1, 0, 2)\]"
} -result {["lower", "upper", [1], "lower", "upper", "lower", "upper", "upper", [1, 1, 2]]}

