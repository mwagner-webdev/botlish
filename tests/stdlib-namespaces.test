test ns-get-default-is-eager {the default is an ordinary argument: evaluated before the call, present index or not} -body {
    agree {import std::list
import std::mutable_array
import std::str
context struct Log:
    marks: MutableArray[int]
fn marks(context log: Log):
    std::mutable_array::get(log.marks, 0, -1)
fn mark(v, context log: Log):
    std::mutable_array::set(log.marks, 0, marks() + 1):
        on IndexNotFound:
            unit
    v
with context Log {marks: std::mutable_array::create(1, 0)}
a = std::list::get([10, 20], 0, mark(-1))
b = std::list::get([10, 20], 5, mark(-2))
c = std::mutable_array::get(std::mutable_array::create(1, 7), 0, mark(-3))
[a, b, c, marks()]}
} -result {[10, -2, 7, 3]}

# get against the explicit handling it is defined as: same value on every
# backend for every container/index pair, including missing indices.
set ::explicitGet {import std::list
import std::mutable_array
fn explicit(xs, i, d):
    v = std::list::at(xs, i):
        on IndexNotFound:
            d
    v
fn explicit_array(a, i, d):
    v = std::mutable_array::at(a, i):
        on IndexNotFound:
            d
    v
}

test ns-get-differential {std::list::get(xs, i, d) == explicit at-with-handler, and std::mutable_array::get likewise, for every pair (every backend)} -body {
    set cases {}
    foreach xs {{[]} {[7]} {[1, 2, 3]} {["a", "b"]} {[[1], [2, 3]]}} {
        foreach i {-2 -1 0 1 2 3 100000000000000000000} {
            lappend cases "\[std::list::get($xs, $i, \"d\") == explicit($xs, $i, \"d\"), std::list::get($xs, $i, \"d\"), std::mutable_array::get(std::mutable_array::from_list($xs), $i, \"d\") == explicit_array(std::mutable_array::from_list($xs), $i, \"d\")\]"
        }
    }
    set program "$::explicitGet\[[join $cases ",\n"]\]"
    set result [agree $program]
    list [regexp {DISAGREE|false} $result] [regexp -all {\[true, } $result]
} -result {0 35}

test ns-handle-type-in-an-instance {a handled call's type includes a handler the semantic instance cannot admit as the call's own type (an int call, a str handler): no Int equality is ever applied to the String (natively this crashed before STDLIB-NAMESPACES.md; std::list::get is the everyday case)} -body {
    list [agree "error E\nfn f(x, n) errors E:\n    if n < 0:\n        fail E\n    x\nfn explicit(x, n, d):\n    v = f(x, n):\n        on E:\n            d\n    v\nb = explicit(1, 0 - 2, \"dd\")\nc = explicit(1, 0 - 3, \"dd\")\n\[b == c, b, explicit(1, 5, \"dd\")\]"] \
        [agree "import std::list\na = std::list::get(\[7\], -2, \"dd\")\nb = std::list::get(\[7\], -3, \"dd\")\n\[a == b, std::list::get(\[7\], 0, \"dd\") == 7\]"]
} -result {{[true, "dd", 1]} {[true, true]}}

# ---------------------------------------------------------------------------
# Method spelling: once bound to a name, an intrinsic or library member is
# the same callable as its qualified free spelling

# The resolved target of the method call (the call carrying a `method`
# marker) of HIR, and of its first call spelled QUALIFIED: one callable.
proc sameCallable {mh fh qualified} {
    set mcall [lindex [lmap e [hir::walk $mh] {
        if {[hir::kind $mh $e] eq "call" && [dict exists [hir::node $mh $e] method]} {set e} else continue
    }] 0]
    set fcall [callNamed $fh $qualified]
    set mt [targetOf $mh $mcall]
    set ft [targetOf $fh $fcall]
    if {[lindex $mt 0] eq "block"} {
        # A library member: the same module function block.
        return [expr {$mt eq $ft}]
    }
    return [expr {$mt eq $ft && $mt eq [list native $qualified]}]
}

foreach {name qualified imports method free expected} {
    list-at       std::list::at       {import std::list}   {[10, 20, 30].at(1)}         {std::list::at([10, 20, 30], 1)}          {20}
    list-get      std::list::get      {import std::list}   {[10, 20].get(5, 0)}         {std::list::get([10, 20], 5, 0)}          {0}
    list-append   std::list::append   {import std::list}   {[1].append(2)}              {std::list::append([1], 2)}               {[1, 2]}
    list-length   std::list::length   {import std::list}   {[1, 2].length()}            {std::list::length([1, 2])}               {2}
    str-concat    std::str::concat    {import std::str}    {"ab".concat("cd")}          {std::str::concat("ab", "cd")}            {"abcd"}
    str-length    std::str::length    {import std::str}    {"abc".length()}             {std::str::length("abc")}                 {3}
    str-substring std::str::substring {import std::str}    {"hello".substring(1, 3)}    {std::str::substring("hello", 1, 3)}      {"el"}
    set-contains  std::immutable_set::contains {import std::immutable_set} {std::immutable_set::from_list([1]).contains(1)} {std::immutable_set::contains(std::immutable_set::from_list([1]), 1)} {true}
    char-scalar-value std::char::scalar_value {import std::char} {'A'.scalar_value()} {std::char::scalar_value('A')}          {65}
} {
    test ns-method-$name "$name: the method spelling and the qualified free spelling agree, through the same callable (the namespace is imported, nothing is bound)" -body {
        set m "$imports\n$method"
        set f "$imports\n$free"
        list [agree $m] [agree $f] [sameCallable [nsHir $m] [nsHir $f] $qualified]
    } -result [list $expected $expected 1]
}

# An old-style binding of an imported function to a name is still a method
# candidate -- the same function as the imported member, so one candidate.
foreach {name qualified imports binding method free expected} {
    list-at       std::list::at       {import std::list} {at = std::list::at}               {[10, 20, 30].at(1)}   {std::list::at([10, 20, 30], 1)}   {20}
    list-length   std::list::length   {import std::list} {length = std::list::length}       {[1, 2].length()}      {std::list::length([1, 2])}        {2}
    str-concat    std::str::concat    {import std::str}  {concat = std::str::concat}        {"ab".concat("cd")}    {std::str::concat("ab", "cd")}     {"abcd"}
    list-get      std::list::get      {import std::list} {get = std::list::get}             {[10, 20].get(5, 0)}   {std::list::get([10, 20], 5, 0)}   {0}
} {
    test ns-method-alias-$name "$name: an alias of an imported member is the same one candidate as the member itself: method, qualified and aliased spellings agree through the same callable" -body {
        set m "$imports\n$binding\n$method"
        set f "$imports\n$binding\n$free"
        list [agree $m] [agree $f] [sameCallable [nsHir $m] [nsHir $f] $qualified]
    } -result [list $expected $expected 1]
}

test ns-method-mutable-array {std::mutable_array::at/set/get by method spelling: the same reads and writes as the free calls} -body {
    set prelude "import std::mutable_array\na = std::mutable_array::allocate(2)\n"
    list [agree "${prelude}a.set(0, 5)\na.set(1, 6)\n\[a.at(0), a.at(1), a.get(2, -1)\]"] \
        [agree "${prelude}std::mutable_array::set(a, 0, 5)\nstd::mutable_array::set(a, 1, 6)\n\[std::mutable_array::at(a, 0), std::mutable_array::at(a, 1), std::mutable_array::get(a, 2, -1)\]"]
} -result {{[5, 6, -1]} {[5, 6, -1]}}

test ns-method-nir-identical {the method spelling and the qualified spelling of an imported namespace's functions lower to identical NIR} -body {
    set tail "r = f(\[4\]):\n    on IndexNotFound:\n        \[\]\nr"
    set m [dict get [native::lower::program [nsHir "import std::list\nfn f(xs) errors IndexNotFound:\n    \[xs.at(0), xs.get(9, 1)\]\n$tail"]] text]
    set f [dict get [native::lower::program [nsHir "import std::list\nfn f(xs) errors IndexNotFound:\n    \[std::list::at(xs, 0), std::list::get(xs, 9, 1)\]\n$tail"]] text]
    expr {$m eq $f}
} -result 1

test ns-method-alias-nir-identical {a binding of an imported function that stays in the program adds no second candidate: the method spelling lowers to the same NIR as the qualified spelling beside that very binding} -body {
    set tail "r = f(\[4\]):\n    on IndexNotFound:\n        \[\]\nr"
    set m [dict get [native::lower::program [nsHir "import std::list\nat = std::list::at\nget = std::list::get\nfn f(xs) errors IndexNotFound:\n    \[xs.at(0), xs.get(9, 1)\]\n$tail"]] text]
    set q [dict get [native::lower::program [nsHir "import std::list\nat = std::list::at\nget = std::list::get\nfn f(xs) errors IndexNotFound:\n    \[std::list::at(xs, 0), std::list::get(xs, 9, 1)\]\n$tail"]] text]
    expr {$m eq $q}
} -result 1

test ns-method-requires-an-import {a namespace's functions are method candidates only when the file imports that namespace: no import (or the import of another namespace) leaves `.at` unresolved -- the missing import, as a qualified name alone without its import is (DIAGNOSTIC-RECOVERY.md)} -body {
    list [lindex [rejection {[1, 2].at(0)}] 0] \
        [lindex [rejection "import std::str\n\[1, 2\].at(0)"] 0] \
        [rejection "import std::list\n\[1, 2\].at(0)"] \
        [lindex [rejection {std::list::at([1, 2], 0)}] 0]
} -result {MISSING-IMPORT MISSING-IMPORT accepted MISSING-IMPORT}

# ---------------------------------------------------------------------------
# Randomized checking (audit/stdlib-namespaces/tools/fuzz.tcl): a bounded run;
# a longer one is `tclsh9.0 audit/stdlib-namespaces/tools/fuzz.tcl -n 200 -seed 1`.

test ns-fuzz-smoke {random at/get/set/str programs agree with the Tcl oracle on every backend, get equals the explicit handler, the default is evaluated once, and the rotating illegal programs are rejected} -body {
    set output [exec [info nameofexecutable] [file join $::projectRoot audit stdlib-namespaces tools fuzz.tcl] -n 6 -seed 4100 2>@1]
    lindex [split [string trim $output] \n] end
} -match glob -result {stdlib-ns-fuzz programs 6 values * negatives * oracle-disagreements 0 negative-escapes 0 backend-disagreements 0}

cleanupTests
