# stdlib-namespaces.test -- the language/library cleanup of
# STDLIB-NAMESPACES.md:
#
#   * the historical `eq` String-equality native is gone (== is the one
#     equality, Strings included);
#   * standard operations live in their value family's namespace as
#     qualified root natives, below the root std since STD-NAMESPACE.md
#     (std::list::at, std::str::concat, std::mutable_array::set, ...),
#     protected per member from redefinition;
#   * indexed access is `at` (fails with the builtin declared error
#     IndexNotFound) and `get` (ordinary Botlish over `at`, with an explicit,
#     eagerly evaluated default);
#   * method spelling and qualified free spelling resolve to one callable.
#
# Value checks run on every backend (interp, compile, cranelift-generic,
# cranelift) and require them to agree.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]

interp recursionlimit {} 100000

set nsBackends {interp compile cranelift-generic cranelift}

# HIR of SOURCE, read as a program file through the module loader, so
# qualified references to library modules (std::list::get) resolve too.
proc nsHir {source {strict 1}} {
    set path [makeFile $source stdlib-ns-case.bot]
    try {
        return [surface::readProgramFile $path -strict $strict]
    } finally {
        removeFile stdlib-ns-case.bot
    }
}

# Every backend's outcome of the HIR of SOURCE, without the test log.
proc nsOutcomes {source {strict 1}} {
    set hir [nsHir $source $strict]
    return [lmap backend $::nsBackends {lrange [outcomeUnderHir $backend $hir] 0 end-1}]
}

# The value every backend agrees on, "error CODE" if they agree on an error,
# or the disagreement.
proc agree {source {strict 1}} {
    set outcomes [nsOutcomes $source $strict]
    if {[llength [lsort -unique $outcomes]] != 1} {
        return "DISAGREE: [join [lmap b $::nsBackends o $outcomes {list $b $o}] { / }]"
    }
    set outcome [lindex $outcomes 0]
    if {[lindex $outcome 0] eq "value"} {
        return [lindex $outcome 1]
    }
    return [list error [lindex $outcome 1]]
}

# "accepted", or the error code's last word and message of the static
# rejection of SOURCE (compiled strictly).
proc rejection {source} {
    if {[catch {nsHir $source} message options]} {
        return [list [lindex [dict get $options -errorcode] end] $message]
    }
    return accepted
}

# The sorted diagnostic kinds of SOURCE (compiled with -strict 0).
proc diagKinds {source} {
    return [lsort -unique [lmap d [hir::diagnostics [nsHir $source 0]] {dict get $d kind}]]
}

# The first call node of HIR whose callee is spelled NAME (a ref), or "".
proc callNamed {hir name} {
    foreach e [hir::walk $hir] {
        if {[hir::kind $hir $e] eq "call"} {
            set callee [hir::get $hir $e callee]
            if {[hir::kind $hir $callee] eq "ref" && [hir::get $hir $callee name] eq $name} {
                return $e
            }
        }
    }
    return ""
}

# The resolved target of call E as {KIND NAME}: the native's registered name,
# or the binding name of a block's function.
proc targetOf {hir e} {
    lassign [hir::get $hir $e target] kind target
    if {$kind eq "native"} {
        return [list native [dict get [hir::symbol $hir $target] name]]
    }
    return [list $kind $target]
}

# ---------------------------------------------------------------------------
# `eq` is not Botlish any more

test ns-eq-is-gone {no native, root name or intrinsic of any spelling is named eq} -body {
    list [expr {"eq" in [core::native::names]}] [expr {"eq" in [hir::resolve::RootNames]}] \
        [dict exists $native::lower::natives eq] [dict exists $core::compiler::intrinsics eq]
} -result {0 0 0 0}

test ns-eq-call-is-an-unknown-name {eq(a, b) is an ordinary call of an unbound name} -body {
    lindex [rejection {eq("a", "a")}] 0
} -result UNBOUND

test ns-eq-infix-is-a-syntax-error {`a eq b` is not an expression: eq is not an operator (no token, no precedence level)} -body {
    catch {nsHir {"a" eq "a"}} message options
    list [lrange [dict get $options -errorcode] 0 1] [string match {*found name "eq"*} $message]
} -result {{SURFACE SYNTAX} 1}

test ns-string-equality-is-double-equals {String equality is ==: exact characters, never a coercion across kinds} -body {
    agree {["abc" == "abc", "abc" == "abd", "" == "", "10" == 10, "é" == "é"]}
} -result {[true, false, true, false, true]}

# ---------------------------------------------------------------------------
# The root namespace and the qualified intrinsics

# The inventory of a freshly loaded runtime (this process also has the test
# harness's own natives and, once a test loads it, the optional web library).
proc freshNatives {} {
    set script "source [list [file join $::projectRoot core core.tcl]]\nputs \[core::native::names\]"
    return [exec [info nameofexecutable] << $script]
}

test ns-root-inventory {the unqualified root natives are exactly the language primitives (beside the internal operations source cannot spell, whose names contain "#": the two execution-environment context operations, CONTEXTS.md, and the placeholder of code no installed context reaches, CONTEXT-TRAITS.md, the five internal coroutine operations, COROUTINES.md, the drop of an affine aggregate, AFFINE-VALUES.md, the six internal MutableVector operations the compiler writes out, MUTABLE-VECTOR.md, and the six internal MutableArray ones, MUTABLE-ARRAY.md, and the elaborated binary#emit, BINARY-LAYOUT.md, and the elaborated native-view reads binary#load and binary#view_field, NATIVE-LAYOUT-VIEWS.md, and the elaborated live-array operations binary#element, binary#store_element and binary#load_array, FIXED-LAYOUT-ARRAYS.md, and the run-time replay of a refused byte exposure, C-POINTER-BORROWING.md, and the nine Float64 operations an operator on Float64 operands resolves to, FLOAT64-MILESTONE-1.md, and the ten DecimalRounded operations an operator on DecimalRounded operands resolves to with the seven operations their elaboration writes, given the precision each observation reads, DECIMAL-ROUNDED-MILESTONE-1.md, and the elaborated length check list#with_length, LIST-CARDINALITY-REFINEMENTS.md, and the elaborated text decimal_rounded#to_string, NUMERIC-TEXT-BOUNDARY-MILESTONE-1.md, and the transition table of a declared recognizer dfa#transition, DFA-COROUTINE-MILESTONE-2.md)} -body {
    list [lsort [lmap name [freshNatives] {if {[string first :: $name] >= 0 || [string first # $name] >= 0} continue; set name}]] \
        [lsort [lmap name [freshNatives] {if {[string first # $name] < 0} continue; set name}]]
} -result {{* + - / < <= == > >= argv bit_and bit_or bit_xor error? hash integer? list list? mod mutarray? ok? result-error result-value shift_left shift_right string?} {DecimalRounded#* DecimalRounded#+ DecimalRounded#- DecimalRounded#/ DecimalRounded#< DecimalRounded#<= DecimalRounded#== DecimalRounded#> DecimalRounded#>= DecimalRounded#neg Float64#* Float64#+ Float64#- Float64#/ Float64#< Float64#<= Float64#> Float64#>= Float64#neg affine#drop binary#element binary#emit binary#load binary#load_array binary#store_element binary#view_field context#install context#load context#unreachable coroutine#create coroutine#release coroutine#resume coroutine#start coroutine#yield decimal_rounded#equal decimal_rounded#greater decimal_rounded#greater_equal decimal_rounded#less decimal_rounded#less_equal decimal_rounded#round decimal_rounded#to_float64 decimal_rounded#to_string dfa#transition foreign#refused list#with_length mutable_array#consume mutable_array#generate_drop mutable_array#set_drop mutable_array#swap_drop mutable_array#take_front mutable_array#to_list mutable_vector#clear_drop mutable_vector#consume mutable_vector#share mutable_vector#swap_drop mutable_vector#take_front mutable_vector#to_list}}

test ns-qualified-inventory {every standard intrinsic lives in its value family's namespace, below the root std (STD-NAMESPACE.md)} -body {
    lmap ns {std::list std::str std::char std::int std::float64 std::decimal_rounded std::mutable_array std::mutable_vector std::immutable_set std::byte_store std::mutable_byte_store std::linux::abi::x86_64 std::linux::abi::aarch64 std::abi::x86_64 std::abi::aarch64 std::ffi::c} {
        list $ns [core::native::qualifiedMembers $ns]
    }
} -result {{std::list {append at length with_length}} {std::str {append_char char_at concat encode_utf8 is_tcl_alnum is_tcl_alpha length lowercase substring}} {std::char {is_tcl_alnum is_tcl_alpha scalar_value}} {std::int {from_string to_string}} {std::float64 {from_decimal_rounded from_int round truncate}} {std::decimal_rounded {round to_string}} {std::mutable_array {allocate at capacity copy create element freeze from_list generate set swap}} {std::mutable_vector {at clear element empty? from_list length pop push swap take}} {std::immutable_set {contains from_list}} {std::byte_store {byte_count decode_utf8 from_list join slice}} {std::mutable_byte_store {count detach freeze freeze_prefix from_storage replace zeroed}} {std::linux::abi::x86_64 syscall} {std::linux::abi::aarch64 syscall} {std::abi::x86_64 {from_bytes from_mutable_bytes}} {std::abi::aarch64 {from_bytes from_mutable_bytes}} {std::ffi::c {clone erase null null? retype}}}

test ns-no-nested-stdlib {every qualified intrinsic is standard, under the one compiler-owned root std (STD-NAMESPACE.md: no flat alias, no second root), and every one but the platforms' (std::linux::abi::x86_64::syscall, std::linux::abi::aarch64::syscall, std::abi::x86_64::from_bytes, std::abi::aarch64::from_bytes) and the C ABI's (std::ffi::c::null ..., C-ABI-TYPES.md) and the native-view constructor (std::binary::native::view, NATIVE-LAYOUT-VIEWS.md: a namespace of its own because directness is designated per namespace, so binary itself stays non-direct) is std::FAMILY::MEMBER, one family level below std} -body {
    lsort [lmap name [core::native::names] {
        if {[string first :: $name] < 0} continue
        if {[string match std::* $name]} {
            if {[string match std::linux::abi::* $name] || [string match std::abi::x86_64::* $name]
                    || [string match std::abi::aarch64::* $name]
                    || [string match std::ffi::c::* $name] || [string match std::binary::native::* $name]} continue
            if {[llength [split [string map {:: \x00} $name] \x00]] == 3} continue
        }
        set name
    }]
} -result {}

test ns-historical-names-are-unknown {every historical root spelling is now an ordinary unbound name} -body {
    lmap call {
        {list_get([1], 0)} {list_append([1], 2)} {list_length([1])} {concat("a", "b")}
        {length("a")} {substring("ab", 0, 1)} {lowercase("A")} {encode_utf8("a")}
        {is_tcl_alpha("a")} {is_tcl_alnum("a")} {char_codepoint('a')}
        {mutable_array_allocate(1)} {import std::mutable_array
mutable_array_capacity(std::mutable_array::allocate(1))}
        {import std::mutable_array
mutable_array_get(std::mutable_array::allocate(1), 0)} {import std::mutable_array
mutable_array_set(std::mutable_array::allocate(1), 0, 1)}
        {import std::mutable_array
mutable_array_copy(std::mutable_array::allocate(1), 0, std::mutable_array::allocate(1), 0, 1)}
        {import std::mutable_array
mutable_array_freeze(std::mutable_array::allocate(1), 1)}
        {immutable_set_from_list([1])} {import std::immutable_set
immutable_set_contains(std::immutable_set::from_list([1]), 1)}
    } {
        diagKinds $call
    }
} -result [lrepeat 19 UNBOUND]

test ns-char-scalar-value-is-canonical {std::char::scalar_value is the one spelling: the intrinsic itself (no char module, no codepoint wrapper); a direct call with an Int is a compile-time TYPE error, like any intrinsic's argument statically of another kind (METHOD-RECEIVER-TYPE-CORRECTNESS-MILESTONE-1.md)} -body {
    list [rejection {import std::char
std::char::codepoint('A')}] [rejection {import std::char
std::char::scalar_value(65)}] \
        [agree {import std::char
[std::char::scalar_value('A'), std::char::scalar_value('é'), std::char::scalar_value('😀')]}] \
        [core::native::isQualifiedNative std::char::scalar_value] [file exists [file join $::projectRoot stdlib char.bot]]
} -match glob -result {{UNKNOWN-SYMBOL {*: namespace "std::char" has no definition "codepoint" (its members are the intrinsics: is_tcl_alnum, is_tcl_alpha, scalar_value)}} {TYPE {*: argument 1 of native std::char::scalar_value requires UnicodeChar, but this argument has type int: the call could only fail when it runs}} {\[65, 233, 128512\]} 1 0}

test ns-historical-module-is-gone {the mutarray module became mutable_array (one namespace per family)} -body {
    list [lindex [rejection {import mutarray
mutarray::create(1, 0)}] 0] [agree {import std::mutable_array
std::mutable_array::freeze(std::mutable_array::create(2, 7), 2)}]
} -result {UNKNOWN-NAMESPACE {[7, 7]}}

test ns-intrinsics-are-root-natives {a qualified intrinsic is a root reference: no module is loaded for it and no local can shadow it} -body {
    set hir [nsHir "import std::list\nimport std::str\nfn f(list, str):\n    \[std::list::at(\[1, 2\], 1), std::str::concat(\"a\", \"b\")\]\nf(0, 0)"]
    list [targetOf $hir [callNamed $hir std::list::at]] [targetOf $hir [callNamed $hir std::str::concat]] \
        [agree "import std::list\nimport std::str\nfn f(list, str):\n    \[std::list::at(\[1, 2\], 1), std::str::concat(\"a\", \"b\")\]\nf(0, 0)"]
} -result {{native std::list::at} {native std::str::concat} {[2, "ab"]}}

test ns-diagnostics-name-the-qualified-callable {run-time and static diagnostics spell the intrinsic's qualified name} -body {
    list [lindex [agree {import std::list
std::list::length("abc")} 0] 1] \
        [string match {*this call of "std::list::at" may produce the declared error "IndexNotFound"*} \
            [lindex [rejection "import std::list\nfn f(xs, i):\n    std::list::at(xs, i)\nf(\[1\], 0)"] 1]] \
        [lindex [outcomeUnderHir interp [nsHir {import std::list
std::list::length("abc")} 0]] 2]
} -result {{CORE SEMANTIC TYPE} 1 {std::list::length: expected list, got "abc"}}

# ---------------------------------------------------------------------------
# Protection: an intrinsic member cannot be redefined or overloaded; other
# members of its namespace stay ordinary

proc withLibrary {files script} {
    set dir [makeDirectory stdlib-ns-lib]
    set saved $::core::libraryDir
    try {
        foreach {name text} $files {
            set path [file join $dir $name]
            file mkdir [file dirname $path]
            set channel [open $path w]
            puts -nonewline $channel $text
            close $channel
        }
        # The real library's modules stay reachable (list.bot, ...).
        foreach file [glob -nocomplain -directory $saved *.bot] {
            if {![file exists [file join $dir [file tail $file]]]} {
                file copy $file [file join $dir [file tail $file]]
            }
        }
        set ::core::libraryDir $dir
        uplevel 1 $script
    } finally {
        set ::core::libraryDir $saved
        removeDirectory stdlib-ns-lib
    }
}

test ns-protect-module-member {a module of the intrinsic's namespace may not define a member of the intrinsic's name} -body {
    withLibrary {str.bot "fn shout(s):\n    std::str::concat(s, \"!\")\n\nfn concat(a, b):\n    a\n"} {
        lassign [rejection {import std::str
std::str::shout("hi")}] kind message
        list $kind [string match {*module "std::str" (*str.bot) cannot define "concat": std::str::concat is a compiler-provided intrinsic*cannot be redefined or overloaded (other members of namespace "std::str" are unaffected)*} $message]
    }
} -result {DUPLICATE-NATIVE 1}

test ns-protect-module-binding {an immutable module binding of the intrinsic's name is rejected the same way} -body {
    withLibrary {mutable_array.bot "set = 1\n\nfn create(n, d):\n    std::mutable_array::allocate(n)\n"} {
        lindex [rejection {import std::mutable_array
std::mutable_array::create(1, 0)}] 0
    }
} -result DUPLICATE-NATIVE

test ns-unrelated-member-is-legal {an unrelated member of the same namespace is ordinary: std::str::shout beside the intrinsic std::str::concat, which still means the intrinsic} -body {
    withLibrary {str.bot "fn shout(s):\n    std::str::concat(s, \"!\")\n"} {
        agree {import std::str
[std::str::shout("hi"), std::str::concat("a", "b"), std::str::length(std::str::shout("x"))]}
    }
} -result {["hi!", "ab", 2]}

test ns-list-module-beside-intrinsics {stdlib/list.bot's own members (get, find, any?) sit beside the intrinsics std::list::at/append/length} -body {
    list [core::native::isQualifiedNative std::list::get] [core::native::isQualifiedNative std::list::at] \
        [agree "import std::list\nfn odd(x):\n    mod(x, 2) == 1\nf = std::list::find(\[2, 3\], odd):\n    on std::list::NotFound:\n        0\n\[std::list::get(\[1\], 0, 9), f, std::list::any?(\[2\], odd), std::list::length(std::list::append(\[\], 1))\]"]
} -result {0 1 {[1, 3, false, 1]}}

test ns-entry-program-is-in-no-namespace {an entry program belongs to no namespace, so it may define a function whose name an intrinsic uses in some namespace: only a module file of that namespace is protected} -body {
    list [agree "fn at(xs, i):\n    \"mine\"\n\[at(\[4, 5\], 0)\]"] \
        [agree "set = 3\n\[set\]"] \
        [agree "import std::list\nfn second(xs):\n    std::list::length(xs)\n\[second(\[4, 5\])\]"]
} -result {{["mine"]} {[3]} {[2]}}

test ns-protect-is-not-overloading {a module's definition of an intrinsic's name with another arity is no overload: it is rejected like any other} -body {
    list [withLibrary {str.bot "fn length(s, extra):\n    0\n"} {lindex [rejection "import std::str\n1\n"] 0}] \
        [withLibrary {list.bot "fn at(xs):\n    0\n"} {lindex [rejection "import std::list\n1\n"] 0}]
} -result {DUPLICATE-NATIVE DUPLICATE-NATIVE}

test ns-local-names-are-unrelated {a local function named at is an ordinary binding: it neither replaces nor overloads std::list::at} -body {
    agree "import std::list\nfn at(xs, i):\n    \"mine\"\n\[at(\[1\], 0), std::list::at(\[7\], 0)\]"
} -result {["mine", 7]}

test ns-unknown-member-of-intrinsic-namespace {a namespace with only intrinsics reports an unknown member against them, not as a missing module file} -body {
    rejection {import std::str
std::str::nope("a")}
} -match glob -result {UNKNOWN-SYMBOL {*namespace "std::str" has no definition "nope" (its members are the intrinsics: append_char, char_at, concat, encode_utf8, is_tcl_alnum, is_tcl_alpha, length, lowercase, substring)}}

test ns-unknown-member-lists-intrinsics-too {a namespace with a module lists the module's definitions and the intrinsics} -body {
    rejection {import std::list
std::list::nope([1])}
} -match glob -result {UNKNOWN-SYMBOL {*namespace "std::list" has no definition "nope" (it defines: all?, any?, append, at, find, get, length, none?, with_length)}}

# ---------------------------------------------------------------------------
# at: required indexed lookup, IndexNotFound otherwise

set ::pick {import std::list
fn pick(xs, i) errors IndexNotFound:
    std::list::at(xs, i)
fn safe(xs, i):
    r = pick(xs, i):
        on IndexNotFound:
            "missing"
    r
}

test ns-at-present-and-missing {std::list::at returns the element for 0 <= i < length and fails with IndexNotFound for every other Int: past the end, negative (no negative indexing), a BigInt, an empty List} -body {
    agree "$::pick\[safe(\[10, 20, 30\], 0), safe(\[10, 20, 30\], 2), safe(\[10, 20, 30\], 3), safe(\[10, 20, 30\], -1), safe(\[10\], 100000000000000000000), safe(\[\], 0)\]"
} -result {[10, 30, "missing", "missing", "missing", "missing"]}

test ns-at-unhandled-is-the-declared-error {an IndexNotFound nobody handles is the ordinary uncaught declared error on every backend (a -strict 0 program)} -body {
    agree "$::pick\npick(\[1\], 5)" 0
} -result {error {CORE SEMANTIC UNCAUGHT-ERROR}}

test ns-at-other-failures-are-not-index-not-found {a non-List container or a non-Int index is the TYPE error, which an IndexNotFound handler does not catch} -body {
    list [agree "$::pick\nsafe(\"abc\", 0)" 0] [agree "$::pick\nsafe(\[1\], \"0\")" 0]
} -result {{error {CORE SEMANTIC TYPE}} {error {CORE SEMANTIC TYPE}}}

test ns-mutable-array-at {std::mutable_array::at has the same contract over a MutableArray's capacity} -body {
    agree "import std::mutable_array\nfn pick(a, i) errors IndexNotFound:\n    std::mutable_array::at(a, i)\nfn safe(a, i):\n    r = pick(a, i):\n        on IndexNotFound:\n            -1\n    r\na = std::mutable_array::from_list(\[5, 6\])\n\[safe(a, 0), safe(a, 1), safe(a, 2), safe(a, -1), safe(std::mutable_array::allocate(0), 0)\]"
} -result {[5, 6, -1, -1, -1]}

test ns-mutable-array-set-is-index-not-found {std::mutable_array::set at an index that designates no slot fails with IndexNotFound, on every backend; each call writes its own copy (MUTABLE-ARRAY.md), never the caller's array} -body {
    agree "import std::mutable_array\nfn put(a, i, v) errors IndexNotFound:\n    std::mutable_array::set(a, i, v)\n    a\nfn safe(a, i, v):\n    r = put(a, i, v):\n        on IndexNotFound:\n            return \"missing\"\n    std::mutable_array::freeze(r, std::mutable_array::capacity(r))\na = std::mutable_array::from_list(\[5, 6\])\n\[safe(a, 1, 9), safe(a, 2, 9), safe(a, -1, 9), safe(a, 100000000000000000000, 9), safe(std::mutable_array::allocate(0), 0, 1), std::mutable_array::freeze(a, 2)\]"
} -result {[[5, 9], "missing", "missing", "missing", "missing", [5, 6]]}

test ns-error-signatures {the indexed natives declare exactly IndexNotFound, the slicing natives exactly LowerUnderrun and UpperOverrun: builtin errors every program sees, with fixed native ids (the Float64 operations' NonFiniteFloat, FLOAT64-MILESTONE-1.md, is the fifth builtin error, std::binary::parse's LayoutLengthMismatch, BINARY-LAYOUT.md, the sixth, std::binary::native::view's NativeViewNull, NATIVE-LAYOUT-VIEWS.md, the seventh, std::binary::native::edit's NativeEditNull, NATIVE-LAYOUT-WRITES.md, the eighth, and a whole fixed array's LayoutExtentMismatch, FIXED-LAYOUT-ARRAYS.md, the ninth, and std::decimal_rounded::round's UnrepresentableDecimal, DECIMAL-ROUNDED-MILESTONE-1.md, the tenth, and std::list::with_length's LengthMismatch, LIST-CARDINALITY-REFINEMENTS.md, the eleventh, and std::int::from_string's InvalidIntegerText, NUMERIC-TEXT-BOUNDARY-MILESTONE-1.md, the twelfth, and std::abi::bytes::decode_utf8's InvalidUtf8, WINDOWS-X86-64-MILESTONE-7.md, the thirteenth)} -body {
    list [lmap n {std::list::at std::mutable_array::at std::mutable_array::set std::str::substring std::mutable_array::freeze std::mutable_array::copy} {
            list $n [dict get [core::native::metadata $n] errors]
        }] \
        [core::native::builtinErrorNames] \
        [lmap e {IndexNotFound LowerUnderrun UpperOverrun NonFiniteFloat} {native::lower::ErrorId $e}]
} -result {{{std::list::at IndexNotFound} {std::mutable_array::at IndexNotFound} {std::mutable_array::set IndexNotFound} {std::str::substring {LowerUnderrun UpperOverrun}} {std::mutable_array::freeze {LowerUnderrun UpperOverrun}} {std::mutable_array::copy {LowerUnderrun UpperOverrun}}} {InvalidArgumentEncoding IndexNotFound LowerUnderrun UpperOverrun NonFiniteFloat LayoutLengthMismatch NativeViewNull NativeEditNull LayoutExtentMismatch UnrepresentableDecimal LengthMismatch InvalidIntegerText InvalidUtf8} {1073741825 1073741826 1073741827 1073741828}}

test ns-bounds-are-registered {the bounds checks behind the argument-dependent errors are registered with each native (-bounds), validated against its -errors and arity} -body {
    set bad {}
    foreach {bounds errors arity} {
        {index list 0 1}                  {}                            2
        {index list 0 2}                  IndexNotFound                 2
        {index tree 0 1}                  IndexNotFound                 2
        {slices {str 0 1 2}}              IndexNotFound                 3
        {slices {str 0 1 {sum 1 3}}}      {LowerUnderrun UpperOverrun}  3
        {slices {str 0 {const x} 2}}      {LowerUnderrun UpperOverrun}  3
        {slices}                          {LowerUnderrun UpperOverrun}  3
        {window 0 1}                      IndexNotFound                 2
    } {
        lappend bad [catch {core::native::register test-ns-bounds -arity $arity -impl list \
            -errors $errors -bounds $bounds} message]
        catch {core::native::unregister test-ns-bounds}
    }
    list [lmap n {std::list::at std::mutable_array::at std::mutable_array::set std::str::substring std::mutable_array::freeze std::mutable_array::copy std::list::length} {
            list $n [dict get [core::native::metadata $n] bounds]
        }] $bad
} -result {{{std::list::at {index list 0 1}} {std::mutable_array::at {index mutarray 0 1}} {std::mutable_array::set {index mutarray 0 1}} {std::str::substring {slices {str 0 1 2}}} {std::mutable_array::freeze {slices {mutarray 0 {const 0} 1}}} {std::mutable_array::copy {slices {mutarray 0 1 {sum 1 4}} {mutarray 2 3 {sum 3 4}}}} {std::list::length {}}} {1 1 1 1 1 1 1 1}}

