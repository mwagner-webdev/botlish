test ns-at-element-type {std::list::at keeps the element type: List[int] gives int, no optional/null type} -body {
    set hir [nsHir "import std::list\nfn f(xs: List\[int\]) errors IndexNotFound:\n    std::list::at(xs, 0)\nr = f(\[1, 2\]):\n    on IndexNotFound:\n        0\nr"]
    # `import std::list` loads stdlib/list.bot, whose own (untyped) std::list::at calls come
    # first in the walk: pick the call written inside this program's f.
    set mine {}
    foreach e [hir::walk $hir] {
        if {[hir::kind $hir $e] ne "call"} continue
        set callee [hir::get $hir $e callee]
        if {[hir::kind $hir $callee] eq "ref" && [hir::get $hir $callee name] eq "std::list::at" &&
                [string match {f()/*} [dict get [hir::get $hir $e origin] node]]} {
            lappend mine $e
        }
    }
    hir::types::show [hir::typeOf $hir [lindex $mine 0]]
} -result int

test ns-get-element-type {std::list::get and std::mutable_array::get keep the element type: the result of a get call is the element type joined with the default's, no optional/null type} -body {
    set hir [nsHir {import std::list
import std::mutable_array
a = std::list::get([1, 2], 5, 0)
b = std::list::get(["x"], 0, "y")
c = std::mutable_array::get(std::mutable_array::create(2, "s"), 1, "t")
d = std::list::get([[1], [2, 3]], 1, [])
[a, b, c, d]}]
    lmap name {a b c d} {
        set bind [lindex [lmap e [hir::walk $hir] {
            if {[hir::kind $hir $e] ne "bind" || [dict get [hir::binding $hir [hir::get $hir $e binding]] name] ne $name} continue
            set e
        }] 0]
        hir::types::show [hir::typeOf $hir [hir::get $hir $bind value]]
    }
} -result {int str str {List[int]}}

