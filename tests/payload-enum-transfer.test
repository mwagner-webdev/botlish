std::transfer::encode([Message::Text {body: "two"}, Message::Batch {items: [3, 4]}, Message::Ping, Message::Number {value: -5}])
}]
    petAgree "enum Other:
    Q {z: str},
    R,

struct Unrelated:
    a: str

enum Message:
    Batch {items: List\[int\]},
    Number {value: int},
    Text {body: str},
    Ping,

u = Unrelated {a: \"u\"}
o = Other::Q {z: \"z\"}
xs = std::transfer::decode\[List\[Message\]\]([petLiteral $codes]):
    on TransferMalformed:
        \[\]
    on TransferVersion:
        \[\]
    on TransferTypeMismatch:
        \[\]
    on TransferInvalidValue:
        \[\]
    on TransferLimit:
        \[\]
loop m in xs:
    match m:
        case Message::Ping:
            \"ping\"
        case Message::Text {body}:
            body
        case Message::Number {value}:
            value.to_string()
        case Message::Batch {items}:
            a = items.at(0):
                on IndexNotFound:
                    -1
            b = items.at(1):
                on IndexNotFound:
                    -1
