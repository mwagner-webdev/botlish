    A,
    B {x: int},
} {T::B {x: 5}} {enum T:
    A,
    B {x: int},
} {T::B {x: 300}} {enum T:
    A,
    B {x: int},
} {T::B {x: 0}} {enum T:
    A,
    B {x: int},
    C,
} {T::C}} {
        set codes [petCodesOf [core::evalProgram [hir::lower [surface::compile [petProgram "$sent\nstd::transfer::encode($value)\n"] t.bot -warnings off]]]]
        set codes [concat [lrange $codes 0 4] [petFpBytes $fp] [lrange $codes 13 end]]
