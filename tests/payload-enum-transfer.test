test pet-refuse-mutations {a thousand mutations of a rich encoding (every byte after the header, every value) decode, on every backend, into a value or a declared refusal -- the same on every backend, never a crash or an internal error -- and none of them is taken for another version or type} -body {
    petAgree "$::petDecls
fn attempt(data: std::abi::bytes::Bytes) -> int:
    v = std::transfer::decode\[List\[Outer\]\](data):
        on TransferMalformed:
            return 1
        on TransferVersion:
            return 2
        on TransferTypeMismatch:
            return 3
        on TransferInvalidValue:
            return 4
        on TransferLimit:
            return 5
    0

good = std::transfer::encode(\[Outer::Wrap {inner: Message::Batch {items: \[1, 300, -5\]}}, Outer::Empty, Outer::Wrap {inner: Message::Text {body: \"héllo\"}}, Outer::Wrap {inner: Message::Number {value: 77}}\])
n = size(good)
fold i from 0 to 1000 with intermediate t \[0, 0, 0\]:
    at = 13 + (i * 7919).mod(n - 13)
    b = (i * 104729 + 17).mod(256)
    r = attempt(poke(good, at, std::byte::from_int(b)))
    if r == 2 or r == 3:
        \[t.at(0) + 1, t.at(1), t.at(2) + r\]
    elif r == 0:
        \[t.at(0), t.at(1) + 1, t.at(2)\]
    else:
        \[t.at(0), t.at(1), t.at(2) + r\]
"
} -result {[0, 298, 1927]}

test pet-limits {resource limits stay effective: a List count of payload enums is bounded by the bytes left (every value takes at least its case index's byte), and a deep recursion through a payload is encoded and decoded by work stacks, bounded by its bytes} -body {
    petAgree "$::petDecls
struct Walk:
    n: int
    e: Expr

fn deep(n: int) -> Expr:
    fold i from 0 to n with intermediate e Expr::Lit {value: 1}:
        Expr::Neg {e: e}

fn depth(e: Expr) -> int:
    w = fold with intermediate w Walk {n: 0, e: e}:
        next = match w.e:
            case Expr::Neg {e}:
                Walk {n: w.n + 1, e: e}
            case Expr::Lit {value}:
                break
            case Expr::Add {left, right}:
                break
        next
    w.n

fn attempt(data: std::abi::bytes::Bytes) -> str:
    v = std::transfer::decode\[List\[Message\]\](data):$::petHandlers
    \"ok\"

good = std::transfer::encode(\[Message::Ping\])
claim = append(prefix(good, 13), \[std::byte::from_int(255), std::byte::from_int(255), std::byte::from_int(255), std::byte::from_int(127), std::byte::from_int(2), std::byte::from_int(2)\])
d = std::transfer::encode(deep(20000))
back = std::transfer::decode\[Expr\](d):
    on TransferMalformed:
        Expr::Lit {value: 0}
    on TransferVersion:
        Expr::Lit {value: 0}
    on TransferTypeMismatch:
        Expr::Lit {value: 0}
    on TransferInvalidValue:
        Expr::Lit {value: 0}
    on TransferLimit:
        Expr::Lit {value: 0}
\[attempt(claim), size(d), depth(back)\]
"
} -result {["malformed", 20016, 20000]}

# ---------------------------------------------------------------------------
# Programs: values cross between independently compiled programs

# The bytes (Ints) program SOURCE's value -- a std::abi::bytes::Bytes --
# holds, run on the interp backend; FILES library modules.
proc petBytesOf {source {files {}}} {
    withPrivateLibrary {
        petWriteModules $files
        set codes [petCodesOf [core::evalProgram [hir::lower [surface::compile [petProgram $source] t.bot -warnings off]]]]
    }
    return $codes
}

test pet-program-compatible {a value made by one program is rebuilt by another compiled independently: cases and payload fields declared in another order, other enums and structs before them (other native enum and shape numbers), and the receiver matches it} -body {
    set codes [petBytesOf {enum Message:
    Ping,
    Text {body: str},
    Number {value: int},
