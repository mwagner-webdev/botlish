# ---------------------------------------------------------------------------
# Processes: separate VMs, separate heaps; the sender has exited

proc petWrite {path text} {
    set f [open $path w]
    fconfigure $f -encoding utf-8
    puts -nonewline $f $text
    close $f
}

# A driver run in a process of its own (tests/value-transfer.test's).
set ::petDriver {
set root [lindex $argv 0]
lassign [lrange $argv 1 end] mode backend source path
set argv {}
set argc 0
source [file join $root tests helpers.tcl]
source [file join $root surface surface.tcl]
proc readText {path} {
    set f [open $path r]
    fconfigure $f -encoding utf-8
    set text [read $f]
    close $f
    return $text
}
proc run {backend hir} {
    switch -- $backend {
        interp { return [core::evalProgram [hir::lower $hir]] }
        compile { return [core::compiler::evalHir $hir] }
        cranelift { return [native::evalHir $hir] }
        cranelift-generic { return [native::evalHir $hir -specialize 0] }
    }
}
set text [readText $source]
if {$mode eq "send"} {
    set value [run $backend [surface::compile $text sender.bot -warnings off]]
    set f [open $path wb]
    puts -nonewline $f [binary decode hex [lindex $value 2 0 1]]
    close $f
    puts sent
} else {
    set f [open $path rb]
    binary scan [read $f] cu* codes
    close $f
    set literal "std::abi::bytes::from_list(\[[join [lmap b $codes {string cat "std::byte::from_int($b)"}] {, }]\])"
    set hir [surface::compile [string map [list BYTES $literal] $text] receiver.bot -warnings off]
    puts [core::value::show [run $backend $hir] 1]
}
}

foreach {from to} {interp compile compile interp interp cranelift cranelift interp cranelift-generic cranelift cranelift cranelift-generic} {
    test pet-process-$from-$to "payload enums sent by a $from process are rebuilt and matched by a $to process after the sender exited" -constraints [expr {$from in {cranelift cranelift-generic} || $to in {cranelift cranelift-generic} ? "nativeBuilt" : ""}] -body {
        set dir [makeDirectory pet-process-[pid]-$from-$to]
        petWrite [file join $dir driver.tcl] $::petDriver
        petWrite [file join $dir sender.bot] [petProgram "$::petDecls\n$::petBundle\n$::petSender"]
        petWrite [file join $dir receiver.bot] [petProgram "$::petDecls\n$::petBundle\n$::petReceiver"]
        set data [file join $dir message.bin]
        set sent [exec [info nameofexecutable] [file join $dir driver.tcl] $::projectRoot send $from [file join $dir sender.bot] $data 2>@1]
        set received [exec [info nameofexecutable] [file join $dir driver.tcl] $::projectRoot receive $to [file join $dir receiver.bot] $data 2>@1]
        removeDirectory pet-process-[pid]-$from-$to
        list [lindex [split [string trim $sent] \n] end] [lindex [split [string trim $received] \n] end]
    } -result {sent {[[0, 1, -129, 2, 0], 0, 3, 9, "r", true]}}
}

# ---------------------------------------------------------------------------
# GC stress: the native codec under a collection at every allocation site

test pet-gc-stress {round trips of payload enums -- nested, recursive, holding Lists, MutableVectors and opaque representations -- under BOTLISH_NATIVE_GC_STRESS=1 on the native backends} -constraints nativeBuilt -body {
    set had [info exists ::env(BOTLISH_NATIVE_GC_STRESS)]
    set ::env(BOTLISH_NATIVE_GC_STRESS) 1
    try {
        sourceAgree [petProgram "$::petDecls
fn main() -> List\[any\] errors TransferMalformed, TransferVersion, TransferTypeMismatch, TransferInvalidValue, TransferLimit:
    xs = loop i from 0 to 40:
        Outer::Wrap {inner: Message::Batch {items: \[i, i * i\]}}
    ts = loop i from 0 to 40:
        Tree::Branch {children: \[Tree::Leaf {value: i}, Tree::Branch {children: \[Tree::Leaf {value: 0 - i}\]}\]}
    ls = loop i from 0 to 40:
        Labeled::Named {name: name_of(i.to_string())}
    cs = loop i from 0 to 40:
        Counter::Counts {numbers: std::mutable_vector::from_list(\[i, i + 1\])}
    a = std::transfer::decode\[List\[Outer\]\](std::transfer::encode(xs))
    b = std::transfer::decode\[List\[Tree\]\](std::transfer::encode(ts))
    c = std::transfer::decode\[List\[Labeled\]\](std::transfer::encode(ls))
    d = std::transfer::decode\[List\[Counter\]\](std::transfer::encode(cs))
    \[a == xs, b == ts, c.length(), d.length()\]

main():
    on TransferMalformed:
        \[\"malformed\"\]
    on TransferVersion:
        \[\"version\"\]
    on TransferTypeMismatch:
        \[\"mismatch\"\]
    on TransferInvalidValue:
        \[\"invalid\"\]
    on TransferLimit:
        \[\"limit\"\]
"] {cranelift-generic cranelift}
    } finally {
        if {!$had} {
            unset ::env(BOTLISH_NATIVE_GC_STRESS)
        }
    }
} -result {value {[true, true, 40, 40]}}

# ---------------------------------------------------------------------------
# The principal application: typed remote messages and calls between threads

set petSources [file join $::projectRoot tests payload-enum-transfer]
set petApp [file join [temporaryDirectory] pet-app-[pid]]

# The application directory -- the programs and the Linux driver package
# installed as an application installs it -- built once.
proc petBuild {} {
    if {[info exists ::petBuilt]} {
        return $::petBuilt
    }
    set ::petBuilt [expr {![catch {
        file delete -force $::petApp
        file mkdir $::petApp
        foreach path [glob -directory $::petSources *.bot] {
            file copy $path $::petApp
        }
        eventLoopLinux::install $::petApp
    } ::petBuildError]}]
    return $::petBuilt
}

# Program NAME of the application compiled (-warnings error) and run on
# cranelift: {value SHOWN} or {error CODE MESSAGE}; ENVIRONMENT: variable
# pairs set for the run.
proc petRemote {name {environment {}}} {
    if {![petBuild]} {
        return [list error BUILD $::petBuildError]
    }
    if {![info exists ::petHirs($name)]} {
        if {[catch {surface::readProgramFile [file join $::petApp $name.bot] -warnings error} message]} {
            return [list error COMPILE $message]
        }
        set ::petHirs($name) $message
    }
    set o [withEnvironment $environment {outcomeUnderHir cranelift $::petHirs($name)}]
    return [lrange $o 0 [expr {[lindex $o 0] eq "value" ? 1 : 2}]]
}

set ::petMessages {value {[["calc 1 42", "store kéy 6", "update 24 4", "update 34 5", "nested 2 calc 2 2 stop", "ordered 200 received 200"], true, "count 3 three"]}}

test pet-remote-messages {a worker thread sends every case of a payload-bearing Request -- payload-free, scalar fields, a String, a List, a MutableVector sent, changed by its sender and sent again, a List of Requests -- through a Remote endpoint into a mailbox of 4 of this VM; the receiving actor matches each reconstructed value exhaustively, in the order sent, the 200 numbered requests behind them too, and each received vector is its own; a thread entry's payload-enum initialization value and result cross both ways} -constraints threadTransport -body {
    petRemote messages
} -result $::petMessages

test pet-remote-messages-gc-stress {the same under GC stress: every VM's collector at every allocation site while the bytes are rebuilt in the receiving VM} -constraints threadTransport -body {
    petRemote messages {BOTLISH_NATIVE_GC_STRESS 1}
} -result $::petMessages

test pet-remote-calls {typed calls into another VM whose request and response are payload enums (Service[Query, Outcome]): the worker's service matches each request exhaustively and replies with an Outcome case, which this VM's caller matches; every call is answered} -constraints threadTransport -body {
    petRemote calls
} -result {value {[["pong", "sum 42", "text héllo!", "count 3 bbbb"], true, 4]}}

test pet-remote-calls-gc-stress {the same under GC stress} -constraints threadTransport -body {
    petRemote calls {BOTLISH_NATIVE_GC_STRESS 1}
} -result {value {[["pong", "sum 42", "text héllo!", "count 3 bbbb"], true, 4]}}

test pet-actor-same-thread {a same-thread std::actor message is an ordinary value of its VM, no transfer involved: a payload enum posted to an actor's mailbox is received, matched and answered as it was sent, on every backend} -body {
    sourceAgree [petProgram "import std::actor
import std::event_loop
import std::event_loop::deterministic

enum Work:
    Stop,
    Add {a: int, b: int},
    Name {text: str},

fn worker(inbox: std::actor::Inbox\[Work\], out: std::actor::Address\[str\], context ev: std::event_loop::Loop, resume std::actor::Answer) -> std::actor::Exit:
    rx = std::actor::listen(inbox):
        on std::actor::Closed:
            return std::actor::exit(-1)
    n = fold with intermediate n 0:
        w = std::actor::receive(rx):
            on std::actor::Closed:
                break
        line = match w:
            case Work::Stop:
                break
            case Work::Add {a, b}:
                (a + b).to_string()
            case Work::Name {text}:
                text
        out.send(line)
        n + 1
    std::event_loop::stop():
        on std::event_loop::SchedulerFault:
            return std::actor::exit(-2)
    std::actor::exit(n)

fn go(context ev: std::event_loop::Loop, d: std::event_loop::Driver, ac: std::actor::Actors) -> List\[str\] errors std::event_loop::SchedulerFault, std::event_loop::DriverFault, std::event_loop::LoopReentered:
    {to, inbox} = std::actor::open\[Work\](4)
    {to: out, inbox: result} = std::actor::open\[str\](4)
    a = inject context std::event_loop::Loop:
        coroutine {step, first} = worker(inbox, out)
        std::actor::spawned(step, first)
    std::actor::start(a)
    std::actor::post(to, Work::Add {a: 40, b: 2})
    std::actor::post(to, Work::Name {text: \"hé\"})
    std::actor::post(to, Work::Stop)
    std::event_loop::run()
    std::actor::drain(result)

with context std::event_loop::create(16)
with context std::event_loop::deterministic::create()
with context std::actor::create()
go():
    on std::event_loop::SchedulerFault:
        \[\"scheduler fault\"\]
    on std::event_loop::DriverFault {code}:
        \[\"driver fault\"\]
    on std::event_loop::LoopReentered:
        \[\"reentered\"\]
"] [petBackends]
} -result {value {["42", "hé"]}}

cleanupTests
