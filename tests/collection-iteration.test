# collection-iteration.test -- loops over std::mutable_map::MutableMap and
# std::mutable_set::MutableSet: the loop protocol (hir/iteration.tcl,
# ORDERED-MUTABLE-MAP-SET.md, "Iteration").
#
# `loop x in c:` over one of the standard library's collection structs
# visits its elements in insertion order through its owner module's loop
# protocol -- internal operations over positions no program can name --
# written out after the checks as a counted loop over a logical copy of the
# collection: the loop iterates the collection as it was when the loop
# began (MutableVector's snapshot policy), materializes nothing, and every
# other loop rule (collecting, continue, break, the loop variable a fresh
# binding per iteration) is the listloop's.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]

testConstraint nativeBuilt [expr {![catch {native::binary}]}]

set ciDecls {import std::mutable_map
import std::mutable_set
import std::mutable_array

fn letters() -> std::mutable_map::MutableMap[str, int]:
    m = std::mutable_map::create[str, int]()
    m.set("a", 1)
    m.set("b", 2)
    m.set("c", 3)
    m

fn digits(n: int) -> std::mutable_set::MutableSet[int]:
    s = std::mutable_set::create[int]()
    loop i from 0 to n:
        s.add(i)
    s

}

proc ciRun {body} {
    return [sourceAgree "$::ciDecls$body"]
}

proc ciDiagnostics {body} {
    set offset [llength [split $::ciDecls \n]]
    if {![catch {surface::compile "$::ciDecls$body" -warnings off} message options]} {
        return {}
    }
    set result {}
    foreach d [dict getdef $options -diagnostics [list [dict create errorcode [dict get $options -errorcode] message $message]]] {
        set line ""
        regexp {^[^:]*:([0-9]+):} [dict get $d message] -> line
        if {$line ne ""} {
            set line [expr {$line - $offset + 1}]
        }
        lappend result [list [lindex [dict get $d errorcode] end] $line]
    }
    return $result
}

# ---------------------------------------------------------------------------
# The loop as written

test ci-order-and-element {a loop visits a map's entries (MutableMapEntry[K, V]: key, value) and a set's elements in insertion order, and collects the body's values} -body {
    ciRun "m = letters()\nkeys = loop e in m:\n    e.key\npairs = loop e in m:\n    \[e.key\]\nvalues = loop e in m:\n    e.value * 10\nxs = loop x in digits(4):\n    x * x\n\[keys, values, xs, std::list::length(pairs)\]\n"
} -setup {set ::ciDecls "import std::list\n$::ciDecls"} -cleanup {set ::ciDecls [string range $::ciDecls 16 end]} -result {value {[["a", "b", "c"], [10, 20, 30], [0, 1, 4, 9], 3]}}

test ci-element-type {the loop variable's type is the protocol's element with the collection's arguments put in: MutableMapEntry[str, int] over a MutableMap[str, int], int over a MutableSet[int]} -body {
    set hir [surface::compile "${::ciDecls}m = letters()\nks = loop entry_q in m:\n    entry_q.key\nxs = loop elem_q in digits(2):\n    elem_q\n0\n" -warnings off]
    set types {}
    dict for {b binding} [dict get $hir bindings] {
        if {[dict get $binding name] in {entry_q elem_q} && [dict get $binding type] ne ""} {
            lappend types [dict get $binding name] [hir::types::show [hir::bindingType $hir $b]]
        }
    }
    lsort -stride 2 $types
} -cleanup {unset -nocomplain hir types b binding} -result {elem_q int entry_q {std::mutable_map::MutableMapEntry[str, int]}}

test ci-continue-break {continue skips an element (contributes nothing), break ends the loop with the List collected so far} -body {
    ciRun "xs = loop x in digits(10):\n    if x.mod(2) == 1:\n        continue\n    if x > 6:\n        break\n    x\nys = loop e in letters():\n    if e.key == \"b\":\n        continue\n    e.value\n\[xs, ys\]\n"
} -result {value {[[0, 2, 4, 6], [1, 3]]}}

test ci-removed-not-visited {a removed entry is never visited, a re-added one is visited last, and a replaced value is visited in its key's place} -body {
    ciRun "m = letters()\nr = m.remove(\"a\"):\n    on std::mutable_map::KeyNotFound:\n        0\nm.set(\"b\", 20)\nm.set(\"a\", 100)\ns = digits(5)\ns.remove(0)\ns.remove(3)\ns.add(0)\nks = loop e in m:\n    \[e.key, e.value\]\nxs = loop x in s:\n    x\n\[ks, xs\]\n"
} -result {value {[[["b", 20], ["c", 3], ["a", 100]], [1, 2, 4, 0]]}}

test ci-empty {a loop over an empty collection, or one emptied by removal or clear, runs no iteration} -body {
    ciRun "m = std::mutable_map::create\[int, int\]()\ns = digits(3)\ns.remove(0)\ns.remove(1)\ns.remove(2)\nt = digits(20)\nt.clear()\na = loop e in m:\n    e.key\nb = loop x in s:\n    x\nc = loop x in t:\n    x\n\[std::list::length(a), std::list::length(b), std::list::length(c)\]\n"
} -setup {set ::ciDecls "import std::list\n$::ciDecls"} -cleanup {set ::ciDecls [string range $::ciDecls 16 end]} -result {value {[0, 0, 0]}}

# ---------------------------------------------------------------------------
# Mutation during iteration: the snapshot

test ci-mutation-during-iteration {the loop iterates the collection as it was when it began: replacing a value, inserting, removing, clearing and growing the collection in the body change the collection, never what the loop visits} -body {
    ciRun "m = letters()\nseen = loop e in m:\n    m.set(e.key, e.value * 100)\n    m.set(std::str::concat(\"new\", e.key), 0)\n    r = m.remove(\"c\"):\n        on std::mutable_map::KeyNotFound:\n            -1\n    \[e.key, e.value\]\nafter = loop e in m:\n    \[e.key, e.value\]\ns = digits(3)\nxs = loop x in s:\n    s.clear()\n    loop k from 0 to 50:\n        s.add(k + 100)\n    x\n\[seen, after, xs, s.length()\]\n"
} -setup {set ::ciDecls "import std::str\n$::ciDecls"} -cleanup {set ::ciDecls [string range $::ciDecls 15 end]} -result {value {[[["a", 1], ["b", 2], ["c", 3]], [["a", 100], ["b", 200], ["newa", 0], ["newb", 0], ["newc", 0]], [0, 1, 2], 50]}}

test ci-mutation-in-function {the snapshot holds wherever the loop is: over a parameter, and over a place parameter the function updates in the body} -body {
    ciRun "fn sum(s: std::mutable_set::MutableSet\[int\]) -> List\[int\]:\n    loop x in s:\n        x * 2\nfn double_all(place s: std::mutable_set::MutableSet\[int\]) -> List\[int\]:\n    loop x in s:\n        s.remove(x)\n        s.add(x * 10)\n        x\ns = digits(4)\na = sum(s)\nb = double_all(s)\nc = loop x in s:\n    x\n\[a, b, c\]\n"
} -result {value {[[0, 2, 4, 6], [0, 1, 2, 3], [0, 10, 20, 30]]}}

test ci-nested {two loops over one collection, nested, are independent: each iterates its own snapshot} -body {
    ciRun "s = digits(3)\npairs = loop x in s:\n    ys = loop y in s:\n        x * 10 + y\n    ys\npairs\n"
} -result {value {[[0, 1, 2], [10, 11, 12], [20, 21, 22]]}}

test ci-snapshot-copies-only-when-needed {natively, a loop whose body does not touch the collection copies nothing; one that mutates it shares its headers once and detaches what it writes} -constraints nativeBuilt -body {
    set quiet [native::allocationReport [surface::compile "${::ciDecls}s = digits(100)\nacc = std::mutable_array::create(1, 0)\nloop x in s:\n    acc.set(0, x):\n        on IndexNotFound:\n            unit\nacc.capacity()\n" -warnings off] summary]
    set busy [native::allocationReport [surface::compile "${::ciDecls}s = digits(100)\nloop x in s:\n    s.add(x + 1000)\ns.length()\n" -warnings off] summary]
    list [dict get $quiet mutableVector shares] [dict get $quiet mutableVector detaches] \
        [expr {[dict get $busy mutableVector shares] > 0}] [expr {[dict get $busy mutableVector detaches] <= [dict get $busy mutableVector shares]}]
} -cleanup {unset -nocomplain quiet busy} -result {0 0 1 1}

test ci-no-materialization {natively, iterating a collection materializes nothing: a loop over a map's entries and a set's elements allocates the same at 1000 and at 2000 elements} -constraints nativeBuilt -body {
    set rows [lmap n {1000 2000} {
        set hir [surface::compile "${::ciDecls}fn build(place m: std::mutable_map::MutableMap\[int, int\], place s: std::mutable_set::MutableSet\[int\], i: int, n: int) -> unit:\n    if i >= n:\n        return unit\n    m.set(i, i * 2)\n    s.add(i)\n    build(m, s, i + 1, n)\nm = std::mutable_map::create\[int, int\]()\ns = std::mutable_set::create\[int\]()\nbuild(m, s, 0, $n)\nacc = std::mutable_array::create(1, 0)\nloop e in m:\n    acc.set(0, e.value):\n        on IndexNotFound:\n            unit\nloop x in s:\n    acc.set(0, x):\n        on IndexNotFound:\n            unit\nacc.capacity()\n" -warnings off]
        set report [native::allocationReport $hir summary]
        list [dict get $report total allocations] [dict get $report byKind Struct allocations] [dict get $report byKind List allocations]
    }]
    expr {[lindex $rows 0] eq [lindex $rows 1]}
} -cleanup {unset -nocomplain hir report n rows} -result 1

test ci-no-materialization-set {the same for a set alone, beside a map that is never iterated} -constraints nativeBuilt -body {
    set rows [lmap n {1000 2000} {
        set hir [surface::compile "${::ciDecls}fn build(place s: std::mutable_set::MutableSet\[int\], i: int, n: int) -> unit:\n    if i >= n:\n        return unit\n    s.add(i)\n    build(s, i + 1, n)\nm = letters()\ns = std::mutable_set::create\[int\]()\nbuild(s, 0, $n)\nacc = std::mutable_array::create(1, 0)\nloop x in s:\n    acc.set(0, x):\n        on IndexNotFound:\n            unit\nacc.capacity()\n" -warnings off]
        dict get [native::allocationReport $hir summary] total allocations
    }]
    expr {[lindex $rows 0] == [lindex $rows 1]}
} -cleanup {unset -nocomplain rows hir n} -result 1

# ---------------------------------------------------------------------------
# What is written out, and what is refused

test ci-elaborated {after the checks a loop over a collection is a counted loop over the protocol of a logical copy of it: the program's loop is a countloop from 0 whose body first skips a dead position, then binds the element, each operation a direct call} -body {
    set hir [surface::compile "${::ciDecls}xs = loop x in digits(3):\n    x\nxs\n" -warnings off]
    set loop ""
    dict for {e node} [dict get $hir exprs] {
        if {[dict get $node kind] eq "bind" && [dict get $node name] eq "xs"} {
            set loop [dict get $hir exprs [dict get $node value]]
        }
    }
    set names {}
    foreach x [list [dict get $loop end] [dict get $hir exprs [lindex [dict get $loop body] 0] condition] \
            [dict get $hir exprs [lindex [dict get $loop body] 1] value]] {
        set callee [dict get $hir exprs [dict get $hir exprs $x callee]]
        lappend names [dict get $hir bindings [dict get $callee binding] name] [lindex [dict get $hir exprs $x target] 0]
    }
    list [dict get $loop kind] [dict get $hir exprs [dict get $loop start] value] [dict get $hir exprs [lindex [dict get $loop body] 0] kind] $names
} -cleanup {unset -nocomplain hir loop e node names x callee} -result {countloop {int 0} if {std::mutable_set::iteration_end block std::mutable_set::iteration_live? block std::mutable_set::iteration_at block}}

test ci-lockstep-refused {a lockstep loop cannot iterate a collection: its clauses advance over a count the compiler proves equal, which a collection's is not (TYPE)} -body {
    ciDiagnostics "xs = loop x in digits(3) and i from 0 to 3:\n    x + i\nxs\n"
} -result {{TYPE 1}}

test ci-protocol-internal {the loop protocol is internal to the standard library: a program naming one of its operations, qualified or with method syntax, or importing the engine module, is refused} -body {
    set results {}
    foreach body [list "s = digits(2)\nstd::mutable_set::iteration_end(s)\n" \
            "s = digits(2)\ns.iteration_at(0)\n"] {
        catch {surface::compile "$::ciDecls$body" -warnings off} message options
        lappend results [lindex [dict get $options -errorcode] end]
    }
    catch {surface::compile "import std::ordered_table\n1\n" -warnings off} message options
    lappend results [lindex [dict get $options -errorcode] end]
} -cleanup {unset -nocomplain results body message options} -result {INTERNAL-NAMESPACE NOMETHOD-CALL INTERNAL-NAMESPACE}

test ci-other-structs-not-iterable {only the implementation's iterable structs are iterable: a loop over any other struct is the loop's ordinary TYPE failure, as before} -body {
    lindex [sourceAgree "struct P:\n    a: int\nxs = loop x in P {a: 1}:\n    x\nxs\n" {interp compile}] 0
} -result error

cleanupTests
