# unicode-lowercase.tcl -- the native runtime's lowercase table, generated
# from the reference (core::strings::lowercase: Unicode 16's simple,
# one-to-one mapping, README.md "Strings").
#
#   tclsh9.0 tools/unicode-lowercase.tcl generate   write the table
#   tclsh9.0 tools/unicode-lowercase.tcl check      exit 1 when the committed
#                                                   table is not what
#                                                   generation writes
#
# Writes native/src/runtime/lower16.rs, which rt_str_lower (ops.rs) reads.
# The native runtime used to take the mapping from Rust's standard library
# (`char::to_lowercase`) minus a list of scalars newer Unicode versions map:
# that list was the toolchain's, so every stable Rust that updated its
# Unicode tables changed what std::str::lowercase returns natively (rustc
# 1.97's Unicode 17 additions, then rustc 1.100's: MAIN-CI-FAILURES-2026-11-13.md).
# The table makes the mapping the language's, whatever rustc builds it.
#
# The table is runs (FIRST, LAST, STEP, DELTA), sorted by FIRST: every
# scalar FIRST, FIRST+STEP, ..., LAST lowercases to itself plus DELTA, and
# every other scalar to itself. tests/native-tcl-unicode.test runs `check`
# and compares the native runtime with the reference on every scalar.

set root [file dirname [file dirname [file normalize [info script]]]]
source [file join $root core core.tcl]

namespace eval lower16 {
    variable root $::root
    variable path [file join $::root native src runtime lower16.rs]
}

# Every scalar the reference maps to another scalar, as {CP LOWER} pairs in
# code point order. A mapping that is not one scalar is an error: the
# reference is the simple mapping.
proc lower16::Pairs {} {
    set pairs {}
    for {set cp 0} {$cp < 0x110000} {incr cp} {
        if {$cp >= 0xD800 && $cp <= 0xDFFF} continue
        set c [format %c $cp]
        set l [core::value::strOf [core::strings::lowercase [core::value::str $c]]]
        if {$l eq $c} continue
        if {[string length $l] != 1} {
            error [format "U+%04X lowercases to %d scalars: the reference is no simple mapping" $cp [string length $l]]
        }
        scan $l %c lower
        lappend pairs [list $cp $lower]
    }
    return $pairs
}

# PAIRS as runs {FIRST LAST STEP DELTA}: a run grows while the next pair is
# its last scalar plus its step and has its delta; its step (1 or 2) is set
# by its second pair.
proc lower16::Runs {pairs} {
    set runs {}
    set run {}
    foreach pair $pairs {
        lassign $pair cp lower
        set delta [expr {$lower - $cp}]
        if {$run ne ""} {
            lassign $run first last step d
            set gap [expr {$cp - $last}]
            if {$d == $delta && (($step == 0 && $gap in {1 2}) || ($step != 0 && $gap == $step))} {
                set run [list $first $cp $gap $d]
                continue
            }
            lappend runs $run
        }
        set run [list $cp $cp 0 $delta]
    }
    if {$run ne ""} {
        lappend runs $run
    }
    # A run of one scalar has step 1.
    return [lmap run $runs {
        lassign $run first last step d
        list $first $last [expr {$step == 0 ? 1 : $step}] $d
    }]
}

proc lower16::Text {} {
    set pairs [Pairs]
    set runs [Runs $pairs]
    set lines [list \
        "// lower16.rs -- GENERATED by tools/unicode-lowercase.tcl from" \
        "// core::strings::lowercase (Unicode 16's simple lowercase mapping):" \
        "// do not edit. Regenerate with `tclsh9.0 tools/unicode-lowercase.tcl" \
        "// generate`; tests/native-tcl-unicode.test checks it." \
        "//" \
        "// [llength $pairs] scalars in [llength $runs] runs (FIRST, LAST, STEP, DELTA): every" \
        "// scalar FIRST, FIRST+STEP, ..., LAST lowercases to itself plus DELTA, every" \
        "// other scalar to itself. Sorted by FIRST; runs do not overlap." \
        "" \
        "pub(crate) static RUNS: \[(u32, u32, u32, i32); [llength $runs]\] = \["]
    foreach run $runs {
        lassign $run first last step delta
        lappend lines [format "    (0x%04X, 0x%04X, %d, %d)," $first $last $step $delta]
    }
    lappend lines "\];" "" \
        "/// C's Unicode 16 simple lowercase: the run holding C maps it, any other" \
        "/// scalar is its own lowercase." \
        "pub(crate) fn lower(c: char) -> char \{" \
        "    let cp = c as u32;" \
        "    let i = RUNS.partition_point(|&(first, _, _, _)| first <= cp);" \
        "    if i == 0 \{" \
        "        return c;" \
        "    \}" \
        "    let (first, last, step, delta) = RUNS\[i - 1\];" \
        "    if cp > last || (cp - first) % step != 0 \{" \
        "        return c;" \
        "    \}" \
        "    char::from_u32(cp.wrapping_add_signed(delta)).expect(\"a lowercase table entry maps to a scalar\")" \
        "\}"
    return "[join $lines \n]\n"
}

proc lower16::Committed {} {
    variable path
    if {![file exists $path]} {
        return ""
    }
    set channel [open $path r]
    fconfigure $channel -encoding utf-8 -translation lf
    set text [read $channel]
    close $channel
    return $text
}

switch -- [lindex $argv 0] {
    generate {
        set channel [open $lower16::path w]
        fconfigure $channel -encoding utf-8 -translation lf
        puts -nonewline $channel [lower16::Text]
        close $channel
        puts "wrote $lower16::path"
    }
    check {
        if {[lower16::Committed] ne [lower16::Text]} {
            puts stderr "$lower16::path is not what tools/unicode-lowercase.tcl generate writes: regenerate it"
            exit 1
        }
        puts "ok: $lower16::path"
    }
    default {
        puts stderr "usage: tclsh9.0 tools/unicode-lowercase.tcl generate|check"
        exit 2
    }
}
