# demo.bot -- a Botlish caller of the generated bgf binding (C-BINDGEN.md,
# "The synthetic fixture"). caller.c computes the same list with C calls of
# the header's own API; tests/c-bindgen.test runs both and compares them value
# for value (`tools/c-bindgen.tcl run fixture` runs this one).
#
# A direct module: bgf_unnamed's pointer parameter has no contract (unknown
# escape), so calling it is direct authority, acknowledged here; the binding
# modules themselves stay ordinary.
direct module

import std::abi
import std::abi::bytes
import std::byte
import std::ffi::c
import std::list
import std::str
import bgf::bgf
import bgf::ctypes
import bgf::thunks::bgf
import bgf::types

fn nul() -> std::byte::Byte:
    0

# The bytes of TEXT and the NUL the C API needs.
fn cstring(text: str) -> std::abi::bytes::Bytes:
    std::abi::bytes::from_list(std::str::encode_utf8(text).append(nul()))

fn byte_of(n: int) -> std::byte::Byte:
    if n >= 0 and n <= 255:
        return n
    0

fn bytes_of(values: List[int]) -> std::abi::bytes::Bytes:
    bytes = loop v in values:
        byte_of(v)
    std::abi::bytes::from_list(bytes)

fn text(s: str) -> std::abi::bytes::Bytes:
    std::abi::bytes::from_list(std::str::encode_utf8(s))

# C types for the trailing arguments of the variadic bgf_printf, which have no
# declared parameter type to prove a value against (VARIADICS-VERTICAL-
# SLICE-1.md): converters, functions whose declared result is the type.
fn c_int(x: std::ffi::c::Int) -> std::ffi::c::Int:
    x

fn c_long(x: std::ffi::c::Long) -> std::ffi::c::Long:
    x

handle = cstring("alpha").bgf_open(1)
alias = handle.clone()
window = bgf::bgf::bgf_window_of(alias)
nothing = std::ffi::c::null[std::ffi::c::Char]()
missing = cstring("beta").bgf_open(1)
filled = std::abi::bytes::zeroed(std::abi::usize(3)).bgf_fill(3, 7)
digest = text("abc").bgf_digest(3, std::abi::bytes::zeroed(std::abi::usize(4)))
fill_bytes = std::abi::bytes::freeze(filled.out)
digest_bytes = std::abi::bytes::freeze(digest.out)
id_handle = handle.clone()
handle_id = id_handle.bgf_handle_id()
twin = std::ffi::c::null[bgf::ctypes::bgf_twin]()
twin_struct = std::ffi::c::null[bgf::ctypes::bgf_twin_struct]()
twins = twin.bgf_twins(twin_struct)
summed = cstring("dldfp").bgf_printf(c_int(5), c_long(-7), c_int(30), 2.75, nothing)
printed = cstring("dd").bgf_print(c_int(7), c_int(8))
bgf::bgf::bgf_close(handle)
[2.bgf_add(3),
 bgf::bgf::bgf_length(cstring("hello")),
 1.bgf_mix(-2, 3, 4, -5, 6),
 bgf::bgf::bgf_count(),
 bgf::bgf::bgf_plain_char(65),
 1.bgf_keywords(2, 3, 4, 5),
 10.bgf_unnamed(nothing),
 filled.result,
 fill_bytes == bytes_of([7, 44, 81]),
 digest_bytes == bytes_of([128, 160, 192, 4]),
 bgf::bgf::bgf_labeled(2),
 bgf::bgf::bgf_renamed(2),
 bgf::bgf::bgf_current(2),
 bgf::bgf::bgf_legacy(2),
 20.bgf_call_add(22),
 bgf::thunks::bgf::bgf_square(7),
 bgf::thunks::bgf::BGF_TWICE(21),
 bgf::thunks::bgf::bgf_get(3),
 bgf::thunks::bgf::bgf_shadowed(1),
 bgf::bgf::BGF_FLAG_ALL,
 bgf::bgf::BGF_BIG,
 bgf::bgf::BGF_SIZE_NONE,
 bgf::bgf::BGF_NEGATIVE,
 bgf::bgf::BGF_CHAR,
 bgf::bgf::BGF_BLUE,
 bgf::bgf::bgf_next_color(bgf::bgf::BGF_GREEN),
 window.null?(),
 missing.null?(),
 bgf::bgf::bgf_is_even(4),
 bgf::bgf::bgf_flip(true),
 handle_id,
 twins,
 bgf::bgf::BGF_HIGH_CHAR,
 summed,
 printed]
