# sdl3.tcl -- the SDL3 binding profile (C-BINDGEN.md, "SDL3"): the breadth
# test. The whole public header set SDL3/SDL.h includes, generated by the
# normal rules, no API selected by hand.
#
# Pinned: SDL release-3.4.18 (its commit checked by the fetch); the
# acceptance's library is built from the same source (tests/cffi/sdl3.tcl).
# Modules: SDL_video.h is sdl3::video, SDL_render.h sdl3::render, ...
#
# Targets: the Linux ones are committed (generated/c/sdl3/TARGET/), macOS's
# needs the macOS SDK, and windows-x86_64 (MSVC's ABI) is generated on
# Windows, where clang's MSVC target finds Visual Studio's and the Windows
# SDK's headers: the Icy Tower Windows build generates it
# (examples/games/icy-tower/build-windows.sh, ICY-TOWER-WINDOWS.md), and
# none is committed.
#
# Manual policy: the window-title contracts the acceptance needs (SDL
# copies the title: SDL_video.h documents it as the window's title in
# UTF-8, which SDL_CreateWindow stores in its own window structure), so a
# NUL-terminated Botlish Bytes can be exposed for the call; and the new
# window SDL_CreateWindow returns points into no argument (independent),
# which a call exposing the title must state.
dict create \
    name sdl3 \
    description "SDL 3.4.18's public C API (SDL3/SDL.h and every header it includes)" \
    headers {
        library sdl3
        source {url https://github.com/libsdl-org/SDL tag release-3.4.18 commit 829a65d769d935c4852f8159e964312c0957260a}
        includeDirs {include}
        public {include/SDL3/*}
        entry {SDL3/SDL.h}
    } \
    targets {linux-x86_64 linux-aarch64 macos-aarch64 windows-x86_64} \
    modules {stripPrefix SDL_} \
    libraries {
        {headers * targets * names {SDL3}}
    } \
    contracts {
        SDL_CreateWindow {title {read noescape} result independent}
        SDL_SetWindowTitle {title {read noescape}}
    } \
    evidence llvm
