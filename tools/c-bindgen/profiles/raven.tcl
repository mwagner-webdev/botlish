# raven.tcl -- the Raven binding profile (RAVEN-BINDINGS.md).
#
# Raven (github.com/oscar-soirey/Raven, Apache License 2.0) is a retained-mode
# GUI library in C11: native windows (Win32, X11, Cocoa) drawn with Vulkan,
# every object an opaque uint32_t handle (Rid), booleans as int, colors as
# four floats. The whole public API is include/Raven.h and the headers it
# includes (include/raven/raven_*.h), generated by the normal rules with no
# API selected by hand.
#
# Pinned: Raven v0.1.3 (its commit checked by the fetch); the acceptance's
# library is built from the same source (tests/cffi/raven.tcl).
# Modules: raven_core.h is raven::core, raven_window.h raven::window, ...
#
# Targets: the Linux ones. Raven's headers include only <stdint.h> and
# <stddef.h>; macOS and Windows need their own toolchains' headers and are
# not generated here (RAVEN-BINDINGS.md, "Targets").
#
# Manual policy: Raven documents one rule for every string it is given
# (raven_core.h's conventions, "strings are UTF-8 and always copied by the
# library"; the guide's "Names": "strings are UTF-8 and always copied by the
# library"): a `const char *` parameter is read during the call and never
# kept. So each one is `read noescape`, stated below per parameter name for
# the explicit list of functions that have it -- every `const char *`
# parameter of the public headers, written out, never a rule by C type
# (C-BINDGEN.md, "Contracts"). Pointers to anything else (out-parameters,
# descriptors, user data, callbacks) carry no fact: unknown.
dict create \
    name raven \
    description "Raven 0.1.3's public C API (Raven.h and every header it includes)" \
    headers {
        library raven
        source {url https://github.com/oscar-soirey/Raven tag v0.1.3 commit cd228d8ec05e1b8f1e85ae2520600835ad2c3585}
        includeDirs {include}
        public {include/Raven.h include/raven/*.h}
        entry {Raven.h}
    } \
    targets {linux-x86_64 linux-aarch64} \
    modules {stripPrefix raven_} \
    libraries {
        {headers * targets * names {raven}}
    } \
    groups {
        {functions {Rwindow_register_shortcut Rwidget_set_action} facts {action {read noescape}}}
        {functions {Rwidget_set_text_key} facts {attribute {read noescape}}}
        {functions {Rblock_editor_add_kind Rblock_editor_set_category_color} facts {category {read noescape}}}
        {functions {Rwidget_set_class} facts {classes {read noescape}}}
        {functions {Rlocale_set_language Rlocale_set_fallback_language} facts {code {read noescape}}}
        {functions {Rlocale_load_csv_from_memory} facts {csv {read noescape}}}
        {functions {Rdrag_begin Rfont_create Rtexture_create Rtexture_create_async} facts {data {read noescape}}}
        {functions {Rwidget_set_accessible_description} facts {description {read noescape}}}
        {functions {Rtext_editor_add_completion} facts {detail {read noescape}}}
        {functions {Rfile_browser_set_default_extension} facts {extension {read noescape}}}
        {functions {Rlocale_set_text Rtr Rtr_exists Rtr_format Rtr_plural Rwidget_set_text_key} facts {key {read noescape}}}
        {functions {Rblock_editor_add_block Rblock_editor_set_slot_options Rblock_editor_set_kind_visible Rblock_editor_set_kind_label} facts {kind {read noescape}}}
        {functions {Rdrag_begin Rtimeline_add_clip Rtimeline_add_marker Rtimeline_set_item_label Rnode_graph_add_input Rnode_graph_add_output Rblock_editor_add_kind Rblock_editor_set_kind_label} facts {label {read noescape}}}
        {functions {Rlocale_set_text} facts {language {read noescape}}}
        {functions {Rdock_area_load_layout} facts {layout {read noescape}}}
        {functions {Rtext_editor_add_marker} facts {message {read noescape}}}
        {functions {Raction_bind Raction_unbind Raction_fire Rtheme_use Rtheme_save Rwidget_set_name Rwidget_find Rwidget_set_theme Rlanguage_get Rtext_editor_set_language Rtimeline_add_track Rtimeline_set_track_name Rnode_graph_set_node_name Rnode_graph_find_node Rnode_graph_set_pin_name Rnode_graph_find_pin Rblock_editor_add_kind Rfile_browser_set_file_name Rfile_browser_select Reffect_find Rxml_unregister_widget Rxml_is_widget_registered Rwidget_set_attribute Rxml_node_get_attribute Rxml_node_set_attribute Rwidget_set_accessible_name} facts {name {read noescape}}}
        {functions {Rblock_editor_set_slot_options} facts {options {read noescape}}}
        {functions {Rtheme_load Rtheme_save Rfont_create_from_file Rtexture_create_from_file Rtexture_create_from_file_async Rlanguage_for_file Rfile_register_memory Rfile_unregister_memory Rfile_is_memory Rfile_read Rfile_write Rfile_browser_set_directory Rshader_create_from_file Rwindow_create_from_xml_file Rwidget_create_from_xml_file Rxml_set_base_path Rxml_register_widgets_from_file Rxml_resolve_path Rxml_document_load Rxml_document_save Rlocale_load_csv} facts {path {read noescape}}}
        {functions {Rxml_document_create} facts {root_tag {read noescape}}}
        {functions {Rwindow_create_from_compiled Rwidget_create_from_compiled} facts {source {read noescape}}}
        {functions {Rtheme_set_style_color Rtheme_set_style_metric Rtheme_set_style_material Rwidget_add_class Rwidget_remove_class Rwidget_has_class} facts {style_class {read noescape}}}
        {functions {Rxml_register_tag Rxml_unregister_tag Rxml_is_tag_registered Rxml_node_set_tag Rxml_node_add_child Rxml_get_tag_description Rxml_get_tag_children Rxml_get_attribute_count Rxml_get_attribute_info} facts {tag {read noescape}}}
        {functions {Rclipboard_set_text Rwindow_inject_text Rwindow_inject_drop Rfont_measure_text Rwidget_set_tooltip Rlabel_create Rlabel_set_text Rbutton_create Rbutton_set_text Rcheckbox_create Rcheckbox_set_text Rtext_input_set_text Rtext_input_set_placeholder Rcombo_box_add_item Rlist_view_add_item Rlist_view_set_item_text Rtree_view_add_item Rtree_item_set_text Rmenu_add_item Rmenu_item_set_text Rtile_view_set_empty_text Rtext_editor_create Rtext_editor_set_text Rtext_editor_insert_text Rtext_editor_set_placeholder Rtext_editor_add_completion Rcolor_picker_set_hex Rnode_graph_set_node_badge Rblock_editor_load Rmessage_box Rdraw_text Rxml_node_set_text Rxml_node_add_comment Rlocale_set_text Raccessibility_announce} facts {text {read noescape}}}
        {functions {Rwindow_create Rwindow_set_title Rslot_set_title Rtab_view_add_tab Rtab_view_set_tab_title Rexpander_set_title Rmenu_add_menu Rmenu_set_title Rheader_bar_create Rheader_bar_set_title Rdock_area_add_panel Rdock_area_set_panel_title Rnode_graph_add_node Rnode_graph_set_node_title Rmessage_box} facts {title {read noescape}}}
        {functions {Rdrag_begin Rtree_view_set_drag_type Rtile_view_set_drag_type Rnode_graph_add_input Rnode_graph_add_output Rnode_graph_set_type_color} facts {type {read noescape}}}
        {functions {Ropen_url} facts {url {read noescape}}}
        {functions {Rblock_editor_set_value Rwidget_set_attribute Rxml_node_set_attribute} facts {value {read noescape}}}
        {functions {Rtheme_set_style_color Rtheme_set_style_metric Rtheme_set_style_material} facts {widget {read noescape}}}
        {functions {Rtheme_load_from_memory Rwindow_create_from_xml Rwidget_create_from_xml Rxml_register_widgets Rxml_document_parse Rxml_node_add_xml} facts {xml {read noescape}}}
    } \
    evidence llvm
