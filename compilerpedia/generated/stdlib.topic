@caption Proven slices need no handler
@value ["el", "B", ""]
@end

@example accept
import std::str

fn cut(s: str, a: int, b: int) -> str:
    t = s.substring(a, b):
        on LowerUnderrun:
            "below"
        on UpperOverrun:
            "above"
    t

