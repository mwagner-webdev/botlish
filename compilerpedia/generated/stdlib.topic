    abi::bytes::MutableBytes       opaque struct
    abi::bytes::detach             function -- DATA itself, as a value (a l...
    abi::bytes::freeze             function -- An immutable snapshot of all...
    abi::bytes::freeze_prefix      function -- An immutable snapshot of the...
