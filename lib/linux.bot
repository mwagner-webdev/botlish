# linux.bot -- the "linux" namespace: thin, ordinary-Botlish wrappers over
# the raw Linux x86-64 syscall transport (LINUX-X86-64-SYSCALL.md,
# ABI-BYTES.md).
#
# `linux::abi::syscall` (a different namespace, the one privileged
# operation) is the generic kernel transition: seven register words in, the
# raw rax out, no syscall known to the compiler. This module is policy above
# it, written in Botlish: which syscall number, which register carries which
# argument, and how a Botlish value becomes register contents.
#
#   linux::write(fd, data)    write(2): ONE syscall, the kernel's raw
#                             signed result as an ordinary Int.
#   linux::read(fd, data)     read(2): ONE syscall into the caller's
#                             abi::bytes::MutableBytes (MUTABLE-BYTES.md); the
#                             kernel's raw signed result and the updated
#                             buffer come back in a linux::ReadResult.
#
# write is the first syscall that moves memory, so it is also the first that
# needs the memory boundary this milestone adds (ABI-BYTES.md): its buffer is
# an abi::bytes::Bytes -- an immutable, owned, contiguous byte value -- and both the
# address and the byte count are derived from that ONE value. The wrapper
# deliberately has no `count` parameter: a separate count could disagree with
# the buffer, and `write(fd, bytes, count)` is exactly the pointer/length
# mismatch the safe wrapper exists to rule out. The raw syscall still
# receives the address (rsi) and the count (rdx) in separate registers,
# because that is machine reality; the Botlish function keeps the two facts
# coupled.
#
# The machine address is taken by `abi::x86_64::from_bytes(data)`, a raw
# architecture bridge, and consumed synchronously by the syscall in the same
# function: the address is never returned, stored or retained, and the
# compiler keeps `data`'s storage alive until the kernel has returned
# (native/lower.tcl's `keepalive`). Nothing here can retain a pointer after
# the call -- that belongs to a future resource/context design.
#
# Syscall-level semantics, deliberately thin (no errno layer yet):
#
# * The result is the raw signed rax as an Int, by abi::x86_64::to_int: n >=
#   0 is the number of bytes written; a negative n is the kernel's -errno
#   (-9 for a bad file descriptor on Linux), preserved exactly -- never
#   reread as an unsigned number, never turned into -1/errno. A later,
#   higher-level wrapper can translate negative results into Botlish errors.
# * ONE write call. A successful write may write fewer bytes than the Bytes
#   holds (a pipe, a signal, a full disk): the wrapper does not loop, retry
#   or complete the write; the result says how much happened. Completion is
#   a policy for a higher I/O abstraction.
# * Native only (Linux x86-64): the Tcl backends refuse the syscall
#   (NATIVE-ONLY) exactly as they refuse getpid; nothing imitates a write
#   with puts or a Tcl channel.
import abi
import abi::bytes
import abi::x86_64
import linux::abi

# write(2): SYS_write = 1, rdi = fd, rsi = the address of data's payload,
# rdx = data's byte count.
fn write(fd: abi::I32, data: abi::bytes::Bytes) -> int:
    abi::x86_64::to_int(
        linux::abi::syscall({
            rax: abi::x86_64::register64(1),
            rdi: abi::x86_64::from_i32(fd),
            rsi: abi::x86_64::from_bytes(data),
            rdx: abi::x86_64::from_usize(abi::bytes::length(data)),
        })
    )

# What read(2) did, with both halves kept: the kernel's raw signed ssize_t
# (> 0 the bytes read, 0 end of file, < 0 the kernel's -errno, exactly) and
# the buffer as the kernel left it. Not a tuple, not an error: the caller
# decides what a short read, EOF or a negative result means.
struct ReadResult:
    result: int
    data: abi::bytes::MutableBytes

# read(2): SYS_read = 0, rdi = fd, rsi = the address of the buffer's payload,
# rdx = the buffer's byte count.
#
# * LOGICAL COPY. `data` is a value: the caller's buffer is never changed.
#   The kernel writes into this function's own copy (`local`, the writable
#   address bridge's operand: a freshly detached storage nothing else
#   observes), and that same copy is returned as the result's `data`. A
#   caller that keeps `original` and calls read(fd, original) still holds
#   the unchanged bytes; the bytes the kernel wrote are in result.data. (An
#   optimizer that proves `data` dead may write into its storage directly;
#   nobody could tell.)
# * ONE buffer, one source of truth. There is no `count` parameter: the
#   address and the count both come from the same MutableBytes (the raw
#   syscall still receives them in separate registers).
# * ONE syscall: no retry, no loop, no filling. A positive result smaller
#   than the buffer is normal (a short read): only the prefix
#   [0, result) was written, the rest holds what it held before. 0 is end of
#   file, not an error. A negative result is the kernel's -errno, preserved
#   exactly (-9 for a bad descriptor), and the buffer is then unchanged.
# * The buffer keeps its length; nothing is resized to the byte count. Take
#   the bytes actually read with abi::bytes::freeze_prefix(result.data,
#   abi::usize(result.result)).
# * The address is taken and consumed synchronously; the compiler keeps the
#   storage alive until the kernel has returned (native/lower.tcl).
fn read(fd: abi::I32, data: abi::bytes::MutableBytes) -> ReadResult:
    local = abi::bytes::detach(data)
    result = abi::x86_64::to_int(
        linux::abi::syscall({
            rax: abi::x86_64::register64(0),
            rdi: abi::x86_64::from_i32(fd),
            rsi: abi::x86_64::from_mutable_bytes(local),
            rdx: abi::x86_64::from_usize(abi::bytes::mutable_length(local)),
        })
    )
    ReadResult {result: result, data: local}
