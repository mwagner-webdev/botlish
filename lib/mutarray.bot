# mutarray.bot -- the "mutarray" namespace: construction of MutableArray
# (core/mutarray.tcl) from ordinary Botlish values.
#
#   mutarray::from_list(xs)        a fresh MutableArray whose capacity is
#                                  list_length(xs) and whose slot i holds
#                                  list_get(xs, i), for every i in order.
#   mutarray::create(capacity, d)  a fresh MutableArray of CAPACITY slots,
#                                  every slot holding D.
#
# No new runtime operation backs either: they are ordinary functions over the
# existing substrate (mutable_array_allocate, mutable_array_set), exactly the
# allocate-then-fill sequence the stdlib builders (examples/stdlib) write by
# hand, so the runtime construction path (allocation, rooting, bounds
# checks) is the existing one, unchanged.
#
# Semantics, all inherited from that substrate rather than defined here:
#   * the result is a new, distinct MutableArray (mutable_array_allocate's
#     own fresh identity); XS is only read, so it stays the same immutable
#     List and later mutation of the result never reaches it;
#   * slots hold the given values as-is (the same immutable values, and the
#     same handle for a nested MutableArray -- values are shared, never
#     copied deeply); for `create` every slot holds the same value D;
#   * element order is preserved; the empty List / capacity 0 give a
#     capacity-0 array;
#   * a negative or impossible capacity is rejected by
#     mutable_array_allocate itself (RANGE), exactly like a raw allocation;
#   * a non-List XS / non-Int CAPACITY is rejected by the declared parameter
#     contract under Botlish's ordinary typed-parameter rule, never coerced.
#
# Static typing (PARAMETERIZED-MUTABLEARRAY.md). The declared result below is
# the raw kind -- what the bodies themselves produce -- but both functions
# are *intrinsic container operations*: the compiler types a call of either
# from its argument types, keyed to this resolved library function
# (hir/containers.tcl), not to its spelling:
#
#   from_list(xs : List[T])       -> MutableArray[T]   (list -> MutableArray[any])
#   create(capacity, d : T)       -> MutableArray[T]
#
# MutableArray[T] is a compile-time contract only: every slot holds a T and
# every store must preserve that. `create` initializes every slot, so the
# contract holds from the first instant; for capacity 0 there is no slot,
# and T is still the static type of D. Botlish has no general type variables,
# so this relation cannot be written as a function type; a callable *value*
# of either function (viewed through a structural Fn) exposes only the raw
# `mutarray` result.
namespace mutarray

fn from_list(xs: list) -> mutarray:
    count = list_length(xs)
    storage = mutable_array_allocate(count)
    loop i from 0 to count:
        mutable_array_set(storage, i, list_get(xs, i))
    storage

fn create(capacity: int, default) -> mutarray:
    storage = mutable_array_allocate(capacity)
    loop i from 0 to capacity:
        mutable_array_set(storage, i, default)
    storage
