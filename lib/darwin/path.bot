# path.bot -- the "darwin::path" namespace: textual macOS (Darwin) paths
# (CONTEXT-TRAITS.md, "Paths"; MACOS-AARCH64-MILESTONE-8.md).
#
#   darwin::path::validate(value)       proves VALUE a DarwinPath, or io::path::NotAPath
#   darwin::path::valid?(value)         true proves VALUE a DarwinPath
#   darwin::path::concat(path, part)    PATH joined with PART: a DarwinPath
#   darwin::path::text(path)            PATH's String form (the carrier)
#
# DarwinPath is a refinement of str (REFINEMENT-VALUES.md): a value proven to
# be a non-empty String without U+0000 -- text that may be handed to
# libSystem as an ordinary C pathname once it is encoded as UTF-8 and given
# its terminating NUL (darwin::open and darwin::create do that, for the one
# call). It is the same String, with the String's representation, so a
# validated value keeps being used as text with no conversion. It is
# linux::path::LinuxPath's sibling, not a shared type: each platform owns its
# textual path, and io::path::Path is what portable code names.
#
# The proposition is textual eligibility and nothing more. It does NOT claim
# that the path exists, is readable or writable, is a file or a directory,
# resolves through symlinks, is canonical, is shorter than PATH_MAX or a
# filesystem's name limit, is normalized the way APFS compares names, or is
# meaningful relative to the current working directory: those are facts
# about the environment at some moment, never about the String, and
# validation observes no filesystem. Nor does it claim to represent every
# Darwin directory entry: Darwin names are bytes, and arbitrary-byte paths
# belong to a lower-level abstraction. Validation does not normalize: ".",
# "..", "./a", "../a", "a//b" and "/a/b" are valid exactly as written.
#
# DarwinPath satisfies the portable io::path::Path trait through this
# module's own `concat` and `text` (TRAITS.md: the owner's declarations,
# nothing else), so a function over io::path::Path specializes to direct
# calls of them.
import char
import str
import io::path

refined type DarwinPath = str

# true when no character of VALUE is U+0000.
fn nul_free?(value: str) -> bool:
    loop i from 0 to value.length():
        if value.char_at(i).scalar_value() == 0:
            return false
    true

# true when VALUE is a valid textual Darwin path (non-empty, no U+0000), which
# proves it a DarwinPath; false proves nothing.
fn valid?(value: str) -> bool proves value: DarwinPath:
    value.length() > 0 and value.nul_free?()

# Completes normally only when VALUE is a valid textual Darwin path, which
# proves it a DarwinPath for the rest of the caller's path; fails with
# io::path::NotAPath otherwise.
fn validate(value: str) -> unit proves value: DarwinPath errors io::path::NotAPath:
    if valid?(value):
        unit
    else:
        fail io::path::NotAPath

# The path's canonical String form: exactly the carrier String (lossless; no
# escaping, quoting or display conversion).
fn text(path: DarwinPath) -> str:
    path

# true when TEXT's last character is "/".
fn ends_with_slash?(text: str) -> bool:
    n = text.length()
    if n == 0:
        return false
    # n - 1 is TEXT's last index; the index proof does not relate it to the
    # length, so the handler answers for the case it excludes.
    last = text.char_at(n - 1):
        on IndexNotFound:
            return false
    last == '/'

# PATH joined with COMPONENT: one "/" between them unless PATH already ends
# with one. COMPONENT is a relative path fragment -- non-empty, without
# U+0000, not starting with "/" (an absolute component would replace PATH,
# which joining never does) -- and may itself contain "/", "." or "..";
# nothing is normalized and no filesystem is observed. Fails with
# io::path::NotAPath for any other COMPONENT. The result is a DarwinPath by
# validation, the ordinary owner proof.
fn concat(path: DarwinPath, component: str) -> DarwinPath errors io::path::NotAPath:
    m = component.length()
    if m == 0 or component.char_at(0) == '/' or not valid?(component):
        fail io::path::NotAPath
    joined = if ends_with_slash?(path):
        str::concat(path, component)
    else:
        str::concat(path.append_char('/'), component)
    validate(joined)
    joined
