# abi.bot -- the "abi" namespace: ABI numeric domains (ABI-NUMERIC-DOMAINS.md).
#
# These are ABI numeric DOMAINS, not fixed-width arithmetic types. An ABI
# numeric value is an ordinary mathematical Botlish Int together with the
# static proof that it lies in one declared foreign-interface domain:
#
#   x = abi::i32(n)     x represents exactly the Int n, and proves
#                       -2^31 <= n <= 2^31 - 1
#   x = abi::u32(n)     x represents exactly the Int n, and proves
#                       0 <= n <= 2^32 - 1
#
# Nothing else. There is no 32-bit (or 8-, 16-, 64-bit) arithmetic, no
# wrapping, saturation, truncation, C promotion, implicit narrowing or
# widening, undefined overflow, bitwise operation or pointer meaning
# anywhere here. Each type is a nominal struct, so `abi::u8(255) + 1` is the
# ordinary TYPE error any struct operand gets -- it is never 0 and never
# 256. Computation happens in Int, and a result re-enters a domain only
# through a checked (or statically proven) conversion:
#
#   n = x.value             # back to the ordinary Int (exactly 255)
#   y = abi::u8(n + 1)      # 256: the declared error AbiIntegerAboveRange
#
# so fixed-width representation concerns stay at foreign boundaries:
#
#   ordinary computation in Int
#       --abi::u32(...)-->           abi::U32       checked/proven domain
#       --abi::x86_64::from_u32-->   Register64     x86-64 transport
#       --linux::abi::syscall-->     the kernel
#
# The family (exact inclusive domains):
#
#   I8     -128 .. 127
#   I16    -32768 .. 32767
#   I32    -2147483648 .. 2147483647
#   I64    -9223372036854775808 .. 9223372036854775807
#   U8     0 .. 255
#   U16    0 .. 65535
#   U32    0 .. 4294967295
#   U64    0 .. 18446744073709551615
#   Isize  signed ABI address/size-width integer
#   Usize  unsigned ABI address/size-width integer
#
# U64 is the full unsigned 64-bit domain, 2^63 .. 2^64 - 1 included: Botlish
# Int is arbitrary precision, so a value above the signed 64-bit range is an
# ordinary Int (a BigInt natively, when it is not a constant), never
# reduced to 0 .. 2^63 - 1 for the sake of a representation.
#
# Every type is ordinary Botlish, built from three ordinary declarations and
# nothing compiler-defined:
#
#   type I32Value = Int in -2147483648..2147483647
#                               the domain (an Int subtype: range analysis,
#                               completion proofs and native lowering read
#                               its interval like any source domain's)
#   struct I32: value: I32Value
#                               the nominal type
#   fn i32(value: int) -> I32 errors ...
#                               the checked creator
#
# * Creation. abi::i8(value) ... abi::usize(value) take an ordinary Int and
#   either return the ABI value representing exactly that Int, or fail with
#   AbiIntegerBelowRange (value < the domain's minimum) or
#   AbiIntegerAboveRange (value > its maximum). Never truncation. The
#   call-specific completion proof (STATIC-COMPLETION-PROOFS.md) makes a
#   provably in-range argument (abi::u8(42)) need no handler and a provably
#   out-of-range constant (abi::u8(256)) a compile-time KNOWN-ERROR; a
#   dynamic Int keeps the ordinary obligation to handle or declare them.
#   Direct construction (`abi::U8 {value: x}`) is equally sound with no
#   privacy: a named construction must statically prove each field in its
#   declared domain (STRUCTS.md), so no ABI value outside its domain exists.
# * Back to Int. `x.value` is the mathematical Int x represents, exactly
#   (U8 255 -> 255, I8 -1 -> -1, U64 2^64 - 1 -> 18446744073709551615): an
#   ordinary field projection, uniform over the whole family, statically
#   typed with the domain (so `byte::from_int(x.value)` needs no handler for
#   `x: abi::U8`). It never sign-extends, truncates or reinterprets bits.
#   There is no abi::to_int: Botlish has no overloading, and one function
#   over ten nominal types would need it (or ten *_to_int functions that
#   only repeat the projection).
# * Nominal. abi::I32 and abi::U32 are distinct types even where their values
#   overlap; so are abi::I64 and abi::Isize, and abi::U64 and abi::Usize,
#   whose domains are identical on today's target. `fn f(x: abi::Usize)`
#   does not accept an abi::U64. The explicit route is through Int:
#   `abi::usize(u.value)`, which needs no handler (the projection proves the
#   domain) and has no run-time check.
# * Not a calling convention. `fn f(x: abi::I32)` says x is mathematically in
#   the signed 32-bit range; it does not fix how a Botlish function
#   physically receives it (natively: the one Int field, carried in a
#   register by struct scalar replacement). Machine meaning starts only at
#   an explicit architecture conversion (abi::x86_64::from_i32, ...).
# * Not C. U32 is the unsigned 32-bit domain, not "C unsigned int"; Usize
#   is the target's address/size-width unsigned domain, not size_t. A later
#   C layer may map its target-dependent types onto these.
# * Not collection lengths. list::length, string lengths and indexes are
#   ordinary Int; Isize/Usize are for foreign ABI boundaries only.
#
# abi::Bytes (below, ABI-BYTES.md) is the first ABI value that is memory
# rather than a number: an immutable, owned, contiguous sequence of bytes.
#
# The domain types (I8Value ... UsizeValue) are members of namespace abi,
# like the structs and creators: abi::U8Value (IMPORTS.md). A consumer
# either spells one qualified after `import abi` (`x: abi::U8Value`) or
# binds the short name with `import type abi::U8Value`; the two errors
# stay program-global names, as every `error` declaration is
# (hir/errordecls.tcl), hence their Abi prefix.
import type byte::Byte
import byte_store

# The two declared errors of every checked creator: one coherent pair for
# the whole family rather than twenty type-specific names. The creator a
# call names already says which domain was meant; the error says which
# bound the value violated (byte::from_int's and register64's two-error
# granularity).
error AbiIntegerBelowRange
error AbiIntegerAboveRange

# ---------------------------------------------------------------------------
# Fixed-width domains: target-independent mathematical intervals.

type I8Value = Int in -128..127
type I16Value = Int in -32768..32767
type I32Value = Int in -2147483648..2147483647
type I64Value = Int in -9223372036854775808..9223372036854775807

type U8Value = Int in 0..255
type U16Value = Int in 0..65535
type U32Value = Int in 0..4294967295
type U64Value = Int in 0..18446744073709551615

# ---------------------------------------------------------------------------
# Address/size-width domains: TARGET-DEPENDENT.
#
# Isize is the signed, and Usize the unsigned, integer domain whose ABI
# width equals the target's address size. The only supported target today
# is Linux x86-64 (LINUX-X86-64-SYSCALL.md: the native backend refuses to
# generate the syscall transport for any other), whose address size is 64
# bits, so here and now
#
#   IsizeValue == I64Value's domain     -2^63 .. 2^63 - 1
#   UsizeValue == U64Value's domain     0 .. 2^64 - 1
#
# This pair of declarations is the one place that width is chosen; a target
# with another address size would change exactly these two domains (and its
# own architecture layer's encoders), nothing else. Each is declared
# directly as an Int domain -- not as a subtype of I64Value/U64Value,
# and Isize/Usize are not aliases of I64/U64 -- because the equality is a fact
# about the current target, not about the types: I64 is a specifically
# 64-bit signed field, Isize a signed address-width quantity.
type IsizeValue = Int in -9223372036854775808..9223372036854775807
type UsizeValue = Int in 0..18446744073709551615

# ---------------------------------------------------------------------------
# The nominal types: one field, `value`, the mathematical Int.

struct I8:
    value: I8Value

struct I16:
    value: I16Value

struct I32:
    value: I32Value

struct I64:
    value: I64Value

struct U8:
    value: U8Value

struct U16:
    value: U16Value

struct U32:
    value: U32Value

struct U64:
    value: U64Value

struct Isize:
    value: IsizeValue

struct Usize:
    value: UsizeValue

# ---------------------------------------------------------------------------
# The checked creators: Int -> ABI value, or the declared error naming the
# violated bound. Each is written with its two literal bounds directly so
# hir/range.tcl's comparison narrowing proves `value` in the domain in the
# final branch -- the proof the construction needs (abi::x86_64::register64's
# shape). Botlish has no generics over nominal types and no macros, so the
# family is spelled out once per member; every member is the same three
# branches.

fn i8(value: int) -> I8 errors AbiIntegerBelowRange, AbiIntegerAboveRange:
    if value < -128:
        fail AbiIntegerBelowRange
    elif value > 127:
        fail AbiIntegerAboveRange
    else:
        I8 {value: value}

fn i16(value: int) -> I16 errors AbiIntegerBelowRange, AbiIntegerAboveRange:
    if value < -32768:
        fail AbiIntegerBelowRange
    elif value > 32767:
        fail AbiIntegerAboveRange
    else:
        I16 {value: value}

fn i32(value: int) -> I32 errors AbiIntegerBelowRange, AbiIntegerAboveRange:
    if value < -2147483648:
        fail AbiIntegerBelowRange
    elif value > 2147483647:
        fail AbiIntegerAboveRange
    else:
        I32 {value: value}

fn i64(value: int) -> I64 errors AbiIntegerBelowRange, AbiIntegerAboveRange:
    if value < -9223372036854775808:
        fail AbiIntegerBelowRange
    elif value > 9223372036854775807:
        fail AbiIntegerAboveRange
    else:
        I64 {value: value}

fn u8(value: int) -> U8 errors AbiIntegerBelowRange, AbiIntegerAboveRange:
    if value < 0:
        fail AbiIntegerBelowRange
    elif value > 255:
        fail AbiIntegerAboveRange
    else:
        U8 {value: value}

fn u16(value: int) -> U16 errors AbiIntegerBelowRange, AbiIntegerAboveRange:
    if value < 0:
        fail AbiIntegerBelowRange
    elif value > 65535:
        fail AbiIntegerAboveRange
    else:
        U16 {value: value}

fn u32(value: int) -> U32 errors AbiIntegerBelowRange, AbiIntegerAboveRange:
    if value < 0:
        fail AbiIntegerBelowRange
    elif value > 4294967295:
        fail AbiIntegerAboveRange
    else:
        U32 {value: value}

fn u64(value: int) -> U64 errors AbiIntegerBelowRange, AbiIntegerAboveRange:
    if value < 0:
        fail AbiIntegerBelowRange
    elif value > 18446744073709551615:
        fail AbiIntegerAboveRange
    else:
        U64 {value: value}

# Target-dependent bounds: IsizeValue's/UsizeValue's (above).
fn isize(value: int) -> Isize errors AbiIntegerBelowRange, AbiIntegerAboveRange:
    if value < -9223372036854775808:
        fail AbiIntegerBelowRange
    elif value > 9223372036854775807:
        fail AbiIntegerAboveRange
    else:
        Isize {value: value}

fn usize(value: int) -> Usize errors AbiIntegerBelowRange, AbiIntegerAboveRange:
    if value < 0:
        fail AbiIntegerBelowRange
    elif value > 18446744073709551615:
        fail AbiIntegerAboveRange
    else:
        Usize {value: value}

# ---------------------------------------------------------------------------
# abi::Bytes: the first owned ABI memory value (ABI-BYTES.md).
#
# A Bytes is an immutable, finite sequence of bytes with an exact length,
# whose contiguous ABI representation exists whenever a foreign boundary
# needs it. It is an ordinary Botlish value -- copy it, alias it, store it in
# a List, compare it, hash it -- with an opaque representation. It is NOT a
# String (no characters, no encoding), a C string (nothing terminates it: a
# 0 byte is an ordinary byte and the length is explicit and authoritative), a
# pointer, a borrow, a resource, a mutable buffer or an iterator.
#
#   data = abi::bytes(str::encode_utf8("h\u00e9llo\n"))     # 7 bytes
#   n = abi::bytes_length(data)                             # an abi::Usize
#
# * Creation is EAGER. abi::bytes(values) converts the List into storage the
#   resulting Bytes owns; afterwards the List (or the String it was encoded
#   from) is irrelevant -- the Bytes is not a view of it and does not retain
#   it. Every element must be a byte::Byte and is stored exactly: there is
#   no `mod 256`, no signed reinterpretation and no character coercion, so a
#   List that is statically not a List of bytes is rejected by the ordinary
#   typing of the parameter below.
# * Equality and hashing are by the bytes: abi::bytes([a, b]) ==
#   abi::bytes([a, b]); two Bytes with different contents are unequal. No
#   address, buffer identity, allocation identity or sharing is observable,
#   and none of the physical choices (a static constant, a heap buffer, one
#   buffer shared by every alias or a copy per alias) can be told apart.
# * The one hidden field, `storage`, is the owned byte storage (a runtime
#   value of its own kind, core/bytestore.tcl, natively one allocation of
#   header + length + payload). Only this module may name it: a projection or
#   construction anywhere else is OPAQUE-REPRESENTATION / OPAQUE-
#   CONSTRUCTION, and the machine address of the payload is available only
#   through the raw architecture bridge abi::x86_64::from_bytes, never from
#   the Bytes itself.
#
# Not here, deliberately: slicing, indexing, concatenation, capacity,
# mutation (MutableBytes), NUL-terminated strings (CString), and any
# retained-pointer or lifetime story.
opaque struct Bytes:
    storage: any

# The Bytes holding exactly the given bytes, in order. The empty List gives
# the empty Bytes (length 0).
fn bytes(values: List[Byte]) -> Bytes:
    Bytes {storage: byte_store::from_list(values)}

# The exact byte count of DATA, as the ABI size domain. The runtime's
# collection-length ceiling (below 2^62) already guarantees the count is a
# valid native buffer extent, so no caller re-proves 0 <= n <= 2^64 - 1.
fn bytes_length(data: Bytes) -> Usize:
    Usize {value: byte_store::byte_count(data.storage)}

# ---------------------------------------------------------------------------
# abi::MutableBytes: the writable counterpart of Bytes (MUTABLE-BYTES.md).
#
# A MutableBytes is a finite sequence of bytes of one fixed length whose
# CONTENTS can change, and it is a VALUE: mutable storage does not imply
# reference semantics. If a program logically copies one, the copies are
# independent values -- changing one never changes another because the
# implementation happened to hold both in the same heap object:
#
#   a = abi::mutable_bytes_from_bytes(original)
#   b = a                                      # a logical copy
#   a2 = abi::mutable_bytes_set(a, 0, x)       # a2 differs from a ...
#   abi::freeze(b) == original                 # ... and b (and a) did not change
#
# This holds through every route a value can take -- a binding, a function
# argument or result, a struct field, a List element, a generic or `any`
# parameter, a closure capture -- because there is exactly one rule: a
# MutableBytes' storage is never written once it is a value anyone can
# hold. Every operation that changes contents (mutable_bytes_set here,
# linux::read's kernel write) works on a FRESH copy of the storage and
# returns that copy as the new value. Copying a value, passing it and
# storing it are therefore plain sharing (nothing needs a copy at those
# boundaries), and an update costs one copy of the bytes. That eager copy is
# an implementation choice, not part of the semantics: a later optimization
# (copy-on-write, uniqueness or deadness analysis, return-value transfer)
# may skip a copy when no other value can observe the storage, and
# must produce the same results.
#
# Contrast the things that DO have identity and are meant to: a raw
# address (the bits are the value), a file descriptor or other handle (the
# token is the value), and the existing MutableArray (a reference to a shared
# store). Copying `fd2 = fd1` names the same kernel descriptor on purpose; a
# MutableBytes never does that behind an ordinary-looking value.
#
# Equality and hashing are by the current bytes (never by storage identity):
# two independent values with the same contents are equal. It is an opaque
# struct like Bytes, and not a Bytes, String, C string, pointer, borrow,
# resource, reference, resizable vector or iterator. The length is fixed for
# the value's lifetime; there is no capacity and no terminator. Nothing is
# ever uninitialized: abi::mutable_bytes zero-fills.
#
# The machine address of the payload, for a foreign call that writes it, is
# available only through the raw architecture bridge
# abi::x86_64::from_mutable_bytes (the writable twin of from_bytes), which
# takes an address of the storage of the value it is given and does NOT copy
# it: a raw-layer caller must hand it a storage nothing else observes
# (linux::read does, with mutable_bytes_copy). That is the raw layer's sharp
# edge, as with from_bytes' provenance rules.
opaque struct MutableBytes:
    storage: any

# A MutableBytes of LENGTH zero bytes. A length beyond the runtime's
# collection ceiling (2^62 - 1) is the RANGE error every oversized
# collection is.
fn mutable_bytes(length: Usize) -> MutableBytes:
    MutableBytes {storage: byte_store::mutable_new(length.value)}

# An independent writable copy of DATA's bytes: changing the result never
# changes DATA.
fn mutable_bytes_from_bytes(data: Bytes) -> MutableBytes:
    MutableBytes {storage: byte_store::mutable_from(data.storage)}

# The exact byte count of DATA; fixed for the life of the value.
fn mutable_bytes_length(data: MutableBytes) -> Usize:
    Usize {value: byte_store::mutable_count(data.storage)}

# DATA with the byte at INDEX replaced by VALUE: a new value; DATA itself is
# unchanged. IndexNotFound unless 0 <= index < mutable_bytes_length(data)
# (the same error list::at and mutable_array::set use).
fn mutable_bytes_set(data: MutableBytes, index: int, value: Byte) -> MutableBytes errors IndexNotFound:
    if index < 0:
        fail IndexNotFound
    elif index >= byte_store::mutable_count(data.storage):
        fail IndexNotFound
    else:
        MutableBytes {storage: byte_store::mutable_set(data.storage, index, value)}

# DATA itself, as a value (a logical copy is always the same value), but with
# its own freshly allocated storage. The one operation that is semantically
# the identity and physically a copy: what a caller needs before handing the
# storage to a foreign write (linux::read), because the raw writable bridge
# writes through the storage it is given. Copy-on-write's "detach", taken
# every time.
fn mutable_bytes_copy(data: MutableBytes) -> MutableBytes:
    MutableBytes {storage: byte_store::mutable_copy(data.storage)}

# An immutable snapshot of all of DATA's bytes. DATA stays a valid, independent
# value and the Bytes never changes afterwards.
fn freeze(data: MutableBytes) -> Bytes:
    Bytes {storage: byte_store::freeze(data.storage)}

# An immutable snapshot of the first COUNT bytes of DATA (the bytes a
# read(2) that returned COUNT wrote). UpperOverrun if COUNT exceeds
# mutable_bytes_length(data): nothing outside the payload is ever read.
fn freeze_prefix(data: MutableBytes, count: Usize) -> Bytes errors UpperOverrun:
    if count.value > byte_store::mutable_count(data.storage):
        fail UpperOverrun
    else:
        Bytes {storage: byte_store::freeze_prefix(data.storage, count.value)}
