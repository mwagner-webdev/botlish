# Binaries bench/bench.tcl compiles from bench/equivalents/rust/*.rs and
# caches alongside the source, rebuilt automatically when the source changes.
/bench/equivalents/rust/*
!/bench/equivalents/rust/*.rs

# Same for the Go equivalents (bench/equivalents/go/*.go): cached binaries
# have no way to be checked stale and compile quickly, so they are not
# committed.
/bench/equivalents/go/*
!/bench/equivalents/go/*.go
__pycache__/

# The fuzzing campaign tree (FUZZING-EXAMPLES-AOT.md). Everything the
# campaign can regenerate is ignored: the AFL++ toolchain it builds from a
# pinned source, the AOT executables and copied sources it emits, and AFL's
# own session state. Seeds, dictionaries, baselines, scripts, triage
# packages and campaign stats snapshots are committed.
/fuzz/tools/
/fuzz/build/
/fuzz/out/
/fuzz/seeds-src/
/fuzz/harness/argv-file
