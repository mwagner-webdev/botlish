# bench/bench.tcl builds the Rust and Go reference programs into a private
# temporary directory; these keep a binary built beside its source by hand
# (or by an older bench.tcl, which cached them there) out of git.
/bench/equivalents/rust/*
!/bench/equivalents/rust/*.rs
/bench/equivalents/go/*
!/bench/equivalents/go/*.go
/bench/experimental/equivalents/rust/*
!/bench/experimental/equivalents/rust/*.rs
/bench/experimental/equivalents/go/*
!/bench/experimental/equivalents/go/*.go
__pycache__/

# The fuzzing campaign tree (FUZZING-EXAMPLES-AOT.md). Everything the
# campaign can regenerate is ignored: the AFL++ toolchain it builds from a
# pinned source, the AOT executables and copied sources it emits, and AFL's
# own session state. Seeds, dictionaries, baselines, scripts, triage
# packages and campaign stats snapshots are committed.
/fuzz/tools/
/fuzz/build/
/fuzz/out/
/fuzz/out-asan/
/fuzz/seeds-src/
/fuzz/harness/argv-file

# single/build.sh's default output (SINGLE-EXECUTABLE.md).
/single/out/

# tools/event-loop-linux.tcl builds the Linux event-loop driver package's
# archive where it installs the package, never here.
/packages/event_loop_linux/native/*.a
/packages/event_loop_linux/native/*.o

# examples/event-loop/native/build.sh's products (the installed driver
# package and the ticker's archive).
/examples/event-loop/native/.bot_modules/
/examples/event-loop/native/libticker.a

# tools/raven-package.tcl builds the Raven package's event bridge where it
# installs the package, never here; and the examples' installed package.
/packages/raven/native/*.a
/packages/raven/native/*.o
/examples/raven/.bot_modules/
