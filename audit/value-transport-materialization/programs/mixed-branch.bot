fn fwd0(r, k):
    r.f0 + r.f1 + r.f2 + r.f3 + r.f4 + r.f5 + r.f6 + r.f7 + k
fn fwd1(r, k):
    fwd0(r, k)
fn fwd2(r, k):
    fwd1(r, k)
fn fwd3(r, k):
    fwd2(r, k)
fn fwd4(r, k):
    fwd3(r, k)
fn fwd5(r, k):
    fwd4(r, k)

fn drive(i, n, acc):
    if i >= n:
        return acc
    r = {f0: i + 0, f1: i + 1, f2: i + 2, f3: i + 3, f4: i + 4, f5: i + 5, f6: i + 6, f7: i + 7}
    v = if i >= 100:
        fwd5(r, i)
    else:
        r.f0 + r.f1
    drive(i + 1, n, acc + v)
drive(0, 200000, 0)
