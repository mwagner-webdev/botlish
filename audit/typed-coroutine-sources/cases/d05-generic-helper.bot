# case: deep yields -- an untyped helper yielding its parameter, called by two roots with an int and a str: a helper has no outward type of its own (COROUTINES.md 9), and its yield is typed by its generic body (any), which neither root's declared result (int, str) admits
# class: rejected-precision
# expect: rejected COROUTINE-RESULT-MISMATCH
import std::coroutine

fn emit(x):
    yield x
    unit

fn ints() -> int:
    emit(1)
    2

fn texts() -> str:
    emit("a")
    "b"

coroutine {step: s1, first: f1} = ints()
r1 = s1()
coroutine {step: s2, first: f2} = texts()
r2 = s2()
[f1, r1, f2, r2]
