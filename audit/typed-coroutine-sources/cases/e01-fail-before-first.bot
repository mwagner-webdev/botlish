# case: errors -- a failure before the first yield crosses the construction: its handler's value is `first`, and the coroutine is failed (every later resume raises it again)
# class: intended
# expect: facts-widened
# value: [-1, -2, 1]
import std::coroutine

error Broke

fn source(n: int) -> int errors Broke:
    if n < 0:
        fail Broke
    yield n
    n + 1

fn run(n: int) -> List[int]:
    coroutine {step, first} = source(n):
        on Broke:
            -1
    again = step():
        on Broke:
            -2
    done = if std::coroutine::done?(step):
        1
    else:
        0
    [first, again, done]

run(0 - 5)
