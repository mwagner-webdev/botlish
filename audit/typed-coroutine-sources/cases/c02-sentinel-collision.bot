# case: sentinel -- the same consumer over a stream in which -1 is an ordinary symbol: the sentinel consumer stops at the yielded -1, the done? consumer takes every symbol (why the CSV milestone removed the -1 rule: COROUTINES.md's done? is the phase, never a value)
# class: narrowing
# expect: precise
# value: [[3], [3, -1, 4]]
import std::coroutine
import std::mutable_vector
import std::mutable_array

fn symbols(xs: List[int]) -> int:
    loop x in xs:
        yield x
    -1

fn by_sentinel(xs: List[int]) -> List[int]:
    coroutine {step, first} = symbols(xs)
    out = std::mutable_vector::from_list([0])
    out.clear()
    c = std::mutable_array::create(1, first)
    loop:
        if c.at(0) == -1:
            break
        out.push(c.at(0))
        c.set(0, step())
    loop x in out:
        x

fn by_done(xs: List[int]) -> List[int]:
    coroutine {step, first} = symbols(xs)
    out = std::mutable_vector::from_list([0])
    out.clear()
    c = std::mutable_array::create(1, first)
    loop:
        if std::coroutine::done?(step):
            break
        out.push(c.at(0))
        c.set(0, step())
    loop x in out:
        x

[by_sentinel([3, -1, 4]), by_done([3, -1, 4])]
