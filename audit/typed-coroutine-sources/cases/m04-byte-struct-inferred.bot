# case: matrix -- yields Byte, returns a struct with no declared result: rejected, the diagnostic lists both types a segment can end with
# class: rejected-precision
# expect: rejected COROUTINE-RESULT-MISMATCH
import std::coroutine
import std::byte

struct Summary:
    count: int

fn source(b: std::byte::Byte, n: int):
    loop i from 0 to n:
        yield b
        continue
    Summary {count: n}

coroutine {step, first} = source(65, 2)
first
