# case: errors -- a failure after several yields crosses the resume that ran the failing segment; the consumer's handler value stands in for the value, and joins the outward type
# class: intended
# expect: facts-widened
# value: [1, 2, -1, -1, 1]
import std::coroutine

error Broke

fn source(n: int) -> int errors Broke:
    loop i from 1 to n + 1:
        yield i
        continue
    fail Broke

fn run() -> List[int]:
    coroutine {step, first} = source(2):
        on Broke:
            -9
    second = step():
        on Broke:
            -9
    third = step():
        on Broke:
            -1
    again = step():
        on Broke:
            -1
    done = if std::coroutine::done?(step):
        1
    else:
        0
    [first, second, third, again, done]

run()
