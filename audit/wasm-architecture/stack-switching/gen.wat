;; Two independent generators suspended and resumed in interleaved order
;; with the core stack-switching proposal (cont.new / resume / suspend).
(module
  (type $ft (func))
  (type $ct (cont $ft))
  (tag $yield (param i32))
  (import "wasi_snapshot_preview1" "fd_write" (func $fd_write (param i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 1)
  (global $base (mut i32) (i32.const 0))
  (func $gen (param $start i32)
    (local $i i32)
    (loop $l
      (suspend $yield (i32.add (local.get $start) (local.get $i)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (i32.const 3)))))
  (func $gen0 (call $gen (i32.const 0)))
  (func $gen100 (call $gen (i32.const 100)))
  (elem declare func $gen0 $gen100)
  ;; Prints one decimal number and a space (n < 1000).
  (func $print (param $n i32)
    (i32.store8 offset=100 (i32.const 0) (i32.add (i32.const 48) (i32.div_u (local.get $n) (i32.const 100))))
    (i32.store8 offset=101 (i32.const 0) (i32.add (i32.const 48) (i32.rem_u (i32.div_u (local.get $n) (i32.const 10)) (i32.const 10))))
    (i32.store8 offset=102 (i32.const 0) (i32.add (i32.const 48) (i32.rem_u (local.get $n) (i32.const 10))))
    (i32.store8 offset=103 (i32.const 0) (i32.const 32))
    (i32.store (i32.const 0) (i32.const 100))
    (i32.store (i32.const 4) (i32.const 4))
    (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8))))
  ;; Resumes K once: prints the yielded value, returns the continuation (or null when done).
  (func $step (param $k (ref null $ct)) (result (ref null $ct))
    (local $v i32)
    (block $done
      (block $on (result i32 (ref $ct))
        (resume $ct (on $yield $on) (local.get $k))
        (br $done))
      (local.set $k)
      (call $print)
      (return (local.get $k)))
    (ref.null $ct))
  (func (export "_start")
    (local $a (ref null $ct)) (local $b (ref null $ct))
    (local.set $a (cont.new $ct (ref.func $gen0)))
    (local.set $b (cont.new $ct (ref.func $gen100)))
    (local.set $a (call $step (local.get $a)))
    (local.set $b (call $step (local.get $b)))
    (local.set $b (call $step (local.get $b)))
    (local.set $a (call $step (local.get $a)))
    (local.set $b (call $step (local.get $b)))
    (local.set $a (call $step (local.get $a))))
)
