+// WASM-ARCH PROTOTYPE: wasm32-unknown-unknown has no C allocator; an 8-byte length prefix over Rust's.
+#[cfg(all(target_family = "wasm", target_os = "unknown"))]
+unsafe fn proto_malloc(n: usize) -> *mut c_void { unsafe { let l = std::alloc::Layout::from_size_align(n + 8, 8).unwrap(); let p = std::alloc::alloc(l); *(p as *mut usize) = n; p.add(8) as *mut c_void } }
+#[cfg(all(target_family = "wasm", target_os = "unknown"))]
+unsafe fn proto_free(p: *mut c_void) { unsafe { let b = (p as *mut u8).sub(8); let n = *(b as *mut usize); std::alloc::dealloc(b, std::alloc::Layout::from_size_align(n + 8, 8).unwrap()) } }
