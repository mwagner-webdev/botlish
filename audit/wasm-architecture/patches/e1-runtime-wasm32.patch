+#[cfg(not(all(target_family = "wasm", target_os = "unknown")))]
+unsafe fn proto_malloc(n: usize) -> *mut c_void { unsafe { libc::malloc(n) as *mut c_void } }
+#[cfg(not(all(target_family = "wasm", target_os = "unknown")))]
