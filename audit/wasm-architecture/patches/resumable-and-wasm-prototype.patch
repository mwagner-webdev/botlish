+                    fx.line(format!("br\t{d}"));
+                    terminated = true;
+                }
+                Inst::Jump(l) => {
+                    fx.goto(*l, 0);
+                    terminated = true;
+                }
+                Inst::Switch { value, default, cases } => {
+                    for (lo, hi, l) in cases {
+                        fx.get(*value);
+                        fx.line(format!("i64.const\t{lo}"));
+                        fx.line("i64.ge_s");
+                        fx.get(*value);
+                        fx.line(format!("i64.const\t{hi}"));
+                        fx.line("i64.le_s");
+                        fx.line("i32.and");
+                        fx.line("if");
+                        fx.goto(*l, 1);
+                        fx.line("end_if");
+                    }
+                    fx.goto(*default, 0);
+                    terminated = true;
+                }
+                Inst::Ret(r) => {
+                    fx.leave();
+                    fx.get(*r);
+                    if f.scalar_result() && f.may_error {
+                        fx.line("i64.const\t1");
+                    }
+                    fx.line("return");
+                    terminated = true;
+                }
