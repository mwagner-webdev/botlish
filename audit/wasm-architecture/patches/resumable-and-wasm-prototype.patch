+    // The startup crate (wasm32): the code table and the run.
+    let mut startup = String::new();
+    startup.push_str("use botlish_native::runtime::{program, show, value::*, vm::Vm};\nunsafe extern \"C\" {\n    fn botlish_fn_0(vm: *mut Vm) -> u64;\n");
