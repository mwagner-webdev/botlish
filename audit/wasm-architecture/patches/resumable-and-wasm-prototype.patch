+    startup.push_str(GLUE);
+    startup.push_str("fn code() -> Vec<(usize, usize)> {\n    vec![\n");
+    for f in &program.functions {
+        if f.id == 0 {
+            writeln!(startup, "        (botlish_fn_0 as usize, botlish_entry_0 as usize),").unwrap();
+        } else {
+            writeln!(startup, "        (botlish_entry_{0} as usize, botlish_entry_{0} as usize),", f.id).unwrap();
+        }
+    }
+    startup.push_str("    ]\n}\n");
