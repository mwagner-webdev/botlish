+            }
+        }
+        writeln!(body, "\tcall\tbotlish_fn_{}", f.id).unwrap();
+        if f.scalar_result() && f.may_error {
+            // (value, status) -> the value, or 0 on failure.
+            writeln!(body, "\tlocal.set\t3\n\tlocal.set\t4\n\tlocal.get\t3\n\ti64.eqz\n\tif\n\ti64.const\t0\n\treturn\n\tend_if\n\tlocal.get\t4").unwrap();
+        }
+        if f.raw_result {
+            writeln!(body, "\ti64.const\t1\n\ti64.shl\n\ti64.const\t1\n\ti64.or").unwrap();
+        }
+        writeln!(body, "\tend_function").unwrap();
+    }
+    // Declarations: helpers and the glue's functions.
+    let mut asm = String::new();
+    asm.push_str("\t.globaltype\t__stack_pointer, i32\n");
+    for h in &helpers {
+        let sig = match h.as_str() {
+            "proto_ss_enter" => "(i32, i32) -> (i32)".to_string(),
+            "proto_ss_leave" => "(i32, i32) -> ()".to_string(),
+            "proto_const" => "(i32, i32) -> (i64)".to_string(),
+            "proto_capture" => "(i32, i64, i32) -> (i64)".to_string(),
+            "proto_struct_get" => "(i32, i64, i32) -> (i64)".to_string(),
+            "proto_ctx_load" => "(i32, i32) -> (i64)".to_string(),
+            "proto_ctx_store" => "(i32, i32, i64) -> ()".to_string(),
