+
+const GLUE: &str = r#"
+static DESCRIPTOR: &[u8] = include_bytes!("descriptor.bin");
+
+#[unsafe(no_mangle)]
+pub extern "C" fn proto_ss_enter(vm: *mut Vm, n: u32) -> *mut u64 {
+    let vm = unsafe { &mut *vm };
+    let base = vm.ss_top;
+    let top = unsafe { base.add(n as usize) };
+    if top > vm.ss_limit {
+        eprintln!("error {{NATIVE LIMIT STACK}} {{native stack exhausted: too many nested calls}}");
+        std::process::exit(1);
+    }
+    for i in 0..n as usize {
+        unsafe { *base.add(i) = 0 };
+    }
+    vm.ss_top = top;
+    base
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn proto_ss_leave(vm: *mut Vm, base: *mut u64) {
+    unsafe { (*vm).ss_top = base };
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn proto_const(vm: *mut Vm, i: u32) -> u64 {
+    unsafe { *(*vm).consts.add(i as usize) }
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn proto_struct_get(_vm: *mut Vm, v: u64, slot: u32) -> u64 {
+    struct_of(v).fields()[slot as usize]
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn proto_ctx_load(vm: *mut Vm, offset: u32) -> u64 {
+    unsafe { *(((*vm).context_ptr as *mut u8).add(offset as usize) as *const u64) }
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn proto_ctx_store(vm: *mut Vm, offset: u32, v: u64) {
+    unsafe { *(((*vm).context_ptr as *mut u8).add(offset as usize) as *mut u64) = v };
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn proto_str_len(_vm: *mut Vm, v: u64) -> u64 {
+    ((str_of(v).chars as u64) << 1) | 1
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn proto_capture(_vm: *mut Vm, closure: u64, i: u32) -> u64 {
+    let c = closure_of(closure);
+    unsafe { *c.caps.add(i as usize) }
+}
+
+fn main() {
+    let descriptor = program::ProgramDescriptor::decode(DESCRIPTOR).expect("descriptor");
+    let (mut vm, entry) = program::instantiate(&descriptor, &code());
+    let v = entry(&mut *vm);
+    if v == NO_VALUE {
+        let e = vm.error.take().map(|e| e.message(&vm.info)).unwrap_or_default();
+        println!("error {e}");
+        std::process::exit(1);
+    }
+    println!("value {}", show::show(&vm.info, v));
+    println!("collections {}", vm.heap.collections);
+}
