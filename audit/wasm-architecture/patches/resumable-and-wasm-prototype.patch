+                    fx.line(format!("local.get\t{vm}"));
+                    fx.line(format!("i64.const\t{index}"));
+                    fx.line("call\trt_declared_payload");
+                    fx.helpers.insert("rt_declared_payload".into());
+                    fx.def(*dst);
+                }
+                Inst::DeclaredErrorEq { dst, id } => {
+                    fx.line(format!("i64.const\t{TRUE}"));
+                    fx.line(format!("i64.const\t{FALSE}"));
+                    fx.line(format!("local.get\t{vm}"));
+                    fx.line("call\trt_declared_error");
+                    fx.helpers.insert("rt_declared_error".into());
+                    fx.line(format!("i64.const\t{id}"));
+                    fx.line("i64.eq");
+                    fx.line("i64.select");
+                    fx.def(*dst);
+                }
+                Inst::ClearDeclaredError => {
