diff -ruN a/native/src/codegen/wasmemit.rs b/native/src/codegen/wasmemit.rs
--- a/native/src/codegen/wasmemit.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/native/src/codegen/wasmemit.rs	2026-11-15 19:18:32.000000000 +0000
@@ -0,0 +1,942 @@
+//! WASM-ARCH PROTOTYPE (WASM-TARGET-AND-COROUTINE-ARCHITECTURE-MILESTONE-1.md,
+//! experiment E2): NIR -> WebAssembly assembly text, for a subset of NIR.
+//!
+//! What it shows: the driver's real NIR (after the real parse, call-effect
+//! settlement and, for coroutine programs, the resumable lowering) lowered
+//! to a relocatable wasm object that wasm-ld links with the real Botlish
+//! runtime compiled for wasm32. What it is not: the production code
+//! generator. Control flow is a dispatch loop over NIR blocks (no
+//! structuring), every tagged operation is a runtime helper call (no inline
+//! fast paths, so no field offsets are read by generated code), and GC roots
+//! use the ShadowOnly model through two glue helpers (`proto_ss_enter`,
+//! `proto_ss_leave`): every function with a root slot gets a frame in the
+//! Vm's shadow array, every rooted register is stored there at its
+//! definition (codegen::roots's liveness and slot coloring, unchanged).
+use crate::codegen::roots;
+use crate::codegen::ConstPool;
+use crate::nir::{Function, Inst, Label, OpCode, Program, Reg, RegKind};
+use crate::runtime::constants::Const;
+use crate::runtime::value::*;
+use std::collections::HashMap;
+use std::fmt::Write;
+
+pub struct Emitted {
+    pub asm: String,
+    pub descriptor: Vec<u8>,
+    pub startup: String,
+}
+
+/// Helper signatures beyond `vm`: 'v' an i64 (Value or raw word), 'p' an i32
+/// pointer. Every helper returns i64.
+fn helper_sig(name: &str) -> Option<&'static str> {
+    Some(match name {
+        "rt_int_add" | "rt_int_sub" | "rt_int_mul" | "rt_int_cmp" => "vv",
+        "rt_list_new" => "vp",
+        "rt_closure_new" => "vvvp",
+        "rt_call_value" => "vvp",
+        "rt_co_create" | "rt_co_start" | "rt_co_resume0" | "rt_co_done" | "rt_co_release" | "rt_co_abandon" | "rt_co_yield" => "v",
+        "rt_co_resume" => "vv",
+        "rt_fr_take" | "rt_fr_pending" | "rt_co_msg" => "",
+        "rt_fr_is_frame" | "rt_fr_point" | "rt_fr_callee" | "rt_fr_set_resume" | "rt_fr_is_suspend" | "rt_co_suspend" => "v",
+        "rt_fr_get" | "rt_fr_get_raw" => "vv",
+        "rt_fr_ensure" | "rt_fr_put" | "rt_fr_put_raw" => "vvv",
+        "rt_fr_finish" => "vvvv",
+        "rt_list_len" => "v",
+        "rt_list_get" => "vv",
+        "rt_list_get_proven" => "vv",
+        "rt_str_len" => "v",
+        "rt_mv_from_list" | "rt_mv_len" | "rt_mv_empty" | "rt_mv_pop" | "rt_mv_to_list" => "v",
+        "rt_mv_push" | "rt_mv_take" => "vv",
+        "rt_affine_drop" | "rt_str_cat" => "vv",
+        "rt_int_to_str" | "proto_str_len" => "v",
+        "rt_construct" => "vvp",
+        "rt_struct_new" => "vvp",
+        "rt_cleanup_table" => "vp",
+        "rt_cleanup_call" | "rt_mv_at" | "rt_mv_share" | "rt_affine_drop_run" => "vv",
+        "rt_context_root" => "v",
+        "rt_fail_declared" => "vv",
+        "rt_fail_declared_payload" => "vvvvp",
+        "rt_declared_payload" => "v",
+        "rt_declared_error" | "rt_clear_declared_error" => "",
+        _ => return None,
+    })
+}
+
+/// The runtime helper of OP, whether its result is checked for NO_VALUE.
+fn op_helper(op: OpCode) -> Option<(&'static str, bool)> {
+    use OpCode::*;
+    Some(match op {
+        IAdd => ("rt_int_add", true),
+        ISub => ("rt_int_sub", true),
+        IMul => ("rt_int_mul", true),
+        CoCreate => ("rt_co_create", false),
+        CoStart => ("rt_co_start", true),
+        CoResume => ("rt_co_resume", true),
+        CoResume0 => ("rt_co_resume0", true),
+        CoYield => ("rt_co_yield", true),
+        CoDone => ("rt_co_done", false),
+        CoRelease => ("rt_co_release", false),
+        CoAbandon => ("rt_co_abandon", true),
+        FrTake => ("rt_fr_take", false),
+        FrIsFrame => ("rt_fr_is_frame", false),
+        FrEnsure => ("rt_fr_ensure", false),
+        FrPut => ("rt_fr_put", false),
+        FrPutRaw => ("rt_fr_put_raw", false),
+        FrFinish => ("rt_fr_finish", false),
+        FrGet => ("rt_fr_get", false),
+        FrGetRaw => ("rt_fr_get_raw", false),
+        FrPoint => ("rt_fr_point", false),
+        FrCallee => ("rt_fr_callee", false),
+        FrPending => ("rt_fr_pending", false),
+        FrSetResume => ("rt_fr_set_resume", false),
+        FrIsSuspend => ("rt_fr_is_suspend", false),
+        CoSuspend => ("rt_co_suspend", true),
+        CoMsg => ("rt_co_msg", true),
+        ListLen => ("rt_list_len", false),
+        ListGet => ("rt_list_get", true),
+        ListGetProven => ("rt_list_get_proven", true),
+        MvFromList => ("rt_mv_from_list", false),
+        MvLen => ("rt_mv_len", false),
+        MvPush => ("rt_mv_push", false),
+        AffineDrop => ("rt_affine_drop", false),
+        StrCat => ("rt_str_cat", true),
+        IntToStr => ("rt_int_to_str", false),
+        StrLen => ("proto_str_len", false),
+        MvAt => ("rt_mv_at", true),
+        MvShare => ("rt_mv_share", false),
+        CtxRoot => ("rt_context_root", false),
+        CleanupCall => ("rt_cleanup_call", true),
+        AffineDropRun => ("rt_affine_drop_run", true),
+        MvTake => ("rt_mv_take", true),
+        _ => return None,
+    })
+}
+
+fn wasm_name(op: OpCode) -> Option<&'static str> {
+    use OpCode::*;
+    Some(match op {
+        RIAdd => "i64.add",
+        RISub => "i64.sub",
+        RIMul => "i64.mul",
+        RIAnd => "i64.and",
+        RIOr => "i64.or",
+        RIXor => "i64.xor",
+        RILt => "i64.lt_s",
+        RILe => "i64.le_s",
+        RIGt => "i64.gt_s",
+        RIGe => "i64.ge_s",
+        RIEq => "i64.eq",
+        _ => return None,
+    })
+}
+
+struct Fx<'a> {
+    program: &'a Program,
+    f: &'a Function,
+    out: String,
+    slot_of: Vec<Option<u32>>,
+    nblocks: usize,
+    block_of: HashMap<Label, usize>,
+    cur: usize,
+    errors: Vec<Option<Label>>,
+    pool: &'a mut ConstPool,
+    helpers: &'a mut std::collections::BTreeSet<String>,
+    // local indices
+    vm: u32,
+    closure: Option<u32>,
+    reg0: u32,
+    pc: u32,
+    base: u32,
+    sp: u32,
+}
+
+impl<'a> Fx<'a> {
+    fn line(&mut self, s: impl AsRef<str>) {
+        self.out.push('\t');
+        self.out.push_str(s.as_ref());
+        self.out.push('\n');
+    }
+    fn local(&self, r: Reg) -> u32 {
+        self.reg0 + r
+    }
+    fn get(&mut self, r: Reg) {
+        let l = self.local(r);
+        self.line(format!("local.get\t{l}"));
+    }
+    /// Pops the i64 on the stack into R (and its shadow slot, if rooted).
+    fn def(&mut self, r: Reg) {
+        let l = self.local(r);
+        self.line(format!("local.set\t{l}"));
+        if let Some(slot) = self.slot_of[r as usize] {
+            let base = self.base;
+            self.line(format!("local.get\t{base}"));
+            self.line(format!("local.get\t{l}"));
+            self.line(format!("i64.store\t{}", slot * 8));
+        }
+    }
+    fn depth_to_loop(&self) -> usize {
+        self.nblocks - 1 - self.cur
+    }
+    fn goto(&mut self, l: Label, extra: usize) {
+        let b = self.block_of[&l];
+        let pc = self.pc;
+        self.line(format!("i32.const\t{b}"));
+        self.line(format!("local.set\t{pc}"));
+        let d = self.depth_to_loop() + extra;
+        self.line(format!("br\t{d}"));
+    }
+    /// Control to the innermost error exit (a pending error is set).
+    fn to_error_exit(&mut self, extra: usize) {
+        match *self.errors.last().unwrap() {
+            Some(l) => self.goto(l, extra),
+            None => {
+                self.leave();
+                self.zeros();
+                self.line("return");
+            }
+        }
+    }
+    fn zeros(&mut self) {
+        let n = if self.f.scalar_result() && self.f.may_error { 2 } else { self.f.results.max(1) };
+        for _ in 0..n {
+            self.line("i64.const\t0");
+        }
+    }
+    fn leave(&mut self) {
+        let (vm, base) = (self.vm, self.base);
+        self.line(format!("local.get\t{vm}"));
+        self.line(format!("local.get\t{base}"));
+        self.line("call\tproto_ss_leave");
+        self.helpers.insert("proto_ss_leave".into());
+    }
+    /// The value on the stack is a call's result: NO_VALUE goes to the
+    /// innermost error exit (a handler block, or this function's error
+    /// return). Leaves the value on the stack.
+    fn check(&mut self, tmp: u32) {
+        self.line(format!("local.tee\t{tmp}"));
+        self.line("i64.eqz");
+        self.line("if");
+        match *self.errors.last().unwrap() {
+            Some(l) => self.goto(l, 1),
+            None => {
+                self.leave();
+                self.zeros();
+                self.line("return");
+            }
+        }
+        self.line("end_if");
+        self.line(format!("local.get\t{tmp}"));
+    }
+    fn constant(&mut self, c: Const) {
+        let i = self.pool.index(c);
+        let vm = self.vm;
+        self.line(format!("local.get\t{vm}"));
+        self.line(format!("i32.const\t{i}"));
+        self.line("call\tproto_const");
+        self.helpers.insert("proto_const".into());
+    }
+    /// ARGS as an array of i64 below __stack_pointer; pushes its address.
+    /// The caller restores the stack pointer from `self.sp` after the call.
+    fn array(&mut self, args: &[Reg]) {
+        let sp = self.sp;
+        self.line("global.get\t__stack_pointer");
+        self.line(format!("local.tee\t{sp}"));
+        self.line(format!("i32.const\t{}", ((8 * args.len() + 15) / 16) * 16));
+        self.line("i32.sub");
+        self.line("global.set\t__stack_pointer");
+        for (i, a) in args.iter().enumerate() {
+            self.line("global.get\t__stack_pointer");
+            self.get(*a);
+            self.line(format!("i64.store\t{}", 8 * i));
+        }
+        self.line("global.get\t__stack_pointer");
+    }
+    fn restore_sp(&mut self) {
+        let sp = self.sp;
+        self.line(format!("local.get\t{sp}"));
+        self.line("global.set\t__stack_pointer");
+    }
+    fn helper(&mut self, name: &str, args: &[Reg]) -> Result<(), String> {
+        let sig = helper_sig(name).ok_or_else(|| format!("no signature for {name}"))?;
+        if sig.len() != args.len() {
+            return Err(format!("{name}: {} arguments, signature {sig}", args.len()));
+        }
+        let vm = self.vm;
+        self.line(format!("local.get\t{vm}"));
+        for a in args {
+            self.get(*a);
+        }
+        self.line(format!("call\t{name}"));
+        self.helpers.insert(name.into());
+        Ok(())
+    }
+    fn bool_of_i32(&mut self) {
+        // i32 condition on the stack -> TRUE / FALSE
+        let t = self.reg0 + self.f.regs; // scratch i64? use select form instead
+        let _ = t;
+    }
+}
+
+fn kind_scalar(f: &Function, r: Reg) -> bool {
+    f.kind_of(r) != RegKind::Tagged
+}
+
+fn direct_type(f: &Function) -> String {
+    let mut ps = vec!["i32".to_string()];
+    if f.env {
+        ps.push("i64".into());
+    }
+    for _ in 0..f.params {
+        ps.push("i64".into());
+    }
+    if f.scalar_result() && f.may_error {
+        format!("({}) -> (i64, i64)", ps.join(", "))
+    } else {
+        format!("({}) -> ({})", ps.join(", "), vec!["i64"; f.results.max(1) as usize].join(", "))
+    }
+}
+
+pub fn emit(program: &Program) -> Result<Emitted, String> {
+    let mut pool = ConstPool::default();
+    let mut helpers = std::collections::BTreeSet::new();
+    let mut body = String::new();
+    for f in &program.functions {
+        let plan = roots::plan(f, false);
+        // Blocks: the entry and one per label.
+        let mut block_of = HashMap::new();
+        let mut nblocks = 1;
+        for inst in &f.body {
+            if let Inst::Label(l) = inst {
+                block_of.insert(*l, nblocks);
+                nblocks += 1;
+            }
+        }
+        let vm = 0u32;
+        let closure = if f.env { Some(1u32) } else { None };
+        let reg0 = 1 + f.env as u32;
+        let nlocals_i64 = f.regs + 2; // registers (params first) and two scratch
+        let pc = reg0 + nlocals_i64;
+        let base = pc + 1;
+        let sp = pc + 2;
+        let mut fx = Fx {
+            program,
+            f,
+            out: String::new(),
+            slot_of: plan.slot_of.clone(),
+            nblocks,
+            block_of,
+            cur: 0,
+            errors: vec![None],
+            pool: &mut pool,
+            helpers: &mut helpers,
+            vm,
+            closure,
+            reg0,
+            pc,
+            base,
+            sp,
+        };
+        let tmp = reg0 + f.regs;
+        let name = format!("botlish_fn_{}", f.id);
+        writeln!(fx.out, "\t.globl\t{name}\n\t.type\t{name},@function\n{name}:\n\t.functype\t{name} {}", direct_type(f)).unwrap();
+        let extra_i64 = f.regs - f.params + 2;
+        let mut locals: Vec<&str> = vec!["i64"; extra_i64 as usize];
+        locals.extend(["i32", "i32", "i32"]);
+        fx.line(format!(".local\t{}", locals.join(", ")));
+        // Prologue: the shadow frame, raw parameters unboxed, rooted
+        // parameters stored.
+        fx.line(format!("local.get\t{vm}"));
+        fx.line(format!("i32.const\t{}", plan.num_slots));
+        fx.line("call\tproto_ss_enter");
+        fx.helpers.insert("proto_ss_enter".into());
+        fx.line(format!("local.set\t{base}"));
+        for p in 0..f.params {
+            if f.raw_regs[p as usize] && !f.raw_params[p as usize] {
+                fx.get(p);
+                fx.line("i64.const\t1");
+                fx.line("i64.shr_s");
+                fx.def(p);
+            } else if fx.slot_of[p as usize].is_some() {
+                fx.get(p);
+                fx.def(p);
+            }
+        }
+        fx.line("i32.const\t0");
+        fx.line(format!("local.set\t{pc}"));
+        fx.line("loop");
+        for _ in 0..nblocks {
+            fx.line("block");
+        }
+        fx.line(format!("local.get\t{pc}"));
+        let table: Vec<String> = (0..nblocks).map(|i| i.to_string()).collect();
+        fx.line(format!("br_table\t{{{}, {}}}", table.join(", "), nblocks - 1));
+        fx.line("end_block");
+        fx.cur = 0;
+        let mut terminated = false;
+        for inst in &f.body {
+            if let Inst::Label(l) = inst {
+                if !terminated {
+                    fx.goto(*l, 0);
+                }
+                fx.line("end_block");
+                fx.cur = fx.block_of[l];
+                terminated = false;
+                continue;
+            }
+            terminated = false;
+            match inst {
+                Inst::Int { dst, digits } => {
+                    match digits.parse::<i64>() {
+                        Ok(n) if fits_small(n) => fx.line(format!("i64.const\t{}", make_small(n) as i64)),
+                        _ => fx.constant(Const::BigInt(digits.clone())),
+                    }
+                    fx.def(*dst);
+                }
+                Inst::RawInt { dst, digits } | Inst::CWord { dst, digits } => {
+                    let n: i64 = digits.parse().map_err(|_| format!("raw literal {digits}"))?;
+                    fx.line(format!("i64.const\t{n}"));
+                    fx.def(*dst);
+                }
+                Inst::ShortLit { dst, value } | Inst::AsciiLit { dst, value } => {
+                    fx.line(format!("i64.const\t{value}"));
+                    fx.def(*dst);
+                }
+                Inst::Bool { dst, value } => {
+                    fx.line(format!("i64.const\t{}", bool_value(*value)));
+                    fx.def(*dst);
+                }
+                Inst::Unit { dst } => {
+                    fx.line(format!("i64.const\t{UNIT}"));
+                    fx.def(*dst);
+                }
+                Inst::Str { dst, text } => {
+                    fx.constant(Const::Str(text.clone()));
+                    fx.def(*dst);
+                }
+                Inst::FnValue { dst, func } => {
+                    fx.constant(Const::FnValue(*func));
+                    fx.def(*dst);
+                }
+                Inst::Native { dst, native } => {
+                    fx.constant(Const::Native(*native));
+                    fx.def(*dst);
+                }
+                Inst::Move { dst, src } => {
+                    fx.get(*src);
+                    fx.def(*dst);
+                }
+                Inst::SelfClosure { dst } => {
+                    let c = fx.closure.ok_or("selfclosure without env")?;
+                    fx.line(format!("local.get\t{c}"));
+                    fx.def(*dst);
+                }
+                Inst::Capture { dst, index } => {
+                    let c = fx.closure.ok_or("capture without env")?;
+                    fx.line(format!("local.get\t{vm}"));
+                    fx.line(format!("local.get\t{c}"));
+                    fx.line(format!("i32.const\t{index}"));
+                    fx.line("call\tproto_capture");
+                    fx.helpers.insert("proto_capture".into());
+                    fx.def(*dst);
+                }
+                Inst::Closure { dst, func, captures } => {
+                    fx.line(format!("local.get\t{vm}"));
+                    fx.line(format!("i64.const\t{func}"));
+                    fx.line(format!("i32.const\tbotlish_entry_{func}"));
+                    fx.line("i64.extend_i32_u");
+                    fx.line(format!("i64.const\t{}", captures.len()));
+                    fx.array(captures);
+                    fx.line("call\trt_closure_new");
+                    fx.helpers.insert("rt_closure_new".into());
+                    fx.restore_sp();
+                    fx.def(*dst);
+                }
+                Inst::Op { dst, op, args } => {
+                    if let Some(w) = wasm_name(*op) {
+                        let cmp = matches!(op, OpCode::RILt | OpCode::RILe | OpCode::RIGt | OpCode::RIGe | OpCode::RIEq);
+                        if cmp {
+                            fx.line(format!("i64.const\t{TRUE}"));
+                            fx.line(format!("i64.const\t{FALSE}"));
+                        }
+                        fx.get(args[0]);
+                        fx.get(args[1]);
+                        fx.line(w);
+                        if cmp {
+                            fx.line("i64.select");
+                        }
+                        fx.def(*dst);
+                        continue;
+                    }
+                    match op {
+                        OpCode::RBox => {
+                            fx.get(args[0]);
+                            fx.line("i64.const\t1");
+                            fx.line("i64.shl");
+                            fx.line("i64.const\t1");
+                            fx.line("i64.or");
+                            fx.def(*dst);
+                            continue;
+                        }
+                        OpCode::RUnbox => {
+                            fx.get(args[0]);
+                            fx.line("i64.const\t1");
+                            fx.line("i64.shr_s");
+                            fx.def(*dst);
+                            continue;
+                        }
+                        OpCode::ILt | OpCode::ILe | OpCode::IGt | OpCode::IGe | OpCode::IEq => {
+                            let w = match op {
+                                OpCode::ILt => "i64.lt_s",
+                                OpCode::ILe => "i64.le_s",
+                                OpCode::IGt => "i64.gt_s",
+                                OpCode::IGe => "i64.ge_s",
+                                _ => "i64.eq",
