+                    fx.line(format!("i64.const\t{id}"));
+                    fx.constant(Const::Str(name.clone()));
+                    if payload.is_empty() {
+                        fx.line("call\trt_fail_declared");
+                        fx.helpers.insert("rt_fail_declared".into());
+                    } else {
+                        fx.line(format!("i64.const\t{shape}"));
+                        fx.line(format!("i64.const\t{}", payload.len()));
+                        fx.array(payload);
+                        fx.line("call\trt_fail_declared_payload");
+                        fx.helpers.insert("rt_fail_declared_payload".into());
+                        fx.restore_sp();
