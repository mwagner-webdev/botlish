+                    // The words as registers: a tag constant, then the piece's operands.
+                    let mut words: Vec<Option<Reg>> = Vec::new();
+                    let mut tags: Vec<u64> = Vec::new();
+                    for piece in pieces {
+                        let tag = match piece {
+                            crate::nir::Piece::Span(_) => TAG_SPAN,
+                            crate::nir::Piece::Region(..) => TAG_REGION,
+                            crate::nir::Piece::Elem(_) => TAG_ELEM,
+                        };
+                        tags.push(tag);
+                        words.push(None);
+                        for r in piece.regs() {
+                            words.push(Some(r));
+                        }
+                    }
+                    let mode = (if *list { MODE_LIST } else { 0 }) | (if *plan { MODE_PLAN } else { 0 });
+                    fx.line(format!("local.get\t{vm}"));
+                    fx.line(format!("i64.const\t{mode}"));
+                    fx.line(format!("i64.const\t{}", words.len()));
