+                    fx.array(args);
+                    fx.line("call\trt_call_value");
+                    fx.helpers.insert("rt_call_value".into());
+                    fx.restore_sp();
+                    fx.check(tmp);
+                    fx.def(*dst);
+                }
+                Inst::Br { cond, then, otherwise } => {
+                    let (bt, bo) = (fx.block_of[then], fx.block_of[otherwise]);
+                    fx.line(format!("i32.const\t{bt}"));
+                    fx.line(format!("i32.const\t{bo}"));
+                    fx.get(*cond);
+                    fx.line(format!("i64.const\t{TRUE}"));
+                    fx.line("i64.eq");
+                    fx.line("i32.select");
+                    fx.line(format!("local.set\t{pc}"));
