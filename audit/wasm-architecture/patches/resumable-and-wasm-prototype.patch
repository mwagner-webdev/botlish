diff -ruN a/native/src/codegen/resumable.rs b/native/src/codegen/resumable.rs
--- a/native/src/codegen/resumable.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/native/src/codegen/resumable.rs	2026-11-15 19:23:21.000000000 +0000
@@ -0,0 +1,384 @@
+//! WASM-ARCH PROTOTYPE (WASM-TARGET-AND-COROUTINE-ARCHITECTURE-MILESTONE-1.md):
+//! compiler-side resumable lowering of general coroutines, a NIR-to-NIR pass.
+//!
+//! Where the runtime has no stack switch (runtime::coroutine::RESUMABLE), every
+//! function that may yield (a `coyield`, or a direct call of a function that
+//! may: fusion's `yielding`, exact because a function that may yield is never
+//! a value, COROUTINES.md point 37) becomes a state machine over a heap frame:
+//!
+//! * its prologue takes the frame the caller (or the coroutine's segment) left
+//!   in the Vm (`frtake`): UNIT for a fresh call, else its own frame from its
+//!   last suspension, which it dispatches on (`frpoint`, a `switch`) to the
+//!   suspension point, reloading every register live there (`frget`,
+//!   `frgetraw`);
+//! * a yield stores the outward value (`cosuspend`), saves the registers live
+//!   after it into its frame (`frensure`, `frput`, `frputraw`, `frfinish`) and
+//!   returns SUSPEND; resumed, the yield's value is the message (`comsg`,
+//!   which fails when the coroutine is abandoned);
+//! * a call of a yielding function checks for SUSPEND (`frissuspend`): its
+//!   caller takes the callee's frame (`frpending`), saves its own live
+//!   registers with it and returns SUSPEND too; resumed, it hands the callee
+//!   its frame (`frsetresume`) and makes the call again, which continues the
+//!   callee where it stopped.
+//!
+//! No activation outlives a suspension: every frame is popped, and the
+//! suspended state is exactly the chain of frames, reachable from the
+//! coroutine object and traced like any object. The shadow stack stays one
+//! LIFO stack.
+use crate::codegen::fusion::{max_label, push_reg, yielding};
+use crate::codegen::roots::live_at_many;
+use crate::nir::{Function, Inst, Label, OpCode, Program, Reg, RegKind};
+
+#[derive(Default, Debug)]
+pub struct Report {
+    pub functions: usize,
+    pub yield_sites: usize,
+    pub call_sites: usize,
+    pub max_tagged: usize,
+    pub max_raw: usize,
+    pub refused: Vec<String>,
+}
+
+pub fn enabled() -> bool {
+    crate::runtime::coroutine::RESUMABLE && std::env::var("BOTLISH_NATIVE_RESUMABLE").map_or(true, |v| v != "0")
+}
+
+enum Site {
+    Yield { dst: Reg, value: Reg },
+    Call { closure: Option<Reg>, args: Vec<Reg> },
+}
+
+fn name_of(f: &Function) -> String {
+    if f.name.is_empty() { format!("#{}", f.id) } else { f.name.clone() }
+}
+
+/// Lowers every yielding function of PROGRAM. Err: a construct the prototype
+/// does not lower (the program then refuses to run its coroutines).
+pub fn lower(program: &mut Program) -> Result<Report, String> {
+    let y = yielding(program);
+    let mut report = Report::default();
+    // A yielding function's result must be one tagged Value (SUSPEND travels
+    // in it): a scalar result (raw, short, packed ASCII: proven small or
+    // short, so boxing is exact) is boxed at its returns and unboxed by its
+    // callers after their suspension check; multiple results are refused.
+    let mut converted: Vec<Option<RegKind>> = vec![None; program.functions.len()];
+    for i in 0..program.functions.len() {
+        let f = &mut program.functions[i];
+        if !y[i] || f.results != 1 || f.plan_result {
+            continue;
+        }
+        let kind = if f.raw_result { RegKind::Raw } else if f.short_result { RegKind::Short } else if f.ascii_result { RegKind::Ascii } else { continue };
+        let boxing = match kind { RegKind::Raw => OpCode::RBox, RegKind::Short => OpCode::ShortToStr, _ => OpCode::AsciiToStr };
+        let old_body = std::mem::take(&mut f.body);
+        let old_origins = std::mem::take(&mut f.origins);
+        for (inst, origin) in old_body.into_iter().zip(old_origins) {
+            if let Inst::Ret(r) = inst {
+                let t = push_reg(f, RegKind::Tagged, false);
+                f.body.push(Inst::Op { dst: t, op: boxing, args: vec![r] });
+                f.origins.push(origin);
+                f.body.push(Inst::Ret(t));
+                f.origins.push(origin);
+            } else {
+                f.body.push(inst);
+                f.origins.push(origin);
+            }
+        }
+        f.raw_result = false;
+        f.short_result = false;
+        f.ascii_result = false;
+        converted[i] = Some(kind);
+    }
+    for g in program.functions.iter_mut() {
+        if !g.body.iter().any(|inst| matches!(inst, Inst::Call { func, .. } | Inst::CallEnv { func, .. } if converted[*func as usize].is_some())) {
+            continue;
+        }
+        let old_body = std::mem::take(&mut g.body);
+        let old_origins = std::mem::take(&mut g.origins);
+        for (inst, origin) in old_body.into_iter().zip(old_origins) {
+            let (func, dst) = match &inst {
+                Inst::Call { func, dst, .. } | Inst::CallEnv { func, dst, .. } => (*func, *dst),
+                _ => {
+                    g.body.push(inst);
+                    g.origins.push(origin);
+                    continue;
+                }
+            };
+            let Some(kind) = converted[func as usize] else {
+                g.body.push(inst);
+                g.origins.push(origin);
+                continue;
+            };
+            let t = push_reg(g, RegKind::Tagged, false);
+            let inst = match inst {
+                Inst::Call { func, args, may_error, may_gc, .. } => Inst::Call { dst: t, func, args, may_error, may_gc },
+                Inst::CallEnv { func, closure, args, may_error, may_gc, .. } => Inst::CallEnv { dst: t, func, closure, args, may_error, may_gc },
+                _ => unreachable!(),
+            };
+            g.body.push(inst);
+            g.origins.push(origin);
+            let unboxing = match kind { RegKind::Raw => OpCode::RUnbox, RegKind::Short => OpCode::StrToShort, _ => OpCode::StrToAscii };
+            g.body.push(Inst::Op { dst, op: unboxing, args: vec![t] });
+            g.origins.push(None);
+        }
+    }
+    for (i, f) in program.functions.iter().enumerate() {
+        if y[i] && (f.raw_result || f.short_result || f.ascii_result || f.plan_result) {
+            report.refused.push(format!("{}: a yielding function with a scalar or multiple result", name_of(f)));
+        }
+    }
+    if !report.refused.is_empty() {
+        return Err(report.refused.join("; "));
+    }
+    for i in 0..program.functions.len() {
+        if !y[i] {
+            continue;
+        }
+        let f = &program.functions[i];
+        let mut sites: Vec<(usize, Site)> = Vec::new();
+        for (j, inst) in f.body.iter().enumerate() {
+            match inst {
+                Inst::Op { dst, op: OpCode::CoYield, args } => sites.push((j, Site::Yield { dst: *dst, value: args[0] })),
+                Inst::Call { func, args, .. } if y[*func as usize] => sites.push((j, Site::Call { closure: None, args: args.clone() })),
+                Inst::CallEnv { func, closure, args, .. } if y[*func as usize] => {
+                    sites.push((j, Site::Call { closure: Some(*closure), args: args.clone() }))
+                }
+                Inst::CallMulti { func, args, .. } if y[*func as usize] => sites.push((j, Site::Call { closure: None, args: args.clone() })),
+                Inst::CallEnvMulti { func, closure, args, .. } if y[*func as usize] => {
+                    sites.push((j, Site::Call { closure: Some(*closure), args: args.clone() }))
+                }
+                _ => {}
+            }
+        }
+        let indices: Vec<usize> = sites.iter().map(|(j, _)| *j).collect();
+        let live = live_at_many(f, &indices);
+        let mut f = program.functions[i].clone();
+        let rf = push_reg(&mut f, RegKind::Tagged, false);
+        let is_frame = push_reg(&mut f, RegKind::Tagged, false);
+        let mut next = max_label(&f).map_or(0, |l| l + 1);
+        let mut label = || {
+            next += 1;
+            next - 1
+        };
+        // What each site saves: (tagged, scalar) registers live after it.
+        let mut saved: Vec<(Vec<Reg>, Vec<Reg>)> = Vec::new();
+        for ((j, site), (_, out)) in sites.iter().zip(&live) {
+            let dsts: Vec<Reg> = match &f.body[*j] {
+                Inst::Op { dst, .. } | Inst::Call { dst, .. } | Inst::CallEnv { dst, .. } => vec![*dst],
+                Inst::CallMulti { dsts, .. } | Inst::CallEnvMulti { dsts, .. } => dsts.clone(),
+                _ => unreachable!(),
+            };
+            let mut tagged = Vec::new();
+            let mut scalar = Vec::new();
+            for r in 0..out.len() as Reg {
+                let force = matches!(site, Site::Call { closure: Some(c), .. } if *c == r);
+                if (!out[r as usize] && !force) || dsts.contains(&r) || r == rf || r == is_frame {
+                    continue;
+                }
+                if f.kind_of(r) == RegKind::Tagged { tagged.push(r) } else { scalar.push(r) }
+            }
+            saved.push((tagged, scalar));
+        }
+        let cap_tagged = saved.iter().map(|s| s.0.len()).max().unwrap_or(0);
+        let cap_raw = saved.iter().map(|s| s.1.len()).max().unwrap_or(0);
+        report.max_tagged = report.max_tagged.max(cap_tagged);
+        report.max_raw = report.max_raw.max(cap_raw);
+
+        let l_dispatch = label();
+        let l_start = label();
+        let resume_labels: Vec<Label> = sites.iter().map(|_| label()).collect();
+        let reenter_labels: Vec<Label> = sites.iter().map(|_| label()).collect();
+        let l_bad = label();
+
+        let old_body = std::mem::take(&mut f.body);
+        let old_origins = std::mem::take(&mut f.origins);
+        let mut body: Vec<Inst> = Vec::new();
+        let mut origins: Vec<Option<u32>> = Vec::new();
+        macro_rules! emit {
+            ($f:expr, $inst:expr) => {{
+                body.push($inst);
+                origins.push(None);
+            }};
+        }
+        let raw = |f: &mut Function, body: &mut Vec<Inst>, origins: &mut Vec<Option<u32>>, n: usize| -> Reg {
+            let r = push_reg(f, RegKind::Raw, false);
+            body.push(Inst::RawInt { dst: r, digits: n.to_string() });
+            origins.push(None);
+            r
+        };
+        let unit = |f: &mut Function| push_reg(f, RegKind::Tagged, false);
+        emit!(f, Inst::Op { dst: rf, op: OpCode::FrTake, args: vec![] });
+        emit!(f, Inst::Op { dst: is_frame, op: OpCode::FrIsFrame, args: vec![rf] });
+        emit!(f, Inst::Br { cond: is_frame, then: l_dispatch, otherwise: l_start });
+        emit!(f, Inst::Label(l_start));
+        let mut site_of = std::collections::HashMap::new();
+        for (k, (j, _)) in sites.iter().enumerate() {
+            site_of.insert(*j, k);
+        }
+        for (j, inst) in old_body.into_iter().enumerate() {
+            let Some(&k) = site_of.get(&j) else {
+                body.push(inst);
+                origins.push(old_origins[j]);
+                continue;
+            };
+            let (tagged, scalar) = saved[k].clone();
+            // The suspension: save, finish, return SUSPEND.
+            let mut save = |f: &mut Function, body: &mut Vec<Inst>, origins: &mut Vec<Option<u32>>, callee: Reg| {
+                let nt = raw(f, body, origins, cap_tagged);
+                let nr = raw(f, body, origins, cap_raw);
+                let fr = push_reg(f, RegKind::Tagged, false);
+                body.push(Inst::Op { dst: fr, op: OpCode::FrEnsure, args: vec![rf, nt, nr] });
+                origins.push(None);
+                for (slot, r) in tagged.iter().enumerate() {
+                    let idx = raw(f, body, origins, slot);
+                    let t = unit(f);
+                    body.push(Inst::Op { dst: t, op: OpCode::FrPut, args: vec![fr, idx, *r] });
+                    origins.push(None);
+                }
+                for (slot, r) in scalar.iter().enumerate() {
+                    let idx = raw(f, body, origins, slot);
+                    let t = unit(f);
+                    body.push(Inst::Op { dst: t, op: OpCode::FrPutRaw, args: vec![fr, idx, *r] });
+                    origins.push(None);
+                }
+                let point = raw(f, body, origins, k + 1);
+                let count = raw(f, body, origins, tagged.len());
+                let s = push_reg(f, RegKind::Tagged, false);
+                body.push(Inst::Op { dst: s, op: OpCode::FrFinish, args: vec![fr, point, callee, count] });
+                origins.push(None);
+                if f.results > 1 {
+                    let mut rs = vec![s];
+                    for _ in 1..f.results {
+                        let u = push_reg(f, RegKind::Tagged, false);
+                        body.push(Inst::Unit { dst: u });
+                        origins.push(None);
+                        rs.push(u);
+                    }
+                    body.push(Inst::RetMulti(rs));
+                } else {
+                    body.push(Inst::Ret(s));
+                }
+                origins.push(None);
+            };
+            match &sites[k].1 {
+                Site::Yield { dst, value } => {
+                    report.yield_sites += 1;
+                    let t = unit(&mut f);
+                    body.push(Inst::Op { dst: t, op: OpCode::CoSuspend, args: vec![*value] });
+                    origins.push(old_origins[j]);
+                    let none = unit(&mut f);
+                    body.push(Inst::Unit { dst: none });
+                    origins.push(None);
+                    save(&mut f, &mut body, &mut origins, none);
+                    body.push(Inst::Label(resume_labels[k]));
+                    origins.push(None);
+                    body.push(Inst::Op { dst: *dst, op: OpCode::CoMsg, args: vec![] });
+                    origins.push(old_origins[j]);
+                }
+                Site::Call { .. } => {
+                    report.call_sites += 1;
+                    let dst = match &inst {
+                        Inst::Call { dst, .. } | Inst::CallEnv { dst, .. } => *dst,
+                        Inst::CallMulti { dsts, .. } | Inst::CallEnvMulti { dsts, .. } => dsts[0],
+                        _ => unreachable!(),
+                    };
+                    body.push(Inst::Jump(reenter_labels[k]));
+                    origins.push(None);
+                    body.push(Inst::Label(reenter_labels[k]));
+                    origins.push(None);
+                    body.push(inst);
+                    origins.push(old_origins[j]);
+                    let t = unit(&mut f);
+                    body.push(Inst::Op { dst: t, op: OpCode::FrIsSuspend, args: vec![dst] });
+                    origins.push(None);
+                    let suspend = resume_labels[k];
+                    let cont = { next += 1; next - 1 };
+                    body.push(Inst::Br { cond: t, then: suspend, otherwise: cont });
+                    origins.push(None);
+                    body.push(Inst::Label(suspend));
+                    origins.push(None);
+                    let cf = unit(&mut f);
+                    body.push(Inst::Op { dst: cf, op: OpCode::FrPending, args: vec![] });
+                    origins.push(None);
+                    save(&mut f, &mut body, &mut origins, cf);
+                    body.push(Inst::Label(cont));
+                    origins.push(None);
+                }
+            }
+        }
+        // The dispatch: reload what the suspension point saved, then continue
+        // after a yield, or make a suspended call again with its callee's frame.
+        let point = push_reg(&mut f, RegKind::Raw, false);
+        let dispatch_labels: Vec<Label> = sites.iter().map(|_| { next += 1; next - 1 }).collect();
+        body.push(Inst::Label(l_dispatch));
+        origins.push(None);
+        body.push(Inst::Op { dst: point, op: OpCode::FrPoint, args: vec![rf] });
+        origins.push(None);
+        let cases = dispatch_labels.iter().enumerate().map(|(k, l)| ((k + 1) as i64, (k + 1) as i64, *l)).collect();
+        body.push(Inst::Switch { value: point, default: l_bad, cases });
+        origins.push(None);
+        for (k, (_, site)) in sites.iter().enumerate() {
+            body.push(Inst::Label(dispatch_labels[k]));
+            origins.push(None);
+            let (tagged, scalar) = &saved[k];
+            for (slot, r) in tagged.iter().enumerate() {
+                let idx = raw(&mut f, &mut body, &mut origins, slot);
+                body.push(Inst::Op { dst: *r, op: OpCode::FrGet, args: vec![rf, idx] });
+                origins.push(None);
+            }
+            for (slot, r) in scalar.iter().enumerate() {
+                let idx = raw(&mut f, &mut body, &mut origins, slot);
+                body.push(Inst::Op { dst: *r, op: OpCode::FrGetRaw, args: vec![rf, idx] });
+                origins.push(None);
+            }
+            match site {
+                Site::Yield { .. } => {
+                    // Continue right after the suspension, at the yield's value.
+                    let after = resume_labels[k];
+                    // resume_labels[k] marks the CoMsg of a yield site.
+                    body.push(Inst::Jump(after));
+                    origins.push(None);
+                }
+                Site::Call { args, .. } => {
+                    // Arguments the callee will not read (it reloads its own
+                    // registers): defined, of their kinds.
+                    for a in args {
+                        if tagged.contains(a) || scalar.contains(a) {
+                            continue;
+                        }
+                        let inst = match f.kind_of(*a) {
+                            RegKind::Tagged => Inst::Unit { dst: *a },
+                            RegKind::Raw => Inst::RawInt { dst: *a, digits: "0".into() },
+                            RegKind::Short => Inst::ShortLit { dst: *a, value: -1 },
+                            RegKind::Ascii => Inst::AsciiLit { dst: *a, value: 0 },
+                            RegKind::I64 | RegKind::U64 => Inst::CWord { dst: *a, digits: "0".into() },
+                        };
+                        body.push(inst);
+                        origins.push(None);
+                    }
+                    let cf = push_reg(&mut f, RegKind::Tagged, false);
+                    body.push(Inst::Op { dst: cf, op: OpCode::FrCallee, args: vec![rf] });
+                    origins.push(None);
+                    let t = push_reg(&mut f, RegKind::Tagged, false);
+                    body.push(Inst::Op { dst: t, op: OpCode::FrSetResume, args: vec![cf] });
+                    origins.push(None);
+                    body.push(Inst::Jump(reenter_labels[k]));
+                    origins.push(None);
+                }
+            }
+        }
+        body.push(Inst::Label(l_bad));
+        origins.push(None);
+        body.push(Inst::Unreachable);
+        origins.push(None);
+        let _ = emit_unused();
+        f.body = body;
+        f.origins = origins;
+        f.may_gc = true;
+        report.functions += 1;
+        program.functions[i] = f;
+    }
+    crate::nir::validate(program).map_err(|e| format!("the resumable lowering's NIR does not validate: {e}"))?;
+    Ok(report)
+}
+
+fn emit_unused() {}
