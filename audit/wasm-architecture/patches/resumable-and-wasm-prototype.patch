+                format!("({}) -> (i64)", ps.join(", "))
+            }
+        };
+        writeln!(asm, "\t.functype\t{h} {sig}").unwrap();
+    }
+    for f in &program.functions {
+        writeln!(asm, "\t.functype\tbotlish_fn_{} {}", f.id, direct_type(f)).unwrap();
+        writeln!(asm, "\t.functype\tbotlish_entry_{} (i32, i64, i32) -> (i64)", f.id).unwrap();
+    }
+    asm.push_str("\t.text\n");
+    asm.push_str(&body);
