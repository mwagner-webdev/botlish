+        let ename = format!("botlish_entry_{}", f.id);
+        writeln!(body, "\t.globl\t{ename}\n\t.type\t{ename},@function\n{ename}:\n\t.functype\t{ename} (i32, i64, i32) -> (i64)\n\t.local\ti64, i64").unwrap();
