+                    fx.line("global.get\t__stack_pointer");
+                    fx.line(format!("local.tee\t{spl}"));
+                    fx.line(format!("i32.const\t{}", ((8 * words.len() + 15) / 16) * 16));
+                    fx.line("i32.sub");
+                    fx.line("global.set\t__stack_pointer");
