+                        fx.get(*closure);
+                    }
+                    for a in args {
+                        fx.get(*a);
+                    }
+                    fx.line(format!("call\tbotlish_fn_{func}"));
+                    // Results pop last-first; the first is the checked one.
+                    for d in dsts.iter().skip(1).rev() {
+                        fx.def(*d);
+                    }
