+                    fx.line(format!("local.get\t{vm}"));
+                    fx.line(format!("i64.const\t{shape}"));
+                    fx.line(format!("i64.const\t{}", fields.len()));
+                    fx.array(fields);
+                    fx.line("call\trt_struct_new");
+                    fx.helpers.insert("rt_struct_new".into());
+                    fx.restore_sp();
+                    fx.def(*dst);
+                }
+                Inst::StructGet { dst, slot, value } => {
+                    fx.line(format!("local.get\t{vm}"));
+                    fx.get(*value);
+                    fx.line(format!("i32.const\t{slot}"));
+                    fx.line("call\tproto_struct_get");
+                    fx.helpers.insert("proto_struct_get".into());
+                    fx.def(*dst);
+                }
+                Inst::ContextLoad { dst, offset } => {
+                    fx.line(format!("local.get\t{vm}"));
+                    fx.line(format!("i32.const\t{offset}"));
+                    fx.line("call\tproto_ctx_load");
+                    fx.helpers.insert("proto_ctx_load".into());
+                    fx.def(*dst);
+                }
+                Inst::ContextStore { offset, value } => {
+                    fx.line(format!("local.get\t{vm}"));
+                    fx.line(format!("i32.const\t{offset}"));
+                    fx.get(*value);
+                    fx.line("call\tproto_ctx_store");
+                    fx.helpers.insert("proto_ctx_store".into());
