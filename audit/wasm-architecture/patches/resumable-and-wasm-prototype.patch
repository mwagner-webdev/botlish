+                    fx.line("unreachable");
+                    terminated = true;
+                }
+                Inst::PushErrorExit(l) => fx.errors.push(Some(*l)),
+                Inst::CallMulti { dsts, func, args, may_error, .. } | Inst::CallEnvMulti { dsts, func, args, may_error, .. } => {
+                    fx.line(format!("local.get\t{vm}"));
