+# 1 if the facts of value binding B -- its type, its exact value -- were
+# derived from code whose meaning the front end could not establish: B is
+# declared by a `bind` whose value is no function, and the reachable code of
+# that value holds a diagnostic of the program's own, poison or a hole, or
+# refers to a value binding of which this holds, or calls a function whose
+# result is inferred (so the value's type is what its body makes it) and
+# whose code depends on a resolution diagnostic (recovery's unit graph for a
+# top-level function; its own code for a nested one).
+proc hir::emission::BindingDependent {b} {
+    variable hir
+    variable bindingDeps
+    if {[dict exists $bindingDeps $b]} {
+        return [dict get $bindingDeps $b]
+    }
+    dict set bindingDeps $b 0
+    set value [BoundValue $b]
+    if {$value eq "" || [dict get $hir exprs $value kind] eq "block"} {
+        return 0
+    }
+    if {[dict exists $hir poisoned $b]} {
+        set out 1
+    } elseif {![dict get $hir exprs $value reachable]} {
+        # A declaration after code that never completes: the binding's type
+        # is inference's default, whatever stopped it -- an unresolved name's
+        # `never` among the possibilities, by recovery's unit graph (the
+        # declaring unit: a module binding's statement, an enclosing
+        # function's whole declaration).
+        variable recovery
+        set out 0
+        if {$recovery ne {}} {
+            if {[dict exists $recovery *]} {
+                set out 1
+            } else {
+                set bind [dict get $hir bindings $b declaredBy]
+                set unit [dict getdef [dict get $recovery unitOf] $bind ""]
+                set out [dict exists [dict get $recovery units] $unit]
+            }
+        }
+    } else {
+        set out [CodeDependent $value 1]
+    }
+    dict set bindingDeps $b $out
+    return $out
+}
+
+# The value expression of the `bind` declaring binding B, or "".
+proc hir::emission::BoundValue {b} {
+    variable hir
+    set binding [dict get $hir bindings $b]
+    set bind [dict get $binding declaredBy]
+    if {[dict get $binding kind] ne "local" || $bind eq "" || ![dict exists $hir exprs $bind]
+            || [dict get $hir exprs $bind kind] ne "bind"} {
+        return ""
+    }
+    return [dict get $hir exprs $bind value]
+}
+
+# 1 if the reachable code of expression E (a nested function's body only
+# when DEEP) is what BindingDependent says.
+proc hir::emission::CodeDependent {e deep} {
+    variable hir
+    variable diagnosed
+    variable recovery
+    set node [dict get $hir exprs $e]
+    if {![dict get $node reachable]} {
+        return 0
+    }
+    if {[dict exists $hir poisoned $e] || [dict exists $hir syntaxDependent $e] || [dict exists $diagnosed $e]} {
+        return 1
+    }
+    if {[dict get $node kind] eq "ref" && [dict get $node binding] ne ""} {
+        set x [dict get $node binding]
+        set v [BoundValue $x]
+        if {$v ne "" && [dict get $hir exprs $v kind] eq "block"} {
+            if {[dict get $hir exprs $v declaredResult] ne "" || $recovery eq {}} {
+                return 0
+            }
+            if {[dict exists $recovery *]} { return 1 }
+            set bind [dict get $hir bindings $x declaredBy]
+            set unit [dict getdef [dict get $recovery unitOf] $bind ""]
+            if {$unit eq $bind} {
+                return [dict exists [dict get $recovery units] $unit]
+            }
+            return [CodeDependent $v 1]
+        }
+        if {$v ne ""} {
+            return [BindingDependent $x]
+        }
+        return 0
+    }
+    if {[dict get $node kind] eq "block" && !$deep} {
+        return 0
+    }
+    foreach child [hir::children $hir $e] {
+        if {[CodeDependent $child 0]} {
+            return 1
+        }
+    }
+    return 0
 }
 
