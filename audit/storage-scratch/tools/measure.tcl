# measure.tcl -- the measurements of STORAGE-COMPILER-MANAGED-SCRATCH-
# MILESTONE-1.md (sections 17, 21-23): the census's workloads
# (audit/storage-static-reuse/cases/) run natively with and without
# compiler-managed scratch storage, at N = 1 .. 10000.
#
#   tclsh9.0 audit/storage-scratch/tools/measure.tcl ?-sizes {1 10 ...}?
#       ?-runs R? ?-time-size N? ?-memory 0|1? ?-out FILE?
#
# Per workload and size, with scratch storage off and on:
#
#   * the managed heap: allocations, bytes, collections and their time
#     (native::allocationReport, summary: the Botlish managed heap only);
#   * scratch storage: Strings placed, bytes, placements in reused bytes,
#     regions entered, reservations (chunks taken from the system
#     allocator) and growths, the peak reserved and the peak in use, the
#     fallbacks to the heap, and the run's stale roots and protocol errors;
#   * the marginal heap allocations and scratch reservations per unit
#     between the two largest sizes (a steady state needs none of either);
#   * at -time-size: the best and median of R runs (native::Driver bench,
#     compile time excluded) and the runs' spread, per unit;
#   * with -memory 1 (the default): the peak resident set of a standalone
#     executable of the workload at -time-size, scratch storage off and on
#     (python3's resource.getrusage of the child: the whole process).
set here [file dirname [file normalize [info script]]]
set audit [file dirname $here]
set root [file dirname [file dirname $audit]]
set options [list -sizes {1 10 100 1000 10000} -runs 7 -time-size 10000 -memory 1 \
    -out [file join $audit results measurements.md]]
set options [dict merge $options $argv]
set argv {}
source [file join $root tests helpers.tcl]
source [file join $root surface surface.tcl]
set env(LANG) C.utf8
set env(LC_ALL) C.utf8

proc readFile {path} {
    set f [open $path r]
    fconfigure $f -encoding utf-8
    set text [read $f]
    close $f
    return $text
}

set work [file tempdir]
set cases [file join $root audit storage-static-reuse cases]

# The case file NAME with its size literal OLD replaced by NEW (@N@ the size).
proc Program {name old new size} {
    set text [readFile [file join $::cases $name.bot]]
    if {[string first $old $text] < 0} {
        error "measure: $name has no \"$old\""
    }
    set text [string map [list $old [string map [list @N@ $size] $new]] $text]
    set path [file join $::work $name-$size.bot]
    set f [open $path w]
    fconfigure $f -encoding utf-8 -translation lf
    puts -nonewline $f $text
    close $f
    return $path
}

# workload -> {case old new}
set workloads [dict create \
    sequential {p01-sequential-temps {fold i from 0 to 1000 with} {fold i from 0 to @N@ with}} \
    loop       {p04-loop-reuse {work(1000)} {work(@N@)}} \
    request    {p13-request-handler {fold i from 0 to 200 with} {fold i from 0 to @N@ with}} \
    errors     {p14-errors-early-exit {fold i from 0 to 1000 with} {fold i from 0 to @N@ with}} \
    returned   {p05-escape-result {fold i from 0 to 1000 with} {fold i from 0 to @N@ with}} \
    actor      {p12-actor-messages {main(200):} {main(@N@):}}]

proc Opt {on} {
    return [list -scratch-opt [expr {$on ? 1 : 0}]]
}

proc Report {hir on} {
    return [native::allocationReport $hir summary 1 {*}[Opt $on]]
}

proc Scratch {report key} {
    return [dict getdef [dict getdef $report scratch {}] $key 0]
}

# {best median min-max} of R runs of HIR, in microseconds.
proc Times {hir on runs} {
    set text [native::nir $hir {*}[Opt $on]]
    set lines [native::Driver bench $text $runs]
    set times [lsearch -inline $lines {times *}]
    set us [lsort -real [lmap n [lrange $times 1 end] {expr {$n / 1000.0}}]]
    set median [lindex $us [expr {[llength $us] / 2}]]
    return [list [lindex $us 0] $median [lindex $us end]]
}

# The peak resident set (KB) of a standalone executable of HIR.
proc Memory {hir on name} {
    set exe [native::executable $hir [file join $::work $name-[expr {$on ? "on" : "off"}]] {*}[Opt $on]]
    set script {import resource, subprocess, sys
subprocess.run([sys.argv[1]], check=True, stdout=subprocess.DEVNULL)
print(resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss)}
    return [string trim [exec python3 -I -c $script $exe]]
}

set lines {}
lappend lines "# Measurements" "" \
    "Generated by \`tclsh9.0 audit/storage-scratch/tools/measure.tcl\` (STORAGE-COMPILER-MANAGED-SCRATCH-MILESTONE-1.md)." \
    "The native backend (cranelift), each size run once per configuration; \"off\" is \`-scratch-opt 0\`. Heap counts are the Botlish managed heap's (native::allocationReport); scratch counts are the scratch storage's own (runtime/scratch.rs)." ""
dict for {name spec} $workloads {
    lassign $spec case old new
    puts stderr "measure: $name"
    lappend lines "## $name ($case)" "" \
        "| N | heap allocations off / on | heap bytes off / on | collections off / on | GC us off / on | in scratch | scratch bytes | reused | regions | reservations | growths | peak reserved | peak in use | fallbacks | stale / protocol | value equal |" \
        "|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---|"
    set marginal {}
    foreach size [dict get $options -sizes] {
        set hir [surface::readProgramFile [Program $case $old $new $size] -warnings off]
        set off [Report $hir 0]
        set on [Report $hir 1]
        set equal [expr {[outcomeUnderHir cranelift $hir] eq [withEnvironment {BOTLISH_NATIVE_SCRATCH_OPT 0} {outcomeUnderHir cranelift $hir}]}]
        set t0 [dict get $off total]
        set t1 [dict get $on total]
        lappend marginal $size [dict get $t1 allocations] [Scratch $on reservations] [dict get $t0 allocations]
        lappend lines "| $size | [dict get $t0 allocations] / [dict get $t1 allocations] | [dict get $t0 allocatedBytes] / [dict get $t1 allocatedBytes] |\
            [dict get $off gc cycles] / [dict get $on gc cycles] | [dict get $off gc totalTimeUs] / [dict get $on gc totalTimeUs] |\
            [Scratch $on allocations] | [Scratch $on bytes] | [Scratch $on reused] | [Scratch $on regions] | [Scratch $on reservations] |\
            [Scratch $on growths] | [Scratch $on peakReserved] | [Scratch $on peakOccupancy] |\
            [expr {[Scratch $on fallbackLarge] + [Scratch $on fallbackCapacity]}] |\
            [Scratch $on staleRoots] / [Scratch $on protocolErrors] | [expr {$equal ? "yes" : "NO"}] |"
    }
    lassign [lrange $marginal end-7 end-4] s1 h1 r1 o1
    lassign [lrange $marginal end-3 end] s2 h2 r2 o2
    set d [expr {double($s2 - $s1)}]
    lappend lines "" "Marginal per unit between N = $s1 and $s2: heap allocations [format %.2f [expr {($o2 - $o1) / $d}]] off,\
        [format %.2f [expr {($h2 - $h1) / $d}]] on; scratch reservations [format %.4f [expr {($r2 - $r1) / $d}]] on."
    set size [dict get $options -time-size]
    set hir [surface::readProgramFile [Program $case $old $new $size] -warnings off]
    set runs [dict get $options -runs]
    lassign [Times $hir 0 $runs] b0 m0 x0
    lassign [Times $hir 1 $runs] b1 m1 x1
    lappend lines "Time at N = $size, $runs runs each: off best [format %.0f $b0] us, median [format %.0f $m0] us (spread [format %.0f $b0]-[format %.0f $x0]);\
        on best [format %.0f $b1] us, median [format %.0f $m1] us (spread [format %.0f $b1]-[format %.0f $x1]);\
        per unit [format %.3f [expr {$b0 / $size}]] us off, [format %.3f [expr {$b1 / $size}]] us on (best),\
        on/off [format %.2f [expr {$b1 / $b0}]] (best), [format %.2f [expr {$m1 / $m0}]] (median)."
    if {[dict get $options -memory] && [testConstraint executableAot]} {
        if {[catch {
            set k0 [Memory $hir 0 $name]
            set k1 [Memory $hir 1 $name]
            lappend lines "Peak resident set of a standalone executable at N = $size: [set k0] KB off, [set k1] KB on."
        } err]} {
            lappend lines "Peak resident set: not measured ([lindex [split $err \n] 0])."
        }
    }
    lappend lines ""
}
set f [open [dict get $options -out] w]
fconfigure $f -encoding utf-8 -translation lf
puts -nonewline $f [join $lines \n]\n
close $f
file delete -force $work
puts stderr "measure: wrote [dict get $options -out]"
