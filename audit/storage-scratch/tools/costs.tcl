# costs.tcl -- what a region costs and what a placed String saves
# (STORAGE-COMPILER-MANAGED-SCRATCH-MILESTONE-1.md, section 22): a cost
# probe, not a workload. One function called N times places K Strings per
# call in its activation region (K = 1 .. 8; K = 0 is a framed function
# whose one placed site is in a loop it never enters, so it pays the frame
# and an empty loop region and places nothing); the same program runs with
# scratch storage off and on.
#
#   tclsh9.0 audit/storage-scratch/tools/costs.tcl ?-n 100000? ?-runs 9?
#       ?-out FILE?
#
# Per K: the best and median of R timed runs each way (native::Driver bench,
# compile time excluded), the difference per call, and the heap allocations
# and scratch regions of one run, and the heap side's collections. The
# difference per call divided by K is the saving per placed String (a heap
# allocation and its share of the collections); K = 0 is the frame's cost
# (mark, reset, error exit) and an empty loop region's.
set here [file dirname [file normalize [info script]]]
set audit [file dirname $here]
set root [file dirname [file dirname $audit]]
set options [dict create -n 100000 -runs 9 -out [file join $audit results costs.md]]
foreach {k v} $argv {
    if {![dict exists $options $k]} { error "unknown option $k" }
    dict set options $k $v
}
set argv {}
source [file join $root tests helpers.tcl]
source [file join $root surface surface.tcl]
set env(LANG) C.utf8
set env(LC_ALL) C.utf8

# The program for K Strings per call.
proc Program {k n} {
    set body {}
    set sum {}
    if {$k == 0} {
        # A loop that never runs holds the one placed site, so the function
        # is framed (its loop region is emitted) but places nothing.
        lappend body "    t = fold j from 0 to i - i with intermediate acc 0:"
        lappend body "        acc + std::str::length(std::int::to_string(j))"
        set sum t
    }
    for {set j 0} {$j < $k} {incr j} {
        lappend body "    s$j = std::int::to_string(i + $j)"
        lappend sum "std::str::length(s$j)"
    }
    if {$sum eq {}} { set sum 0 }
    return "import std::int
import std::str

fn work(i: int) -> int:
[join $body \n]
    [join $sum { + }]

fold i from 0 to $n with intermediate total 0:
    total + work(i)
"
}

proc Times {hir on runs} {
    set text [native::nir $hir -scratch-opt [expr {$on ? 1 : 0}]]
    set lines [native::Driver bench $text $runs]
    set us [lsort -real [lmap t [lrange [lsearch -inline $lines {times *}] 1 end] {expr {$t / 1000.0}}]]
    return [list [lindex $us 0] [lindex $us [expr {[llength $us] / 2}]]]
}

set n [dict get $options -n]
set runs [dict get $options -runs]
set lines [list "# Costs of a region and savings of a placed String" "" \
    "Generated by \`tclsh9.0 audit/storage-scratch/tools/costs.tcl -n $n -runs $runs\` (STORAGE-COMPILER-MANAGED-SCRATCH-MILESTONE-1.md, section 22): one function called $n times, placing K Strings (\`std::int::to_string\`) per call in its activation region; times are the driver's \`bench\` (compile time excluded), best and median of $runs runs." "" \
    "| K | heap allocations off / on | collections off | regions on | best off us | best on us | median off us | median on us | (on - off) per call, ns (best) |" \
    "|---:|---:|---:|---:|---:|---:|---:|---:|---:|"]
set points {}
foreach k {0 1 2 4 8} {
    puts stderr "costs: K = $k"
    set hir [surface::compile [Program $k $n] -warnings off]
    if {[outcomeUnderHir cranelift $hir] ne [withEnvironment {BOTLISH_NATIVE_SCRATCH_OPT 0} {outcomeUnderHir cranelift $hir}]} {
        error "costs: K = $k: the outcomes differ"
    }
    set off [native::allocationReport $hir summary 1 -scratch-opt 0]
    set on [native::allocationReport $hir summary 1]
    lassign [Times $hir 0 $runs] b0 m0
    lassign [Times $hir 1 $runs] b1 m1
    set d [expr {($b1 - $b0) * 1000.0 / $n}]
    lappend points $k $d
    lappend lines "| $k | [dict get $off total allocations] / [dict get $on total allocations] | [dict get $off gc cycles] | [dict getdef [dict getdef $on scratch {}] regions 0] | [format %.0f $b0] | [format %.0f $b1] | [format %.0f $m0] | [format %.0f $m1] | [format %.1f $d] |"
}
lappend lines "" "Per placed String (off - on, per call, divided by K; best runs): [join [lmap {k d} $points {if {$k == 0} continue; format "K = %d: %.1f ns" $k [expr {-$d / $k}]}] {, }]. K = 0 (a frame and an empty loop region: five runtime calls, nothing placed): [format %.1f [dict get $points 0]] ns per call more with scratch storage. The heap side's time includes its collections (the column), part of what a placed String saves."

# p04 (one String per loop iteration, a reset per iteration) where its
# runs are long enough to time, and where the heap side starts collecting.
lappend lines "" "p04 (\`audit/storage-static-reuse/cases/p04-loop-reuse.bot\`, \`work(N)\`), best and median of $runs runs:" "" \
    "| N | collections (off) | best off us | best on us | median off us | median on us | per iteration off / on, ns (best) |" \
    "|---:|---:|---:|---:|---:|---:|---:|"
set f [open [file join $root audit storage-static-reuse cases p04-loop-reuse.bot]]
fconfigure $f -encoding utf-8
set p04 [read $f]
close $f
foreach size {10000 100000 1000000} {
    puts stderr "costs: p04 N = $size"
    set hir [surface::compile [string map [list "work(1000)" "work($size)"] $p04] -warnings off]
    set off [native::allocationReport $hir summary 1 -scratch-opt 0]
    lassign [Times $hir 0 $runs] b0 m0
    lassign [Times $hir 1 $runs] b1 m1
    lappend lines "| $size | [dict get $off gc cycles] | [format %.0f $b0] | [format %.0f $b1] | [format %.0f $m0] | [format %.0f $m1] | [format %.1f [expr {$b0 * 1000.0 / $size}]] / [format %.1f [expr {$b1 * 1000.0 / $size}]] |"
}
set f [open [dict get $options -out] w]
fconfigure $f -encoding utf-8 -translation lf
puts -nonewline $f [join $lines \n]\n
close $f
puts stderr "costs: wrote [dict get $options -out]"
