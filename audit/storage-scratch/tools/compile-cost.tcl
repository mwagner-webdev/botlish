# compile-cost.tcl -- what the storage-use plan costs at compile time
# (STORAGE-COMPILER-MANAGED-SCRATCH-MILESTONE-1.md, section 22): native
# lowering (`native::nir`, the HIR already built) with scratch storage off
# and on. On, lowering also runs hir::lifetime::analyze, the plan and the
# frames' post-processing; off is lowering as it was before the milestone.
#
#   tclsh9.0 audit/storage-scratch/tools/compile-cost.tcl ?-runs 3?
#       ?-out FILE? ?FILE.bot ...?
#
# Default corpus: three census cases, the 2048 demo, the event loop's
# fairness test program and the CSV export application. Each time is the
# best of R lowerings after one warm-up.
set here [file dirname [file normalize [info script]]]
set audit [file dirname $here]
set root [file dirname [file dirname $audit]]
set options [dict create -runs 3 -out [file join $audit results compile-cost.md]]
set files {}
for {set i 0} {$i < [llength $argv]} {incr i} {
    set a [lindex $argv $i]
    if {[dict exists $options $a]} {
        dict set options $a [lindex $argv [incr i]]
    } else {
        lappend files [file normalize $a]
    }
}
set argv {}
source [file join $root tests helpers.tcl]
source [file join $root surface surface.tcl]
set env(LANG) C.utf8
set env(LC_ALL) C.utf8
if {$files eq {}} {
    foreach f {
        audit/storage-static-reuse/cases/p01-sequential-temps.bot
        audit/storage-static-reuse/cases/p13-request-handler.bot
        audit/storage-static-reuse/cases/p12-actor-messages.bot
        examples/games/2048/demo.bot
        tests/event-loop/fairness.bot
        examples/dfa/csv/export.bot
    } {
        lappend files [file join $root $f]
    }
}
proc Best {script runs} {
    set best {}
    for {set i 0} {$i < $runs} {incr i} {
        set t [lindex [uplevel 1 [list time $script]] 0]
        if {$best eq {} || $t < $best} { set best $t }
    }
    return [expr {$best / 1000.0}]
}
set runs [dict get $options -runs]
set lines [list "# Compile-time cost of the storage-use plan" "" \
    "Generated by \`tclsh9.0 audit/storage-scratch/tools/compile-cost.tcl\` (STORAGE-COMPILER-MANAGED-SCRATCH-MILESTONE-1.md): native lowering of an already-built HIR (\`native::nir\`), best of $runs after a warm-up; \"on\" also runs hir::lifetime::analyze, the plan and the frames' post-processing." "" \
    "| program | lowering off, ms | lowering on, ms | difference | units | String producers | sites selected (Strings and calls) |" \
    "|---|---:|---:|---:|---:|---:|---:|"]
foreach file $files {
    set name [string map [list $root/ {}] $file]
    puts stderr "compile-cost: $name"
    set hir [surface::readProgramFile $file -warnings off]
    native::nir $hir -scratch-opt 0
    native::nir $hir -scratch-opt 1
    set off [Best {native::nir $hir -scratch-opt 0} $runs]
    set on [Best {native::nir $hir -scratch-opt 1} $runs]
    set plan [dict get [native::lowered $hir] storagePlan plan]
    set units 0; set sites 0; set selected 0
    foreach id [hir::storageplan::units $plan] {
        incr units
        dict for {site d} [dict get [hir::storageplan::unit $plan $id] sites] {
            if {[dict get $d kind] eq "str"} { incr sites }
            if {[dict get $d status] eq "selected"} { incr selected }
        }
    }
    lappend lines "| $name | [format %.0f $off] | [format %.0f $on] | [format %+.0f%% [expr {100.0 * ($on - $off) / $off}]] | $units | $sites | $selected |"
}
set f [open [dict get $options -out] w]
fconfigure $f -encoding utf-8 -translation lf
puts -nonewline $f [join $lines \n]\n
close $f
puts stderr "compile-cost: wrote [dict get $options -out]"
