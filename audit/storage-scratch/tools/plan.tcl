# plan.tcl -- the storage-use plans of a corpus (STORAGE-COMPILER-MANAGED-
# SCRATCH-MILESTONE-1.md, sections 5 and 18): for each program, the plan
# native lowering reads (hir::storageplan::report: every unit, every String
# producer, its region and why it is or is not placed) and what lowering
# emitted for each selected site.
#
#   tclsh9.0 audit/storage-scratch/tools/plan.tcl ?-out DIR? ?FILE.bot ...?
#
# With no FILE, the corpus is the census's cases
# (audit/storage-static-reuse/cases/). Writes DIR/NAME.txt per program and
# DIR/summary.md (default DIR: audit/storage-scratch/results/plans). Each
# program also runs once natively (scratch storage on): per emitted site,
# what executed through its region, through the fallback, or on the heap
# (the allocation report's sites, by HIR expression).
set here [file dirname [file normalize [info script]]]
set audit [file dirname $here]
set root [file dirname [file dirname $audit]]
set out [file join $audit results plans]
set files {}
for {set i 0} {$i < [llength $argv]} {incr i} {
    set a [lindex $argv $i]
    if {$a eq "-out"} {
        set out [file normalize [lindex $argv [incr i]]]
    } else {
        lappend files [file normalize $a]
    }
}
set argv {}
source [file join $root tests helpers.tcl]
source [file join $root surface surface.tcl]
set env(LANG) C.utf8
set env(LC_ALL) C.utf8
if {$files eq {}} {
    set files [lsort [glob [file join $root audit storage-static-reuse cases *.bot]]]
}
file mkdir $out

# A path relative to the checkout, for the reports (never a host path).
proc Relative {path} {
    set prefix $::root/
    if {[string first $prefix $path] == 0} {
        return [string range $path [string length $prefix] end]
    }
    return [file tail $path]
}

# The region-boundary actions that release a placed site's object.
proc Boundary {placement form} {
    switch -- [lindex $placement 0] {
        activation {
            return "its function's exits: the reset before every ret, and on the error exit"
        }
        iteration {
            return "its loop's reset at the head and at the exit (and its function's error exit when an error leaves the loop)"
        }
        caller {
            return "its caller's region: the function exits with scratchexit, which leaves it there when the caller gave a destination; the caller's own boundaries release it"
        }
    }
    return "?"
}

set summary [list "# Storage-use plans" "" \
    "Generated by \`tclsh9.0 audit/storage-scratch/tools/plan.tcl\` (STORAGE-COMPILER-MANAGED-SCRATCH-MILESTONE-1.md). One file per program: the plan native lowering reads, then what lowering emitted for each selected site." "" \
    "| program | units | framed | sites | selected | emitted | not emitted | rejected: not confined | rejected: unit has no region | rejected: not representable | ran in scratch storage | ran through the fallback |" \
    "|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|"]
foreach file $files {
    set name [file rootname [file tail $file]]
    puts stderr "plan: $name"
    if {[catch {surface::readProgramFile $file -warnings off} hir]} {
        # A program the compiler rejects (p16b) has no plan: say so.
        set f [open [file join $out $name.txt] w]
        fconfigure $f -encoding utf-8 -translation lf
        puts $f "# $name ([Relative $file])\n\nrejected by the compiler (no plan): [lindex [split [string map [list $::root/ {}] $hir] \n] 0]"
        close $f
        lappend summary "| $name | rejected by the compiler | | | | | | | | | | |"
        continue
    }
    set lowered [native::lowered $hir]
    set sp [dict get $lowered storagePlan]
    set plan [dict get $sp plan]
    set emitted [dict get $sp emitted]
    set lines [list "# $name ([Relative $file])" "" [hir::storageplan::report $hir $plan] "" "# What lowering emitted, and what ran"]
    set counts [dict create units 0 framed 0 sites 0 selected 0 emitted 0 missed 0 confined 0 noregion 0 representable 0 ranScratch 0 ranFallback 0]
    # The run: the native allocation report per site (scratch storage on),
    # by HIR expression -- what executed through a region, through the
    # fallback, or on the heap.
    set ran [dict create]
    if {[catch {native::allocationReport $hir sites 1} report]} {
        lappend lines "  (the program did not run natively: [lindex [split $report \n] 0])"
    } else {
        foreach site [dict get $report sites] {
            set key e[dict get $site hirExpr]
            # A String built where its binding is first read is attributed to
            # that read: count it for the bound expression (the site), as
            # native lowering matches it.
            if {[dict exists $hir exprs $key] && [dict get $hir exprs $key kind] eq "ref"} {
                set binding [dict get $hir exprs $key binding]
                if {$binding ne "" && [dict exists $hir bindings $binding]} {
                    set bind [dict get $hir bindings $binding declaredBy]
                    if {$bind ne "" && [dict exists $hir exprs $bind] && [dict get $hir exprs $bind kind] eq "bind"} {
                        set key [dict get $hir exprs $bind value]
                    }
                }
            }
            set prior [dict getdef $ran $key {0 0 0}]
            dict set ran $key [list [expr {[lindex $prior 0] + [dict get $site scratchAllocations]}] \
                [expr {[lindex $prior 1] + [dict get $site scratchFallbacks]}] \
                [expr {[lindex $prior 2] + [dict get $site allocations]}]]
        }
    }
    foreach id [hir::storageplan::units $plan] {
        set u [hir::storageplan::unit $plan $id]
        dict incr counts units
        if {[dict get $u frame]} {
            dict incr counts framed
        }
        dict for {site s} [dict get $u sites] {
            dict incr counts sites
            if {[dict get $s status] eq "selected"} {
                dict incr counts selected
                set st [dict getdef $emitted $id $site [dict create status "not emitted" reason "no record"]]
                if {[dict get $st status] eq "emitted"} {
                    dict incr counts emitted
                    lappend lines "  [dict get $u label]: [dict get $s what] at [dict get $s origin]: emitted ([dict get $st instructions] instruction(s))"
                    lappend lines "    released by: [Boundary [dict get $s placement] [dict get $s form]]"
                    lappend lines "    size: dynamic (the object's own size at run time); may still use the general allocator: yes, the fallback (above the object limit, 64 KiB, or past the reservation limit, 64 MiB per Vm)"
                    lassign [dict getdef $ran [dict get $s expr] {0 0 0}] inScratch fallbacks onHeap
                    dict incr counts ranScratch $inScratch
                    dict incr counts ranFallback $fallbacks
                    if {[dict get $s form] eq "call"} {
                        lappend lines "    ran: its callee placed what it returns (the callee's sites count it)"
                    } else {
                        lappend lines "    ran: $inScratch in scratch storage, $fallbacks fell back to the heap, $onHeap on the heap"
                    }
                } else {
                    dict incr counts missed
                    lappend lines "  [dict get $u label]: [dict get $s what] at [dict get $s origin]: not emitted -- [dict get $st reason]"
                }
            } elseif {[dict get $s representable] ne ""} {
                dict incr counts representable
            } elseif {[dict get $u blocked] ne ""} {
                dict incr counts noregion
            } else {
                dict incr counts confined
            }
        }
    }
    set f [open [file join $out $name.txt] w]
    fconfigure $f -encoding utf-8 -translation lf
    puts $f [join $lines \n]
    close $f
    lappend summary "| $name | [join [lmap k {units framed sites selected emitted missed confined noregion representable ranScratch ranFallback} {dict get $counts $k}] { | }] |"
}
lappend summary "" "A site is counted once by its first reason: not representable (a producer the backend does not place), else the unit has no region (it may suspend, is excluded, or is the program's own unit when nothing in it is placed), else not confined to its innermost region."
set f [open [file join $out summary.md] w]
fconfigure $f -encoding utf-8 -translation lf
puts $f [join $summary \n]
close $f
puts stderr "plan: wrote [Relative $out]"
