# sysalloc.tcl -- every system allocation, not only the managed heap's
# (STORAGE-COMPILER-MANAGED-SCRATCH-MILESTONE-1.md, sections 17 and 21): the
# positive workloads' standalone executables under valgrind, at two sizes,
# scratch storage off and on; the difference per unit is what each unit
# allocates from the system allocator -- managed-heap objects (a String is
# one block, a struct two: the object and its fields), the runtime helpers'
# own temporaries and anything else.
#
#   tclsh9.0 audit/storage-scratch/tools/sysalloc.tcl ?-sizes {1000 2000}?
#       ?-out FILE?
#
# valgrind's "total heap usage" of the whole process (startup included,
# which the difference cancels). Writes results/sysalloc.md.
set here [file dirname [file normalize [info script]]]
set audit [file dirname $here]
set root [file dirname [file dirname $audit]]
set options [dict create -sizes {1000 2000} -out [file join $audit results sysalloc.md]]
foreach {k v} $argv {
    if {![dict exists $options $k]} { error "unknown option $k" }
    dict set options $k $v
}
set argv {}
source [file join $root tests helpers.tcl]
source [file join $root surface surface.tcl]
set env(LANG) C.utf8
set env(LC_ALL) C.utf8
if {[catch {exec valgrind --version} version]} {
    puts stderr "sysalloc: valgrind is not installed"
    exit 1
}
set work [file tempdir]
lassign [dict get $options -sizes] n1 n2
set lines [list "# System allocations per unit" "" \
    "Generated by \`tclsh9.0 audit/storage-scratch/tools/sysalloc.tcl\` ([string trim $version]; STORAGE-COMPILER-MANAGED-SCRATCH-MILESTONE-1.md): every allocation of the system allocator in a standalone executable (valgrind's total heap usage), at N = $n1 and $n2; per unit is their difference over [expr {$n2 - $n1}] units. Managed-heap allocations per unit (native::allocationReport) beside it." "" \
    "| workload | system allocations per unit, off / on | managed-heap allocations per unit, off / on |" \
    "|---|---:|---:|"]
foreach {case old pattern} {
    p01 {fold i from 0 to 1000 with} {fold i from 0 to @N@ with}
    p04 {work(1000)} {work(@N@)}
    p13 {fold i from 0 to 200 with} {fold i from 0 to @N@ with}
    p14 {fold i from 0 to 1000 with} {fold i from 0 to @N@ with}
    p05 {fold i from 0 to 1000 with} {fold i from 0 to @N@ with}
} {
    set path [lindex [glob [file join $root audit storage-static-reuse cases $case-*.bot]] 0]
    set f [open $path]
    fconfigure $f -encoding utf-8
    set text [read $f]
    close $f
    set cells {}
    set heapCells {}
    foreach opt {0 1} {
        set sys {}
        set heap {}
        foreach n [list $n1 $n2] {
            set hir [surface::compile [string map [list $old [string map [list @N@ $n] $pattern]] $text] -warnings off]
            set exe [native::executable $hir [file join $work $case-$opt-$n] -scratch-opt $opt]
            catch {exec valgrind --leak-check=no $exe 2>@1} out
            if {![regexp {total heap usage: ([0-9,]+) allocs} $out -> a]} {
                error "sysalloc: no heap summary for $case:\n$out"
            }
            lappend sys [string map {, {}} $a]
            lappend heap [dict get [native::allocationReport $hir summary 1 -scratch-opt $opt] total allocations]
        }
        lappend cells [format %.2f [expr {([lindex $sys 1] - [lindex $sys 0]) / double($n2 - $n1)}]]
        lappend heapCells [format %.2f [expr {([lindex $heap 1] - [lindex $heap 0]) / double($n2 - $n1)}]]
    }
    puts stderr "sysalloc: $case"
    lappend lines "| [file rootname [file tail $path]] | [join $cells { / }] | [join $heapCells { / }] |"
}
file delete -force $work
set f [open [dict get $options -out] w]
fconfigure $f -encoding utf-8 -translation lf
puts -nonewline $f [join $lines \n]\n
close $f
puts stderr "sysalloc: wrote [dict get $options -out]"
