+/// EXPERIMENT ONLY -- audit/macos-graphical-main-thread
+/// (MACOS-GRAPHICAL-MAIN-THREAD-CENSUS.md); never part of the production
+/// runtime. Selected per run by the environment, so one build runs every
+/// model side by side:
+///
+///   BOTLISH_EXPERIMENT_THREAD=main      candidate A: `run` executes the
+///                                       program on its own thread (the
+///                                       process's main thread) and stack
+///   BOTLISH_EXPERIMENT_THREAD=dispatch  candidate B: the worker as ever,
+///                                       and the main thread serves
+///                                       `botlish_experiment_main_call`
+///                                       requests until the worker ends
+///   (unset)                             the production model: the worker
+///   BOTLISH_EXPERIMENT_NO_GUARD=1       no overflow guard (a positive
+///                                       control of the overflow tests)
+///   BOTLISH_EXPERIMENT_REPORT=1         one "MTP" line on standard error:
+///                                       the thread and the stack the
+///                                       runtime found
+pub mod experiment {
+    use std::ffi::c_void;
+    use std::sync::{mpsc, Mutex};
+    use std::time::Duration;
+
+    #[derive(Clone, Copy, PartialEq, Eq, Debug)]
+    pub enum Mode { Worker, Main, Dispatch }
+
+    pub fn mode() -> Mode {
+        match std::env::var("BOTLISH_EXPERIMENT_THREAD").as_deref() {
+            Ok("main") => Mode::Main,
+            Ok("dispatch") => Mode::Dispatch,
+            _ => Mode::Worker,
+        }
+    }
+
+    pub fn skip_guard() -> bool {
+        std::env::var_os("BOTLISH_EXPERIMENT_NO_GUARD").is_some_and(|v| v == "1")
+    }
+
+    fn process_main() -> i32 {
+        #[cfg(target_vendor = "apple")]
+        // SAFETY: no preconditions.
+        return unsafe { libc::pthread_main_np() };
+        #[cfg(target_os = "linux")]
+        // SAFETY: no preconditions.
+        return unsafe { (libc::syscall(libc::SYS_gettid) == libc::getpid() as libc::c_long) as i32 };
+        #[allow(unreachable_code)]
+        -1
+    }
+
+    pub fn report_thread(mode: Mode) {
+        if std::env::var_os("BOTLISH_EXPERIMENT_REPORT").is_none() {
+            return;
+        }
+        #[cfg(any(all(target_os = "linux", any(target_arch = "x86_64", target_arch = "aarch64")), all(target_os = "macos", target_arch = "aarch64"), all(windows, target_arch = "x86_64", target_env = "msvc")))]
+        let stack = match super::super::native_stack::NativeStack::current() {
+            Ok(s) => format!(
+                "\"stack_low\":\"{:#x}\",\"stack_high\":\"{:#x}\",\"guard_low\":\"{:#x}\",\"usable_bytes\":{},\"guard_bytes\":{}",
+                s.low_bound, s.high_bound, s.guard_low, s.high_bound - s.low_bound, s.low_bound - s.guard_low
+            ),
+            Err(e) => format!("\"stack_error\":\"{e}\""),
+        };
+        #[cfg(not(any(all(target_os = "linux", any(target_arch = "x86_64", target_arch = "aarch64")), all(target_os = "macos", target_arch = "aarch64"), all(windows, target_arch = "x86_64", target_env = "msvc"))))]
+        let stack = String::from("\"stack_error\":\"unsupported host\"");
+        eprintln!("MTP {{\"kind\":\"runtime\",\"mode\":\"{mode:?}\",\"pthread_main\":{},{stack}}}", process_main());
+    }
+
+    type Job = (extern "C" fn(*mut c_void), usize, mpsc::SyncSender<()>);
+    static QUEUE: Mutex<Option<mpsc::Sender<Job>>> = Mutex::new(None);
+
+    /// Runs F(DATA) on the main thread and waits for it: 0, or -1 when no
+    /// main thread serves requests (the production model, and after the
+    /// worker ended).
+    #[unsafe(no_mangle)]
+    pub extern "C" fn botlish_experiment_main_call(f: extern "C" fn(*mut c_void), data: *mut c_void) -> i32 {
+        let sender = QUEUE.lock().ok().and_then(|q| q.clone());
+        let Some(sender) = sender else { return -1 };
+        let (done, wait) = mpsc::sync_channel(1);
+        if sender.send((f, data as usize, done)).is_err() {
+            return -1;
+        }
+        if wait.recv().is_ok() { 0 } else { -1 }
+    }
+
+    pub fn open_queue() -> mpsc::Receiver<Job> {
+        let (sender, receiver) = mpsc::channel();
+        *QUEUE.lock().unwrap() = Some(sender);
+        receiver
+    }
+
+    /// The main thread's loop: every request, in order, until WORKER ends.
+    pub fn serve<T>(queue: mpsc::Receiver<Job>, worker: &std::thread::JoinHandle<T>) {
+        loop {
+            match queue.recv_timeout(Duration::from_millis(2)) {
+                Ok((f, data, done)) => {
+                    f(data as *mut c_void);
+                    let _ = done.send(());
+                }
+                Err(mpsc::RecvTimeoutError::Timeout) => {
+                    if worker.is_finished() {
+                        break;
+                    }
+                }
+                Err(mpsc::RecvTimeoutError::Disconnected) => break,
+            }
+        }
+        *QUEUE.lock().unwrap() = None;
+    }
+}
