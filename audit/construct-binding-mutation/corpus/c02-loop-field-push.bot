# category: loop-element (List of structs), a field path of the loop variable
# class: C -- silently discarded write
# intended: close every shape by appending a point, then count the points (4)
# actual: the push changes the loop variable's copy of each shape; the count
#         reads the original shapes (2)
# fixed: c02-loop-field-push-fixed.bot
# expect: 2
import std::mutable_vector

struct Shape:
    points: MutableVector[int]
    name: str

fn make(k: int) -> Shape:
    Shape {points: std::mutable_vector::from_list([k]), name: "s"}

fn close_all(shapes: List[Shape]) -> int:
    loop s in shapes:
        s.points.push(0)
    fold s in shapes with intermediate n 0:
        n + s.points.length()

close_all([make(1), make(2)])
