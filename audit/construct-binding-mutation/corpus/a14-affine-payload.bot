# category: handler-payload of an affine type (a vector of coroutine handles)
# class: A -- an ownership transfer: the payload moves into the handler's
#        binding (no copy), is pushed onto and measured, and is released
# expect: [2]
# alloc: mutableVector shares 0 detaches 0
import std::coroutine
import std::mutable_vector

struct Msg:
    v: int
struct Ev:
    v: int

fn w(acc: int, resume Msg) -> Ev:
    m = yield Ev {v: acc}
    Ev {v: acc + m.v}

fn make(acc: int) -> Coroutine{args: [Msg], return: Ev}:
    coroutine {step} = w(acc)
    step

error Stalled:
    tasks: MutableVector[Coroutine{args: [Msg], return: Ev}]

fn schedule(n: int) -> int errors Stalled:
    if n > 0:
        return n
    fail Stalled {tasks: std::mutable_vector::from_list([make(1)])}

fn run(n: int) -> List[int]:
    r = schedule(n):
        on Stalled details:
            details.tasks.push(make(2))
            details.tasks.length()
    [r]

run(0)
