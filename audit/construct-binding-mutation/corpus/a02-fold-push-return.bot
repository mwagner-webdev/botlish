# category: fold-intermediate
# class: A -- productive local mutation (the idiom fold-loops-mutable-vector
#        pins), and its cost at the census: the intermediate's entry was a
#        logical copy of the carried value, so every iteration's push
#        detached the whole vector -- 1000 pushes copied 499,500 elements
#        (section 15). Since CONSUMED-FOLD-INTERMEDIATES-MILESTONE-1.md the
#        intermediate is consumed (no exit of the fold): nothing is copied.
# expect: 1000
# alloc: mutableVector shares 0 detaches 0 detachElements 0
import std::mutable_vector

fn ints() -> MutableVector[int]:
    std::mutable_vector::from_list([])

fn f(n: int) -> int:
    w = fold i from 0 to n with intermediate acc ints():
        acc.push(i)
        acc
    w.length()

f(1000)
