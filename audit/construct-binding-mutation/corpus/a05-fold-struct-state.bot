# category: fold-intermediate (a struct of two vectors)
# class: A -- productive local mutation carrying several pieces of state;
#        at the census each iteration shared both vectors and detached the
#        one it pushed (400 shares, 200 detaches, 9,900 elements copied);
#        since CONSUMED-FOLD-INTERMEDIATES-MILESTONE-1.md the struct
#        intermediate is consumed: nothing is copied
# expect: [100, 100]
# alloc: mutableVector shares 0 detaches 0 detachElements 0
import std::mutable_vector

fn ints() -> MutableVector[int]:
    std::mutable_vector::from_list([])

struct Acc:
    evens: MutableVector[int]
    odds: MutableVector[int]

fn split(n: int) -> List[int]:
    t = fold i from 0 to n with intermediate a Acc {evens: ints(), odds: ints()}:
        if i < 100:
            a.evens.push(i)
        else:
            a.odds.push(i)
        a
    [t.evens.length(), t.odds.length()]

split(200)
