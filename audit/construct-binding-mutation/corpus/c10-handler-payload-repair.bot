# category: handler-payload, given to a place parameter
# class: C -- silently discarded write
# intended: on Overflow, clear the caller's buffer and retry (buffer length 1)
# actual: the payload is a logical copy of the buffer the raiser put in it;
#         clearing and refilling it changes the copy, and `buf` keeps its 2
#         elements -- the retry's result (1) is the copy's length
# expect: [1, 2]
import std::mutable_vector

error Overflow:
    pending: MutableVector[int]

fn ints() -> MutableVector[int]:
    std::mutable_vector::from_list([])

fn flush(place buf: MutableVector[int], x: int) -> int errors Overflow:
    if buf.length() >= 2:
        fail Overflow {pending: buf}
    buf.push(x)
    buf.length()

fn run() -> List[int]:
    buf = ints()
    buf.push(1)
    buf.push(2)
    r = flush(buf, 3):
        on Overflow details:
            details.pending.clear()
            flush(details.pending, 3):
                on Overflow:
                    -1
    [r, buf.length()]

run()
