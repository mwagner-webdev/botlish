# probe: the same program as c5 without `import std::byte`: the byte index
# is proven to lie in the 256-entry table, so no IndexNotFound handler is
# needed, as in c5. Before STDLIB-ENCODE-UTF8-RESULT-TYPE-STABILITY-
# MILESTONE-1.md this program was rejected (two UNHANDLED-ERROR
# diagnostics): an import nothing used decided acceptance (C).
# outcome: accept
# value: [105, 196, 170, 109, 109, 112]
# binding: 15 b int[std::byte::Byte]
import std::str
import std::list

fn classes(s: str) -> List[int]:
    table = loop i from 0 to 256:
        i + 1
    loop b in s.encode_utf8():
        table.at(b)

classes("héllo")
