# probe: the same program as c5 without `import std::byte`: the byte index
# is not proven to lie in the 256-entry table, so the call needs
# IndexNotFound handled (C: an import nothing uses changes acceptance).
# outcome: reject
# diagnostic: 16:1 this call may produce the declared error "IndexNotFound"
# diagnostic: 14:9 this call of "std::list::at" may produce the declared error "IndexNotFound"
import std::str
import std::list

fn classes(s: str) -> List[int]:
    table = loop i from 0 to 256:
        i + 1
    loop b in s.encode_utf8():
        table.at(b)

classes("héllo")
