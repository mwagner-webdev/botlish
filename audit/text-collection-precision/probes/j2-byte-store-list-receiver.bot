import std::str
import std::list
import std::byte_store

fn f(s: str) errors LowerUnderrun, UpperOverrun:
    s.encode_utf8().slice(0, 1)

r = f("ab"):
    on LowerUnderrun:
        0
    on UpperOverrun:
        0
