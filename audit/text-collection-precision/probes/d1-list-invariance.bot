import std::str
import std::list
import std::byte
import std::mutable_vector

fn sum(xs: List[int]) -> int:
    fold x in xs with intermediate acc 0:
        acc + x

fn sum_untyped(xs) -> int:
    fold x in xs with intermediate acc 0:
        acc + x

fn sum_list(xs: list) -> int:
    fold x in xs with intermediate acc 0:
        acc + x

fn widened(s: str) -> List[int]:
    s.encode_utf8()

fn need_bytes(xs: List[std::byte::Byte]) -> int:
    std::list::length(xs)

fn vec(v: MutableVector[int]) -> int:
    std::mutable_vector::length(v)

a = sum("héllo".encode_utf8())
b = sum_untyped("héllo".encode_utf8())
c = sum_list("héllo".encode_utf8())
e = need_bytes([1, 2])
f = sum(std::list::flat(["a".encode_utf8()]))
[a, b, c, e, f]
