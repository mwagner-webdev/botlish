import std::str
import std::list
import std::byte

struct Pair:
    first: std::byte::Byte
    rest: List[std::byte::Byte]

fn f(s: str) -> int:
    bs = s.encode_utf8()
    n = fold i from 0 to std::list::length(bs) with intermediate acc 0:
        acc + i
    m = fold b in bs and j from 0 to std::list::length(bs) with intermediate acc 0:
        acc + b + j
    {first, rest} = Pair {first: std::byte::from_int(7), rest: bs}
    n + m + first

f("ab")
