# cframes.tcl -- the C backend's explicit execution storage
# (STORAGE-EXECUTION-OWNER-CENSUS-1.md, sections 15, 16 and 23): for the
# probes in the freestanding C subset and the kiosk, the coroutine storage
# types and their sizes per target, the writable objects of static storage
# duration the generated C declares, and the transient C stack the
# generated functions use.
#
#   tclsh9.0 audit/storage-execution-owner/tools/cframes.tcl ?-out FILE?
#       ?-targets {thumbv6m-none-eabi msp430 avr}?
#
# Sizes are one compiler's layout for one target (C fixes no layout):
# examples/c-freestanding/frame-sizes.sh, the host's cc and clang for the
# cross targets. Stack usage is gcc -fstack-usage at -O2 on the host
# (static, per function; a call chain's total is not summed here). Writes
# FILE (default audit/storage-execution-owner/results/cframes.md).
set here [file dirname [file normalize [info script]]]
set audit [file dirname $here]
set root [file dirname [file dirname $audit]]
set options [dict create -out [file join $audit results cframes.md] \
    -targets {thumbv6m-none-eabi msp430 avr}]
set options [dict merge $options $argv]
set argv {}
set env(LANG) C.utf8
set env(LC_ALL) C.utf8
set work [file tempdir]

set programs [list \
    [file join $audit probes e15-c-frames.bot] \
    [file join $audit probes e13b-c-nested-owners.bot] \
    [file join $audit probes e16-static-instances.bot] \
    [file join $audit probes e16b-static-binding.bot] \
    [file join $root examples c-freestanding kiosk kiosk_bench.bot]]

proc readFile {path} {
    set f [open $path r]
    fconfigure $f -encoding utf-8
    set text [read $f]
    close $f
    return $text
}

set lines [list "# C execution storage: frames, statics, stack" "" \
    "Generated by \`tclsh9.0 audit/storage-execution-owner/tools/cframes.tcl\` (STORAGE-EXECUTION-OWNER-CENSUS-1.md). Each program is compiled with \`main.tcl -emit-c\`; sizes are \`examples/c-freestanding/frame-sizes.sh\`'s (the host's cc, and clang for each cross target: one compiler's layout, not a property of the program)." ""]
foreach file $programs {
    set name [file rootname [file tail $file]]
    puts stderr "cframes: $name"
    set dir [file join $work $name]
    file mkdir $dir
    set rel [string map [list $root/ {}] $file]
    lappend lines "## $name ($rel)" ""
    if {[catch {exec tclsh9.0 [file join $root main.tcl] -emit-c -out $dir $file 2>@1} message]} {
        lappend lines "not compiled: [string map [list $root/ {} $dir/ {}] [lindex [split $message \n] 0]]" ""
        continue
    }
    regsub {\.runtime\.json$} [file tail [lindex [glob [file join $dir *.runtime.json]] 0]] {} prefix
    # Frame sizes, per target.
    set sizes [dict create]
    set targets [concat host [dict get $options -targets]]
    if {[catch {exec env TMPDIR=$work sh [file join $root examples c-freestanding frame-sizes.sh] $dir $prefix} host]} {
        set host ""
    }
    set cross ""
    if {[llength [dict get $options -targets]]} {
        catch {exec env TMPDIR=$work sh [file join $root examples c-freestanding frame-sizes.sh] $dir $prefix {*}[dict get $options -targets]} cross
    }
    foreach line [split "$host\n$cross" \n] {
        if {[llength $line] != 4} continue
        lassign $line target type size align
        if {![string is integer -strict $size]} continue
        dict set sizes $type $target $size
    }
    if {[dict size $sizes]} {
        lappend lines "| coroutine type | [join $targets { | }] |" "|---|[string repeat ---:| [llength $targets]]"
        set storage [dict create]
        dict for {type per} $sizes {
            set short [string map [list ${prefix}_ {}] $type]
            lappend lines "| $short | [join [lmap t $targets {dict getdef $per $t ?}] { | }] |"
            # A construction site's storage is a co<K> type.
            if {[regexp {^co[0-9]+$} $short]} {
                foreach t $targets {
                    if {[dict exists $per $t]} {
                        dict incr storage $t [dict get $per $t]
                    }
                }
            }
        }
        lappend lines "" "Every construction site's storage (the co<K> types) summed: [join [lmap t $targets {string cat "$t [dict getdef $storage $t ?] B"}] {, }]. (A construction inside a yielding function is a field of that function's frame, so its co<K> is also inside its parent's: the sum then counts it twice.)" ""
    } else {
        lappend lines "No coroutine storage type." ""
    }
    # Writable objects of static storage duration, and what the header says.
    set statics {}
    foreach c [glob [file join $dir *.c]] {
        foreach line [split [readFile $c] \n] {
            if {[regexp {^static\s} $line] && ![regexp {\mconst\M} $line] && ![regexp {\(} $line]} {
                lappend statics [string trim $line]
            }
        }
    }
    set header [readFile [file join $dir $prefix.h]]
    set reentrant [expr {[string first "Not reentrant" $header] >= 0 ? "not reentrant" : ([string first "static storage" $header] >= 0 ? "writes no object of static storage duration" : "?")}]
    lappend lines "Writable file-scope objects: [expr {[llength $statics] ? [join $statics {; }] : "none"}] (the header: $reentrant)." ""
    # The transient C stack, per function (gcc -O2 -fstack-usage).
    set su {}
    foreach c [lsort [glob [file join $dir *.c]]] {
        if {[string match *_display.c $c]} continue
        set obj [file join $work [file rootname [file tail $c]].o]
        if {[catch {exec gcc -std=c11 -O2 -ffreestanding -fstack-usage -I $dir -c $c -o $obj 2>@1} m]} {
            lappend su "(not compiled: [lindex [split $m \n] 0])"
            continue
        }
        set sufile [file rootname $obj].su
        foreach line [split [string trim [readFile $sufile]] \n] {
            set fields [split $line \t]
            set fn [lindex [split [lindex $fields 0] :] end]
            lappend su "$fn [lindex $fields 1]"
        }
    }
    lappend lines "C stack per function at -O2 (bytes, static): [join [lmap s [lsort -integer -decreasing -index end $su] {string map [list ${prefix}_ {}] $s}] {; }]." ""
}
set f [open [dict get $options -out] w]
fconfigure $f -encoding utf-8 -translation lf
puts -nonewline $f [join $lines \n]
close $f
file delete -force $work
puts stderr "cframes: wrote [string map [list $root/ {}] [dict get $options -out]]"
