# stacks.tcl -- what K simultaneously suspended native coroutines cost
# today (STORAGE-EXECUTION-OWNER-CENSUS-1.md, section 23): each keeps one
# short String across its suspension -- the storage an execution owner
# would retain for it -- while the native runtime gives each its own
# stack.
#
#   tclsh9.0 audit/storage-execution-owner/tools/stacks.tcl ?-ks {1 256 1024 4096}?
#       ?-out FILE?
#
# Per K: the native allocation report (managed-heap allocations, the
# coroutine runtime's stacks mapped and reused), and, for a standalone
# executable of the program, the minor page faults and the peak resident
# set (python3's resource.getrusage of the child: the whole process). The
# faults are the measure: each is a page the process touched for the first
# time, and their slope between two Ks is the pages each suspended
# coroutine costs. The peak resident set is reported but is approximate
# (Linux syncs a thread's resident-page counters in batches, and the
# program runs on a worker thread). The
# address space a stack reserves is the runtime's constant
# (runtime/coroutine.rs: DEFAULT_STACK_BYTES 8 MiB plus GUARD_BYTES 64 KiB,
# mapped with MAP_NORESERVE on Linux), not measured here. Writes FILE
# (default audit/storage-execution-owner/results/stacks.md).
set here [file dirname [file normalize [info script]]]
set audit [file dirname $here]
set root [file dirname [file dirname $audit]]
set options [dict create -ks {1 256 1024 4096} -out [file join $audit results stacks.md]]
set options [dict merge $options $argv]
set argv {}
source [file join $root tests helpers.tcl]
source [file join $root surface surface.tcl]
set env(LANG) C.utf8
set env(LC_ALL) C.utf8
set work [file tempdir]

proc Program {k} {
    set text "import std::coroutine
import std::int
import std::mutable_vector
import std::str

fn request(id: int) -> int:
    head = \"GET /items/\".concat(std::int::to_string(id))
    yield std::str::length(head)
    std::str::length(head.concat(\" done\"))

fn empty_pending() -> MutableVector\[Coroutine{args: \[\], return: int, errors: \[\]}\]:
    std::mutable_vector::from_list(\[\])

fn burst(k: int) -> int:
    pending = empty_pending()
    opened = fold i from 0 to k with intermediate acc 0:
        coroutine {step, first} = request(i)
        pending.push(step)
        acc + first
    finished = fold with intermediate acc 0:
        h = pending.pop():
            on IndexNotFound:
                break
        acc + h()
    opened + finished

burst($k)
"
    set path [file join $::work k$k.bot]
    set f [open $path w]
    fconfigure $f -encoding utf-8 -translation lf
    puts -nonewline $f $text
    close $f
    return $path
}

# {minor faults, peak resident set in KB} of one run of EXE.
proc Usage {exe} {
    set script {import resource, subprocess, sys
subprocess.run([sys.argv[1]], check=True, stdout=subprocess.DEVNULL)
r = resource.getrusage(resource.RUSAGE_CHILDREN)
print(r.ru_minflt, r.ru_maxrss)}
    return [string trim [exec python3 -I -c $script $exe]]
}

set lines [list "# Suspended native coroutines: what they cost today" "" \
    "Generated by \`tclsh9.0 audit/storage-execution-owner/tools/stacks.tcl\` (STORAGE-EXECUTION-OWNER-CENSUS-1.md). K request coroutines are opened and all suspended at once (each keeps one String, \`head\`, across its suspension), then resumed to completion. The native backend (cranelift); heap counts are the managed heap's (native::allocationReport, scratch storage on); the resident set is a standalone executable's peak (the whole process)." "" \
    "| K | value | heap allocations | heap bytes | stacks mapped | stacks reused | released | minor page faults | peak resident set, KB (approximate) |" \
    "|---:|---|---:|---:|---:|---:|---:|---:|---:|"]
set points {}
foreach k [dict get $options -ks] {
    puts stderr "stacks: K = $k"
    set hir [surface::readProgramFile [Program $k] -warnings off]
    set value [lindex [outcomeUnderHir cranelift $hir] 1]
    set report [native::allocationReport $hir summary 1]
    set co [dict get $report coroutines]
    set exe [native::executable $hir [file join $work exe$k]]
    lassign [Usage $exe] faults rss
    lappend points $k $faults
    lappend lines "| $k | $value | [dict get $report total allocations] | [dict get $report total allocatedBytes] |\
        [dict get $co stacksMapped] | [dict get $co stacksReused] | [dict get $co released] | $faults | $rss |"
}
lassign [lrange $points end-3 end] k1 r1 k2 r2
set slope [expr {($r2 - $r1) / double($k2 - $k1)}]
lappend lines "" "Pages first touched per suspended coroutine, the slope of the minor faults between K = $k1 and K = $k2: [format %.2f $slope] (4 KiB pages on this host: about [format %.1f [expr {$slope * 4}]] KiB each)." \
    "Address space reserved per live coroutine stack: 8 MiB + 64 KiB guard (runtime/coroutine.rs, MAP_NORESERVE on Linux), so K = [lindex [dict get $options -ks] end] reserves about [expr {[lindex [dict get $options -ks] end] * (8 * 1024 + 64) / 1024}] MiB of address space." \
    "What each one keeps across its suspension is one String (\`head\`: \"GET /items/\" and at most 4 digits, a native block of at most 40 bytes) and its loop state."
set f [open [dict get $options -out] w]
fconfigure $f -encoding utf-8 -translation lf
puts $f [join $lines \n]
close $f
file delete -force $work
puts stderr "stacks: wrote [string map [list $root/ {}] [dict get $options -out]]"
