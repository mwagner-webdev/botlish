# nested-5.bot -- FOLD-VIRTUAL-LIST-CONSTRUCTION-MILESTONE-1.md's compile-cost
# input: 5 nested folds, each appending the List its inner fold builds
# (tools/economics.tcl). Generated; every fold is a plan fold.

import std::list

fn f(xs: List[int]):
    fold x1 in xs with intermediate a1 []:
        inner1 = fold x2 in xs with intermediate a2 []:
            inner2 = fold x3 in xs with intermediate a3 []:
                inner3 = fold x4 in xs with intermediate a4 []:
                    inner4 = fold x5 in xs with intermediate a5 []:
                        a5.append(x5)
                    a4.append(inner4)
                a3.append(inner3)
            a2.append(inner2)
        a1.append(inner1)

f([1, 2])
