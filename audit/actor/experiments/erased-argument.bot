# erased-argument.bot -- an `any` payload passed where M is expected: rejected (TYPE: "cannot be proven to satisfy M").
opaque struct Box[M]:
    payload: any

struct Pt:
    x: int
    y: int

fn wrap(m: M) -> Box[M]:
    Box[M] {payload: m}

fn same(b: Box[M], x: M) -> M:
    x

fn unwrap(b: Box[M]) -> M:
    same(b, b.payload)

p = unwrap(wrap(Pt {x: 1, y: 2}))
p.x + p.y
