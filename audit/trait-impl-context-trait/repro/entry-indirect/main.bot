# The implementation needs the context trait only through a helper it calls
# (the requirement is derived twice over). Should print "A" twice and be 2.
import std::io
import std::linux::io

fn say(text: str) -> unit:
    std::io::print_line(text):
        on std::io::WriteFailed:
            return unit

trait Thing:
    fn show(t: Thing) -> int

struct A:
    v: int

fn show(t: A) -> int:
    say("A")
    t.v

fn twice(t: Thing) -> int:
    t.show() + t.show()

with context std::linux::io::create()
twice(A {v: 1})
