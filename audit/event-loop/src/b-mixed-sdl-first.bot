# b-mixed-sdl-first.bot -- EVENT-LOOP-EXPLORATION.md, Experiment B: mixed.bot
# with the SDL3 adapter initialized first.
import evloop
import evn
import mixed

with context evloop::create(64, 0)
with context evn::create(4096, 16, 0)
mixed::run(true):
    on IndexNotFound:
        ["IndexNotFound"]
    on evloop::LoopReentered:
        ["LoopReentered"]
