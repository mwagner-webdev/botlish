# recursive.bot -- json.bot's structural layer written as recursive descent
# (DFA-COROUTINE-EXPLORATION.md, "Composition and its limits"): a value is
# a coroutine helper that calls itself for a nested value, so the nesting is
# the coroutine's own call stack rather than an explicit stack. Ordinary
# coroutine semantics express it (deep yields at any depth); coroutine
# fusion cannot (a recursive yielding function has unboundedly many
# suspended frames: COROUTINE-FUSION-MILESTONE-1.md 2.2), so it runs on the
# general runtime. validate_text_recursive is json.bot's validate_text with
# this structure.

import dfa
import json
import json_lex
import std::coroutine
import std::mutable_array

# Whether T may be a member's key.
fn key?(t: json::Lexeme) -> bool:
    t.kind == json::Kind::String

# The value that starts with token T, and everything inside it; DEPTH the
# containers around it. Each further token is a resume.
fn value(t: json::Lexeme, depth: int, max_depth: int, resume json::Lexeme) -> bool errors json::Structure, json::TooDeep:
    if t.kind == json::Kind::BeginArray:
        if depth >= max_depth:
            fail json::TooDeep {limit: max_depth}
        first = yield true
        if first.kind == json::Kind::EndArray:
            return true
        value(first, depth + 1, max_depth)
        loop:
            s = yield true
            if s.kind == json::Kind::EndArray:
                return true
            if s.kind != json::Kind::ValueSeparator:
                fail json::Structure {at: s.start, expected: ", or ]"}
            v = yield true
            value(v, depth + 1, max_depth)
    if t.kind == json::Kind::BeginObject:
        if depth >= max_depth:
            fail json::TooDeep {limit: max_depth}
        first = yield true
        if first.kind == json::Kind::EndObject:
            return true
        if not key?(first):
            fail json::Structure {at: first.start, expected: "a string or }"}
        loop:
            # A member: its key was the token before this resume.
            colon = yield true
            if colon.kind != json::Kind::NameSeparator:
                fail json::Structure {at: colon.start, expected: ":"}
            v = yield true
            value(v, depth + 1, max_depth)
            s = yield true
            if s.kind == json::Kind::EndObject:
                return true
            if s.kind != json::Kind::ValueSeparator:
                fail json::Structure {at: s.start, expected: ", or }"}
            k = yield true
            if not key?(k):
                fail json::Structure {at: k.start, expected: "a string"}
    if not json::value_start?(t.kind):
        fail json::Structure {at: t.start, expected: "a value"}
    true

fn document(max_depth: int, resume json::Lexeme) -> bool errors json::Structure, json::TooDeep:
    t = yield true
    value(t, 0, max_depth)
    e = yield true
    if e.kind != json::Kind::End:
        fail json::Structure {at: e.start, expected: "the end of the input"}
    true

fn validate_text_recursive(chunks: List[str], max_depth: int, max_token: int) -> json::Summary errors IndexNotFound, json::Lexical, json::Truncated, json::Structure, json::TooDeep, json::TokenTooLong:
    coroutine {step: next_symbol, first: c0} = json::scalars(chunks)
    coroutine {step: parse} = document(max_depth)
    current = std::mutable_array::create(1, c0)
    offset = std::mutable_array::create(1, 0)
    tokens = std::mutable_array::create(1, 0)
    took = std::mutable_array::create(1, false)
    loop:
        c = std::mutable_array::at(current, 0)
        if json::whitespace?(c):
            std::mutable_array::set(offset, 0, std::mutable_array::at(offset, 0) + 1)
            std::mutable_array::set(current, 0, next_symbol())
            continue
        start = std::mutable_array::at(offset, 0)
        if c == -1:
            parse(json::Lexeme {kind: json::Kind::End, start: start, end: start})
            break
        coroutine {step: feed, first} = json_lex::json_token(c):
            on dfa::UnrecognizedInput {state}:
                fail json::Lexical {at: start, state: state}
            on dfa::UnexpectedEnd {state}:
                fail json::Truncated {state: state}
        std::mutable_array::set(took, 0, first)
        loop:
            if std::mutable_array::at(took, 0):
                std::mutable_array::set(offset, 0, std::mutable_array::at(offset, 0) + 1)
                std::mutable_array::set(current, 0, next_symbol())
            if std::coroutine::done?(feed):
                break
            if std::mutable_array::at(offset, 0) - start >= max_token:
                fail json::TokenTooLong {at: start, limit: max_token}
            answer = feed(dfa::Symbol {code: std::mutable_array::at(current, 0)}):
                on dfa::UnrecognizedInput {state}:
                    fail json::Lexical {at: std::mutable_array::at(offset, 0), state: state}
                on dfa::UnexpectedEnd {state}:
                    fail json::Truncated {state: state}
            std::mutable_array::set(took, 0, answer)
        parse(json::Lexeme {kind: json::kind_of(c), start: start, end: std::mutable_array::at(offset, 0)})
        std::mutable_array::set(tokens, 0, std::mutable_array::at(tokens, 0) + 1)
    json::Summary {tokens: std::mutable_array::at(tokens, 0), symbols: std::mutable_array::at(offset, 0)}
