# composition.bot -- one driver for any recognizer (DFA-COROUTINE-
# EXPLORATION.md, "Composition"). A function that may yield is never a value
# (COROUTINES.md 37), so a driver cannot be handed a recognizer; but a
# function that *starts* one does not yield (the construction is a
# boundary), returns its handle (AFFINE-VALUES.md: a handle moves through
# results and fields) and is a value like any other. lex_with is json.bot's
# lex_text with the recognizer a parameter.
#
# Expressible today, with ordinary coroutine semantics -- and a fallback for
# coroutine fusion: the handle leaves the factory, so every token's
# recognizer runs on the general runtime (a stack, a switch per symbol).

import dfa
import json
import json_lex
import std::coroutine
import std::mutable_array

# A started recognizer: its handle, and whether it took its first symbol.
struct Started:
    step: Coroutine{args: [dfa::Symbol], return: bool, errors: [dfa::UnrecognizedInput, dfa::UnexpectedEnd]}
    first: bool

fn token(c: int) -> Started errors dfa::UnrecognizedInput, dfa::UnexpectedEnd:
    coroutine {step, first} = json_lex::json_token(c)
    Started {step: step, first: first}

fn token_strict(c: int) -> Started errors dfa::UnrecognizedInput, dfa::UnexpectedEnd:
    if c == 34:
        coroutine {step, first} = json_lex::json_string_strict(c)
        return Started {step: step, first: first}
    coroutine {step, first} = json_lex::json_token(c)
    Started {step: step, first: first}

# The tokens of CHUNKS, each recognized by the recognizer MAKE starts.
fn lex_with(make: Fn{args: [int], return: Started, errors: [dfa::UnrecognizedInput, dfa::UnexpectedEnd]}, chunks: List[str], max_token: int) -> json::Summary errors IndexNotFound, json::Lexical, json::Truncated, json::TokenTooLong:
    coroutine {step: next_symbol, first: c0} = json::scalars(chunks)
    current = std::mutable_array::create(1, c0)
    offset = std::mutable_array::create(1, 0)
    tokens = std::mutable_array::create(1, 0)
    took = std::mutable_array::create(1, false)
    loop:
        c = std::mutable_array::at(current, 0)
        if json::whitespace?(c):
            std::mutable_array::set(offset, 0, std::mutable_array::at(offset, 0) + 1)
            std::mutable_array::set(current, 0, next_symbol())
            continue
        if c == -1:
            break
        start = std::mutable_array::at(offset, 0)
        {step: feed, first} = make(c):
            on dfa::UnrecognizedInput {state}:
                fail json::Lexical {at: start, state: state}
            on dfa::UnexpectedEnd {state}:
                fail json::Truncated {state: state}
        std::mutable_array::set(took, 0, first)
        loop:
            if std::mutable_array::at(took, 0):
                std::mutable_array::set(offset, 0, std::mutable_array::at(offset, 0) + 1)
                std::mutable_array::set(current, 0, next_symbol())
            if std::coroutine::done?(feed):
                break
            if std::mutable_array::at(offset, 0) - start >= max_token:
                fail json::TokenTooLong {at: start, limit: max_token}
            answer = feed(dfa::Symbol {code: std::mutable_array::at(current, 0)}):
                on dfa::UnrecognizedInput {state}:
                    fail json::Lexical {at: std::mutable_array::at(offset, 0), state: state}
                on dfa::UnexpectedEnd {state}:
                    fail json::Truncated {state: state}
            std::mutable_array::set(took, 0, answer)
        std::mutable_array::set(tokens, 0, std::mutable_array::at(tokens, 0) + 1)
    json::Summary {tokens: std::mutable_array::at(tokens, 0), symbols: std::mutable_array::at(offset, 0)}
