        elif next == 4:
            dfa_json_escape_strict(0, c)
            1
        else:
            if c == -1:
                fail dfa::UnexpectedEnd {state: dfa_json_string_strict_state(next)}
            fail dfa::UnrecognizedInput {state: dfa_json_string_strict_state(next), symbol: c}
    m = yield true
    dfa_json_string_strict(target, m.code)

fn json_string_strict(first: int, resume dfa::Symbol) -> bool errors dfa::UnrecognizedInput, dfa::UnexpectedEnd:
    dfa_json_string_strict(0, first) == -2
