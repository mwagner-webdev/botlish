# yaml_lex.dfa -- a scoped subset of YAML 1.2.2's lexical grammar as
# declarative recognizers (DFA-COROUTINE-EXPLORATION.md, "YAML findings"):
# a stress test of the construct on a grammar JSON's does not resemble. The
# DFA front end (audit/dfa/tools/dfa.tcl) lowers it to yaml_lex.bot.
#
# In the subset: double-quoted scalars with every escape of 5.7, single-
# quoted scalars ('' is a quote), comments, and plain scalars of one line in
# flow context. Not in it, by the subset's design: block structure,
# indentation, block scalars (| and >), multi-line plain scalars, tags,
# anchors, directives, documents -- each needs a count or a stack that no
# finite set of states holds (the report says which).
#
# yaml_plain_flow is the counterexample: it is a well-formed automaton the
# front end accepts, and it is wrong, because the language it should
# recognize needs two symbols of lookahead (the report: "a: b").

import dfa

# c-printable without the line breaks and the byte order mark: nb-char (5.2,
# 5.4); its non-blank part, ns-char (5.5).
class nb_char = 0x09 0x20..0x7E 0x85 0xA0..0xD7FF 0xE000..0xFEFE 0xFF00..0xFFFD 0x10000..0x10FFFF
class ns_char = 0x21..0x7E 0x85 0xA0..0xD7FF 0xE000..0xFEFE 0xFF00..0xFFFD 0x10000..0x10FFFF
class break = '\n' '\r'
class white = ' ' '\t'
class hex = '0'..'9' 'a'..'f' 'A'..'F'

# c-double-quoted (7.3.1): nb-json characters but " and \, line breaks (the
# scalar may span lines; folding is the value's, not the token's), and the
# escapes of 5.7 -- an escaped line break included.
dfa yaml_escape over ascii:
    backslash:
        '\\' -> kind
    kind:
        '0' 'a' 'b' 't' '\t' 'n' 'v' 'f' 'r' 'e' ' ' '"' '/' '\\' 'N' '_' 'L' 'P' '\n' '\r' -> accept
        'x' -> x2
        'u' -> u4
        'U' -> U8
    x2:
        hex -> x1
    x1:
        hex -> accept
    u4:
        hex -> u3
    u3:
        hex -> u2
    u2:
        hex -> u1
    u1:
        hex -> accept
    U8:
        hex -> U7
    U7:
        hex -> U6
    U6:
        hex -> U5
    U5:
        hex -> u4

dfa yaml_double_quoted over unicode:
    class content = 0x09 0x20..0x21 0x23..0x5B 0x5D..0x10FFFF
    open:
        '"' -> body
    body:
        '"' -> accept
        '\\' -> call yaml_escape then body
        content break -> body

# c-single-quoted (7.3.2): '' is one quote, so the closing quote is known
# only at the symbol after it: one symbol of lookahead.
dfa yaml_single_quoted over unicode:
    class content = 0x09 0x20..0x26 0x28..0x10FFFF
    class not_quote = any except '\''
    open:
        '\'' -> body
    body:
        '\'' -> quote
        content break -> body
    quote:
        '\'' -> body
        not_quote -> accept before
        end -> accept

# c-nb-comment-text (6.6): # and the rest of the line, without the break.
dfa yaml_comment over unicode:
    start:
        '#' -> text
    text:
        nb_char -> text
        break -> accept before
        end -> accept

# ns-plain-one-line in flow context (7.3.3), as it can be declared: the
# first symbol no indicator, or one of - ? : followed by a safe one; ":" and
# "#" inside it only where they cannot start an indicator or a comment.
# WRONG at "colon": a ":" followed by a blank or a flow indicator is the
# mapping indicator, not part of the scalar, so the scalar ended *before*
# the ":" -- two symbols ago. A recognizer can leave one symbol unread, so
# this accepts "a:" where YAML means "a" and an indicator.
dfa yaml_plain_flow over unicode:
    class indicator = '-' '?' ':' ',' '[' ']' '{' '}' '#' '&' '*' '!' '|' '>' '\'' '"' '%' '@' '`'
    class flow_indicator = ',' '[' ']' '{' '}'
    class first = ns_char except indicator
    class safe = ns_char except flow_indicator
    class plain = safe except ':' '#'
    start:
        first -> body
        '-' '?' ':' -> lead
    lead:
        safe -> body
    body:
        plain '#' -> body
        ':' -> colon
        white break flow_indicator -> accept before
        end -> accept
    colon:
        safe -> body
        white break flow_indicator -> accept before
        end -> accept
