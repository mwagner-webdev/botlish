# d-errors.bot -- FOLD-VIRTUAL-STRUCT-STATE-CENSUS-1.md, Probe D: errors
# around a struct-carrying fold. A failure raised after a successor was
# computed leaves the fold with no value (the handler outside sees only its
# payload); a failure handled inside the body is an ordinary completion of
# the iteration; a failure from a callee mid-body abandons the candidate.
#
# expect: [[-1, 3], [12, 5], [7, 3]]

import std::list

error TooBig:
    at: int

struct P:
    a: int
    b: int

xs = [1, 2, 3, 4, 5]

fn check(x: int) -> int errors TooBig:
    if x > 3:
        fail TooBig {at: x}
    x

# Raised after the candidate: the fold has no value; the caller's handler
# reports where.
fn raised(xs: List[int]) -> List[int] errors TooBig:
    t = fold x in xs with intermediate s P {a: 0, b: 0}:
        n = P {a: s.a + x, b: s.b + 1}
        c = check(x)
        P {a: n.a + c * 0, b: n.b}
    [t.a, t.b]

fn caught(xs: List[int]) -> List[int]:
    r = raised(xs):
        on TooBig {at}:
            return [-1, at - 1]
    r

# Handled inside the body: the handler's value completes the iteration.
fn handled(xs: List[int]) -> List[int]:
    t = fold x in xs with intermediate s P {a: 0, b: 0}:
        c = check(x):
            on TooBig:
                0
        P {a: s.a + c * 2, b: s.b + 1}
    [t.a, t.b]

# A callee fails on some iterations; those iterations keep s through a
# handler that continues.
fn skipped(xs: List[int]) -> List[int]:
    t = fold x in xs with intermediate s P {a: 1, b: 0}:
        n = P {a: s.a + x, b: s.b + 1}
        c = check(x):
            on TooBig:
                continue
        P {a: n.a, b: n.b + c * 0}
    [t.a, t.b]

[caught(xs), handled(xs), skipped(xs)]
