# a-scan4-fold.bot -- FOLD-VIRTUAL-STRUCT-STATE-CENSUS-1.md, Probe A: the stateful scanner of audit/fold-loops/workloads/scanner-fold.bot with its fold carrying 4 fields (pos, idents, ints, sum) instead of 6: the same token transitions (number_at, ident_end, line_end unchanged), the nesting counters dropped.
#
# expect: [26, 15, 1116]

import std::char
import std::str

struct Scan:
    pos: int
    idents: int
    ints: int
    sum: int

struct Number:
    pos: int
    value: int

fn ident_char?(c: UnicodeChar) -> bool:
    std::char::is_tcl_alpha(c) or c == '_'

fn ident_end(text: str, start: int) -> int:
    fold with intermediate p start:
        if p < 0 or p >= std::str::length(text):
            break
        if not ident_char?(text.char_at(p)):
            break
        p + 1

fn line_end(text: str, start: int) -> int:
    fold with intermediate p start:
        if p < 0 or p >= std::str::length(text):
            break
        if text.char_at(p) == '\n':
            break
        p + 1

fn number_at(text: str, start: int) -> Number:
    fold with intermediate num Number {pos: start, value: 0}:
        p = num.pos
        if p < 0 or p >= std::str::length(text):
            break
        v = std::char::scalar_value(text.char_at(p))
        if v < 48 or v > 57:
            break
        Number {pos: p + 1, value: num.value * 10 + v - 48}

fn scan(text: str) -> Scan:
    fold with intermediate s Scan {pos: 0, idents: 0, ints: 0, sum: 0}:
        p = s.pos
        if p < 0 or p >= std::str::length(text):
            break
        c = text.char_at(p)
        v = std::char::scalar_value(c)
        if v >= 48 and v <= 57:
            num = text.number_at(p)
            Scan {pos: num.pos, idents: s.idents, ints: s.ints + 1, sum: s.sum + num.value}
        elif ident_char?(c):
            Scan {pos: text.ident_end(p), idents: s.idents + 1, ints: s.ints, sum: s.sum}
        elif c == '#':
            Scan {pos: text.line_end(p), idents: s.idents, ints: s.ints, sum: s.sum}
        else:
            Scan {pos: p + 1, idents: s.idents, ints: s.ints, sum: s.sum}

text = "(define (square x) (mul x x)) # squares 12\nlet total_42 = 7 (plus 100 (minus 3 2))\n(define (cube y) (mul y (mul y y))) # 3 levels\nlet limit = 250 (max 9 (min 81 (abs 6)))\n(list 1 2 3) # done 999\n(sum (range 0 10) 600)\n"

r = scan(text)
[r.idents, r.ints, r.sum]
