# c-two-vecs.bot -- FOLD-VIRTUAL-STRUCT-STATE-CENSUS-1.md, Probe C: two
# independent MutableVectors and a count, one vector pushed per iteration
# and the other carried through unchanged, completed by a new literal.
# tools/measure.tcl rewrites `n = ...`.
#
# expect: [1024, 512, 512, 261632]

import std::mutable_vector

struct Acc:
    count: int
    evens: MutableVector[int]
    odds: MutableVector[int]

fn ints() -> MutableVector[int]:
    std::mutable_vector::from_list([])

fn build(n: int) -> Acc:
    fold i from 0 to n with intermediate a Acc {count: 0, evens: ints(), odds: ints()}:
        if i.mod(2) == 0:
            a.evens.push(i)
        else:
            a.odds.push(i)
        Acc {count: a.count + 1, evens: a.evens, odds: a.odds}

fn total(v: MutableVector[int]) -> int:
    fold i from 0 to v.length() with intermediate s 0:
        s + v.at(i)

n = 1024
r = build(n)
[r.count, r.evens.length(), r.odds.length(), total(r.evens)]
