# c-vec-continue.bot -- FOLD-VIRTUAL-STRUCT-STATE-CENSUS-1.md, Probe C: the
# struct of c-vec-literal.bot in a fold the consumption does not reach: a
# `continue` after the push (CONSUMED-FOLD-INTERMEDIATES-MILESTONE-1.md,
# "Clean exits") must carry the iteration's starting value, so every
# iteration starts with a share of the whole struct by its descriptor
# (`mutable_vector#share(a, "s1.1.h")`), which builds a new struct. The
# control of section 9's field-wise share. tools/measure.tcl rewrites
# `n = ...`.
#
# expect: [342, 342, 174933]

import std::mutable_vector

struct Acc:
    count: int
    items: MutableVector[int]

fn ints() -> MutableVector[int]:
    std::mutable_vector::from_list([])

fn build(n: int) -> Acc:
    fold i from 0 to n with intermediate a Acc {count: 0, items: ints()}:
        a.items.push(i)
        if i.mod(3) != 0:
            continue
        Acc {count: a.count + 1, items: a.items}

fn total(v: MutableVector[int]) -> int:
    fold i from 0 to v.length() with intermediate s 0:
        s + v.at(i)

n = 1024
r = build(n)
[r.count, r.items.length(), total(r.items)]
