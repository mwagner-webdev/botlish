# ret-2.bot -- a 2-field fold as a function's value, read by its caller (tools/gen-width.tcl).
import std::list

struct S:
    f0: int
    f1: int

fn g(n: int) -> S:
    fold i from 0 to n with intermediate s S {f0: 0, f1: 0}:
        S {f0: (s.f0 + i + 0).mod(1000), f1: (s.f1 + i + 1).mod(1000)}

fn f(n: int, k: int) -> int:
    t = g(n + k * 0)
    t.f0 + t.f1

n = 1000
f(n, 1)
