# spill-8.bot -- a 8-field fold whose fields are live across a call every iteration (tools/gen-width.tcl).
import std::list

struct S:
    f0: int
    f1: int
    f2: int
    f3: int
    f4: int
    f5: int
    f6: int
    f7: int

# Recursive, so native lowering keeps it a call.
fn step(x: int) -> int:
    if x < 7:
        return x + 1
    step(x - 7)

fn f(n: int) -> int:
    t = fold i from 0 to n with intermediate s S {f0: 0, f1: 0, f2: 0, f3: 0, f4: 0, f5: 0, f6: 0, f7: 0}:
        k = step(i.mod(14))
        S {f0: (s.f0 + k * 0).mod(1000), f1: (s.f1 + k * 1).mod(1000), f2: (s.f2 + k * 2).mod(1000), f3: (s.f3 + k * 3).mod(1000), f4: (s.f4 + k * 4).mod(1000), f5: (s.f5 + k * 5).mod(1000), f6: (s.f6 + k * 6).mod(1000), f7: (s.f7 + k * 7).mod(1000)}
    t.f0 + t.f7

n = 1000
f(n)
