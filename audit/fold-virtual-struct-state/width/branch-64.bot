fn f(n: int) -> int:
    t = fold i from 0 to n with intermediate s S {f0: 0, f1: 0, f2: 0, f3: 0, f4: 0, f5: 0, f6: 0, f7: 0, f8: 0, f9: 0, f10: 0, f11: 0, f12: 0, f13: 0, f14: 0, f15: 0, f16: 0, f17: 0, f18: 0, f19: 0, f20: 0, f21: 0, f22: 0, f23: 0, f24: 0, f25: 0, f26: 0, f27: 0, f28: 0, f29: 0, f30: 0, f31: 0, f32: 0, f33: 0, f34: 0, f35: 0, f36: 0, f37: 0, f38: 0, f39: 0, f40: 0, f41: 0, f42: 0, f43: 0, f44: 0, f45: 0, f46: 0, f47: 0, f48: 0, f49: 0, f50: 0, f51: 0, f52: 0, f53: 0, f54: 0, f55: 0, f56: 0, f57: 0, f58: 0, f59: 0, f60: 0, f61: 0, f62: 0, f63: 0}:
        if i.mod(3) == 0:
            s
        else:
            S {f0: (s.f0 + i + 0).mod(1000), f1: (s.f1 + i + 1).mod(1000), f2: (s.f2 + i + 2).mod(1000), f3: (s.f3 + i + 3).mod(1000), f4: (s.f4 + i + 4).mod(1000), f5: (s.f5 + i + 5).mod(1000), f6: (s.f6 + i + 6).mod(1000), f7: (s.f7 + i + 7).mod(1000), f8: (s.f8 + i + 8).mod(1000), f9: (s.f9 + i + 9).mod(1000), f10: (s.f10 + i + 10).mod(1000), f11: (s.f11 + i + 11).mod(1000), f12: (s.f12 + i + 12).mod(1000), f13: (s.f13 + i + 13).mod(1000), f14: (s.f14 + i + 14).mod(1000), f15: (s.f15 + i + 15).mod(1000), f16: (s.f16 + i + 16).mod(1000), f17: (s.f17 + i + 17).mod(1000), f18: (s.f18 + i + 18).mod(1000), f19: (s.f19 + i + 19).mod(1000), f20: (s.f20 + i + 20).mod(1000), f21: (s.f21 + i + 21).mod(1000), f22: (s.f22 + i + 22).mod(1000), f23: (s.f23 + i + 23).mod(1000), f24: (s.f24 + i + 24).mod(1000), f25: (s.f25 + i + 25).mod(1000), f26: (s.f26 + i + 26).mod(1000), f27: (s.f27 + i + 27).mod(1000), f28: (s.f28 + i + 28).mod(1000), f29: (s.f29 + i + 29).mod(1000), f30: (s.f30 + i + 30).mod(1000), f31: (s.f31 + i + 31).mod(1000), f32: (s.f32 + i + 32).mod(1000), f33: (s.f33 + i + 33).mod(1000), f34: (s.f34 + i + 34).mod(1000), f35: (s.f35 + i + 35).mod(1000), f36: (s.f36 + i + 36).mod(1000), f37: (s.f37 + i + 37).mod(1000), f38: (s.f38 + i + 38).mod(1000), f39: (s.f39 + i + 39).mod(1000), f40: (s.f40 + i + 40).mod(1000), f41: (s.f41 + i + 41).mod(1000), f42: (s.f42 + i + 42).mod(1000), f43: (s.f43 + i + 43).mod(1000), f44: (s.f44 + i + 44).mod(1000), f45: (s.f45 + i + 45).mod(1000), f46: (s.f46 + i + 46).mod(1000), f47: (s.f47 + i + 47).mod(1000), f48: (s.f48 + i + 48).mod(1000), f49: (s.f49 + i + 49).mod(1000), f50: (s.f50 + i + 50).mod(1000), f51: (s.f51 + i + 51).mod(1000), f52: (s.f52 + i + 52).mod(1000), f53: (s.f53 + i + 53).mod(1000), f54: (s.f54 + i + 54).mod(1000), f55: (s.f55 + i + 55).mod(1000), f56: (s.f56 + i + 56).mod(1000), f57: (s.f57 + i + 57).mod(1000), f58: (s.f58 + i + 58).mod(1000), f59: (s.f59 + i + 59).mod(1000), f60: (s.f60 + i + 60).mod(1000), f61: (s.f61 + i + 61).mod(1000), f62: (s.f62 + i + 62).mod(1000), f63: (s.f63 + i + 63).mod(1000)}
    t.f0 + t.f63

n = 1000
