# Recursive, so native lowering keeps it a call.
fn step(x: int) -> int:
    if x < 7:
        return x + 1
    step(x - 7)

fn f(n: int) -> int:
    t = fold i from 0 to n with intermediate s S {f0: 0, f1: 0, f2: 0, f3: 0, f4: 0, f5: 0, f6: 0, f7: 0, f8: 0, f9: 0, f10: 0, f11: 0, f12: 0, f13: 0, f14: 0, f15: 0, f16: 0, f17: 0, f18: 0, f19: 0, f20: 0, f21: 0, f22: 0, f23: 0, f24: 0, f25: 0, f26: 0, f27: 0, f28: 0, f29: 0, f30: 0, f31: 0, f32: 0, f33: 0, f34: 0, f35: 0, f36: 0, f37: 0, f38: 0, f39: 0, f40: 0, f41: 0, f42: 0, f43: 0, f44: 0, f45: 0, f46: 0, f47: 0, f48: 0, f49: 0, f50: 0, f51: 0, f52: 0, f53: 0, f54: 0, f55: 0, f56: 0, f57: 0, f58: 0, f59: 0, f60: 0, f61: 0, f62: 0, f63: 0, f64: 0, f65: 0, f66: 0, f67: 0, f68: 0, f69: 0, f70: 0, f71: 0, f72: 0, f73: 0, f74: 0, f75: 0, f76: 0, f77: 0, f78: 0, f79: 0, f80: 0, f81: 0, f82: 0, f83: 0, f84: 0, f85: 0, f86: 0, f87: 0, f88: 0, f89: 0, f90: 0, f91: 0, f92: 0, f93: 0, f94: 0, f95: 0, f96: 0, f97: 0, f98: 0, f99: 0, f100: 0, f101: 0, f102: 0, f103: 0, f104: 0, f105: 0, f106: 0, f107: 0, f108: 0, f109: 0, f110: 0, f111: 0, f112: 0, f113: 0, f114: 0, f115: 0, f116: 0, f117: 0, f118: 0, f119: 0, f120: 0, f121: 0, f122: 0, f123: 0, f124: 0, f125: 0, f126: 0, f127: 0}:
        k = step(i.mod(14))
        S {f0: (s.f0 + k * 0).mod(1000), f1: (s.f1 + k * 1).mod(1000), f2: (s.f2 + k * 2).mod(1000), f3: (s.f3 + k * 3).mod(1000), f4: (s.f4 + k * 4).mod(1000), f5: (s.f5 + k * 5).mod(1000), f6: (s.f6 + k * 6).mod(1000), f7: (s.f7 + k * 7).mod(1000), f8: (s.f8 + k * 8).mod(1000), f9: (s.f9 + k * 9).mod(1000), f10: (s.f10 + k * 10).mod(1000), f11: (s.f11 + k * 11).mod(1000), f12: (s.f12 + k * 12).mod(1000), f13: (s.f13 + k * 13).mod(1000), f14: (s.f14 + k * 14).mod(1000), f15: (s.f15 + k * 15).mod(1000), f16: (s.f16 + k * 16).mod(1000), f17: (s.f17 + k * 17).mod(1000), f18: (s.f18 + k * 18).mod(1000), f19: (s.f19 + k * 19).mod(1000), f20: (s.f20 + k * 20).mod(1000), f21: (s.f21 + k * 21).mod(1000), f22: (s.f22 + k * 22).mod(1000), f23: (s.f23 + k * 23).mod(1000), f24: (s.f24 + k * 24).mod(1000), f25: (s.f25 + k * 25).mod(1000), f26: (s.f26 + k * 26).mod(1000), f27: (s.f27 + k * 27).mod(1000), f28: (s.f28 + k * 28).mod(1000), f29: (s.f29 + k * 29).mod(1000), f30: (s.f30 + k * 30).mod(1000), f31: (s.f31 + k * 31).mod(1000), f32: (s.f32 + k * 32).mod(1000), f33: (s.f33 + k * 33).mod(1000), f34: (s.f34 + k * 34).mod(1000), f35: (s.f35 + k * 35).mod(1000), f36: (s.f36 + k * 36).mod(1000), f37: (s.f37 + k * 37).mod(1000), f38: (s.f38 + k * 38).mod(1000), f39: (s.f39 + k * 39).mod(1000), f40: (s.f40 + k * 40).mod(1000), f41: (s.f41 + k * 41).mod(1000), f42: (s.f42 + k * 42).mod(1000), f43: (s.f43 + k * 43).mod(1000), f44: (s.f44 + k * 44).mod(1000), f45: (s.f45 + k * 45).mod(1000), f46: (s.f46 + k * 46).mod(1000), f47: (s.f47 + k * 47).mod(1000), f48: (s.f48 + k * 48).mod(1000), f49: (s.f49 + k * 49).mod(1000), f50: (s.f50 + k * 50).mod(1000), f51: (s.f51 + k * 51).mod(1000), f52: (s.f52 + k * 52).mod(1000), f53: (s.f53 + k * 53).mod(1000), f54: (s.f54 + k * 54).mod(1000), f55: (s.f55 + k * 55).mod(1000), f56: (s.f56 + k * 56).mod(1000), f57: (s.f57 + k * 57).mod(1000), f58: (s.f58 + k * 58).mod(1000), f59: (s.f59 + k * 59).mod(1000), f60: (s.f60 + k * 60).mod(1000), f61: (