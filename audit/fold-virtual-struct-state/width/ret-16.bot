# ret-16.bot -- a 16-field fold as a function's value, read by its caller (tools/gen-width.tcl).
import std::list

struct S:
    f0: int
    f1: int
    f2: int
    f3: int
    f4: int
    f5: int
    f6: int
    f7: int
    f8: int
    f9: int
    f10: int
    f11: int
    f12: int
    f13: int
    f14: int
    f15: int

fn g(n: int) -> S:
    fold i from 0 to n with intermediate s S {f0: 0, f1: 0, f2: 0, f3: 0, f4: 0, f5: 0, f6: 0, f7: 0, f8: 0, f9: 0, f10: 0, f11: 0, f12: 0, f13: 0, f14: 0, f15: 0}:
        S {f0: (s.f0 + i + 0).mod(1000), f1: (s.f1 + i + 1).mod(1000), f2: (s.f2 + i + 2).mod(1000), f3: (s.f3 + i + 3).mod(1000), f4: (s.f4 + i + 4).mod(1000), f5: (s.f5 + i + 5).mod(1000), f6: (s.f6 + i + 6).mod(1000), f7: (s.f7 + i + 7).mod(1000), f8: (s.f8 + i + 8).mod(1000), f9: (s.f9 + i + 9).mod(1000), f10: (s.f10 + i + 10).mod(1000), f11: (s.f11 + i + 11).mod(1000), f12: (s.f12 + i + 12).mod(1000), f13: (s.f13 + i + 13).mod(1000), f14: (s.f14 + i + 14).mod(1000), f15: (s.f15 + i + 15).mod(1000)}

fn f(n: int, k: int) -> int:
    t = g(n + k * 0)
    t.f0 + t.f15

n = 1000
f(n, 1)
