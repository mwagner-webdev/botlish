# most-4.bot -- a 4-field fold, every field updated per iteration (tools/gen-width.tcl).
import std::list

struct S:
    f0: int
    f1: int
    f2: int
    f3: int

fn f(n: int) -> int:
    t = fold i from 0 to n with intermediate s S {f0: 0, f1: 0, f2: 0, f3: 0}:
        S {f0: (s.f0 + i * 0 + 1).mod(1000), f1: (s.f1 + i * 1 + 1).mod(1000), f2: (s.f2 + i * 2 + 1).mod(1000), f3: (s.f3 + i * 3 + 1).mod(1000)}
    t.f0 + t.f3

n = 1000
f(n)
