fn f(n: int) -> int:
    t = fold i from 0 to n with intermediate s S {f0: 0, f1: 0, f2: 0, f3: 0, f4: 0, f5: 0, f6: 0, f7: 0, f8: 0, f9: 0, f10: 0, f11: 0, f12: 0, f13: 0, f14: 0, f15: 0, f16: 0, f17: 0, f18: 0, f19: 0, f20: 0, f21: 0, f22: 0, f23: 0, f24: 0, f25: 0, f26: 0, f27: 0, f28: 0, f29: 0, f30: 0, f31: 0, f32: 0, f33: 0, f34: 0, f35: 0, f36: 0, f37: 0, f38: 0, f39: 0, f40: 0, f41: 0, f42: 0, f43: 0, f44: 0, f45: 0, f46: 0, f47: 0, f48: 0, f49: 0, f50: 0, f51: 0, f52: 0, f53: 0, f54: 0, f55: 0, f56: 0, f57: 0, f58: 0, f59: 0, f60: 0, f61: 0, f62: 0, f63: 0}:
        S {f0: (s.f0 + i).mod(1000), f1: s.f1, f2: s.f2, f3: s.f3, f4: s.f4, f5: s.f5, f6: s.f6, f7: s.f7, f8: s.f8, f9: s.f9, f10: s.f10, f11: s.f11, f12: s.f12, f13: s.f13, f14: s.f14, f15: s.f15, f16: s.f16, f17: s.f17, f18: s.f18, f19: s.f19, f20: s.f20, f21: s.f21, f22: s.f22, f23: s.f23, f24: s.f24, f25: s.f25, f26: s.f26, f27: s.f27, f28: s.f28, f29: s.f29, f30: s.f30, f31: s.f31, f32: s.f32, f33: s.f33, f34: s.f34, f35: s.f35, f36: s.f36, f37: s.f37, f38: s.f38, f39: s.f39, f40: s.f40, f41: s.f41, f42: s.f42, f43: s.f43, f44: s.f44, f45: s.f45, f46: s.f46, f47: s.f47, f48: s.f48, f49: s.f49, f50: s.f50, f51: s.f51, f52: s.f52, f53: s.f53, f54: s.f54, f55: s.f55, f56: s.f56, f57: s.f57, f58: s.f58, f59: s.f59, f60: s.f60, f61: s.f61, f62: s.f62, f63: s.f63}
    t.f0 + t.f63

n = 1000
f(n)
