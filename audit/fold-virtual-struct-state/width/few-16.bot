# few-16.bot -- a 16-field fold, one field updated per iteration (tools/gen-width.tcl).
import std::list

struct S:
    f0: int
    f1: int
    f2: int
    f3: int
    f4: int
    f5: int
    f6: int
    f7: int
    f8: int
    f9: int
    f10: int
    f11: int
    f12: int
    f13: int
    f14: int
    f15: int

fn f(n: int) -> int:
    t = fold i from 0 to n with intermediate s S {f0: 0, f1: 0, f2: 0, f3: 0, f4: 0, f5: 0, f6: 0, f7: 0, f8: 0, f9: 0, f10: 0, f11: 0, f12: 0, f13: 0, f14: 0, f15: 0}:
        S {f0: (s.f0 + i).mod(1000), f1: s.f1, f2: s.f2, f3: s.f3, f4: s.f4, f5: s.f5, f6: s.f6, f7: s.f7, f8: s.f8, f9: s.f9, f10: s.f10, f11: s.f11, f12: s.f12, f13: s.f13, f14: s.f14, f15: s.f15}
    t.f0 + t.f15

n = 1000
f(n)
