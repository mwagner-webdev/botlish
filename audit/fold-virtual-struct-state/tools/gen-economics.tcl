# gen-economics.tcl -- writes FOLD-VIRTUAL-STRUCT-STATE-CENSUS-1.md's
# synthetic compile-cost inputs into audit/fold-virtual-struct-state/
# economics/ (tools/economics.tcl measures them):
#
#   width-W.bot    one fold carrying a W-field Int struct, every field
#                  rebuilt each iteration (W = 2 4 8 16 32 64)
#   nested-D.bot   D struct folds nested, each seeded with a field of the
#                  enclosing intermediate, its value read into the next
#                  (D = 1 .. 5)
#   many-K.bot     K struct folds in one function, one after the other
#                  (K = 10 20 40 80)
#   locals-K.bot   the control: K struct locals in one function, each
#                  built and projected (the existing virtual-local path)
#   spill-W.bot    a runtime input (tools/measure.tcl): a fold carrying a
#                  W-field struct for n iterations whose body calls an
#                  exact function first, so every field is live across a
#                  call (W = 2 4 8 16 32 64)
#
#   tclsh9.0 audit/fold-virtual-struct-state/tools/gen-economics.tcl

set here [file dirname [file normalize [info script]]]
set out [file join [file dirname $here] economics]
file mkdir $out

proc write {name text} {
    global out
    set ch [open [file join $out $name] w]
    fconfigure $ch -encoding utf-8 -translation lf
    puts -nonewline $ch $text
    close $ch
}

proc header {name what {kind "compile-cost input"} {tool economics.tcl}} {
    return "# $name -- FOLD-VIRTUAL-STRUCT-STATE-CENSUS-1.md's $kind:\n# $what (tools/$tool). Generated by tools/gen-economics.tcl.\n\nimport std::list\n\n"
}

foreach w {2 4 8 16 32 64} {
    set fields [lmap i [lseq $w] {string cat f$i}]
    set text [header width-$w.bot "one fold carrying a $w-field struct"]
    append text "struct S:\n"
    foreach f $fields {
        append text "    $f: int\n"
    }
    append text "\nfn f(xs: List\[int\]) -> int:\n"
    append text "    t = fold x in xs with intermediate s S {[join [lmap f $fields {string cat "$f: 0"}] {, }]}:\n"
    set i 0
    set parts {}
    foreach f $fields {
        lappend parts "$f: s.$f + x * [incr i]"
    }
    append text "        S {[join $parts {, }]}\n"
    append text "    [join [lmap f $fields {string cat t.$f}] { + }]\n\nf(\[1, 2, 3\])\n"
    write width-$w.bot $text
}

foreach d {1 2 3 4 5} {
    set text [header nested-$d.bot "$d struct folds nested, each seeded from the enclosing intermediate"]
    append text "struct S:\n    a: int\n    b: int\n    c: int\n    d: int\n\n"
    append text "fn f(xs: List\[int\]) -> int:\n"
    set indent "    "
    set seed "0"
    for {set k 1} {$k <= $d} {incr k} {
        set lead [expr {$k == 1 ? "t = " : "r$k = "}]
        append text "${indent}${lead}fold x$k in xs with intermediate s$k S {a: $seed, b: 0, c: 0, d: 0}:\n"
        set indent "$indent    "
        set seed "s$k.a"
    }
    for {set k $d} {$k >= 1} {incr k -1} {
        set inner [expr {$k == $d ? "x$k" : "r[expr {$k + 1}].a + x$k"}]
        append text "${indent}S {a: s$k.a + $inner, b: s$k.b + 1, c: s$k.c + s$k.a, d: s$k.d}\n"
        set indent [string range $indent 4 end]
    }
    append text "    t.a + t.b + t.c + t.d\n\nf(\[1, 2, 3\])\n"
    write nested-$d.bot $text
}

foreach k {10 20 40 80} {
    set text [header many-$k.bot "$k struct folds in one function"]
    append text "struct S:\n    a: int\n    b: int\n    c: int\n    d: int\n\n"
    append text "fn f(xs: List\[int\]) -> int:\n    acc = 0\n"
    for {set i 1} {$i <= $k} {incr i} {
        append text "    t$i = fold x in xs with intermediate s S {a: [expr {$i == 1 ? 0 : "t[expr {$i - 1}].a"}], b: 0, c: 0, d: 0}:\n"
        append text "        if x > $i:\n"
        append text "            S {a: s.a + x, b: s.b + 1, c: s.c, d: s.d + x}\n"
        append text "        else:\n"
        append text "            S {a: s.a, b: s.b, c: s.c + 1, d: s.d}\n"
    }
    append text "    t$k.a + t$k.b + t$k.c + t$k.d\n\nf(\[1, 2, 3\])\n"
    write many-$k.bot $text
}

foreach k {10 20 40 80} {
    set text [header locals-$k.bot "the control: $k struct locals in one function, each projected"]
    append text "struct S:\n    a: int\n    b: int\n    c: int\n    d: int\n\n"
    append text "fn f(x: int) -> int:\n"
    for {set i 1} {$i <= $k} {incr i} {
        set prev [expr {$i == 1 ? "x" : "p[expr {$i - 1}].a"}]
        append text "    p$i = if x > $i:\n"
        append text "        S {a: $prev + 1, b: x, c: $i, d: 0}\n"
        append text "    else:\n"
        append text "        S {a: $prev, b: 0, c: x, d: $i}\n"
    }
    append text "    p$k.a + p$k.b + p$k.c + p$k.d\n\nf(3)\n"
    write locals-$k.bot $text
}

foreach w {2 4 8 16 32 64} {
    set fields [lmap i [lseq $w] {string cat f$i}]
    set text [header spill-$w.bot "a fold carrying a $w-field struct across a call in its body, for n iterations" "runtime input" measure.tcl]
    append text "struct S:\n"
    foreach f $fields {
        append text "    $f: int\n"
    }
    append text "\n# Recursive, so native lowering keeps it a call.\nfn step(x: int) -> int:\n    if x < 7:\n        return x + 1\n    step(x - 7)\n"
    append text "\nfn f(n: int) -> int:\n"
    append text "    t = fold i from 0 to n with intermediate s S {[join [lmap f $fields {string cat "$f: 0"}] {, }]}:\n"
    append text "        k = step(i.mod(14))\n"
    set j 0
    set parts {}
    foreach f $fields {
        lappend parts "$f: (s.$f + k * [incr j]).mod(1000)"
    }
    append text "        S {[join $parts {, }]}\n"
    append text "    [join [lmap f $fields {string cat t.$f}] { + }]\n\nn = 1000\nf(n)\n"
    write spill-$w.bot $text
}
