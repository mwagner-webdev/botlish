# 1 struct folds nested, each seeded from the enclosing intermediate (tools/economics.tcl). Generated by tools/gen-economics.tcl.

import std::list

struct S:
    a: int
    b: int
    c: int
    d: int

fn f(xs: List[int]) -> int:
    t = fold x1 in xs with intermediate s1 S {a: 0, b: 0, c: 0, d: 0}:
        S {a: s1.a + x1, b: s1.b + 1, c: s1.c + s1.a, d: s1.d}
    t.a + t.b + t.c + t.d

f([1, 2, 3])
