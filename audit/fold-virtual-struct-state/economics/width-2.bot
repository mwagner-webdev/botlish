import std::list

struct S:
    f0: int
    f1: int

fn f(xs: List[int]) -> int:
    t = fold x in xs with intermediate s S {f0: 0, f1: 0}:
        S {f0: s.f0 + x * 1, f1: s.f1 + x * 2}
    t.f0 + t.f1

f([1, 2, 3])
