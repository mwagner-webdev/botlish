                    S {a: s4.a + x4, b: s4.b + 1, c: s4.c + s4.a, d: s4.d}
                S {a: s3.a + r4.a + x3, b: s3.b + 1, c: s3.c + s3.a, d: s3.d}
            S {a: s2.a + r3.a + x2, b: s2.b + 1, c: s2.c + s2.a, d: s2.d}
        S {a: s1.a + r2.a + x1, b: s1.b + 1, c: s1.c + s1.a, d: s1.d}
    t.a + t.b + t.c + t.d

