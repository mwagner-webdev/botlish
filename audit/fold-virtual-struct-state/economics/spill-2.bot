# spill-2.bot -- FOLD-VIRTUAL-STRUCT-STATE-CENSUS-1.md's runtime input:
# a fold carrying a 2-field struct across a call in its body, for n iterations (tools/measure.tcl). Generated by tools/gen-economics.tcl.

import std::list

struct S:
    f0: int
    f1: int

# Recursive, so native lowering keeps it a call.
fn step(x: int) -> int:
    if x < 7:
        return x + 1
    step(x - 7)

fn f(n: int) -> int:
    t = fold i from 0 to n with intermediate s S {f0: 0, f1: 0}:
        k = step(i.mod(14))
        S {f0: (s.f0 + k * 1).mod(1000), f1: (s.f1 + k * 2).mod(1000)}
    t.f0 + t.f1

n = 1000
f(n)
