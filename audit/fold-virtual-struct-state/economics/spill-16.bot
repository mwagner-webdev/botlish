# spill-16.bot -- FOLD-VIRTUAL-STRUCT-STATE-CENSUS-1.md's runtime input:
# a fold carrying a 16-field struct across a call in its body, for n iterations (tools/measure.tcl). Generated by tools/gen-economics.tcl.

import std::list

struct S:
    f0: int
    f1: int
    f2: int
    f3: int
    f4: int
    f5: int
    f6: int
    f7: int
    f8: int
    f9: int
    f10: int
    f11: int
    f12: int
    f13: int
    f14: int
    f15: int

# Recursive, so native lowering keeps it a call.
fn step(x: int) -> int:
    if x < 7:
        return x + 1
    step(x - 7)

fn f(n: int) -> int:
    t = fold i from 0 to n with intermediate s S {f0: 0, f1: 0, f2: 0, f3: 0, f4: 0, f5: 0, f6: 0, f7: 0, f8: 0, f9: 0, f10: 0, f11: 0, f12: 0, f13: 0, f14: 0, f15: 0}:
        k = step(i.mod(14))
        S {f0: (s.f0 + k * 1).mod(1000), f1: (s.f1 + k * 2).mod(1000), f2: (s.f2 + k * 3).mod(1000), f3: (s.f3 + k * 4).mod(1000), f4: (s.f4 + k * 5).mod(1000), f5: (s.f5 + k * 6).mod(1000), f6: (s.f6 + k * 7).mod(1000), f7: (s.f7 + k * 8).mod(1000), f8: (s.f8 + k * 9).mod(1000), f9: (s.f9 + k * 10).mod(1000), f10: (s.f10 + k * 11).mod(1000), f11: (s.f11 + k * 12).mod(1000), f12: (s.f12 + k * 13).mod(1000), f13: (s.f13 + k * 14).mod(1000), f14: (s.f14 + k * 15).mod(1000), f15: (s.f15 + k * 16).mod(1000)}
    t.f0 + t.f1 + t.f2 + t.f3 + t.f4 + t.f5 + t.f6 + t.f7 + t.f8 + t.f9 + t.f10 + t.f11 + t.f12 + t.f13 + t.f14 + t.f15

n = 1000
f(n)
