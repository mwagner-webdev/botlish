# sinks.bot -- consumers of emitted symbols (EMITTER-COROUTINE-EXPLORATION.md,
# "Streaming output and sinks"), and the run-time validation the static
# check is compared with (the report's design A).
#
# An emitter's coroutine is a symbol source in std::dfa's protocol: each
# segment yields one symbol, and its completion's stable value is -1, the
# end, which no consumer writes (std::coroutine::done? tells it from a
# symbol; a resume after the end answers -1 again and runs nothing). A
# consumer here is the function that drives one emitter: constructed and
# resumed in the same function, the pair is closed and coroutine fusion
# compiles both into straight-line code (COROUTINE-FUSION-MILESTONE-1.md);
# `drain`, which receives a handle, is the reusable form whose handle
# crosses a call -- fusion keeps it on the general runtime (its limit, not
# the emitter's).
#
#   collect_*      every symbol into a List (an accumulating sink)
#   digest_*       a running checksum of the symbols, storing none (a
#                  stand-in for a file or socket: no authority is involved,
#                  and an emitter has none)
#   chunked_*      the symbols handed to the checksum in chunks of 64: what
#                  a buffered writer does
#   validated_*    the symbols of an unchecked emitter, each fed to the
#                  token's recognizer as it is emitted (design A): an
#                  invalid token fails Invalid where it goes wrong
#   buffered_*     the token collected, validated whole, then committed

import number_emit
import string_emit
import value_emit
import json_grammar
import json_lex
import std::dfa
import std::coroutine
import std::list
import std::mutable_vector
import std::mutable_array

# The emitted symbols did not make a token of the recognizer (design A's
# run-time verdict): AT the index of the symbol where it went wrong (the
# end: the number of symbols), STATE the recognizer's state there.
error Invalid:
    at: int
    recognizer: str
    state: str

# The sink's limit on the symbols it accepts (a consumer's own failure).
error SinkFull:
    limit: int

fn no_symbols() -> List[int]:
    v = std::mutable_vector::from_list([0])
    v.pop():
        on IndexNotFound:
            return []
    loop x in v:
        x

# Every symbol of the source STEP, whose construction yielded FIRST.
fn drain(step: Coroutine{args: [], return: int, errors: [IndexNotFound]}, first: int) -> List[int] errors IndexNotFound:
    out = std::mutable_vector::from_list(no_symbols())
    c = std::mutable_array::create(1, first)
    loop:
        if std::coroutine::done?(step):
            break
        out.push(c.at(0))
        c.set(0, step())
    loop x in out:
        x

fn collect_integer(n: int) -> List[int] errors IndexNotFound:
    coroutine {step, first} = number_emit::integer_source(n)
    out = std::mutable_vector::from_list(no_symbols())
    c = std::mutable_array::create(1, first)
    loop:
        if std::coroutine::done?(step):
            break
        out.push(c.at(0))
        c.set(0, step())
    loop x in out:
        x

