# bench_work.bot -- the emitter experiment's benchmark workloads
# (EMITTER-COROUTINE-EXPLORATION.md, "Performance"; audit/emitter/tools/
# bench.tcl runs them natively). Each emits COUNT items through a checksum
# sink (sinks.bot's mix: no symbol stored) and returns [symbols, checksum].
# Every emitter coroutine is constructed and drained in the workload's own
# function, so coroutine fusion takes it (but where a workload says
# otherwise: a recursive emitter, a handle passed to a function).
#
#   ints_*       the Int of a deterministic sequence of 19-digit magnitudes
#                (signs alternating; past 2^62, so BigInts natively), one
#                json_number token each; ints_small_* magnitudes below 10^9
#   strings_*    one string token per item, cycling through eight texts of
#                about 60 characters (ASCII, quotation marks, controls,
#                Latin-1, CJK, an emoji)
#   documents_*  one JSON text: an array of COUNT objects of five members
#                (numbers, a string, literals, a nested array and object)

import number_emit
import string_emit
import value_emit
import json_lex
import json_grammar
import json
import sinks
import std::dfa
import std::coroutine
import std::list
import std::mutable_array

# The I-th Int of the sequence: magnitudes 10^18..10^19, signs alternating.
fn nth(i: int) -> int:
    m = (i * 6364136223846793005 + 1442695040888963407).mod(9000000000000000000) + 1000000000000000000
    if i.mod(2) == 0:
        return m
    0 - m

# The I-th Int of a sequence of magnitudes below 10^9 (small Ints natively:
# no BigInt arithmetic), signs alternating.
fn nth_small(i: int) -> int:
    m = (i * 2654435761 + 12345).mod(1000000000)
    if i.mod(2) == 0:
        return m
    0 - m

fn ints_small_static(count: int) -> List[int] errors IndexNotFound:
    st = std::mutable_array::create(3, 0)
    loop i from 0 to count:
        coroutine {step, first} = number_emit::integer_source(i.nth_small())
        st.set(2, first)
        loop:
            if std::coroutine::done?(step):
                break
            st.set(0, st.at(0).mix(st.at(2)))
            st.set(1, st.at(1) + 1)
            st.set(2, step())
        continue
    [st.at(1), st.at(0)]

fn ints_small_trusted(count: int) -> List[int] errors IndexNotFound:
    st = std::mutable_array::create(3, 0)
    loop i from 0 to count:
        coroutine {step, first} = number_emit::integer_trusted_source(i.nth_small())
        st.set(2, first)
        loop:
            if std::coroutine::done?(step):
                break
            st.set(0, st.at(0).mix(st.at(2)))
            st.set(1, st.at(1) + 1)
            st.set(2, step())
        continue
    [st.at(1), st.at(0)]

