# integer_trusted's symbols, each fed to json_number as it is emitted
# (design A, incrementally): two coroutines per token, both fused.
fn ints_validated(count: int) -> List[int] errors IndexNotFound, sinks::Invalid:
    st = std::mutable_array::create(3, 0)
    loop i from 0 to count:
        coroutine {step, first} = number_emit::integer_trusted_source(i.nth())
        coroutine {step: feed} = json_lex::json_number(first):
            on std::dfa::UnrecognizedInput {recognizer, state}:
                fail sinks::Invalid {at: 0, recognizer: recognizer, state: state}
            on std::dfa::UnexpectedEnd {recognizer, state}:
                fail sinks::Invalid {at: 0, recognizer: recognizer, state: state}
        st.set(2, first)
        loop:
            if std::coroutine::done?(feed):
                fail sinks::Invalid {at: 0, recognizer: "json_lex::json_number", state: "ended early"}
            st.set(0, st.at(0).mix(st.at(2)))
            st.set(1, st.at(1) + 1)
            x = step()
            if std::coroutine::done?(step):
                break
            feed(std::dfa::Symbol {code: x}):
                on std::dfa::UnrecognizedInput {recognizer, state}:
                    fail sinks::Invalid {at: 0, recognizer: recognizer, state: state}
                on std::dfa::UnexpectedEnd {recognizer, state}:
                    fail sinks::Invalid {at: 0, recognizer: recognizer, state: state}
            st.set(2, x)
        r = feed(std::dfa::Symbol {code: -1}):
            on std::dfa::UnrecognizedInput {recognizer, state}:
                fail sinks::Invalid {at: 0, recognizer: recognizer, state: state}
            on std::dfa::UnexpectedEnd {recognizer, state}:
                fail sinks::Invalid {at: 0, recognizer: recognizer, state: state}
        if r != 0:
            fail sinks::Invalid {at: 0, recognizer: "json_lex::json_number", state: "ended early"}
        continue
    [st.at(1), st.at(0)]

# ints_static through sinks::drain, a reusable sink the handle is passed
# to: the handle leaves the function that constructs it, so fusion keeps
# every token's coroutine on the general runtime.
fn ints_drained(count: int) -> List[int] errors IndexNotFound:
    st = std::mutable_array::create(2, 0)
    loop i from 0 to count:
        coroutine {step, first} = number_emit::integer_source(i.nth())
        loop c in step.drain(first):
            st.set(0, st.at(0).mix(c))
            st.set(1, st.at(1) + 1)
            continue
        continue
    [st.at(1), st.at(0)]

fn texts() -> List[str]:
    ["The quick brown fox jumps over the lazy dog, 0123456789 times.", "\"Quoted\" and \\back\\slashed\\ text with a /solidus/ and tabs\t\t.", "Latin-1: àéîõü ÀÉÎÕÜ ñç ß ø å æ, and more of the same: àéîõü!", "日本語のテキストと中文文本，还有한국어 텍스트가 섞여 있습니다。", "Line one\nline two\r\nline three\tand a tab, then\n\n\tmore lines.", "Emoji: 😀😁😂🤣😃😄😅😆😉😊😋😎😍😘🥰😗 and a smile.", "Mixed: a\"b\\c/d\te\nf é ü 中 😀 \r\n and the end of the piece.", "Plain ASCII words, nothing to escape, nothing to encode at all."]

fn strings_static(count: int) -> List[int] errors IndexNotFound:
    pieces = texts()
    st = std::mutable_array::create(3, 0)
    loop i from 0 to count:
        coroutine {step, first} = string_emit::string_source(std::list::at(pieces, i.mod(8)))
        st.set(2, first)
        loop:
            if std::coroutine::done?(step):
                break
            st.set(0, st.at(0).mix(st.at(2)))
            st.set(1, st.at(1) + 1)
            st.set(2, step())
        continue
    [st.at(1), st.at(0)]

fn strings_ascii(count: int) -> List[int] errors IndexNotFound:
    pieces = texts()
    st = std::mutable_array::create(3, 0)
    loop i from 0 to count:
        coroutine {step, first} = string_emit::string_ascii_source(std::list::at(pieces, i.mod(8)))
        st.set(2, first)
        loop:
            if std::coroutine::done?(step):
                break
            st.set(0, st.at(0).mix(st.at(2)))
            st.set(1, st.at(1) + 1)
            st.set(2, step())
        continue
    [st.at(1), st.at(0)]

fn strings_bytes(count: int) -> List[int] errors IndexNotFound:
    pieces = texts()
    st = std::mutable_array::create(3, 0)
    loop i from 0 to count:
        coroutine {step, first} = string_emit::string_bytes_source(std::list::at(pieces, i.mod(8)))
        st.set(2, first)
        loop:
