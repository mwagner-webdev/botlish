                break
            st.set(0, st.at(0).mix(st.at(2)))
            st.set(1, st.at(1) + 1)
            st.set(2, step())
        continue
    [st.at(1), st.at(0)]

# string's symbols, each fed to json_string as it is emitted (design A).
fn strings_validated(count: int) -> List[int] errors IndexNotFound, sinks::Invalid:
    pieces = texts()
    st = std::mutable_array::create(3, 0)
    loop i from 0 to count:
        coroutine {step, first} = string_emit::string_source(std::list::at(pieces, i.mod(8)))
        coroutine {step: feed} = json_lex::json_string(first):
            on std::dfa::UnrecognizedInput {recognizer, state}:
                fail sinks::Invalid {at: 0, recognizer: recognizer, state: state}
            on std::dfa::UnexpectedEnd {recognizer, state}:
                fail sinks::Invalid {at: 0, recognizer: recognizer, state: state}
        st.set(2, first)
        loop:
            st.set(0, st.at(0).mix(st.at(2)))
            st.set(1, st.at(1) + 1)
            x = step()
            if std::coroutine::done?(step):
                break
            if std::coroutine::done?(feed):
                fail sinks::Invalid {at: 0, recognizer: "json_lex::json_string", state: "ended early"}
            feed(std::dfa::Symbol {code: x}):
                on std::dfa::UnrecognizedInput {recognizer, state}:
                    fail sinks::Invalid {at: 0, recognizer: recognizer, state: state}
                on std::dfa::UnexpectedEnd {recognizer, state}:
                    fail sinks::Invalid {at: 0, recognizer: recognizer, state: state}
            st.set(2, x)
        if not std::coroutine::done?(feed):
            fail sinks::Invalid {at: 0, recognizer: "json_lex::json_string", state: "incomplete"}
        continue
    [st.at(1), st.at(0)]

fn no_keys() -> List[str]:
    []

# An array of COUNT objects: {"id": I, "name": a text, "flags": [true,
# false, null], "point": {"px": -I, "py": I * 7}, "big": 2^70 + I}.
fn tree(count: int) -> value_emit::Value errors IndexNotFound:
    pieces = texts()
    keys = ["id", "name", "flags", "point", "big"]
    flags = value_emit::array([value_emit::boolean(true), value_emit::boolean(false), value_emit::null_value()])
    items = loop i from 0 to count:
        coordinates = ["px", "py"]
        point = coordinates.object([value_emit::number(0 - i), value_emit::number(i * 7)])
        keys.object([value_emit::number(i), value_emit::string(std::list::at(pieces, i.mod(8))), flags, point, value_emit::number(1180591620717411303424 + i)])
    value_emit::array(items)

fn documents_stacked(count: int) -> List[int] errors IndexNotFound:
    v = tree(count)
    st = std::mutable_array::create(3, 0)
    coroutine {step, first} = value_emit::stacked_source(v)
    st.set(2, first)
    loop:
        if std::coroutine::done?(step):
            break
        st.set(0, st.at(0).mix(st.at(2)))
        st.set(1, st.at(1) + 1)
        st.set(2, step())
    [st.at(1), st.at(0)]

# documents_stacked's symbols handed to the checksum in chunks of 64
# (sinks::chunked_stacked: a buffered writer's sink).
fn documents_chunked(count: int) -> List[int] errors IndexNotFound:
    d = sinks::chunked_stacked(tree(count))
    [d.symbols, d.digest]

# The recursive serializer: its yielding call chain is recursive, so fusion
# keeps it on the general runtime.
fn documents_recursive(count: int) -> List[int] errors IndexNotFound:
    v = tree(count)
    st = std::mutable_array::create(3, 0)
    coroutine {step, first} = value_emit::text_source(v)
    st.set(2, first)
    loop:
        if std::coroutine::done?(step):
            break
        st.set(0, st.at(0).mix(st.at(2)))
        st.set(1, st.at(1) + 1)
        st.set(2, step())
    [st.at(1), st.at(0)]

# value_stacked's symbols, each fed to json_grammar::json_text as it is
# emitted (design A: the lexical layer checked at run time).
fn documents_validated(count: int) -> List[int] errors IndexNotFound, sinks::Invalid:
    v = tree(count)
    st = std::mutable_array::create(3, 0)
    coroutine {step, first} = value_emit::stacked_source(v)
    coroutine {step: feed} = json_grammar::json_text(first):
        on std::dfa::UnrecognizedInput {recognizer, state}:
            fail sinks::Invalid {at: 0, recognizer: recognizer, state: state}
        on std::dfa::UnexpectedEnd {recognizer, state}:
            fail sinks::Invalid {at: 0, recognizer: recognizer, state: state}
    st.set(2, first)
    loop:
        st.set(0, st.at(0).mix(st.at(2)))
        st.set(1, st.at(1) + 1)
        x = step()
        if std::coroutine::done?(step):
            break
        feed(std::dfa::Symbol {code: x}):
            on std::dfa::UnrecognizedInput {recognizer, state}:
                fail sinks::Invalid {at: 0, recognizer: recognizer, state: state}
            on std::dfa::UnexpectedEnd {recognizer, state}:
                fail sinks::Invalid {at: 0, recognizer: recognizer, state: state}
        st.set(2, x)
    feed(std::dfa::Symbol {code: -1}):
        on std::dfa::UnrecognizedInput {recognizer, state}:
            fail sinks::Invalid {at: 0, recognizer: recognizer, state: state}
        on std::dfa::UnexpectedEnd {recognizer, state}:
            fail sinks::Invalid {at: 0, recognizer: recognizer, state: state}
    [st.at(1), st.at(0)]

# The text collected, then validated whole -- its structure included -- by
# json.bot's validate_scalars (design A, afterwards: the sink held the
# text before the verdict).
fn documents_checked_after(count: int) -> List[int] errors IndexNotFound, json::Lexical, json::Truncated, json::Structure, json::TooDeep, json::TokenTooLong:
    out = sinks::collect_stacked(tree(count))
    chunks = [out]
    s = chunks.validate_scalars(1000, 100000000)
    [s.symbols, s.tokens]
