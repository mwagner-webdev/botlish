# number_emit.bot -- JSON integers emitted as json_lex::json_number tokens
# (EMITTER-COROUTINE-EXPLORATION.md, "JSON numbers"). Each emitter is an
# ordinary function whose yields are the token's symbols (ASCII codes); it
# runs inside whatever coroutine calls it (a deep yield), so a serializer
# composes them by calling them. `#: emits R` is the experiment's directive:
# audit/emitter/tools/emitcheck.tcl proves that every normal completion of
# the function has yielded exactly one R token.
#
#   integer          the digits computed arithmetically: every symbol's set
#                    is proved by the compiler's own facts, so the token is
#                    valid with no check at run time
#   integer_text     std::int::to_string's text (canonical decimal), each
#                    character checked by a guard declared from json_lex's
#                    own classes: valid by a check at run time per symbol
#   integer_trusted  the same text, unchecked: what an ordinary serializer
#                    writes; the checker cannot prove it (it has no contract
#                    for to_string's text) and it carries no directive
#
# Botlish has no integer division (POST-2048-PRODUCT-FIXES.md, S2), so
# `integer` finds each digit by comparisons with multiples of its power of
# ten, most significant first: what makes it streamable, and slower than
# the runtime's formatter on long numbers.

import std::dfa
import json_grammar
import std::char
import std::int
import std::str
import std::mutable_vector
import std::mutable_array

# The decimal digit of R at the power of ten P, for 0 <= R < 10P: how many
# times P fits. The result is one of the constants 0..9 whatever R and P
# are -- the compiler proves [0, 9] -- and the right one when 0 <= R < 10P.
fn digit_at(r: int, p: int) -> int:
    if r >= 5 * p:
        if r >= 7 * p:
            if r >= 9 * p:
                return 9
            if r >= 8 * p:
                return 8
            return 7
        if r >= 6 * p:
            return 6
        return 5
    if r >= 3 * p:
        if r >= 4 * p:
            return 4
        return 3
    if r >= 2 * p:
        return 2
    if r >= p:
        return 1
    0

# The leading digit of R at its highest power of ten P (P <= R < 10P): one
# of 1..9, so the token cannot start with a zero whatever R is. (That the
# digit is R's is the arithmetic's business: the property tests check it.)
fn leading_digit_at(r: int, p: int) -> int:
    if r >= 5 * p:
        if r >= 7 * p:
            if r >= 9 * p:
                return 9
            if r >= 8 * p:
                return 8
            return 7
        if r >= 6 * p:
            return 6
        return 5
    if r >= 3 * p:
        if r >= 4 * p:
            return 4
        return 3
    if r >= 2 * p:
        return 2
    1

# The digits of M >= 1, most significant first.
fn magnitude(m: int) -> unit errors IndexNotFound:
    powers = std::mutable_vector::from_list([1])
    loop:
        top = powers.at(powers.length() - 1)
        if top * 10 > m:
            break
        powers.push(top * 10)
    p0 = powers.pop()
    d0 = m.leading_digit_at(p0)
    yield 48 + d0
    rest = std::mutable_array::create(1, m - d0 * p0)
    loop:
        if powers.empty?():
            break
        p = powers.pop()
        r = rest.at(0)
        d = r.digit_at(p)
        yield 48 + d
        rest.set(0, r - d * p)
    unit

#: emits json_lex::json_number
fn integer(n: int) -> unit errors IndexNotFound:
    if n == 0:
        yield 48
    elif n < 0:
        yield 45
        magnitude(0 - n)
    else:
        magnitude(n)
    unit

# A character of std::int::to_string's text that its token cannot hold
# (never: its text is canonical decimal; but nothing states that to the
# compiler, so integer_text checks it and fails here otherwise).
error NotCanonical:
    at: int

#: emits json_lex::json_number
fn integer_text(n: int) -> unit errors IndexNotFound, NotCanonical:
    text = std::int::to_string(n)
    if n == 0:
        yield 48
        return unit
    lead = if n < 0:
        yield 45
        1
    else:
        0
    first = std::char::scalar_value(text.char_at(lead))
    json_grammar::nonzero_symbol(first):
        on std::dfa::UnrecognizedInput:
            fail NotCanonical {at: lead}
        on std::dfa::UnexpectedEnd:
            fail NotCanonical {at: lead}
    yield first
    loop i from lead + 1 to text.length():
        c = std::char::scalar_value(text.char_at(i))
        json_grammar::digit_symbol(c):
            on std::dfa::UnrecognizedInput:
                fail NotCanonical {at: i}
            on std::dfa::UnexpectedEnd:
                fail NotCanonical {at: i}
        yield c
        continue
    unit

fn integer_trusted(n: int) -> unit errors IndexNotFound:
    text = std::int::to_string(n)
    loop i from 0 to text.length():
        yield std::char::scalar_value(text.char_at(i))
        continue
    unit

# Coroutine roots: the token's symbols, then -1 (the end) as the stable
# final value, so an emitter is a symbol source in std::dfa's protocol (a
# driver reads -1 as the end, never as a symbol).

#: emits json_lex::json_number
fn integer_source(n: int) -> int errors IndexNotFound:
    integer(n)
    -1

#: emits json_lex::json_number
fn integer_text_source(n: int) -> int errors IndexNotFound, NotCanonical:
    integer_text(n)
    -1

fn integer_trusted_source(n: int) -> int errors IndexNotFound:
    integer_trusted(n)
    -1
