# evidence.tcl -- the native evidence of the emitter experiment
# (EMITTER-COROUTINE-EXPLORATION.md, "Native evidence"), gathered the way
# audit/dfa/tools/evidence.tcl gathers the recognizers'.
#
#   tclsh9.0 audit/emitter/tools/evidence.tcl ?-out DIR?
#
# For each workload (a bench_work.bot function at a small size), writes to
# DIR (default audit/emitter/results/evidence/):
#
#   NAME.report.txt    the driver's fusion report
#   NAME.fused.nir     the NIR after fusion (what the driver compiles)
#   NAME.fused.s       the consumer function's machine code, fused
#   NAME.general.s     the same function on the general runtime
#
# and summary.md: per workload and variant, the consumer's machine code
# bytes and call instructions, the coroutine helpers and the other runtime
# helpers it calls, and -- in its fused NIR -- the table loads (rtabload*)
# and multiway branches (switch) a recognizer's transitions lower to: what a
# check against a declared grammar costs at run time; and the consumer's NIR
# lines, fused and not. Needs objdump.

set root [file dirname [file dirname [file dirname [file dirname [file normalize [info script]]]]]]
set out [file join $root audit emitter results evidence]
foreach {option value} $argv {
    switch -- $option {
        -out { set out $value }
        default { error "unknown option $option" }
    }
}
set argv {}
source [file join $root tests helpers.tcl]
source [file join $root audit emitter tools workspace.tcl]
interp recursionlimit {} 200000
file mkdir $out

proc writeText {path text} {
    set f [open $path w]
    fconfigure $f -encoding utf-8 -translation lf
    puts -nonewline $f $text
    close $f
}

proc functionNumber {text name} {
    if {![regexp -line "^func (\[0-9\]+) \"[string map {? \\? : \\:} $name]\"" $text -> n]} {
        error "no function $name"
    }
    return $n
}

# The NIR text of function N of TEXT.
proc functionText {text n} {
    set start [string first "\nfunc $n " $text]
    if {$start < 0} {
        return ""
    }
    set end [string first "\nfunc " $text [expr {$start + 1}]]
    return [string range $text $start [expr {$end < 0 ? "end" : $end}]]
}

proc disassemble {text n fused} {
    lassign [file tempfile nirPath botlish-evidence.nir] channel
    fconfigure $channel -encoding utf-8 -translation lf
    puts -nonewline $channel $text
    close $channel
    set object [file join [file dirname $nirPath] botlish-emitter-evidence-[pid].o]
    try {
        if {$fused} {
            exec [native::binary] object $object $nirPath
        } else {
            withoutCoroutineFusion {exec [native::binary] object $object $nirPath}
        }
        set dump [exec objdump -d -r --no-show-raw-insn $object]
    } finally {
        file delete $nirPath $object
    }
    set start [string first "<botlish_fn_$n>:" $dump]
    set end [string first "\n\n" $dump $start]
    return [string range $dump $start [expr {$end < 0 ? "end" : $end - 1}]]\n
}

proc census {asm} {
    set lines [split [string trim $asm] \n]
    set addresses {}
    foreach line $lines {
        if {[regexp {^\s*([0-9a-f]+):\s} $line -> address]} {
            lappend addresses [scan $address %x]
        }
    }
    set bytes [expr {[llength $addresses] ? [lindex $addresses end] - [lindex $addresses 0] : 0}]
    set calls 0
    set coroutine {}
    set helpers {}
    foreach line $lines {
        if {[regexp {\scall\s} $line]} {
            incr calls
        }
        if {[regexp {R_X86_64_\S+\s+(rt_co_[a-z0-9_]+)} $line -> helper]} {
            lappend coroutine $helper
        } elseif {[regexp {R_X86_64_PLT32\s+(rt_[a-z0-9_]+)} $line -> helper]} {
            lappend helpers $helper
        }
    }
    return [list $bytes $calls [lsort -unique $coroutine] [lsort -unique $helpers]]
}

set summary "# Grammar-constrained emission: native evidence\n\n"
append summary "Generated by audit/emitter/tools/evidence.tcl. Per workload (bench_work.bot at 4 items), the consumer\n"
append summary "function's machine code (bytes, call instructions, the coroutine helpers and other runtime helpers\n"
append summary "it calls) and, in its fused NIR, the table loads and switches of recognizer transitions.\n\n"
append summary "| workload | variant | bytes | calls | coroutine helpers | other runtime helpers | rtabload | switch | NIR lines |\n|---|---|---:|---:|---|---|---:|---:|---:|\n"
foreach name {ints_static ints_text ints_trusted ints_validated strings_static strings_validated documents_stacked documents_validated documents_recursive} {
    set main "import bench_work\nimport sinks\nimport number_emit\nimport json\n\nbench_work::$name\(4):\n    on IndexNotFound:\n        \[-1\]\n    on sinks::Invalid:\n        \[-2\]\n    on number_emit::NotCanonical:\n        \[-3\]\n"
    set dir [emitws::scratch main.bot $main]
    try {
        set hir [surface::readProgramFile [file join $dir main.bot] -warnings off]
    } finally {
        file delete -force $dir
    }
    set general [native::nir $hir]
    set fusedNir [native::fusedNir $hir]
    writeText [file join $out $name.report.txt] [join [native::fusion $hir] \n]\n
    writeText [file join $out $name.fused.nir] $fusedNir\n
    set function bench_work::$name
    set n [functionNumber $general $function]
    set body [functionText $fusedNir $n]
    set tables [regexp -all {rtabload} $body]
    set switches [regexp -all -line {^\s*switch } $body]
    foreach {variant fused} {fused 1 general 0} {
        set asm [disassemble $general $n $fused]
        writeText [file join $out $name.$variant.s] $asm
        lassign [census $asm] bytes calls coroutine helpers
        set t [expr {$fused ? $tables : "--"}]
        set s [expr {$fused ? $switches : "--"}]
        set nirText [if {$fused} {set body} else {functionText $general $n}]
        set lines [llength [split [string trim $nirText] \n]]
        append summary "| $name | $variant | $bytes | $calls | [expr {$coroutine eq {} ? "none" : [join $coroutine {, }]}] | [expr {$helpers eq {} ? "none" : [join $helpers {, }]}] | $t | $s | $lines |\n"
    }
}
writeText [file join $out summary.md] $summary
puts $summary
