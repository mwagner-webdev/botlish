# bench.tcl -- the emitter experiment's performance report
# (EMITTER-COROUTINE-EXPLORATION.md, "Performance"): bench_work.bot's
# workloads natively on cranelift, fused (the default) and on the general
# runtime (BOTLISH_NATIVE_COROUTINE_FUSION=0), and what checking the claims
# costs.
#
#   tclsh9.0 audit/emitter/tools/bench.tcl ?-runs N? ?-rounds R? ?-scale F?
#       ?-workloads LIST? ?-parts LIST? ?-out FILE?
#
# Parts: times (ns per emitted symbol: the best of RUNS in-process runs,
# then the minimum and the median over ROUNDS interleaved rounds);
# resources (per workload and variant: allocations, coroutine objects,
# machine code bytes, native lowering's and the driver's compile); check
# (check_all.bot: the front end, the range analysis the checker reads, and
# the checker's own walk, each the median of three).

set root [file dirname [file dirname [file dirname [file dirname [file normalize [info script]]]]]]
set args $argv
set argv {}
source [file join $root tests helpers.tcl]
source [file join $root audit emitter tools workspace.tcl]
source [file join $root audit emitter tools emitcheck.tcl]
interp recursionlimit {} 200000
core::useProgramRecursionLimit

set runs 3
set rounds 3
set scale 1.0
set parts {times resources check}
set out ""
set workloads {ints_static ints_text ints_trusted ints_validated ints_drained ints_small_static ints_small_trusted
    strings_static strings_ascii strings_bytes strings_validated
    documents_stacked documents_chunked documents_recursive documents_validated documents_checked_after}
foreach {option value} $args {
    switch -- $option {
        -runs { set runs $value }
        -rounds { set rounds $value }
        -scale { set scale $value }
        -workloads { set workloads $value }
        -parts { set parts $value }
        -out { set out $value }
        default { error "unknown option $option" }
    }
}

# The items of workload NAME: ints and strings 2,000 tokens, documents 500
# objects (about 79,000 symbols).
proc items {name} {
    set n [dict get {ints 2000 strings 2000 documents 500} [lindex [split $name _] 0]]
    return [expr {max(1, int($n * $::scale))}]
}

proc compile {name} {
    set n [items $name]
    set main "import bench_work\nimport sinks\nimport number_emit\nimport json\n\nbench_work::$name\($n):\n    on IndexNotFound:\n        \[-1\]\n    on sinks::Invalid:\n        \[-2\]\n    on number_emit::NotCanonical:\n        \[-3\]\n    on json::Lexical:\n        \[-4\]\n    on json::Truncated:\n        \[-5\]\n    on json::Structure:\n        \[-6\]\n    on json::TooDeep:\n        \[-7\]\n    on json::TokenTooLong:\n        \[-8\]\n"
    set dir [emitws::scratch main.bot $main]
    try {
        set t0 [clock microseconds]
        set hir [surface::readProgramFile [file join $dir main.bot] -warnings off]
        return [list $hir [expr {([clock microseconds] - $t0) / 1000.0}]]
    } finally {
        file delete -force $dir
    }
}

proc measure {hir fused} {
    if {$fused} {
        return [native::measure $hir $::runs]
    }
    return [withoutCoroutineFusion {native::measure $hir $::runs}]
}

# The symbols a run emitted (the workload's value: [symbols, checksum]).
proc symbols {value} {
    regexp {\{int (-?[0-9]+)\}} $value -> n
    return $n
}

proc median {values} {
    set sorted [lsort -real $values]
    return [lindex $sorted [expr {[llength $sorted] / 2}]]
}

proc writeFile {path text} {
    set f [open $path w]
    fconfigure $f -encoding utf-8 -translation lf
    puts -nonewline $f $text
    close $f
}

set report "# Grammar-constrained emission: performance\n\n"
append report "Generated by audit/emitter/tools/bench.tcl -runs $runs -rounds $rounds -scale $scale on [exec uname -m] ([string trim [lindex [split [exec grep -m1 {model name} /proc/cpuinfo] :] 1]]).\n"
append report "Natively on cranelift. Best of $runs in-process runs; minimum and median over $rounds interleaved rounds; ns per emitted symbol (a run's whole time: the input's construction, every token's coroutine, the sink).\n\n"

set compiled [dict create]
foreach name $workloads {
    dict set compiled $name [compile $name]
}

if {"times" in $parts} {
    append report "| workload | items | symbols | general min | general med | fused min | fused med | general / fused (med) |\n|---|---:|---:|---:|---:|---:|---:|---:|\n"
    foreach name $workloads {
        lassign [dict get $compiled $name] hir
        set times [dict create 0 {} 1 {}]
        set values {}
        for {set r 0} {$r < $rounds} {incr r} {
            foreach fused {0 1} {
                lassign [measure $hir $fused] lower compile best collections value
                lappend values $value
                set n [symbols $value]
                dict lappend times $fused [expr {$best * 1000.0 / $n}]
            }
        }
        if {[llength [lsort -unique $values]] != 1} {
            error "$name: the variants disagree: [lsort -unique $values]"
        }
        set g [dict get $times 0]
        set f [dict get $times 1]
        set row "| $name | [items $name] | [symbols [lindex $values 0]] | [format %.2f [tcl::mathfunc::min {*}$g]] | [format %.2f [median $g]] | [format %.2f [tcl::mathfunc::min {*}$f]] | [format %.2f [median $f]] | [format %.1f [expr {[median $g] / [median $f]}]] |"
        append report $row\n
        puts $row
    }
}

if {"resources" in $parts} {
    append report "\n## Resources\n\n| workload | variant | allocations | coroutine objects | code bytes | front end ms | lower ms | driver compile ms | fusion |\n|---|---|---:|---:|---:|---:|---:|---:|---|\n"
    foreach name $workloads {
        lassign [dict get $compiled $name] hir front
        foreach {variant fused} {general 0 fused 1} {
            set report0 [if {$fused} {native::allocationReport $hir summary} else {withoutCoroutineFusion {native::allocationReport $hir summary}}]
            set all 0
            dict for {kind info} [dict get $report0 byKind] {
                incr all [dict get $info allocations]
            }
            set coroutines [expr {[dict exists $report0 byKind Coroutine] ? [dict get $report0 byKind Coroutine allocations] : 0}]
            set size [lindex [lindex [if {$fused} {native::Driver size [native::nir $hir]} else {withoutCoroutineFusion {native::Driver size [native::nir $hir]}}] 0] 1]
            set lowers {}
            set compiles {}
            for {set r 0} {$r < 3} {incr r} {
                lassign [measure $hir $fused] lower compile
                lappend lowers [expr {$lower / 1000.0}]
                lappend compiles [expr {$compile / 1000.0}]
            }
            set fusion "--"
            if {$fused} {
                set lines [native::fusion $hir]
                set fusedN [llength [lsearch -all -glob $lines {fused *}]]
                set kept [llength [lsearch -all -glob $lines {kept *}]]
                set fusion "$fusedN fused, $kept kept"
            }
            set row "| $name | $variant | $all | $coroutines | $size | [format %.0f $front] | [format %.0f [median $lowers]] | [format %.1f [median $compiles]] | $fusion |"
            append report $row\n
            puts $row
        }
    }
}

if {"check" in $parts} {
    set dir [emitws::scratch]
    set path [file join $dir check_all.bot]
    set fronts {}
    set analyses {}
    set checks {}
    set claims 0
    for {set r 0} {$r < 3} {incr r} {
        set t0 [clock microseconds]
        set hir [surface::readProgramFile $path -warnings off]
        set t1 [clock microseconds]
        set spec [hir::specialize::analyze $hir -call-facts-opt 1]
        hir::range::analyze $hir $spec 1 1 1 1 ""
        set t2 [clock microseconds]
        set result [emitcheck::check $path]
        set t3 [clock microseconds]
        lappend fronts [expr {($t1 - $t0) / 1000.0}]
        lappend analyses [expr {($t2 - $t1) / 1000.0}]
        # (check repeats the front end and the analysis: its own walk is
        # what remains.)
        lappend checks [expr {($t3 - $t2 - ($t2 - $t0)) / 1000.0}]
        set claims [llength [dict get $result emitters]]
    }
    file delete -force $dir
    set section "\n## Checking the claims\n\ncheck_all.bot ($claims claims): the front end, then the specialization and range analysis the checker reads (native lowering computes the same), then the checker's own walk; ms, median of three in one process.\n\n| front end | specialize + range | checker walk |\n|---:|---:|---:|\n| [format %.0f [median $fronts]] | [format %.0f [median $analyses]] | [format %.0f [median $checks]] |\n"
    append report $section
    puts -nonewline $section
}

if {$out ne ""} {
    writeFile $out $report
}
