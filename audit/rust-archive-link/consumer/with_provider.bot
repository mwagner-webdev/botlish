# The acceptance with the rustlink_provider package linked: the unit's post, from a
# thread of its own, reaches the provider's botlish_event_post2 with its
# arguments intact. Its value lists what was observed, or starts with
# "FAIL".
import checks
import rustlink
import rustlink_provider
import std::list

fn run() -> List[str] errors checks::Check, rustlink::Failed:
    seen = checks::common()
    checks::expect("no post before", rustlink_provider::posts(), 0)
    r = rustlink::notify(1, 2, 3, 4, 77)
    checks::expect("a post with the provider", r, 0)
    checks::expect("posts", rustlink_provider::posts(), 1)
    checks::expect("loop", rustlink_provider::last(0), 1)
    checks::expect("endpoint", rustlink_provider::last(1), 2)
    checks::expect("slot", rustlink_provider::last(2), 3)
    checks::expect("generation", rustlink_provider::last(3), 4)
    checks::expect("first value", rustlink_provider::last(4), 77)
    checks::expect("second value", rustlink_provider::last(5), 1)
    checks::expect("a refused post", rustlink::notify(0, 2, 3, 4, 78), -9)
    checks::expect("posts after the refusal", rustlink_provider::posts(), 1)
    seen.append("notify with provider 0")

run():
    on checks::Check {what, got, want}:
        checks::check_failed(what, got, want)
    on rustlink::Failed {operation, code}:
        checks::unit_failed(operation, code)
