# lcg-procedural.bot -- lcg.bot written by hand without a coroutine: the
# same generator, the same items, the same fold, the same final -1
# (COROUTINE-FUSION-MILESTONE-1.md's procedural baseline).
#
# expect: 507467

import std::mutable_array

fn sum(count: int) -> int:
    state = std::mutable_array::create(1, 42)
    acc = std::mutable_array::create(1, 0)
    loop i from 0 to count:
        raw = state.at(0) * 1103515245 + 12345
        next = raw.mod(2147483648)
        state.set(0, next)
        acc.set(0, acc.at(0) + next.mod(1000))
    acc.at(0) + -1

sum(1000)
