# tokens.bot -- cooperating coroutines (COROUTINE-FUSION-MILESTONE-1.md,
# "Multiple coroutines"), after audit/compiler-service/probes/json/
# json_tokens.bot: a JSON-like tokenizer whose character source and whose
# number and string recognizers are coroutines.
#
#   chars      yields the input's code points one by one, then -1
#   number     a recognizer: each resume hands it the next character, and
#              its answer says whether it took it and whether the token
#              ended (-?digits(.digits)?)
#   string     the same for a string with backslash escapes
#
# lex owns the source for the whole run and one recognizer per token, so
# two coroutines are alive at once; it feeds the recognizer the source's
# characters until the token ends, and counts tokens and their characters.
# The recognizers keep their state as nothing but the point they are
# suspended at (no flag, no counter): a number between its sign and its
# digits is a different suspended yield than one inside its fraction, and a
# string that just read a backslash is suspended at the yield that takes
# the escaped character. Recognizing a digit run is a helper the number
# recognizer calls twice, which yields itself: a deep yield inside a
# recognizer.
#
# expect: [6, 4, 17, 29]

import std::coroutine
import std::mutable_array
import std::str
import std::char

struct Ch:
    code: int

struct Answer:
    took: bool
    done: bool

fn digit?(c: int) -> bool:
    c >= 48 and c <= 57

fn chars(text: str) -> int errors IndexNotFound:
    loop i from 0 to std::str::length(text):
        yield std::char::scalar_value(text.char_at(i))
    return -1

# Takes the digit it was handed and every digit after it; returns the code
# of the first character that is not one, received but not yet answered.
fn digit_run(resume Ch) -> int:
    loop:
        next = yield Answer {took: true, done: false}
        if not digit?(next.code):
            return next.code

fn number(resume Ch) -> Answer:
    first = yield Answer {took: false, done: false}
    lead = if first.code == 45:
        yield Answer {took: true, done: false}
    else:
        first
    if not digit?(lead.code):
        return Answer {took: false, done: true}
    stop = digit_run()
    if stop != 46:
        return Answer {took: false, done: true}
    after = yield Answer {took: true, done: false}
    if not digit?(after.code):
        return Answer {took: false, done: true}
    digit_run()
    Answer {took: false, done: true}

fn string(resume Ch) -> Answer:
    open = yield Answer {took: false, done: false}
    loop:
        c = yield Answer {took: true, done: false}
        if c.code == 34:
            return Answer {took: true, done: true}
        if c.code == -1:
            return Answer {took: false, done: true}
        if c.code == 92:
            escaped = yield Answer {took: true, done: false}
            if escaped.code == -1:
                return Answer {took: false, done: true}

# [numbers, strings, punctuation, characters in numbers and strings]
fn lex(text: str) -> List[int] errors IndexNotFound:
    coroutine {step: next_char, first: c0} = chars(text)
    current = std::mutable_array::create(1, c0)
    counts = std::mutable_array::create(4, 0)
    loop:
        c = current.at(0)
        if c == -1:
            break
        if c == 45 or digit?(c):
            coroutine {step: feed} = number()
            loop:
                answer = feed(Ch {code: current.at(0)})
                if answer.took:
                    counts.set(3, counts.at(3) + 1)
                    current.set(0, next_char())
                if answer.done:
                    break
            counts.set(0, counts.at(0) + 1)
        elif c == 34:
            coroutine {step: feed} = string()
            loop:
                answer = feed(Ch {code: current.at(0)})
                if answer.took:
                    counts.set(3, counts.at(3) + 1)
                    current.set(0, next_char())
                if answer.done:
                    break
            counts.set(1, counts.at(1) + 1)
        else:
            if c == 123 or c == 125 or c == 91 or c == 93 or c == 58 or c == 44:
                counts.set(2, counts.at(2) + 1)
            current.set(0, next_char())
    [counts.at(0), counts.at(1), counts.at(2), counts.at(3)]

lex("{\"a\": [1, -2.5, 30], \"b\\\"c\": {\"d\": 400}, \"e\": [6.0, 7]}"):
    on IndexNotFound:
        []
