# lcg-struct.bot -- lcg.bot with a struct outward value: every item is an
# Item {value: V} (COROUTINE-FUSION-MILESTONE-1.md, "Performance": what a
# yielded aggregate costs once the coroutine itself is gone).
#
# expect: 507467

import std::coroutine
import std::mutable_array

struct Item:
    value: int

fn numbers(seed: int, count: int) -> Item:
    state = std::mutable_array::create(1, seed)
    loop i from 0 to count:
        raw = state.at(0) * 1103515245 + 12345
        next = raw.mod(2147483648)
        state.set(0, next)
        yield Item {value: next.mod(1000)}
    return Item {value: -1}

fn sum(count: int) -> int:
    coroutine {step, first} = numbers(42, count)
    acc = std::mutable_array::create(1, first.value)
    loop i from 1 to count:
        acc.set(0, acc.at(0) + step().value)
    acc.at(0) + step().value

sum(1000)
