# evidence.tcl -- the native evidence of coroutine fusion
# (COROUTINE-FUSION-MILESTONE-1.md, "Native evidence").
#
#   tclsh9.0 audit/coroutine-fusion/tools/evidence.tcl ?-out DIR?
#
# For every workload of audit/coroutine-fusion/programs/ (lcg, lcg-struct,
# grid, tokens, utf8), writes to DIR (default audit/coroutine-fusion/
# evidence/):
#
#   NAME.report.txt      the driver's fusion report (botlish-native fusion)
#   NAME.general.nir     the NIR native lowering writes: what the general
#                        runtime runs (BOTLISH_NATIVE_COROUTINE_FUSION=0)
#   NAME.fused.nir       the NIR after fusion (botlish-native fused): what the
#                        driver compiles
#   NAME.fused.s         the machine code of the fused consumer function
#   NAME.general.s       the machine code of the same function, unfused
#   NAME.procedural.s    the machine code of the procedural baseline's
#                        corresponding function (NAME-procedural.bot)
#
# (objdump -d of the relocatable object botlish-native object emits for the
# host; a function is botlish_fn_N, N its NIR number), and summary.md: per
# workload and variant, the consumer function's machine code size, its call
# instructions, and which of them call a coroutine helper. Deterministic for
# a given compiler, native backend and objdump.

set root [file dirname [file dirname [file dirname [file dirname [file normalize [info script]]]]]]
set out [file join $root audit coroutine-fusion evidence]
foreach {option value} $argv {
    switch -- $option {
        -out { set out $value }
        default { error "unknown option $option" }
    }
}
set argv {}
source [file join $root tests helpers.tcl]
source [file join $root surface surface.tcl]

set programs [file join $root audit coroutine-fusion programs]
file mkdir $out

proc write {path text} {
    set f [open $path w]
    fconfigure $f -encoding utf-8 -translation lf
    puts -nonewline $f $text
    close $f
}

# The NIR number of function NAME in NIR text TEXT.
proc functionNumber {text name} {
    if {![regexp -line "^func (\[0-9\]+) \"[string map {? \\?} $name]\"" $text -> n]} {
        error "no function $name"
    }
    return $n
}

# The machine code of function N of the program NIR TEXT, as objdump -d
# prints it (instruction column only), fusion on or off. Relocations to the
# runtime's helpers are named.
proc disassemble {text n fused} {
    lassign [file tempfile nirPath botlish-evidence.nir] channel
    fconfigure $channel -encoding utf-8 -translation lf
    puts -nonewline $channel $text
    close $channel
    set object [file join [file dirname $nirPath] botlish-evidence-[pid].o]
    try {
        if {$fused} {
            exec [native::binary] object $object $nirPath
        } else {
            withoutCoroutineFusion {exec [native::binary] object $object $nirPath}
        }
        set dump [exec objdump -d -r --no-show-raw-insn $object]
    } finally {
        file delete $nirPath $object
    }
    set start [string first "<botlish_fn_$n>:" $dump]
    set end [string first "\n\n" $dump $start]
    return [string range $dump $start [expr {$end < 0 ? "end" : $end - 1}]]\n
}

# {BYTES CALLS COROUTINE-CALLS} of a function's disassembly.
proc census {asm} {
    set lines [split [string trim $asm] \n]
    set addresses {}
    foreach line $lines {
        if {[regexp {^\s*([0-9a-f]+):\s} $line -> address]} {
            lappend addresses [scan $address %x]
        }
    }
    set bytes [expr {[llength $addresses] ? [lindex $addresses end] - [lindex $addresses 0] : 0}]
    set calls 0
    set coroutine {}
    foreach line $lines {
        if {[regexp {\scall\s} $line]} {
            incr calls
        }
        if {[regexp {R_X86_64_\S+\s+(rt_co_[a-z0-9_]+)} $line -> helper]} {
            lappend coroutine $helper
        }
    }
    return [list $bytes $calls [lsort $coroutine]]
}

set summary "# Coroutine fusion: native evidence\n\n"
append summary "Generated by audit/coroutine-fusion/tools/evidence.tcl. Per workload, the consumer function's\n"
append summary "machine code (bytes, call instructions, and the coroutine helpers they call).\n\n"
append summary "| workload | function | variant | bytes | calls | coroutine helper calls |\n|---|---|---|---:|---:|---|\n"
foreach {name function baselineFunction} {
    lcg sum sum
    lcg-struct sum sum
    grid total total
    tokens lex lex
    utf8 validate validate
} {
    set hir [surface::compile [core::ReadFile [file join $programs $name.bot]] -warnings off]
    set baseline [surface::compile [core::ReadFile [file join $programs $name-procedural.bot]] -warnings off]
    set general [native::nir $hir]
    write [file join $out $name.report.txt] [join [native::fusion $hir] \n]\n
    write [file join $out $name.general.nir] $general
    write [file join $out $name.fused.nir] [native::fusedNir $hir]\n
    set n [functionNumber $general $function]
    set variants [list fused [disassemble $general $n 1] general [disassemble $general $n 0]]
    set baselineText [native::nir $baseline]
    lappend variants procedural [disassemble $baselineText [functionNumber $baselineText $baselineFunction] 1]
    foreach {variant asm} $variants {
        write [file join $out $name.$variant.s] $asm
        lassign [census $asm] bytes calls coroutine
        append summary "| $name | $function | $variant | $bytes | $calls | [expr {$coroutine eq {} ? "none" : [join $coroutine {, }]}] |\n"
    }
}
write [file join $out summary.md] $summary
puts $summary
