# exports.bot -- the Botlish side of the exported-function probe
# (COMPILER-SERVICE-CENSUS.md, "FFI and JSON feasibility"; run.sh builds it).
#
# A native library (NATIVE-LIBRARY-MILESTONE-1.md): main.tcl
# -emit-native-library bj compiles this file into libbj.a, libbj.so, bj.h and
# bj.json, and each `exported c fn` is a C function bj_NAME. The root file
# declares and runs nothing: creating an instance (bj_create) initializes the
# modules it imports, and every export is compiled as an independent root,
# for every value its declared types admit -- so the probe needs no
# top-level calls, and none of their arguments has to be made opaque to the
# analyses (the census's first version's exported token_count miscounted
# every input longer than its 6-character constant caller, and checked(-5)
# returned -10: section 8.2).
#
# json_tokens.bot is the unchanged tokenizer: ordinary Botlish with rich
# values and declared errors. This file is its C-facing adapter.

import json_tokens
import std::list
import std::str

error Rejected:
    code: int

# The number of JSON tokens in TEXT, or -1 - OFFSET of the first malformed
# character: the tokenizer's errors folded into an Int, because an export's
# result is a scalar or a str.
exported c fn token_count(text: str) -> int:
    r = json_tokens::tokenize(text, 1000000):
        on json_tokens::Malformed details:
            return -1 - details.at
        on json_tokens::TooManyTokens:
            return -2
        on IndexNotFound:
            return -3
        on LowerUnderrun:
            return -3
        on UpperOverrun:
            return -3
    std::list::length(r)

# The tokens of TEXT as a declared error crossing the boundary: Malformed
# {at: OFFSET} for a malformed input, as the tokenizer raises it.
exported c fn tokens(text: str) -> int errors json_tokens::Malformed, json_tokens::TooManyTokens, IndexNotFound, LowerUnderrun, UpperOverrun:
    std::list::length(json_tokens::tokenize(text, 1000000))

# A str result: TEXT with "!" appended (allocates on the Botlish heap; the
# caller receives an owned copy).
exported c fn shout(text: str) -> str:
    std::str::concat(text, "!")

# A declared error crossing the boundary, with its payload as data.
exported c fn checked(n: int) -> int errors Rejected:
    if n < 0:
        fail Rejected {code: n}
    n * 2

# Allocation pressure: N appends, so the collector runs while the caller's
# (Tcl's) frames are above the export's on the stack.
exported c fn churn(n: int) -> int:
    xs = loop i from 0 to n:
        [i, i + 1]
    std::list::length(xs)
