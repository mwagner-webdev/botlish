# synth.tcl -- generates a synthetic Botlish program shaped like a mid-end
# written in Botlish (audit/mid-end-port/README.md, "The scale experiment").
#
#   tclsh9.0 audit/mid-end-port/tools/synth.tcl -out DIR ?-passes M? ?-handlers F?
#       ?-kinds K? ?-nodes N? ?-seed S? ?-generic 0|1? ?-untyped PERCENT?
#
# DIR (created; must not exist or be empty) receives an application:
#
#   ir.bot       the IR: an enum of K node kinds, a Node struct, a builder
#                that fills a MutableVector[Node] from a seed
#   lattice.bot  a small lattice (a Fact struct, typed join, meet, widen) and
#                untyped helpers every pass calls with its own types (choose)
#   pass_I.bot   I = 1..M: one analysis pass each -- its own Info struct, F
#                handlers in three tiers (tier 0 calls the lattice only, tier
#                1 calls tier 0 of its own pass and of up to three earlier
#                passes, tier 2 calls tier 1), a dispatch on the node kind
#                (an if chain over the K kinds), a fold over the node table
#                that stamps every node's Fact into a MutableArray side table,
#                and a census through a MutableMap[int, int]
#   main.bot     the entry program: builds N nodes, runs every pass in order,
#                returns a checksum of the side table and the passes' counts
#
# Every function declares its result type (as a `mutual:` group's members
# must); -untyped PERCENT of the tier-1 handlers leave their parameters
# untyped (typed per call site by semantic instances), and so does
# lattice::choose. -generic 1 (the default) makes every tier-1 handler call
# lattice::choose with its pass's own Info struct, so choose needs one
# semantic instance per pass: the per-function budget (16) is exceeded from
# the 17th pass on. Nothing is random but the seeded LCG below: one set of
# options always writes the same files.
#
# Prints one line: `lines L functions F files N`.

proc lcgNext {} {
    set ::lcg [expr {($::lcg * 6364136223846793005 + 1442695040888963407) % 18446744073709551616}]
    return [expr {$::lcg >> 33}]
}
proc pick {n} { expr {[lcgNext] % $n} }

set options [dict create -out "" -passes 4 -handlers 40 -kinds 24 -nodes 400 -seed 1 -generic 1 -untyped 25]
foreach {option value} $argv {
    if {![dict exists $options $option]} { error "synth.tcl: unknown option $option" }
    dict set options $option $value
}
dict with options {}
set out ${-out}
if {$out eq ""} { error "synth.tcl: -out DIR is required" }
if {[file exists $out] && [glob -nocomplain -directory $out *] ne ""} { error "synth.tcl: $out is not empty" }
file mkdir $out
set passes ${-passes}
set handlers ${-handlers}
set kinds ${-kinds}
set ::lcg ${-seed}
set functions 0

proc emit {name text} {
    set channel [open [file join $::out $name] w]
    fconfigure $channel -encoding utf-8 -translation lf
    puts -nonewline $channel $text
    close $channel
}

# ---------------------------------------------------------------- ir.bot
set t "# ir.bot -- the synthetic IR (generated by audit/mid-end-port/tools/synth.tcl).\nimport std::mutable_vector\n\nenum Kind:\n"
for {set k 0} {$k < $kinds} {incr k} { append t "    K$k,\n" }
append t {
struct Node:
    kind: Kind
    a: int
    b: int
    value: int

fn next(seed: int) -> int:
    (seed * 1103515245 + 12345).mod(2147483648)

fn kind_of(r: int) -> Kind:
}
for {set k 0} {$k < $kinds - 1} {incr k} {
    append t "    if r == $k:\n        return Kind::K$k\n"
}
append t "    Kind::K[expr {$kinds - 1}]\n"
append t "
# COUNT nodes after the ones NODES holds, each reading two earlier nodes.
fn build(count: int, place nodes: MutableVector\[Node\]) -> int:
    fold i from 0 to count with intermediate seed 42:
        s = next(seed)
        j = nodes.length()
        nodes.push(Node {kind: kind_of(s.mod($kinds)), a: next(s).mod(j), b: next(next(s)).mod(j), value: s.mod(1000)})
        next(next(s))
"
incr functions 3
emit ir.bot $t

# ---------------------------------------------------------------- lattice.bot
emit lattice.bot {# lattice.bot -- the synthetic lattice (generated by audit/mid-end-port/tools/synth.tcl).

struct Fact:
    lo: int
    hi: int
    tag: int

fn bottom() -> Fact:
    Fact {lo: 0, hi: 0, tag: 0}

fn smaller(x: int, y: int) -> int:
    if x < y:
        x
    else:
        y

fn larger(x: int, y: int) -> int:
    if x > y:
        x
    else:
        y

fn join(x: Fact, y: Fact) -> Fact:
    Fact {lo: smaller(x.lo, y.lo), hi: larger(x.hi, y.hi), tag: (x.tag + y.tag).mod(97)}

fn meet(x: Fact, y: Fact) -> Fact:
    Fact {lo: larger(x.lo, y.lo), hi: smaller(x.hi, y.hi), tag: (x.tag * 3 + y.tag).mod(97)}

fn widen(x: Fact, y: Fact, n: int) -> Fact:
    if n > 500:
        return Fact {lo: smaller(x.lo, y.lo) - 1, hi: larger(x.hi, y.hi) + 1, tag: x.tag}
    join(x, y)

fn shift(f: Fact, d: int) -> Fact:
    Fact {lo: f.lo + d, hi: f.hi + d, tag: (f.tag + d).mod(97)}

# Untyped: every caller's argument types make a semantic instance of their own.
fn choose(c, x, y):
    if c:
        x
    else:
        y
}
incr functions 8

# ---------------------------------------------------------------- pass_I.bot
set tier0 [expr {max(1, $handlers / 4)}]
set tier1 [expr {max(1, $handlers / 4)}]
set tier2 [expr {max(1, $handlers - $tier0 - $tier1)}]
set lines [dict create]
for {set p 1} {$p <= $passes} {incr p} {
    set earlier {}
    if {$p > 1} {
        for {set i 0} {$i < 3} {incr i} {
            set q [expr {1 + [pick [expr {$p - 1}]]}]
            if {$q ni $earlier} { lappend earlier $q }
        }
    }
    set t "# pass_$p.bot -- synthetic analysis pass $p (generated by audit/mid-end-port/tools/synth.tcl).\nimport std::mutable_vector\nimport std::mutable_array\nimport std::mutable_map\nimport ir\nimport lattice\n"
    foreach q [lsort -integer $earlier] { append t "import pass_$q\n" }
    append t "\nstruct P${p}Info:\n    count: int\n    last: lattice::Fact\n    name: str\n"
    set h 0
    # Tier 0: the lattice only.
    for {set j 0} {$j < $tier0} {incr j; incr h} {
        set c1 [expr {1 + [pick 50]}]; set c2 [expr {2 + [pick 30]}]; set c3 [expr {[pick 97]}]
        append t "
fn p${p}_h$h\(n: ir::Node, f: lattice::Fact) -> lattice::Fact:
    x = n.value + $c1
    y = lattice::larger(f.lo, x.mod($c2))
    if n.a > n.b:
        return lattice::widen(f, lattice::Fact {lo: y, hi: f.hi + 1, tag: $c3}, n.value)
    g = f.shift(x.mod(7))
    lattice::Fact {lo: lattice::smaller(g.lo, y), hi: lattice::larger(g.hi, x), tag: (g.tag + $c3).mod(97)}
"
    }
    # Tier 1: tier 0 of this pass and of earlier passes.
    for {set j 0} {$j < $tier1} {incr j; incr h} {
        set c1 [expr {1 + [pick 50]}]; set c2 [expr {2 + [pick 30]}]; set c3 [expr {[pick 97]}]
        set local "p${p}_h[pick $tier0]"
        if {$earlier ne "" && [pick 2]} {
            set q [lindex $earlier [pick [llength $earlier]]]
            set remote "pass_$q\::p${q}_h[pick $tier0]"
        } else {
            set remote "p${p}_h[pick $tier0]"
        }
        set untyped [expr {[pick 100] < ${-untyped}}]
        set params [expr {$untyped ? "n, f" : "n: ir::Node, f: lattice::Fact"}]
        append t "
fn p${p}_h$h\($params) -> lattice::Fact:
    x = n.value + $c1
    g = $local\(n, f)
    z = $remote\(n, g)
"
        if {${-generic}} {
            append t "    first = P${p}Info {count: x, last: g, name: \"pass$p\"}
    second = P${p}Info {count: x.mod($c2), last: z, name: \"pass$p.$h\"}
    chosen = lattice::choose(n.a > n.b, first, second)
    w = lattice::join(chosen.last, z)
"
        } else {
            append t "    w = lattice::join(g, z)\n"
        }
        append t "    if w.hi > x:
        return w.meet(lattice::Fact {lo: w.lo, hi: x, tag: $c3})
    lattice::Fact {lo: w.lo, hi: lattice::larger(w.hi, x.mod($c2)), tag: (w.tag + $c3).mod(97)}
"
    }
    # Tier 2: tier 1 of this pass.
    for {set j 0} {$j < $tier2} {incr j; incr h} {
        set c1 [expr {1 + [pick 50]}]; set c3 [expr {[pick 97]}]
        set a "p${p}_h[expr {$tier0 + [pick $tier1]}]"
        set b "p${p}_h[expr {$tier0 + [pick $tier1]}]"
        append t "
fn p${p}_h$h\(n: ir::Node, f: lattice::Fact) -> lattice::Fact:
    if n.value > [expr {200 + [pick 600]}]:
        return $a\(n, f)
    left = $a\(n, f)
    right = $b\(n, left.shift($c1))
    left.join(right).shift($c3)
"
    }
    set total $h
    # The dispatch: one arm per kind.
    append t "\nfn p${p}_dispatch(n: ir::Node, f: lattice::Fact) -> lattice::Fact:\n    kind = n.kind\n"
    for {set k 0} {$k < $kinds - 1} {incr k} {
        set target [expr {$tier0 + $tier1 + [pick $tier2]}]
        append t "    if kind == ir::Kind::K$k:\n        return p${p}_h$target\(n, f)\n"
    }
    append t "    p${p}_h[expr {$total - 1}](n, f)\n"
    # The pass over the node table.
    append t "
fn p${p}_run(nodes: MutableVector\[ir::Node\], place facts: MutableArray\[lattice::Fact\]) -> int errors IndexNotFound:
    fold i from 1 to nodes.length() with intermediate changes 0:
        n = nodes.at(i)
        old = facts.at(i)
        f = p${p}_dispatch(n, lattice::join(facts.at(n.a), facts.at(n.b)))
        updated = old.join(f)
        if updated == old:
            continue
        facts.set(i, updated)
        changes + 1

fn p${p}_census(nodes: MutableVector\[ir::Node\]) -> int errors IndexNotFound:
    m = std::mutable_map::create\[int, int\]()
    fold i from 0 to nodes.length() with intermediate seen 0:
        key = nodes.at(i).value.mod([expr {16 + [pick 48]}])
        current = std::mutable_map::at(m, key):
            on std::mutable_map::KeyNotFound:
                0
        m.set(key, current + 1)
        if current == 0:
            seen + 1
        else:
            seen
"
    incr functions [expr {$total + 3}]
    emit pass_$p.bot $t
}

# ---------------------------------------------------------------- main.bot
set t "# main.bot -- the synthetic program's entry (generated by audit/mid-end-port/tools/synth.tcl).\nimport std::mutable_vector\nimport std::mutable_array\nimport ir\nimport lattice\n"
for {set p 1} {$p <= $passes} {incr p} { append t "import pass_$p\n" }
append t "
fn run_all(count: int) -> int errors IndexNotFound:
    nodes = std::mutable_vector::from_list(\[ir::Node {kind: ir::Kind::K0, a: 0, b: 0, value: 0}\])
    ir::build(count, nodes)
    facts = std::mutable_array::create(nodes.length(), lattice::bottom())
"
for {set p 1} {$p <= $passes} {incr p} {
    append t "    c$p = pass_$p\::p${p}_run(nodes, facts) + pass_$p\::p${p}_census(nodes)\n"
}
set sum [join [lmap p [lsort -integer [lmap x [lrepeat $passes 0] {incr i0}]] {set p "c$p"}] " + "]
append t "    check = fold i from 0 to facts.capacity() with intermediate acc 0:
        f = facts.at(i)
        (acc * 31 + f.lo * 3 + f.hi * 7 + f.tag).mod(1000000007)
    (check + $sum).mod(1000000007)

run_all(${-nodes}):
    on IndexNotFound:
        0 - 1
"
incr functions
emit main.bot $t

set total 0
foreach file [glob -directory $out *.bot] {
    set channel [open $file]
    incr total [llength [split [string trimright [read $channel] \n] \n]]
    close $channel
}
puts "lines $total functions $functions files [llength [glob -directory $out *.bot]]"
