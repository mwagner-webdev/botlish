# mutual-context.bot -- mutual.bot's `passed` form when the walkers need a
# context (a mid-end would give its walkers the registries and the
# diagnostic sink as contexts): a function that requires a context cannot
# be a value (CONTEXT-FUNCTION-VALUE), so the function-value workaround for
# mutual recursion and context-carried authority exclude each other
# (PORTABILITY-MID-END-PORT-READINESS-CENSUS-1.md, section 5).
import std::mutable_vector

context struct Sink:
    seen: MutableVector[int]

fn stmt_with(s: int, expr: Fn{args: [int], return: int}, context sink: Sink) -> int:
    sink.seen.push(s)
    expr(s) + 1

fn expr(e: int, context sink: Sink) -> int:
    if e == 0:
        return 0
    fn stmt(s: int) -> int:
        expr(s - 1)
    stmt_with(e, stmt)

with context Sink {seen: std::mutable_vector::from_list([0])}
expr(3)
