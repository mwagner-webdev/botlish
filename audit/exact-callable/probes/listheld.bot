# Probe (audit only): callable read from a List at a CONSTANT index: existing exact-value analysis makes it exact (#56/#58 boundary).
# Not a benchmark.
#
# expect: [2, 3]

import list
import str

fn a_alpha(c):
    str::is_tcl_alpha(c)

fn b_alnum(c):
    str::is_tcl_alnum(c)

fn count_while(p, s):
    loop i from 0 to str::length(s):
        if p(str::substring(s, i, i + 1)):
            continue
        return i
    str::length(s)

preds = [a_alpha, b_alnum]
[count_while(list::at(preds, 0), "ab1"), count_while(list::at(preds, 1), "12a_")]
