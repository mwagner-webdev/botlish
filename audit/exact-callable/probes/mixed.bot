# Probe (audit only): one HOF, an exact Botlish block and an exact native (symmetry, #54).
# Not a benchmark.
#
# expect: [4, 3]

import str

fn bot_alpha(c):
    str::is_tcl_alpha(c) or c == "_"

fn count_while(p, s):
    loop i from 0 to str::length(s):
        if p(str::substring(s, i, i + 1)):
            continue
        return i
    str::length(s)

[count_while(bot_alpha, "ab_c1"), count_while(str::is_tcl_alpha, "abc1")]
