# Probe (audit only): typed callables (declared types) through a HOF with a declared error.
# Not a benchmark.
#
# expect: [3, -1]

error NotFound

fn find_first(p, xs: List[int]) -> int errors NotFound:
    loop x in xs:
        if p(x):
            return x
    fail NotFound

fn small?(n: int) -> bool:
    n < 4

fn big?(n: int) -> bool:
    n > 100

r1 = find_first(small?, [7, 3, 4, 6]):
    on NotFound:
        -2
r2 = find_first(big?, [1, 3, 4]):
    on NotFound:
        -1
[r1, r2]
