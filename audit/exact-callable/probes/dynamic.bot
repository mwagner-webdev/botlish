# Probe (audit only): predicate chosen at run time by `if`: genuinely dynamic, callvalue stays (#55).
# Not a benchmark.
#
# expect: [2, 3]

fn a_alpha(c):
    str::is_tcl_alpha(c)

fn b_alnum(c):
    str::is_tcl_alnum(c)

fn count_while(p, s):
    loop i from 0 to str::length(s):
        if p(str::substring(s, i, i + 1)):
            continue
        return i
    str::length(s)

fn pick(flag):
    if flag:
        a_alpha
    else:
        b_alnum

[count_while(pick(true), "ab1"), count_while(pick(false), "12a_")]
