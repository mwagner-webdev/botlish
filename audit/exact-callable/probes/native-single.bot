# Probe (audit only): one exact native through a HOF (the native one-site probe, #52).
# Not a benchmark.
#
# expect: 3

fn count_while(p, s):
    loop i from 0 to str::length(s):
        if p(str::substring(s, i, i + 1)):
            continue
        return i
    str::length(s)

count_while(str::is_tcl_alpha, "abc1")
