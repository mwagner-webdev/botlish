# Probe (audit only): an exact callable that also escapes into a List (#20).
# Not a benchmark.
#
# expect: [10, true]

fn is_small(x):
    x < 10

fn apply_loop(f, i, n):
    loop j from i to n:
        if f(j) == false:
            return j
    n

fs = [is_small]
[apply_loop(is_small, 0, 100), list::at(fs, 0)(3)]
