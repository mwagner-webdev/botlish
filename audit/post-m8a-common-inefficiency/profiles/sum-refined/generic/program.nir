nir 1 call-effects=1

func 0 "<program>" params=0 env=0 regs=5 pnames="" captures=0 instance="generic" rawregs="1 3"
    %0 = int 400 @e32
    %1 = rawint 400
    %2 = int 0 @e33
    %3 = rawint 0
    %4 = call 1 %0 %2 @e30
    ret %4
end

func 1 "sum" params=2 env=0 regs=15 pnames="n acc" captures=0 instance="generic" rawregs="0 6 10 11" @e2
    %2 = op isint %1 @e4
    br %2 L0 L1 @e3
  label L0
    %4 = op rbox %0
    %5 = int 0 @e11
    %6 = rawint 0
    %7 = op veq %4 %5 @e8
    br %7 L3 L4 @e7
  label L3
    %8 = move %1
    jump L5
  label L4
    %9 = int 1 @e24
    %10 = rawint 1
    guard int %4 "-" @e21
    %11 = op risub %0 %10 @e21
    %12 = call 2 %1 %4 @e25
    tail %11 %12 @e19
  label L5
    %3 = move %8
    jump L2
  label L1
    %13 = str "not_an_integer" @e29
    %14 = op mkerror %13 @e28
    %3 = move %14
    jump L2
  label L2
    ret %3
end

func 2 "step" params=2 env=0 regs=3 pnames="x n" captures=0 instance="generic" @e14
    guard int %0 "+" @e15
    guard int %1 "+" @e15
    %2 = op iadd %0 %1 @e15
    ret %2
end
