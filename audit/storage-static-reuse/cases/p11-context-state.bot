# p11 -- context-owned state: an installed context owns a MutableVector
# that every call mutates in place through its context parameter. Its
# lifetime is the installation's (to the end of the entry program), not any
# call's; nothing releases it.
import std::mutable_vector

context struct Journal:
    entries: MutableVector[int]

fn note(x: int, context j: Journal):
    j.entries.push(x)

fn count(context j: Journal) -> int:
    std::mutable_vector::length(j.entries)

fn record(n: int, context j: Journal) -> int:
    loop i from 0 to n:
        note(i * i)
    count()

with context Journal {entries: std::mutable_vector::from_list([0])}
record(100)
