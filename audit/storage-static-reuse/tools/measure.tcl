# measure.tcl -- the measurements of STORAGE-STATIC-REUSE-CENSUS-1.md,
# section 15: how the native backend's managed-heap allocation grows with
# the number of requests, messages or iterations of the census's workloads,
# what the collector does about it, and what a run costs. Measures today's
# behavior; it models no proposed optimizer.
#
#   tclsh9.0 audit/storage-static-reuse/tools/measure.tcl ?-sizes {1 10 ...}?
#       ?-runs R? ?-time-size N? ?-out FILE?
#
# Workloads (each the case file of audit/storage-static-reuse/cases/ with its
# size substituted):
#
#   request   p13-request-handler: N requests parsed, transformed, answered
#   actor     p12-actor-messages: N request/reply exchanges between actors
#   sequential p01-sequential-temps's shape, N iterations
#   suspended p07b-string-across-suspension's shape, N coroutines, fused and
#             with coroutine fusion off
#
# For each size: allocations, allocated bytes, peak live objects and bytes,
# collections and their total time (native::allocationReport: the Botlish
# managed heap only -- not BigInt limbs, coroutine stacks, the shadow stack
# or Rust's own allocations); the marginal allocations per unit between the
# two largest sizes; and, at -time-size, the best of R runs' time
# (native::measure, compile time excluded), per unit.
set here [file dirname [file normalize [info script]]]
set audit [file dirname $here]
set options [dict merge [list -sizes {1 10 100 1000 10000} -runs 5 -time-size 10000 \
    -out [file join $audit results measurements.md]] $argv]
set argv {}
source [file join [file dirname [file dirname $audit]] tests helpers.tcl]
source [file join $::projectRoot surface surface.tcl]
set env(LANG) C.utf8
set env(LC_ALL) C.utf8

proc readFile {path} {
    set f [open $path r]
    fconfigure $f -encoding utf-8
    set text [read $f]
    close $f
    return $text
}

set work [file tempdir]

# The case file NAME with its size literal (OLD, as written there) replaced.
proc Program {name old new size} {
    set text [readFile [file join $::audit cases $name.bot]]
    set text [string map [list $old [string map [list @N@ $size] $new]] $text]
    set path [file join $::work $name-$size.bot]
    set f [open $path w]
    fconfigure $f -encoding utf-8 -translation lf
    puts -nonewline $f $text
    close $f
    return $path
}

# workload -> {case old new fusion-variants}
set workloads [dict create \
    request    {p13-request-handler {fold i from 0 to 200 with} {fold i from 0 to @N@ with} {1}} \
    actor      {p12-actor-messages {main(200):} {main(@N@):} {1}} \
    sequential {p01-sequential-temps {fold i from 0 to 1000 with} {fold i from 0 to @N@ with} {1}} \
    suspended  {p07b-string-across-suspension {drive(1000)} {drive(@N@)} {1 0}}]

# The allocation summary of HIR; STRESS 1 runs it under
# BOTLISH_NATIVE_GC_STRESS=1 (a collection before every allocation: the
# peak is then what is reachable at the worst allocation point).
proc Report {hir fused {stress 0}} {
    set script {native::allocationReport $hir summary}
    if {$stress} {
        set ::env(BOTLISH_NATIVE_GC_STRESS) 1
    }
    try {
        if {$fused} {
            return [eval $script]
        }
        return [withoutCoroutineFusion $script]
    } finally {
        unset -nocomplain ::env(BOTLISH_NATIVE_GC_STRESS)
    }
}

proc Time {hir fused runs} {
    set script [list native::measure $hir $runs]
    if {$fused} {
        return [eval $script]
    }
    return [withoutCoroutineFusion $script]
}

set lines {}
lappend lines "# Measurements" "" \
    "Generated by \`tclsh9.0 audit/storage-static-reuse/tools/measure.tcl\` (STORAGE-STATIC-REUSE-CENSUS-1.md, section 15)." \
    "The native backend (cranelift), one run per size; the Botlish managed heap only." ""
dict for {name spec} $workloads {
    lassign $spec case old new variants
    foreach fused $variants {
        set label [if {$fused} {string cat $name} else {string cat "$name (coroutine fusion off)"}]
        puts stderr "measure: $label"
        lappend lines "## $label ($case)" "" \
            "| N | allocations | bytes | peak live objects | peak live bytes | collections | collection time (us) | reachable peak (GC stress) objects / bytes | value |" \
            "|---:|---:|---:|---:|---:|---:|---:|---:|---|"
        set counts {}
        foreach size [dict get $options -sizes] {
            set hir [surface::readProgramFile [Program $case $old $new $size] -warnings off]
            set r [Report $hir $fused]
            set t [dict get $r total]
            set gc [dict get $r gc]
            set stress [dict get [Report $hir $fused 1] total]
            set value [outcomeUnderHir [if {$fused} {string cat cranelift} else {string cat cranelift-unfused}] $hir]
            lappend counts $size [dict get $t allocations] [dict get $t allocatedBytes]
            lappend lines "| $size | [dict get $t allocations] | [dict get $t allocatedBytes] | [dict get $t peakLiveObjects] |\
                [dict get $t peakLiveBytes] | [dict get $gc cycles] | [dict get $gc totalTimeUs] |\
                [dict get $stress peakLiveObjects] / [dict get $stress peakLiveBytes] | [lrange [lindex $value 1] 0 5] |"
        }
        set n [llength $counts]
        lassign [lrange $counts end-5 end-3] s1 a1 b1
        lassign [lrange $counts end-2 end] s2 a2 b2
        set per [format %.2f [expr {double($a2 - $a1) / ($s2 - $s1)}]]
        set perB [format %.1f [expr {double($b2 - $b1) / ($s2 - $s1)}]]
        lappend lines "" "Marginal per unit (between N = $s1 and $s2): $per allocations, $perB bytes."
        set size [dict get $options -time-size]
        set hir [surface::readProgramFile [Program $case $old $new $size] -warnings off]
        lassign [Time $hir $fused [dict get $options -runs]] lower compile best collections _
        set m [dict create collections $collections]
        lappend lines "Time at N = $size: best of [dict get $options -runs] runs [format %.0f $best] us,\
            [format %.3f [expr {$best / $size}]] us per unit (collections in the timed runs: [dict getdef $m collections ?])." ""
    }
}
set f [open [dict get $options -out] w]
fconfigure $f -encoding utf-8 -translation lf
puts -nonewline $f [join $lines \n]\n
close $f
file delete -force $work
puts stderr "measure: wrote [dict get $options -out]"
