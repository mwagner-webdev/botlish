# String reverse, written in Botlish over the string primitives.
#
# reverse_chars reverses the units that length and substring count. Today
# those are the runtime's characters (Tcl 9 string indices), not grapheme
# clusters: a base letter followed by a combining mark is two units, and its
# mark ends up before the letter.
#
# Botlish has no mutable loop state, so the loop is a recursive call that
# carries the index and the text reversed so far. Each step builds a new
# string one character longer than the last, so reversing n characters
# copies O(n^2) characters, and the recursion is n calls deep.
#
# expect: ["", "a", "cba", "dcba", "üöä"]

import str

# The characters of text from index on, reversed, followed by reversed.
fn reverse_from(text, index, reversed) errors LowerUnderrun, UpperOverrun:
    if index == str::length(text):
        return reversed

    character = str::substring(text, index, index + 1)
    reverse_from(text, index + 1, str::concat(character, reversed))

fn reverse_chars(text) errors LowerUnderrun, UpperOverrun:
    reverse_from(text, 0, "")

# The sample's inputs never take a slice out of range; the handlers
# state what one would mean.
fn sample() errors LowerUnderrun, UpperOverrun:
    [reverse_chars(""), reverse_chars("a"), reverse_chars("abc"), reverse_chars("abcd"), reverse_chars("äöü")]

checks = sample():
    on LowerUnderrun:
        []
    on UpperOverrun:
        []
checks
