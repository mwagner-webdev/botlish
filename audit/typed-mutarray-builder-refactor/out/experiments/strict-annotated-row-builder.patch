+fn rgeo_grow(storage: MutableArray[mutarray], length: int, value: mutarray) -> MutableArray[mutarray]:
+    capacity = mutable_array_capacity(storage)
+    if length < capacity:
+        return storage
+
+    new_capacity = geo_new_capacity(capacity, length)
+    fresh = mutarray::create(new_capacity, value)
+    mutable_array_copy(fresh, 0, storage, 0, length)
+    fresh
+
+fn rgeo_append(storage: MutableArray[mutarray], length: int, value: mutarray) -> MutableArray[mutarray]:
+    grown = rgeo_grow(storage, length, value)
+    mutable_array_set(grown, length, value)
+    grown
+
+fn rgeo_finish(storage: MutableArray[mutarray], length: int) -> List[mutarray]:
+    mutable_array_freeze(storage, length)
+
