# rnprobe.bot -- the Botlish side of the React Native census probe
# (REACT-NATIVE-TARGET-CENSUS.md): the functions its TurboModule exports,
# built as a native library by the compiler (NATIVE-LIBRARY-MILESTONE-1.md):
#
#   tclsh9.0 main.tcl -emit-native-library rnprobe -out DIR rnprobe.bot
#
# Each `exported c fn` is an export root, compiled under its declared types
# whatever Botlish code calls it with; the file holds declarations only, so
# creating an instance runs nothing of it.
import std::list
import std::str

error NotPositive

exported c fn add(a: int, b: int) -> int:
    a + b

fn reverse_into(s: str, i: int, acc: str) -> str:
    if i == 0:
        return acc
    c = s.char_at(i - 1):
        on IndexNotFound:
            return ""
    s.reverse_into(i - 1, acc.append_char(c))

exported c fn reverse(s: str) -> str:
    s.reverse_into(s.length(), "")

exported c fn require_positive(n: int) -> int errors NotPositive:
    if n > 0:
        return n
    fail NotPositive

exported c fn same(a: str, b: str) -> bool:
    a == b

exported c fn pick(first: bool, a: str, b: str) -> str:
    if first:
        return a
    b

# Recursion that is not a tail call: N native frames deep.
exported c fn depth(n: int) -> int:
    if n <= 0:
        return 0
    depth(n - 1) + 1
