# render.bot -- draws a frame of the Icy Tower vertical slice
# (ICY-TOWER-VERTICAL-SLICE-1.md), Design A of
# ICY-TOWER-CONTEXT-REFACTOR-CENSUS.md: the walls with their mortar lines,
# the platforms, the player and the text. Rectangles and lines only; the
# text is SDL's built-in debug font.
#
# A frame is data: every function here but `draw` is pure and returns the
# sdl::Commands that draw its part, so it may compute -- and fail -- freely.
# Only `draw` holds the SDL objects (an sdl::Video, opaque and affine): it
# hands the frame's Commands to sdl::show, which takes the Video and gives
# it back.
#
# The view is 480 x 720 logical units, y DOWN; the world's y is altitude,
# UP (tower.bot). The one conversion is `row`: the view row of an altitude
# is the view's height less the altitude's height above the camera's
# bottom edge. Nothing in the world moves for the camera.
import std::float64
import std::list
import std::str
import hud
import sdl
import tower

# A platform's drawn thickness, below its top.
thickness = 14.0

# The altitude between two mortar lines of the walls.
brick = 48.0

# The view row of altitude Y under CAMERA.
fn row(y: Float64, camera: tower::Camera) -> Float64 errors NonFiniteFloat:
    tower::view_height - (y - camera.bottom)

fn walls(camera: tower::Camera) -> List[sdl::Command] errors NonFiniteFloat:
    shade = [
        sdl::color(54, 64, 96),
        sdl::fill(0.0, 0.0, tower::wall, tower::view_height),
        sdl::fill(tower::view_width - tower::wall, 0.0, tower::wall, tower::view_height),
        sdl::color(32, 38, 60),
    ]
    first = std::float64::truncate(camera.bottom / brick)
    lines = loop k from first to first + 17:
        y = row(std::float64::from_int(k) * brick, camera)
        [sdl::line(0.0, y, tower::wall, y), sdl::line(tower::view_width - tower::wall, y, tower::view_width, y)]
    sdl::joined([shade, sdl::joined(lines)])

# The platform color of FLOOR: the spanning floors gold, the others in
# bands of ten floors.
fn platform_color(floor: int) -> sdl::Command:
    band = floor.mod(40)
    if tower::milestone?(floor):
        sdl::color(236, 196, 84)
    elif band < 10:
        sdl::color(128, 206, 236)
    elif band < 20:
        sdl::color(120, 220, 170)
    elif band < 30:
        sdl::color(186, 160, 240)
    else:
        sdl::color(240, 150, 140)

fn platform(p: tower::Platform, camera: tower::Camera) -> List[sdl::Command] errors NonFiniteFloat:
    top = p.y.row(camera)
    if top < -thickness or top > tower::view_height:
        return []
    body = [
        platform_color(p.floor),
        sdl::fill(p.x, top, p.width, thickness),
        sdl::color(255, 255, 255),
        sdl::fill(p.x, top, p.width, 2.0),
    ]
    if not tower::milestone?(p.floor) or p.floor == 0:
        return body
    label = hud::int_text(p.floor)
    x = p.x + (p.width - 8.0 * std::float64::from_int(std::str::length(label))) / 2.0
    sdl::joined([body, [sdl::color(60, 40, 10), sdl::text(x, top + 4.0, label)]])

fn player(p: tower::Player, camera: tower::Camera) -> List[sdl::Command] errors NonFiniteFloat:
    top = row(p.y + tower::player_height, camera)
    # The eyes look the way it runs.
    look = if p.vx < -20.0:
        -4.0
    elif p.vx > 20.0:
        4.0
    else:
        0.0
    [
        sdl::color(250, 112, 72),
        sdl::fill(p.x, top, tower::player_width, tower::player_height),
        sdl::color(28, 28, 40),
        sdl::fill(p.x + 6.0 + look, top + 8.0, 4.0, 7.0),
        sdl::fill(p.x + 16.0 + look, top + 8.0, 4.0, 7.0),
    ]

# LINES of text, one under another from X, Y.
fn lines(lines: List[str], x: Float64, y: Float64) -> List[sdl::Command] errors NonFiniteFloat:
    loop line in lines and i from 0 to std::list::length(lines):
        sdl::text(x, y + 12.0 * std::float64::from_int(i), line)

# LINES twice the size, each centered across the view, from row Y, on a
# dark band.
fn banner(lines: List[str], y: Float64) -> List[sdl::Command] errors NonFiniteFloat:
    n = std::list::length(lines)
    if n == 0:
        return []
    band = [
        sdl::color(10, 12, 24),
        sdl::fill(tower::wall, y - 16.0, tower::inner_width, 24.0 * std::float64::from_int(n) + 24.0),
        sdl::color(255, 236, 160),
        sdl::scale(2.0),
    ]
    written = loop line in lines and i from 0 to n:
        x = (tower::view_width / 2.0 - 8.0 * std::float64::from_int(std::str::length(line))) / 2.0
        sdl::text(x, (y + 24.0 * std::float64::from_int(i)) / 2.0, line)
    sdl::joined([band, written, [sdl::scale(1.0)]])

# One frame of WORLD, presented.
fn frame(world: tower::World) -> List[sdl::Command] errors NonFiniteFloat:
    camera = world.camera
    platforms = loop p in world.platforms:
        p.platform(camera)
    sdl::joined([
        [sdl::color(18, 22, 38), sdl::clear()],
        walls(camera),
        sdl::joined(platforms),
        world.player.player(camera),
        [sdl::color(10, 12, 24), sdl::fill(tower::wall, 0.0, 132.0, 56.0), sdl::color(236, 240, 255)],
        hud::status_lines(world).lines(tower::wall + 8.0, 8.0),
        hud::banner_lines(world).banner(300.0),
        [sdl::present()],
    ])

# What drawing a frame did: the Video back, whether presenting waits for
# the display, and what failed ("" when nothing did).
struct Drawn:
    video: sdl::Video
    synced: bool
    failure: str

# Draws WORLD on VIDEO and presents it.
fn draw(video: sdl::Video, world: tower::World) -> Drawn:
    commands = frame(world):
        on NonFiniteFloat:
            return Drawn {video: video, synced: false, failure: "drawing a frame"}
    {video: shown, synced, ok} = video.show(commands)
    failure = if ok:
        ""
    else:
        "drawing a frame"
    Drawn {video: shown, synced: synced, failure: failure}
