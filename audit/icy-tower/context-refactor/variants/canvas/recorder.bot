# recorder.bot -- a canvas that records (variant "canvas" of
# ICY-TOWER-CONTEXT-REFACTOR-CENSUS): the context Recorder implements
# render::Canvas structurally, through this module's own color, clear,
# present, fill, line, text and scale (CONTEXT-TRAITS.md, section 2: the
# owner of a context implements a context trait with its own top-level
# functions). Each operation appends one line to the log, a
# MutableVector[str] -- a context member, mutated in place
# (MUTABLE-VECTOR.md) -- and succeeds. Numbers are written to one decimal
# place, colors as their three channels:
#
#   color 18 22 38          clear          present
#   fill 0.0 0.0 20.0 720.0                line 0.0 720.0 20.0 720.0
#   text 28.0 8.0 SCORE 0                  scale 2.0
#
# A program installs it, `with context recorder::create()`, draws through
# render.bot, and reads the log with `recorded()`; `forget()` empties it.
# Pure: no SDL, no C call, so it runs on every backend.
import std::ffi::c
import std::mutable_vector
import std::str
import hud

context struct Recorder:
    log: MutableVector[str]

fn create() -> Recorder:
    Recorder {log: std::mutable_vector::from_list([])}

# X to one decimal place, "263.4".
fn number(x: Float64) -> str errors NonFiniteFloat:
    hud::tenths_text(hud::nearest(x * 10.0))

# Appends ENTRY to the log; succeeds.
fn record(entry: str, context rec: Recorder) -> bool:
    rec.log.push(entry)
    true

# ---------------------------------------------------------------------------
# render::Canvas

nomethod fn color(r: std::ffi::c::UChar, g: std::ffi::c::UChar, b: std::ffi::c::UChar, context rec: Recorder) -> bool:
    hud::spaced(["color", hud::int_text(r), hud::int_text(g), hud::int_text(b)]).record()

fn clear(context rec: Recorder) -> bool:
    "clear".record()

fn present(context rec: Recorder) -> bool:
    "present".record()

nomethod fn fill(x: Float64, y: Float64, w: Float64, h: Float64, context rec: Recorder) -> bool errors NonFiniteFloat:
    hud::spaced(["fill", number(x), number(y), number(w), number(h)]).record()

nomethod fn line(x1: Float64, y1: Float64, x2: Float64, y2: Float64, context rec: Recorder) -> bool errors NonFiniteFloat:
    hud::spaced(["line", number(x1), number(y1), number(x2), number(y2)]).record()

nomethod fn text(x: Float64, y: Float64, text: str, context rec: Recorder) -> bool errors NonFiniteFloat:
    hud::spaced(["text", number(x), number(y), text]).record()

fn scale(factor: Float64, context rec: Recorder) -> bool errors NonFiniteFloat:
    hud::spaced(["scale", number(factor)]).record()

# ---------------------------------------------------------------------------
# Reading the log

# The log, in order.
fn recorded(context rec: Recorder) -> List[str]:
    loop entry in rec.log:
        entry

# Empties the log.
fn forget(context rec: Recorder):
    rec.log.clear()

# The entries of ENTRIES whose operation is OP ("text", "scale", ...).
fn only(entries: List[str], op: str) -> List[str]:
    n = std::str::length(op)
    loop entry in entries:
        head = entry.substring(0, n):
            on LowerUnderrun:
                ""
            on UpperOverrun:
                ""
        if head != op:
            continue
        entry
