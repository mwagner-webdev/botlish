# render.bot -- draws a frame of the Icy Tower vertical slice
# (ICY-TOWER-VERTICAL-SLICE-1.md): the walls with their mortar lines, the
# platforms, the player and the text. Rectangles and lines only; the text
# is a built-in 8 x 8 font.
#
# Variant "canvas" (ICY-TOWER-CONTEXT-REFACTOR-CENSUS): the drawing
# operations are the context trait Canvas below (CONTEXT-TRAITS.md), not
# sdl.bot's functions, so this module imports no SDL module. Whatever
# installed context implements Canvas draws the frame: sdl::Sdl in the game
# (sdl.bot's own color, clear, present, fill, line, text and scale, with
# the same parameter and result types and errors, satisfy it structurally),
# a recording context in a test. The selection is static and the
# functions below are cloned for it: nothing exists at run time.
#
# The view is 480 x 720 logical units, y DOWN; the world's y is altitude,
# UP (tower.bot). The one conversion is `row`: the view row of an altitude
# is the view's height less the altitude's height above the camera's
# bottom edge. Nothing in the world moves for the camera.
#
# Every Canvas operation returns whether it succeeded; a frame is drawn
# whole and answers whether all of them did (main.bot stops on a failed
# frame).
import std::ffi::c
import std::float64
import std::list
import std::str
import hud
import tower

# What a frame is drawn with: the current color (R, G, B, opaque), clearing
# the view to it, presenting the frame, a filled rectangle (its top left
# corner, in view coordinates, and its size), a line, a line of text (its
# top left corner) and the scale of everything drawn after it. Each answers
# whether it drew. The coordinates are Float64s; an implementation that
# hands them to something narrower may fail with NonFiniteFloat.
context trait Canvas:
    fn color(r: std::ffi::c::UChar, g: std::ffi::c::UChar, b: std::ffi::c::UChar) -> bool
    fn clear() -> bool
    fn present() -> bool
    fn fill(x: Float64, y: Float64, w: Float64, h: Float64) -> bool errors NonFiniteFloat
    fn line(x1: Float64, y1: Float64, x2: Float64, y2: Float64) -> bool errors NonFiniteFloat
    fn text(x: Float64, y: Float64, text: str) -> bool errors NonFiniteFloat
    fn scale(factor: Float64) -> bool errors NonFiniteFloat

# A platform's drawn thickness, below its top.
thickness = 14.0

# The altitude between two mortar lines of the walls.
brick = 48.0

# The view row of altitude Y under CAMERA.
fn row(y: Float64, camera: tower::Camera) -> Float64 errors NonFiniteFloat:
    tower::view_height - (y - camera.bottom)

fn succeeded?(results: List[bool]) -> bool:
    loop ok in results:
        if not ok:
            return false
    true

fn walls(camera: tower::Camera, context canvas: Canvas) -> bool errors NonFiniteFloat:
    shade = canvas.color(54, 64, 96)
    left = canvas.fill(0.0, 0.0, tower::wall, tower::view_height)
    right = canvas.fill(tower::view_width - tower::wall, 0.0, tower::wall, tower::view_height)
    mortar = canvas.color(32, 38, 60)
    first = std::float64::truncate(camera.bottom / brick)
    lines = loop k from first to first + 17:
        y = row(std::float64::from_int(k) * brick, camera)
        a = canvas.line(0.0, y, tower::wall, y)
        b = canvas.line(tower::view_width - tower::wall, y, tower::view_width, y)
        a and b
    shade and left and right and mortar and lines.succeeded?()

# The platform color of FLOOR: the spanning floors gold, the others in
# bands of ten floors.
fn platform_color(floor: int, context canvas: Canvas) -> bool:
    band = floor.mod(40)
    if tower::milestone?(floor):
        canvas.color(236, 196, 84)
    elif band < 10:
        canvas.color(128, 206, 236)
    elif band < 20:
        canvas.color(120, 220, 170)
    elif band < 30:
        canvas.color(186, 160, 240)
    else:
        canvas.color(240, 150, 140)

fn platform(p: tower::Platform, camera: tower::Camera, context canvas: Canvas) -> bool errors NonFiniteFloat:
    top = p.y.row(camera)
    if top < -thickness or top > tower::view_height:
        return true
    colored = platform_color(p.floor)
    body = canvas.fill(p.x, top, p.width, thickness)
    shine = canvas.color(255, 255, 255)
    edge = canvas.fill(p.x, top, p.width, 2.0)
    if not tower::milestone?(p.floor) or p.floor == 0:
        return colored and body and shine and edge
    label = hud::int_text(p.floor)
    ink = canvas.color(60, 40, 10)
    x = p.x + (p.width - 8.0 * std::float64::from_int(std::str::length(label))) / 2.0
    written = canvas.text(x, top + 4.0, label)
    colored and body and shine and edge and ink and written

fn player(p: tower::Player, camera: tower::Camera, context canvas: Canvas) -> bool errors NonFiniteFloat:
    top = row(p.y + tower::player_height, camera)
    body_color = canvas.color(250, 112, 72)
    body = canvas.fill(p.x, top, tower::player_width, tower::player_height)
    eye_color = canvas.color(28, 28, 40)
    # The eyes look the way it runs.
    look = if p.vx < -20.0:
        -4.0
    elif p.vx > 20.0:
        4.0
    else:
        0.0
    left_eye = canvas.fill(p.x + 6.0 + look, top + 8.0, 4.0, 7.0)
    right_eye = canvas.fill(p.x + 16.0 + look, top + 8.0, 4.0, 7.0)
    body_color and body and eye_color and left_eye and right_eye

# LINES of text, one under another from X, Y.
fn lines(lines: List[str], x: Float64, y: Float64, context canvas: Canvas) -> bool errors NonFiniteFloat:
    written = loop line in lines and i from 0 to std::list::length(lines):
        canvas.text(x, y + 12.0 * std::float64::from_int(i), line)
    written.succeeded?()

# LINES twice the size, each centered across the view, from row Y, on a
# dark band.
fn banner(lines: List[str], y: Float64, context canvas: Canvas) -> bool errors NonFiniteFloat:
    n = std::list::length(lines)
    if n == 0:
        return true
    shade = canvas.color(10, 12, 24)
    band = canvas.fill(tower::wall, y - 16.0, tower::inner_width, 24.0 * std::float64::from_int(n) + 24.0)
    ink = canvas.color(255, 236, 160)
    bigger = canvas.scale(2.0)
    written = loop line in lines and i from 0 to n:
        x = (tower::view_width / 2.0 - 8.0 * std::float64::from_int(std::str::length(line))) / 2.0
        canvas.text(x, (y + 24.0 * std::float64::from_int(i)) / 2.0, line)
    normal = canvas.scale(1.0)
    shade and band and ink and bigger and written.succeeded?() and normal

# One frame of WORLD, presented: whether every Canvas operation succeeded.
fn frame(world: tower::World, context canvas: Canvas) -> bool errors NonFiniteFloat:
    camera = world.camera
    sky = canvas.color(18, 22, 38)
    cleared = canvas.clear()
    walled = walls(camera)
    drawn = loop p in world.platforms:
        p.platform(camera)
    figure = world.player.player(camera)
    shade = canvas.color(10, 12, 24)
    panel = canvas.fill(tower::wall, 0.0, 132.0, 56.0)
    ink = canvas.color(236, 240, 255)
    status = hud::status_lines(world).lines(tower::wall + 8.0, 8.0)
    message = hud::banner_lines(world).banner(300.0)
    shown = canvas.present()
    sky and cleared and walled and drawn.succeeded?() and figure and shade and panel and ink and status and message and shown

# Draws WORLD and presents it: what failed, "" when nothing did.
fn draw(world: tower::World) -> str:
    drawn = frame(world):
        on NonFiniteFloat:
            false
    if drawn:
        return ""
    "drawing a frame"
