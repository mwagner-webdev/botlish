# A2. Affinity is compositional, so no container smuggles a pointer into a
# context (ICY-TOWER-CONTEXT-REFACTOR-CENSUS.md, "Context deficiencies", A).
#
# A struct holding a pointer, and a MutableVector of pointers (the one kind
# of member a context mutates in place), are affine like the pointer itself
# (hir::types::IsAffine): installing a context that holds either was the
# same AFFINE-ERASURE-UNSUPPORTED as a1's, one diagnostic per installation.
#
# Since CONTEXT-OWNED-AFFINE-STATE-MILESTONE-1.md both installations are
# valid on every backend: the slot owns the aggregate -- the struct's
# pointers, the vector and the pointers in it -- and affinity stays
# compositional (the vector is still an affine MutableVector: nothing copies
# it). a3-late-acquisition.bot uses such a member.
#
# expect interp: value: 1
# expect compile: value: 1
# expect cranelift-generic: value: 1
# expect cranelift: value: 1
import std::ffi::c
import std::mutable_vector

struct Pair:
    window: std::ffi::c::Ptr[std::ffi::c::Void]
    renderer: std::ffi::c::Ptr[std::ffi::c::Void]

opaque context struct Video:
    pair: Pair

opaque context struct Pool:
    pointers: MutableVector[std::ffi::c::Ptr[std::ffi::c::Void]]

fn video() -> Video:
    Video {pair: Pair {window: std::ffi::c::null[std::ffi::c::Void](), renderer: std::ffi::c::null[std::ffi::c::Void]()}}

fn pool() -> Pool:
    Pool {pointers: std::mutable_vector::from_list([])}

with context video()
with context pool()

1
