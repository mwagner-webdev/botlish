nir 1 call-effects=1 statics=3

func 0 "<program>" params=0 env=0 regs=8 pnames="" captures=0 instance="generic" rawregs="1 4 7"
    %0 = int 10 @e13
    %1 = rawint 10
    %2 = call 1 %0 @e11
    %3 = int 32 @e16
    %4 = rawint 32
    %5 = callenv 3 %2 %3 @e14
    %6 = int 42 @e14
    %7 = rawint 42
    ret %6
end

func 1 "make_adder" params=1 env=0 regs=2 pnames="x" captures=0 instance="int" @e2
    %1 = closure 2 %0 @e4
    ret %1
end

func 2 "add" params=1 env=1 regs=3 pnames="y" captures=1 instance="generic" @e4
    %1 = capture 0
    guard int %0 "+" @e5
    %2 = op iadd %1 %0 @e5
    ret %2
end

func 3 "add" params=1 env=1 regs=6 pnames="y" captures=1 instance="int" rawregs="2 3 4" @e4
    %1 = capture 0
    %2 = op runbox %1
    %3 = op runbox %0
    %4 = op riadd %2 %3 @e5
    %5 = op rbox %4
    ret %5
end

