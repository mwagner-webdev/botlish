nir 1 call-effects=1 statics=3

func 0 "<program>" params=0 env=0 regs=8 pnames="" captures=0 instance="generic" rawregs="1 3 5"
    %0 = int 3 @e8
    %1 = rawint 3
    %2 = int 1 @e13
    %3 = rawint 1
    %4 = int 2 @e14
    %5 = rawint 2
    %6 = call 1 %2 %4 @e11
    %7 = op listnew %6 %0 @e9
    ret %7
end

func 1 "pair" params=2 env=0 regs=3 pnames="list#1 x" captures=0 instance="int, int" @e2
    %2 = op listnew %0 %1 @e3
    ret %2
end

