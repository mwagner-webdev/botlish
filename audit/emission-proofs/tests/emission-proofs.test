test ep-statement-digest {what a certificate states -- its exits, visits, failure states, result -- is in its statement digest} -body {
    set cert [dict create function f recognizer r depends [dict create recognizers [dict create r X]] \
        domain int exits {a} visits {a b} fails {a} result {{-1 -1}} follow self]
    set d0 [modcheck::StatementDigest $cert]
    set out {}
    foreach {k v} {exits {b} visits {a} fails {} result {{0 0}} follow {}} {
        lappend out [expr {[modcheck::StatementDigest [dict replace $cert $k $v]] ne $d0}]
    }
    set out
} -result {1 1 1 1 1}

test ep-compose-modes {body composition and certificate composition decide the JSON emitters alike} -body {
    set dir [epws::scratch]
    set a [modcheck::check [file join $dir check_all.bot] -witness 0 -compose body]
    set b [modcheck::check [file join $dir check_all.bot] -witness 0 -compose certificate]
    set va [lmap c [dict get $a claims] {dict get $c verdict}]
    set vb [lmap c [dict get $b claims] {dict get $c verdict}]
    list [expr {$va eq $vb}] [llength [lsearch -all $va proven]]
} -result {1 22}

# ---------------------------------------------------------------------------
# Certificates

test ep-store-reuse {a certificate store proved once, reused by another compilation of another program} -body {
    set dir [epws::scratch]
    foreach c {safe unused} {
        file copy -force [file join $auditDir callers $c.bot] [file join $dir $c.bot]
    }
    set store [file join $dir certs.store]
    set a [modcheck::check [file join $dir safe.bot] -witness 0 -store $store]
    set b [modcheck::check [file join $dir unused.bot] -witness 0 -store $store]
    set reused [llength [lmap c [dict get $b claims] {if {![dict exists $c reused]} continue; set c}]]
    set proven [llength [lmap c [dict get $a claims] {if {[dict get $c verdict] ne "proven"} continue; set c}]]
    list [expr {$reused == $proven}] [expr {$reused > 0}]
} -result {1 1}

test ep-store-invalidate {a helper's change invalidates its function's certificate, not the certificate of a caller that composed by it; a recognizer's change invalidates both} -body {
    set dir [epws::scratch]
    file copy -force [file join $auditDir callers unused.bot] [file join $dir unused.bot]
    set store [file join $dir certs.store]
    modcheck::check [file join $dir unused.bot] -witness 0 -store $store
    set lib [file join $dir emitlib.bot]
    set text [readFile $lib]
    set f [open $lib w]; puts -nonewline $f [string map {"        yield 87 + n" "        yield 55 + n"} $text]; close $f
    set r1 [modcheck::check [file join $dir unused.bot] -witness 0 -store $store]
    set f [open $lib w]; puts -nonewline $f $text; close $f
    modcheck::check [file join $dir unused.bot] -witness 0 -store $store
    set lex [file join $dir json_lex.bot]
    set ltext [readFile $lex]
    set f [open $lex w]; puts -nonewline $f [string map {"'\"' '\\\\' '/' 'b'" "'\"' '\\\\' 'b'"} $ltext]; close $f
    set r2 [modcheck::check [file join $dir unused.bot] -witness 0 -store $store]
    set again {}
    foreach r [list $r1 $r2] {
        lappend again [lsort [lmap c [dict get $r claims] {
            if {[dict exists $c reused] || [dict get $c verdict] ne "proven"} continue
            if {![string match emitlib::* [dict get $c name]]} continue
            namespace tail [dict get $c name]
        }]]
    }
    set again
} -result {json_string {json_string json_string_source member}}

test ep-fingerprint {a function's fingerprint ignores comments and unrelated code, and changes with a constant} -body {
    set p1 [program {fn f(n: int) -> unit:
    yield 48 + n
    unit

0}]
    set p2 [program {# a comment
fn g() -> int:
    5

fn f(n: int) -> unit:
    # another
    yield 48 + n
    unit

0}]
    set p3 [program {fn f(n: int) -> unit:
    yield 49 + n
    unit

0}]
    set out {}
    foreach p [list $p1 $p2 $p3] {
        set dir [epws::scratch main.bot $p]
        modcheck::Reset
        modcheck::Load [file join $dir main.bot] {}
        lappend out [modcheck::FunctionFingerprint [dict get $modcheck::byName f]]
    }
    list [expr {[lindex $out 0] eq [lindex $out 1]}] [expr {[lindex $out 0] ne [lindex $out 2]}]
} -result {1 1}

# ---------------------------------------------------------------------------
# The exploratory baseline's false proofs (kept as found)

test ep-exploratory-false-proofs {the exploratory checker certified a symbol of 10^23 and a quotation mark after a caught failure; the modular checker rejects both} -body {
    set p [program {error Oops:
    at: int

fn h(n: int) -> unit errors Oops:
    yield 34
    if n > 0:
        fail Oops {at: 1}
    unit

#: emits json_lex::json_string
fn s(n: int) -> unit:
    yield 34
    h(n):
        on Oops:
            yield 34
    unit

#: emits json_lex::json_number
fn big() -> unit:
    yield 49
    yield 100000000000000000000000
    unit

fn src(n: int) -> int:
    s(n)
    big()
    -1

coroutine {step, first} = src(1)
first} {json_lex}]
    set dir [epws::scratch main.bot $p]
    set o [emitcheck::check [file join $dir main.bot]]
    list [lmap e [dict get $o emitters] {dict get $e name}] [llength [dict get $o diagnostics]] [verdicts $p]
} -result {{s big} 0 {{s not-proved} {big not-proved}}}

# ---------------------------------------------------------------------------
# Native erasure

test ep-claim-erased {a claim is erased: the library with and without its eight claims compiles to the same functions (every fingerprint equal; number_emit keeps its four)} -body {
    set out {}
    foreach strip {0 1} {
        set dir [epws::scratch main.bot "import emitlib\n\n0\n"]
        if {$strip} {
            set lib [file join $dir emitlib.bot]
            set text [readFile $lib]
            set f [open $lib w]
            puts -nonewline $f [regsub -all -line {^#: emits .*$} $text "#"]
            close $f
        }
        modcheck::Reset
        modcheck::Load [file join $dir main.bot] {}
        set fps {}
        foreach name [lsort [dict keys $modcheck::byName]] {
            if {![string match emitlib::* $name]} continue
            lappend fps $name [modcheck::FunctionFingerprint [dict get $modcheck::byName $name]]
        }
        lappend out [list [llength $modcheck::claims] $fps]
    }
    lassign $out a b
    list [lindex $a 0] [lindex $b 0] [expr {[lindex $a 1] eq [lindex $b 1]}] [expr {[llength [lindex $a 1]] > 20}]
} -result {12 4 1 1}

test ep-native-erasure {a certified emitter's fused code holds no transition of its grammar; a guarded one keeps only its guard's} -constraints nativeCoroutines -body {
    set main "import emitlib\nimport std::coroutine\n\nfn text(t: str) -> int errors IndexNotFound:\n    coroutine {step, first} = emitlib::json_string_source(t)\n    n = first\n    loop:\n        if std::coroutine::done?(step):\n            break\n        step()\n        continue\n    n\n\ntext(\"a\\\"b\"):\n    on IndexNotFound:\n        -2\n"
    set dir [epws::scratch main.bot $main]
    set hir [surface::readProgramFile [file join $dir main.bot] -warnings off]
    set nir [native::fusedNir $hir]
    list [regexp -all {rtabload} $nir] [regexp -all -line {^\s*switch } $nir] [regexp -all {dfa#transition} $nir]
} -result {0 0 0}

