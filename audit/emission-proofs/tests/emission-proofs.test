test ep-conformance {dfasem's step against the reference interpreter on every case dfatest makes for the JSON recognizers and three with lookahead two, a call `then accept` and a call `then STATE` that reconsiders: the same outcome everywhere} -body {
    set dir [epws::scratch main.bot "import json_grammar\nimport la\n\n0\n" la.bot \
        "import std::dfa\n\ndfa ab over ascii:\n    start:\n        'a' -> one\n    one:\n        'b' -> two\n    two:\n        'c' -> accept before 2\n        end -> accept\n\ndfa ab_more over ascii:\n    start:\n        'b' -> more\n    more:\n        'b' -> more\n        ')' 'c' -> accept before\n        end -> reject\n\ndfa wrap over ascii:\n    start:\n        '(' -> inner\n    inner:\n        'a' -> call ab then accept\n        'b' -> call ab_more then close\n    close:\n        ')' -> accept\n        'c' -> accept\n"]
    set entry [file join $dir main.bot]
    set keys [dfasem::load $entry]
    lassign [conformance::run $entry $keys 12 3] cases mismatches
    list [expr {$cases > 2000}] [lrange $mismatches 0 2]
} -result {1 {}}

