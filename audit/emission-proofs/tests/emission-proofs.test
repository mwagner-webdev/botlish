# Boundaries and composition

test ep-boundary-adjacent {two numbers back to back in a text are one number: each integer's boundary obligation is broken} -body {
    claims [program {import number_emit

#: emits json_grammar::json_text
fn pair(a: int, b: int) -> unit errors IndexNotFound:
    yield 91
    number_emit::integer(a)
    number_emit::integer(b)
    yield 93
    unit

#: emits json_grammar::json_text
fn pair_ok(a: int, b: int) -> unit errors IndexNotFound:
    yield 91
    number_emit::integer(a)
    yield 44
    number_emit::integer(b)
    yield 93
    unit

0}]
} -result {{pair not-proved {EMIT-BOUNDARY EMIT-REJECTED}} {pair_ok proven {}}}

test ep-boundary-branch {a number written on one branch only: the obligation is on that branch's exits, so a separator after the branches is proven, a digit is not (and, composed by the certificate, which may end in `zero`, also rejected)} -body {
    claims [program {import number_emit

#: emits json_grammar::json_text
fn branch_ok(a: int, b: int) -> unit errors IndexNotFound:
    yield 91
    if a > 0:
        number_emit::integer(a)
        yield 44
    number_emit::integer(b)
    yield 93
    unit

#: emits json_grammar::json_text
fn branch_bad(a: int) -> unit errors IndexNotFound:
    yield 91
    if a > 0:
        number_emit::integer(a)
    yield 53
    yield 93
    unit

0}]
} -result {{branch_ok proven {}} {branch_bad not-proved {EMIT-BOUNDARY EMIT-REJECTED}}}

