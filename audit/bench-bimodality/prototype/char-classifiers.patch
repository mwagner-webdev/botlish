diff --git a/core/unicodechar.tcl b/core/unicodechar.tcl
index 5578d7bb..53c9882c 100644
--- a/core/unicodechar.tcl
+++ b/core/unicodechar.tcl
@@ -26,5 +26,23 @@ proc core::unicodechar::scalar_value {c} {
     return [core::value::int [core::value::charOf $c]]
 }
 
+# PROTOTYPE (BENCHMARK-BIMODALITY.md): Tcl's [:alpha:]/[:alnum:] of a
+# UnicodeChar, exactly std::str::is_tcl_alpha/alnum of its one-scalar String,
+# but total: there is no operand of the wrong length.
+proc core::unicodechar::isTclAlpha {c} {
+    set c [core::value::expect UnicodeChar $c std::char::is_tcl_alpha]
+    return [core::value::bool [string is alpha -strict [format %c [core::value::charOf $c]]]]
+}
+
+proc core::unicodechar::isTclAlnum {c} {
+    set c [core::value::expect UnicodeChar $c std::char::is_tcl_alnum]
+    return [core::value::bool [string is alnum -strict [format %c [core::value::charOf $c]]]]
+}
+
+core::native::register std::char::is_tcl_alpha -arity 1 -impl core::unicodechar::isTclAlpha \
+    -param-types {UnicodeChar} -result-type bool -context-free 1
+core::native::register std::char::is_tcl_alnum -arity 1 -impl core::unicodechar::isTclAlnum \
+    -param-types {UnicodeChar} -result-type bool -context-free 1
+
 core::native::register std::char::scalar_value -arity 1 -impl core::unicodechar::scalar_value \
     -param-types {UnicodeChar} -result-type int -result-range {interval 0 0x10FFFF} -context-free 1
