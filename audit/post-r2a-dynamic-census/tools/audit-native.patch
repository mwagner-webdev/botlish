+/// AUDIT-ONLY (audit/post-m8a-common-inefficiency/tools/audit-native.patch):
+/// one named, never-inlined frame around each timed program run, so
+/// `valgrind --tool=callgrind --toggle-collect=botlish_audit_run` collects
+/// exactly program execution -- not JIT compilation, not Vm::reset's
+/// between-run collection.
+#[inline(never)]
+#[unsafe(no_mangle)]
+pub extern "C" fn botlish_audit_run(entry: codegen::ProgramEntry, vm: *mut Vm) -> runtime::value::Value {
+    entry(vm)
+}
+
+/// AUDIT-ONLY (audit/post-r2a-dynamic-census/tools/audit-native.patch): the
+/// between-run Vm::reset (which reclaims every object the previous run
+/// allocated) in its own named, never-inlined frame, so
+/// `valgrind --tool=callgrind --toggle-collect=botlish_audit_reset` can
+/// measure the deferred reclamation cost the timed runs themselves exclude.
+#[inline(never)]
+#[unsafe(no_mangle)]
+pub extern "C" fn botlish_audit_reset(vm: *mut Vm) {
+    unsafe { (*vm).reset() }
+}
