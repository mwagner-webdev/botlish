        # kindOf; the others are bare kinds whose elements are not known.)
        return [list unknown "its static type is [show $type], whose values are not known to have total equality and hashing (one may hold a function)"]
    }
    return {total ""}
}

proc ::reference::types::Components {operation parts seen} {
    set unknown ""
    foreach part $parts {
        lassign $part what t
        lassign [Totality $operation $t $seen] class why
        if {$class eq "none"} {
            return [list none "$what ([show $t]): $why"]
        }
        if {$class eq "unknown" && $unknown eq ""} {
            set unknown "$what ([show $t]): $why"
        }
    }
    if {$unknown ne ""} {
        return [list unknown $unknown]
    }
    return {total ""}
}

proc ::reference::types::SendClass {type {assumed {}} {seen {}}} {
    if {$type eq "never"} {
        return {total ""}
    }
    if {[IsTrait $type]} {
        if {"send" in [hir::traits::intrinsicGuarantees [lindex $type 1]]} {
            return {total ""}
        }
        return [list unknown "it is seen only through trait [lindex $type 1], whose values need not be sendable"]
    }
    if {[IsFn $type] || [IsExactBlock $type] || [IsExactNative $type]} {
        return [list none [NoSending block]]
    }
    if {[IsImprint $type]} {
        if {[lindex $type 1] in $assumed} {
            return {total ""}
        }
        foreach trait [ImprintConstraints $type] {
            if {"send" in [hir::traits::intrinsicGuarantees $trait]} {
                return {total ""}
            }
        }
        return [list unknown "its type is the imprint variable [hir::imprint::Shown [lindex $type 1]], which no constraint holds to Sendable"]
    }
    if {[IsCoroutine $type]} {
        return [list none [NoSending coroutine]]
    }
    if {[IsCPtr $type] || [IsCFnPtr $type] || [IsNativeMemory $type] || $type eq "cptr"} {
        return [list none [NoSending cptr]]
    }
    if {[hir::cabi::IsFiniteFloating $type]} {
        return [SendClass [hir::cabi::Carrier $type] $assumed $seen]
    }
    if {[hir::refinements::IsRefined $type]} {
        if {[hir::refinements::IsApplied [hir::refinements::Family $type]]} {
            # A List length refinement: knowledge about a List, which the
            # receiver checks again (the length is part of the schema).
            return [SendClass [hir::refinements::Base $type] $assumed $seen]
        }
        # DecimalRounded: its guarantee is a property of the binary64 it
        # holds, which the copy keeps bit for bit.
        return {total ""}
    }
    if {[IsList $type]} {
        # (A positional shape is knowledge about one value: a List is sent
        # as a List of its element type.)
        return [SendComponents [list [list "its elements" [lindex $type 1]]] $assumed $seen]
    }
    if {[IsSet $type]} {
        return [SendComponents [list [list "its members" [lindex $type 1]]] $assumed $seen]
    }
    if {[IsMutVec $type] || [IsMutArray $type]} {
        # A mutable collection is a value (MUTABLE-VECTOR.md): its copy is a
        # new value in the receiver, its backing never crosses.
        return [SendComponents [list [list "its elements" [lindex $type 1]]] $assumed $seen]
    }
    if {[IsStruct $type]} {
        set parts {}
        foreach {name t} [lindex $type 1] {
            lappend parts [list "field \"$name\"" $t]
        }
        return [SendComponents $parts $assumed $seen]
    }
    if {[IsNamedStruct $type]} {
        return [SendStruct $type $assumed $seen]
    }
    if {[IsEnum $type]} {
        # A case is its enum's identity and its case name: the receiver
        # finds both by name (ENUMS.md: no case has a position).
        return {total ""}
    }
    if {$type in {any struct list immutableSet mutarray mutvec result} || [catch {core::type::normalize $type} normal]} {
        return [list unknown "its static type is [show $type], which does not say what its values are"]
    }
    foreach name [core::type::evidenceClosure $normal] {
        if {[core::type::isRefinement $name]} {
            return [list none "$name is a refinement: membership in it is a proof of this program (its predicates and validators), which a copy cannot carry and the receiver does not run again"]
        }
    }
    switch -- [core::type::base $normal] {
        int - str - bool - unit - UnicodeChar - Float64 - DecimalRounded - rawfloat32 - rawfloat64 {
            # (An integer domain's range is part of the schema: the receiver
            # checks every value against it.)
            return {total ""}
        }
        block - native {
            return [list none [NoSending block]]
        }
        coroutine {
            return [list none [NoSending coroutine]]
        }
        cptr {
            return [list none [NoSending cptr]]
        }
    }
    return [list unknown "its static type is [show $type], which does not say what its values are"]
}

proc ::reference::types::SendStruct {type assumed seen} {
    set id [lindex $type 1]
    if {$type in $seen} {
        return {total ""}
    }
    if {![hir::structs::declared $id]} {
        return [list unknown "$id is not a declared struct"]
    }
    set shown [show $type]
    if {[hir::structs::isContext $id]} {
        return [list none "$shown is a context struct: an installed context is authority, selected by each program's own installation, never a value one VM can hand another"]
    }
    set seen [concat $seen [list $type]]
    if {[hir::structs::isOpaque $id]} {
        set clause [hir::structs::sendableOf $id]
        if {$clause eq ""} {
            return [list none "$shown is an opaque struct whose owner, [hir::structs::ownerOf $id], does not declare it sendable: its fields are its owner's representation, whose meaning (a value, or an identity of one VM: a slot, a handle) only the owner knows"]
        }
        switch -- [dict get $clause form] {
            bytes - mutable_bytes {
                # Byte storage: the bytes are the value.
                return {total ""}
            }
            through {
                set r [hir::structs::AppliedRepresentation $type]
                return [SendComponents [list [list "the representation of $shown" $r]] $assumed $seen]
            }
        }
        # `fields`: the owner states that a field-wise copy is the value.
    }
    set parts {}
    foreach {name t} [::reference::Fields $type] {
        lappend parts [list "field \"$name\" of $shown" [if {$t eq {}} {string cat any} else {set t}]]
    }
    return [SendComponents $parts $assumed $seen]
}

proc ::reference::types::SendComponents {parts assumed seen} {
    set unknown ""
    foreach part $parts {
        lassign $part what t
        lassign [SendClass $t $assumed $seen] class why
        if {$class eq "none"} {
            return [list none "$what ([show $t]): $why"]
        }
        if {$class eq "unknown" && $unknown eq ""} {
            set unknown "$what ([show $t]): $why"
        }
    }
    if {$unknown ne ""} {
        return [list unknown $unknown]
    }
    return {total ""}
}

proc ::reference::types::MentionsMutable {type} {
    set visited [dict create]
    return [MentionsMutableFrom $type visited]
}

proc ::reference::types::MentionsMutableFrom {type visitedVar} {
    upvar 1 $visitedVar visited
    if {[IsMutVec $type] || [IsMutArray $type] || $type in {mutvec mutarray}} {
        return 1
    }
    if {[IsRefinedApplied $type]} {
        return [MentionsMutableFrom [hir::refinements::Base $type] visited]
    }
    if {[IsList $type] || [IsSet $type]} {
        return [MentionsMutableFrom [lindex $type 1] visited]
    }
    if {[IsStruct $type]} {
        foreach {name t} [lindex $type 1] {
            if {[MentionsMutableFrom $t visited]} { return 1 }
        }
    }
    if {[IsNamedStruct $type]} {
        if {[dict exists $visited $type]} {
            return 0
        }
        dict set visited $type 1
        foreach {name t} [::reference::Fields $type] {
            if {[MentionsMutableFrom $t visited]} { return 1 }
        }
    }
    return 0
}

proc ::reference::types::HashClass {type} {
    lassign [Totality equality $type] e ewhy
    lassign [Totality hash $type] h hwhy
    if {$e eq "none"} { return [list none $ewhy] }
    if {$h eq "none"} { return [list none $hwhy] }
    if {$e eq "unknown"} { return [list unknown $ewhy] }
    if {$h eq "unknown"} { return [list unknown $hwhy] }
    return {total ""}
}

namespace eval ::reference::mutvec { namespace path ::hir::mutvec }
proc ::reference::mutvec::MayHoldVector {type {seen {}}} {
    if {[lindex $type 0] eq "refined"} {
        # A refined value has exactly its carrier's representation
        # (REFINEMENT-VALUES.md): an integer domain, a C scalar, a
        # refinement of a String hold no header.
        return [MayHoldVector [lindex $type 1] $seen]
    }
    if {[hir::types::IsStruct $type]} {
        foreach {name t} [lindex $type 1] {
            if {[MayHoldVector $t $seen]} {
                return 1
            }
        }
        return 0
    }
    if {[hir::types::IsNamedStruct $type]} {
        # (An application's fields, its slots replaced by the arguments:
        # TRAIT-CONSTRAINED-IMPRINTED-TYPES.md.)
        if {$type in $seen} {
            return 0
        }
        foreach {name t} [::reference::Fields $type] {
            if {[MayHoldVector $t [concat $seen [list $type]]]} {
                return 1
            }
        }
        return 0
    }
    if {[hir::types::IsEnum $type]} {
        # An enum (ENUMS.md) holds what its case payloads hold: nothing,
        # for the payload-free cases of today.
        set id [lindex $type 1]
        if {$id in $seen} {
            return 0
        }
        foreach t [hir::enums::payloadTypes $id] {
            if {[MayHoldVector $t [concat $seen [list $id]]]} {
                return 1
            }
        }
        return 0
    }
    if {[Kind $type] ne ""} {
        return 1
    }
    return [expr {[lindex $type 0] ni {int str bool unit UnicodeChar never list immutableSet block native fn coroutine result}
        && ![core::type::isFloat [lindex $type 0]]}]
}

namespace eval ::reference::staticdeps { namespace path ::hir::staticdeps }
proc ::reference::staticdeps::CanCarry {hir type {seen {}}} {
    set type [hir::types::Unrefined $type]
    if {[hir::types::IsExactBlock $type] || [hir::types::IsExactNative $type]
            || [hir::types::IsFn $type] || [hir::types::IsCoroutine $type]} {
        return 1
    }
    if {[hir::types::IsMutArray $type] || [hir::types::IsSet $type] || [hir::types::IsMutVec $type]} {
        return [CanCarry $hir [lindex $type 1] $seen]
    }
    if {[hir::types::IsList $type]} {
        foreach t [concat [list [lindex $type 1]] [hir::types::shapeOf $type]] {
            if {[CanCarry $hir $t $seen]} {
                return 1
            }
        }
        return 0
    }
    if {[hir::types::IsStruct $type]} {
        foreach {name t} [lindex $type 1] {
            if {[CanCarry $hir $t $seen]} {
                return 1
            }
        }
        return 0
    }
    if {[hir::types::IsNamedStruct $type]} {
        # (An application's fields, its slots replaced by the arguments:
        # TRAIT-CONSTRAINED-IMPRINTED-TYPES.md.)
        if {$type in $seen} {
            return 0
        }
        lappend seen $type
        foreach {name t} [::reference::Fields $type] {
            if {[CanCarry $hir $t $seen]} {
                return 1
            }
        }
    }
    return 0
}

namespace eval ::reference::decimal { namespace path ::hir::decimal }
proc ::reference::decimal::Mentions {type {seen {}}} {
    set type [hir::types::Unrefined $type]
    if {[IsDecimal $type]} {
        return 1
    }
    if {[hir::types::IsList $type] || [hir::types::IsSet $type]
            || [hir::types::IsMutVec $type] || [hir::types::IsMutArray $type]} {
        return [Mentions [lindex $type 1] $seen]
    }
    if {[hir::types::IsStruct $type]} {
        foreach {name t} [lindex $type 1] {
            if {[Mentions $t $seen]} {
                return 1
            }
        }
        return 0
    }
    if {[hir::types::IsNamedStruct $type]} {
        # (An application's fields, its slots replaced by the arguments:
        # TRAIT-CONSTRAINED-IMPRINTED-TYPES.md. SEEN guards a struct that
        # holds itself.)
        if {$type in $seen} {
            return 0
        }
        set fields [::reference::Fields $type]
        set identity [hir::structs::identityOf [lindex $type 1]]
        if {$identity ne ""} {
            # A struct that declares its identity (REPRESENTATION-
            # INDEPENDENT-VALUE-IDENTITY.md) is compared by it alone: what
            # its equality reads are its identity fields, never the rest.
            set fields [concat {*}[lmap field [dict get $identity fields] {
                list $field [dict get $fields $field]
            }]]
        }
        foreach {name t} $fields {
            if {[Mentions $t [concat $seen [list $type]]]} {
                return 1
            }
        }
    }
    return 0
}

namespace eval ::reference::structs { namespace path ::hir::structs }
proc ::reference::structs::MutableComponent {type {seen {}}} {
    if {$type eq "never" || [hir::types::IsFn $type] || [hir::types::IsImprint $type]
            || [hir::types::IsTrait $type]} {
        return ""
    }
    if {[hir::types::IsAffine $type]} {
        return "an affine value"
    }
    switch -- [hir::types::kindOf $type] {
        mutvec { return "a MutableVector" }
        mutarray { return "a MutableArray" }
        cptr { return "a C pointer or native view" }
    }
    if {[hir::types::IsList $type] && [llength $type] == 2} {
        return [MutableComponent [lindex $type 1] $seen]
    }
    if {[hir::types::IsList $type]} {
        foreach t [lindex $type 2] {
            set why [MutableComponent $t $seen]
            if {$why ne ""} {
                return $why
            }
        }
        return ""
    }
    if {[hir::types::IsSet $type]} {
        return [MutableComponent [lindex $type 1] $seen]
    }
    if {[hir::types::IsStruct $type]} {
        foreach {name t} [lindex $type 1] {
            set why [MutableComponent $t $seen]
            if {$why ne ""} {
                return $why
            }
        }
        return ""
    }
    if {[hir::types::IsNamedStruct $type]} {
        set id [lindex $type 1]
        if {$type in $seen || ![declared $id] || [identityOf $id] ne ""} {
            return ""
        }
        if {[::reference::CatchFields $type fields]} {
            return ""
        }
        foreach {name t} $fields {
            if {$t eq {}} continue
            set why [MutableComponent $t [concat $seen [list $type]]]
            if {$why ne ""} {
                if {[isOpaque $id]} {
                    # (An opaque struct's representation is its owner's.)
                    return "[hir::types::show $type], a mutable value"
                }
                return "[hir::types::show $type], whose field \"$name\" holds $why"
            }
        }
    }
    return ""
}

namespace eval ::reference::sourcetypes { namespace path ::hir::sourcetypes }
proc ::reference::sourcetypes::ValueStability {type {visiting {}}} {
    set type [hir::types::Unrefined $type]
    if {$type eq "any"} {
        return "may be any value, including a mutable one"
    }
    if {[hir::types::IsMutArray $type] || $type eq "mutarray"} {
        return "has reference semantics (a MutableArray's slots change in place)"
    }
    if {[hir::types::IsMutVec $type] || $type eq "mutvec"} {
        return "is a MutableVector, whose contents its owning place changes in place"
    }
    if {[hir::types::IsFn $type] || [hir::types::IsExactBlock $type] || [hir::types::IsExactNative $type]
            || $type in {block native}} {
        return "is a callable, which has no stable value to refine"
    }
    if {[hir::types::IsList $type] || [hir::types::IsSet $type]} {
        set why [ValueStability [lindex $type 1] $visiting]
        return [expr {$why eq "" ? "" : "has an element type, [hir::types::show [lindex $type 1]], that $why"}]
    }
    if {$type in {list immutableSet result struct}} {
        return "may hold values of any kind, including mutable ones"
    }
    if {[hir::types::IsStruct $type]} {
        foreach {field t} [lindex $type 1] {
            set why [ValueStability $t $visiting]
            if {$why ne ""} { return "has a field \"$field\" that $why" }
        }
        return ""
    }
    if {[hir::types::IsNamedStruct $type]} {
        # (An application's fields: TRAIT-CONSTRAINED-IMPRINTED-TYPES.md.)
        if {$type in $visiting} { return "" }
        foreach {field t} [::reference::Fields $type] {
            set why [ValueStability $t [concat $visiting [list $type]]]
            if {$why ne ""} { return "has a field \"$field\" that $why" }
        }
        return ""
    }
    return ""
}
