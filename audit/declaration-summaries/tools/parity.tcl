# parity.tcl -- the declaration summaries' answers against the recursive
# walks they replaced (PARAMETERIZED-DECLARATION-SUMMARIES-MILESTONE-1.md).
#
# Sourced by tests/parameterized-declaration-summaries.test and the audit
# tools after the compiler. reference.tcl holds the old walks (generated by
# extract-reference.py from the revision before the summaries).
#
#   parity::analyses                     the analyses compared, in order
#   parity::New ANALYSIS HIR TYPE        the compiler's answer
#   parity::Old ANALYSIS HIR TYPE        the old walk's answer, or
#                                        REFERENCE-BUDGET if it did not finish
#   parity::Exact ANALYSIS HIR TYPE      the old walk with the type bound
#                                        raised while it substitutes: no
#                                        argument is cut (the answer the uncut
#                                        type has), or REFERENCE-BUDGET
#   parity::Compare HIR TYPE             {ANALYSIS NEW OLD EXACT VERDICT} for
#                                        every analysis; VERDICT is `same`
#                                        (NEW is OLD), `bound` (NEW differs
#                                        from OLD, and the old walk read a
#                                        field type the type bound had cut:
#                                        an argument it substituted lost a
#                                        component), `diverges` (the old walk
#                                        does not finish) or `DIFFERENT`

source [file join [file dirname [file normalize [info script]]] reference.tcl]

namespace eval ::parity {
    # ANALYSIS -> {NEW OLD}: lambdas of {hir t}.
    variable table {
        bearing {
            {{hir t} {hir::callables::Bearing $hir $t}}
            {{hir t} {::reference::callables::Bearing $hir $t}}
        }
        carried {
            {{hir t} {hir::callables::CarriedErrors $hir $t}}
            {{hir t} {::reference::callables::CarriedErrors $hir $t}}
        }
        equality {
            {{hir t} {hir::types::Totality equality $t}}
            {{hir t} {::reference::types::Totality equality $t}}
        }
        hash {
            {{hir t} {hir::types::Totality hash $t}}
            {{hir t} {::reference::types::Totality hash $t}}
        }
        hashClass {
            {{hir t} {hir::types::HashClass $t}}
            {{hir t} {::reference::types::HashClass $t}}
        }
        send {
            {{hir t} {hir::types::SendClass $t}}
            {{hir t} {::reference::types::SendClass $t}}
        }
        mentionsMutable {
            {{hir t} {hir::types::MentionsMutable $t}}
            {{hir t} {::reference::types::MentionsMutable $t}}
        }
        mayHoldVector {
            {{hir t} {hir::mutvec::MayHoldVector $t}}
            {{hir t} {::reference::mutvec::MayHoldVector $t}}
        }
        canCarry {
            {{hir t} {hir::staticdeps::CanCarry $hir $t}}
            {{hir t} {::reference::staticdeps::CanCarry $hir $t}}
        }
        decimalMentions {
            {{hir t} {hir::decimal::Mentions $t}}
            {{hir t} {::reference::decimal::Mentions $t}}
        }
        mutableComponent {
            {{hir t} {hir::structs::MutableComponent $t}}
            {{hir t} {::reference::structs::MutableComponent $t}}
        }
        valueStability {
            {{hir t} {hir::sourcetypes::ValueStability $t}}
            {{hir t} {::reference::sourcetypes::ValueStability $t}}
        }
    }
    variable analyses [dict keys $table]
}

proc ::parity::New {analysis hir t} {
    variable table
    return [apply [lindex [dict get $table $analysis] 0] $hir $t]
}

proc ::parity::Old {analysis hir t} {
    variable table
    if {[catch {::reference::Run [list apply [lindex [dict get $table $analysis] 1] $hir $t]} result options]} {
        if {[dict get $options -errorcode] eq "REFERENCE-BUDGET"} {
            return REFERENCE-BUDGET
        }
        return -options $options $result
    }
    return $result
}

proc ::parity::Exact {analysis hir t} {
    set saved [list $::hir::types::aggregateDepth $::hir::types::appliedDepth]
    set ::hir::types::aggregateDepth 64
    set ::hir::types::appliedDepth 64
    try {
        return [Old $analysis $hir $t]
    } finally {
        lassign $saved ::hir::types::aggregateDepth ::hir::types::appliedDepth
    }
}

# The class part of an answer: Totality's and SendClass's {CLASS WHY} keep
# their class only for the `bound` verdict (a cut changes a reason's text
# with its class).
proc ::parity::Class {answer} {
    if {[llength $answer] == 2 && [lindex $answer 0] in {total unknown none}} {
        return [lindex $answer 0]
    }
    return $answer
}

proc ::parity::Compare {hir t} {
    variable analyses
    set result {}
    foreach analysis $analyses {
        set new [New $analysis $hir $t]
        set old [Old $analysis $hir $t]
        set cut $::reference::cut
        set exact ""
        if {$old eq "REFERENCE-BUDGET"} {
            set verdict diverges
        } elseif {$new eq $old} {
            set verdict same
        } elseif {$cut} {
            # (The old walk read a field type the bound had cut: its answer
            # is the cut type's.)
            set verdict bound
            set exact [Exact $analysis $hir $t]
        } else {
            set verdict DIFFERENT
        }
        lappend result [list $analysis $new $old $exact $verdict]
    }
    return $result
}

# ---------------------------------------------------------------------------
# The parity corpus: corpus.bot's declarations applied to a pool of arguments.

# The HIR of corpus.bot, its declarations active.
set ::parity::corpusFile [file join [file dirname [file dirname [file normalize [info script]]]] corpus.bot]
proc ::parity::CorpusHir {} {
    variable corpusFile
    set hir [surface::readProgramFile $corpusFile -warnings off]
    hir::activate $hir
    return $hir
}

# The argument pool: one type of every kind the analyses tell apart (SIZE
# small: one of each class the analyses read).
proc ::parity::Pool {{size full}} {
    set C [hir::types::MakeCoroutineType [list {nstruct Message}] {nstruct Event} {}]
    set F [hir::types::MakeFn {int} int {}]
    set pool [list int str any never Small {enum Color} $F \
        [hir::types::MakeFn {any} int {}] [hir::types::MakeFn {} int {Oops}] $C \
        [hir::types::MakeList int] [hir::types::MakeList $F] [hir::types::MakeMutVec int 0] \
        [hir::types::MakeMutArray int 0] [hir::types::MakeSet int 0] \
        [hir::structs::fieldType HoldsPtr p] [hir::structs::fieldType HoldsDecimal d] \
        {nstruct Plain} {nstruct HoldsFn} {nstruct Tree} \
        [hir::types::MakeApplied Box [list int]] [hir::types::MakeApplied Box [list $F]] \
        [hir::types::MakeApplied Box [list $C]] [hir::types::MakeApplied Phantom [list $F]] \
        [hir::types::MakeStruct [dict create x int y $F] 0]]
    if {$size eq "small"} {
        return [list int any $F [hir::types::MakeFn {} int {Oops}] $C [hir::types::MakeMutVec int 0] \
            [hir::types::MakeApplied Box [list $F]]]
    }
    return $pool
}

# The small pool for declarations of two slots.
proc ::parity::SmallPool {} {
    set C [hir::types::MakeCoroutineType [list {nstruct Message}] {nstruct Event} {}]
    return [list int any [hir::types::MakeFn {int} int {}] $C [hir::types::MakeList int] \
        [hir::types::MakeMutVec int 0]]
}

# Every corpus type: each declaration of no slot, each of one slot applied
# to the pool, each of two slots to pairs of the small pool, and some of them
# held in a List, an anonymous struct, a function's result and a vector
# (SIZE small: the small pool, two-slot declarations at three arguments, the
# held forms of W only).
proc ::parity::Corpus {{size full}} {
    set types {}
    foreach id [lsort [dict keys $::hir::structs::registry]] {
        set slots [hir::structs::slots $id]
        switch -- [llength $slots] {
            0 { lappend types [list nstruct $id] }
            1 {
                lappend types [list nstruct $id]
                foreach a [Pool $size] {
                    lappend types [hir::types::MakeApplied $id [list $a]]
                }
            }
            2 {
                set pool [SmallPool]
                if {$size eq "small"} {
                    set pool [lrange $pool 1 3]
                }
                foreach a $pool {
                    foreach b $pool {
                        lappend types [hir::types::MakeApplied $id [list $a $b]]
                    }
                }
            }
        }
    }
    set extra {}
    foreach t [lrange $types 0 end] {
        if {$size eq "small" && [lindex $t 1] ne "W"} continue
        if {[string first Box $t] >= 0 || [string first W $t] >= 0 || [string first Swap $t] >= 0} {
            lappend extra [hir::types::MakeList $t] [hir::types::MakeStruct [dict create s $t] 0] \
                [hir::types::MakeFn {} $t {}] [hir::types::MakeMutVec $t 0]
        }
    }
    return [lsort -unique [concat $types $extra]]
}
