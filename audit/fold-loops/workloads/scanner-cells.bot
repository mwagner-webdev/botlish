# scanner-cells.bot -- scanner-fold.bot's transitions written in the
# pre-fold mutable idiom: the cursor and the counters are one-slot
# MutableArrays updated in place by a bare loop ended by a break (as
# bench/experimental/json-parse.bot keeps its cursor:
# BENCHMARK-SLOWDOWN-CAUSES.md, cause 2), the state struct built once, at
# the end.
#
# expect: [26, 15, 1116, 3]

import std::char
import std::mutable_array
import std::str

struct Scan:
    pos: int
    idents: int
    ints: int
    sum: int
    depth: int
    deepest: int

fn ident_char?(c: UnicodeChar) -> bool:
    std::char::is_tcl_alpha(c) or c == '_'

fn ident_end(text: str, start: int) -> int:
    p = std::mutable_array::create(1, start)
    loop:
        q = p.at(0)
        if q < 0 or q >= std::str::length(text):
            break
        if not ident_char?(text.char_at(q)):
            break
        p.set(0, q + 1)
    p.at(0)

fn line_end(text: str, start: int) -> int:
    p = std::mutable_array::create(1, start)
    loop:
        q = p.at(0)
        if q < 0 or q >= std::str::length(text):
            break
        if text.char_at(q) == '\n':
            break
        p.set(0, q + 1)
    p.at(0)

fn scan(text: str) -> Scan:
    pos = std::mutable_array::create(1, 0)
    idents = std::mutable_array::create(1, 0)
    ints = std::mutable_array::create(1, 0)
    sum = std::mutable_array::create(1, 0)
    depth = std::mutable_array::create(1, 0)
    deepest = std::mutable_array::create(1, 0)
    value = std::mutable_array::create(1, 0)
    loop:
        p = pos.at(0)
        if p < 0 or p >= std::str::length(text):
            break
        c = text.char_at(p)
        v = std::char::scalar_value(c)
        if v >= 48 and v <= 57:
            value.set(0, 0)
            loop:
                q = pos.at(0)
                if q < 0 or q >= std::str::length(text):
                    break
                w = std::char::scalar_value(text.char_at(q))
                if w < 48 or w > 57:
                    break
                value.set(0, value.at(0) * 10 + w - 48)
                pos.set(0, q + 1)
            ints.set(0, ints.at(0) + 1)
            sum.set(0, sum.at(0) + value.at(0))
        elif ident_char?(c):
            pos.set(0, text.ident_end(p))
            idents.set(0, idents.at(0) + 1)
        elif c == '#':
            pos.set(0, text.line_end(p))
        elif c == '(':
            d = depth.at(0) + 1
            depth.set(0, d)
            if d > deepest.at(0):
                deepest.set(0, d)
            pos.set(0, p + 1)
        elif c == ')':
            depth.set(0, depth.at(0) - 1)
            pos.set(0, p + 1)
        else:
            pos.set(0, p + 1)
    Scan {pos: pos.at(0), idents: idents.at(0), ints: ints.at(0), sum: sum.at(0), depth: depth.at(0), deepest: deepest.at(0)}

text = "(define (square x) (mul x x)) # squares 12\nlet total_42 = 7 (plus 100 (minus 3 2))\n(define (cube y) (mul y (mul y y))) # 3 levels\nlet limit = 250 (max 9 (min 81 (abs 6)))\n(list 1 2 3) # done 999\n(sum (range 0 10) 600)\n"

r = scan(text)
[r.idents, r.ints, r.sum, r.deepest]
