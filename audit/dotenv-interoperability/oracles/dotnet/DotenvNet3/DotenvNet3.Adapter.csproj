<Project Sdk="Microsoft.NET.Sdk">
  <!-- audit/dotenv-interoperability: the dotenv.net 3.x reference adapter (cross-version). Restored in
       locked mode (packages.lock.json) and built by tools/setup.py into the
       census cache; nothing is built into the repository. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AssemblyName>DotenvNet3.Adapter</AssemblyName>
    <RootNamespace>DotenvCensus</RootNamespace>
    <DefineConstants>$(DefineConstants);DOTENVNET3</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="dotenv.net" Version="[3.2.1]" />
    <Compile Include="../Common/Census.cs" />
    <Compile Include="../DotenvNet/Program.cs" />
  </ItemGroup>
</Project>
