import abi
import abi::x86_64
fn classify(n: int):
    x = abi::i16(n):
        on AbiIntegerBelowRange:
            return "below"
        on AbiIntegerAboveRange:
            return "above"
    [x.value, abi::x86_64::from_i16(x).word]

xs = [0 - 32769, 0 - 32768, 0 - 32767, 0 - 1, 0, 1, 0 - 16384, 16383, 32766, 32767, 32768, 340282366920938463463374607431768211456, 340282366920938463463374607431768211456]
loop x in xs:
    classify(x)
