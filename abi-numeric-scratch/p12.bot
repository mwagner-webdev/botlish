import abi
import abi::x86_64
fn classify(n: int):
    x = abi::i64(n):
        on AbiIntegerBelowRange:
            return "below"
        on AbiIntegerAboveRange:
            return "above"
    [x.value, abi::x86_64::from_i64(x).word]

xs = [0 - 9223372036854775809, 0 - 9223372036854775808, 0 - 9223372036854775807, 0 - 1, 0, 1, 0 - 4611686018427387904, 4611686018427387903, 9223372036854775806, 9223372036854775807, 9223372036854775808, 340282366920938463463374607431768211456, 340282366920938463463374607431768211456, 9223372036854775808, 0 - 9223372036854775809]
loop x in xs:
    classify(x)
