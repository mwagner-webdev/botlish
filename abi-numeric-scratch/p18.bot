import abi
import abi::x86_64
fn classify(n: int):
    x = abi::usize(n):
        on AbiIntegerBelowRange:
            return "below"
        on AbiIntegerAboveRange:
            return "above"
    [x.value, abi::x86_64::from_usize(x).word]

xs = [0 - 1, 0, 1, 0 - 1, 0, 1, 0, 9223372036854775807, 18446744073709551614, 18446744073709551615, 18446744073709551616, 340282366920938463463374607431768211456, 340282366920938463463374607431768211456, 9223372036854775807, 9223372036854775808, 9223372036854775809]
loop x in xs:
    classify(x)
