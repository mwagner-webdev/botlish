import abi
import abi::x86_64
fn classify(n: int):
    x = abi::i32(n):
        on AbiIntegerBelowRange:
            return "below"
        on AbiIntegerAboveRange:
            return "above"
    [x.value, abi::x86_64::from_i32(x).word]

xs = [0 - 2147483649, 0 - 2147483648, 0 - 2147483647, 0 - 1, 0, 1, 0 - 1073741824, 1073741823, 2147483646, 2147483647, 2147483648, 340282366920938463463374607431768211456, 340282366920938463463374607431768211456]
loop x in xs:
    classify(x)
