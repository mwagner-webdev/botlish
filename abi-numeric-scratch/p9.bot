import abi
import abi::x86_64
fn classify(n: int):
    x = abi::i8(n):
        on AbiIntegerBelowRange:
            return "below"
        on AbiIntegerAboveRange:
            return "above"
    [x.value, abi::x86_64::from_i8(x).word]

xs = [0 - 129, 0 - 128, 0 - 127, 0 - 1, 0, 1, 0 - 64, 63, 126, 127, 128, 340282366920938463463374607431768211456, 340282366920938463463374607431768211456]
loop x in xs:
    classify(x)
