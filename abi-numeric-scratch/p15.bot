import abi
import abi::x86_64
fn classify(n: int):
    x = abi::u32(n):
        on AbiIntegerBelowRange:
            return "below"
        on AbiIntegerAboveRange:
            return "above"
    [x.value, abi::x86_64::from_u32(x).word]

xs = [0 - 1, 0, 1, 0 - 1, 0, 1, 0, 2147483647, 4294967294, 4294967295, 4294967296, 340282366920938463463374607431768211456, 340282366920938463463374607431768211456]
loop x in xs:
    classify(x)
