# tree.bot -- the "std::tree" namespace: Order and walk, the depth-first
# (preorder) and breadth-first traversal of tree struct values
# (TREE-STRUCT-MILESTONE-1.md).
#
# A `tree struct` is a finite recursive value: an ordinary immutable struct
# whose one recursive field, its child field, is a List of values of its own
# type. `walk` traverses any tree struct's value by that field -- the
# declaration says which field it is, so no children callback is passed --
# and is an ordinary coroutine whose every segment hands over one node: the
# subtree value itself, of the tree's own type, never a handle, a cursor or a
# reference into the tree.
#
#     coroutine {step, first} = std::tree::walk(root, std::tree::Order::BreadthFirst)
#     visit(first)
#     loop:
#         if std::coroutine::done?(step):
#             break
#         visit(step())
#
# A tree has at least one node, its root: the first segment hands over the
# first node, each resume the next, and the last node is the coroutine's
# result (std::coroutine::done? is true once it is handed over).
#
#   DepthFirst    preorder: a node, then each of its children's subtrees,
#                 first child to last. A
#                                                ├─ B
#                                                │  ├─ D
#                                                │  └─ E
#                                                └─ C          is A B D E C.
#   BreadthFirst  every node at depth N before any at depth N + 1, and the
#                 children of each node in their order: A B C D E.
#
# Neither recursion nor the host's stack bounds a tree: the depth-first walk
# keeps the nodes still to visit on an explicit stack (at most the depth
# times the widest node's child count), the breadth-first walk a queue of the
# frontier, whose visited prefix is dropped as it grows (at most about twice
# the widest level). A tree is a tree by construction, so neither walk keeps
# a visited set: two equal subtrees are two occurrences, visited twice.
#
# The child field is read by the internal std::tree::children (core/tree.tcl),
# which the compiler resolves to the field of the walked tree's own type.
import std::list
import std::mutable_vector

# How a traversal orders a tree's nodes (std::tree::Order::DepthFirst,
# std::tree::Order::BreadthFirst).
enum Order:
    DepthFirst,
    BreadthFirst,

# The nodes of ROOT, a tree struct's value, in ORDER: a coroutine handing
# over each node (each subtree, root included, once per occurrence) in turn,
# the last one its result. Start it with
# `coroutine {step, first} = std::tree::walk(root, order)`.
nomethod fn walk(root, order: Order):
    breadth = order == Order::BreadthFirst
    # The nodes still to visit. Breadth-first, a queue: PENDING's elements
    # from position HEAD's one element on, in order. Depth-first, a stack:
    # all of PENDING's elements, the last one next.
    pending = std::mutable_vector::from_list([root])
    head = std::mutable_vector::from_list([0])
    loop:
        h = head.at(0):
            on IndexNotFound:
                0
        position = if breadth:
            h
        else:
            std::mutable_vector::length(pending) - 1
        # (Never empty here: a walk ends with the node it takes last.)
        node = pending.at(position):
            on IndexNotFound:
                return root
        kids = std::tree::children(node)
        done = if breadth:
            loop kid in kids:
                pending.push(kid)
            visited = h + 1
            remaining = std::mutable_vector::length(pending) - visited
            if remaining > 0 and visited >= 64 and visited >= remaining:
                # At least half the queue is visited: keep only the rest
                # (each node moves at most once per halving, so a walk
                # moves fewer nodes than it visits).
                rest = loop j from visited to std::mutable_vector::length(pending):
                    pending.at(j):
                        on IndexNotFound:
                            node
                pending.clear()
                loop kept in rest:
                    pending.push(kept)
                reset = head.swap(0, 0):
                    on IndexNotFound:
                        0
            else:
                previous = head.swap(0, visited):
                    on IndexNotFound:
                        0
            remaining == 0
        else:
            pending.pop():
                on IndexNotFound:
                    node
            loop i down from std::list::length(kids) - 1 through 0:
                kid = kids.at(i):
                    on IndexNotFound:
                        node
                pending.push(kid)
            std::mutable_vector::empty?(pending)
        if done:
            return node
        yield node
