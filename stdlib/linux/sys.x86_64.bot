# linux/sys.x86_64.bot -- namespace "std::linux::sys" on x86-64: the Linux x86-64
# syscall numbers and register convention under stdlib/linux.bot's wrappers
# (LINUX-SYSCALL-TRANSPORTS.md).
#
# std::linux::sys is an architecture-specific module: it has no stdlib/linux/sys.bot
# but this file and stdlib/linux/sys.aarch64.bot, and the compilation target's
# architecture selects the one that defines it (surface/modules.tcl's
# ModuleFile). Both files declare the same members with the same signatures
# (tests/linux-syscall.test pins it), so code above them -- linux, std::linux::io,
# io -- is one source on every architecture. What differs is all here, as
# ordinary Botlish data: which syscall number, which register carries which
# argument, and the architecture's register type and bridges.
#
#   std::linux::sys::write(fd, data)   write(2), SYS_write = 1: rdi = fd, rsi =
#                                 the address of data's payload, rdx = its
#                                 byte count. The raw signed rax as an Int.
#   std::linux::sys::read(fd, data)    read(2), SYS_read = 0: into a freshly
#                                 detached copy of DATA (rsi its address, rdx
#                                 its byte count); {result: the raw signed
#                                 rax, data: the copy as the kernel left it}.
#
# stdlib/linux.bot states the semantics (one syscall, the raw result, the
# logical copy); this file only performs them on x86-64.
#
# A direct module (DIRECT-MODULES.md): write and read call the raw transport,
# std::linux::abi::x86_64::syscall, for any descriptor, with no context -- raw
# process authority, which stdlib/linux.bot exposes as its explicit low-level
# layer and std::linux::io mediates through LinuxIO.
direct module

import std::abi
import std::abi::bytes
import std::abi::x86_64
import std::linux::abi::x86_64

# write(2): SYS_write = 1, rdi = fd, rsi = the address of data's payload,
# rdx = data's byte count.
fn write(fd: std::abi::I32, data: std::abi::bytes::Bytes) -> int:
    std::abi::x86_64::to_int(
        std::linux::abi::x86_64::syscall({
            rax: std::abi::x86_64::register64(1),
            rdi: std::abi::x86_64::from_i32(fd),
            rsi: std::abi::x86_64::from_bytes(data),
            rdx: std::abi::x86_64::from_usize(std::abi::bytes::length(data)),
        })
    )

# read(2): SYS_read = 0, rdi = fd, rsi = the address of the buffer's payload,
# rdx = the buffer's byte count. The kernel writes into `local`, the writable
# address bridge's operand: a freshly detached storage nothing else observes,
# returned as `data`.
fn read(fd: std::abi::I32, data: std::abi::bytes::MutableBytes):
    local = std::abi::bytes::detach(data)
    result = std::abi::x86_64::to_int(
        std::linux::abi::x86_64::syscall({
            rax: std::abi::x86_64::register64(0),
            rdi: std::abi::x86_64::from_i32(fd),
            rsi: std::abi::x86_64::from_mutable_bytes(local),
            rdx: std::abi::x86_64::from_usize(std::abi::bytes::mutable_length(local)),
        })
    )
    {result: result, data: local}

# openat(2): SYS_openat = 257, rdi = dirfd, rsi = the address of
# PATH's payload (a C string: stdlib/linux.bot builds it with its terminating
# NUL), rdx = flags, r10 = the creation mode. The raw signed result: the new
# descriptor, or -errno.
fn openat(dirfd: std::abi::I32, path: std::abi::bytes::Bytes, flags: std::abi::I32, mode: std::abi::U32) -> int:
    std::abi::x86_64::to_int(
        std::linux::abi::x86_64::syscall({
            rax: std::abi::x86_64::register64(257),
            rdi: std::abi::x86_64::from_i32(dirfd),
            rsi: std::abi::x86_64::from_bytes(path),
            rdx: std::abi::x86_64::from_i32(flags),
            r10: std::abi::x86_64::from_u32(mode),
        })
    )

# close(2): SYS_close = 3, rdi = fd. 0, or -errno.
fn close(fd: std::abi::I32) -> int:
    std::abi::x86_64::to_int(
        std::linux::abi::x86_64::syscall({
            rax: std::abi::x86_64::register64(3),
            rdi: std::abi::x86_64::from_i32(fd),
        })
    )

# getdents64(2): SYS_getdents64 = 217, rdi = fd, rsi = the
# address of a freshly detached copy of the buffer, rdx = its byte count. As
# read: {result: the raw signed result (bytes of linux_dirent64 records written,
# 0 at the end of the directory, or -errno), data: the copy as the kernel left
# it}.
fn getdents64(fd: std::abi::I32, data: std::abi::bytes::MutableBytes):
    local = std::abi::bytes::detach(data)
    result = std::abi::x86_64::to_int(
        std::linux::abi::x86_64::syscall({
            rax: std::abi::x86_64::register64(217),
            rdi: std::abi::x86_64::from_i32(fd),
            rsi: std::abi::x86_64::from_mutable_bytes(local),
            rdx: std::abi::x86_64::from_usize(std::abi::bytes::mutable_length(local)),
        })
    )
    {result: result, data: local}

# mkdirat(2): SYS_mkdirat = 258, rdi = dirfd, rsi = PATH (a C
# string), rdx = the mode. 0, or -errno.
fn mkdirat(dirfd: std::abi::I32, path: std::abi::bytes::Bytes, mode: std::abi::U32) -> int:
    std::abi::x86_64::to_int(
        std::linux::abi::x86_64::syscall({
            rax: std::abi::x86_64::register64(258),
            rdi: std::abi::x86_64::from_i32(dirfd),
            rsi: std::abi::x86_64::from_bytes(path),
            rdx: std::abi::x86_64::from_u32(mode),
        })
    )

# unlinkat(2): SYS_unlinkat = 263, rdi = dirfd, rsi = PATH (a C
# string), rdx = flags (AT_REMOVEDIR to remove a directory). 0, or -errno.
fn unlinkat(dirfd: std::abi::I32, path: std::abi::bytes::Bytes, flags: std::abi::I32) -> int:
    std::abi::x86_64::to_int(
        std::linux::abi::x86_64::syscall({
            rax: std::abi::x86_64::register64(263),
            rdi: std::abi::x86_64::from_i32(dirfd),
            rsi: std::abi::x86_64::from_bytes(path),
            rdx: std::abi::x86_64::from_i32(flags),
        })
    )

# O_DIRECTORY: 0200000 on x86_64 (open(2)'s flags are not all the same on
# every architecture: arm64 has its own O_DIRECTORY, O_NOFOLLOW, O_DIRECT and
# O_LARGEFILE, x86-64 the generic ones).
fn o_directory() -> std::abi::I32Value:
    65536

# O_NOFOLLOW: 0400000 on x86_64.
fn o_nofollow() -> std::abi::I32Value:
    131072
