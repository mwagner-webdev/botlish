# test.bot -- the "std::test" namespace: a golden test framework written as an
# ordinary Botlish library (GOLDEN-TEST-FRAMEWORK.md).
#
# A golden test runs an operation, observes its outcome, compares the
# outcome with an expected one, and records the comparison as data. There is
# no test syntax, no assertion, no test-only native and no hidden registry:
# a suite is an ordinary context value holding an ordinary MutableVector,
# registration is an ordinary call that pushes a deferred check into it, and
# the runner is an ordinary coroutine that runs the checks in registration
# order and yields their results.
#
#   import std::compiler
#   import std::test
#
#   fn register_arithmetic_tests():
#       fn adds() errors std::compiler::CompilerError:
#           static compile:
#               20 + 22
#       std::test::value("adds", 42, adds)
#       fn unbound() errors std::compiler::CompilerError:
#           static compile:
#               missing + 1
#       std::test::rejects("unbound", std::compiler::DiagnosticCode::Unbound, unbound)
#
#   with context std::test::suite()
#   register_arithmetic_tests()
#   std::test::report()     # ["PASS adds", "PASS unbound", "2 passed, 0 failed"]
#
# The suite. `std::test::suite()` is the value a program installs with `with
# context`: a Suite whose one field is the MutableVector of registered
# cases. The context value itself is an ordinary immutable struct, installed
# once like any context (entry program top level only, at most one per
# program, CONTEXTS.md); registration mutates the vector it holds
# (`suite.cases.push(...)`), never the binding -- the place model of
# MUTABLE-VECTOR.md. Calling a registration function where no suite is
# installed is the ordinary MISSING-CONTEXT.
#
# Registration. `std::test::case(name, check)` records a TestCase {name, run}
# whose `run` is a function value of the one uniform type
# Fn{args: [], return: Match}: registration stores it and never calls it.
# A function value is the deferred representation because Botlish
# coroutines start eagerly -- `coroutine {step, first} = f()` runs f to its
# first yield at once (COROUTINES.md 15) -- so storing a started coroutine
# would run the test while registering it. The value helpers below
# (`std::test::value`, `std::test::holds`, `std::test::rejects`, ...) wrap a test body into
# such a check while its concrete types are known: they call the body, turn
# the one error a body may complete with, std::compiler::CompilerError, into a
# mismatch, compare, and return a Match. A body is a function of no
# arguments whose only declared error is std::compiler::CompilerError: any other
# error the body may raise must be handled inside it (the compiler rejects
# the registration otherwise, at the call: the body's error set does not fit
# the parameter contract `Fn{args: [], return: any, errors:
# [std::compiler::CompilerError]}` the helper's code infers). Botlish has no
# catch-all handler, so this is how an arbitrary test outcome becomes data
# without one.
#
# Matchers. A Match is the verdict of one comparison, as data:
# {matched, expected, actual, detail}, the three texts saying what was
# expected, what was observed and anything further (a diagnostic's
# message). A mismatch is a value, never an error: a failing test does not
# stop the run. `std::test::equal` compares with `==`; `std::test::satisfies` applies
# a caller's predicate; `std::test::diagnostic` compares a rejected block's
# std::compiler::DiagnosticCode (never its message); `std::test::passed()` and
# `std::test::mismatch(...)` build verdicts for a custom check.
#
# Running. `std::test::run()` is the runner coroutine: started with
# `coroutine {step, first} = std::test::run()`, it runs one case per segment, in
# registration order, and sends that case's result as a one-element List;
# its last segment sends the empty List and completes. (A coroutine's yields
# and its return share one outward type and Botlish has no sum type with a
# payload, so "one more result" and "no more results" are a List of one
# result and the empty List: a batch of results.) Every start runs every
# registered case again: a suite may be run any number of times, each run
# calling each check exactly once. `std::test::results()` drains a run,
# `std::test::report()` formats it: one "PASS name" line per passing case, a
# "FAIL name" line and its indented "expected:", "actual:" and "detail:"
# lines per failing one, then "P passed, F failed".
#
# Text. An Int's text is std::int::to_string's (NUMERIC-TEXT-BOUNDARY-
# MILESTONE-1.md); a value's is this module's own (`describe`, slices of one
# table for its punctuation), and an enum has no String form (ENUMS.md), so
# `code_name` spells every std::compiler::DiagnosticCode case itself.
import std::compiler
import std::coroutine
import std::int
import std::list
import std::mutable_vector
import std::str

# ---------------------------------------------------------------------------
# Data

# The verdict of one comparison: whether the outcome matched, and the texts
# that explain it (empty when it matched).
struct Match:
    matched: bool
    expected: str
    actual: str
    detail: str

# The result of running one registered case.
struct TestResult:
    name: str
    passed: bool
    expected: str
    actual: str
    detail: str

# One registered case: its name and its deferred check, which runs the test
# and compares its outcome when called.
struct TestCase:
    name: str
    run: Fn{args: [], return: Match}

# The suite: the context a program installs. Its one field is the registered
# cases, in registration order. Exactly two functions declare it as their
# context parameter -- `case` (registration) and `registered` (the snapshot
# the runner reads) -- and every other function's requirement is derived:
# a context implements, structurally, any context trait whose operations its
# owner's functions with that context parameter spell (CONTEXT-TRAITS.md), so
# the fewer such functions, the fewer application traits the suite could
# satisfy by accident.
context struct Suite:
    cases: MutableVector[TestCase]

# The totals of a run.
struct Summary:
    total: int
    passed: int
    failed: int

# ---------------------------------------------------------------------------
# The suite and registration

# A new, empty suite, for `with context std::test::suite()`.
fn suite() -> Suite:
    Suite {cases: std::mutable_vector::from_list([])}

# Registers the case NAME, whose check is RUN: RUN is stored, not called.
# The low-level form every helper below uses, and the escape hatch for a
# test no helper fits. (nomethod: NAME is not a receiver.)
nomethod fn case(name: str, run: Fn{args: [], return: Match}, context suite: Suite) -> unit:
    suite.cases.push(TestCase {name: name, run: run})

# The registered cases, in registration order: a snapshot (a List), so
# nothing that runs later can change it.
fn registered(context suite: Suite) -> List[TestCase]:
    loop c in suite.cases:
        c

# How many cases are registered.
fn count() -> int:
    std::list::length(registered())

# ---------------------------------------------------------------------------
# Text

# The one-character String at INDEX of the table "\"[]": the quotation mark
# and the brackets.
fn glyph(index: int) -> str:
    text = "\"[]".substring(index, index + 1):
        on LowerUnderrun:
            ""
        on UpperOverrun:
            ""
    text

fn no_texts() -> MutableVector[str]:
    std::mutable_vector::from_list([])

# PARTS joined by SEPARATOR. Iterative (a one-element vector holds the text
# so far: bindings are immutable), so a long List or String costs no stack.
fn joined(parts: List[str], separator: str) -> str:
    text = no_texts()
    loop part in parts and k from 0 to std::list::length(parts):
        sofar = text.pop():
            on IndexNotFound:
                ""
        if k == 0:
            text.push(part)
        else:
            text.push(sofar.concat(separator).concat(part))
    whole = text.pop():
        on IndexNotFound:
            ""
    whole

# The Botlish escape of the character C, or "" when it needs none.
fn escape_of(c: UnicodeChar) -> str:
    if c == '"':
        "\\\""
    elif c == '\\':
        "\\\\"
    elif c == '\n':
        "\\n"
    elif c == '\t':
        "\\t"
    elif c == '\r':
        "\\r"
    else:
        ""

# TEXT with every quotation mark, backslash, newline, tab and carriage return
# written as its Botlish escape.
fn escaped(text: str) -> str:
    pieces = loop i from 0 to std::str::length(text):
        c = text.char_at(i):
            on IndexNotFound:
                continue
        escape = c.escape_of()
        if escape != "":
            escape
        else:
            one = text.substring(i, i + 1):
                on LowerUnderrun:
                    ""
                on UpperOverrun:
                    ""
            one
    pieces.joined("")

# TEXT as a Botlish String literal.
fn quoted(text: str) -> str:
    mark = 0.glyph()
    mark.concat(text.escaped()).concat(mark)

# The lines of TEXT: its pieces between newline characters (one piece, TEXT
# itself, when it has none).
fn text_lines(text: str) -> List[str]:
    length = std::str::length(text)
    breaks = loop i from 0 to length:
        c = text.char_at(i):
            on IndexNotFound:
                continue
        if c != '\n':
            continue
        i
    count = std::list::length(breaks)
    loop k from 0 through count:
        start = if k == 0:
            0
        else:
            previous = std::list::at(breaks, k - 1):
                on IndexNotFound:
                    length
            previous + 1
        end = breaks.get(k, length)
        piece = text.substring(start, end):
            on LowerUnderrun:
                ""
            on UpperOverrun:
                ""
        piece

# Whether FRAGMENT occurs in TEXT (the empty fragment occurs everywhere).
fn contains_text?(text: str, fragment: str) -> bool:
    n = std::str::length(text)
    k = std::str::length(fragment)
    loop i from 0 through n - k:
        piece = text.substring(i, i + k):
            on LowerUnderrun:
                continue
            on UpperOverrun:
                continue
        if piece == fragment:
            return true
    false

# A value whose static type `describe` must not keep (see there).
struct Erased:
    value: any

# The text of a value for a report: an Int, a String (as a literal), a Bool
# or a List of those, written as Botlish source writes them; any other value
# (a struct, an enum case, a function) as a placeholder -- there is no
# reflection to take one apart, and a test that compares such values and
# wants them shown writes a custom check. The value goes through an `any`
# field first: describe's instance for an Int argument otherwise checks the
# string? branch's calls with the argument still typed int (a semantic-
# instance check does not narrow under a type test it decides false;
# GOLDEN-TEST-FRAMEWORK.md, "Compiler findings").
fn describe(original) -> str:
    v = Erased {value: original}.value
    if integer?(v):
        std::int::to_string(v)
    elif string?(v):
        v.quoted()
    elif v == true:
        "true"
    elif v == false:
        "false"
    elif list?(v):
        parts = loop x in v:
            x.describe()
        1.glyph().concat(parts.joined(", ")).concat(2.glyph())
    else:
        "a value with no text form"

# The name of a std::compiler::DiagnosticCode case, as stdlib/compiler.bot spells it.
fn code_name(code: std::compiler::DiagnosticCode) -> str:
    codes = [
        std::compiler::DiagnosticCode::AffineCaptureUnsupported,
        std::compiler::DiagnosticCode::AffineContainerUnsupported,
        std::compiler::DiagnosticCode::AffineContextCopyOut,
        std::compiler::DiagnosticCode::AffineDuplicationUnsupported,
