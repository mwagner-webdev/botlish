        std::compiler::DiagnosticCode::AffineGenericNestedUnsupported,
        std::compiler::DiagnosticCode::AffineInstanceBudget,
        std::compiler::DiagnosticCode::AffineListOperationUnsupported,
        std::compiler::DiagnosticCode::AffineNotDefinitelyLive,
        std::compiler::DiagnosticCode::AffinePathReleaseUnsupported,
        std::compiler::DiagnosticCode::AffineTemporaryUnsupported,
        std::compiler::DiagnosticCode::AmbiguousContextImplementation,
        std::compiler::DiagnosticCode::AmbiguousMethodCall,
        std::compiler::DiagnosticCode::AmbiguousQualifier,
        std::compiler::DiagnosticCode::Arity,
        std::compiler::DiagnosticCode::BinaryOperand,
        std::compiler::DiagnosticCode::BreakOutsideLoop,
        std::compiler::DiagnosticCode::ContextBindingCollision,
        std::compiler::DiagnosticCode::ContextFunctionValue,
        std::compiler::DiagnosticCode::ContextInstallationUnsupported,
        std::compiler::DiagnosticCode::ContextTraitMisuse,
        std::compiler::DiagnosticCode::ContextTraitPosition,
        std::compiler::DiagnosticCode::ContinueOutsideLoop,
        std::compiler::DiagnosticCode::CoroutineContract,
        std::compiler::DiagnosticCode::CoroutineNotFunction,
        std::compiler::DiagnosticCode::CoroutineResultMismatch,
        std::compiler::DiagnosticCode::CoroutineResumeArity,
        std::compiler::DiagnosticCode::CoroutineResumeConflict,
        std::compiler::DiagnosticCode::CoroutineResumeType,
        std::compiler::DiagnosticCode::CoroutineResumeUnderconstrained,
        std::compiler::DiagnosticCode::CoroutineRhsNotYielding,
        std::compiler::DiagnosticCode::DecimalGuaranteeLost,
        std::compiler::DiagnosticCode::DecimalPrecision,
        std::compiler::DiagnosticCode::Direct,
        std::compiler::DiagnosticCode::DirectCallableValue,
        std::compiler::DiagnosticCode::Duplicate,
        std::compiler::DiagnosticCode::DuplicateContextParameter,
        std::compiler::DiagnosticCode::DuplicateField,
        std::compiler::DiagnosticCode::DuplicateFlag,
        std::compiler::DiagnosticCode::DuplicateFlagDeclaration,
        std::compiler::DiagnosticCode::DuplicateLoopVariable,
        std::compiler::DiagnosticCode::ExportEnvironment,
        std::compiler::DiagnosticCode::ExportName,
        std::compiler::DiagnosticCode::ExportPlacement,
        std::compiler::DiagnosticCode::ExportSignature,
        std::compiler::DiagnosticCode::FlagBindingCollision,
        std::compiler::DiagnosticCode::FlagCalleeUnknown,
        std::compiler::DiagnosticCode::FlagFunctionValue,
        std::compiler::DiagnosticCode::ForeignBorrow,
        std::compiler::DiagnosticCode::Imprint,
        std::compiler::DiagnosticCode::InternalIntrinsicValue,
        std::compiler::DiagnosticCode::InternalNamespace,
        std::compiler::DiagnosticCode::KnownError,
        std::compiler::DiagnosticCode::LayoutArrayExtent,
        std::compiler::DiagnosticCode::LayoutArrayIndex,
        std::compiler::DiagnosticCode::LayoutForeignWrite,
        std::compiler::DiagnosticCode::LayoutNativeOnly,
        std::compiler::DiagnosticCode::LayoutNotAType,
        std::compiler::DiagnosticCode::LayoutNotAValue,
        std::compiler::DiagnosticCode::LayoutOperand,
        std::compiler::DiagnosticCode::LayoutStructParameter,
        std::compiler::DiagnosticCode::LayoutUnion,
        std::compiler::DiagnosticCode::LockstepUnequal,
        std::compiler::DiagnosticCode::LockstepUnproven,
        std::compiler::DiagnosticCode::MissingContext,
        std::compiler::DiagnosticCode::MissingErrorPayload,
        std::compiler::DiagnosticCode::MissingField,
        std::compiler::DiagnosticCode::MissingImport,
        std::compiler::DiagnosticCode::ModuleContext,
        std::compiler::DiagnosticCode::ModuleImmutable,
        std::compiler::DiagnosticCode::MutablePlaceCapture,
        std::compiler::DiagnosticCode::MutablePlaceReceiver,
        std::compiler::DiagnosticCode::NoApplicableMethod,
        std::compiler::DiagnosticCode::NomethodCall,
        std::compiler::DiagnosticCode::NotAContext,
        std::compiler::DiagnosticCode::NotAStruct,
        std::compiler::DiagnosticCode::NotAnEnum,
        std::compiler::DiagnosticCode::OpaqueConstruction,
        std::compiler::DiagnosticCode::OpaqueRepresentation,
        std::compiler::DiagnosticCode::PrivateAccess,
        std::compiler::DiagnosticCode::ProofClause,
        std::compiler::DiagnosticCode::RefinementMintAuthority,
        std::compiler::DiagnosticCode::RefinementParameter,
        std::compiler::DiagnosticCode::ReorderNotProven,
        std::compiler::DiagnosticCode::ResourceDeclaration,
        std::compiler::DiagnosticCode::ReturnOutsideCallable,
        std::compiler::DiagnosticCode::TraitImplOrder,
        std::compiler::DiagnosticCode::TraitInstanceBudget,
        std::compiler::DiagnosticCode::TraitNestedPolymorphic,
        std::compiler::DiagnosticCode::TraitNotSatisfied,
        std::compiler::DiagnosticCode::TraitPolymorphicFunctionValue,
        std::compiler::DiagnosticCode::TraitPolymorphicRecursion,
        std::compiler::DiagnosticCode::TraitStorageUnsupported,
        std::compiler::DiagnosticCode::TraitUnknownOperation,
        std::compiler::DiagnosticCode::TraitViewMisuse,
        std::compiler::DiagnosticCode::TraitWitnessJoin,
        std::compiler::DiagnosticCode::Type,
        std::compiler::DiagnosticCode::Unbound,
        std::compiler::DiagnosticCode::UndeclaredError,
        std::compiler::DiagnosticCode::UnexpectedErrorPayload,
        std::compiler::DiagnosticCode::UnhandledError,
        std::compiler::DiagnosticCode::UnknownEnumCase,
        std::compiler::DiagnosticCode::UnknownField,
        std::compiler::DiagnosticCode::UnknownFlag,
        std::compiler::DiagnosticCode::UnknownLayout,
        std::compiler::DiagnosticCode::UnknownNamespace,
        std::compiler::DiagnosticCode::UnknownStruct,
        std::compiler::DiagnosticCode::UnknownSymbol,
        std::compiler::DiagnosticCode::UnprovenField,
        std::compiler::DiagnosticCode::UnwrappedYield,
        std::compiler::DiagnosticCode::UseAfterMove,
        std::compiler::DiagnosticCode::YieldOutsideFunction,
    ]
    names = [
        "AffineCaptureUnsupported",
        "AffineContainerUnsupported",
        "AffineContextCopyOut",
        "AffineDuplicationUnsupported",
        "AffineElementCopyOut",
        "AffineEqualityUnsupported",
        "AffineErasureUnsupported",
        "AffineFieldMoveRequiresDestructure",
        "AffineGenericNestedUnsupported",
        "AffineInstanceBudget",
        "AffineListOperationUnsupported",
        "AffineNotDefinitelyLive",
        "AffinePathReleaseUnsupported",
        "AffineTemporaryUnsupported",
        "AmbiguousContextImplementation",
        "AmbiguousMethodCall",
        "AmbiguousQualifier",
        "Arity",
        "BinaryOperand",
        "BreakOutsideLoop",
        "ContextBindingCollision",
        "ContextFunctionValue",
        "ContextInstallationUnsupported",
        "ContextTraitMisuse",
        "ContextTraitPosition",
        "ContinueOutsideLoop",
        "CoroutineContract",
        "CoroutineNotFunction",
        "CoroutineResultMismatch",
        "CoroutineResumeArity",
        "CoroutineResumeConflict",
        "CoroutineResumeType",
        "CoroutineResumeUnderconstrained",
        "CoroutineRhsNotYielding",
        "DecimalGuaranteeLost",
        "DecimalPrecision",
        "Direct",
        "DirectCallableValue",
        "Duplicate",
        "DuplicateContextParameter",
        "DuplicateField",
        "DuplicateFlag",
        "DuplicateFlagDeclaration",
        "DuplicateLoopVariable",
        "ExportEnvironment",
        "ExportName",
        "ExportPlacement",
        "ExportSignature",
        "FlagBindingCollision",
        "FlagCalleeUnknown",
        "FlagFunctionValue",
        "ForeignBorrow",
        "Imprint",
        "InternalIntrinsicValue",
        "InternalNamespace",
        "KnownError",
        "LayoutArrayExtent",
        "LayoutArrayIndex",
        "LayoutForeignWrite",
        "LayoutNativeOnly",
        "LayoutNotAType",
        "LayoutNotAValue",
        "LayoutOperand",
        "LayoutStructParameter",
        "LayoutUnion",
        "LockstepUnequal",
        "LockstepUnproven",
        "MissingContext",
        "MissingErrorPayload",
        "MissingField",
        "MissingImport",
        "ModuleContext",
        "ModuleImmutable",
        "MutablePlaceCapture",
        "MutablePlaceReceiver",
        "NoApplicableMethod",
        "NomethodCall",
        "NotAContext",
        "NotAStruct",
        "NotAnEnum",
        "OpaqueConstruction",
        "OpaqueRepresentation",
        "PrivateAccess",
        "ProofClause",
        "RefinementMintAuthority",
        "RefinementParameter",
        "ReorderNotProven",
        "ResourceDeclaration",
        "ReturnOutsideCallable",
        "TraitImplOrder",
        "TraitInstanceBudget",
        "TraitNestedPolymorphic",
        "TraitNotSatisfied",
        "TraitPolymorphicFunctionValue",
        "TraitPolymorphicRecursion",
        "TraitStorageUnsupported",
        "TraitUnknownOperation",
        "TraitViewMisuse",
        "TraitWitnessJoin",
        "Type",
        "Unbound",
        "UndeclaredError",
        "UnexpectedErrorPayload",
        "UnhandledError",
        "UnknownEnumCase",
        "UnknownField",
        "UnknownFlag",
        "UnknownLayout",
        "UnknownNamespace",
        "UnknownStruct",
        "UnknownSymbol",
        "UnprovenField",
        "UnwrappedYield",
        "UseAfterMove",
        "YieldOutsideFunction",
    ]
    found = loop c in codes and name in names:
        if c != code:
            continue
        name
    first = std::list::at(found, 0):
        on IndexNotFound:
            "a DiagnosticCode this module does not name"
    first

# A rejected block's diagnostic, for a report: its code and where it is.
fn diagnostic_text(code: std::compiler::DiagnosticCode, primary: std::compiler::SourceLocation) -> str:
    "compiler diagnostic ".concat(code.code_name()).concat(" at line ").concat(primary.line.to_string()).concat(", column ").concat(primary.column.to_string())

# ---------------------------------------------------------------------------
# Matchers

# The verdict of a comparison that matched.
fn passed() -> Match:
    Match {matched: true, expected: "", actual: "", detail: ""}

# The verdict of a comparison that did not match: what was EXPECTED, what
# was observed (ACTUAL), and any further DETAIL ("" for none). (nomethod:
# three texts of equal standing, none a receiver.)
nomethod fn mismatch(expected: str, actual: str, detail: str) -> Match:
    Match {matched: false, expected: expected, actual: actual, detail: detail}

# ACTUAL against the golden value EXPECTED, by `==`.
fn equal(expected, actual) -> Match:
    if actual == expected:
        passed()
    else:
        mismatch(expected.describe(), actual.describe(), "")

# ACTUAL against PREDICATE, a function of one argument returning a Bool;
# DESCRIPTION says what the predicate expects, for the report.
fn satisfies(actual, description: str, predicate) -> Match:
    if predicate(actual):
        passed()
    else:
        mismatch(description, actual.describe(), "")

# An observed rejection -- CODE at PRIMARY, with MESSAGE -- against the
# EXPECTED diagnostic code. The message is reported, never compared.
fn diagnostic(expected: std::compiler::DiagnosticCode, code: std::compiler::DiagnosticCode, primary: std::compiler::SourceLocation, message: str) -> Match:
    if code == expected:
        passed()
    else:
        mismatch("compiler diagnostic ".concat(expected.code_name()), code.diagnostic_text(primary), message)

# ---------------------------------------------------------------------------
# Registration helpers: a body and an expected outcome, as one case
#
# BODY is a function of no arguments whose only declared error is
# std::compiler::CompilerError, normally a `static compile:` block around the code
# under test. Every helper is nomethod: its first argument is the case's
# name, not a receiver.

# BODY's value must equal EXPECTED.
nomethod fn value(name: str, expected, body) -> unit:
    fn check() -> Match:
        actual = body():
            on std::compiler::CompilerError {code, primary, message}:
                return mismatch(expected.describe(), code.diagnostic_text(primary), message)
        expected.equal(actual)
    case(name, check)

# BODY's value must satisfy PREDICATE (see `satisfies`).
nomethod fn holds(name: str, description: str, predicate, body) -> unit:
    fn check() -> Match:
        actual = body():
            on std::compiler::CompilerError {code, primary, message}:
                return mismatch(description, code.diagnostic_text(primary), message)
        actual.satisfies(description, predicate)
    case(name, check)

# BODY's block must be rejected with diagnostic code EXPECTED.
nomethod fn rejects(name: str, expected: std::compiler::DiagnosticCode, body) -> unit:
    fn check() -> Match:
        actual = body():
            on std::compiler::CompilerError {code, primary, message}:
                return expected.diagnostic(code, primary, message)
        mismatch("compiler diagnostic ".concat(expected.code_name()), "value ".concat(actual.describe()), "")
    case(name, check)

# BODY's block must be rejected with diagnostic code EXPECTED, reported at
# LINE and COLUMN of the suite's source file.
nomethod fn rejects_at(name: str, expected: std::compiler::DiagnosticCode, line: int, column: int, body) -> unit:
    fn check() -> Match:
        wanted = expected.diagnostic_text(std::compiler::SourceLocation {line: line, column: column})
        actual = body():
            on std::compiler::CompilerError {code, primary, message}:
                if code == expected and primary.line == line and primary.column == column:
                    return passed()
                return mismatch(wanted, code.diagnostic_text(primary), message)
        mismatch(wanted, "value ".concat(actual.describe()), "")
    case(name, check)

# BODY's block must be rejected, with any diagnostic.
nomethod fn rejects_any(name: str, body) -> unit:
    fn check() -> Match:
        actual = body():
            on std::compiler::CompilerError:
                return passed()
        mismatch("a compiler diagnostic", "value ".concat(actual.describe()), "")
    case(name, check)

# BODY's block must be rejected with diagnostic code EXPECTED and exactly the
# message WANTED: for a test whose property is the diagnostic's wording (a
# call chain, a name the message alone carries). Messages are otherwise
# reported, never compared. (Promoted from the suite-local matchers four
# suites wrote independently: LARGE-SCALE-GOLDEN-MIGRATION.md.)
nomethod fn rejects_message(name: str, expected: std::compiler::DiagnosticCode, wanted: str, body) -> unit:
    fn check() -> Match:
        shown = "compiler diagnostic ".concat(expected.code_name()).concat(" with the message ").concat(wanted.quoted())
        actual = body():
            on std::compiler::CompilerError {code, primary, message}:
                if code == expected and message == wanted:
                    return passed()
                return mismatch(shown, code.diagnostic_text(primary), message)
        mismatch(shown, "value ".concat(actual.describe()), "")
    case(name, check)

# BODY's block must be rejected with diagnostic code EXPECTED and a message
# containing FRAGMENT (see `rejects_message`).
nomethod fn rejects_containing(name: str, expected: std::compiler::DiagnosticCode, fragment: str, body) -> unit:
    fn check() -> Match:
        shown = "compiler diagnostic ".concat(expected.code_name()).concat(" with a message containing ").concat(fragment.quoted())
        actual = body():
            on std::compiler::CompilerError {code, primary, message}:
                if code == expected and message.contains_text?(fragment):
                    return passed()
                return mismatch(shown, code.diagnostic_text(primary), message)
        mismatch(shown, "value ".concat(actual.describe()), "")
    case(name, check)

# ---------------------------------------------------------------------------
# Running

# The runner coroutine: one case per segment, in registration order, each
# segment sending that case's result as a one-element List; the last
# segment sends the empty List. Start it with
# `coroutine {step, first} = std::test::run()` and resume it with `step()`.
fn run() -> List[TestResult]:
    loop c in registered():
        m = (c.run)()
        yield [TestResult {name: c.name, passed: m.matched, expected: m.expected, actual: m.actual, detail: m.detail}]
    return []

fn no_results() -> MutableVector[TestResult]:
    std::mutable_vector::from_list([])

# Runs the suite once: every case's result, in registration order.
fn results() -> List[TestResult]:
    coroutine {step, first} = run()
    collected = no_results()
    loop r in first:
        collected.push(r)
    loop:
        if std::coroutine::done?(step):
            break
        batch = step()
        loop r in batch:
            collected.push(r)
    loop r in collected:
        r

# The totals of RESULTS.
fn summarize(results: List[TestResult]) -> Summary:
    passing = loop r in results:
        if not r.passed:
            continue
        r
    total = std::list::length(results)
    Summary {total: total, passed: std::list::length(passing), failed: total - std::list::length(passing)}

# The report lines of one result: "PASS name", or "FAIL name" and what was
# expected, what was observed and the detail, if any.
fn result_lines(result: TestResult) -> List[str]:
    lines = no_texts()
    if result.passed:
        lines.push("PASS ".concat(result.name))
    else:
        lines.push("FAIL ".concat(result.name))
        lines.push("  expected: ".concat(result.expected))
        lines.push("  actual: ".concat(result.actual))
        if result.detail != "":
            # A diagnostic's message may span lines: its continuation lines
            # are indented, so every report line that starts a result starts
            # with PASS or FAIL.
            pieces = result.detail.text_lines()
            loop piece in pieces and k from 0 to std::list::length(pieces):
                if k == 0:
                    lines.push("  detail: ".concat(piece))
                else:
                    lines.push("    ".concat(piece))

    loop line in lines:
        line

# "P passed, F failed".
fn summary_line(summary: Summary) -> str:
    summary.passed.to_string().concat(" passed, ").concat(summary.failed.to_string()).concat(" failed")

# Runs the suite once and returns its report: every result's lines, in
# registration order, then the summary line. A run that reports a different
# number of results than there are registered cases is itself a failure,
# reported as one more failed line ("FAIL the run"): the runner is ordinary
# Botlish over an ordinary coroutine, and a fault below it (a coroutine that
# lost a segment) must not shorten a report silently.
fn report() -> List[str]:
    all = results()
    lines = no_texts()
    loop r in all:
        loop line in r.result_lines():
            lines.push(line)
    summary = all.summarize()
    registered = count()
    if summary.total == registered:
        lines.push(summary.summary_line())
    else:
        lines.push("FAIL the run")
        lines.push("  expected: ".concat(registered.to_string()).concat(" results, one per registered case"))
        lines.push("  actual: ".concat(summary.total.to_string()).concat(" results"))
        lines.push(Summary {total: summary.total + 1, passed: summary.passed, failed: summary.failed + 1}.summary_line())
    loop line in lines:
        line
