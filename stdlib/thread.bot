# thread.bot -- the "std::thread" namespace: Botlish-owned OS threads, each
# running an independently initialized VM of the same program
# (BOTLISH-OWNED-THREADS-AND-CROSS-THREAD-ACTORS-MILESTONE-1.md).
#
#   # worker.bot -- a module
#   thread fn crunch(n: int) -> int:             a thread entry
#       fib(n)
#
#   # main.bot
#   import std::thread
#   import worker
#   with context std::thread::create(4)          the authority to start threads
#   s = std::thread::start(std::thread::entry(worker::crunch), 30)
#   std::thread::join(s.thread)                  832040, from the other VM
#
# A THREAD is an OS thread with its own native stack and stack-overflow
# guard, running one VM: its own heap and collector, module statics,
# installed contexts and roots, made on that thread from the program's one
# compiled image. A thread runs one THREAD ENTRY (`thread fn` in a module,
# hir/threads.tcl): the runtime initializes the VM's module statics, copies
# the start's initialization value into it (std::transfer: the value is
# rebuilt there, nothing of the starting VM is kept), runs the entry -- which
# installs the contexts the thread needs, in its own body -- and copies its
# result back for whoever joins it. A thread never has its creator's
# contexts: they belong to another VM. The program's selection of each
# context trait is the same for every entry (CONTEXT-TRAIT-SELECTION-
# CONFLICT); each VM installs its own instance.
#
# AUTHORITY. Starting a thread needs the installed context Threads
# (std::thread::create), which an entry installs and restricted injection
# can withhold (`inject no context:` code cannot start one). Everything else
# here takes the value that names a thread: the affine join right
# Thread[R] (one owner: whoever may collect the outcome), or the
# unrestricted ThreadId (status, stop requests, bounded waits).
#
# LIFECYCLE. A thread is Starting, then Running, then ends Returned (its
# entry completed: the value is kept for join), Stopped (it completed after
# a stop was requested: likewise), Failed (its entry failed: the error's
# identity and message are kept) or StartFailed (no VM could start: the
# reason is kept). Its outcome stays until join collects it -- dropping the
# Thread without joining detaches it: its outcome is then dropped when it
# ends, and counted (stats). Stopping is cooperative: request_stop sets a
# flag the thread reads (stop_requested) and wakes its port (std::actor::
# remote serves it), never interrupts it; nothing kills a thread. When the
# program's main VM completes, every thread still running is asked to stop
# and joined before the program's image is released.
#
# WAITING. join and await_end block the calling OS thread (a bounded
# await_end returns false when the thread has not ended; it never ends the
# thread). Code on an event loop waits without blocking its thread with
# wait_end (std::actor::remote's port: the runtime wakes the loop when the
# thread ends).
#
# LIMITS. At most 64 threads run guarded at once in a process -- the
# stack-overflow guard's table (PER-THREAD-RUNTIME-STATE-MILESTONE-1.md),
# the main thread's included -- and a start reserves its guard record before
# the thread exists: a start beyond it is ThreadLimit, never an unguarded
# thread. A native stack overflow on any thread ends the process (NATIVE
# LIMIT STACK), as on the main thread: no thread-only recovery.
#
# Native backends only: the Tcl backends refuse a program that starts a
# thread (THREAD-UNAVAILABLE), at compile time.
import std::abi::bytes
import std::ffi::c
import std::int
import std::str
import std::transfer

# No thread can start now: the Threads context's own limit, or every
# stack-overflow guard record of the process is in use.
error ThreadLimit

# A thread could not start: the operating system refused the thread, or
# its VM could not be made or initialized (REASON says which).
error ThreadStartFailed:
    reason: str

# The thread's entry failed: IDENTITY is the identity of its error (a
# declared error's canonical name, or the runtime failure's code), MESSAGE
# its text.
error ThreadFailed:
    identity: str
    message: str

# A thread's lifecycle state (status).
enum Status:
    Starting,
    Running,
    Returned,
    Stopped,
    Failed,
    StartFailed,
    Gone,

# The authority to start threads: at most LIMIT of this context's own at
# once (a further start is ThreadLimit), whatever else the process runs.
opaque context struct Threads:
    limit: Limit

# How many threads one Threads context may run at once.
type Limit = Int in 1..4096

# A thread entry, by its index among the program's entries and its name:
# what std::thread::entry(NAME) makes (a constant). I is its
# initialization value's type, R its result's.
opaque struct Entry[I satisfies Sendable, R satisfies Sendable]:
    index: int
    name: str

# An affine token that owns nothing (a null C pointer no C call ever
# receives): it makes a Thread movable but not copyable, as
# std::io::fs::Owner makes a File.
private opaque struct Right:
    marker: std::ffi::c::Ptr[std::ffi::c::Void]

# The join right of one thread whose entry returns an R: affine, one owner.
opaque struct Thread[R satisfies Sendable]:
    id: int
    right: Right

# The identity of one thread: copyable; it names the thread for status,
# stop requests and waits, never for its outcome.
opaque struct ThreadId:
    id: int

# What start makes: the join right and the identity.
struct Started[R satisfies Sendable]:
    thread: Thread[R]
    id: ThreadId

# The process's thread counters (stats).
struct Stats:
    started: int
    running: int
    ended: int
    joined: int
    detached: int
    start_failures: int
    limit_refusals: int

# The default size of a thread's native stack: 64 MiB of address space
# (reserved, committed as it is used).
private default_stack = 67108864

# Codes of rt_status (native/src/runtime/thread.rs).
private st_starting = 0
private st_running = 1
private st_returned = 2
private st_stopped = 3
private st_failed = 4
private st_start_failed = 5
private st_gone = -1

# The authority to start at most LIMIT (at least 1) threads at once.
fn create(limit: int) -> Threads:
    bounded = if limit < 1:
        1
    elif limit > 4096:
        4096
    else:
        limit
    Threads {limit: bounded}

private nomethod fn status_of(code: int) -> Status:
    if code == st_starting:
        Status::Starting
    elif code == st_running:
        Status::Running
    elif code == st_returned:
        Status::Returned
    elif code == st_stopped:
        Status::Stopped
    elif code == st_failed:
        Status::Failed
    elif code == st_start_failed:
        Status::StartFailed
    else:
        Status::Gone

# 1 if status CODE is an ended thread's.
private nomethod fn ended?(code: int) -> bool:
    code == st_returned or code == st_stopped or code == st_failed or code == st_start_failed or code == st_gone

# Start a thread running entry E with the initialization value INIT (copied
# into the thread's VM), on a native stack of 64 MiB (start_sized: of STACK
# bytes, at least 1 MiB). ThreadLimit when this authority's limit, or the
# process's guard records, are exhausted; ThreadStartFailed when the
# operating system refuses the thread. A thread whose VM cannot start is
# StartFailed, which join reports.
# The runtime's start of entry E with INIT on a STACK-byte stack (at least
# 1 MiB): the thread's id, or -1 (no guard record) or -2 - errno.
private nomethod fn spawn(e: Entry[I, R], init: I, stack: int) -> int:
    data = std::transfer::encode(init)
    size = if stack < 1048576:
        1048576
    else:
        stack
    std::thread::rt_spawn(e.index, e.name, data, size)

nomethod fn start_sized(e: Entry[I, R], init: I, stack: int, context t: Threads) -> Started[R] errors ThreadLimit, ThreadStartFailed:
    # (This VM's own threads still running: one Threads context per VM.)
    id = if std::thread::rt_stat(8) >= t.limit:
        -1
    else:
        spawn(e, init, stack)
    if id == -1:
        fail ThreadLimit
    if id < 0:
        fail ThreadStartFailed {reason: "the operating system could not start a thread (errno ".concat(std::int::to_string(-2 - id)).append_char(')')}
    Started[R] {thread: Thread[R] {id: id, right: Right {marker: std::ffi::c::null[std::ffi::c::Void]()}}, id: ThreadId {id: id}}

nomethod fn start(e: Entry[I, R], init: I, context t: Threads) -> Started[R] errors ThreadLimit, ThreadStartFailed:
    start_sized(e, init, default_stack)

# THREAD's lifecycle state.
nomethod fn status(thread: ThreadId) -> Status:
    status_of(std::thread::rt_status(thread.id))

# Ask THREAD to stop: its stop_requested() answers true from now on and its
# port is woken (std::actor::remote). True when the thread had not ended.
nomethod fn request_stop(thread: ThreadId) -> bool:
    std::thread::rt_stop(thread.id) == 1

# Whether this thread was asked to stop (false on the main thread).
fn stop_requested?() -> bool:
    std::thread::rt_stop_requested() == 1

# Blocks this OS thread until THREAD has ended or TIMEOUT microseconds have
# passed (TIMEOUT < 0: no bound): whether it ended. A false answer means the
# thread is still running -- nothing was done to it.
nomethod fn await_end(thread: ThreadId, timeout: int) -> bool:
    ended?(std::thread::rt_await(thread.id, timeout))

# THREAD's result: blocks this OS thread until it ends, then collects its
# outcome -- its entry's value, copied into this VM -- and releases it.
# ThreadFailed with the entry's error, ThreadStartFailed when it never
# started. (On an event loop, wait_end first: join then does not block.)
nomethod fn join(thread: Thread[R]) -> R errors ThreadFailed, ThreadStartFailed:
    {id, right} = thread
    code = std::thread::rt_await(id, -1)
    if code == st_failed:
        identity = std::thread::rt_error(id)
        message = std::thread::rt_error_message(id)
        std::thread::rt_release(id)
        fail ThreadFailed {identity: identity, message: message}
    if code == st_start_failed:
        reason = std::thread::rt_error_message(id)
        std::thread::rt_release(id)
        fail ThreadStartFailed {reason: reason}
    if code == st_gone:
        fail ThreadFailed {identity: "ThreadGone", message: "the thread's outcome was already collected"}
    data = std::thread::rt_result(id)
    std::thread::rt_release(id)
    std::transfer::decode[R](data):
        on TransferMalformed:
            fail ThreadFailed {identity: "TransferMalformed", message: "the thread's result could not be copied into this VM"}
        on TransferVersion:
            fail ThreadFailed {identity: "TransferVersion", message: "the thread's result could not be copied into this VM"}
        on TransferTypeMismatch:
            fail ThreadFailed {identity: "TransferTypeMismatch", message: "the thread's result could not be copied into this VM"}
        on TransferInvalidValue:
            fail ThreadFailed {identity: "TransferInvalidValue", message: "the thread's result could not be copied into this VM"}
        on TransferLimit:
            fail ThreadFailed {identity: "TransferLimit", message: "the thread's result could not be copied into this VM"}

# How many more threads the process can run guarded now (its free
# stack-overflow guard records).
fn capacity() -> int:
    std::thread::rt_capacity()

# The process's thread counters.
fn stats() -> Stats:
    Stats {
        started: std::thread::rt_stat(0), running: std::thread::rt_stat(1), ended: std::thread::rt_stat(2),
        joined: std::thread::rt_stat(3), detached: std::thread::rt_stat(4),
        start_failures: std::thread::rt_stat(5), limit_refusals: std::thread::rt_stat(6)
    }
