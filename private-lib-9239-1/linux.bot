# linux.bot -- the "std::linux" namespace: thin, ordinary-Botlish wrappers over
# the raw Linux syscall transports (LINUX-X86-64-SYSCALL.md, ABI-BYTES.md,
# LINUX-SYSCALL-TRANSPORTS.md).
#
# The transports `std::linux::abi::x86_64::syscall` and
# `std::linux::abi::aarch64::syscall` (the privileged operations, one per
# architecture) are generic kernel transitions: seven register words in, the
# raw result register out, no syscall known to the compiler. This module is
# policy above them, written in Botlish and the same on every architecture:
# what each wrapper takes, returns and guarantees.
#
#   std::linux::write(fd, data)    write(2): ONE syscall, the kernel's raw
#                             signed result as an ordinary Int.
#   std::linux::read(fd, data)     read(2): ONE syscall into the caller's
#                             std::abi::bytes::MutableBytes (MUTABLE-BYTES.md); the
#                             kernel's raw signed result and the updated
#                             buffer come back in a std::linux::ReadResult.
#
# What differs by architecture -- the syscall numbers (write is 1 on x86-64
# and 64 on AArch64), which register carries which argument, and how a
# Botlish value becomes that architecture's register contents -- is
# std::linux::sys, an architecture-specific module: stdlib/linux/sys.x86_64.bot and
# stdlib/linux/sys.aarch64.bot, of which the compilation target's architecture
# selects the one (surface/modules.tcl's ModuleFile; -target, the host's by
# default). So `std::linux::write` and everything above it (std::linux::io, the
# portable std::io::print) is one source on every architecture, and nothing here
# names a register or a number.
#
# write is the first syscall that moves memory, so it is also the first that
# needs the memory boundary of ABI-BYTES.md: its buffer is an
# std::abi::bytes::Bytes -- an immutable, owned, contiguous byte value -- and both
# the address and the byte count are derived from that ONE value. The wrapper
# deliberately has no `count` parameter: a separate count could disagree with
# the buffer, and `write(fd, bytes, count)` is exactly the pointer/length
# mismatch the safe wrapper exists to rule out. The raw syscall still
# receives the address and the count in separate registers, because that is
# machine reality; the Botlish function keeps the two facts coupled.
#
# The machine address is taken by the architecture's raw bridge
# (std::abi::x86_64::from_bytes, std::abi::aarch64::from_bytes) and consumed
# synchronously by the syscall in the same function of std::linux::sys: the
# address is never returned, stored or retained, and the compiler keeps
# `data`'s storage alive until the kernel has returned (native/lower.tcl's
# `keepalive`). Nothing here can retain a pointer after the call -- that
# belongs to a future resource/context design.
#
# Syscall-level semantics, deliberately thin (no errno layer yet):
#
# * The result is the raw signed result register as an Int: n >= 0 is the
#   number of bytes written; a negative n is the kernel's -errno (-9 for a
#   bad file descriptor on Linux, on both architectures: the generic errno
#   table), preserved exactly -- never reread as an unsigned number, never
#   turned into -1/errno. A later, higher-level wrapper can translate
#   negative results into Botlish errors.
# * ONE write call. A successful write may write fewer bytes than the Bytes
#   holds (a pipe, a signal, a full disk): the wrapper does not loop, retry
#   or complete the write; the result says how much happened. Completion is
#   a policy for a higher I/O abstraction.
# * Native only, on the target's architecture: the Tcl backends refuse the
#   syscall (NATIVE-ONLY) exactly as they refuse getpid; nothing imitates a
#   write with puts or a Tcl channel.
#
# A direct module (DIRECT-MODULES.md). write and read take any descriptor and
# call std::linux::sys -- the architecture's transport layer, a direct module
# itself -- with no context: they expose raw process authority, which is this
# module's point, the explicit low-level layer. Code that calls them is
# calling into a direct module and either mediates them through a context of
# its own (std::linux::io's LinuxIO does) or is declared direct itself.
direct module

import std::abi
import std::abi::bytes
import std::linux::sys
import std::list
import type std::byte::Byte

# write(2): DATA's bytes to descriptor FD, through the target architecture's
# transport (std::linux::sys::write).
fn write(fd: std::abi::I32, data: std::abi::bytes::Bytes) -> int:
    std::linux::sys::write(fd, data)

# What read(2) did, with both halves kept: the kernel's raw signed ssize_t
# (> 0 the bytes read, 0 end of file, < 0 the kernel's -errno, exactly) and
# the buffer as the kernel left it. Not a tuple, not an error: the caller
# decides what a short read, EOF or a negative result means.
struct ReadResult:
    result: int
    data: std::abi::bytes::MutableBytes

# read(2) from descriptor FD into a logical copy of DATA, through the target
# architecture's transport (std::linux::sys::read).
#
# * LOGICAL COPY. `data` is a value: the caller's buffer is never changed.
#   The kernel writes into a freshly detached copy nothing else observes
#   (std::linux::sys::read takes it), and that same copy is returned as the
#   result's `data`. A caller that keeps `original` and calls read(fd,
#   original) still holds the unchanged bytes; the bytes the kernel wrote are
#   in result.data. (An optimizer that proves `data` dead may write into its
#   storage directly; nobody could tell.)
# * ONE buffer, one source of truth. There is no `count` parameter: the
#   address and the count both come from the same MutableBytes (the raw
#   syscall still receives them in separate registers).
# * ONE syscall: no retry, no loop, no filling. A positive result smaller
#   than the buffer is normal (a short read): only the prefix
#   [0, result) was written, the rest holds what it held before. 0 is end of
#   file, not an error. A negative result is the kernel's -errno, preserved
#   exactly (-9 for a bad descriptor), and the buffer is then unchanged.
# * The buffer keeps its length; nothing is resized to the byte count. Take
#   the bytes actually read with std::abi::bytes::freeze_prefix(result.data,
#   std::abi::usize(result.result)).
# * The address is taken and consumed synchronously; the compiler keeps the
#   storage alive until the kernel has returned (native/lower.tcl).
fn read(fd: std::abi::I32, data: std::abi::bytes::MutableBytes) -> ReadResult:
    done = std::linux::sys::read(fd, data)
    ReadResult {result: done.result, data: done.data}

# ---------------------------------------------------------------------------
# Paths and directories (WINDOWS-X86-64-MILESTONE-7.md): the syscalls
# std::linux::fs is built on, as thin as write and read -- ONE syscall each,
# the raw signed result (a descriptor or 0, or the kernel's -errno, exactly),
# no retry, no ownership.
#
# A pathname is a List of bytes WITHOUT its terminator: the C string the
# kernel reads -- those bytes and one NUL -- is built here, for the one call,
# so it always ends inside its own storage (a Bytes the caller made could
# not be checked: nothing reads a Bytes' bytes). A byte 0 inside PATH ends
# the kernel's pathname there; std::linux::fs's paths never hold one.

# The byte that terminates a C string.
fn terminator() -> Byte:
    0

# PATH's bytes and a terminating NUL: the C string a path syscall reads.
fn c_string(path: List[Byte]) -> std::abi::bytes::Bytes:
    std::abi::bytes::from_list(path.append(terminator()))

# openat(2) of PATH relative to DIRFD (AT_FDCWD, -100, for the working
# directory) with FLAGS and, when FLAGS create a file, the permission bits
# MODE (before the umask). The new descriptor, or -errno.
fn openat(dirfd: std::abi::I32, path: List[Byte], flags: std::abi::I32, mode: std::abi::U32) -> int:
    std::linux::sys::openat(dirfd, c_string(path), flags, mode)

# close(2) of FD: 0, or -errno. On Linux the descriptor is released even
# when close reports an error (EINTR, EIO): it is never closed twice.
fn close(fd: std::abi::I32) -> int:
    std::linux::sys::close(fd)

# getdents64(2): the next linux_dirent64 records of the directory open on FD,
# into a logical copy of DATA (read's rule): result.result the bytes of
# records written (0 at the end of the directory, -errno on failure),
# result.data the buffer as the kernel left it.
fn getdents64(fd: std::abi::I32, data: std::abi::bytes::MutableBytes) -> ReadResult:
    done = std::linux::sys::getdents64(fd, data)
    ReadResult {result: done.result, data: done.data}

# mkdirat(2): the directory PATH (relative to DIRFD) with the permission bits
# MODE (before the umask). 0, or -errno.
fn mkdirat(dirfd: std::abi::I32, path: List[Byte], mode: std::abi::U32) -> int:
    std::linux::sys::mkdirat(dirfd, c_string(path), mode)

# unlinkat(2): removes the name PATH (relative to DIRFD); with FLAGS
# AT_REMOVEDIR (512) an empty directory, else any other kind of entry. 0, or
# -errno.
fn unlinkat(dirfd: std::abi::I32, path: List[Byte], flags: std::abi::I32) -> int:
    std::linux::sys::unlinkat(dirfd, c_string(path), flags)

# O_DIRECTORY and O_NOFOLLOW for the compilation target's architecture (the
# open flags arm64 defines differently): std::linux::sys's.
fn o_directory() -> std::abi::I32Value:
    std::linux::sys::o_directory()

fn o_nofollow() -> std::abi::I32Value:
    std::linux::sys::o_nofollow()
