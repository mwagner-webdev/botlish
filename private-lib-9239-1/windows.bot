# windows.bot -- the "std::windows" namespace: the Windows platform's low-level
# output operations, thin ordinary-Botlish wrappers over kernel32
# (WINDOWS-X86-64-MILESTONE-2.md).
#
#   std::windows::standard_handle(device)   GetStdHandle: the process's
#                                           standard handle of DEVICE, as it is
#                                           now
#   std::windows::write_file(handle, data)  WriteFile: ONE kernel32 call, all
#                                           of DATA asked (or a DWORD's worth);
#                                           a WriteResult
#   std::windows::last_error()              GetLastError: the calling thread's
#                                           last-error code, as it is now
#
# kernel32 is the boundary: the Windows system interface is its DLLs'
# exports, which this module calls through ordinary `extern c fn`
# declarations of their documented prototypes (C-FFI.md), linked through
# kernel32's import library (`extern c library "kernel32"`): no system call
# number, no C runtime function, and no compiler knowledge of I/O.
#
# A HANDLE is an opaque pointer-sized value, `void *` -- a std::ffi::c::Ptr[
# std::ffi::c::Void] here, never an integer or a POSIX descriptor. A standard
# handle is the process's (its STD_INPUT_HANDLE, STD_OUTPUT_HANDLE and
# STD_ERROR_HANDLE slots), *borrowed*: this module never closes one, and has
# no CloseHandle. GetStdHandle documents two results that are no usable
# handle: NULL when the process has no handle for the device (a process
# started without one), and INVALID_HANDLE_VALUE when the call itself failed.
# NULL is told apart (`null?`); INVALID_HANDLE_VALUE is a pointer value
# Botlish cannot compare with (a C pointer has no equality, C-ABI-TYPES.md),
# and is left to WriteFile, which refuses it with ERROR_INVALID_HANDLE (6),
# the error a WriteResult then carries.
#
# Windows reports a failure as its API does: the call returns FALSE and the
# reason is the thread's last-error code (GetLastError), which a later call
# may change. write_file reads it right after WriteFile returns, before any
# other call: nothing runs between the two but the test of WriteFile's BOOL,
# and the byte count's write-back value is built only after it
# (C-FFI-ERROR-CAPTURE-MILESTONE-1.md); neither the allocator nor the
# collector makes a Win32 call that sets the code. A result never encodes the code in its
# count: it holds WriteFile's own success, the count it reported, and,
# separately, the code a failed call left (`last_error`) (0 when it succeeded: the code is
# never read after a success, where it means nothing).
#
# Byte storage reaches C only through the borrowing contract
# (C-POINTER-BORROWING.md): the buffer is `read noescape` (exposed as it is,
# no copy) and its count derived from the ONE value -- there is no count
# parameter; the DWORD WriteFile writes its count into is a 4-byte
# MutableBytes, `write noescape` (a private copy C writes, read back as a
# binary layout). A DWORD holds at most 4294967295, so a larger Bytes is
# asked for in part: a short write by construction, which the count says.
#
# Thin by design: ONE kernel32 call per operation, no loop, no retry, no
# console mode, code page or UTF-16 conversion (the bytes are written as
# they are: WriteFile writes bytes to a console, a file or a pipe alike), no
# buffering, no overlapped I/O, no handle ownership. The standard streams as
# a context and the portable std::io::IO implementation are std::windows::io's.
#
# An ordinary module (DIRECT-MODULES.md): every C call here retains nothing
# -- every pointer parameter is noescape -- so none is a direct edge. Any
# code may ask the process for its standard handles; a handle authorizes
# only the writes its device takes.
import std::abi
import std::abi::bytes
import std::binary
import std::ffi::c

extern c library "kernel32"

# HANDLE GetStdHandle(DWORD nStdHandle)
extern c fn c_get_std_handle named "GetStdHandle"(which: std::ffi::c::ULong) -> std::ffi::c::Ptr[std::ffi::c::Void]

# BOOL WriteFile(HANDLE hFile, LPCVOID lpBuffer, DWORD nNumberOfBytesToWrite,
#                LPDWORD lpNumberOfBytesWritten, LPOVERLAPPED lpOverlapped)
#
# lpNumberOfBytesWritten is a DWORD *: byte storage, so its pointee is
# declared void (an exposure's pointee is byte-sized or void), and the four
# bytes are read back by the Written layout. lpOverlapped is always NULL:
# synchronous I/O.
extern c fn c_write_file named "WriteFile"(file: std::ffi::c::Ptr[std::ffi::c::Void] noescape, buffer: std::ffi::c::Ptr[std::ffi::c::Void] read noescape, count: std::ffi::c::ULong, written: std::ffi::c::Ptr[std::ffi::c::Void] write noescape, overlapped: std::ffi::c::Ptr[std::ffi::c::Void] noescape) -> std::ffi::c::Int

# DWORD GetLastError(void)
extern c fn c_get_last_error named "GetLastError"() -> std::ffi::c::ULong

# The process's standard devices: GetStdHandle's nStdHandle.
enum StandardDevice:
    Input,
    Output,
    Error,

# The DWORD WriteFile reports its count in.
layout Written:
    size 4
    align 4
    field count: std::binary::U32 at 0

# What one WriteFile did: OK its BOOL (WriteFile returned TRUE), COUNT the
# bytes it reported written (fewer than asked is a short write, not an
# error; 0 when it failed), LAST_ERROR the thread's last-error code when it
# failed, read right after it (0 exactly when OK).
struct WriteResult:
    ok: bool
    count: int
    last_error: int

# STD_INPUT_HANDLE, STD_OUTPUT_HANDLE, STD_ERROR_HANDLE: (DWORD)-10, -11,
# -12.
fn selector(device: StandardDevice) -> std::ffi::c::ULong:
    if device == StandardDevice::Input:
        return 4294967286
    if device == StandardDevice::Output:
        return 4294967285
    4294967284

# The process's standard handle of DEVICE, as it is now (GetStdHandle reads
# the process's slot each time: SetStdHandle may have changed it): NULL when
# the process has none, INVALID_HANDLE_VALUE when GetStdHandle failed.
# Borrowed: never close it.
fn standard_handle(device: StandardDevice) -> std::ffi::c::Ptr[std::ffi::c::Void]:
    c_get_std_handle(selector(device))

# The calling thread's last-error code, as it is now. Meaningful only right
# after a call that reported a failure.
fn last_error() -> int:
    c_get_last_error()

# How many of DATA's bytes one WriteFile asks for: all of them, or a DWORD's
# maximum.
fn request(data: std::abi::bytes::Bytes) -> std::ffi::c::ULong:
    n = std::abi::bytes::length(data).value
    if n > 4294967295:
        return 4294967295
    n

# The count WriteFile wrote into CELL.
fn written(cell: std::abi::bytes::MutableBytes) -> int:
    w = std::binary::parse(Written, std::abi::bytes::freeze(cell)):
        on LayoutLengthMismatch:
            # Never: CELL is the four bytes write_file gave WriteFile.
            return 0
    w.count

# WriteFile of DATA's bytes to HANDLE, by one kernel32 call (synchronous: no
# overlapped structure).
fn write_file(handle: std::ffi::c::Ptr[std::ffi::c::Void], data: std::abi::bytes::Bytes) -> WriteResult:
    synchronous = std::ffi::c::null[std::ffi::c::Void]()
    r = handle.c_write_file(data, request(data), std::abi::bytes::zeroed(std::abi::usize(4)), synchronous)
    if r.result == 0:
        failure = c_get_last_error()
        return WriteResult {ok: false, count: written(r.written), last_error: failure}
    WriteResult {ok: true, count: written(r.written), last_error: 0}
