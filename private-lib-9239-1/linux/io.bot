# io.bot -- the "std::linux::io" namespace: the process's standard I/O as one
# execution-environment context (CONTEXTS.md).
#
#   with context std::linux::io::create()        install it (entry program)
#   std::linux::io::write(data)                  write(2) to the context's stdout
#   std::linux::io::write_error(data)            write(2) to the context's stderr
#   std::linux::io::read(buffer)                 read(2) from the context's stdin
#
# LinuxIO is ONE context, the process I/O environment, holding the three
# standard descriptors; it is not three contexts. A function that uses it says
# so once, in its context section (`context io: LinuxIO`), and is called with
# its ordinary arguments only: `std::linux::io::write(data)`. Code between the entry
# program and such a function declares nothing -- the compiler derives that it
# requires LinuxIO -- and a call made before `with context std::linux::io::create()`
# is rejected at compile time (MISSING-CONTEXT, with the call chain).
#
# Capability boundary (DIRECT-MODULES.md). `linux` is a direct module: its
# write and read take any descriptor, raw process authority. This module is
# not: every function here that calls into `linux` requires LinuxIO, the
# context it defines itself, so the raw authority reaches its callers only as
# that explicit capability -- and nothing above std::linux::io is direct for using
# it.
#
# This module is one level above `linux` (stdlib/linux.bot): every operation here
# is the existing raw-thin wrapper applied to a descriptor taken from the
# context, and every external effect still flows
#
#   std::linux::io::write --> std::linux::write --> std::linux::sys::write --> the target
#   architecture's transport (std::linux::abi::x86_64::syscall: `syscall`;
#   std::linux::abi::aarch64::syscall: `svc #0`)
#
# with no libc, no compiler knowledge of write(2) and no new syscall code. The
# low-level layer stays as it is: code that wants an explicit descriptor calls
# std::linux::write(fd, data) / std::linux::read(fd, buffer) directly.
#
# Representation authority. FileDescriptor and LinuxIO are opaque
# (OPAQUE-STRUCTS.md): only this module may construct them or look inside.
# Outside it a LinuxIO -- even one a function receives as its context -- can be
# held and passed but not taken apart (`io.stdout` is OPAQUE-REPRESENTATION):
# being a context grants no representation authority. Inside, the consumers
# below project `io.stdout.raw` directly; there are deliberately no public
# descriptor accessors.
#
# FileDescriptor's theorem is narrow: "this value is a Linux file-descriptor
# token minted by the owning Linux I/O abstraction". It does not claim the
# descriptor is open, or stays open. The machine token is a std::abi::I32 (so the
# value is proven to be in the signed 32-bit domain); application code gets no
# .raw, no integer conversion and no address. Minting needs no special
# mechanism: the opaque representation already makes this module the only code
# that can build one, so create() mints the three standard tokens 0, 1, 2 --
# constants the existing completion proofs show are in std::abi::I32's domain, with
# no run-time range check.
#
# LinuxIO implements the portable std::io::IO context trait (CONTEXT-TRAITS.md)
# with write_text and write_error_text below: ordinary functions of this
# module whose one context parameter is a LinuxIO -- the implicit receiver --
# and whose signatures match std::io::IO's requirements. Nothing registers them:
# where a call needs std::io::IO and LinuxIO is the one installed context that
# implements it, the compiler binds `io.write_text(...)` to a direct call of
# std::linux::io::write_text, which loads its descriptor from LinuxIO's own
# context slot as every function here does.
#
# Not here (deliberately): errno mapping beyond std::io::WriteFailed (the raw
# write/read below return the kernel's signed values), buffering,
# close/ownership/RAII (the standard descriptors need no application cleanup),
# other descriptors (openat, sockets), mutable contexts.
import std::abi
import std::abi::bytes
import std::io
import std::linux
import std::list
import std::str
import type std::byte::Byte

# A Linux file-descriptor token minted by this module.
opaque struct FileDescriptor:
    raw: std::abi::I32

# The process I/O environment: the standard input, output and error
# descriptors of the process. One context.
opaque context struct LinuxIO:
    stdin: FileDescriptor
    stdout: FileDescriptor
    stderr: FileDescriptor

# The standard process I/O environment: descriptors 0, 1 and 2. An ordinary
# constructor; `with context std::linux::io::create()` installs its value.
fn create() -> LinuxIO:
    LinuxIO {
        stdin: FileDescriptor {raw: std::abi::i32(0)},
        stdout: FileDescriptor {raw: std::abi::i32(1)},
        stderr: FileDescriptor {raw: std::abi::i32(2)},
    }

# write(2) of DATA to the context's standard output: ONE syscall, the kernel's
# raw signed result unchanged (bytes written, or -errno). std::linux::write's
# semantics exactly (stdlib/linux.bot).
fn write(data: std::abi::bytes::Bytes, context io: LinuxIO) -> int:
    io.stdout.raw.write(data)

# write(2) of DATA to the context's standard error.
fn write_error(data: std::abi::bytes::Bytes, context io: LinuxIO) -> int:
    io.stderr.raw.write(data)

# read(2) from the context's standard input into a logical copy of DATA:
# std::linux::read's semantics exactly (one syscall; the caller's buffer is
# unchanged; the kernel's raw result and the updated buffer come back in a
# std::linux::ReadResult).
fn read(data: std::abi::bytes::MutableBytes, context io: LinuxIO) -> std::linux::ReadResult:
    io.stdin.raw.read(data)

# ---------------------------------------------------------------------------
# std::io::IO (CONTEXT-TRAITS.md)

# Writes every byte of BYTES to FD. One write(2) of the whole text in the
# common case; a short write (fewer bytes than asked, but some) is completed
# by writing the rest, again and again, so the caller only ever sees all or
# std::io::WriteFailed. A negative result (the kernel's -errno) and a write that makes
# no progress are std::io::WriteFailed; no count or errno escapes.
#
# It requires LinuxIO although it reads only FD: it makes the direct call
# (std::linux::write, a callable of the direct module linux), and a direct call is
# mediated by a context of this module in the function that makes it
# (DIRECT-MODULES.md), never by its callers' contexts. Its callers have it.
fn write_all(fd: FileDescriptor, bytes: List[Byte], context io: LinuxIO) -> unit errors std::io::WriteFailed:
    n = std::list::length(bytes)
    if n == 0:
        return unit
    written = fd.raw.write(std::abi::bytes::from_list(bytes))
    if written <= 0:
        fail std::io::WriteFailed
    if written < n:
        # The unwritten suffix: indices WRITTEN..n-1, which the checks above
        # prove are inside BYTES.
        remaining = loop i from written to n:
            bytes.at(i)
        return fd.write_all(remaining)
    unit

# All of TEXT, UTF-8 encoded, on the context's standard output; std::io::WriteFailed
# when Linux reports an error or stops making progress. Never a byte count.
fn write_text(text: str, context io: LinuxIO) -> unit errors std::io::WriteFailed:
    io.stdout.write_all(std::str::encode_utf8(text))

# All of TEXT, UTF-8 encoded, on the context's standard error.
fn write_error_text(text: str, context io: LinuxIO) -> unit errors std::io::WriteFailed:
    io.stderr.write_all(std::str::encode_utf8(text))
