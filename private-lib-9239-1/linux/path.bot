# path.bot -- the "std::linux::path" namespace: textual Linux paths
# (CONTEXT-TRAITS.md, "Paths").
#
#   std::linux::path::validate(value)       proves VALUE a LinuxPath, or std::io::path::NotAPath
#   std::linux::path::valid?(value)         true proves VALUE a LinuxPath
#   std::linux::path::concat(path, part)    PATH joined with PART: a LinuxPath
#   std::linux::path::text(path)            PATH's String form (the carrier)
#
# LinuxPath is a refinement of str (REFINEMENT-VALUES.md): a value proven to
# be a non-empty String without U+0000 -- text that may be handed to Linux as
# an ordinary pathname. It is the same String, with the String's
# representation, so a validated value keeps being used as text with no
# conversion:
#
#   fn show(value: str):
#       std::linux::path::validate(value):
#           on std::io::path::NotAPath:
#               return
#       std::io::print_line(std::str::concat("Reading config at ", value))   # a str
#       open_config(value)                                # and a LinuxPath
#
# The proposition is textual eligibility and nothing more. It does NOT claim
# that the path exists, is readable or writable, is a file or a directory,
# resolves through symlinks, is canonical, is shorter than PATH_MAX or a
# filesystem's name limit, or is meaningful relative to the current working
# directory: those are facts about the environment at some moment, never
# about the String, and validation observes no filesystem. Nor does it claim
# to represent every Linux directory entry: Linux names are bytes, and
# arbitrary-byte paths belong to a lower-level abstraction. Validation does
# not normalize: ".", "..", "./a", "../a", "a//b" and "/a/b" are valid exactly
# as written.
#
# LinuxPath satisfies the portable std::io::path::Path trait through this module's
# own `concat` and `text` (TRAITS.md: the owner's declarations, nothing
# else), so a function over std::io::path::Path specializes to direct calls of
# them.
#
# A LinuxPath is also a std::io::fs::FilePath (WINDOWS-X86-64-MILESTONE-7.md):
# its native path is its UTF-8 bytes (`native`, total: a LinuxPath holds no
# U+0000), and its filesystem operations below are std::linux::fs's on that
# native path. They declare no context; std::linux::fs's functions require
# std::linux::fs::LinuxFS, so every caller of these does too (the requirement
# is derived), and a program that uses a LinuxPath's file operations without
# installing a LinuxFS is MISSING-CONTEXT at compile time.
#
#   std::linux::path::native(path)            PATH's std::linux::fs::NativePath
#   std::linux::path::read_file(path), write_file(path, data),
#   create_file(path, data), entries(path), create_directory(path),
#   remove_file(path), remove_directory(path)
#                                             std::io::fs::FilePath's
#                                             operations, on PATH's native path
import std::abi
import std::abi::bytes
import std::char
import std::str
import std::io::fs
import std::io::path
import std::linux::fs

refined type LinuxPath = str

# true when no character of VALUE is U+0000.
fn nul_free?(value: str) -> bool:
    loop i from 0 to value.length():
        if value.char_at(i).scalar_value() == 0:
            return false
    true

# true when VALUE is a valid textual Linux path (non-empty, no U+0000), which
# proves it a LinuxPath; false proves nothing.
fn valid?(value: str) -> bool proves value: LinuxPath:
    value.length() > 0 and value.nul_free?()

# Completes normally only when VALUE is a valid textual Linux path, which
# proves it a LinuxPath for the rest of the caller's path; fails with
# std::io::path::NotAPath otherwise.
fn validate(value: str) -> unit proves value: LinuxPath errors std::io::path::NotAPath:
    if valid?(value):
        unit
    else:
        fail std::io::path::NotAPath

# The path's canonical String form: exactly the carrier String (lossless; no
# escaping, quoting or display conversion).
fn text(path: LinuxPath) -> str:
    path

# PATH joined with COMPONENT: one "/" between them unless PATH already ends
# with one. COMPONENT is a relative path fragment -- non-empty, without
# U+0000, not starting with "/" (an absolute component would replace PATH,
# which joining never does) -- and may itself contain "/", "." or "..";
# nothing is normalized and no filesystem is observed. Fails with std::io::path::NotAPath
# for any other COMPONENT. The result is a LinuxPath by validation, the
# ordinary owner proof.
fn concat(path: LinuxPath, component: str) -> LinuxPath errors std::io::path::NotAPath:
    m = component.length()
    if m == 0 or component.char_at(0) == '/' or not valid?(component):
        fail std::io::path::NotAPath
    n = path.length()
    joined = if n > 0 and path.substring(n - 1, n) == "/":
        std::str::concat(path, component)
    else:
        std::str::concat(std::str::concat(path, "/"), component)
    validate(joined)
    joined

# ---------------------------------------------------------------------------
# std::io::fs::FilePath (WINDOWS-X86-64-MILESTONE-7.md)

# PATH's native path: its UTF-8 bytes, exactly (no normalization).
fn native(path: LinuxPath) -> std::linux::fs::NativePath:
    std::linux::fs::of_valid_text(path)

# Every byte of the file PATH.
fn read_file(path: LinuxPath) -> std::abi::bytes::Bytes errors std::io::fs::FileError:
    std::linux::fs::read_file(path.native())

# The file PATH holds exactly DATA: created, or truncated and rewritten.
fn write_file(path: LinuxPath, data: std::abi::bytes::Bytes) -> unit errors std::io::fs::FileError:
    std::linux::fs::write_file(path.native(), data)

# A new file PATH holding DATA; AlreadyExists when the name exists.
fn create_file(path: LinuxPath, data: std::abi::bytes::Bytes) -> unit errors std::io::fs::FileError:
    std::linux::fs::create_file(path.native(), data)

# Every entry of the directory PATH but "." and "..", with its textual name;
# std::io::path::NotText when a name is not UTF-8 (std::linux::fs::entries
# lists every name as bytes).
fn entries(path: LinuxPath) -> List[std::io::fs::Entry] errors std::io::fs::FileError, std::io::path::NotText:
    listed = std::linux::fs::entries(path.native())
    loop e in listed:
        std::io::fs::Entry {name: std::linux::fs::text(e.name), kind: e.kind}

# A new, empty directory PATH.
fn create_directory(path: LinuxPath) -> unit errors std::io::fs::FileError:
    std::linux::fs::create_directory(path.native())

# Removes the name PATH of anything but a directory.
fn remove_file(path: LinuxPath) -> unit errors std::io::fs::FileError:
    std::linux::fs::remove_file(path.native())

# Removes the empty directory PATH.
fn remove_directory(path: LinuxPath) -> unit errors std::io::fs::FileError:
    std::linux::fs::remove_directory(path.native())
