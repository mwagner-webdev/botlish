# path.bot -- the "std::darwin::path" namespace: textual macOS (Darwin) paths
# (CONTEXT-TRAITS.md, "Paths"; MACOS-AARCH64-MILESTONE-8.md).
#
#   std::darwin::path::validate(value)     proves VALUE a DarwinPath, or
#                                          std::io::path::NotAPath
#   std::darwin::path::valid?(value)       true proves VALUE a DarwinPath
#   std::darwin::path::concat(path, part)  PATH joined with PART: a DarwinPath
#   std::darwin::path::text(path)          PATH's String form (the carrier)
#
# DarwinPath is a refinement of str (REFINEMENT-VALUES.md): a value proven to
# be a non-empty String without U+0000 -- text that may be handed to
# libSystem as an ordinary C pathname once it is encoded as UTF-8 and given
# its terminating NUL (std::darwin::open and std::darwin::create do that, for the one
# call). It is the same String, with the String's representation, so a
# validated value keeps being used as text with no conversion. It is
# std::linux::path::LinuxPath's sibling, not a shared type: each platform owns its
# textual path, and std::io::path::Path is what portable code names.
#
# The proposition is textual eligibility and nothing more. It does NOT claim
# that the path exists, is readable or writable, is a file or a directory,
# resolves through symlinks, is canonical, is shorter than PATH_MAX or a
# filesystem's name limit, is normalized the way APFS compares names, or is
# meaningful relative to the current working directory: those are facts
# about the environment at some moment, never about the String, and
# validation observes no filesystem. Nor does it claim to represent every
# Darwin directory entry: Darwin names are bytes, and arbitrary-byte paths
# belong to a lower-level abstraction. Validation does not normalize: ".",
# "..", "./a", "../a", "a//b" and "/a/b" are valid exactly as written.
#
# DarwinPath satisfies the portable std::io::path::Path trait through this
# module's own `concat` and `text` (TRAITS.md: the owner's declarations,
# nothing else), so a function over std::io::path::Path specializes to direct
# calls of them.
#
# A DarwinPath is also a std::io::fs::FilePath (WINDOWS-X86-64-MILESTONE-7.md):
# its native path is its UTF-8 bytes (`native`), and its filesystem
# operations below are std::darwin::fs's on that native path, which require
# std::darwin::fs::DarwinFS (so every caller does: the requirement is
# derived).
import std::abi
import std::abi::bytes
import std::char
import std::darwin::fs
import std::io::fs
import std::str
import std::io::path

refined type DarwinPath = str

# true when no character of VALUE is U+0000.
fn nul_free?(value: str) -> bool:
    loop i from 0 to value.length():
        if value.char_at(i).scalar_value() == 0:
            return false
    true

# true when VALUE is a valid textual Darwin path (non-empty, no U+0000), which
# proves it a DarwinPath; false proves nothing.
fn valid?(value: str) -> bool proves value: DarwinPath:
    value.length() > 0 and value.nul_free?()

# Completes normally only when VALUE is a valid textual Darwin path, which
# proves it a DarwinPath for the rest of the caller's path; fails with
# std::io::path::NotAPath otherwise.
fn validate(value: str) -> unit proves value: DarwinPath errors std::io::path::NotAPath:
    if valid?(value):
        unit
    else:
        fail std::io::path::NotAPath

# The path's canonical String form: exactly the carrier String (lossless; no
# escaping, quoting or display conversion).
fn text(path: DarwinPath) -> str:
    path

# true when TEXT's last character is "/".
fn ends_with_slash?(text: str) -> bool:
    n = text.length()
    if n == 0:
        return false
    # n - 1 is TEXT's last index; the index proof does not relate it to the
    # length, so the handler answers for the case it excludes.
    last = text.char_at(n - 1):
        on IndexNotFound:
            return false
    last == '/'

# PATH joined with COMPONENT: one "/" between them unless PATH already ends
# with one. COMPONENT is a relative path fragment -- non-empty, without
# U+0000, not starting with "/" (an absolute component would replace PATH,
# which joining never does) -- and may itself contain "/", "." or "..";
# nothing is normalized and no filesystem is observed. Fails with
# std::io::path::NotAPath for any other COMPONENT. The result is a DarwinPath by
# validation, the ordinary owner proof.
fn concat(path: DarwinPath, component: str) -> DarwinPath errors std::io::path::NotAPath:
    m = component.length()
    if m == 0 or component.char_at(0) == '/' or not valid?(component):
        fail std::io::path::NotAPath
    joined = if ends_with_slash?(path):
        std::str::concat(path, component)
    else:
        std::str::concat(path.append_char('/'), component)
    validate(joined)
    joined

# ---------------------------------------------------------------------------
# std::io::fs::FilePath (WINDOWS-X86-64-MILESTONE-7.md)

# PATH's native path: its UTF-8 bytes, exactly (no normalization).
fn native(path: DarwinPath) -> std::darwin::fs::NativePath:
    std::darwin::fs::of_valid_text(path)

# Every byte of the file PATH.
fn read_file(path: DarwinPath) -> std::abi::bytes::Bytes errors std::io::fs::FileError:
    std::darwin::fs::read_file(path.native())

# The file PATH holds exactly DATA: created, or truncated and rewritten.
fn write_file(path: DarwinPath, data: std::abi::bytes::Bytes) -> unit errors std::io::fs::FileError:
    std::darwin::fs::write_file(path.native(), data)

# A new file PATH holding DATA; AlreadyExists when the name exists.
fn create_file(path: DarwinPath, data: std::abi::bytes::Bytes) -> unit errors std::io::fs::FileError:
    std::darwin::fs::create_file(path.native(), data)

# Every entry of the directory PATH but "." and "..", with its textual name;
# std::io::path::NotText for a name that is not UTF-8.
fn entries(path: DarwinPath) -> List[std::io::fs::Entry] errors std::io::fs::FileError, std::io::path::NotText:
    listed = std::darwin::fs::entries(path.native())
    loop e in listed:
        std::io::fs::Entry {name: std::darwin::fs::text(e.name), kind: e.kind}

# A new, empty directory PATH.
fn create_directory(path: DarwinPath) -> unit errors std::io::fs::FileError:
    std::darwin::fs::create_directory(path.native())

# Removes the name PATH of anything but a directory.
fn remove_file(path: DarwinPath) -> unit errors std::io::fs::FileError:
    std::darwin::fs::remove_file(path.native())

# Removes the empty directory PATH.
fn remove_directory(path: DarwinPath) -> unit errors std::io::fs::FileError:
    std::darwin::fs::remove_directory(path.native())
