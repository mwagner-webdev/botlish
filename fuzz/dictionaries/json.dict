# json.dict -- RFC 8259's grammar tokens: the two structural pairs, the
# value literals, the string-escape machinery (including the surrogate
# pair halves), number grammar pieces and the whitespace forms. Attached
# to the conformance target (JSON ingestion). Hand-written from RFC 8259
# (AFL++'s bundled json.dict was not available offline; the token set is
# the same idea).
object_open="{"
object_close="}"
array_open="["
array_close="]"
colon=":"
comma=","
null="null"
true="true"
false="false"
quote="\""
backslash="\\"
escaped_quote="\\\""
escaped_backslash="\\\\"
escaped_slash="\\/"
esc_b="\\b"
esc_f="\\f"
esc_n="\\n"
esc_r="\\r"
esc_t="\\t"
u_escape="\\u"
u_bound_hi="\\uD7FF"
u_surrogate_hi="\\uD800"
u_surrogate_lo="\\uDC00"
u_bound_lo="\\uE000"
u_max="\\uFFFF"
zero="0"
minus="-"
plus="+"
dot="."
exp_e="e"
exp_E="E"
exp="e-"
exp_plus="E+"
leading_zero="01"
nan="NaN"
infinity="Infinity"
space=" "
tab="\x09"
newline="\x0a"
cr="\x0d"
bom="\xEF\xBB\xBF"
